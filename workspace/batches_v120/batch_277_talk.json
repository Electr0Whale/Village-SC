        {
          "f_idx": 14,
          "pidx_tc": 465095,
          "spk": "琪娜娜 (チナナ)",
          "ja": "種類は増やせないから、",
          "tc": "但不能增加訂購的種類，",
          "sc": "但不能增加订购的种类，"
        },
