          "pidx_tc": 465027,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これまで手に入れた家具が",
          "tc": "你至今曾獲得過的",
          "sc": "你至今曾获得过的"
        },
        {
          "f_idx": 7,
          "pidx_tc": 465034,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一覧で載ってるんだよ",
          "tc": "所有家具。",
          "sc": "所有家具。"
        },
        {
