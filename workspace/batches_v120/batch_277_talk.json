      "rec_id": "TALK_ID_90_2002_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465500,
          "spk": "林 (リン)",
          "ja": "昔の地図を眺めていたらね、",
          "tc": "我在翻看以前的地圖時，",
          "sc": "我在翻看以前的地图时，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 465507,
          "spk": "林 (リン)",
          "ja": "この先に、道があったらしい場所を見つけたの",
          "tc": "發現這前方似乎曾經有一條路。  ",
          "sc": "发现这前方似乎曾经有一条路。  "
        },
        {
          "f_idx": 3,
          "pidx_tc": 465525,
          "spk": "林 (リン)",
          "ja": "瓦礫をどけて道を整備すれば、",
          "tc": "只要清除瓦礫並整修道路，",
          "sc": "只要清除瓦砾并整修道路，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 465532,
          "spk": "林 (リン)",
          "ja": "あなたの庭として使えるはず……",
          "tc": "那塊地應該就能供你作為庭院使用……",
          "sc": "那块地应该就能供你作为庭院使用……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7917,
      "rec_id": "TALK_ID_90_2002_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465563,
          "spk": "林 (リン)",
          "ja": "まだ土地を増やしたいのなら、",
          "tc": "要是想擴建土地的話，",
          "sc": "要是想扩建土地的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 465570,
          "spk": "林 (リン)",
          "ja": "<strong>素材とお金を用意して、",
          "tc": "<strong>就準備好材料和費用，",
          "sc": "<strong>就准备好材料和费用，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 465577,
          "spk": "林 (リン)",
          "ja": "樹木建設</strong>でキスケさんに依頼しなさい",
          "tc": "到樹木建設</strong>委託木助哥吧。",
          "sc": "到树木建设</strong>委托木助哥吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 465588,
          "spk": "林 (リン)",
          "ja": "あ、土地の代金の支払いはキスケさんにお願いね",
          "tc": "對了，土地的費用請直接交給木助哥。",
          "sc": "对了，土地的费用请直接交给木助哥。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 465595,
          "spk": "林 (リン)",
          "ja": "後で、私がキスケさんから受け取るから",
          "tc": "我之後會再跟他收款。",
          "sc": "我之后会再跟他收款。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 465613,
          "spk": "林 (リン)",
          "ja": "もちろん、無理に買えとは言わないわ！",
          "tc": "當然，我不是要強迫你買！",
          "sc": "当然，我不是要强迫你买！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 465620,
          "spk": "林 (リン)",
          "ja": "でも、あなたがもっと広い土地を求めるなら、",
          "tc": "只是如果你需要更寬敞的土地，",
          "sc": "只是如果你需要更宽敞的土地，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 465627,
          "spk": "林 (リン)",
          "ja": "売ってあげてもいい……それだけの話よ",
          "tc": "我願意再賣給你……就是這麼回事。",
          "sc": "我愿意再卖给你……就是这么回事。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 465638,
          "spk": "林 (リン)",
          "ja": "じゃあ、私からの話はこれだけ",
          "tc": "我想跟你說的就是這些。",
          "sc": "我想跟你说的就是这些。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 465645,
          "spk": "林 (リン)",
          "ja": "購入するかどうか、よく検討してちょうだいね",
          "tc": "至於要不要買，你就再好好考慮一下吧。",
          "sc": "至于要不要买，你就再好好考虑一下吧。"
        }
      ]
    },
