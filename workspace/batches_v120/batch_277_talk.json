    {
      "file": "talk.dat",
      "rec_idx": 7905,
      "rec_id": "TALK_ID_70_2150_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393881,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ～……昨日はなんて",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393888,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こっぱずかしい話を",
          "tc": "我昨天到底為什麼會講那些",
          "sc": "我昨天到底为什么会讲那些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393895,
          "spk": "琪娜娜 (チナナ)",
          "ja": "したんだろうねえ……",
          "tc": "那麼難為情的話啊……",
          "sc": "那么难为情的话啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393904,
          "spk": "琪娜娜 (チナナ)",
          "ja": "素面であんなこと",
          "tc": "真是不敢相信，",
          "sc": "真是不敢相信，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393911,
          "spk": "琪娜娜 (チナナ)",
          "ja": "堂々と言っちゃうなんて",
          "tc": "我明明就沒喝醉，",
          "sc": "我明明就没喝醉，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393918,
          "spk": "琪娜娜 (チナナ)",
          "ja": "信じられないねえ……",
          "tc": "居然還能面不改色地說出那些話……",
          "sc": "居然还能面不改色地说出那些话……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393929,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これだから夜は",
          "tc": "夜晚就是",
          "sc": "夜晚就是"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393936,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おセンチになりやすくて",
          "tc": "容易讓人多愁善感，",
          "sc": "容易让人多愁善感，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 393943,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困るんだよ",
          "tc": "真傷腦筋。",
          "sc": "真伤脑筋。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 393954,
          "spk": "琪娜娜 (チナナ)",
          "ja": "頼むから、昨日のことは",
          "tc": "拜託你了，",
          "sc": "拜托你了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 393961,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチとキミだけの秘密に",
          "tc": "希望你能把昨天的事",
          "sc": "希望你能把昨天的事"
        },
        {
          "f_idx": 11,
          "pidx_tc": 393968,
          "spk": "琪娜娜 (チナナ)",
          "ja": "してほしいんだけど……",
          "tc": "當作我們兩個人之間的祕密……",
          "sc": "当作我们两个人之间的秘密……"
        }
      ]
    },
