  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7895,
      "rec_id": "TALK_ID_70_2150_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393069,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、まだ",
          "tc": "哈哈哈，",
          "sc": "哈哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393076,
          "spk": "琪娜娜 (チナナ)",
          "ja": "舌がヒリヒリするかい？",
          "tc": "你舌頭還是麻麻的嗎？",
          "sc": "你舌头还是麻麻的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393083,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪かったねえ",
          "tc": "真是不好意思啊。",
          "sc": "真是不好意思啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393094,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちゃんと辛くないディップも",
          "tc": "我還有準備不辣的沾醬，",
          "sc": "我还有准备不辣的沾酱，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393101,
          "spk": "琪娜娜 (チナナ)",
          "ja": "用意してあるから安心するといいよ",
          "tc": "所以你就放心吧。",
          "sc": "所以你就放心吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393112,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……早く一緒に",
          "tc": "……真希望",
          "sc": "……真希望"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393119,
          "spk": "琪娜娜 (チナナ)",
          "ja": "辛いものとビールを",
          "tc": "你能趕快長大，",
          "sc": "你能赶快长大，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "楽しめるようになりたいねえ",
          "tc": "我們就可以一起享用辣的食物跟啤酒了呢。",
          "sc": "我们就可以一起享用辣的食物跟啤酒了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7896,
      "rec_id": "TALK_ID_70_2150_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393150,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よく来たね",
          "tc": "你來啦，",
          "sc": "你来啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393157,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いらっしゃい",
          "tc": "歡迎。",
          "sc": "欢迎。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393168,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミが寝る場所を",
          "tc": "我已經整理好",
          "sc": "我已经整理好"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393175,
          "spk": "琪娜娜 (チナナ)",
          "ja": "作っておいたよ",
          "tc": "讓你睡覺的地方了。",
          "sc": "让你睡觉的地方了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393182,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、そこ",
          "tc": "你看，就在那邊。",
          "sc": "你看，就在那边。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7897,
      "rec_id": "TALK_ID_70_2150_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393206,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秘密基地っぽくて",
          "tc": "是不是很像祕密基地？",
          "sc": "是不是很像秘密基地？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393213,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なかなかいいだろう？",
          "tc": "很不錯吧？",
          "sc": "很不错吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここは二人で寝るには",
          "tc": "雖然這裡睡兩個人",
          "sc": "虽然这里睡两个人"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっとばかし狭いけどね",
          "tc": "是有一點點擠，",
          "sc": "是有一点点挤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393238,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それもまた楽しいんだよ",
          "tc": "但這也是一種樂趣嘛。",
          "sc": "但这也是一种乐趣嘛。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393249,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜は今みたいに",
          "tc": "晚上只要像現在一樣",
          "sc": "晚上只要像现在一样"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393256,
          "spk": "琪娜娜 (チナナ)",
          "ja": "車内灯を点けていれば",
          "tc": "打開車內燈，",
          "sc": "打开车内灯，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393263,
          "spk": "琪娜娜 (チナナ)",
          "ja": "明るくて過ごしやすいし",
          "tc": "就會很明亮了，很方便。",
          "sc": "就会很明亮了，很方便。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 393274,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気分を変えて",
          "tc": "或者如果想要換個心情，",
          "sc": "或者如果想要换个心情，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 393281,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ランタンの明かりで",
          "tc": "打開燈籠的燈",
          "sc": "打开灯笼的灯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 393288,
          "spk": "琪娜娜 (チナナ)",
          "ja": "過ごすのもいいもんだよ",
          "tc": "也不錯。",
          "sc": "也不错。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 393299,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜の運転席って",
          "tc": "晚上的駕駛座",
          "sc": "晚上的驾驶座"
        },
        {
          "f_idx": 12,
          "pidx_tc": 393306,
          "spk": "琪娜娜 (チナナ)",
          "ja": "落ち着くんだよねえ",
          "tc": "很讓人放鬆呢。",
          "sc": "很让人放松呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 393315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝る前はここで",
          "tc": "我睡前都會在這裡",
          "sc": "我睡前都会在这里"
        },
        {
          "f_idx": 14,
          "pidx_tc": 393322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "本を読んだり、",
          "tc": "讀讀書、",
          "sc": "读读书、"
        },
        {
          "f_idx": 15,
          "pidx_tc": 393329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "虫の声を聞いたり……",
          "tc": "聽聽蟲鳴……",
          "sc": "听听虫鸣……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 393340,
          "spk": "琪娜娜 (チナナ)",
          "ja": "天気が良ければ",
          "tc": "然後天氣好的時候，",
          "sc": "然后天气好的时候，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 393347,
          "spk": "琪娜娜 (チナナ)",
          "ja": "窓を開けて",
          "tc": "我會打開車窗",
          "sc": "我会打开车窗"
        },
        {
          "f_idx": 18,
          "pidx_tc": 393354,
          "spk": "琪娜娜 (チナナ)",
          "ja": "星を眺めたりするんだよ",
          "tc": "看星星。",
          "sc": "看星星。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 393365,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ああ、でも今日は",
          "tc": "……啊，",
          "sc": "……啊，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 393372,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう遅いからね",
          "tc": "不過今天已經很晚了，",
          "sc": "不过今天已经很晚了，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 393379,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝るとしようか",
          "tc": "所以我們還是先睡吧。",
          "sc": "所以我们还是先睡吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7898,
      "rec_id": "TALK_ID_70_2150_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……起きてるかい、<player>",
          "tc": "……你還醒著嗎，<player>？",
          "sc": "……你还醒着吗，<player>？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7899,
      "rec_id": "TALK_ID_70_2150_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393415,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっと",
          "tc": "哎呀，",
          "sc": "哎呀，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393422,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こっちは見ないでくれるかい？",
          "tc": "可以不要看我嗎？",
          "sc": "可以不要看我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393429,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと気恥ずかしくてね",
          "tc": "我有一點不好意思。",
          "sc": "我有一点不好意思。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7900,
      "rec_id": "TALK_ID_70_2150_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393445,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなこと、面と向かっては",
          "tc": "雖然這種事",
          "sc": "虽然这种事"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393452,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なかなか言えないけどさ",
          "tc": "實在是很難當著面開口，",
          "sc": "实在是很难当着面开口，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393459,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鵺の皮の件では、世話になったね",
          "tc": "但關於鵺皮那件事，我還是要謝謝你的幫忙。",
          "sc": "但关于鵺皮那件事，我还是要谢谢你的帮忙。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393468,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチはずっと",
          "tc": "……我一直都希望",
          "sc": "……我一直都希望"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393475,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミにまた笑ってほしいと",
          "tc": "能夠再看到",
          "sc": "能够再看到"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393482,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思っていたんだ",
          "tc": "應該會累死。",
          "sc": "应该会累死。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393491,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのためにどうしたらいいのか、",
          "tc": "但是我卻不知道該怎麼做。",
          "sc": "但是我却不知道该怎么做。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393498,
          "spk": "琪娜娜 (チナナ)",
          "ja": "答えが出ないまま",
          "tc": "我始終都找不到答案，",
          "sc": "我始终都找不到答案，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 393505,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村を行き来していたわけだけど",
          "tc": "就這樣一直在村子裡進進出出的。",
          "sc": "就这样一直在村子里进进出出的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 393514,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今は、こんなに簡単なこと",
          "tc": "所以現在我才會覺得很驚訝，",
          "sc": "所以现在我才会觉得很惊讶，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 393521,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だったのかって驚いているよ",
          "tc": "想說原來答案這麼簡單。",
          "sc": "想说原来答案这么简单。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7901,
      "rec_id": "TALK_ID_70_2150_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393537,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……でもねえ",
          "tc": "……可是啊，",
          "sc": "……可是啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393544,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミとスミレがね",
          "tc": "蓮實和堇怜啊，",
          "sc": "莲实和堇怜啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393553,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの傷を見ると、",
          "tc": "他們每次只要一看到我的傷口，",
          "sc": "他们每次只要一看到我的伤口，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393560,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悲しそうな申し訳なさそうな",
          "tc": "都會露出",
          "sc": "都会露出"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393567,
          "spk": "琪娜娜 (チナナ)",
          "ja": "顔をするんだよ",
          "tc": "悲傷又愧疚的表情。",
          "sc": "悲伤又愧疚的表情。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393576,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチとしては、ハスミとスミレを",
          "tc": "……雖然我對於自己有保護好蓮實和堇怜、",
          "sc": "……虽然我对于自己有保护好莲实和堇怜、"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393583,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無傷で守り通したことは、",
          "tc": "他們兩個人都毫髮無傷這件事，",
          "sc": "他们两个人都毫发无伤这件事，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393590,
          "spk": "琪娜娜 (チナナ)",
          "ja": "誇っていいことだと思っているんだけどね",
          "tc": "是非常引以為傲的。",
          "sc": "是非常引以为傲的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7902,
      "rec_id": "TALK_ID_70_2150_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393606,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ねえ、<player>",
          "tc": "……我問你，<player>。",
          "sc": "……我问你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393615,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチが長い間ハスミとスミレの",
          "tc": "你覺得我長時間以來",
          "sc": "你觉得我长时间以来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393622,
          "spk": "琪娜娜 (チナナ)",
          "ja": "代わりにやってきたことは、",
          "tc": "代替蓮實和堇怜做的那些",
          "sc": "代替莲实和堇怜做的那些"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393629,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よかったと思うかい？",
          "tc": "是好的嗎？",
          "sc": "是好的吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393638,
          "spk": "主角心声/旁白/选项",
          "ja": "よかった",
          "tc": "是好的",
          "sc": "是好的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393645,
          "spk": "主角心声/旁白/选项",
          "ja": "よくない",
          "tc": "不太好",
          "sc": "不太好"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7903,
      "rec_id": "TALK_ID_70_2150_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393721,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……答えにくいことを",
          "tc": "……抱歉問了你",
          "sc": "……抱歉问了你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393728,
          "spk": "琪娜娜 (チナナ)",
          "ja": "質問して悪かったね",
          "tc": "這麼難回答的問題。",
          "sc": "这么难回答的问题。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393737,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミの言葉には",
          "tc": "總覺得你講話",
          "sc": "总觉得你讲话"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393744,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嘘がない気がして",
          "tc": "都很真誠，",
          "sc": "都很真诚，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393751,
          "spk": "琪娜娜 (チナナ)",
          "ja": "つい聞きたくなっちゃうんだ",
          "tc": "所以讓我忍不住想問你。",
          "sc": "所以让我忍不住想问你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393760,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あのね、<player>",
          "tc": "……那個啊，<player>，",
          "sc": "……那个啊，<player>，"
        },
