        },
        {
          "f_idx": 19,
          "pidx_tc": 465146,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、もう一つ、",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 465153,
          "spk": "琪娜娜 (チナナ)",
          "ja": "伝えとくことがあるんだった",
          "tc": "還有一件事得先告訴你。",
          "sc": "还有一件事得先告诉你。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 465164,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カタログで注文する場合、",
          "tc": "透過目錄訂購商品時，",
          "sc": "透过目录订购商品时，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 465171,
          "spk": "琪娜娜 (チナナ)",
          "ja": "少しだけ手数料をいただくよ",
          "tc": "會收取一點手續費喔。",
          "sc": "会收取一点手续费哦。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 465182,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<strong>家具の値段に、価格の5％だけ",
          "tc": "<strong>訂購時會在",
