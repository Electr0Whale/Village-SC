          "f_idx": 15,
          "pidx_tc": 465102,
          "spk": "琪娜娜 (チナナ)",
          "ja": "その辺はよく考えておくれ",
          "tc": "所以要好好考慮一下。",
          "sc": "所以要好好考虑一下。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 465115,
          "spk": "茶梅 (サザンカ)",
          "ja": "一日に五種類までかぁ",
          "tc": "一天只能訂五種啊。",
          "sc": "一天只能订五种啊。"
