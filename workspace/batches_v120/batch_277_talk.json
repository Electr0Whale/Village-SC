    {
      "file": "talk.dat",
      "rec_idx": 7911,
      "rec_id": "TALK_ID_90_2001_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 464979,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それは、ウチからの素敵なプレゼント、",
          "tc": "這就是我要給你的超棒禮物，",
          "sc": "这就是我要给你的超棒礼物，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 464986,
          "spk": "琪娜娜 (チナナ)",
          "ja": "家具の「カタログ」さ！",
          "tc": "家具的「目錄」！",
          "sc": "家具的“目录”！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 464995,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一度でも手に入れた家具なら、",
          "tc": "只要是曾獲得過的家具，",
          "sc": "只要是曾获得过的家具，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 465002,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう一度注文できる便利なシロモノだよ",
          "tc": "都能透過它再次訂購，非常方便。",
          "sc": "都能透过它再次订购，非常方便。"
