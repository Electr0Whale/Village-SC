          "pidx_tc": 465045,
          "spk": "琪娜娜 (チナナ)",
          "ja": "欲しいものを選んで注文してくれれば、",
          "tc": "只要選好想要的商品下單訂購，",
          "sc": "只要选好想要的商品下单订购，"
        },
