    {
      "file": "talk.dat",
      "rec_idx": 7655,
      "rec_id": "TALK_ID_70_2120_009_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438388,
          "spk": "裕太 (ユータ)",
          "ja": "俺は昔から、大事にしたいものには",
          "tc": "我從以前就有幫重要的東西",
          "sc": "我从以前就有帮重要的东西"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438395,
          "spk": "裕太 (ユータ)",
          "ja": "名前をつけるようにしているんだ",
          "tc": "取名字的習慣。",
          "sc": "取名字的习惯。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438406,
          "spk": "裕太 (ユータ)",
          "ja": "名前があったほうが愛着も湧いて",
          "tc": "有名字就會更有感情，",
          "sc": "有名字就会更有感情，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438413,
          "spk": "裕太 (ユータ)",
          "ja": "友達みたいに思えるでしょ",
          "tc": "變得像朋友一樣。",
          "sc": "变得像朋友一样。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438431,
          "spk": "裕太 (ユータ)",
          "ja": "本当は、養蜂箱のミツバチたちにも",
          "tc": "其實我也很想幫",
          "sc": "其实我也很想帮"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438438,
          "spk": "裕太 (ユータ)",
          "ja": "名前をつけてあげたいんだけども……",
          "tc": "養蜂箱的蜜蜂取名字……",
          "sc": "养蜂箱的蜜蜂取名字……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438449,
          "spk": "裕太 (ユータ)",
          "ja": "まったく見分けがつかなくて",
          "tc": "但我實在是分不出誰是誰，",
          "sc": "但我实在是分不出谁是谁，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438456,
          "spk": "裕太 (ユータ)",
          "ja": "諦めちゃったんだよね",
          "tc": "所以就只好放棄了。",
          "sc": "所以就只好放弃了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7656,
      "rec_id": "TALK_ID_70_2120_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438480,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>、よく来たね！",
          "tc": "啊，<player>你來啦！",
          "sc": "啊，<player>你来啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438487,
          "spk": "裕太 (ユータ)",
          "ja": "待ってたんだよ！",
          "tc": "等你很久了！",
          "sc": "等你很久了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438498,
          "spk": "裕太 (ユータ)",
          "ja": "こんな時間に、",
          "tc": "有人在這個時間來拜訪，",
          "sc": "有人在这个时间来拜访，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438505,
          "spk": "裕太 (ユータ)",
          "ja": "誰かが訪ねてくるなんて",
          "tc": "真是新鮮的感覺呢，",
          "sc": "真是新鲜的感觉呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438512,
          "spk": "裕太 (ユータ)",
          "ja": "新鮮で嬉しいよ",
          "tc": "我很開心喔。",
          "sc": "我很开心哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7657,
      "rec_id": "TALK_ID_70_2120_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438530,
          "spk": "裕太 (ユータ)",
          "ja": "ああ……これかい？",
          "tc": "哦……這個嗎？",
          "sc": "哦……这个吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438537,
          "spk": "裕太 (ユータ)",
          "ja": "キミが来るまで、少しだけ触ってたんだ",
          "tc": "在你來之前，我只是稍微碰一下。",
          "sc": "在你来之前，我只是稍微碰一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7658,
      "rec_id": "TALK_ID_70_2120_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438555,
          "spk": "裕太 (ユータ)",
          "ja": "これから、どう向き合えばいいのか……",
          "tc": "今後要怎麼面對大提琴……",
          "sc": "今后要怎么面对大提琴……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438562,
          "spk": "裕太 (ユータ)",
          "ja": "……ずっと考えててね",
          "tc": "……我一直都在思考這件事。",
          "sc": "……我一直都在思考这件事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438573,
          "spk": "裕太 (ユータ)",
          "ja": "チェロを弾くことが俺の価値だと信じてた……",
          "tc": "我曾經相信演奏大提琴就是我的價值……",
          "sc": "我曾经相信演奏大提琴就是我的价值……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438580,
          "spk": "裕太 (ユータ)",
          "ja": "だから、弾けなくなった俺には、",
          "tc": "所以，無法演奏大提琴的我",
          "sc": "所以，无法演奏大提琴的我"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438587,
          "spk": "裕太 (ユータ)",
          "ja": "存在価値がないと思ってた……",
          "tc": "就沒有存在價值了……",
          "sc": "就没有存在价值了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438598,
          "spk": "裕太 (ユータ)",
          "ja": "でも、彼ヶ津村に来て、暮して……",
          "tc": "但是，我來到彼津村、在這裡生活……",
          "sc": "但是，我来到彼津村、在这里生活……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438605,
          "spk": "裕太 (ユータ)",
          "ja": "色々な体験をして、知ったんだ",
          "tc": "經歷了各種事情之後，我了解到，",
          "sc": "经历了各种事情之后，我了解到，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438623,
          "spk": "裕太 (ユータ)",
          "ja": "音楽を、辞めても辞めなくても、",
          "tc": "無論我會不會繼續碰音樂，",
          "sc": "无论我会不会继续碰音乐，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 438630,
          "spk": "裕太 (ユータ)",
          "ja": "俺の価値なんて、変わらないんだってことを",
          "tc": "都不會改變我的價值。",
          "sc": "都不会改变我的价值。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 438637,
          "spk": "裕太 (ユータ)",
          "ja": "何かを諦めても、人生は続いていくんだ……",
          "tc": "無論放棄了什麼，人生都會繼續下去……",
          "sc": "无论放弃了什么，人生都会继续下去……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 438648,
          "spk": "裕太 (ユータ)",
          "ja": "……うん、やっぱりしばらくは、",
          "tc": "……嗯，我想暫時",
          "sc": "……嗯，我想暂时"
        },
        {
          "f_idx": 12,
          "pidx_tc": 438655,
          "spk": "裕太 (ユータ)",
          "ja": "俺の大好きな彼ヶ津村の人たちに",
          "tc": "只要能讓我最喜歡的彼津村的人們",
          "sc": "只要能让我最喜欢的彼津村的人们"
        },
        {
          "f_idx": 13,
          "pidx_tc": 438662,
          "spk": "裕太 (ユータ)",
          "ja": "聞いてもらうだけで十分だね",
          "tc": "聽聽我的演奏就足夠了。",
          "sc": "听听我的演奏就足够了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 438673,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだから、一曲弾いてあげようか",
          "tc": "機會難得，演奏一首曲子給你聽吧。",
          "sc": "机会难得，演奏一首曲子给你听吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 438680,
          "spk": "裕太 (ユータ)",
          "ja": "もう夜だから、少しだけ静かに弾くけど",
          "tc": "夜晚降臨了，我會放低音量演奏，",
