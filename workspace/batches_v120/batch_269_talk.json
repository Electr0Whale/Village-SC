        },
        {
          "f_idx": 16,
          "pidx_tc": 438687,
          "spk": "裕太 (ユータ)",
          "ja": "どんな曲がいい？",
          "tc": "你想聽什麼樣的曲子？",
          "sc": "你想听什么样的曲子？"
        }
      ]
    },
    {
      "file": "talk.dat",
