  ],
  "record_count": 23,
  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7641,
      "rec_id": "TALK_ID_70_2120_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436694,
          "spk": "裕太 (ユータ)",
          "ja": "あの時、先輩が声をかけてくれなかったら",
          "tc": "當時，要不是學長找我說話，",
          "sc": "当时，要不是学长找我说话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436701,
          "spk": "裕太 (ユータ)",
          "ja": "俺は生まれ変わることもなかった",
          "tc": "我也不可能像現在這樣再活一次。",
          "sc": "我也不可能像现在这样再活一次。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436712,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、死んでいただけだろうな",
          "tc": "沒有他，我大概早就已經死了吧。",
          "sc": "没有他，我大概早就已经死了吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 436730,
          "spk": "裕太 (ユータ)",
          "ja": "……本当は",
          "tc": "……其實，",
          "sc": "……其实，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 436737,
          "spk": "裕太 (ユータ)",
          "ja": "わかってたんだ",
          "tc": "我都知道的。",
          "sc": "我都知道的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 436746,
          "spk": "裕太 (ユータ)",
          "ja": "先輩は、大学の先輩じゃなくて",
          "tc": "學長他根本就不是我的大學學長，",
          "sc": "学长他根本就不是我的大学学长，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 436753,
          "spk": "裕太 (ユータ)",
          "ja": "ただの通りすがりの人で……",
          "tc": "他只不過是剛好路過罷了……",
          "sc": "他只不过是刚好路过罢了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 436764,
          "spk": "裕太 (ユータ)",
          "ja": "駅のホームでふらふらしてた俺を心配して",
          "tc": "他是看我在月台上搖搖晃晃的，很擔心，",
          "sc": "他是看我在月台上摇摇晃晃的，很担心，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 436771,
          "spk": "裕太 (ユータ)",
          "ja": "とっさに嘘をついてくれたってこと",
          "tc": "所以在情急之下就撒了謊。",
          "sc": "所以在情急之下就撒了谎。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 436787,
          "spk": "裕太 (ユータ)",
          "ja": "死ぬまでにやりたいことリストだって",
          "tc": "「死前願望清單」這種東西，",
          "sc": "“死前愿望清单”这种东西，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 436794,
          "spk": "裕太 (ユータ)",
          "ja": "俺があそこで死ななくてもいいように",
          "tc": "也是學長為了不讓我死在那裡，",
          "sc": "也是学长为了不让我死在那里，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 436801,
          "spk": "裕太 (ユータ)",
          "ja": "先輩がとっさに考えてくれたことなんだ",
          "tc": "情急之下想出來的東西。",
          "sc": "情急之下想出来的东西。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 436812,
          "spk": "裕太 (ユータ)",
          "ja": "……俺は先輩の嘘に甘えて",
          "tc": "……而我則是接受了學長的謊言，",
          "sc": "……而我则是接受了学长的谎言，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 436819,
          "spk": "裕太 (ユータ)",
          "ja": "生まれ変わることにしたんだよ",
          "tc": "選擇重新再活一次。",
          "sc": "选择重新再活一次。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7642,
      "rec_id": "TALK_ID_70_2120_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436837,
          "spk": "裕太 (ユータ)",
          "ja": "ああ、ごめんね",
          "tc": "啊，抱歉啦，",
          "sc": "啊，抱歉啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436844,
          "spk": "裕太 (ユータ)",
          "ja": "心配しなくても大丈夫だよ",
          "tc": "你不用擔心的，",
          "sc": "你不用担心的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436851,
          "spk": "裕太 (ユータ)",
          "ja": "今は元気だから",
          "tc": "我現在很有活力喔。",
          "sc": "我现在很有活力哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436862,
          "spk": "裕太 (ユータ)",
          "ja": "……俺、思うんだ",
          "tc": "……我在想，",
          "sc": "……我在想，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 436873,
          "spk": "裕太 (ユータ)",
          "ja": "きっと人には、触れられたくない過去とか",
          "tc": "人應該多多少少",
          "sc": "人应该多多少少"
        },
        {
          "f_idx": 5,
          "pidx_tc": 436880,
          "spk": "裕太 (ユータ)",
          "ja": "どうしようもなくて抱えてしまった罪とか",
          "tc": "都會有不想被觸碰的過去，",
          "sc": "都会有不想被触碰的过去，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 436887,
          "spk": "裕太 (ユータ)",
          "ja": "そういうものが、一つや二つあるんじゃないかな",
          "tc": "或者不得不背負的罪孽吧。",
          "sc": "或者不得不背负的罪孽吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 436898,
          "spk": "裕太 (ユータ)",
          "ja": "俺は一度、そこで苦しんで",
          "tc": "我曾經因此深受痛苦，",
          "sc": "我曾经因此深受痛苦，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 436905,
          "spk": "裕太 (ユータ)",
          "ja": "音楽を投げ出してしまったけど",
          "tc": "並放棄了音樂。",
          "sc": "并放弃了音乐。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 436916,
          "spk": "裕太 (ユータ)",
          "ja": "今は、そうやって苦しんでいる人を",
          "tc": "但我現在卻想要用音樂",
          "sc": "但我现在却想要用音乐"
        },
        {
          "f_idx": 10,
          "pidx_tc": 436923,
          "spk": "裕太 (ユータ)",
          "ja": "音楽で支えてあげたいと思うよ",
          "tc": "去幫助那些正在痛苦掙扎的人們。",
          "sc": "去帮助那些正在痛苦挣扎的人们。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 436934,
          "spk": "裕太 (ユータ)",
          "ja": "救いたいなんて言葉は",
          "tc": "雖然想要拯救他們什麼的，",
          "sc": "虽然想要拯救他们什么的，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 436941,
          "spk": "裕太 (ユータ)",
          "ja": "おこがましくて言えないけど",
          "tc": "感覺有點太自大了，",
          "sc": "感觉有点太自大了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 436948,
          "spk": "裕太 (ユータ)",
          "ja": "そっと、寄り添えたらいいよね",
          "tc": "但我希望能默默地在一旁陪伴著他們。",
          "sc": "但我希望能默默地在一旁陪伴着他们。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 436959,
          "spk": "裕太 (ユータ)",
          "ja": "……こんなふうに考えられるようになったのは",
          "tc": "……我現在能夠有這種想法，",
          "sc": "……我现在能够有这种想法，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 436966,
          "spk": "裕太 (ユータ)",
          "ja": "キミが寄り添ってくれたことも大きいんだ",
          "tc": "也是因為你一直都陪在我的身邊。",
          "sc": "也是因为你一直都陪在我的身边。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 436984,
          "spk": "裕太 (ユータ)",
          "ja": "だから……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 436991,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとうね、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 436998,
          "spk": "裕太 (ユータ)",
          "ja": "感謝してるよ",
          "tc": "真的很感謝你。",
          "sc": "真的很感谢你。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 437009,
          "spk": "裕太 (ユータ)",
          "ja": "……気が変わった",
          "tc": "……我改變主意了，",
          "sc": "……我改变主意了，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 437016,
          "spk": "裕太 (ユータ)",
          "ja": "もう一曲、弾いてから帰ろうかな",
          "tc": "還是再演奏一曲之後再回去吧。",
          "sc": "还是再演奏一曲之后再回去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7643,
      "rec_id": "TALK_ID_70_2120_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437040,
          "spk": "裕太 (ユータ)",
          "ja": "よく来たね、<player>",
          "tc": "<player>，你來了啊。",
          "sc": "<player>，你来了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437047,
          "spk": "裕太 (ユータ)",
          "ja": "今日はキミに「ざるうどん」を",
          "tc": "今天我要請你吃",
          "sc": "今天我要请你吃"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437054,
          "spk": "裕太 (ユータ)",
          "ja": "ご馳走するよ",
          "tc": "「竹籠烏龍麵」。",
          "sc": "“竹笼乌冬面”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437065,
          "spk": "裕太 (ユータ)",
          "ja": "麺は、俺が手打ちしたんだよ",
          "tc": "麵條可是我從麵粉開始，",
          "sc": "面条可是我从面粉开始，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437072,
          "spk": "裕太 (ユータ)",
          "ja": "粉からこだわって作ってるからね",
          "tc": "處處講究地親手做出來的喔！",
          "sc": "处处讲究地亲手做出来的哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437090,
          "spk": "裕太 (ユータ)",
          "ja": "冷たい出汁と一緒に",
          "tc": "配上冰涼的高湯一起吃",
          "sc": "配上冰凉的高汤一起吃"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437097,
          "spk": "裕太 (ユータ)",
          "ja": "食べると最高なんだ",
          "tc": "最讚了。",
          "sc": "最赞了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437104,
          "spk": "裕太 (ユータ)",
          "ja": "どうぞ、食べてみてよ",
          "tc": "來，吃吃看吧。",
          "sc": "来，吃吃看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7644,
      "rec_id": "TALK_ID_70_2120_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437128,
          "spk": "裕太 (ユータ)",
          "ja": "手打ちうどんは",
          "tc": "距離我上次",
          "sc": "距离我上次"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437135,
          "spk": "裕太 (ユータ)",
          "ja": "最近あまりやってなくて",
          "tc": "做手工烏龍麵，",
          "sc": "做手工乌冬面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437142,
          "spk": "裕太 (ユータ)",
          "ja": "久しぶりなんだ",
          "tc": "其實已經有一段時間了。",
          "sc": "其实已经有一段时间了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437153,
          "spk": "裕太 (ユータ)",
          "ja": "村に来てすぐの頃は",
          "tc": "在剛來村子的那段期間，",
          "sc": "在刚来村子的那段期间，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437160,
          "spk": "裕太 (ユータ)",
          "ja": "よく作ってたんだけど……",
          "tc": "我常常會做來吃……",
          "sc": "我常常会做来吃……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 437171,
          "spk": "裕太 (ユータ)",
          "ja": "うどんって、コシを出すために",
          "tc": "在做烏龍麵的時候啊，為了要讓麵有嚼勁，",
          "sc": "在做乌冬面的时候啊，为了要让面有嚼劲，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437178,
          "spk": "裕太 (ユータ)",
          "ja": "足で踏む作業があってね",
          "tc": "有一道要用腳踩的步驟。",
          "sc": "有一道要用脚踩的步骤。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437185,
          "spk": "裕太 (ユータ)",
          "ja": "これがすごく楽しいんだ",
          "tc": "那個真的很好玩呢。",
          "sc": "那个真的很好玩呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437196,
          "spk": "裕太 (ユータ)",
          "ja": "俺はいつもテンションが上がって",
          "tc": "每次做到那裡，我都會很興奮，",
          "sc": "每次做到那里，我都会很兴奋，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 437203,
          "spk": "裕太 (ユータ)",
          "ja": "うどんの上で歌ったり踊ったりしてるよ",
          "tc": "會踩在麵團上又唱又跳的。",
          "sc": "会踩在面团上又唱又跳的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 437221,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、ある日そこを",
          "tc": "結果有一天，",
          "sc": "结果有一天，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 437228,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんに見られちゃってね",
          "tc": "就被小洋撞見了我又唱又跳的樣子，",
          "sc": "就被小洋撞见了我又唱又跳的样子，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 437235,
          "spk": "裕太 (ユータ)",
          "ja": "あれは恥ずかしかったなあ……",
          "tc": "真的是丟臉到不行……",
          "sc": "真的是丢脸到不行……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 437246,
          "spk": "裕太 (ユータ)",
          "ja": "それ以来、作る",
          "tc": "從那之後，",
          "sc": "从那之后，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 437253,
          "spk": "裕太 (ユータ)",
          "ja": "回数を減らしてるんだ",
          "tc": "我做烏龍麵的次數就慢慢減少了。",
          "sc": "我做乌冬面的次数就慢慢减少了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 437264,
          "spk": "裕太 (ユータ)",
          "ja": "でもやっぱり",
          "tc": "但果然",
          "sc": "但果然"
        },
        {
          "f_idx": 17,
          "pidx_tc": 437271,
          "spk": "裕太 (ユータ)",
          "ja": "手打ちすると",
          "tc": "還是手工製作的",
          "sc": "还是手工制作的"
        },
        {
          "f_idx": 18,
          "pidx_tc": 437278,
          "spk": "裕太 (ユータ)",
          "ja": "美味しいよね",
          "tc": "比較好吃呢。",
          "sc": "比较好吃呢。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 437289,
          "spk": "裕太 (ユータ)",
          "ja": "均一に切るのが難しくて",
          "tc": "雖然麵條很難切得一模一樣，",
          "sc": "虽然面条很难切得一模一样，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 437296,
          "spk": "裕太 (ユータ)",
          "ja": "麺の太さがバラバラなのが",
          "tc": "所以粗細不一",
          "sc": "所以粗细不一"
        },
        {
          "f_idx": 21,
          "pidx_tc": 437303,
          "spk": "裕太 (ユータ)",
          "ja": "欠点なんだけど",
          "tc": "是個缺點。",
          "sc": "是个缺点。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 437312,
          "spk": "裕太 (ユータ)",
          "ja": "うどんの太さが揃ってないの、気になるかな？",
          "tc": "你會在意烏龍麵的粗細有沒有一致嗎？",
          "sc": "你会在意乌冬面的粗细有没有一致吗？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 437328,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 437335,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7645,
      "rec_id": "TALK_ID_70_2120_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437410,
          "spk": "裕太 (ユータ)",
          "ja": "うどん作り、もっと極めたくなってきたな",
          "tc": "我想要更精進自己做烏龍麵的手藝。",
          "sc": "我想要更精进自己做乌冬面的手艺。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437435,
          "spk": "裕太 (ユータ)",
          "ja": "いつか、出汁に使うかつお節から自作して",
          "tc": "希望有一天，我能從熬湯的柴魚片開始，",
          "sc": "希望有一天，我能从熬汤的柴鱼片开始，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437442,
          "spk": "裕太 (ユータ)",
          "ja": "全部が手作りのうどんを作ってみたい",
          "tc": "做出一碗全手工的烏龍麵。",
          "sc": "做出一碗全手工的乌冬面。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437460,
          "spk": "裕太 (ユータ)",
          "ja": "完成したらキミに",
          "tc": "等完成之後，",
          "sc": "等完成之后，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437467,
          "spk": "裕太 (ユータ)",
          "ja": "一番に食べてもらうからね",
          "tc": "會讓你第一個品嘗的。",
          "sc": "会让你第一个品尝的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7646,
      "rec_id": "TALK_ID_70_2120_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437491,
          "spk": "裕太 (ユータ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>。",
          "sc": "欢迎光临，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437498,
          "spk": "裕太 (ユータ)",
          "ja": "待ってたよ",
          "tc": "我就等你了呢。",
          "sc": "我就等你了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7647,
      "rec_id": "TALK_ID_70_2120_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437522,
          "spk": "裕太 (ユータ)",
          "ja": "今日のメニューは",
          "tc": "今天的料理是",
          "sc": "今天的料理是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437529,
          "spk": "裕太 (ユータ)",
          "ja": "「ビーフシチュー」だよ",
          "tc": "「燉牛肉」喔。",
          "sc": "“炖牛肉”哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437536,
          "spk": "裕太 (ユータ)",
          "ja": "ロッカクさんに作ってもらったんだ",
          "tc": "這是六角叔幫我們做的，",
          "sc": "这是六角叔帮我们做的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437547,
          "spk": "裕太 (ユータ)",
          "ja": "熱々のうちに食べよう",
          "tc": "趕快趁熱吃吧。",
          "sc": "赶快趁热吃吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437554,
          "spk": "裕太 (ユータ)",
          "ja": "いただきます！",
          "tc": "我要開動了！",
          "sc": "我要开动了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7648,
      "rec_id": "TALK_ID_70_2120_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437578,
          "spk": "裕太 (ユータ)",
          "ja": "ビーフシチューって",
          "tc": "說到燉牛肉啊，",
          "sc": "说到炖牛肉啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437585,
          "spk": "裕太 (ユータ)",
          "ja": "俺が村に来た時には",
          "tc": "我剛到村子裡的時候，",
          "sc": "我刚到村子里的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437592,
          "spk": "裕太 (ユータ)",
          "ja": "食堂にない料理だったんだ",
          "tc": "餐廳還沒有這道料理。",
          "sc": "餐厅还没有这道料理。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437603,
          "spk": "裕太 (ユータ)",
          "ja": "だからレシピを教えて",
          "tc": "所以我就把食譜告訴餐廳，",
          "sc": "所以我就把食谱告诉餐厅，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437610,
          "spk": "裕太 (ユータ)",
          "ja": "メニューに追加して",
          "tc": "請他把這道料理",
          "sc": "请他把这道料理"
        },
        {
          "f_idx": 5,
          "pidx_tc": 437617,
          "spk": "裕太 (ユータ)",
          "ja": "もらったんだよ",
          "tc": "加到菜單上。",
          "sc": "加到菜单上。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437628,
          "spk": "裕太 (ユータ)",
          "ja": "ビーフシチューは",
          "tc": "我從以前",
          "sc": "我从以前"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437635,
          "spk": "裕太 (ユータ)",
          "ja": "昔から大好きな料理でね",
          "tc": "就很喜歡燉牛肉這道菜。",
          "sc": "就很喜欢炖牛肉这道菜。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437646,
          "spk": "裕太 (ユータ)",
          "ja": "初めて食べたのは",
          "tc": "我第一次吃到燉牛肉，",
          "sc": "我第一次吃到炖牛肉，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 437653,
          "spk": "裕太 (ユータ)",
          "ja": "親の仕事にくっついて",
          "tc": "是我跟著父母的工作",
          "sc": "是我跟着父母的工作"
        },
        {
          "f_idx": 10,
          "pidx_tc": 437660,
          "spk": "裕太 (ユータ)",
          "ja": "海外に行った時なんだけど",
          "tc": "去國外的時候。",
          "sc": "去国外的时候。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 437671,
          "spk": "裕太 (ユータ)",
          "ja": "一口食べて惚れ込んじゃった",
          "tc": "我才吃了一口就愛上了。",
          "sc": "我才吃了一口就爱上了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 437678,
          "spk": "裕太 (ユータ)",
          "ja": "こんなに完璧で美味しい料理が",
          "tc": "沒想到世界上竟然有這麼完美又好吃的料理，",
          "sc": "没想到世界上竟然有这么完美又好吃的料理，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 437685,
          "spk": "裕太 (ユータ)",
          "ja": "あるんだって、衝撃だったな",
          "tc": "當時真的是大受震撼呢。",
          "sc": "当时真的是大受震撼呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 437696,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、ビーフシチューには",
          "tc": "但是只要一說到燉牛肉，",
          "sc": "但是只要一说到炖牛肉，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 437703,
          "spk": "裕太 (ユータ)",
          "ja": "一つ難しい問題があってね",
          "tc": "就會出現一個難題。",
          "sc": "就会出现一个难题。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 437714,
          "spk": "裕太 (ユータ)",
          "ja": "ライスとパン、どちらと",
          "tc": "就是燉牛肉究竟該配白飯吃好，",
          "sc": "就是炖牛肉究竟该配白饭吃好，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 437721,
          "spk": "裕太 (ユータ)",
          "ja": "一緒に食べるべきか？",
          "tc": "還是配麵包吃才好？",
          "sc": "还是配面包吃才好？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 437730,
          "spk": "裕太 (ユータ)",
          "ja": "これは大きな論争を巻き起こす",
          "tc": "這是個可能會掀起大爭論的",
          "sc": "这是个可能会掀起大争论的"
        },
        {
          "f_idx": 19,
          "pidx_tc": 437737,
          "spk": "裕太 (ユータ)",
          "ja": "可能性がある、重大な問題だよ",
          "tc": "重大問題。",
          "sc": "重大问题。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 437748,
          "spk": "裕太 (ユータ)",
          "ja": "ちなみに……",
          "tc": "順便問一下……",
          "sc": "顺便问一下……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 437755,
          "spk": "裕太 (ユータ)",
          "ja": "キミはライスとパン",
          "tc": "白飯跟麵包，",
          "sc": "白饭跟面包，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 437762,
          "spk": "裕太 (ユータ)",
          "ja": "どっちが好きかな？",
          "tc": "你比較喜歡配哪個吃啊？",
          "sc": "你比较喜欢配哪个吃啊？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 437771,
          "spk": "主角心声/旁白/选项",
          "ja": "ライス",
          "tc": "白飯",
          "sc": "白饭"
        },
        {
          "f_idx": 24,
          "pidx_tc": 437778,
          "spk": "主角心声/旁白/选项",
          "ja": "パン",
          "tc": "麵包",
          "sc": "面包"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7649,
      "rec_id": "TALK_ID_70_2120_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437882,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、俺？",
          "tc": "咦，你問我嗎？",
          "sc": "咦，你问我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437893,
          "spk": "裕太 (ユータ)",
          "ja": "ええっと……そうだな……",
          "tc": "呃……我想想……",
          "sc": "呃……我想想……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437900,
          "spk": "裕太 (ユータ)",
          "ja": "うーん……甲乙つけがたい……",
          "tc": "嗯……好難決定啊……",
          "sc": "嗯……好难决定啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437911,
          "spk": "裕太 (ユータ)",
          "ja": "……実を言うとね",
          "tc": "……老實說，",
          "sc": "……老实说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437922,
          "spk": "裕太 (ユータ)",
          "ja": "余ったビーフシチューを",
          "tc": "把剩下來的燉牛肉",
          "sc": "把剩下来的炖牛肉"
        },
        {
          "f_idx": 5,
          "pidx_tc": 437929,
          "spk": "裕太 (ユータ)",
          "ja": "コロッケに入れたやつが",
          "tc": "包進可樂餅裡面，",
          "sc": "包进可乐饼里面，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437936,
          "spk": "裕太 (ユータ)",
          "ja": "一番好きなんだ",
          "tc": "是我最喜歡的吃法。",
          "sc": "是我最喜欢的吃法。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437947,
          "spk": "裕太 (ユータ)",
          "ja": "今度、ロッカクさんに頼んで",
          "tc": "乾脆下次拜託六角叔",
          "sc": "干脆下次拜托六角叔"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437954,
          "spk": "裕太 (ユータ)",
          "ja": "作ってもらおうかな",
          "tc": "幫我做好了。",
          "sc": "帮我做好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7650,
      "rec_id": "TALK_ID_70_2120_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437978,
          "spk": "裕太 (ユータ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>。",
          "sc": "欢迎光临，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437985,
          "spk": "裕太 (ユータ)",
          "ja": "いいタイミングで来てくれたね",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437994,
          "spk": "裕太 (ユータ)",
          "ja": "ちょうど今日のメニュー「いももち」が",
          "tc": "今日的料理「馬鈴薯麻糬」",
          "sc": "今日的料理“土豆年糕”"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438001,
          "spk": "裕太 (ユータ)",
          "ja": "できたてほやほやなんだ",
          "tc": "才剛出爐，熱呼呼的喔。",
          "sc": "才刚出炉，热呼呼的哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438012,
          "spk": "裕太 (ユータ)",
          "ja": "裏の畑で採れたジャガイモを",
          "tc": "這是我用",
          "sc": "这是我用"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438019,
          "spk": "裕太 (ユータ)",
          "ja": "使って作ったんだよ",
          "tc": "自家種的馬鈴薯做的。",
          "sc": "自家种的土豆做的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438037,
          "spk": "裕太 (ユータ)",
          "ja": "さっそく食べよう",
          "tc": "我們趕快開動吧。",
          "sc": "我们赶快开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7651,
      "rec_id": "TALK_ID_70_2120_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438061,
          "spk": "裕太 (ユータ)",
          "ja": "熱いから火傷に注意してね",
          "tc": "小心別燙到了，",
          "sc": "小心别烫到了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438068,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんとフーフーするんだよ",
          "tc": "要好好吹涼喔。",
          "sc": "要好好吹凉哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438079,
          "spk": "裕太 (ユータ)",
          "ja": "タレはみたらし風にしてみたんだ",
          "tc": "醬汁是甜醬油，",
          "sc": "酱汁是甜酱油，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438086,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんとスミレくんにも",
          "tc": "堇怜和小洋",
          "sc": "堇怜和小洋"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438093,
          "spk": "裕太 (ユータ)",
          "ja": "好評だったから",
          "tc": "也都很喜歡喔。",
          "sc": "也都很喜欢哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438104,
          "spk": "裕太 (ユータ)",
          "ja": "……どう？",
          "tc": "……如何？",
          "sc": "……如何？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438111,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんと美味しく出来てる？",
          "tc": "我做的好吃嗎？",
          "sc": "我做的好吃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7652,
      "rec_id": "TALK_ID_70_2120_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438129,
          "spk": "裕太 (ユータ)",
          "ja": "よかったぁー",
          "tc": "太好了～！",
          "sc": "太好了～！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438136,
          "spk": "裕太 (ユータ)",
          "ja": "できたては、柔らかくて",
          "tc": "剛出爐的馬鈴薯麻糬既柔軟又Q彈，",
          "sc": "刚出炉的土豆年糕既柔软又Q弹，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438143,
          "spk": "裕太 (ユータ)",
          "ja": "もちもちでいいよねえ……",
          "tc": "很好吃對吧……",
          "sc": "很好吃对吧……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438154,
          "spk": "裕太 (ユータ)",
          "ja": "……あっ、そうだ！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438161,
          "spk": "裕太 (ユータ)",
          "ja": "裏の畑といえば……",
          "tc": "說到我家的田地……",
          "sc": "说到我家的田地……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7653,
      "rec_id": "TALK_ID_70_2120_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438179,
          "spk": "裕太 (ユータ)",
          "ja": "やらなきゃいけないことが",
          "tc": "我忘記有件",
          "sc": "我忘记有件"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438186,
          "spk": "裕太 (ユータ)",
          "ja": "あるのを忘れていたよ……",
          "tc": "不得不做的事情……",
          "sc": "不得不做的事情……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438197,
          "spk": "裕太 (ユータ)",
          "ja": "「監督」の服が古くなってるから",
          "tc": "「總管」的衣服越來越舊了，",
          "sc": "“总管”的衣服越来越旧了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438204,
          "spk": "裕太 (ユータ)",
          "ja": "新調してあげようと思っていたんだ",
          "tc": "我想找件新的給他。",
          "sc": "我想找件新的给他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7654,
      "rec_id": "TALK_ID_70_2120_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438229,
          "spk": "裕太 (ユータ)",
          "ja": "あ、監督がわからないかい？",
          "tc": "你不知道總管是誰嗎？",
          "sc": "你不知道总管是谁吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438236,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も会ったことあるはずだけど……",
          "tc": "<player>應該也有見過他才對……",
          "sc": "<player>应该也有见过他才对……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438247,
          "spk": "裕太 (ユータ)",
          "ja": "実は、俺の畑のカカシの名前なんだ",
          "tc": "其實就是我田地裡稻草人的名字。",
          "sc": "其实就是我田地里稻草人的名字。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438254,
          "spk": "裕太 (ユータ)",
          "ja": "キミもカカシを置いたら、",
          "tc": "你應該也懂架設了稻草人，",
          "sc": "你应该也懂架设了稻草人，"
