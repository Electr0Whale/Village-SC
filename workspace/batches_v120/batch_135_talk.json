        {
          "f_idx": 1,
          "pidx_tc": 89850,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんにも教えてあげようかな",
          "tc": "要不要也告訴叔叔呢。",
          "sc": "要不要也告诉叔叔呢。"
