  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2246,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_2821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87282,
          "spk": "洋 (ヨウ)",
          "ja": "なんだろう……？",
          "tc": "該怎麼說呢……？",
          "sc": "该怎么说呢……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87289,
          "spk": "洋 (ヨウ)",
          "ja": "お昼の時間が明るかったからかな",
          "tc": "不知道是不是因為白天很亮，",
          "sc": "不知道是不是因为白天很亮，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87296,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、お外がいつもよりも暗い気がする",
          "tc": "總感覺四周比平時還要暗呢。",
          "sc": "总感觉四周比平时还要暗呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2247,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_2822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87320,
          "spk": "洋 (ヨウ)",
          "ja": "もうすっかり暗くなっちゃったね",
          "tc": "天色已經完全暗下來了。",
          "sc": "天色已经完全暗下来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87327,
          "spk": "洋 (ヨウ)",
          "ja": "<player>は、お家に帰らなくていいの……？",
          "tc": "<player>你不回家好嗎……？",
          "sc": "<player>你不回家好吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2248,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_2823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87351,
          "spk": "洋 (ヨウ)",
          "ja": "この時間になると、",
          "tc": "到了這個時間，",
          "sc": "到了这个时间，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87358,
          "spk": "洋 (ヨウ)",
          "ja": "村のみんな、お家に帰りだすんだよ",
          "tc": "村裡的大家都會回家喔。",
          "sc": "村里的大家都会回家哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87369,
          "spk": "洋 (ヨウ)",
          "ja": "<player>も、お家に帰ったほうがいいよ",
          "tc": "<player>你也回家比較好。",
          "sc": "<player>你也回家比较好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 87376,
          "spk": "洋 (ヨウ)",
          "ja": "きっと、ワンちゃんが待ってるからね",
          "tc": "我想狗狗一定在等你！",
          "sc": "我想狗狗一定在等你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2249,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87400,
          "spk": "洋 (ヨウ)",
          "ja": "こうやって秋の川辺でお散歩することを",
          "tc": "像這樣秋天在河邊散步，",
          "sc": "像这样秋天在河边散步，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87407,
          "spk": "洋 (ヨウ)",
          "ja": "紅葉狩りっていうんだって",
          "tc": "就叫做賞楓喔。",
          "sc": "就叫做赏枫哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 87425,
          "spk": "洋 (ヨウ)",
          "ja": "なんで紅葉「狩り」なんだろうね？",
          "tc": "為什麼會叫做「賞」楓呢？",
          "sc": "为什么会叫做“赏”枫呢？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 87432,
          "spk": "洋 (ヨウ)",
          "ja": "なにも狩ったりしてないよ？",
          "tc": "明明也沒有獎品啊？",
          "sc": "明明也没有奖品啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2250,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87463,
          "spk": "洋 (ヨウ)",
          "ja": "この木、大きいね",
          "tc": "這棵樹好大喔。",
          "sc": "这棵树好大哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87470,
          "spk": "洋 (ヨウ)",
          "ja": "てっぺんからはどんな景色が見えるんだろ？",
          "tc": "從樹頂看的話會是什麼樣的景色呢？",
          "sc": "从树顶看的话会是什么样的景色呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87481,
          "spk": "洋 (ヨウ)",
          "ja": "……登ったら怒られるかな？",
          "tc": "……不知道爬上去會不會被罵？",
          "sc": "……不知道爬上去会不会被骂？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2251,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87512,
          "spk": "洋 (ヨウ)",
          "ja": "ここから釣りしたら、なにが釣れるのかな？",
          "tc": "在這裡釣魚的話，能釣到什麼呢？",
          "sc": "在这里钓鱼的话，能钓到什么呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87519,
          "spk": "洋 (ヨウ)",
          "ja": "今度、ユータさんを誘ってみようかな",
          "tc": "下次約裕太哥哥一起來好了。",
          "sc": "下次约裕太哥哥一起来好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2252,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87543,
          "spk": "洋 (ヨウ)",
          "ja": "いいな、ネコちゃんの模型……",
          "tc": "是貓咪的模型耶，真好……",
          "sc": "是猫咪的模型呀，真好……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87554,
          "spk": "洋 (ヨウ)",
          "ja": "……コマコちゃん、好きそう",
          "tc": "……感覺駒子姐姐會喜歡。",
          "sc": "……感觉驹子姐姐会喜欢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87561,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが取ってプレゼントしようかな……",
          "tc": "要不要轉出來送給她呢……",
          "sc": "要不要转出来送给她呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2253,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87585,
          "spk": "洋 (ヨウ)",
          "ja": "こういうのの中身って、",
          "tc": "這裡面的東西，",
          "sc": "这里面的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87592,
          "spk": "洋 (ヨウ)",
          "ja": "サザンカさんが入れ替えてるのかな",
          "tc": "都是茶梅姐姐負責交換的嗎？",
          "sc": "都是茶梅姐姐负责交换的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87599,
          "spk": "洋 (ヨウ)",
          "ja": "気になるね……",
          "tc": "真令人好奇……",
          "sc": "真令人好奇……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2254,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87623,
          "spk": "洋 (ヨウ)",
          "ja": "次に回したら何が出るかな……",
          "tc": "下次會轉到什麼呢……",
          "sc": "下次会转到什么呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87634,
          "spk": "洋 (ヨウ)",
          "ja": "んー見えそうで見えない……",
          "tc": "嗯～好像看得見，又好像看不見……",
          "sc": "嗯～好像看得见，又好像看不见……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2255,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87658,
          "spk": "洋 (ヨウ)",
          "ja": "わ、木の実がいっぱいだ",
          "tc": "哇，有好多果實啊。",
          "sc": "哇，有好多果实啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87665,
          "spk": "洋 (ヨウ)",
          "ja": "いっぱい拾っていこうね、オワン",
          "tc": "我們多撿一些回去吧，歐宛。",
          "sc": "我们多捡一些回去吧，欧宛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87676,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "イッパイ！　ヒロッテヒロッテ！",
          "tc": "撿很多！撿很多！",
          "sc": "捡很多！捡很多！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 87689,
          "spk": "洋 (ヨウ)",
          "ja": "あ、でも……",
          "tc": "啊，不過……",
          "sc": "啊，不过……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 87696,
          "spk": "洋 (ヨウ)",
          "ja": "オワンが食べられそうなのはないかも……",
          "tc": "好像沒有能給歐宛吃的……",
          "sc": "好像没有能给欧宛吃的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 87707,
          "spk": "洋 (ヨウ)",
          "ja": "あとでおじちゃんに",
          "tc": "晚點再請叔叔",
          "sc": "晚点再请叔叔"
        },
        {
          "f_idx": 6,
          "pidx_tc": 87714,
          "spk": "洋 (ヨウ)",
          "ja": "リンゴを剥いてもらおうね",
          "tc": "削蘋果給你吃吧。",
          "sc": "削苹果给你吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2256,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87738,
          "spk": "洋 (ヨウ)",
          "ja": "わ、ドングリがいっぱい落ちてる",
          "tc": "哇，地上有好多橡實喔。",
          "sc": "哇，地上有好多橡实哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87749,
          "spk": "洋 (ヨウ)",
          "ja": "ドングリって、爪楊枝を刺すとコマになるの",
          "tc": "只要把牙籤插在橡實上，就能當成陀螺喔，",
          "sc": "只要把牙签插在橡实上，就能当成陀螺哦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87756,
          "spk": "洋 (ヨウ)",
          "ja": "前にスミレくんに、教えてもらったんだよ",
          "tc": "這是堇怜哥哥之前教我的。",
          "sc": "这是堇怜哥哥之前教我的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2257,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87780,
          "spk": "洋 (ヨウ)",
          "ja": "このカキ……色がキレイで美味しそう",
          "tc": "這顆柿子……顏色好漂亮，感覺好像很好吃。",
          "sc": "这颗柿子……颜色好漂亮，感觉好像很好吃。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87798,
          "spk": "洋 (ヨウ)",
          "ja": "これを持って帰ったら、",
          "tc": "把這個拿回去的話，",
          "sc": "把这个拿回去的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 87805,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんがなにか作ってくれるかな？",
          "tc": "叔叔會不會用它做東西給我吃呢？",
          "sc": "叔叔会不会用它做东西给我吃呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2258,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3016",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87829,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>も来たんだ",
          "tc": "啊，<player>也來了啊。",
          "sc": "啊，<player>也来了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87840,
          "spk": "洋 (ヨウ)",
          "ja": "ここ、色んな木の実が落ちてて面白いよ",
          "tc": "這裡地上掉了各種果實，很有趣喔。",
          "sc": "这里地上掉了各种果实，很有趣哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87847,
          "spk": "洋 (ヨウ)",
          "ja": "一緒に探す？",
          "tc": "要一起找嗎？",
          "sc": "要一起找吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2259,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87878,
          "spk": "洋 (ヨウ)",
          "ja": "わぁ、すっごくキレイに折れちゃった",
          "tc": "哇，這次摺得好漂亮。",
          "sc": "哇，这次折得好漂亮。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87889,
          "spk": "洋 (ヨウ)",
          "ja": "これは後で、",
          "tc": "等一下把這個",
          "sc": "等一下把这个"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87896,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんにプレゼントしようかな",
          "tc": "送給叔叔好了。",
          "sc": "送给叔叔好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2260,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87920,
          "spk": "洋 (ヨウ)",
          "ja": "そういえば、キスケさんって",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87927,
          "spk": "洋 (ヨウ)",
          "ja": "折り紙をとってもキレイに折れるんだよ",
          "tc": "木助叔叔摺紙都摺得很漂亮喔。",
          "sc": "木助叔叔折纸都折得很漂亮哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87938,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱり大工さんって器用なんだね……",
          "tc": "果然木匠的手很巧呢……",
          "sc": "果然木匠的手很巧呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2261,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87962,
          "spk": "洋 (ヨウ)",
          "ja": "鶴を折りたいけど難しい……",
          "tc": "我想要摺紙鶴，但是好難喔……",
          "sc": "我想要折纸鹤，但是好难哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87969,
          "spk": "洋 (ヨウ)",
          "ja": "きれいに折るコツってないのかな",
          "tc": "要摺得漂亮是不是有什麼訣竅啊？",
          "sc": "要折得漂亮是不是有什么诀窍啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2262,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87993,
          "spk": "洋 (ヨウ)",
          "ja": "読書の感想って、なにを書けばいいんだろう",
          "tc": "讀書心得該寫些什麼呢？",
          "sc": "读书心得该写些什么呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88000,
          "spk": "洋 (ヨウ)",
          "ja": "読んで感じたこと？　知れたこと？",
          "tc": "讀過的感想？還是學到了什麼？",
          "sc": "读过的感想？还是学到了什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88007,
          "spk": "洋 (ヨウ)",
          "ja": "答えって、あるのかな",
          "tc": "不知道有沒有有標準答案？",
          "sc": "不知道有没有有标准答案？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2263,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88031,
          "spk": "洋 (ヨウ)",
          "ja": "……少しずつ、問題が難しくなってる気がする",
          "tc": "……感覺問題越來越難了。",
          "sc": "……感觉问题越来越难了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88038,
          "spk": "洋 (ヨウ)",
          "ja": "うぅ……勉強って終わりのない坂道みたい……",
          "tc": "嗚嗚……讀書就好像沒有盡頭的斜坡一樣……",
          "sc": "呜呜……读书就好像没有尽头的斜坡一样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2264,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88069,
          "spk": "洋 (ヨウ)",
          "ja": "歴史のお勉強って、ちょっと好きかも",
          "tc": "我好像還滿喜歡讀歷史的。",
          "sc": "我好像还满喜欢读历史的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88076,
          "spk": "洋 (ヨウ)",
          "ja": "色んな人のお話が知れて、すごく楽しいね",
          "tc": "能夠知道很多人的故事，非常有趣喔。",
          "sc": "能够知道很多人的故事，非常有趣哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2265,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88107,
          "spk": "洋 (ヨウ)",
          "ja": "ぴゅー、ぴゅー……",
          "tc": "嗶咻──嗶咻──",
