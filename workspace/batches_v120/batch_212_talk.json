      "rec_id": "TALK_ID_10_0502_207_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311044,
          "spk": "名护 (ナゴ)",
          "ja": "さあ、ハスミさん",
          "tc": "好了，蓮實小姐。",
