  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5376,
      "rec_id": "TALK_ID_10_0502_206_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310272,
          "spk": "名护 (ナゴ)",
          "ja": "ココ……お前、どうしてここに……",
          "tc": "可可……你怎麼會在這裡……",
          "sc": "可可……你怎么会在这里……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 310279,
          "spk": "名护 (ナゴ)",
          "ja": "その姿……もしかして幽霊なのか……？",
          "tc": "你的模樣……難道是幽靈嗎……？",
          "sc": "你的模样……难道是幽灵吗……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 310297,
          "spk": "名护 (ナゴ)",
          "ja": "あの日から",
          "tc": "從那一天起",
          "sc": "从那一天起"
        },
        {
          "f_idx": 4,
          "pidx_tc": 310304,
          "spk": "名护 (ナゴ)",
          "ja": "何度お前の夢を見たことか……",
          "tc": "都不知道夢見你多少次了……",
          "sc": "都不知道梦见你多少次了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5377,
      "rec_id": "TALK_ID_10_0502_206_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310322,
          "spk": "名护 (ナゴ)",
          "ja": "ずっと、また会いたいと",
          "tc": "我一直都想再見到你，",
          "sc": "我一直都想再见到你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 310329,
          "spk": "名护 (ナゴ)",
          "ja": "思ってたんだよ、ココ……",
          "tc": "可可……",
          "sc": "可可……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5378,
      "rec_id": "TALK_ID_10_0502_206_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310353,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、こいつはココという",
          "tc": "<player>，這隻貓叫做可可。",
          "sc": "<player>，这只猫叫做可可。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 310360,
          "spk": "名护 (ナゴ)",
          "ja": "俺が実家で飼っていて、",
          "tc": "是我以前在老家養的貓。",
          "sc": "是我以前在老家养的猫。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 310367,
          "spk": "名护 (ナゴ)",
          "ja": "数年前に死んでしまった猫なんだ",
          "tc": "幾年前過世了。",
          "sc": "几年前过世了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 310378,
          "spk": "名护 (ナゴ)",
          "ja": "……俺はココの死に目に会えなかった",
          "tc": "……我沒有見到可可的最後一面。",
          "sc": "……我没有见到可可的最后一面。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 310396,
          "spk": "名护 (ナゴ)",
          "ja": "就活で忙しいなんて",
          "tc": "就因為忙著找工作",
          "sc": "就因为忙着找工作"
        },
        {
          "f_idx": 6,
          "pidx_tc": 310403,
          "spk": "名护 (ナゴ)",
          "ja": "バカみたいな理由で、",
          "tc": "這種愚蠢的原因，",
          "sc": "这种愚蠢的原因，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 310410,
          "spk": "名护 (ナゴ)",
          "ja": "帰るのが遅れたんだ",
          "tc": "等我回去的時候已經太遲了……",
          "sc": "等我回去的时候已经太迟了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5379,
      "rec_id": "TALK_ID_10_0502_206_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310428,
          "spk": "名护 (ナゴ)",
          "ja": "ココが死んでから",
          "tc": "自從可可過世之後，",
          "sc": "自从可可过世之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 310435,
          "spk": "名护 (ナゴ)",
          "ja": "後悔が消えなくて……",
          "tc": "我一直無法釋懷……",
          "sc": "我一直无法释怀……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 310446,
          "spk": "名护 (ナゴ)",
          "ja": "どうして俺は、",
          "tc": "為什麼……",
          "sc": "为什么……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 310453,
          "spk": "名护 (ナゴ)",
          "ja": "ココが危ないって聞いて",
          "tc": "我在聽說可可命危時，",
          "sc": "我在听说可可命危时，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 310460,
          "spk": "名护 (ナゴ)",
          "ja": "すぐ実家に戻らなかったのか",
          "tc": "沒有立刻回老家呢？",
          "sc": "没有立刻回老家呢？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 310471,
          "spk": "名护 (ナゴ)",
          "ja": "幽霊でもなんでもいい",
          "tc": "不管是幽靈還是什麼都好，",
          "sc": "不管是幽灵还是什么都好，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 310478,
          "spk": "名护 (ナゴ)",
          "ja": "またココに会えて嬉しいよ……",
          "tc": "能再見到可可，我真的很高興……",
          "sc": "能再见到可可，我真的很高兴……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5380,
      "rec_id": "TALK_ID_10_0502_206_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310509,
          "spk": "名护 (ナゴ)",
          "ja": "なんだ……！？",
          "tc": "怎麼回事……！？",
          "sc": "怎么回事……！？"
