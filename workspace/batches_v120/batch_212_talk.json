        {
          "f_idx": 1,
          "pidx_tc": 310516,
          "spk": "名护 (ナゴ)",
          "ja": "急に雷……？",
          "tc": "突然打雷了……？",
          "sc": "突然打雷了……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5381,
      "rec_id": "TALK_ID_10_0502_206_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 310534,
          "spk": "名护 (ナゴ)",
          "ja": "……嫌な予感がする！",
          "tc": "……我有不好的預感！",
          "sc": "……我有不好的预感！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 310541,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、こっちに隠れよう！",
          "tc": "<player>，躲到這邊來！",
          "sc": "<player>，躲到这边来！"
        }
      ]
    },
    {
      "file": "talk.dat",
