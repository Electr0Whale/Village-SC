        },
        {
          "f_idx": 2,
          "pidx_tc": 310906,
          "spk": "莲实 (ハスミ)",
          "ja": "起きられたのですね",
          "tc": "你醒了呢。",
          "sc": "你醒了呢。"
        },
        {
