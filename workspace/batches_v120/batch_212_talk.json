          "tc": "我一直在等你呢。",
          "sc": "我一直在等你呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311837,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと手順を踏んで、",
          "tc": "你有照著步驟，",
          "sc": "你有照着步骤，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311844,
          "spk": "堇怜 (スミレ)",
          "ja": "幽霊がいる場所に行けたか？",
          "tc": "成功抵達幽靈所在的地方了嗎？",
          "sc": "成功抵达幽灵所在的地方了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5400,
      "rec_id": "TALK_ID_10_0502_208_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311862,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ……怪物は見たか？",
          "tc": "那……你有看到怪物嗎？",
          "sc": "那……你看见怪物了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311869,
          "spk": "堇怜 (スミレ)",
          "ja": "頭が猿で、胴体が虎で、尻尾が蛇の怪物！",
          "tc": "頭部是猴子，身體是老虎，尾巴是蛇的怪物！",
          "sc": "头部是猴子，身体是老虎，尾巴是蛇的怪物！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5401,
      "rec_id": "TALK_ID_10_0502_208_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311894,
          "spk": "堇怜 (スミレ)",
          "ja": "見たんだね！",
          "tc": "你看到了對吧！",
          "sc": "你看到了对吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311901,
          "spk": "堇怜 (スミレ)",
          "ja": "よし――それじゃ、いよいよだ",
          "tc": "很好──那終於可以開始了。",
          "sc": "很好——那终于可以开始了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311908,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、協力してよ",
          "tc": "<player>，幫我個忙吧。",
          "sc": "<player>，帮我个忙吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5402,
      "rec_id": "TALK_ID_10_0502_208_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311926,
          "spk": "堇怜 (スミレ)",
          "ja": "キミがお手伝いをしてくれた時、",
          "tc": "你之前協助我的時候，",
          "sc": "你之前协助我的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311933,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が頼みたいことがあるって",
          "tc": "我說過有事想拜託你，",
          "sc": "我说过有事想拜托你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311940,
          "spk": "堇怜 (スミレ)",
          "ja": "言ったの、覚えてる？",
          "tc": "你還記得嗎？",
          "sc": "你还记得吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311951,
          "spk": "堇怜 (スミレ)",
          "ja": "僕はあの怪物……<strong>「鵺」</strong>を倒して",
          "tc": "我想打倒那個怪物……<strong>「鵺」</strong>，",
          "sc": "我想打倒那个怪物……<strong>“鵺”</strong>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 311958,
          "spk": "堇怜 (スミレ)",
          "ja": "その皮を手に入れたいんだ",
          "tc": "然後拿到牠的皮。",
          "sc": "然后拿到它的皮。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 311969,
          "spk": "堇怜 (スミレ)",
          "ja": "だから日頃、弓の練習をしたり、",
          "tc": "所以我平常才會練習弓箭，",
          "sc": "所以我平常才会练习弓箭，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 311976,
          "spk": "堇怜 (スミレ)",
          "ja": "毒草を集めたりしていたのさ！",
          "tc": "還有收集毒草喔！",
          "sc": "还有收集毒草哦！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 311994,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>は勇気があるから",
          "tc": "因為<player>很勇敢，",
          "sc": "因为<player>很勇敢，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312001,
          "spk": "堇怜 (スミレ)",
          "ja": "一緒に立ち向かえると思う",
          "tc": "我覺得你有辦法跟我一起面對祂。",
          "sc": "我觉得你有办法跟我一起面对他。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 312012,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、まず<player>に",
          "tc": "所以<player>，",
          "sc": "所以<player>，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 312019,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺を見てほしくて、",
          "tc": "我是因為想先讓你看看鵺，",
          "sc": "我是因为想先让你看看鵺，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 312026,
          "spk": "堇怜 (スミレ)",
          "ja": "あそこへの行き方を教えたんだよ",
          "tc": "才會把去那裡的方式告訴你們。",
          "sc": "才会把去那里的方式告诉你们。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 312037,
          "spk": "堇怜 (スミレ)",
          "ja": "キミはまんまと僕の策略にハマったってわけ！",
          "tc": "總之你徹底掉進了我的計畫裡！",
          "sc": "总之你彻底掉进了我的计划里！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 312044,
          "spk": "堇怜 (スミレ)",
          "ja": "いやぁ……キミの力を借りられたら、",
          "tc": "哎呀……要是能借助你的力量，",
          "sc": "哎呀……要是能借助你的力量，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 312051,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺狩りがはかどるぜ～～",
          "tc": "狩獵鵺的事就可以更順利了～～",
          "sc": "狩猎鵺的事就可以更顺利了～～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5403,
      "rec_id": "TALK_ID_10_0502_208_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312069,
          "spk": "堇怜 (スミレ)",
          "ja": "あ……やっぱり、",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312076,
          "spk": "堇怜 (スミレ)",
          "ja": "どうして鵺の皮が欲しいのか",
          "tc": "你應該很好奇，",
          "sc": "你应该很好奇，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312083,
          "spk": "堇怜 (スミレ)",
          "ja": "気になるよね……",
          "tc": "我為什麼會想要鵺皮對吧……",
          "sc": "我为什么会想要鵺皮对吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5404,
      "rec_id": "TALK_ID_10_0502_208_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312101,
          "spk": "堇怜 (スミレ)",
          "ja": "キミは、<strong>「鵺の皮」</strong>の伝説を",
          "tc": "關於<strong>「鵺皮」</strong>的傳說，",
          "sc": "关于<strong>“鵺皮”</strong>的传说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312108,
          "spk": "堇怜 (スミレ)",
          "ja": "本で読んだことがあるかな？",
          "tc": "你曾經在書上看過嗎？",
          "sc": "你曾经在书上看过吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312117,
          "spk": "堇怜 (スミレ)",
          "ja": "伝説によると、",
          "tc": "根據傳說，",
          "sc": "根据传说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312124,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮は持ち主のもとに富を呼び込むという……",
          "tc": "鵺皮會為主人帶來財富……",
          "sc": "鵺皮会为主人带来财富……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312131,
          "spk": "堇怜 (スミレ)",
          "ja": "そして、もともと僕の家にあったものなんだ",
          "tc": "而且鵺皮原本是屬於我家的東西。",
          "sc": "而且鵺皮原本是属于我家的东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5405,
      "rec_id": "TALK_ID_10_0502_208_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312149,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の家はね、昔はリンの家の次に",
          "tc": "以前我家相當興盛，",
          "sc": "以前我家相当兴盛，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312156,
          "spk": "堇怜 (スミレ)",
          "ja": "栄えてる大金持ちの商家でさ",
          "tc": "是僅次於林家的富裕商家。",
          "sc": "是仅次于林家的富裕商家。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312163,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮は、うちの家宝だった",
          "tc": "鵺皮則是我們家的傳家寶。",
          "sc": "鵺皮则是我们家的传家宝。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5406,
      "rec_id": "TALK_ID_10_0502_208_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312181,
          "spk": "堇怜 (スミレ)",
          "ja": "ただ、僕が小さい時に父さんが死んで、",
          "tc": "不過，在我很小的時候，爸爸過世，",
          "sc": "不过，在我很小的时候，爸爸过世，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312188,
          "spk": "堇怜 (スミレ)",
          "ja": "母さんも十年前に死んじゃって……",
          "tc": "而媽媽也在十年前過世……",
          "sc": "而妈妈也在十年前过世……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312206,
          "spk": "堇怜 (スミレ)",
          "ja": "その時、姉さんがうっかり",
          "tc": "那個時候，",
          "sc": "那个时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312213,
          "spk": "堇怜 (スミレ)",
          "ja": "家宝をなくしちゃったんだ",
          "tc": "姊姊不小心把傳家寶弄丟了。",
          "sc": "姐姐不小心把传家宝弄丢了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312224,
          "spk": "堇怜 (スミレ)",
          "ja": "そうしたら……",
          "tc": "結果……",
          "sc": "结果……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312231,
          "spk": "堇怜 (スミレ)",
          "ja": "うちは、あっという間に没落した",
          "tc": "我家轉眼間就沒落了。",
          "sc": "我家转眼间就没落了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5407,
      "rec_id": "TALK_ID_10_0502_208_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312249,
          "spk": "堇怜 (スミレ)",
          "ja": "家宝をなくしたから、",
          "tc": "正是因為失去傳家寶",
          "sc": "正是因为失去传家宝"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312256,
          "spk": "堇怜 (スミレ)",
          "ja": "貧乏になったんだよ",
          "tc": "才會變窮的。",
          "sc": "才会变穷的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312267,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんは探すなって言うけれど……",
          "tc": "雖然姊姊叫我不要去找……",
          "sc": "虽然姐姐叫我不要去找……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312274,
          "spk": "堇怜 (スミレ)",
          "ja": "でも僕は、貧しい暮らしは嫌だ",
          "tc": "但我不想繼續過著貧困的生活。",
          "sc": "但我不想继续过着贫困的生活。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312281,
          "spk": "堇怜 (スミレ)",
          "ja": "どうしても、鵺の皮を取り戻したい",
          "tc": "無論如何我都想把鵺皮拿回來。",
          "sc": "无论如何我都想把鵺皮拿回来。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312292,
          "spk": "堇怜 (スミレ)",
          "ja": "だから……<player>、お願い",
          "tc": "所以……<player>，拜託你！",
          "sc": "所以……<player>，拜托你！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312299,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺狩りを手伝ってよ",
          "tc": "幫我一起狩獵鵺吧。",
          "sc": "帮我一起狩猎鵺吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 312310,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮を取り戻したら、",
          "tc": "等我拿回鵺皮後，",
          "sc": "等我拿回鵺皮后，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 312317,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も神器探しに協力するからさ",
          "tc": "我也會幫你尋找神器的。",
          "sc": "我也会帮你寻找神器的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312324,
          "spk": "堇怜 (スミレ)",
          "ja": "ね、頼むよ",
          "tc": "好不好，拜託你嘛！",
          "sc": "好不好，拜托你嘛！"
        }
      ]
    }
  ]
