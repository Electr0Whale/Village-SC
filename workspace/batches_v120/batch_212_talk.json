          "pidx_tc": 310917,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん",
          "tc": "<player>。",
          "sc": "<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 310924,
          "spk": "名护 (ナゴ)",
          "ja": "ちょうどよかった",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
