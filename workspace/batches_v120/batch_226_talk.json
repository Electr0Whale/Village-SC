  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5910,
      "rec_id": "TALK_ID_10_0601_019_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 341927,
          "spk": "今野 (コンノ)",
          "ja": "じゃあ、この後はどうしますかねェ",
          "tc": "那麼，之後又該怎麼做呢～",
          "sc": "那么，之后又该怎么做呢～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 341934,
          "spk": "今野 (コンノ)",
          "ja": "このままじゃ、ほのぼのとした",
          "tc": "再這樣下去，",
          "sc": "再这样下去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 341941,
          "spk": "今野 (コンノ)",
          "ja": "彼ヶ津村の暮らしが、また脅かされてしまう",
          "tc": "彼津村靜謐的生活又會再次遭遇威脅。",
          "sc": "彼津村静谧的生活又会再次遭遇威胁。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 341954,
          "spk": "裕太 (ユータ)",
          "ja": "どうって……",
          "tc": "你說怎麼做……",
          "sc": "你说怎么做……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 341961,
          "spk": "裕太 (ユータ)",
          "ja": "一体なにができるんだよ……",
          "tc": "我們到底能做什麼啊……",
          "sc": "我们到底能做什么啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5911,
      "rec_id": "TALK_ID_10_0601_019_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 341979,
          "spk": "今野 (コンノ)",
          "ja": "全く、察しが悪いですネ",
          "tc": "受不了，怎麼這麼遲鈍呢。",
          "sc": "受不了，怎么这么迟钝呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 341986,
          "spk": "今野 (コンノ)",
          "ja": "このまま憎たらしい村の敵どもを放置して、",
          "tc": "當然不能放著那些討人厭的──村子的敵人不管，",
          "sc": "当然不能放着那些讨人厌的——村子的敌人不管，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 341993,
          "spk": "今野 (コンノ)",
          "ja": "同じ土地に住み続けるわけにもいかないでしょ",
          "tc": "繼續住在同一片土地上吧？",
          "sc": "继续住在同一片土地上吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342004,
          "spk": "今野 (コンノ)",
          "ja": "まぁ、とりあえず、",
          "tc": "算了，總而言之，",
          "sc": "算了，总而言之，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342011,
          "spk": "今野 (コンノ)",
          "ja": "これからのことはキスケさんが戻って来てから",
          "tc": "今後的事就等木助先生回來後，",
          "sc": "今后的事就等木助先生回来后，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342018,
          "spk": "今野 (コンノ)",
          "ja": "話を聞いて考えましょう",
          "tc": "先聽聽他怎麼說，再來想吧。",
          "sc": "先听听他怎么说，再来想吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342029,
          "spk": "今野 (コンノ)",
          "ja": "これは、彼の問題でもあるのですし",
          "tc": "畢竟這件事也是他的問題。",
          "sc": "毕竟这件事也是他的问题。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 342042,
          "spk": "裕太 (ユータ)",
          "ja": "……？",
          "tc": "……？",
          "sc": "……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5912,
      "rec_id": "TALK_ID_10_0601_019_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342060,
          "spk": "今野 (コンノ)",
          "ja": "さて、話はおしまいにしましょ",
          "tc": "好了，話就聊到這裡吧。",
          "sc": "好了，话就聊到这里吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342067,
          "spk": "今野 (コンノ)",
          "ja": "アホのユータさんと話すと、",
          "tc": "繼續跟腦袋不靈光的裕太先生聊下去，",
          "sc": "继续跟脑袋不灵光的裕太先生聊下去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342074,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんも疲れてしまうでしょうからァ",
          "tc": "<player>應該也會感到疲倦。",
          "sc": "<player>应该也会感到疲倦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342087,
          "spk": "裕太 (ユータ)",
          "ja": "……は？",
          "tc": "……啊？",
          "sc": "……啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342094,
          "spk": "裕太 (ユータ)",
          "ja": "な、なんだよ、俺、別に",
          "tc": "幹、幹嘛這樣說我，",
          "sc": "干、干嘛这样说我，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342101,
          "spk": "裕太 (ユータ)",
          "ja": "アホなこと言ったりなんて……",
          "tc": "我又沒說什麼傻話……",
          "sc": "我又没说什么傻话……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5913,
      "rec_id": "TALK_ID_10_0601_019_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342119,
          "spk": "今野 (コンノ)",
          "ja": "ハイハイ",
          "tc": "是是是。",
          "sc": "是是是。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342126,
          "spk": "今野 (コンノ)",
          "ja": "じゃ、行きましょうね、ユータさん",
          "tc": "那我們走吧，裕太先生。",
          "sc": "那我们走吧，裕太先生。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5914,
      "rec_id": "TALK_ID_10_0601_019_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342148,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、今は無理せずゆっくり休んでよ",
          "tc": "<player>，你現在就別勉強了，好好休息吧。",
          "sc": "<player>，你现在就别勉强了，好好休息吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342155,
          "spk": "裕太 (ユータ)",
          "ja": "無理しちゃだめだからね",
          "tc": "千萬不能逞強喔！",
          "sc": "千万不能逞强哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5915,
      "rec_id": "TALK_ID_10_0601_021_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342183,
          "spk": "驹子 (コマコ)",
          "ja": "あ……<player>！",
          "tc": "啊……<player>！",
          "sc": "啊……<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342190,
          "spk": "驹子 (コマコ)",
          "ja": "起きて来ちゃったの？",
          "tc": "你下床跑來的嗎？",
          "sc": "你下床跑来的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342207,
          "spk": "堇怜 (スミレ)",
          "ja": "元気になったんだね、<player>！",
          "tc": "你恢復精神了呢，<player>！",
          "sc": "你恢复精神了呢，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342214,
          "spk": "堇怜 (スミレ)",
          "ja": "辻で倒れてたって聞いて心配してたんだから！",
          "tc": "我聽說你倒在岔路，一直很擔心耶！",
          "sc": "我听说你倒在岔路，一直很担心呢！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342234,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、もう起きて大丈夫なの？",
          "tc": "<player>，你可以下床了嗎？",
          "sc": "<player>，你可以下床了吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342241,
          "spk": "洋 (ヨウ)",
          "ja": "ほんとうに元気になった？",
          "tc": "真的已經恢復健康了？",
          "sc": "真的已经恢复健康了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5916,
      "rec_id": "TALK_ID_10_0601_021_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342257,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "ゲーンキ！　ゲンキッ！",
          "tc": "健～康！健康！",
          "sc": "健～康！健康！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342270,
          "spk": "堇怜 (スミレ)",
          "ja": "さっき姉さんに電話してみたんだけど、",
          "tc": "我剛剛打過電話給姊姊，",
          "sc": "我刚刚打过电话给姐姐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342277,
          "spk": "堇怜 (スミレ)",
          "ja": "トバリとキスケさん、退院は来週になるらしいよ",
          "tc": "帷和木助哥好像下星期會出院喔！",
          "sc": "帷和木助哥好像下星期会出院哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342293,
          "spk": "堇怜 (スミレ)",
          "ja": "二人とも、酷いケガだけど",
          "tc": "他們雖然都受了重傷，",
          "sc": "他们虽然都受了重伤，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342300,
          "spk": "堇怜 (スミレ)",
          "ja": "意識はしっかりあるんだって",
          "tc": "但現在意識已經很清醒了。",
          "sc": "但现在意识已经很清醒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5917,
      "rec_id": "TALK_ID_10_0601_021_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342318,
          "spk": "驹子 (コマコ)",
          "ja": "命に別状はないらしいからひと安心だけど、",
          "tc": "據說沒有生命危險，所以暫時鬆了一口氣，",
          "sc": "据说没有生命危险，所以暂时松了一口气，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342325,
          "spk": "驹子 (コマコ)",
          "ja": "手放しで喜べることじゃないよね……",
          "tc": "但還是沒辦法打從心底感到高興呢……",
          "sc": "但还是没办法打从心底感到高兴呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5918,
      "rec_id": "TALK_ID_10_0601_021_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342350,
          "spk": "堇怜 (スミレ)",
          "ja": "僕たちも、この先どうなるか……",
          "tc": "我們接下來，會怎麼樣呢……",
          "sc": "我们接下来，会怎么样呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5919,
      "rec_id": "TALK_ID_10_0601_021_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342366,
          "spk": "洋 (ヨウ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342379,
          "spk": "堇怜 (スミレ)",
          "ja": "……はぁ",
          "tc": "……唉。",
          "sc": "……唉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5920,
      "rec_id": "TALK_ID_10_0601_021_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342397,
          "spk": "堇怜 (スミレ)",
          "ja": "……昨日からずっと、",
          "tc": "……從昨天開始，",
          "sc": "……从昨天开始，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342404,
          "spk": "堇怜 (スミレ)",
          "ja": "村のあちこちで話題になってるんだ",
          "tc": "村子裡到處都在討論說，",
          "sc": "村子里到处都在讨论说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342411,
          "spk": "堇怜 (スミレ)",
          "ja": "このまま、この村に住み続けていいのかって",
          "tc": "真的該繼續住在這座村子裡嗎？",
          "sc": "真的该继续住在这座村子里吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342420,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は……いや、村の人はみんな、",
          "tc": "我……不，所有村民都明白，",
          "sc": "我……不，所有村民都明白，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342427,
          "spk": "堇怜 (スミレ)",
          "ja": "今回の事件は人でも神でもない、",
          "tc": "這次事件的始作俑者，",
          "sc": "这次事件的始作俑者，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342434,
          "spk": "堇怜 (スミレ)",
          "ja": "何かの仕業だってわかってるんだ",
          "tc": "是某個既不是人，也不是神的存在。",
          "sc": "是某个既不是人，也不是神的存在。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342445,
          "spk": "堇怜 (スミレ)",
          "ja": "だからこそ、安心して暮らせないって話で……",
          "tc": "正因為這樣，大家才會說沒辦法安心生活……",
          "sc": "正因为这样，大家才会说没办法安心生活……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 342465,
          "spk": "驹子 (コマコ)",
          "ja": "スミレくん、もう村の外に出る方法は、",
          "tc": "堇怜，你之前說過，",
          "sc": "堇怜，你之前说过，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 342472,
          "spk": "驹子 (コマコ)",
          "ja": "あるって言ってたよね",
          "tc": "已經有方法可以離開村子了對吧？",
          "sc": "已经有方法可以离开村子了对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5921,
      "rec_id": "TALK_ID_10_0601_021_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342490,
          "spk": "堇怜 (スミレ)",
          "ja": "うん、鵺の皮があればね",
          "tc": "嗯，只要有鵺皮就可以。",
          "sc": "嗯，只要有鵺皮就可以。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342501,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、時間はかかるかもしれないけど、",
          "tc": "所以，雖然可能需要花點時間，",
          "sc": "所以，虽然可能需要花点时间，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342508,
          "spk": "堇怜 (スミレ)",
          "ja": "村のみんなが引っ越しすることは、",
          "tc": "但還是要讓所有村民都搬家",
          "sc": "但还是要让所有村民都搬家"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342515,
          "spk": "堇怜 (スミレ)",
          "ja": "できなくないんだ",
          "tc": "還是有可能辦到的。",
          "sc": "还是有可能办到的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342528,
          "spk": "驹子 (コマコ)",
          "ja": "でも……村の外で暮らすなんて、",
          "tc": "可是……在村子外面生活這種事，",
          "sc": "可是……在村子外面生活这种事，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342535,
          "spk": "驹子 (コマコ)",
          "ja": "なんだか想像できないや……",
          "tc": "我總覺得無法想像……",
          "sc": "我总觉得无法想像……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5922,
      "rec_id": "TALK_ID_10_0601_021_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342553,
          "spk": "洋 (ヨウ)",
          "ja": "……やだな",
          "tc": "……我不要。",
          "sc": "……我不要。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5923,
      "rec_id": "TALK_ID_10_0601_021_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342573,
          "spk": "驹子 (コマコ)",
          "ja": "……ヨウちゃん",
          "tc": "……小洋。",
          "sc": "……小洋。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342584,
          "spk": "洋 (ヨウ)",
          "ja": "街に行ったらたぶん、",
          "tc": "要是搬到市區去，",
          "sc": "要是搬到市区去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342591,
          "spk": "洋 (ヨウ)",
          "ja": "今みたいにオワンを放しておけないよね……",
          "tc": "就沒辦法像現在這樣，讓歐宛自由行動了吧……",
          "sc": "就没办法像现在这样，让欧宛自由行动了吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5924,
      "rec_id": "TALK_ID_10_0601_021_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342614,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "オワンハナシテ！",
          "tc": "歐宛自由行動！",
          "sc": "欧宛自由行动！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342627,
          "spk": "驹子 (コマコ)",
          "ja": "私も、彼ヶ津村以外で住むなんて、",
          "tc": "我也一樣，",
          "sc": "我也一样，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342634,
          "spk": "驹子 (コマコ)",
          "ja": "考えられないよ……",
          "tc": "真的無法想像要住在彼津村以外的地方……",
          "sc": "真的无法想像要住在彼津村以外的地方……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5925,
      "rec_id": "TALK_ID_10_0601_021_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342659,
          "spk": "堇怜 (スミレ)",
          "ja": "リンは、絶対に納得はしないだろうな",
          "tc": "林也一定不會接受的吧。",
          "sc": "林也一定不会接受的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5926,
      "rec_id": "TALK_ID_10_0601_021_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342677,
          "spk": "驹子 (コマコ)",
          "ja": "私たちに出来ることは、",
          "tc": "有沒有什麼",
          "sc": "有没有什么"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342684,
          "spk": "驹子 (コマコ)",
          "ja": "何かあるのかな……",
          "tc": "是我們能做的呢……",
          "sc": "是我们能做的呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342697,
          "spk": "堇怜 (スミレ)",
          "ja": "だめだ……",
          "tc": "不行……",
          "sc": "不行……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342704,
          "spk": "堇怜 (スミレ)",
          "ja": "土地神さまに許しを乞うくらいしか、",
          "tc": "我能想到的，",
          "sc": "我能想到的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342711,
          "spk": "堇怜 (スミレ)",
          "ja": "思い浮かばないや",
          "tc": "只有去請求土地神大人的原諒。",
          "sc": "只有去请求土地神大人的原谅。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342722,
          "spk": "驹子 (コマコ)",
          "ja": "でも、それじゃ今までと変わらないよね……",
          "tc": "但，那樣就會回到以前的生活……",
          "sc": "但，那样就会回到以前的生活……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342729,
          "spk": "驹子 (コマコ)",
          "ja": "私たち……どうすれば……",
          "tc": "我們……到底該怎麼做……",
          "sc": "我们……到底该怎么做……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5927,
      "rec_id": "TALK_ID_10_0601_021_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342751,
          "spk": "驹子 (コマコ)",
          "ja": "ああ、ごめんね<player>",
          "tc": "啊，抱歉，<player>。",
          "sc": "啊，抱歉，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342758,
          "spk": "驹子 (コマコ)",
          "ja": "せっかく元気になったのに、",
          "tc": "你好不容易才恢復，",
          "sc": "你好不容易才恢复，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342765,
          "spk": "驹子 (コマコ)",
          "ja": "暗い話してて……",
          "tc": "我們卻在講這種沉重的話題……",
          "sc": "我们却在讲这种沉重的话题……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342778,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが、言ってたよ",
          "tc": "姊姊有交代說，",
          "sc": "姐姐有交代说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342785,
          "spk": "堇怜 (スミレ)",
          "ja": "起きたら家に帰って良いって",
          "tc": "你起來後就可以回家了。",
          "sc": "你起来后就可以回家了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342792,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、キミはいったんお家に帰りなよ",
          "tc": "所以，你就先回家一趟吧。",
          "sc": "所以，你就先回家一趟吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342805,
          "spk": "堇怜 (スミレ)",
          "ja": "庭、なんか知らないけど荒れてたぜ？",
          "tc": "庭院不曉得是發生了什麼，變得超亂的耶？",
          "sc": "庭院不晓得是发生了什么，变得超乱的呢？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 342812,
          "spk": "堇怜 (スミレ)",
          "ja": "まるで、<player>がやったと思えないくらいに",
          "tc": "根本就不像是<player>你弄出來的。",
          "sc": "根本就不像是<player>你弄出来的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5928,
      "rec_id": "TALK_ID_10_0601_021_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342839,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、私も仕事に行かなくちゃ",
          "tc": "那麼，我得去工作了。",
          "sc": "那么，我得去工作了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342846,
          "spk": "驹子 (コマコ)",
          "ja": "どんなことがあっても、",
          "tc": "畢竟不管發生什麼事，",
          "sc": "毕竟不管发生什么事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342853,
          "spk": "驹子 (コマコ)",
          "ja": "仕事は待ってくれないからね……",
          "tc": "工作還是得做……",
          "sc": "工作还是得做……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342868,
          "spk": "洋 (ヨウ)",
          "ja": "……うん、頑張ってね、コマコちゃん",
          "tc": "……嗯，加油喔，駒子姐姐。",
          "sc": "……嗯，加油哦，驹子姐姐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5929,
      "rec_id": "TALK_ID_10_0601_021_15",
      "lines": [
