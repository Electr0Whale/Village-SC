    {
      "file": "talk.dat",
      "rec_idx": 5930,
      "rec_id": "TALK_ID_10_0601_022_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342908,
          "spk": "六角 (ロッカク)",
          "ja": "……ここいらが、潮時なのかもしれねぇっス",
          "tc": "……現在或許是該離開的時候了。",
          "sc": "……现在或许是该离开的时候呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5931,
      "rec_id": "TALK_ID_10_0601_022_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 342932,
          "spk": "六角 (ロッカク)",
          "ja": "このままじゃ、いずれ全員",
          "tc": "再這樣下去，",
          "sc": "再这样下去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 342939,
          "spk": "六角 (ロッカク)",
          "ja": "祟りにのまれちまう",
          "tc": "大家遲早都會遭到作祟吞噬。",
          "sc": "大家迟早都会遭到作祟吞噬。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 342952,
          "spk": "四郎治 (シロージ)",
          "ja": "お前は「よそ者」だから言えるんだ",
          "tc": "因為你是「外地人」，才說得出這種話。",
          "sc": "因为你是“外地人”，才说得出这种话。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 342959,
          "spk": "四郎治 (シロージ)",
          "ja": "俺たちは、生まれた土地を捨てて、",
          "tc": "我們可沒有厲害到能夠拋下自己出生的土地，",
          "sc": "我们可没有厉害到能够抛下自己出生的土地，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 342966,
          "spk": "四郎治 (シロージ)",
          "ja": "生きられるほど器用じゃない",
          "tc": "到其他地方生活。",
          "sc": "到其他地方生活。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 342977,
          "spk": "四郎治 (シロージ)",
          "ja": "それに、ロッカクさんこそいいのかよ",
          "tc": "再說，六角叔你自己沒關係嗎？",
          "sc": "再说，六角叔你自己没关系吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 342988,
          "spk": "四郎治 (シロージ)",
          "ja": "リンから聞いたことあるぜ",
          "tc": "我都聽林說過了，",
          "sc": "我都听林说过了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 342995,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、この村の外では生きられないって……",
          "tc": "你在村外是無法生存的……",
          "sc": "你在村外是无法生存的……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 343015,
          "spk": "六角 (ロッカク)",
          "ja": "ああ……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 343022,
          "spk": "六角 (ロッカク)",
          "ja": "ワシには、前科があるっスからね……",
          "tc": "因為我有前科……",
          "sc": "因为我有前科……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 343033,
          "spk": "六角 (ロッカク)",
          "ja": "確かに、償わねぇといけない",
          "tc": "或許我的確",
          "sc": "或许我的确"
        },
        {
          "f_idx": 12,
          "pidx_tc": 343040,
          "spk": "六角 (ロッカク)",
          "ja": "罪はあるかもしれねぇっス",
          "tc": "有必須償還的罪過。",
          "sc": "有必须偿还的罪过呐。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 343051,
          "spk": "六角 (ロッカク)",
          "ja": "でも……生きていれば、どうにかなる",
          "tc": "但是……只要還活著就有辦法。",
          "sc": "但是……只要还活着就有办法。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 343058,
          "spk": "六角 (ロッカク)",
          "ja": "死んでからじゃ、何もできない",
          "tc": "一旦死了就什麼都做不到了。",
          "sc": "一旦死了就什么都做不到了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 343078,
          "spk": "四郎治 (シロージ)",
          "ja": "……逃げて、どこへ行くんだよ",
          "tc": "……逃了之後，又能去哪呢。",
          "sc": "……逃了之后，又能去哪呢。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 343085,
          "spk": "四郎治 (シロージ)",
          "ja": "知らない土地で、知らない人たちの中で……",
          "tc": "在陌生的土地上，在陌生的人群中……",
          "sc": "在陌生的土地上，在陌生的人群中……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 343105,
          "spk": "茶梅 (サザンカ)",
          "ja": "でもアタシ、",
          "tc": "不過我，",
          "sc": "不过我，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 343112,
          "spk": "茶梅 (サザンカ)",
          "ja": "ずっと前から思ってたんだけどさ……",
          "tc": "其實從以前就一直在想……",
          "sc": "其实从以前就一直在想……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 343123,
          "spk": "茶梅 (サザンカ)",
          "ja": "土地神さまってのはずっと昔から、",
          "tc": "土地神大人從很久以前開始，",
          "sc": "土地神大人从很久以前开始，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 343130,
          "spk": "茶梅 (サザンカ)",
          "ja": "この土地に人が住むことを、",
          "tc": "就不曾允許人類住在這片土地上",
          "sc": "就不曾允许人类住在这片土地上"
        },
        {
          "f_idx": 23,
          "pidx_tc": 343137,
          "spk": "茶梅 (サザンカ)",
          "ja": "許していないのかもしれないよ",
          "tc": "也說不定。",
          "sc": "也说不定。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5932,
      "rec_id": "TALK_ID_10_0601_022_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343155,
          "spk": "四郎治 (シロージ)",
          "ja": "……サザンカ",
          "tc": "……茶梅，",
          "sc": "……茶梅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343162,
          "spk": "四郎治 (シロージ)",
          "ja": "お前までそっちに付くのか？",
          "tc": "連妳也要站在那邊嗎？",
          "sc": "连你也要站在那边吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 343171,
          "spk": "四郎治 (シロージ)",
          "ja": "俺たちは守ってきたつもりなんだ",
          "tc": "我們一直都在守護這一切。",
          "sc": "我们一直都在守护这一切。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 343178,
          "spk": "四郎治 (シロージ)",
          "ja": "家も、墓も、暮らしも……",
          "tc": "家園、墓地，還有生活……",
          "sc": "家园、墓地，还有生活……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 343185,
          "spk": "四郎治 (シロージ)",
          "ja": "全部、祖父母の代から繋いできた",
          "tc": "全都是從祖父母那代延續到現在的。",
          "sc": "全都是从祖父母那代延续到现在的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 343196,
          "spk": "四郎治 (シロージ)",
          "ja": "それを今さら捨てろって言うのか",
          "tc": "事到如今難道要我們放棄嗎？",
          "sc": "事到如今难道要我们放弃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5933,
      "rec_id": "TALK_ID_10_0601_022_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343223,
          "spk": "六角 (ロッカク)",
          "ja": "でもそれは、たくさんの犠牲の上に",
          "tc": "但是那些，",
          "sc": "但是那些，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343230,
          "spk": "六角 (ロッカク)",
          "ja": "成り立ってる……",
          "tc": "是建立在許多犧牲上……",
          "sc": "是建立在许多牺牲上……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 343241,
          "spk": "六角 (ロッカク)",
          "ja": "守るために命を差し出すのは、",
          "tc": "為了守護而付出性命，",
          "sc": "为了守护而付出性命，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 343248,
          "spk": "六角 (ロッカク)",
          "ja": "「信仰」じゃなくて「犠牲」っス",
          "tc": "那不是「信仰」，而是「犧牲」。",
          "sc": "那不是“信仰”，而是“牺牲”呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5934,
      "rec_id": "TALK_ID_10_0601_022_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343273,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシも本当はこんなこと考えたくないよ",
          "tc": "老實說我也不願意這麼想。",
          "sc": "老实说我也不愿意这么想。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343280,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも、また意味もわからず、",
          "tc": "但我不想再看到",
          "sc": "但我不想再看到"
        },
        {
          "f_idx": 2,
          "pidx_tc": 343287,
          "spk": "茶梅 (サザンカ)",
          "ja": "誰かが傷つけられるのを見たくないし……",
          "tc": "有人莫名其妙受傷了……",
          "sc": "有人莫名其妙受伤了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 343298,
          "spk": "茶梅 (サザンカ)",
          "ja": "外に出れば、少なくとも「祟り」は届かない",
          "tc": "離開村子的話，至少不會受到「作祟」影響。",
          "sc": "离开村子的话，至少不会受到“作祟”影响。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 343305,
          "spk": "茶梅 (サザンカ)",
          "ja": "土地神のしがらみから、解放されるはず",
          "tc": "應該就能擺脫土地神的糾葛了。",
          "sc": "应该就能摆脱土地神的纠葛了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 343325,
          "spk": "四郎治 (シロージ)",
          "ja": "しがらみがなくなっても、",
          "tc": "就算糾葛消失，",
          "sc": "就算纠葛消失，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 343332,
          "spk": "四郎治 (シロージ)",
          "ja": "外に出ればまた新たなしがらみに",
          "tc": "只要到外面去，",
          "sc": "只要到外面去，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 343339,
          "spk": "四郎治 (シロージ)",
          "ja": "絡め取られるだけだ",
          "tc": "也一樣會受到新的糾葛束縛。",
          "sc": "也一样会受到新的纠葛束缚。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 343352,
          "spk": "六角 (ロッカク)",
          "ja": "でもワシには……ヨウさんがいるっス……",
          "tc": "但我……有洋妹妹在……",
          "sc": "但我……有洋妹妹在……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5935,
      "rec_id": "TALK_ID_10_0601_022_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343372,
          "spk": "六角 (ロッカク)",
          "ja": "あの子をこのまま、",
          "tc": "不能讓那孩子",
          "sc": "不能让那孩子"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343379,
          "spk": "六角 (ロッカク)",
          "ja": "危険に晒しておくことは……",
          "tc": "繼續暴露在危險之中……",
          "sc": "继续暴露在危险之中……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5936,
      "rec_id": "TALK_ID_10_0601_022_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343397,
          "spk": "茶梅 (サザンカ)",
          "ja": "……出るにしても、残るにしても",
          "tc": "……無論要離開還是留下，",
          "sc": "……无论要离开还是留下，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343404,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんらかの覚悟は決めなきゃね",
          "tc": "都得下定某種決心呢。",
