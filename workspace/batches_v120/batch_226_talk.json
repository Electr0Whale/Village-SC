          "tc": "會對我們造成危害的存在，",
          "sc": "会对我们造成危害的存在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 343585,
          "spk": "今野 (コンノ)",
          "ja": "土地神だけじゃないってことですヨ",
          "tc": "可不是只有土地神喔！",
          "sc": "可不是只有土地神哟～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5941,
      "rec_id": "TALK_ID_10_0601_023_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343603,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、最近はみんな、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343610,
          "spk": "名护 (ナゴ)",
          "ja": "村を捨てるかどうかの話ばかりしているよ",
          "tc": "最近大家都在討論要不要離開村子。",
          "sc": "最近大家都在讨论要不要离开村子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 343623,
          "spk": "今野 (コンノ)",
          "ja": "まァ、あんなことが起きればねェ",
          "tc": "這也難怪，畢竟都發生那種事了。",
          "sc": "这也难怪，毕竟都发生那种事呐～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 343643,
          "spk": "名护 (ナゴ)",
          "ja": "少なくとも俺は、",
          "tc": "至少我自己，",
          "sc": "至少我自己，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 343650,
          "spk": "名护 (ナゴ)",
          "ja": "この土地にしがらみができてしまった……",
          "tc": "是已經被這片土地束縛了……",
          "sc": "是已经被这片土地束缚了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 343657,
          "spk": "名护 (ナゴ)",
          "ja": "もう簡単には離れられないよ",
          "tc": "沒辦法輕易離開呢。",
          "sc": "没办法轻易离开呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 343666,
          "spk": "名护 (ナゴ)",
          "ja": "村を捨てれば、きっとこの土地は、",
          "tc": "要是我們丟下村子離開，",
          "sc": "要是我们丢下村子离开，"
