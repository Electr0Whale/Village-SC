          "pidx_tc": 343673,
          "spk": "名护 (ナゴ)",
          "ja": "すぐに緑に埋もれていくだろう……",
          "tc": "這片土地應該會立刻被綠意吞沒吧……",
          "sc": "这片土地应该会立刻被绿意吞没吧……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 343680,
          "spk": "名护 (ナゴ)",
          "ja": "やがて、誰も踏み入れられない場所になる……",
          "tc": "最後，成為誰都進不來的地方……",
          "sc": "最后，成为谁都进不来的地方……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 343691,
          "spk": "名护 (ナゴ)",
          "ja": "そうなれば俺はココを……",
          "tc": "那樣一來……",
          "sc": "那样一来……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 343698,
          "spk": "名护 (ナゴ)",
          "ja": "また置いて行くことに……",
          "tc": "就等於我又丟下了可可……",
          "sc": "就等于我又丢下了可可……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 343707,
          "spk": "名护 (ナゴ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5942,
      "rec_id": "TALK_ID_10_0601_023_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343725,
          "spk": "今野 (コンノ)",
          "ja": "まあ、それもありかもしれませんねェ……",
          "tc": "嗯，那也是有可能的吧……",
          "sc": "嗯，那也是有可能的吧……"
