        {
          "f_idx": 1,
          "pidx_tc": 343506,
          "spk": "今野 (コンノ)",
          "ja": "「誰かさん」の仕業でしょうねェ",
          "tc": "「某人」下的手吧。",
          "sc": "“某人”下的手呐～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 343526,
          "spk": "名护 (ナゴ)",
          "ja": "コンノさん……",
          "tc": "今野先生……",
