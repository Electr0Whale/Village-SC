          "sc": "这是……土地神做的吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5940,
      "rec_id": "TALK_ID_10_0601_023_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343551,
          "spk": "名护 (ナゴ)",
          "ja": "俺には……",
          "tc": "在我看來……",
          "sc": "在我看来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 343558,
          "spk": "名护 (ナゴ)",
          "ja": "人が力ずくで壊したように見えるけど……",
          "tc": "比較像是被人用蠻力破壞的……",
          "sc": "比较像是被人用蛮力破坏的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 343571,
          "spk": "今野 (コンノ)",
          "ja": "我々の暮らしを良しとしていない、",
          "tc": "看不慣我們的生活，",
          "sc": "看不惯我们的生活，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 343578,
          "spk": "今野 (コンノ)",
