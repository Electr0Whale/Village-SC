      "rec_id": "TALK_ID_10_0601_023_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 343499,
          "spk": "今野 (コンノ)",
          "ja": "これこそキスケさんやトバリさんを傷つけた",
          "tc": "這應該就是傷害了木助先生和帷小姐的",
