          "f_idx": 5,
          "pidx_tc": 94557,
          "spk": "堇怜 (スミレ)",
          "ja": "あんまり落ち込むなよ",
          "tc": "你別太沮喪喔。",
          "sc": "你别太沮丧哦。"
        }
      ]
    },
