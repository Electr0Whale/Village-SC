  "record_count": 29,
  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2619,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93119,
          "spk": "堇怜 (スミレ)",
          "ja": "あのさ、<player>",
          "tc": "問你喔，<player>，",
          "sc": "问你哦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93126,
          "spk": "堇怜 (スミレ)",
          "ja": "マンゴーって食べたことある？",
          "tc": "你有吃過芒果嗎？",
          "sc": "你吃过芒果吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93137,
          "spk": "堇怜 (スミレ)",
          "ja": "昔さ、まだ家計に余裕があった頃、",
          "tc": "我在以前家裡還沒那麼窮的時候，",
          "sc": "我在以前家里还没那么穷的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93144,
          "spk": "堇怜 (スミレ)",
          "ja": "一度だけ食べたことがあるんだ",
          "tc": "曾經吃過一次。",
          "sc": "曾经吃过一次。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93155,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと独特な風味だったけど",
          "tc": "雖然味道有點特別，",
          "sc": "虽然味道有点特别，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 93162,
          "spk": "堇怜 (スミレ)",
          "ja": "甘くてトロッとしてて、",
          "tc": "但又甜又入口即化，",
          "sc": "但又甜又入口即化，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 93169,
          "spk": "堇怜 (スミレ)",
          "ja": "めちゃくちゃ美味しかったな……",
          "tc": "真的超好吃的……",
          "sc": "真的超好吃的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 93180,
          "spk": "堇怜 (スミレ)",
          "ja": "もう一度食べたいけど、マンゴーは高いし……",
          "tc": "雖然我很想再吃一次，但芒果很貴……",
          "sc": "虽然我很想再吃一次，但芒果很贵……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 93187,
          "spk": "堇怜 (スミレ)",
          "ja": "今のうちの財政状況じゃ厳しいかな……",
          "tc": "以我們家現在的經濟狀況來說很難買啊……",
          "sc": "以我们家现在的经济状况来说很难买啊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 93205,
          "spk": "堇怜 (スミレ)",
          "ja": "いつか自分で作ろうと思って考えた",
          "tc": "我把自己構想出來、想說要自己做的",
          "sc": "我把自己构想出来、想说要自己做的"
        },
        {
          "f_idx": 11,
          "pidx_tc": 93212,
          "spk": "堇怜 (スミレ)",
          "ja": "「マンゴーパフェ」のレシピをあげるから",
          "tc": "「芒果百匯」的食譜給你，",
          "sc": "“芒果芭菲”的食谱给你，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 93219,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の代わりに、作ってみてよ！",
          "tc": "你就代替我做做看吧！",
          "sc": "你就代替我做做看吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2620,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93243,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、やっと見つけた！",
          "tc": "終於找到你了，<player>！",
          "sc": "终于找到你了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93250,
          "spk": "堇怜 (スミレ)",
          "ja": "キミを誘いに来たんだ",
          "tc": "我是來邀請你的。",
          "sc": "我是来邀请你的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93261,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと急なんだけど……",
          "tc": "雖然有點突然……",
          "sc": "虽然有点突然……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93268,
          "spk": "堇怜 (スミレ)",
          "ja": "今日、うちで一緒にご飯を食べない？",
          "tc": "但你今天要不要來我家一起吃飯？",
          "sc": "但你今天要不要来我家一起吃饭？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93275,
          "spk": "堇怜 (スミレ)",
          "ja": "キミと食事できたら楽しそうだと思ってさ",
          "tc": "我想能跟你一起的吃飯話應該會很開心。",
          "sc": "我想能跟你一起的吃饭话应该会很开心。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 93286,
          "spk": "堇怜 (スミレ)",
          "ja": "高級な食材は用意できないけど、",
          "tc": "雖然我沒辦法準備高級的食材，",
          "sc": "虽然我没办法准备高级的食材，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 93293,
          "spk": "堇怜 (スミレ)",
          "ja": "腕によりをかけて美味いご飯を作るつもりだよ",
          "tc": "但我會使出渾身解數做出美味料理的。",
          "sc": "但我会使出浑身解数做出美味料理的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 93300,
          "spk": "堇怜 (スミレ)",
          "ja": "きっと<player>の口にも合うと思う",
          "tc": "相信<player>你也一定會喜歡。",
          "sc": "相信<player>你也一定会喜欢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 93311,
          "spk": "堇怜 (スミレ)",
          "ja": "ええっと、僕は午後６時くらいからだと",
          "tc": "我想想，我大概晚上6點之後",
          "sc": "我想想，我大概晚上6点之后"
        },
        {
          "f_idx": 9,
          "pidx_tc": 93318,
          "spk": "堇怜 (スミレ)",
          "ja": "都合がいいんだけど……",
          "tc": "會比較方便……",
          "sc": "会比较方便……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 93325,
          "spk": "堇怜 (スミレ)",
          "ja": "どう？　来られそうかな？",
          "tc": "怎麼樣？你能來嗎？",
          "sc": "怎么样？你能来吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 93334,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 12,
          "pidx_tc": 93341,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2621,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93359,
          "spk": "堇怜 (スミレ)",
          "ja": "やったぜ！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93366,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>ならそう言ってくれると思ってた",
          "tc": "我就知道<player>一定會答應的，",
          "sc": "我就知道<player>一定会答应的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93377,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、時間までに準備を進めておくよ",
          "tc": "那麼在那之前我會先做好準備。",
          "sc": "那么在那之前我会先做好准备。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93384,
          "spk": "堇怜 (スミレ)",
          "ja": "来てくれるの、楽しみに待ってるからさ",
          "tc": "我很期待你過來喔，",
          "sc": "我很期待你过来哦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93391,
          "spk": "堇怜 (スミレ)",
          "ja": "忘れないでちゃんと来てくれよな！",
          "tc": "所以你可別忘記了，一定要來喔！",
          "sc": "所以你可别忘记了，一定要来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2622,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93413,
          "spk": "堇怜 (スミレ)",
          "ja": "そっか……残念だな",
          "tc": "這樣啊……真可惜。",
          "sc": "这样啊……真可惜。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93420,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、無理なものは仕方ないよね",
          "tc": "不過這也沒辦法。",
          "sc": "不过这也没办法。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93431,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、また今度改めて誘うよ",
          "tc": "那我會再找機會約你的，",
          "sc": "那我会再找机会约你的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93438,
          "spk": "堇怜 (スミレ)",
          "ja": "次は都合が合うといいんだけど",
          "tc": "希望下次時間能對得上。",
          "sc": "希望下次时间能对得上。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93445,
          "spk": "堇怜 (スミレ)",
          "ja": "またね！",
          "tc": "那就下次見囉！",
          "sc": "那就下次见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2623,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93469,
          "spk": "堇怜 (スミレ)",
          "ja": "あっ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93476,
          "spk": "堇怜 (スミレ)",
          "ja": "今、少しいい？",
          "tc": "你現在有空嗎？",
          "sc": "你现在有空吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93487,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと楽しそうなことを思いついてさ……",
          "tc": "我想到了很有趣的事情……",
          "sc": "我想到了很有趣的事情……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93494,
          "spk": "堇怜 (スミレ)",
          "ja": "今日、僕の家に泊まりに来ない？",
          "tc": "你今天要不要來我家過夜？",
          "sc": "你今天要不要来我家过夜？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 93512,
          "spk": "堇怜 (スミレ)",
          "ja": "夜遅くまで<player>と喋ったり、",
          "tc": "如果能和<player>聊到深夜、",
          "sc": "如果能和<player>聊到深夜、"
        },
        {
          "f_idx": 6,
          "pidx_tc": 93519,
          "spk": "堇怜 (スミレ)",
          "ja": "遊んだりできたら",
          "tc": "一起玩的話，",
          "sc": "一起玩的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 93526,
          "spk": "堇怜 (スミレ)",
          "ja": "楽しそうだなって思ったんだよね",
          "tc": "我想應該會很開心吧。",
          "sc": "我想应该会很开心吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 93537,
          "spk": "堇怜 (スミレ)",
          "ja": "大丈夫なら、今日の午後６時にうちまで",
          "tc": "如果可以的話，",
          "sc": "如果可以的话，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 93544,
          "spk": "堇怜 (スミレ)",
          "ja": "来てくれると嬉しいんだけど、どう？",
          "tc": "希望你今天晚上6點能過來我家，怎麼樣？",
          "sc": "希望你今天晚上6点能过来我家，怎么样？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 93553,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 11,
          "pidx_tc": 93560,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2624,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0081",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93578,
          "spk": "堇怜 (スミレ)",
          "ja": "よかった！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93585,
          "spk": "堇怜 (スミレ)",
          "ja": "そうと決まったら",
          "tc": "既然決定好了，",
          "sc": "既然决定好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93592,
          "spk": "堇怜 (スミレ)",
          "ja": "いろいろと準備しておかないとな",
          "tc": "那我就得趕快做準備才行。",
          "sc": "那我就得赶快做准备才行。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93603,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が来てくれるの、",
          "tc": "我會很期待地等<player>你",
          "sc": "我会很期待地等<player>你"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93610,
          "spk": "堇怜 (スミレ)",
          "ja": "楽しみに待ってるからさ",
          "tc": "過來的。",
          "sc": "过来的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 93617,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、また！",
          "tc": "那就先這樣，等等見囉！",
          "sc": "那就先这样，待会儿见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2625,
      "rec_id": "TALK_ID_BOY_SPECIAL_20_112_0082",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93639,
          "spk": "堇怜 (スミレ)",
          "ja": "難しいんだ……まあ仕方ないよな",
          "tc": "沒有空啊……那也沒辦法。",
          "sc": "没有空啊……那也没办法。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93646,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>にだって予定があるだろうし",
          "tc": "畢竟<player>也有自己的安排。",
          "sc": "毕竟<player>也有自己的安排。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93657,
          "spk": "堇怜 (スミレ)",
          "ja": "別に今日じゃなくても",
          "tc": "反正也不是非今天不可，",
          "sc": "反正也不是非今天不可，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93664,
          "spk": "堇怜 (スミレ)",
          "ja": "また他の日に誘うから大丈夫だよ",
          "tc": "我改天會再約你的，所以沒關係。",
          "sc": "我改天会再约你的，所以没关系。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93671,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、またね！",
          "tc": "那就下次再見囉！",
          "sc": "那就下次再见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2626,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93695,
          "spk": "堇怜 (スミレ)",
          "ja": "今日って確か、",
          "tc": "我記得今天",
          "sc": "我记得今天"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93702,
          "spk": "堇怜 (スミレ)",
          "ja": "品評会の日なんだよな……",
          "tc": "是評鑑會的日子……",
          "sc": "是评鉴会的日子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93713,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は今日中に",
          "tc": "我得在今天之內",
          "sc": "我得在今天之内"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93720,
          "spk": "堇怜 (スミレ)",
          "ja": "宿題を片付けなくちゃいけなくってさ……",
          "tc": "把作業做完才行……",
          "sc": "把作业做完才行……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93727,
          "spk": "堇怜 (スミレ)",
          "ja": "あーあ、行きたかったのになぁ……",
          "tc": "唉～真的好想去喔……",
          "sc": "唉～真的好想去哦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2627,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93751,
          "spk": "堇怜 (スミレ)",
          "ja": "そういえば……今日の品評会には",
          "tc": "話說回來……",
          "sc": "话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93758,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>は参加するの？",
          "tc": "<player>會參加今天的評鑑會嗎？",
          "sc": "<player>会参加今天的评鉴会吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93769,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が出るんだとしたら",
          "tc": "<player>要參加的話",
          "sc": "<player>要参加的话"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93776,
          "spk": "堇怜 (スミレ)",
          "ja": "かなり見ごたえありそうだね",
          "tc": "感覺會很有看頭呢。",
          "sc": "感觉会很有看头呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 93783,
          "spk": "堇怜 (スミレ)",
          "ja": "その時はいい評価を獲れるよう応援してるよ",
          "tc": "到時候我會幫你加油的，希望你能獲得好評。",
          "sc": "到时候我会帮你加油的，希望你能获得好评。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2628,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0110",
      "lines": [
        {
          "f_idx": 0,
