          "f_idx": 0,
          "pidx_tc": 42442,
          "spk": "驹子 (コマコ)",
          "ja": "手がかじかんで上手く編めない……",
          "tc": "手都凍僵了，沒辦法好好編織呢……",
          "sc": "手都冻僵了，没办法好好编织呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42460,
          "spk": "驹子 (コマコ)",
          "ja": "あとであったかいお茶でも飲んで",
          "tc": "待會要來喝點熱茶，",
          "sc": "待会要来喝点热茶，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42467,
          "spk": "驹子 (コマコ)",
          "ja": "体を温めなくちゃね",
          "tc": "讓身體暖起來才行。",
          "sc": "让身体暖起来才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1135,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42491,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうど欲しいものもあるし",
          "tc": "我剛好想要買點東西呢。",
          "sc": "我刚好想要买点东西呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42498,
          "spk": "驹子 (コマコ)",
          "ja": "罠づくりが終わったら、",
          "tc": "等做好陷阱之後，",
          "sc": "等做好陷阱之后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42505,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさんのところに遊びに行こうかな",
          "tc": "就去茶梅姐那邊玩好了，",
          "sc": "就去茶梅姐那边玩好了，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1136,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42529,
          "spk": "驹子 (コマコ)",
          "ja": "今度、ヨウちゃんと一緒に",
          "tc": "下次就來跟小洋一起",
          "sc": "下次就来跟小洋一起"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42536,
          "spk": "驹子 (コマコ)",
          "ja": "おっきな雪だるま作りに挑戦しようっと",
          "tc": "挑戰堆出巨大雪人好了。",
          "sc": "挑战堆出巨大雪人好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42554,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんにも協力してもらわないとね",
          "tc": "我也要請哥哥一起來幫忙才行。",
          "sc": "我也要请哥哥一起来帮忙才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1137,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42585,
          "spk": "驹子 (コマコ)",
          "ja": "雪が積もると、動物たちが隠れて",
          "tc": "一旦積雪，",
          "sc": "一旦积雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42592,
          "spk": "驹子 (コマコ)",
          "ja": "捕まえにくくなっちゃうんだ",
          "tc": "動物們就會躲起來，變得很難獵捕。",
          "sc": "动物们就会躲起来，变得很难猎捕。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42610,
          "spk": "驹子 (コマコ)",
          "ja": "それでも狩れるかどうか、",
          "tc": "到時候能不能捕得到動物，",
          "sc": "到时候能不能捕得到动物，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 42617,
          "spk": "驹子 (コマコ)",
          "ja": "腕の見せどころだね",
          "tc": "就要憑獵人的本事了。",
          "sc": "就要凭猎人的本事了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1138,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42641,
          "spk": "驹子 (コマコ)",
          "ja": "この寒さだと、動物たちも",
          "tc": "冷到了這個地步，",
          "sc": "冷到了这个地步，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42648,
          "spk": "驹子 (コマコ)",
          "ja": "さすがに動きが鈍るんだよ",
          "tc": "動物的行動也會變得遲鈍。",
          "sc": "动物的行动也会变得迟钝。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42655,
          "spk": "驹子 (コマコ)",
          "ja": "だから、今が狩りのチャンスなの",
          "tc": "所以正是狩獵的好機會。",
          "sc": "所以正是狩猎的好机会。"
        }
      ]
    },
    {
      "file": "talk.dat",
