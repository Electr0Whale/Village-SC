          "pidx_tc": 39887,
          "spk": "驹子 (コマコ)",
          "ja": "はしゃぎたくなっちゃうね",
          "tc": "就會莫名地想要大玩特玩呢。",
          "sc": "就会莫名地想要大玩特玩呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39898,
          "spk": "驹子 (コマコ)",
          "ja": "みんなでスイカ割りとかしたいなぁ",
          "tc": "真想跟大家一起打西瓜。",
          "sc": "真想跟大家一起打西瓜。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1077,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_WALK_20_105_2820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39929,
          "spk": "驹子 (コマコ)",
          "ja": "今日は湿気がすごいなぁ",
          "tc": "今天濕氣真重，",
          "sc": "今天湿气真重，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39936,
          "spk": "驹子 (コマコ)",
          "ja": "いろいろカビちゃいそう……",
          "tc": "感覺很多東西都會發霉呢……",
          "sc": "感觉很多东西都会发霉呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39947,
          "spk": "驹子 (コマコ)",
          "ja": "お布団の裏とか、",
          "tc": "得好好注意一下",
          "sc": "得好好注意一下"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39954,
          "spk": "驹子 (コマコ)",
          "ja": "気をつけて見ておかないと",
          "tc": "床鋪的裡層才行。",
          "sc": "床铺的里层才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1078,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_WALK_20_105_2821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39978,
          "spk": "驹子 (コマコ)",
          "ja": "ふふ、いい風が吹いてる",
          "tc": "呵呵，風吹得好舒服啊。",
          "sc": "呵呵，风吹得好舒服啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39989,
          "spk": "驹子 (コマコ)",
          "ja": "星もキレイに見えるし、",
          "tc": "星星也看得很清楚，",
          "sc": "星星也看得很清楚，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39996,
          "spk": "驹子 (コマコ)",
          "ja": "なんだか気持ちいいね",
          "tc": "感覺真舒服。",
          "sc": "感觉真舒服。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1079,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_WALK_20_105_2822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40020,
          "spk": "驹子 (コマコ)",
          "ja": "夜でも蒸し暑くなりそうだね……",
          "tc": "晚上應該也會很悶熱吧……",
          "sc": "晚上应该也会很闷热吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40027,
          "spk": "驹子 (コマコ)",
          "ja": "涼しい格好で寝ないとね",
          "tc": "得穿涼爽一點睡覺才行。",
          "sc": "得穿凉爽一点睡觉才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1080,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_WALK_20_105_2823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40058,
          "spk": "驹子 (コマコ)",
          "ja": "夏になると、動物たちも",
          "tc": "雖然一到了夏天，",
          "sc": "虽然一到了夏天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40065,
          "spk": "驹子 (コマコ)",
          "ja": "暑さで動きが鈍るんだけど……",
          "tc": "動物們也會因為天氣炎熱而變得遲鈍……",
          "sc": "动物们也会因为天气炎热而变得迟钝……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40076,
          "spk": "驹子 (コマコ)",
          "ja": "夜は涼しくなるから、",
          "tc": "但是到了夜晚就會變涼，",
          "sc": "但是到了夜晚就会变凉，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40083,
          "spk": "驹子 (コマコ)",
          "ja": "狩るのが難しいんだよね",
          "tc": "要狩獵又很難。",
          "sc": "要狩猎又很难。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1081,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40107,
          "spk": "驹子 (コマコ)",
          "ja": "これから寒くなるけど",
          "tc": "接下來會開始變冷，",
          "sc": "接下来会开始变冷，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40114,
          "spk": "驹子 (コマコ)",
          "ja": "がんばって育ってほしいな",
          "tc": "真希望它們能努力長大。",
          "sc": "真希望它们能努力长大。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1082,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40138,
          "spk": "驹子 (コマコ)",
          "ja": "葉っぱがだんだん枯れてきて",
          "tc": "綠葉漸漸枯萎，",
          "sc": "绿叶渐渐枯萎，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40145,
          "spk": "驹子 (コマコ)",
          "ja": "寂しい時期だね……",
          "tc": "又到了令人感到冷清的季節……",
          "sc": "又到了令人感到冷清的季节……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40156,
          "spk": "驹子 (コマコ)",
          "ja": "それでも、きれいなお花を咲かせるためには、",
          "tc": "即使如此，為了讓美麗的花綻放，",
          "sc": "即使如此，为了让美丽的花绽放，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40163,
          "spk": "驹子 (コマコ)",
          "ja": "お手入れは欠かさずしておかないとね",
          "tc": "還是得好好照顧才行。",
          "sc": "还是得好好照顾才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1083,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40187,
          "spk": "驹子 (コマコ)",
          "ja": "あ……葉っぱの色が変わってる",
          "tc": "啊……葉子變色了。",
          "sc": "啊……叶子变色了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40198,
          "spk": "驹子 (コマコ)",
          "ja": "こういうの見ると、",
          "tc": "看到變色的葉子，",
          "sc": "看到变色的叶子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40205,
          "spk": "驹子 (コマコ)",
          "ja": "秋が来たなって実感するんだよね",
          "tc": "就會覺得秋天真的來了呢。",
          "sc": "就会觉得秋天真的来了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1084,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40229,
          "spk": "驹子 (コマコ)",
          "ja": "あれ……どこだろ？",
          "tc": "奇怪……是在哪裡呢？",
          "sc": "奇怪……是在哪里呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40236,
          "spk": "驹子 (コマコ)",
          "ja": "リンに欲しいって言われてた素材、",
          "tc": "林想要的材料，",
          "sc": "林想要的材料，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40243,
          "spk": "驹子 (コマコ)",
          "ja": "ここにしまったはずなんだけど……",
          "tc": "我應該是收在這裡的啊……",
          "sc": "我应该是收在这里的啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1085,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40267,
          "spk": "驹子 (コマコ)",
          "ja": "よしよし、備蓄は十分だね！",
          "tc": "很好，儲備得很充足呢！",
          "sc": "很好，储备得很充足呢！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40274,
          "spk": "驹子 (コマコ)",
          "ja": "今年の冬もなんとかなりそうだよ",
          "tc": "今年冬天應該也有辦法撐過去了。",
          "sc": "今年冬天应该也有办法撑过去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1086,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40305,
          "spk": "驹子 (コマコ)",
          "ja": "あ、あれ……",
          "tc": "咦、奇怪……？",
          "sc": "咦、奇怪……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40312,
          "spk": "驹子 (コマコ)",
          "ja": "このヤスリ、こんなところに入ってる……",
          "tc": "這把銼刀，竟然放在這種地方……",
          "sc": "这把锉刀，竟然放在这种地方……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40319,
          "spk": "驹子 (コマコ)",
          "ja": "失くしちゃったと思ってたのに……",
          "tc": "我還以為不見了……",
          "sc": "我还以为不见了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40330,
          "spk": "驹子 (コマコ)",
          "ja": "……きっとお兄ちゃんだね",
          "tc": "……一定是哥哥吧。",
          "sc": "……一定是哥哥吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 40337,
          "spk": "驹子 (コマコ)",
          "ja": "勝手に持ってって、",
          "tc": "自己拿去用，",
          "sc": "自己拿去用，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 40344,
          "spk": "驹子 (コマコ)",
          "ja": "適当にしまったんだろうな……",
          "tc": "用完又隨便亂收……",
          "sc": "用完又随便乱收……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1087,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40368,
          "spk": "驹子 (コマコ)",
          "ja": "このあたりに生えてる野草は、",
          "tc": "這一帶隨意生長的野草中，",
          "sc": "这一带随意生长的野草中，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40375,
          "spk": "驹子 (コマコ)",
          "ja": "食べられるものも多いんだよ",
          "tc": "有許多是可以食用的。",
          "sc": "有许多是可以食用的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40386,
          "spk": "驹子 (コマコ)",
          "ja": "天ぷらにするとおいしいんだ",
          "tc": "拿來做天婦羅很好吃。",
          "sc": "拿来做天妇罗很好吃。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40393,
          "spk": "驹子 (コマコ)",
          "ja": "今度、<player>にも作ってあげるね",
          "tc": "那我下次再做給<player>你吃。",
          "sc": "那我下次再做给<player>你吃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1088,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40417,
          "spk": "驹子 (コマコ)",
          "ja": "えーと、これは毒があるから",
          "tc": "我看看，這個有毒，",
          "sc": "我看看，这个有毒，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40424,
          "spk": "驹子 (コマコ)",
          "ja": "食べちゃいけないんだよね……",
          "tc": "所以不能吃……",
          "sc": "所以不能吃……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40435,
          "spk": "驹子 (コマコ)",
          "ja": "図鑑を読んでおいてよかった",
          "tc": "有先研讀圖鑑真是太好了。",
          "sc": "有先研读图鉴真是太好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40442,
          "spk": "驹子 (コマコ)",
          "ja": "危うくお腹壊すところだったよ……",
          "tc": "不小心就會吃壞肚子的……",
          "sc": "不小心就会吃坏肚子的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1089,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40466,
          "spk": "驹子 (コマコ)",
          "ja": "もうちょっと採ったら",
          "tc": "再稍微採收一些",
          "sc": "再稍微采收一些"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40473,
          "spk": "驹子 (コマコ)",
          "ja": "持って帰ろうっと",
          "tc": "帶回去吧。",
          "sc": "带回去吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40484,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃん喜んでくれるかな？",
          "tc": "不知道哥哥會不會喜歡？",
          "sc": "不知道哥哥会不会喜欢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1090,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40508,
          "spk": "驹子 (コマコ)",
          "ja": "秋と言えばいろいろあるけど、",
          "tc": "秋天雖然有很多事要忙，",
          "sc": "秋天虽然有很多事要忙，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40515,
          "spk": "驹子 (コマコ)",
          "ja": "お休みも大事だよね……",
          "tc": "但休息也很重要呢……",
          "sc": "但休息也很重要呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40526,
          "spk": "驹子 (コマコ)",
          "ja": "トバリもそう言ってたし、",
          "tc": "帷也這麼說過呢，",
          "sc": "帷也这么说过呢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40533,
          "spk": "驹子 (コマコ)",
          "ja": "今日はゆっくりしよっと",
          "tc": "今天就休息一下吧。",
          "sc": "今天就休息一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1091,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40557,
          "spk": "驹子 (コマコ)",
          "ja": "読書の秋って言うし、たまには",
          "tc": "所謂「閱讀之秋」嘛，",
          "sc": "所谓“阅读之秋”嘛，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40564,
          "spk": "驹子 (コマコ)",
          "ja": "寝るまで本を読んで",
          "tc": "我也偶爾在睡前讀一點書，",
          "sc": "我也偶尔在睡前读一点书，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40571,
          "spk": "驹子 (コマコ)",
          "ja": "ゆっくり過ごそうかな？",
          "tc": "過得悠哉一點吧。",
          "sc": "过得悠哉一点吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1092,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40595,
          "spk": "驹子 (コマコ)",
          "ja": "日が暮れるのも早くなって、",
          "tc": "太陽下山的時間越來越早了，",
          "sc": "太阳下山的时间越来越早了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40602,
          "spk": "驹子 (コマコ)",
          "ja": "すっかり秋の空気になってきたよ",
          "tc": "已經完全是秋天的氣氛了。",
          "sc": "已经完全是秋天的气氛了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40613,
          "spk": "驹子 (コマコ)",
          "ja": "でも、このまま一気に寒くなりそうだね……",
          "tc": "感覺會一口氣變冷……",
          "sc": "感觉会一口气变冷……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 40620,
          "spk": "驹子 (コマコ)",
          "ja": "押し入れから毛布、出しておこうかな",
          "tc": "把壁櫥裡的毯子拿出來好了。",
          "sc": "把壁橱里的毯子拿出来好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1093,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40644,
          "spk": "驹子 (コマコ)",
          "ja": "お仕事もあるし、",
          "tc": "我還有工作要忙，",
          "sc": "我还有工作要忙，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40651,
          "spk": "驹子 (コマコ)",
          "ja": "さっと作れるごはんにしよう",
          "tc": "不如就做一些懶人料理吧。",
          "sc": "不如就做一些懒人料理吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1094,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40675,
