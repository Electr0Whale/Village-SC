      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42679,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、何か採りにきたの？",
          "tc": "咦？你是來採集東西的嗎？",
          "sc": "咦？你是来采集东西的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42690,
          "spk": "驹子 (コマコ)",
          "ja": "私も採取ついでに動物たちの様子を",
          "tc": "我也是要來採集東西，",
          "sc": "我也是要来采集东西，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42697,
          "spk": "驹子 (コマコ)",
          "ja": "見に来ようと思ってたところなの",
          "tc": "順便來觀察動物們的情況。",
          "sc": "顺便来观察动物们的情况。"
        }
      ]
    },
