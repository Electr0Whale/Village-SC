      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83314,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、今日も忙しそう",
          "tc": "叔叔今天好像也很忙。",
          "sc": "叔叔今天好像也很忙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83325,
          "spk": "洋 (ヨウ)",
          "ja": "……なにか、お手伝いできないかな",
          "tc": "……有沒有我能幫上忙的呢？",
          "sc": "……有没有我能帮上忙的呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2153,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83349,
          "spk": "洋 (ヨウ)",
          "ja": "わあ、お魚がいっぱい動いてる",
