      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83411,
          "spk": "洋 (ヨウ)",
          "ja": "雨の日の外って、少し寂しいね",
