          "f_idx": 1,
          "pidx_tc": 83387,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、ちょっとだけ楽しいかも",
          "tc": "總覺得滿有趣的。",
          "sc": "总觉得满有趣的。"
        }
      ]
    },
    {
      "file": "talk.dat",
