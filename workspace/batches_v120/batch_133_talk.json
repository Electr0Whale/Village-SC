          "f_idx": 1,
          "pidx_tc": 83418,
          "spk": "洋 (ヨウ)",
          "ja": "みんな、お家でじっとしてるのかな",
          "tc": "大家都乖乖待在家裡嗎？",
          "sc": "大家都乖乖待在家里吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2156,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1023",
      "lines": [
        {
