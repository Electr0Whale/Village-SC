      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83557,
          "spk": "洋 (ヨウ)",
          "ja": "折り紙って、ふしぎ",
          "tc": "摺紙真是不可思議。",
          "sc": "折纸真是不可思议。"
