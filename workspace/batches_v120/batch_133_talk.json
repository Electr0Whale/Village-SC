  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2126,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 81757,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 81764,
          "spk": "洋 (ヨウ)",
          "ja": "今日は「実り祭」だよ",
          "tc": "今天是「豐收祭」喔。",
          "sc": "今天是“丰收祭”哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 81775,
          "spk": "洋 (ヨウ)",
          "ja": "小さな村だから、日々の実りに、",
          "tc": "因為是小小的村子，全村聚在一起吃飯，",
          "sc": "因为是小小的村子，全村聚在一起吃饭，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 81782,
          "spk": "洋 (ヨウ)",
          "ja": "感謝しながら、村人全員でご飯を食べる日",
          "tc": "感謝每天都豐衣足食。",
          "sc": "感谢每天都丰衣足食。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 81789,
          "spk": "洋 (ヨウ)",
          "ja": "……っておじちゃんが教えてくれた",
          "tc": "……叔叔是這麼跟我說的。",
          "sc": "……叔叔是这么跟我说的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2127,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 81813,
          "spk": "洋 (ヨウ)",
          "ja": "今ね、たき火でお芋を焼いてるの",
          "tc": "我們現在在用火堆烤地瓜喔。",
          "sc": "我们现在在用火堆烤红薯哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 81820,
          "spk": "洋 (ヨウ)",
          "ja": "ほくほく甘くて美味しいんだよ",
          "tc": "吃起來很鬆軟又很甜，非常好吃喔。",
          "sc": "吃起来很松软又很甜，非常好吃哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 81838,
          "spk": "洋 (ヨウ)",
          "ja": "でも、火加減が難しくて……",
          "tc": "只是火候很難控制……",
          "sc": "只是火候很难控制……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 81845,
          "spk": "洋 (ヨウ)",
          "ja": "時間通りにしても、たまに生焼けだったり",
          "tc": "就算按照時間來，有時候會沒烤熟，",
          "sc": "就算按照时间来，有时候会没烤熟，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 81852,
          "spk": "洋 (ヨウ)",
          "ja": "焦げちゃったりするの",
          "tc": "有時候又會焦掉。",
          "sc": "有时候又会焦掉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 81863,
          "spk": "洋 (ヨウ)",
          "ja": "お料理って、奥が深いね……",
          "tc": "料理真的很深奧呢……",
          "sc": "料理真的很深奥呢……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 81870,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんはすごいんだね……",
          "tc": "叔叔真是厲害……",
          "sc": "叔叔真是厉害……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2128,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 81894,
          "spk": "洋 (ヨウ)",
          "ja": "<player>！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 81901,
          "spk": "洋 (ヨウ)",
          "ja": "よかった、来てくれて",
          "tc": "太好了，你願意來啊。",
          "sc": "太好了，你愿意来啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 81912,
          "spk": "洋 (ヨウ)",
          "ja": "いつもこの日の大人は忙しそうで……",
          "tc": "今天大人們總是很忙……",
          "sc": "今天大人们总是很忙……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 81919,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと近づきにくいの",
          "tc": "很難找他們說話。",
          "sc": "很难找他们说话。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 81937,
          "spk": "洋 (ヨウ)",
          "ja": "でも楽しいこともあるんだよ！",
          "tc": "但也還是有開心的事！",
          "sc": "但也还是有开心的事！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 81944,
          "spk": "洋 (ヨウ)",
          "ja": "早く始まるといいね",
          "tc": "真希望可以早點開始。",
          "sc": "真希望可以早点开始。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2129,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 81968,
          "spk": "洋 (ヨウ)",
          "ja": "おみくじって、なんだか楽しいよね",
          "tc": "抽籤很有趣對吧？",
          "sc": "抽签很有趣对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 81975,
          "spk": "洋 (ヨウ)",
          "ja": "なにが出てくるか、",
          "tc": "我還滿喜歡在知道抽到什麼之前，",
          "sc": "我还满喜欢在知道抽到什么之前，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 81982,
          "spk": "洋 (ヨウ)",
          "ja": "ドキドキして待つ時間がけっこう好きなの",
          "tc": "那種緊張又期待的感覺。",
          "sc": "那种紧张又期待的感觉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 81993,
          "spk": "洋 (ヨウ)",
          "ja": "あ、でも凶はイヤだな……",
          "tc": "啊，但是我不想抽到凶……",
          "sc": "啊，但是我不想抽到凶……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82000,
          "spk": "洋 (ヨウ)",
          "ja": "悲しい気持ちになっちゃうから",
          "tc": "因為會覺得很難過。",
          "sc": "因为会觉得很难过。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 82011,
          "spk": "洋 (ヨウ)",
          "ja": "もし大吉が出たら、おじちゃんにあげようかな",
          "tc": "如果抽到了大吉，就送給叔叔好了。",
          "sc": "如果抽到了大吉，就送给叔叔好了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 82018,
          "spk": "洋 (ヨウ)",
          "ja": "喜んでくれるといいけど",
          "tc": "希望他會很高興。",
          "sc": "希望他会很高兴。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2130,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82049,
          "spk": "洋 (ヨウ)",
          "ja": "今日は知らない人がいっぱいいて、",
          "tc": "今天有好多不認識的人，",
          "sc": "今天有好多不认识的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82056,
          "spk": "洋 (ヨウ)",
          "ja": "緊張しちゃった……",
          "tc": "好緊張……",
          "sc": "好紧张……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82067,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はお野菜やお花を",
          "tc": "<player>你沒有把蔬菜和花朵",
          "sc": "<player>你没有把蔬菜和花朵"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82074,
          "spk": "洋 (ヨウ)",
          "ja": "おじさんたちに見せなかったんだね",
          "tc": "給叔叔們看啊。",
          "sc": "给叔叔们看啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82085,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと残念だけど、気持ち、わかるよ",
          "tc": "雖然很可惜，但我懂你的心情。",
          "sc": "虽然很可惜，但我懂你的心情。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 82092,
          "spk": "洋 (ヨウ)",
          "ja": "知らない人に見せるの、怖いもんね",
          "tc": "要展示給不認識的人看，真的很可怕。",
          "sc": "要展示给不认识的人看，真的很可怕。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2131,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82123,
          "spk": "洋 (ヨウ)",
          "ja": "すごいね、<player>！",
          "tc": "太厲害了，<player>！",
          "sc": "太厉害了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82130,
          "spk": "洋 (ヨウ)",
          "ja": "Sランクってことは、優勝ってことでしょ？",
          "tc": "你獲得了S級，也就是優勝對吧？",
          "sc": "你获得了S级，也就是优胜对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82141,
          "spk": "洋 (ヨウ)",
          "ja": "みんなが、いっぱい褒めてたよ",
          "tc": "大家都一直稱讚你喔。",
          "sc": "大家都一直称赞你哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82148,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のが一番すてきだって",
          "tc": "說<player>種的蔬菜是最棒的。",
          "sc": "说<player>种的蔬菜是最棒的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2132,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82172,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82179,
          "spk": "洋 (ヨウ)",
          "ja": "……一番はとれなかったんだね",
          "tc": "……你沒有拿到第一名呢。",
          "sc": "……你没有拿到第一名呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82190,
          "spk": "洋 (ヨウ)",
          "ja": "でも、わたしは好きだよ",
          "tc": "可是我很喜歡",
          "sc": "可是我很喜欢"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82197,
          "spk": "洋 (ヨウ)",
          "ja": "<player>が持ってきた作物",
          "tc": "<player>你帶來的作物喔。",
          "sc": "<player>你带来的作物哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2133,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82221,
          "spk": "洋 (ヨウ)",
          "ja": "今日は動物の品評会なんだって",
          "tc": "我剛才聽叔叔說，",
          "sc": "我刚才听叔叔说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82228,
          "spk": "洋 (ヨウ)",
          "ja": "さっきおじちゃんに聞いたんだ",
          "tc": "今天是動物評鑑會喔。",
          "sc": "今天是动物评鉴会哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82239,
          "spk": "洋 (ヨウ)",
          "ja": "大切に育てられた動物さんは、",
          "tc": "被用心養大的動物們，",
          "sc": "被用心养大的动物们，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82246,
          "spk": "洋 (ヨウ)",
          "ja": "きっとすごく幸せそうなんだろうなあ……",
          "tc": "一定感覺非常幸福吧……",
          "sc": "一定感觉非常幸福吧……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82257,
          "spk": "洋 (ヨウ)",
          "ja": "次は<player>もエントリーするの？",
          "tc": "下次<player>也會報名嗎？",
          "sc": "下次<player>也会报名吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 82264,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、今から楽しみ",
          "tc": "我已經開始期待了。",
          "sc": "我已经开始期待了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2134,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82295,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、一番を取れたんだ",
          "tc": "<player>拿到第一名了啊。",
          "sc": "<player>拿到第一名了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82302,
          "spk": "洋 (ヨウ)",
          "ja": "よかったね",
          "tc": "真是太好了呢。",
          "sc": "真是太好了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82313,
          "spk": "洋 (ヨウ)",
          "ja": "とってもとっても頑張ってたもんね",
          "tc": "因為你真的非常非常努力了，",
          "sc": "因为你真的非常非常努力了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82320,
          "spk": "洋 (ヨウ)",
          "ja": "その分、動物さんも答えてくれたんだね",
          "tc": "所以動物們也回應了你的心意呢。",
          "sc": "所以动物们也回应了你的心意呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2135,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0155",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82351,
          "spk": "洋 (ヨウ)",
          "ja": "<player>の動物さん、見たよ",
          "tc": "我有看到<player>的動物了喔。",
          "sc": "我看到<player>养的动物了哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82358,
          "spk": "洋 (ヨウ)",
          "ja": "とっても大事に育てたのが、見てて分かった",
          "tc": "一看就知道牠們受到了很好的照顧。",
          "sc": "一看就知道它们受到了很好的照顾。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82369,
          "spk": "洋 (ヨウ)",
          "ja": "結果は少し残念だったけど……",
          "tc": "雖然結果有點可惜……",
          "sc": "虽然结果有点可惜……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82376,
          "spk": "洋 (ヨウ)",
          "ja": "わたしは<player>が育てたあの子、",
          "tc": "但我很喜歡<player>培育的",
          "sc": "但我很喜欢<player>培育的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82383,
          "spk": "洋 (ヨウ)",
          "ja": "好きだよ",
          "tc": "那個動物喔。",
          "sc": "那个动物哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2136,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82407,
          "spk": "洋 (ヨウ)",
          "ja": "今日はお馬さんの品評会なんだよ",
          "tc": "今天是馬的評鑑會喔。",
          "sc": "今天是马的评鉴会哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82414,
          "spk": "洋 (ヨウ)",
          "ja": "お馬さんって、大きくてきれいで、",
          "tc": "馬又高大又美麗，",
          "sc": "马又高大又美丽，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82421,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、大好きなの",
          "tc": "我最喜歡馬了。",
          "sc": "我最喜欢马了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82432,
          "spk": "洋 (ヨウ)",
          "ja": "一度でいいから、",
          "tc": "就算只有一次也好，",
          "sc": "就算只有一次也好，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82439,
          "spk": "洋 (ヨウ)",
          "ja": "あの背中に乗ってみたいなあ",
          "tc": "真想坐到馬背上看看。",
          "sc": "真想坐到马背上看看。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 82450,
          "spk": "洋 (ヨウ)",
          "ja": "……今のわたしじゃ落ちちゃいそうだから、",
          "tc": "……不過現在的我應該很容易摔下來，",
          "sc": "……不过现在的我应该很容易摔下来，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 82457,
          "spk": "洋 (ヨウ)",
          "ja": "大人になったら挑戦してみようかな",
          "tc": "所以等長大之後我再挑戰看看吧。",
          "sc": "所以等长大之后我再挑战看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2137,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82481,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のお馬さん、一番だって",
          "tc": "<player>的馬是第一名耶，",
          "sc": "<player>的马是第一名呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82488,
          "spk": "洋 (ヨウ)",
          "ja": "すごいすごい、本当にすごい",
          "tc": "好厲害好厲害，真的好厲害！",
          "sc": "好厉害好厉害，真的好厉害！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82497,
          "spk": "洋 (ヨウ)",
          "ja": "あんなキレイなお馬さん、",
          "tc": "我好像是第一次看到",
          "sc": "我好像是第一次看到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82504,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはじめて見たかも",
          "tc": "那麼漂亮的馬。",
          "sc": "那么漂亮的马。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82511,
