          "pidx_tc": 83571,
          "spk": "洋 (ヨウ)",
          "ja": "色んな形になれるんだもん",
          "tc": "就能變成各種形狀呢。",
          "sc": "就能变成各种形状呢。"
        }
      ]
    },
    {
