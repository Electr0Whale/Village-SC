  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5556,
      "rec_id": "TALK_ID_10_0503_312_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323108,
          "spk": "驹子 (コマコ)",
          "ja": "あ、サザンカさん、<player>",
          "tc": "啊，茶梅姐、<player>。",
          "sc": "啊，茶梅姐、<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323115,
          "spk": "驹子 (コマコ)",
          "ja": "おかえりなさい",
          "tc": "你們回來啦。",
          "sc": "你们回来啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323126,
          "spk": "驹子 (コマコ)",
          "ja": "お店、臨時休業って出てたから",
          "tc": "因為雜貨店臨時店休，",
          "sc": "因为杂货店临时店休，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 323133,
          "spk": "驹子 (コマコ)",
          "ja": "藪に行ったのかなって思って……",
          "tc": "我就在猜妳應該是去了草叢……",
          "sc": "我就在猜你应该是去了草丛……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 323153,
          "spk": "茶梅 (サザンカ)",
          "ja": "それで待っててくれたの？",
          "tc": "所以妳就在這裡等我嗎？",
          "sc": "所以你就在这里等我吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 323160,
          "spk": "茶梅 (サザンカ)",
          "ja": "はは、ありがとね～",
          "tc": "哈哈，謝啦～",
          "sc": "哈哈，谢啦～"
        },
        {
          "f_idx": 7,
          "pidx_tc": 323171,
          "spk": "茶梅 (サザンカ)",
          "ja": "ただ、残念ながら",
          "tc": "但很可惜，",
          "sc": "但很可惜，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 323178,
          "spk": "茶梅 (サザンカ)",
          "ja": "何も見つからなかったよ……",
          "tc": "我們什麼都沒找到……",
          "sc": "我们什么都没找到……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 323191,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 323198,
          "spk": "驹子 (コマコ)",
          "ja": "そうなんだ……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 323211,
          "spk": "茶梅 (サザンカ)",
          "ja": "これはいよいよ",
          "tc": "這下子，",
          "sc": "这下子，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 323218,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんのホラ話ってことなのかな～",
          "tc": "越來越有可能只是爺爺在吹牛了呢～",
          "sc": "越来越有可能只是爷爷在吹牛了呢～"
        },
        {
          "f_idx": 13,
          "pidx_tc": 323227,
          "spk": "茶梅 (サザンカ)",
          "ja": "シロージが言うとおり、",
          "tc": "就像四郎治說的，",
          "sc": "就像四郎治说的，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 323234,
          "spk": "茶梅 (サザンカ)",
          "ja": "埋蔵金探しなんて諦めるべきなのかもね",
          "tc": "我可能真的應該放棄尋找地下寶藏了。",
          "sc": "我可能真的应该放弃寻找地下宝藏了。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 323247,
          "spk": "驹子 (コマコ)",
          "ja": "え……お兄ちゃんが",
          "tc": "咦……",
          "sc": "咦……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 323254,
          "spk": "驹子 (コマコ)",
          "ja": "そんなこと……？",
          "tc": "哥哥他說過那種話……？",
          "sc": "哥哥他说过那种话……？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 323267,
          "spk": "茶梅 (サザンカ)",
          "ja": "……ごめん、今日はここで解散でいい？",
          "tc": "……抱歉，今天可以就在這裡解散嗎？",
          "sc": "……抱歉，今天可以就在这里解散吗？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 323285,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょっとなんか……",
          "tc": "我總覺得……",
          "sc": "我总觉得……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 323292,
          "spk": "茶梅 (サザンカ)",
          "ja": "一人になりたいかも……",
          "tc": "有點想自己獨處……",
          "sc": "有点想自己独处……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 323305,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん",
          "tc": "好、好的。",
          "sc": "好、好的。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 323312,
          "spk": "驹子 (コマコ)",
          "ja": "わかったよ",
          "tc": "我知道了。",
          "sc": "我知道了。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 323325,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃーね",
          "tc": "下次見囉～",
          "sc": "下次见啦～"
        }
      ]
    },
