      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323432,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……じゃあ、他になにか、",
          "tc": "啊……那在草叢裡，",
          "sc": "啊……那在草丛里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323439,
          "spk": "驹子 (コマコ)",
          "ja": "薮の中に気になるものはなかった？",
          "tc": "還有其他讓人在意的東西嗎？",
          "sc": "还有其他让人在意的东西吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323446,
          "spk": "驹子 (コマコ)",
          "ja": "なんでもいいんだけど……なにか……",
          "tc": "任何東西都可以……有嗎……",
          "sc": "任何东西都可以……有吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
