      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323814,
          "spk": "四郎治 (シロージ)",
          "ja": "お前……聞いてたのか？",
          "tc": "你……都聽到了嗎？",
          "sc": "你……都听到了吗？"
