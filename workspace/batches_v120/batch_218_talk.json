    {
      "file": "talk.dat",
      "rec_idx": 5563,
      "rec_id": "TALK_ID_10_0503_313_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323549,
          "spk": "驹子 (コマコ)",
          "ja": "どうして何も言ってくれないの？",
          "tc": "為什麼什麼都不告訴我呢？",
          "sc": "为什么什么都不告诉我呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323556,
          "spk": "驹子 (コマコ)",
          "ja": "隠さないで教えてほしいよ",
          "tc": "別再瞞我了，跟我說好不好？",
          "sc": "别再瞒我了，跟我说好不好？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323567,
          "spk": "四郎治 (シロージ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 323580,
          "spk": "驹子 (コマコ)",
          "ja": "お願い、お兄ちゃん",
          "tc": "拜託你，哥哥。",
          "sc": "拜托你，哥哥。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 323587,
          "spk": "驹子 (コマコ)",
          "ja": "神器が必要なの",
          "tc": "我需要神器，",
          "sc": "我需要神器，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 323594,
          "spk": "驹子 (コマコ)",
          "ja": "どこにあるのか教えて",
          "tc": "告訴我在哪裡。",
          "sc": "告诉我在哪里。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 323603,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんは何か知ってるんでしょ？",
          "tc": "哥哥你應該知道些什麼吧？",
          "sc": "哥哥你应该知道些什么吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 323610,
          "spk": "驹子 (コマコ)",
          "ja": "私、わかってるんだよ",
          "tc": "我看得出來。",
          "sc": "我看得出来。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 323623,
          "spk": "四郎治 (シロージ)",
          "ja": "……そこまで言うなら認めてやるよ",
          "tc": "……既然妳都這麼說了，",
          "sc": "……既然你都这么说了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 323630,
          "spk": "四郎治 (シロージ)",
          "ja": "確かに、俺は神器の場所を知ってる",
          "tc": "我承認，我的確知道神器在哪裡。",
          "sc": "我承认，我的确知道神器在哪里。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 323643,
          "spk": "驹子 (コマコ)",
          "ja": "……！！",
          "tc": "……！！",
          "sc": "……！！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 323650,
          "spk": "驹子 (コマコ)",
          "ja": "やっぱり……！",
          "tc": "果然是這樣……！",
          "sc": "果然是这样……！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 323661,
          "spk": "驹子 (コマコ)",
          "ja": "神器はきっと、",
          "tc": "神器一定，",
          "sc": "神器一定，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 323668,
          "spk": "驹子 (コマコ)",
          "ja": "山の藪にあるんだよね？",
          "tc": "在山上的草叢裡對吧？",
          "sc": "在山上的草丛里对吧？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 323681,
          "spk": "四郎治 (シロージ)",
          "ja": "お前に言うつもりはない",
          "tc": "我不打算告訴妳。",
          "sc": "我不打算告诉你。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 323694,
          "spk": "驹子 (コマコ)",
          "ja": "！？",
          "tc": "！？",
          "sc": "！？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 323701,
          "spk": "驹子 (コマコ)",
          "ja": "どうして……？",
          "tc": "為什麼……？",
          "sc": "为什么……？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 323712,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……私だからダメなの？",
          "tc": "啊……因為問的人是我嗎？",
          "sc": "啊……因为问的人是我吗？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 323719,
          "spk": "驹子 (コマコ)",
          "ja": "他の人になら話してくれる？",
          "tc": "換成別人你就願意說了？",
          "sc": "换成别人你就愿意说了？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 323732,
          "spk": "四郎治 (シロージ)",
          "ja": "他の誰にも言うつもりはねぇよ",
          "tc": "我根本不打算告訴任何人。",
          "sc": "我根本不打算告诉任何人。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 323743,
          "spk": "四郎治 (シロージ)",
          "ja": "これは、俺が墓まで",
          "tc": "這是我",
          "sc": "这是我"
        },
        {
          "f_idx": 21,
          "pidx_tc": 323750,
          "spk": "四郎治 (シロージ)",
          "ja": "持ってく秘密だ",
          "tc": "要帶進墳墓的祕密。",
          "sc": "要带进坟墓的秘密。"
        }
      ]
    },
    {
