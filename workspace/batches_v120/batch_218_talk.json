          "spk": "驹子 (コマコ)",
          "ja": "そっか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323471,
          "spk": "驹子 (コマコ)",
          "ja": "なにも、ないんだ……",
          "tc": "什麼都沒有啊……",
          "sc": "什么都没有啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323482,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……いや、大丈夫！",
          "tc": "咦……不，沒關係！",
          "sc": "咦……不，没关系！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 323489,
          "spk": "驹子 (コマコ)",
          "ja": "なんでもないから！",
          "tc": "什麼事也沒有！",
          "sc": "什么事也没有！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 323500,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさんの探しているもの、",
          "tc": "希望茶梅姐可以早點找到",
          "sc": "希望茶梅姐可以早点找到"
        },
        {
          "f_idx": 5,
          "pidx_tc": 323507,
          "spk": "驹子 (コマコ)",
          "ja": "早く見つかるといいね",
          "tc": "她在找的東西。",
          "sc": "她在找的东西。"
