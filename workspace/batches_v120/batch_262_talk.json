        {
          "f_idx": 1,
          "pidx_tc": 413812,
          "spk": "琪娜娜 (チナナ)",
          "ja": "というワケでは、なさそうだね",
          "tc": "似乎不是呢。",
          "sc": "似乎不是呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 413825,
          "spk": "名护 (ナゴ)",
