      "rec_id": "TALK_ID_70_2100_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414111,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ナゴさんが心変わりしたのは",
          "tc": "名護先生之所以改變心意，",
          "sc": "名护先生之所以改变心意，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414118,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミの影響なんだろう？",
          "tc": "是受到你的影響吧？",
          "sc": "是受到你的影响吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414129,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なら、お礼を言っておかないとね",
          "tc": "那得好好跟你道謝才行呢。",
          "sc": "那得好好跟你道谢才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7430,
      "rec_id": "TALK_ID_70_2100_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414147,
          "spk": "琪娜娜 (チナナ)",
          "ja": "相変わらず眉間にシワはあるけど",
          "tc": "雖然他眉頭還是皺得很緊，",
          "sc": "虽然他眉头还是皱得很紧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414154,
          "spk": "琪娜娜 (チナナ)",
          "ja": "最初の頃より、ずっと笑顔が増えた",
          "tc": "但和當初相比，更常露出笑容了。",
          "sc": "但和当初相比，更常露出笑容了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414165,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それに、羽振りだって",
          "tc": "更何況花起錢來",
          "sc": "更何况花起钱来"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414172,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よくなったし",
          "tc": "也更大方了。",
          "sc": "也更大方了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414183,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おかげさまで",
          "tc": "多虧這樣，",
          "sc": "多亏这样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 414190,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの懐も温かくなるってもんだ",
          "tc": "我手頭也寬裕了不少呢。",
          "sc": "我手头也宽裕了不少呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 414201,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい金づる……",
          "tc": "能有這麼棒的搖錢樹……",
          "sc": "能有这么棒的摇钱树……"
        },
