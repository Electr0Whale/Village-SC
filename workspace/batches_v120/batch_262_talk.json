      "rec_id": "TALK_ID_70_2100_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413805,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミも注文……",
          "tc": "你也是來下單……",
          "sc": "你也是来下单……"
