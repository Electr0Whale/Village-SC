          "pidx_tc": 413949,
          "spk": "名护 (ナゴ)",
          "ja": "なければ取り寄せてほしいんだけど",
          "tc": "沒有的話想請妳幫我訂。",
          "sc": "没有的话想请你帮我订。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 413962,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次来る時までには仕入れておくよ",
          "tc": "你下次來之前我會備好貨的。",
          "sc": "你下次来之前我会备好货的。"
