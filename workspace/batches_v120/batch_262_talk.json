      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413613,
          "spk": "名护 (ナゴ)",
          "ja": "やあ、<player>さん",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413624,
          "spk": "名护 (ナゴ)",
          "ja": "今、彼女に別れを伝えたんだ",
          "tc": "我剛剛和女友提分手了。",
          "sc": "我刚刚和女友提分手了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 413635,
          "spk": "名护 (ナゴ)",
          "ja": "もう、帰れなくなってしまったからね",
          "tc": "畢竟已經回不去了。",
          "sc": "毕竟已经回不去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7421,
      "rec_id": "TALK_ID_70_2100_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413653,
          "spk": "名护 (ナゴ)",
          "ja": "……<player>さん",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413660,
          "spk": "名护 (ナゴ)",
          "ja": "これは、自分で決めたことなんだ",
          "tc": "這是我自己的決定。",
          "sc": "这是我自己的决定。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 413669,
          "spk": "名护 (ナゴ)",
          "ja": "この場所で、自分にとって",
          "tc": "因為我在這裡找到了",
          "sc": "因为我在这里找到了"
        },
        {
          "f_idx": 3,
          "pidx_tc": 413676,
          "spk": "名护 (ナゴ)",
          "ja": "「大切なもの」を見つけてしまったから……",
          "tc": "對我來說「很重要的事物」……",
          "sc": "对我来说“很重要的事物”……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 413687,
          "spk": "名护 (ナゴ)",
          "ja": "だから、もうしばらくは、",
          "tc": "所以我想要",
          "sc": "所以我想要"
        },
        {
          "f_idx": 5,
          "pidx_tc": 413694,
          "spk": "名护 (ナゴ)",
          "ja": "ここに居たいんだ……",
          "tc": "在這裡多待一段時間……",
          "sc": "在这里多待一段时间……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 413705,
          "spk": "名护 (ナゴ)",
          "ja": "さてと……",
          "tc": "好了……",
          "sc": "好了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 413712,
          "spk": "名护 (ナゴ)",
          "ja": "そろそろ仕事に戻らないと",
          "tc": "我差不多該回去工作了。",
          "sc": "我差不多该回去工作了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 413723,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃ、またね",
          "tc": "那就改天見囉。",
          "sc": "那就改天见啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7422,
      "rec_id": "TALK_ID_70_2100_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413749,
          "spk": "名护 (ナゴ)",
          "ja": "あとは……冷蔵庫かな？",
          "tc": "再來還剩……冰箱吧？",
          "sc": "再来还剩……冰箱吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413760,
          "spk": "名护 (ナゴ)",
          "ja": "他にも必要な物が出てきたら、",
          "tc": "要是有其他需要的東西，",
          "sc": "要是有其他需要的东西，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 413767,
          "spk": "名护 (ナゴ)",
          "ja": "また頼らせてもらうよ",
          "tc": "到時就拜託妳了。",
          "sc": "到时就拜托你了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 413780,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まいどあり",
          "tc": "多謝惠顧！",
          "sc": "多谢惠顾！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 413787,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご用命とあれば、いつでも駆けつけるよ",
          "tc": "只要有吩咐，隨時任你差遣。",
          "sc": "只要有吩咐，随时任你差遣。"
        }
      ]
    },
    {
      "file": "talk.dat",
