        },
        {
          "f_idx": 4,
          "pidx_tc": 413843,
          "spk": "名护 (ナゴ)",
          "ja": "村での暮らしを充実させるために、",
          "tc": "為了在村子裡過上充實的生活，",
          "sc": "为了在村子里过上充实的生活，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 413850,
          "spk": "名护 (ナゴ)",
          "ja": "白物家電を買っていたんだ",
