          "f_idx": 7,
          "pidx_tc": 414208,
          "spk": "琪娜娜 (チナナ)",
          "ja": "新しい住人を招いてくれたこと",
          "tc": "我是說能有新的居民，",
          "sc": "我是说能有新的居民，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 414215,
          "spk": "琪娜娜 (チナナ)",
          "ja": "感謝するよ、<player>",
          "tc": "真的很感謝你，<player>。",
          "sc": "真的很感谢你，<player>。"
        }
      ]
    }
