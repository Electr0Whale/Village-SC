        {
          "f_idx": 0,
          "pidx_tc": 411934,
          "spk": "名护 (ナゴ)",
          "ja": "俺はいつまで、ここに……",
          "tc": "我還要在這裡待多久……",
          "sc": "我还要在这里待多久……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7401,
      "rec_id": "TALK_ID_70_2100_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411958,
          "spk": "名护 (ナゴ)",
          "ja": "いたのか、<player>さん！？",
          "tc": "你在啊，<player>！？",
          "sc": "你在啊，<player>！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411965,
          "spk": "名护 (ナゴ)",
          "ja": "驚かさないでくれよ……",
          "tc": "別嚇我啊……",
          "sc": "别吓我啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411976,
          "spk": "名护 (ナゴ)",
          "ja": "……今の聞いてたか？",
          "tc": "……你都聽見了嗎？",
          "sc": "……你都听见了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411983,
          "spk": "名护 (ナゴ)",
          "ja": "聞いてたよな……きっと",
          "tc": "肯定都聽到了吧……",
          "sc": "肯定都听到了吧……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411994,
          "spk": "名护 (ナゴ)",
          "ja": "俺は……色んなものを",
          "tc": "我……有很多東西",
          "sc": "我……有很多东西"
        },
        {
          "f_idx": 5,
          "pidx_tc": 412001,
          "spk": "名护 (ナゴ)",
          "ja": "村の外に置いてきてしまっていて……",
          "tc": "留在了這座村子之外……",
          "sc": "留在了这座村子之外……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 412010,
          "spk": "名护 (ナゴ)",
          "ja": "それがずっと気がかりで……",
          "tc": "所以心裡一直很在意……",
          "sc": "所以心里一直很在意……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 412021,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんはどうして",
          "tc": "為什麼<player>",
          "sc": "为什么<player>"
        },
        {
          "f_idx": 8,
          "pidx_tc": 412028,
          "spk": "名护 (ナゴ)",
          "ja": "この村に留まっている？",
          "tc": "會留在這座村子？",
          "sc": "会留在这座村子？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 412037,
          "spk": "名护 (ナゴ)",
          "ja": "大切なものが村の外にあったら",
          "tc": "要是在村外有重要的事物，",
          "sc": "要是在村外有重要的事物，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 412044,
          "spk": "名护 (ナゴ)",
          "ja": "キミも外に出たいと思うか？",
          "tc": "你也會想要離開嗎？",
          "sc": "你也会想要离开吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7402,
      "rec_id": "TALK_ID_70_2100_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412069,
          "spk": "名护 (ナゴ)",
          "ja": "すまない",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412076,
          "spk": "名护 (ナゴ)",
          "ja": "困らせる質問をしたね",
          "tc": "問了會讓你困擾的問題。",
          "sc": "问了会让你困扰的问题。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 412087,
          "spk": "名护 (ナゴ)",
          "ja": "……この村が",
          "tc": "……我並不是",
          "sc": "……我并不是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 412094,
          "spk": "名护 (ナゴ)",
          "ja": "嫌いなワケじゃないんだ",
          "tc": "討厭這座村子。",
          "sc": "讨厌这座村子。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 412105,
          "spk": "名护 (ナゴ)",
          "ja": "美しい景観が残っている土地だし、",
          "tc": "這塊土地保留了美麗的景色，",
          "sc": "这块土地保留了美丽的景色，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 412112,
          "spk": "名护 (ナゴ)",
          "ja": "文化だって他のどこを探したってない",
          "tc": "也有其他地方沒有的獨特文化。",
          "sc": "也有其他地方没有的独特文化。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 412123,
          "spk": "名护 (ナゴ)",
          "ja": "だからこそ、ここを守ろうと",
          "tc": "因此為了守護這裡，",
          "sc": "因此为了守护这里，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 412130,
          "spk": "名护 (ナゴ)",
          "ja": "試行錯誤してるんだけど、",
          "tc": "我反覆做了各種嘗試，",
          "sc": "我反复做了各种尝试，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 412137,
          "spk": "名护 (ナゴ)",
          "ja": "どうにも上手くいかなくてね……",
          "tc": "卻都不太順利……",
          "sc": "却都不太顺利……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 412148,
          "spk": "名护 (ナゴ)",
          "ja": "ソーラーパネルを設置するとか……",
          "tc": "像是設置太陽能板之類的……",
          "sc": "像是设置太阳能板之类的……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 412155,
          "spk": "名护 (ナゴ)",
          "ja": "キミのところにも営業に行っただろう",
          "tc": "我不是也有跟你推銷嗎？",
          "sc": "我不是也有跟你推销吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 412171,
          "spk": "名护 (ナゴ)",
          "ja": "この村の存続を決めるのは、",
          "tc": "決定這座村子存亡的",
          "sc": "决定这座村子存亡的"
        },
        {
          "f_idx": 13,
          "pidx_tc": 412178,
          "spk": "名护 (ナゴ)",
          "ja": "村に住む住人たちだ",
          "tc": "是村子裡的居民。",
          "sc": "是村子里的居民。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 412185,
          "spk": "名护 (ナゴ)",
          "ja": "……俺のような部外者じゃない",
          "tc": "……而不是像我這樣的局外人。",
          "sc": "……而不是像我这样的局外人。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 412196,
          "spk": "名护 (ナゴ)",
          "ja": "けど、この村を守るために",
          "tc": "但是，為了守護這座村子，",
          "sc": "但是，为了守护这座村子，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 412203,
          "spk": "名护 (ナゴ)",
          "ja": "出来ることだってあるはずだ",
          "tc": "一定還有我能做的事。",
          "sc": "一定还有我能做的事。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 412214,
          "spk": "名护 (ナゴ)",
          "ja": "難しい問題だけど、どうにか",
          "tc": "雖然很困難，",
          "sc": "虽然很困难，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 412221,
          "spk": "名护 (ナゴ)",
          "ja": "解決策を見つけたいんだ",
          "tc": "我還是想找出解決之道。",
          "sc": "我还是想找出解决之道。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 412232,
          "spk": "名护 (ナゴ)",
          "ja": "……<player>さんも",
          "tc": "……<player>也是，",
          "sc": "……<player>也是，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 412239,
          "spk": "名护 (ナゴ)",
          "ja": "何か良いアイデアが浮かんだら",
          "tc": "如果想到什麼好點子，",
          "sc": "如果想到什么好点子，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 412246,
          "spk": "名护 (ナゴ)",
          "ja": "教えてくれると助かるよ",
          "tc": "要是能告訴我，我會很感激的。",
          "sc": "要是能告诉我，我会很感激的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7403,
      "rec_id": "TALK_ID_70_2100_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412270,
          "spk": "名护 (ナゴ)",
          "ja": "仕方ないだろ……",
          "tc": "沒辦法啊……",
          "sc": "没办法啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412277,
          "spk": "名护 (ナゴ)",
          "ja": "俺にだって、事情があるんだから",
          "tc": "我也有我的考量。",
          "sc": "我也有我的考量。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 412288,
          "spk": "名护 (ナゴ)",
          "ja": "だから、帰るワケには……",
          "tc": "所以不能就這樣回去……",
          "sc": "所以不能就这样回去……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 412306,
          "spk": "名护 (ナゴ)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 412313,
          "spk": "名护 (ナゴ)",
          "ja": "いや、もちろん、俺は帰りたいんだが……",
          "tc": "不，我當然想要回去……",
          "sc": "不，我当然想要回去……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 412320,
          "spk": "名护 (ナゴ)",
          "ja": "ちょっと……いろいろな理由で……",
          "tc": "但是……有很多原因所以……",
          "sc": "但是……有很多原因所以……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 412331,
          "spk": "名护 (ナゴ)",
          "ja": "いや、ごめん",
          "tc": "啊，抱歉！",
          "sc": "啊，抱歉！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 412338,
          "spk": "名护 (ナゴ)",
          "ja": "からかってるつもりは……",
          "tc": "我不是在戲弄妳……",
          "sc": "我不是在戏弄你……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 412349,
          "spk": "名护 (ナゴ)",
          "ja": "うんうん……また電話するから",
          "tc": "嗯嗯……我再打給妳。",
          "sc": "嗯嗯……我再打给你。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 412356,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃあ……",
          "tc": "那就先這樣……",
          "sc": "那就先这样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7404,
      "rec_id": "TALK_ID_70_2100_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412374,
          "spk": "名护 (ナゴ)",
          "ja": "……はぁ、こっちの気も知らないで",
          "tc": "……唉，根本不懂我的心情。",
          "sc": "……唉，根本不懂我的心情。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7405,
      "rec_id": "TALK_ID_70_2100_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412405,
          "spk": "名护 (ナゴ)",
          "ja": "あ……",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412416,
          "spk": "名护 (ナゴ)",
          "ja": "今のは……",
          "tc": "剛才的是……",
          "sc": "刚才的是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 412423,
          "spk": "名护 (ナゴ)",
          "ja": "街にいる同棲中の彼女だよ",
          "tc": "在市區跟我同居的女友。",
          "sc": "在市区跟我同居的女友。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 412432,
          "spk": "名护 (ナゴ)",
          "ja": "……しばらく、会ってないけどね",
          "tc": "……已經一陣子沒見就是了。",
          "sc": "……已经一阵子没见就是了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 412450,
          "spk": "名护 (ナゴ)",
          "ja": "村に来る前にケンカして以来、",
          "tc": "在來到村子之前我們吵架了，",
          "sc": "在来到村子之前我们吵架了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 412457,
          "spk": "名护 (ナゴ)",
          "ja": "一度も顔をあわせてないんだ",
          "tc": "從那之後就沒見過面。",
          "sc": "从那之后就没见过面。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 412466,
          "spk": "名护 (ナゴ)",
          "ja": "放っておくワケにもいかないから",
          "tc": "畢竟也不能放著不管，",
          "sc": "毕竟也不能放着不管，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 412473,
          "spk": "名护 (ナゴ)",
          "ja": "時折電話をかけてるんだけど……",
          "tc": "所以我偶爾會打電話給她……",
          "sc": "所以我偶尔会打电话给她……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 412484,
          "spk": "名护 (ナゴ)",
          "ja": "そのたびに、今みたいな",
          "tc": "但每次都像剛才那樣，",
          "sc": "但每次都像刚才那样，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 412491,
          "spk": "名护 (ナゴ)",
          "ja": "口論になるんだよ……",
          "tc": "最後跟她吵起來……",
          "sc": "最后跟她吵起来……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 412500,
          "spk": "名护 (ナゴ)",
          "ja": "そんな状態がずっと続いて……",
          "tc": "這種情況一直在持續……",
          "sc": "这种情况一直在持续……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 412507,
          "spk": "名护 (ナゴ)",
          "ja": "いい加減、疲れてきたよ……",
          "tc": "老實說我開始覺得受夠了。",
          "sc": "老实说我开始觉得受够了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 412518,
          "spk": "名护 (ナゴ)",
          "ja": "……こんなこと言われても困るよな",
          "tc": "……說這些也只會讓你困擾吧。",
          "sc": "……说这些也只会让你困扰吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 412527,
          "spk": "名护 (ナゴ)",
          "ja": "いっそ、忘れてしまえばとも思うけど",
          "tc": "如果能全部忘記就好了，",
          "sc": "如果能全部忘记就好了，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 412534,
          "spk": "名护 (ナゴ)",
          "ja": "そうもいかなくてさ",
          "tc": "卻沒這麼簡單呢。",
          "sc": "却没这么简单呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 412545,
          "spk": "名护 (ナゴ)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 412552,
          "spk": "名护 (ナゴ)",
          "ja": "俺にとって、本当に大切なものって",
          "tc": "對我來說真正重要的東西，",
          "sc": "对我来说真正重要的东西，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 412559,
          "spk": "名护 (ナゴ)",
          "ja": "なんなんだろうな……",
          "tc": "究竟是什麼呢……",
          "sc": "究竟是什么呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7406,
      "rec_id": "TALK_ID_70_2100_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412583,
          "spk": "名护 (ナゴ)",
          "ja": "ま、また散らかってる……！",
          "tc": "又、又弄得這麼亂……！",
          "sc": "又、又弄得这么乱……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412590,
          "spk": "名护 (ナゴ)",
          "ja": "この前整理したばかりなのに……！",
          "tc": "明明之前才整理過的……！",
          "sc": "明明之前才整理过的……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7407,
      "rec_id": "TALK_ID_70_2100_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412612,
          "spk": "堇怜 (スミレ)",
          "ja": "すみません、",
          "tc": "很抱歉，",
          "sc": "很抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412619,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も何度か片付けたんですけど……",
          "tc": "雖然我已經收拾過幾次了……",
          "sc": "虽然我已经收拾过几次了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 412634,
          "spk": "名护 (ナゴ)",
          "ja": "こ、これで……？",
          "tc": "這、這叫收拾過……？",
          "sc": "这、这叫收拾过……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 412641,
          "spk": "名护 (ナゴ)",
          "ja": "元はどれだけひどかったんだ……",
          "tc": "那原本到底有多亂啊……",
          "sc": "那原本到底有多乱啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 412652,
          "spk": "名护 (ナゴ)",
          "ja": "一体どうしてこんなことに……？",
          "tc": "究竟為什麼會變成這樣……？",
          "sc": "究竟为什么会变成这样……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 412665,
          "spk": "堇怜 (スミレ)",
          "ja": "それは……",
          "tc": "那是因為……",
          "sc": "那是因为……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7408,
      "rec_id": "TALK_ID_70_2100_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 412691,
          "spk": "木助 (キスケ)",
          "ja": "はっはっはァ～",
          "tc": "哈、哈、哈～",
          "sc": "哈、哈、哈～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 412698,
