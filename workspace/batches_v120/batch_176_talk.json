    {
      "file": "talk.dat",
      "rec_idx": 3945,
      "rec_id": "TALK_ID_10_0201_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222542,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222549,
          "spk": "林 (リン)",
          "ja": "私が何をしに来たかわかるでしょう？",
          "tc": "你應該知道我今天來做什麼的吧？",
          "sc": "你应该知道我今天来做什么的吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222560,
          "spk": "林 (リン)",
          "ja": "そう、あなたは不義理にも村の掟に背いて、",
          "tc": "沒錯，就是因為你背信忘義，破壞規矩，",
          "sc": "没错，就是因为你背信忘义，破坏规矩，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222567,
          "spk": "林 (リン)",
          "ja": "深夜に出歩くという危険行為を働いた",
          "tc": "做出深夜外出的危險行為。",
          "sc": "做出深夜外出的危险行为。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3946,
      "rec_id": "TALK_ID_10_0201_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222592,
          "spk": "林 (リン)",
          "ja": "……あなたも見たでしょう",
          "tc": "……你也看到了吧？",
          "sc": "……你也看到了吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222599,
          "spk": "林 (リン)",
          "ja": "この村の、夜の姿を",
          "tc": "看到這個村子夜晚的模樣。",
          "sc": "看到这个村子夜晚的模样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3947,
      "rec_id": "TALK_ID_10_0201_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222615,
          "spk": "林 (リン)",
          "ja": "なぜ、あんなことになっているか……",
          "tc": "你也很好奇吧？",
          "sc": "你也很好奇吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222622,
          "spk": "林 (リン)",
          "ja": "あなたも気になるでしょう？",
          "tc": "好奇為什麼會是那個樣子……",
          "sc": "好奇为什么会是那个样子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222633,
          "spk": "林 (リン)",
          "ja": "でもね、村の掟を守れないような",
          "tc": "但是呢，我不太可能和你這樣",
          "sc": "但是呢，我不太可能和你这样"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222640,
          "spk": "林 (リン)",
          "ja": "信頼できない村人に、",
          "tc": "無法遵守規矩、不值得信任的村民，",
          "sc": "无法遵守规矩、不值得信任的村民，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 222647,
          "spk": "林 (リン)",
          "ja": "秘密を共有することは難しいわ",
          "tc": "共享村子的祕密。",
          "sc": "共享村子的秘密。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 222658,
          "spk": "林 (リン)",
          "ja": "あなたが、私達の味方であることを",
          "tc": "我希望你能反省，接受懲罰……",
          "sc": "我希望你能反省，接受惩罚……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 222665,
          "spk": "林 (リン)",
          "ja": "証明するためにも、",
          "tc": "就當作是用來證明你真的是",
          "sc": "就当作是用来证明你真的是"
        },
        {
          "f_idx": 7,
          "pidx_tc": 222672,
          "spk": "林 (リン)",
          "ja": "反省して罰を受けてほしいの……",
          "tc": "我們的夥伴也好。",
          "sc": "我们的伙伴也好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 222681,
          "spk": "林 (リン)",
          "ja": "……はい、これ",
          "tc": "……來，這個給你。",
          "sc": "……来，这个给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3948,
      "rec_id": "TALK_ID_10_0201_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222705,
          "spk": "林 (リン)",
          "ja": "それはね、",
          "tc": "那東西啊，",
          "sc": "那东西啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222712,
          "spk": "林 (リン)",
          "ja": "反抗期も矯正させる",
          "tc": "是連叛逆期都能矯正過來的",
          "sc": "是连叛逆期都能矫正过来的"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222719,
          "spk": "林 (リン)",
          "ja": "恐怖の「お手伝い券」よ",
          "tc": "可怕的「幫忙券」。",
          "sc": "可怕的“帮忙券”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222730,
          "spk": "林 (リン)",
          "ja": "その券は、村の住人の前で使うの",
          "tc": "你對著村民使用它，",
          "sc": "你对着村民使用它，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 222737,
          "spk": "林 (リン)",
          "ja": "券を受け取った人は頼み事を言うわ",
          "tc": "收下券的人就會提出他們的委託。",
          "sc": "收下券的人就会提出他们的委托。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 222753,
          "spk": "林 (リン)",
          "ja": "そしてあなたは、",
          "tc": "然後你必須",
          "sc": "然后你必须"
        },
        {
          "f_idx": 7,
          "pidx_tc": 222760,
          "spk": "林 (リン)",
          "ja": "言われたお願い事を",
          "tc": "完成他們",
          "sc": "完成他们"
        },
        {
          "f_idx": 8,
          "pidx_tc": 222767,
          "spk": "林 (リン)",
          "ja": "必ずかなえてあげなくちゃいけないのよ",
          "tc": "提出的請求才行喔。",
          "sc": "提出的请求才行。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 222778,
          "spk": "林 (リン)",
          "ja": "どうかしら？",
          "tc": "你覺得怎麼樣？",
          "sc": "你觉得怎么样？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 222785,
          "spk": "林 (リン)",
          "ja": "<strong>掟の二、村のために協力せよ……</strong>",
          "tc": "<strong>規矩之二，要為村子盡一份力……</strong>",
          "sc": "<strong>规矩之二，要为村子尽一份力……</strong>"
        },
        {
          "f_idx": 11,
          "pidx_tc": 222792,
          "spk": "林 (リン)",
          "ja": "この約束を守る練習にもなるでしょう？",
          "tc": "這樣同時也算是遵守這條規矩的練習，對吧？",
          "sc": "这样同时也算是遵守这条规矩的练习，对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3949,
      "rec_id": "TALK_ID_10_0201_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222816,
          "spk": "林 (リン)",
          "ja": "……あら、あんまり嫌がらないのね？",
          "tc": "……哎呀，你好像不是很抗拒？",
