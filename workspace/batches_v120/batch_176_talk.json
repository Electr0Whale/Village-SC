        {
          "f_idx": 7,
          "pidx_tc": 223262,
          "spk": "林 (リン)",
          "ja": "必ず叶えてあげなくちゃいけないのよ",
          "tc": "說出的心願。",
          "sc": "说出的心愿。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 223273,
          "spk": "林 (リン)",
          "ja": "お手伝い券は本来、トバリが掟を破ったときに",
