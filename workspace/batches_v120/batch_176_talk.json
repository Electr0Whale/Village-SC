  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3926,
      "rec_id": "TALK_ID_10_0104_098_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221543,
          "spk": "六角 (ロッカク)",
          "ja": "おや、<player>さんじゃないっスか",
          "tc": "哦，這不是<player>嗎？",
          "sc": "哦，这不是<player>不？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221550,
          "spk": "六角 (ロッカク)",
          "ja": "こんにちは",
          "tc": "你好。",
          "sc": "你好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221557,
          "spk": "六角 (ロッカク)",
          "ja": "今日も元気いっぱい暇してそうっスね",
          "tc": "你今天看起來也很有活力又很閒的樣子呢。",
          "sc": "你今天看起来也很有活力又很闲的样子呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221568,
          "spk": "六角 (ロッカク)",
          "ja": "ワシは店の仕込みに掃除……",
          "tc": "我得忙餐廳備菜，還要打掃……",
          "sc": "我得忙餐厅备菜，还要打扫……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 221575,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんのお洋服のほつれを直して……",
          "tc": "又要縫補洋妹妹的衣服……",
          "sc": "又要缝补洋妹妹的衣服……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 221582,
          "spk": "六角 (ロッカク)",
          "ja": "それからお家の家事をして……",
          "tc": "接著要做家裡的家事……",
          "sc": "接着要做家里的家事……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 221593,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんは時間がありそうで",
          "tc": "<player>看起來這麼閒，",
          "sc": "<player>看起来这么闲，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 221600,
          "spk": "六角 (ロッカク)",
          "ja": "全くうらやましい限りっス",
          "tc": "實在太讓我羨慕了。",
          "sc": "实在太让我羡慕呐。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 221611,
          "spk": "六角 (ロッカク)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 221618,
          "spk": "六角 (ロッカク)",
          "ja": "その上、店で出す料理に使う",
          "tc": "而且現在，店裡備菜要用的食材中，",
          "sc": "而且现在，店里备菜要用的食材中，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 221625,
          "spk": "六角 (ロッカク)",
          "ja": "<strong>ヨシノボリが２匹</strong>足りてねぇ……",
          "tc": "還少了<strong>2條吻鰕虎魚</strong>……",
          "sc": "还少了<strong>2条吻虾虎鱼</strong>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3927,
      "rec_id": "TALK_ID_10_0104_098_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221643,
          "spk": "六角 (ロッカク)",
          "ja": "だからこうして掲示板に",
          "tc": "所以我才來到公告欄",
          "sc": "所以我才来到公告栏"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221650,
          "spk": "六角 (ロッカク)",
          "ja": "<strong>頼み事</strong>を書いた紙を貼って",
          "tc": "貼上寫了<strong>委託</strong>的紙，",
          "sc": "贴上写了<strong>委托</strong>的纸，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221657,
          "spk": "六角 (ロッカク)",
          "ja": "誰かが頼みを聞いてくれるのを待とうかと……",
          "tc": "等著看有沒有人願意幫忙……",
          "sc": "等着看有没有人愿意帮忙……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221668,
          "spk": "六角 (ロッカク)",
          "ja": "……あ！",
          "tc": "……啊！",
          "sc": "……啊！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 221675,
          "spk": "六角 (ロッカク)",
          "ja": "そうだ！",
          "tc": "對了！",
          "sc": "对了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3928,
      "rec_id": "TALK_ID_10_0104_098_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221693,
          "spk": "六角 (ロッカク)",
          "ja": "暇そうな<player>さんに",
          "tc": "既然<player>看起來這麼閒，",
          "sc": "既然<player>看起来这么闲，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221700,
          "spk": "六角 (ロッカク)",
          "ja": "手伝ってもらえばいいのか！",
          "tc": "就請你來幫忙吧！",
          "sc": "就请你来帮忙吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3929,
      "rec_id": "TALK_ID_10_0104_098_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221716,
          "spk": "六角 (ロッカク)",
          "ja": "頼みを聞いてくれたら、",
          "tc": "只要你願意幫忙，",
          "sc": "只要你愿意帮忙，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221723,
          "spk": "六角 (ロッカク)",
          "ja": "ちゃんとお礼も払うっスから！",
          "tc": "我也會付出報酬的！",
          "sc": "我也会付出报酬的！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221734,
          "spk": "六角 (ロッカク)",
          "ja": "ね、<player>さん",
          "tc": "<player>，怎麼樣？",
          "sc": "<player>，怎么样？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221741,
          "spk": "六角 (ロッカク)",
          "ja": "もちろんワシのお手伝い、",
          "tc": "你應該願意",
          "sc": "你应该愿意"
        },
        {
          "f_idx": 4,
          "pidx_tc": 221748,
          "spk": "六角 (ロッカク)",
          "ja": "やってくれるっスよね！",
          "tc": "幫我這個忙吧！",
          "sc": "帮我这个忙哟！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 221757,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 221764,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3930,
      "rec_id": "TALK_ID_10_0104_098_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221832,
          "spk": "六角 (ロッカク)",
          "ja": "今ならついでに",
          "tc": "現在的話，還可以順便",
          "sc": "现在的话，还可以顺便"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221839,
          "spk": "六角 (ロッカク)",
          "ja": "頼み事の引き受け方も",
          "tc": "把接受委託的方式",
          "sc": "把接受委托的方式"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221846,
          "spk": "六角 (ロッカク)",
          "ja": "教えてあげちゃうっス",
          "tc": "一起教給你喔。",
          "sc": "一起教给你呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221855,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、こちらへ",
          "tc": "往這邊走。",
          "sc": "往这边走。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3931,
      "rec_id": "TALK_ID_10_0104_098_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221879,
          "spk": "六角 (ロッカク)",
          "ja": "<strong>頼み事は掲示板の右側に貼ってある</strong>っス",
          "tc": "<strong>委託貼在公告欄的右邊</strong>，",
          "sc": "<strong>委托贴在公告栏的右边</strong>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221886,
          "spk": "六角 (ロッカク)",
          "ja": "左側は掟が書かれた貼り紙っスから、",
          "tc": "左邊則是寫著規矩的告示，",
          "sc": "左边则是写着规矩的告示，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221893,
          "spk": "六角 (ロッカク)",
          "ja": "ちゃんと右の紙を見るんスよ",
          "tc": "要好好看清楚右邊的紙喔。",
          "sc": "要好好看清楚右边的纸呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221904,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、さっそくワシが貼った",
          "tc": "那麼請你立刻看看",
          "sc": "那么请你立刻看看"
        },
        {
          "f_idx": 4,
          "pidx_tc": 221911,
          "spk": "六角 (ロッカク)",
          "ja": "頼み事を見てほしいっス",
          "tc": "我貼上去的委託。",
          "sc": "我贴上去的委托呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3932,
      "rec_id": "TALK_ID_10_0104_098_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221935,
          "spk": "六角 (ロッカク)",
          "ja": "今貼られているのは",
          "tc": "現在貼在上面的",
          "sc": "现在贴在上面的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221942,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの依頼だけっスね",
          "tc": "只有我的委託。",
          "sc": "只有我的委托呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221953,
          "spk": "六角 (ロッカク)",
          "ja": "それじゃあ、ワシの依頼を選んで",
          "tc": "然後，你選擇我的委託，",
          "sc": "然后，你选择我的委托，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 221960,
          "spk": "六角 (ロッカク)",
          "ja": "ハンコを押してみてほしいっス",
          "tc": "蓋個章上去吧。",
          "sc": "盖个章上去呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 221971,
          "spk": "六角 (ロッカク)",
          "ja": "あ、指印で大丈夫っス",
          "tc": "啊，捺指印就可以了。",
          "sc": "啊，捺指印就可以呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 221978,
          "spk": "六角 (ロッカク)",
          "ja": "朱肉はこちらに……",
          "tc": "印泥在這裡……",
          "sc": "印泥在这里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3933,
      "rec_id": "TALK_ID_10_0104_098_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222002,
          "spk": "六角 (ロッカク)",
          "ja": "はい、これで依頼を",
          "tc": "好，這樣就算是",
          "sc": "好，这样就算是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222009,
          "spk": "六角 (ロッカク)",
          "ja": "受けることが出来たっスよ！",
          "tc": "接下委託了！",
          "sc": "接下委托哟！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222016,
          "spk": "六角 (ロッカク)",
          "ja": "いや～！　助かるっスねぇ～！",
          "tc": "哎呀～！真是幫了我大忙呀～！",
          "sc": "哎呀～！真是帮了我大忙呀～呐！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3934,
      "rec_id": "TALK_ID_10_0104_098_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222040,
          "spk": "六角 (ロッカク)",
          "ja": "大丈夫",
          "tc": "別擔心，",
          "sc": "别担心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222047,
          "spk": "六角 (ロッカク)",
          "ja": "ワシも一緒に釣るから、",
          "tc": "我也會跟著一起釣的，",
          "sc": "我也会跟着一起钓的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222054,
          "spk": "六角 (ロッカク)",
          "ja": "きっとすぐ済むっスよ",
          "tc": "一定很快就能搞定。",
          "sc": "一定很快就能搞定哟。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3935,
      "rec_id": "TALK_ID_10_0104_098_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222078,
          "spk": "六角 (ロッカク)",
          "ja": "じゃあ早速、釣りに行くっス！",
          "tc": "那我們馬上出發去釣魚吧！",
          "sc": "那我们马上出发去钓鱼吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222085,
          "spk": "六角 (ロッカク)",
          "ja": "ワシに着いてきてください",
          "tc": "跟我來。",
          "sc": "跟我来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3936,
      "rec_id": "TALK_ID_10_0104_098_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222109,
          "spk": "六角 (ロッカク)",
          "ja": "見えますかね？",
          "tc": "看到了嗎？",
          "sc": "看到了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222116,
          "spk": "六角 (ロッカク)",
          "ja": "あの川岸でやってみましょう",
          "tc": "我們去那個岸邊試試看吧。",
          "sc": "我们去那个岸边试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3937,
      "rec_id": "TALK_ID_10_0104_098_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222140,
          "spk": "六角 (ロッカク)",
          "ja": "うーん……ダメっスね……",
          "tc": "嗯……沒什麼成果呢……",
          "sc": "嗯……没什么成果呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222147,
          "spk": "六角 (ロッカク)",
          "ja": "ちっともかかりやしねぇ……",
          "tc": "完全沒有咬餌……",
          "sc": "完全没有咬饵……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222154,
          "spk": "六角 (ロッカク)",
          "ja": "今日は日が悪ぃのかもしれねっス",
          "tc": "或許今天運氣不怎麼好。",
          "sc": "或许今天运气不怎么好呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3938,
      "rec_id": "TALK_ID_10_0104_098_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222178,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんも",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222185,
          "spk": "六角 (ロッカク)",
          "ja": "疲れちまったようですし",
          "tc": "你看起來也累了，",
          "sc": "你看起来也累了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222192,
          "spk": "六角 (ロッカク)",
          "ja": "もう引き上げるとしますか……",
          "tc": "我們就先到此為止吧……",
          "sc": "我们就先到此为止吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3939,
      "rec_id": "TALK_ID_10_0104_098_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222216,
          "spk": "六角 (ロッカク)",
          "ja": "釣れなかったっスけど、",
          "tc": "雖然沒有釣到魚，",
          "sc": "虽然没有钓到鱼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222223,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの店のメシをタダで振る舞いますから",
          "tc": "不過我就免費招待你吃店裡的餐點吧。",
          "sc": "不过我就免费招待你吃店里的餐点吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222232,
          "spk": "六角 (ロッカク)",
          "ja": "それで、お礼代わりってことに",
          "tc": "就用那個",
          "sc": "就用那个"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222239,
          "spk": "六角 (ロッカク)",
          "ja": "してくださいな",
          "tc": "作為給你的謝禮啦。",
          "sc": "作为给你的谢礼啦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 222250,
          "spk": "六角 (ロッカク)",
          "ja": "ヨシノボリは……",
          "tc": "至於吻鰕虎魚……",
          "sc": "至于吻虾虎鱼……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 222257,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、期日までに",
          "tc": "只要能在期限之前",
          "sc": "只要能在期限之前"
        },
        {
          "f_idx": 6,
          "pidx_tc": 222264,
          "spk": "六角 (ロッカク)",
          "ja": "釣っておいて貰えりゃいいんで",
          "tc": "幫我釣到就行了。",
          "sc": "帮我钓到就行了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 222275,
          "spk": "六角 (ロッカク)",
          "ja": "じゃ、店まで着いて来てほしいっス",
          "tc": "總之跟我一起到餐廳吧。",
          "sc": "总之跟我一起到餐厅呐。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 222282,
          "spk": "六角 (ロッカク)",
          "ja": "ヨシノボリ料理以外なら",
          "tc": "除了吻鰕虎魚料理之外，",
          "sc": "除了吻虾虎鱼料理之外，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 222289,
          "spk": "六角 (ロッカク)",
          "ja": "何でも振る舞うっスからね",
          "tc": "你想吃什麼都可以。",
          "sc": "你想吃什么都可以。"
        }
      ]
    },
