        {
          "f_idx": 7,
          "pidx_tc": 223181,
          "spk": "林 (リン)",
          "ja": "遠慮なく受け取ってちょうだい",
          "tc": "別客氣，收下吧。",
          "sc": "别客气，收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
