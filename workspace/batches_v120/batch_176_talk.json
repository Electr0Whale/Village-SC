          "sc": "我希望你能反省，接受惩罚……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223156,
          "spk": "林 (リン)",
          "ja": "証明するためにも、",
          "tc": "就當作是用來證明你真的是",
          "sc": "就当作是用来证明你真的是"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223163,
          "spk": "林 (リン)",
          "ja": "やり遂げてほしいのよ",
          "tc": "請你務必完成這件事。",
          "sc": "请你务必完成这件事。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 223174,
          "spk": "林 (リン)",
          "ja": "はい、どうぞ",
          "tc": "來，這個給你，",
          "sc": "来，这个给你，"
