        },
        {
          "f_idx": 3,
          "pidx_tc": 222481,
          "spk": "六角 (ロッカク)",
          "ja": "手に入ったらワシの所まで",
          "tc": "釣到之後，",
          "sc": "钓到之后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 222488,
          "spk": "六角 (ロッカク)",
          "ja": "持ってきてほしいっス",
          "tc": "到我這裡交給我就可以了。",
          "sc": "到我这里交给我就可以呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 222495,
          "spk": "六角 (ロッカク)",
          "ja": "その時にまた、お礼もしますからね",
          "tc": "到時候還會再回禮給你的。",
          "sc": "到时候还会再回礼给你的。"
        }
      ]
    },
