        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3950,
      "rec_id": "TALK_ID_10_0201_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222834,
          "spk": "林 (リン)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222841,
          "spk": "林 (リン)",
          "ja": "トバリはこれが一番嫌がるのに……",
          "tc": "帷她可是最討厭這個處罰了……",
          "sc": "帷她可是最讨厌这个处罚了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222850,
          "spk": "林 (リン)",
          "ja": "まあ、サボらずにやってくれれば",
          "tc": "總之，只要你不偷懶好好完成，",
          "sc": "总之，只要你不偷懒好好完成，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222857,
          "spk": "林 (リン)",
          "ja": "それでいいのだけれど……",
          "tc": "那也就夠了……",
          "sc": "那也就够了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3951,
      "rec_id": "TALK_ID_10_0201_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222875,
          "spk": "林 (リン)",
          "ja": "もし、終わらせるのが遅れたら、",
          "tc": "但要是你太晚完成了，",
          "sc": "但要是你太晚完成了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222882,
          "spk": "林 (リン)",
          "ja": "私はショックで、あなたへ渡す給料を",
          "tc": "我可能會因為內心大受打擊，",
          "sc": "我可能会因为内心大受打击，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222889,
          "spk": "林 (リン)",
          "ja": "半額にしてしまうかもしれないわね……",
          "tc": "把要給你的薪水砍半呢……",
          "sc": "把要给你的薪水砍半呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3952,
      "rec_id": "TALK_ID_10_0201_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222907,
          "spk": "林 (リン)",
          "ja": "大丈夫！　怖がらなくていいわ！",
          "tc": "別擔心！不用害怕！",
          "sc": "别担心！不用害怕！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 222914,
          "spk": "林 (リン)",
          "ja": "真面目にやっていれば、",
          "tc": "只要老老實實去做，",
          "sc": "只要老老实实去做，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 222921,
          "spk": "林 (リン)",
          "ja": "きっとそんなに時間はかからないわよ！",
          "tc": "一定不會花上太多時間的！",
          "sc": "一定不会花上太多时间的！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 222930,
          "spk": "林 (リン)",
          "ja": "あなたが、全ての依頼を終える頃には",
          "tc": "我相信等你完成所有委託，",
          "sc": "我相信等你完成所有委托，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 222937,
          "spk": "林 (リン)",
          "ja": "掟にも従順になっていてくれると",
          "tc": "也會變得",
          "sc": "也会变得"
        },
        {
          "f_idx": 5,
          "pidx_tc": 222944,
          "spk": "林 (リン)",
          "ja": "信じているわ",
          "tc": "願意遵守規矩了。",
          "sc": "愿意遵守规矩了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 222955,
          "spk": "林 (リン)",
          "ja": "さあ、さっそくだけれど、",
          "tc": "好，那就事不宜遲，",
          "sc": "好，那就事不宜迟，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 222962,
          "spk": "林 (リン)",
          "ja": "全ての「券」を使い切れるように",
          "tc": "馬上去巡迴村子用掉所有的「券」，",
          "sc": "马上去巡回村子用掉所有的“券”，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 222969,
          "spk": "林 (リン)",
          "ja": "駆けずり回って、願い事を聞いてきなさい",
          "tc": "聽聽大家的願望吧。",
          "sc": "听听大家的愿望吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3953,
      "rec_id": "TALK_ID_10_0201_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 222993,
          "spk": "林 (リン)",
          "ja": "<strong>その券を持って住人の側で「渡す」と、",
          "tc": "<strong>拿著券站在居民身邊，",
          "sc": "<strong>拿着券站在居民身边，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223000,
          "spk": "林 (リン)",
          "ja": "きっとみんな受け取ってくれるわ</strong>",
