      "rec_id": "TALK_ID_10_0201_001_51",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223056,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223063,
          "spk": "林 (リン)",
          "ja": "そろそろこの村での暮らしに、",
