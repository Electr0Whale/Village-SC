          "pidx_tc": 223312,
          "spk": "林 (リン)",
          "ja": "あなたにもやってもらおうと思ってね！",
          "tc": "來讓大家信任你！",
          "sc": "来让大家信任你！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 223323,
          "spk": "林 (リン)",
          "ja": "どうかしら？",
          "tc": "你覺得怎麼樣？",
          "sc": "你觉得怎么样？"
