    },
    {
      "file": "talk.dat",
      "rec_idx": 3955,
      "rec_id": "TALK_ID_10_0201_001_52",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223088,
          "spk": "林 (リン)",
          "ja": "毎日忙しく働いていて、偉いとは思うけれど……",
          "tc": "每天辛勤工作是很了不起，不過……",
          "sc": "每天辛勤工作是很了不起，不过……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223095,
          "spk": "林 (リン)",
          "ja": "でもね、本当の村の一員になるには、",
          "tc": "要成為村子真正的一員，",
          "sc": "要成为村子真正的一员，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223102,
          "spk": "林 (リン)",
          "ja": "欠かせないことがあるの",
          "tc": "還有件事是不可或缺的。",
          "sc": "还有件事是不可或缺的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3956,
      "rec_id": "TALK_ID_10_0201_001_53",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223120,
          "spk": "林 (リン)",
          "ja": "それは、ご近所さんとの交流よ！",
          "tc": "那就是和鄰居交流！",
          "sc": "那就是和邻居交流！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223131,
          "spk": "林 (リン)",
          "ja": "あなたには、",
          "tc": "我希望你能夠",
          "sc": "我希望你能够"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223138,
          "spk": "林 (リン)",
          "ja": "村のみんなともっと仲良くなって欲しいの",
          "tc": "跟村子裡的大家更加打好關係。",
          "sc": "跟村子里的大家更加打好关系。"
