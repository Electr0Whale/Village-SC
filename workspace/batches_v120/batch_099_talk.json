    },
    {
      "file": "talk.dat",
      "rec_idx": 276,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1733,
          "spk": "木助 (キスケ)",
          "ja": "花の良し悪しなんざ",
          "tc": "我是不太懂",
          "sc": "我是不太懂"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1740,
          "spk": "木助 (キスケ)",
          "ja": "俺にはイマイチわからんが……",
          "tc": "花的好壞啦……",
          "sc": "花的好坏啦……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 1751,
          "spk": "木助 (キスケ)",
          "ja": "美味い飯と美味い酒があるなら",
          "tc": "但如果有美味的飯菜跟美酒，",
          "sc": "但如果有美味的饭菜跟美酒，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1758,
          "spk": "木助 (キスケ)",
          "ja": "花見は大歓迎だ",
          "tc": "要賞花我可是很歡迎的。",
          "sc": "要赏花我可是很欢迎的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 1776,
          "spk": "木助 (キスケ)",
          "ja": "ほら、てめぇも遠慮すんな",
          "tc": "來，你也別客氣，",
          "sc": "来，你也别客气，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 1783,
          "spk": "木助 (キスケ)",
          "ja": "好きなだけ食っていいぜ",
          "tc": "盡量多吃點吧。",
          "sc": "尽量多吃点吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 1799,
          "spk": "木助 (キスケ)",
          "ja": "こういう時は楽しまねぇと",
          "tc": "這種時候就應該盡情享樂，",
          "sc": "这种时候就应该尽情享乐，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 1806,
          "spk": "木助 (キスケ)",
          "ja": "人生損だからな",
          "tc": "不然人生可是會吃虧的。",
          "sc": "不然人生可是会吃亏的。"
        }
      ]
    },
    {
