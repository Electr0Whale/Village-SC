      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1237,
          "spk": "木助 (キスケ)",
          "ja": "そうか、じゃあ午後６時に俺の家に来てくれ",
          "tc": "這樣啊，那你就晚上6點到我家來吧。",
