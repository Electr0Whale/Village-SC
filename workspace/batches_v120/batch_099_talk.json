  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 241,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_4230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21318,
          "spk": "帷 (トバリ)",
          "ja": "暇……こうしてリンの置物を",
          "tc": "好閒啊……",
          "sc": "好闲啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21325,
          "spk": "帷 (トバリ)",
          "ja": "ぼーっと眺めてるなんて、たぶん今",
          "tc": "像這樣看著林的擺飾發呆，",
          "sc": "像这样看着林的摆饰发呆，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21332,
          "spk": "帷 (トバリ)",
          "ja": "私が世界で一番無駄な時間を過ごしてる",
          "tc": "此時此刻的我應該是全世界最浪費時間的人了吧。",
          "sc": "此时此刻的我应该是全世界最浪费时间的人了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 242,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_4231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21356,
          "spk": "帷 (トバリ)",
          "ja": "リンとの共同生活は、",
          "tc": "我跟林應該會",
          "sc": "我跟林应该会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21363,
          "spk": "帷 (トバリ)",
          "ja": "もうしばらくは続きそうね……",
          "tc": "再繼續共同生活一段時間……",
          "sc": "再继续共同生活一段时间……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21374,
          "spk": "帷 (トバリ)",
          "ja": "でも、どうせ一緒に暮らすなら、",
          "tc": "反正都一起住了，",
          "sc": "反正都一起住了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21381,
          "spk": "帷 (トバリ)",
          "ja": "もっといい関係で……",
          "tc": "希望我們感情能更好一點……",
          "sc": "希望我们感情能更好一点……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 21392,
          "spk": "帷 (トバリ)",
          "ja": "ま、それはリンが頭下げてきたらの話ね",
          "tc": "不過這也要林先向我低頭才行。",
          "sc": "不过这也要林先向我低头才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 243,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_4232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21423,
          "spk": "帷 (トバリ)",
          "ja": "今度、<player>が遊びに来た時",
          "tc": "下次<player>來玩的時候，",
          "sc": "下次<player>来玩的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21430,
          "spk": "帷 (トバリ)",
          "ja": "どんな料理でもてなしてほしい？",
          "tc": "你想要我要用什麼料理來招待你呢？",
          "sc": "你想要我要用什么料理来招待你呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21441,
          "spk": "帷 (トバリ)",
          "ja": "デザートはやっぱり、おしるこがいいかな",
          "tc": "甜點果然還是紅豆麻糬湯比較好吧？",
          "sc": "甜点果然还是红豆年糕汤比较好吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 244,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21472,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……また今日も、朝から雪……",
          "tc": "唉……今天也是從早就在下雪……",
          "sc": "唉……今天也是从早就在下雪……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21479,
          "spk": "帷 (トバリ)",
          "ja": "歩きにくいし寒くて震えるし、ウンザリ……",
          "tc": "不但很難行走，又讓人冷到發抖，煩死了……",
          "sc": "不但很难行走，又让人冷到发抖，烦死了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21486,
          "spk": "帷 (トバリ)",
          "ja": "今日はもう家に帰りたいな……",
          "tc": "我今天已經想回家了……",
          "sc": "我今天已经想回家了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 245,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21510,
          "spk": "帷 (トバリ)",
          "ja": "火のよーじん、火のよーじーん……",
          "tc": "天乾物燥、小心火燭……",
          "sc": "天干物燥、小心火烛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21528,
          "spk": "帷 (トバリ)",
          "ja": "リンからやれって言われたけど……バカバカしい",
          "tc": "這是林要我喊的……真的好蠢。",
          "sc": "这是林要我喊的……真的好蠢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21535,
          "spk": "帷 (トバリ)",
          "ja": "こんなのやるくらいなら、",
          "tc": "與其在這邊喊，",
          "sc": "与其在这边喊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 21542,
          "spk": "帷 (トバリ)",
          "ja": "もっと効果的な火事の対策があるでしょ",
          "tc": "應該有更有效率的防火方法吧。",
          "sc": "应该有更有效率的防火方法吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 21553,
          "spk": "帷 (トバリ)",
          "ja": "<player>、代わりにやっておいて",
          "tc": "<player>，你替我喊吧。",
          "sc": "<player>，你替我喊吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 246,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21577,
          "spk": "帷 (トバリ)",
          "ja": "一面真っ白な雪景色……",
          "tc": "是一整片全白的雪景啊……",
          "sc": "是一整片全白的雪景啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21584,
          "spk": "帷 (トバリ)",
          "ja": "何もかも雪で埋まってるから",
          "tc": "如果所有東西都積雪了，",
          "sc": "如果所有东西都积雪了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21591,
          "spk": "帷 (トバリ)",
          "ja": "通い慣れた道も迷いそう……",
          "tc": "那在平常走慣的路上也可能會迷路呢……",
          "sc": "那在平常走惯的路上也可能会迷路呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 247,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21615,
          "spk": "帷 (トバリ)",
          "ja": "暑すぎる夏も寒すぎる冬も、もうたくさん……",
          "tc": "我已經受夠過熱的夏天和過冷的冬天了……",
          "sc": "我已经受够过热的夏天和过冷的冬天了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21622,
          "spk": "帷 (トバリ)",
          "ja": "季節なんて春と秋だけでいいのに",
          "tc": "這世界只要有春天和秋天兩個季節就夠了。",
          "sc": "这世界只要有春天和秋天两个季节就够了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 248,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21653,
          "spk": "帷 (トバリ)",
          "ja": "ここに来たばかりの頃は、",
          "tc": "剛來到這裡的時候，",
          "sc": "刚来到这里的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21660,
          "spk": "帷 (トバリ)",
          "ja": "雪が積もれば少しは退屈も紛れるかなって",
          "tc": "我還曾經想過，",
          "sc": "我还曾经想过，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21667,
          "spk": "帷 (トバリ)",
          "ja": "思ってたんだけど……",
          "tc": "雪積起來後，應該能多少排解我無聊的心情吧……",
          "sc": "雪积起来后，应该能多少排解我无聊的心情吧……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21678,
          "spk": "帷 (トバリ)",
          "ja": "楽しいってより、",
          "tc": "但是比起開心的心情，",
          "sc": "但是比起开心的心情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 21685,
          "spk": "帷 (トバリ)",
          "ja": "面倒って気持ちが勝つかもね……",
          "tc": "我感覺到更多的是麻煩……",
          "sc": "我感觉到更多的是麻烦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 249,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21709,
          "spk": "帷 (トバリ)",
          "ja": "……<player>、急に声かけるから",
          "tc": "……<player>，都是因為你突然叫住我，",
          "sc": "……<player>，都是因为你突然叫住我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21716,
          "spk": "帷 (トバリ)",
          "ja": "転びそうになったじゃない",
          "tc": "害我差點跌倒。",
          "sc": "害我差点跌倒。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21723,
          "spk": "帷 (トバリ)",
          "ja": "今度から声かける時は、事前にアピールして",
          "tc": "下次要叫我之前記得要先讓我知道。",
          "sc": "下次要叫我之前记得要先让我知道。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 250,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21747,
          "spk": "帷 (トバリ)",
          "ja": "寒いのはもう勘弁してほしいけど",
          "tc": "真希望天氣不要再這麼冷了。",
          "sc": "真希望天气不要再这么冷了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21758,
          "spk": "帷 (トバリ)",
          "ja": "気味の悪い虫が湧いてこないのは",
          "tc": "雖然不會有噁心的昆蟲",
          "sc": "虽然不会有恶心的昆虫"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21765,
          "spk": "帷 (トバリ)",
          "ja": "冬の唯一マシなところね……",
          "tc": "是冬天唯一的優點……",
          "sc": "是冬天唯一的优点……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 251,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21789,
          "spk": "帷 (トバリ)",
          "ja": "寒い、寒い……",
          "tc": "好冷啊……",
          "sc": "好冷啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21800,
          "spk": "帷 (トバリ)",
          "ja": "何でもいいから身体を動かしてないと",
          "tc": "不管做什麼都可以，總之要先讓身體動起來才行，",
          "sc": "不管做什么都可以，总之要先让身体动起来才行，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21807,
          "spk": "帷 (トバリ)",
          "ja": "凍えて歩けなくなる……",
          "tc": "不然會冷到走不動啊……",
          "sc": "不然会冷到走不动啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 252,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21831,
          "spk": "帷 (トバリ)",
          "ja": "<player>、この雪平気なの？",
          "tc": "<player>，雪這麼大，你都沒事嗎？",
          "sc": "<player>，雪这么大，你都没事吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21842,
          "spk": "帷 (トバリ)",
          "ja": "私はもう駄目そう……",
          "tc": "我已經不行了……",
          "sc": "我已经不行了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21849,
          "spk": "帷 (トバリ)",
          "ja": "ますます寒くなって、ほんと無理",
          "tc": "天氣越來越冷，我受不了了。",
          "sc": "天气越来越冷，我受不了了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21856,
          "spk": "帷 (トバリ)",
          "ja": "早く帰ってお風呂に入りたい……",
          "tc": "我想趕快回家泡澡……",
          "sc": "我想赶快回家泡澡……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 253,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21880,
          "spk": "帷 (トバリ)",
          "ja": "急いで帰ってたからなのか知らないけど",
          "tc": "剛剛林摔了一個大跤，",
          "sc": "刚刚林摔了一个大跤，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21887,
          "spk": "帷 (トバリ)",
          "ja": "さっき、リンが盛大に転んでたの",
          "tc": "不知道是不是因為她趕著要回家。",
          "sc": "不知道是不是因为她赶着要回家。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21905,
          "spk": "帷 (トバリ)",
          "ja": "あれで結構抜けてるところがあるから……",
          "tc": "其實她還滿少根筋的……",
          "sc": "其实她还满少根筋的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 254,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21929,
          "spk": "帷 (トバリ)",
          "ja": "私の部屋は母屋と離れているから、",
          "tc": "我的房間離主屋有一段距離，",
          "sc": "我的房间离主屋有一段距离，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21936,
          "spk": "帷 (トバリ)",
          "ja": "リンに干渉されなくて良いんだけど",
          "tc": "所以不用怕會被林干擾，",
          "sc": "所以不用怕会被林干扰，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 21943,
          "spk": "帷 (トバリ)",
          "ja": "帰っても部屋が暗くて寒いのは少しツラいわ……",
          "tc": "但即使回去，房間又黑又冷的好難受……",
          "sc": "但即使回去，房间又黑又冷的好难受……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 21954,
          "spk": "帷 (トバリ)",
          "ja": "冬の間くらいは、",
          "tc": "在冬天的時候，",
          "sc": "在冬天的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 21961,
          "spk": "帷 (トバリ)",
          "ja": "私も母屋で暮らすのもアリかもね……",
          "tc": "也許可以考慮住在主屋……",
          "sc": "也许可以考虑住在主屋……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 21968,
          "spk": "帷 (トバリ)",
          "ja": "……でも、リンの小言をどこまで我慢できるかな",
          "tc": "……可是我有辦法忍受林的碎念多久呢。",
          "sc": "……可是我有办法忍受林的碎念多久呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 255,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 21992,
          "spk": "帷 (トバリ)",
          "ja": "村に明かりが少ないから",
          "tc": "村裡的照明很少，",
          "sc": "村里的照明很少，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 21999,
          "spk": "帷 (トバリ)",
          "ja": "夜になると真っ暗ね……",
          "tc": "所以入夜後會全部暗下來……",
          "sc": "所以入夜后会全部暗下来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22006,
          "spk": "帷 (トバリ)",
          "ja": "冬は特にそう感じる……",
          "tc": "冬天尤其令人有這種感覺……",
          "sc": "冬天尤其令人有这种感觉……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22017,
          "spk": "帷 (トバリ)",
          "ja": "少し先も、全然見えなくなるから、",
          "tc": "連稍微前面一點的路也都完全看不到，",
          "sc": "连稍微前面一点的路也都完全看不到，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22024,
          "spk": "帷 (トバリ)",
          "ja": "アンタは注意して帰りなさい",
          "tc": "你回家的路上要小心。",
          "sc": "你回家的路上要小心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 256,
      "rec_id": "TALK_ID_CARPENTER_SPECIAL_20_102_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 329,
          "spk": "木助 (キスケ)",
          "ja": "よお……",
          "tc": "嗨……",
          "sc": "嗨……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336,
          "spk": "木助 (キスケ)",
          "ja": "そろそろ暮らしには慣れたのかよ",
          "tc": "你差不多習慣這裡的生活了吧。",
          "sc": "你差不多习惯这里的生活了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354,
          "spk": "木助 (キスケ)",
          "ja": "色々と事情があるんだろうが……",
          "tc": "雖然我想你應該也有你的隱情……",
          "sc": "虽然我想你应该也有你的隐情……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 361,
          "spk": "木助 (キスケ)",
          "ja": "俺からはとやかく言わねぇ",
          "tc": "但我不會管太多啦。",
