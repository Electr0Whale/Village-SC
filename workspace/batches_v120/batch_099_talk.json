        {
          "f_idx": 5,
          "pidx_tc": 1586,
          "spk": "木助 (キスケ)",
          "ja": "結局いちばん身につくもんだ",
          "tc": "最能轉化為你自己的力量。",
          "sc": "最能转化为你自己的力量。"
        }
      ]
    },
    {
