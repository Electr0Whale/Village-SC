      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1547,
          "spk": "木助 (キスケ)",
          "ja": "俺は品評会には出ねぇけどさ、",
          "tc": "雖然我不會參加評鑑會，",
          "sc": "虽然我不会参加评鉴会，"
        },
