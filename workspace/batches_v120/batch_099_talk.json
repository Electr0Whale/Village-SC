          "f_idx": 1,
          "pidx_tc": 1554,
          "spk": "木助 (キスケ)",
          "ja": "ああいう場で自分の腕試しするのは、",
          "tc": "但我認為那是個不錯的機會，",
          "sc": "但我认为那是个不错的机会，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 1561,
          "spk": "木助 (キスケ)",
          "ja": "悪くない機会だと思うぞ",
          "tc": "你可以在那裡評斷自己的能力。",
          "sc": "你可以在那里评断自己的能力。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1572,
          "spk": "木助 (キスケ)",
          "ja": "人に見られて初めてわかることもあるしな",
          "tc": "有些事情要讓人評價以後才會知道，",
          "sc": "有些事情要让人评价以后才会知道，"
