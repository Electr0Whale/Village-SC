          "pidx_tc": 117242,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はずっと腹が鳴ってる",
          "tc": "但是今天我肚子一直叫個不停，",
          "sc": "但是今天我肚子一直叫个不停，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 117249,
          "spk": "四郎治 (シロージ)",
          "ja": "つまみ食いしないように気をつけないとな",
          "tc": "我可要小心不要嘴饞偷吃了。",
          "sc": "我可要小心不要嘴馋偷吃了。"
        }
      ]
    },
