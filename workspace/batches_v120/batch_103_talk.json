    {
      "file": "talk.dat",
      "rec_idx": 484,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115823,
          "spk": "四郎治 (シロージ)",
          "ja": "そうか",
          "tc": "這樣啊，",
          "sc": "这样啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115830,
          "spk": "四郎治 (シロージ)",
          "ja": "わざわざすまなかったな",
          "tc": "抱歉讓你費心了，",
          "sc": "抱歉让你费心了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115837,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがとうよ",
          "tc": "謝了。",
          "sc": "谢了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115848,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ対価をやらないとな",
          "tc": "那我也得給你酬勞了，",
          "sc": "那我也得给你酬劳了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 115855,
          "spk": "四郎治 (シロージ)",
          "ja": "ほら",
          "tc": "這給你。",
          "sc": "这给你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 115866,
          "spk": "四郎治 (シロージ)",
          "ja": "それじゃ、またなんかあったら頼む",
          "tc": "以後我遇到問題會再靠你的，",
          "sc": "以后我遇到问题会再靠你的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 115873,
          "spk": "四郎治 (シロージ)",
          "ja": "よろしくな",
          "tc": "就拜託你了。",
          "sc": "就拜托你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 485,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115895,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……すまん",
          "tc": "嗯……抱歉，",
          "sc": "嗯……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115902,
          "spk": "四郎治 (シロージ)",
          "ja": "違っていたか",
          "tc": "我搞錯了。",
          "sc": "我搞错了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115913,
          "spk": "四郎治 (シロージ)",
          "ja": "それは<player>に必要なモノなんだな",
          "tc": "那是<player>你自己需要的東西吧，",
          "sc": "那是<player>你自己需要的东西吧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115920,
          "spk": "四郎治 (シロージ)",
          "ja": "だったら大事にしてくれ",
          "tc": "既然如此，要好好珍惜喔。",
          "sc": "既然如此，就好好珍惜吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 486,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115944,
          "spk": "四郎治 (シロージ)",
          "ja": "よう、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115951,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと飯は食ってんのか？",
          "tc": "你有在好好吃飯嗎？",
          "sc": "你有在好好吃饭吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115962,
          "spk": "四郎治 (シロージ)",
          "ja": "いつも同じもん食って飽きてんなら、",
          "tc": "如果你每次都吃一樣的吃到膩了，",
          "sc": "如果你每次都吃一样的吃到腻了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115969,
          "spk": "四郎治 (シロージ)",
          "ja": "調理法を変えてみるのも手だぜ",
          "tc": "那換換料理方式會是個好辦法。",
          "sc": "那换换料理方式会是个好办法。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 115985,
          "spk": "四郎治 (シロージ)",
          "ja": "山菜やキノコを食うんなら",
          "tc": "想吃山菜和蘑菇，",
          "sc": "想吃山菜和蘑菇，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 115992,
          "spk": "四郎治 (シロージ)",
          "ja": "「山の幸茶碗蒸し」にしてみるといい",
          "tc": "就試著做做看「山珍茶碗蒸」吧。",
          "sc": "就试着做做看“山珍茶碗蒸”吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 116010,
          "spk": "四郎治 (シロージ)",
          "ja": "サッと食えるし体が温まるから、",
          "tc": "可以快速吃完又可以溫暖身體，",
          "sc": "可以快速吃完又可以温暖身体，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 116017,
          "spk": "四郎治 (シロージ)",
          "ja": "寒い時期にちょうどいいんだ",
          "tc": "很適合寒冷的天氣。",
          "sc": "很适合寒冷的天气。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 116035,
          "spk": "四郎治 (シロージ)",
          "ja": "作り方、教えてやるから",
          "tc": "我告訴你怎麼做，",
          "sc": "我告诉你怎么做，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 116042,
          "spk": "四郎治 (シロージ)",
          "ja": "今度試してみろよ",
          "tc": "你下次就試試看吧。",
          "sc": "你下次就试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 487,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 116066,
          "spk": "四郎治 (シロージ)",
          "ja": "なあ、<player>",
          "tc": "我問你，<player>，",
          "sc": "我问你，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 116073,
          "spk": "四郎治 (シロージ)",
          "ja": "記憶に残る料理って、何かあるか？",
          "tc": "你有沒有什麼印象深刻的料理？",
          "sc": "你有没有什么印象深刻的料理？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 116091,
          "spk": "四郎治 (シロージ)",
          "ja": "昔、コマコが「ホワイトシチュー」を",
          "tc": "以前駒子曾經做過",
          "sc": "以前驹子曾经做过"
        },
        {
          "f_idx": 4,
          "pidx_tc": 116098,
          "spk": "四郎治 (シロージ)",
          "ja": "作ったことがあってな",
          "tc": "「奶油燉菜」。",
          "sc": "“黄油炖菜”。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 116109,
          "spk": "四郎治 (シロージ)",
          "ja": "本に出てきたのを見て",
          "tc": "大概是她在書上看到了，",
          "sc": "大概是她在书上看到了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 116116,
          "spk": "四郎治 (シロージ)",
          "ja": "自分でも食べてみたくなったんだろうな",
          "tc": "自己也想吃吃看才做的吧。",
          "sc": "自己也想吃吃看才做的吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 116127,
          "spk": "四郎治 (シロージ)",
          "ja": "ま、具材の大きさはバラバラで",
          "tc": "雖然材料切得大小不一的，",
          "sc": "虽然材料切得大小不一的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 116134,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと焦げたりしてて、",
          "tc": "而且還有一點焦掉了，",
          "sc": "而且还有一点焦掉了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 116141,
          "spk": "四郎治 (シロージ)",
          "ja": "思い描いたシチューとは違ったみたいだけどな",
          "tc": "跟我想像中的燉菜不太一樣。",
          "sc": "跟我想像中的炖菜不太一样。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 116152,
          "spk": "四郎治 (シロージ)",
          "ja": "味も特別美味かったわけじゃない",
          "tc": "吃起來也不是特別美味，",
          "sc": "吃起来也不是特别美味，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 116159,
          "spk": "四郎治 (シロージ)",
          "ja": "けど、今でもたまに思い出すんだ",
          "tc": "但我現在偶爾都還會想起那個味道。",
          "sc": "但我现在偶尔都还会想起那个味道。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 116175,
          "spk": "四郎治 (シロージ)",
          "ja": "レシピは簡単だから、",
          "tc": "這食譜很簡單，",
          "sc": "这食谱很简单，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 116182,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も作ってみろよ",
          "tc": "<player>你也做做看吧。",
          "sc": "<player>你也做做看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 488,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 116206,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、お前さ、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 116213,
          "spk": "四郎治 (シロージ)",
          "ja": "山の果物って食ったことあるか？",
          "tc": "你有吃過山上的水果嗎？",
          "sc": "你吃过山上的野果吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 116224,
          "spk": "四郎治 (シロージ)",
          "ja": "山を歩いていると実ってるだろ？",
          "tc": "在山裡走走，應該會看到很多果實吧？",
          "sc": "在山里走走，应该会看到很多果实吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 116231,
          "spk": "四郎治 (シロージ)",
          "ja": "ビワやキイチゴとか、アケビ……",
          "tc": "像是枇杷、樹莓、木通之類的……",
          "sc": "像是枇杷、树莓、木通之类的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 116238,
          "spk": "四郎治 (シロージ)",
          "ja": "要するに、山で採れる果物のことだ",
          "tc": "都是可以在山裡採到的水果。",
          "sc": "都是可以在山里采到的水果。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 116249,
          "spk": "四郎治 (シロージ)",
          "ja": "果物とはいえお前みたいなガキにとっては、",
          "tc": "對妳這樣的小孩來說，",
          "sc": "对你这样的小孩来说，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 116256,
          "spk": "四郎治 (シロージ)",
          "ja": "少しクセがあって食べにくいかもしれないが、",
          "tc": "這些水果可能有些獨特，不太好入口，",
          "sc": "这些水果可能有些独特，不太好入口，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 116263,
          "spk": "四郎治 (シロージ)",
          "ja": "栄養があって、体にいいんだぜ",
          "tc": "但它們營養價值高，對身體很好。",
          "sc": "但它们营养价值高，对身体很好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 116272,
          "spk": "四郎治 (シロージ)",
          "ja": "騙されたと思って食ってみろよ",
          "tc": "就當作是被我騙了，試試看吧。",
          "sc": "就当作是被我骗了，试试看吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 116279,
          "spk": "四郎治 (シロージ)",
          "ja": "あ、いや別に、騙すつもりはないんだけどな",
          "tc": "啊，不是，我也不是想要騙你，",
          "sc": "啊，不是，我也不是想要骗你，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 116286,
          "spk": "四郎治 (シロージ)",
          "ja": "きっと好きになると思うんだ",
          "tc": "我想你一定會喜歡的。",
          "sc": "我想你一定会喜欢的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 116297,
          "spk": "四郎治 (シロージ)",
          "ja": "作り方だけ教えておくから",
          "tc": "我會教你怎麼做，",
          "sc": "我会教你怎么做，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 116304,
          "spk": "四郎治 (シロージ)",
          "ja": "気が向いたら食べてみてくれ",
          "tc": "你有興趣的話再做來吃吃看吧。",
          "sc": "你有兴趣的话再做来吃吃看吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 116313,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、作り方っつっても",
          "tc": "不過說是要教你怎麼做，",
          "sc": "不过说是要教你怎么做，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 116320,
          "spk": "四郎治 (シロージ)",
          "ja": "適当に盛り付けるだけなんだけどな",
          "tc": "其實也就只是隨便擺個盤而已。",
          "sc": "其实也就只是随便摆个盘而已。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 489,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 116344,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、いいところに来たな",
          "tc": "<player>，你來得正好，",
          "sc": "<player>，你来得正好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 116351,
          "spk": "四郎治 (シロージ)",
          "ja": "お前に用があったんだ",
          "tc": "我有事找你。",
          "sc": "我有事找你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 116362,
          "spk": "四郎治 (シロージ)",
          "ja": "いい食材がいくつか手に入ったから、",
          "tc": "我拿到了一些不錯的食材，",
          "sc": "我拿到了一些不错的食材，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 116369,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかくだから調理して",
          "tc": "想說機會難得，",
          "sc": "想说机会难得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 116376,
          "spk": "四郎治 (シロージ)",
          "ja": "お前にも食わせてやろうかと思ったんだ",
          "tc": "我想讓你也吃吃看。",
          "sc": "我想让你也吃吃看。"
        },
        {
