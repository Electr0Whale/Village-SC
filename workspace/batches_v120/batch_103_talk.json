      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 117129,
          "spk": "四郎治 (シロージ)",
          "ja": "ここに置けば、",
          "tc": "放在這裡的話，",
