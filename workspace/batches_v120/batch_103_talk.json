      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115679,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、<player>か",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115686,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょうどいいところに来たな",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115697,
          "spk": "四郎治 (シロージ)",
          "ja": "<tmpstr>を持ってないか？",
          "tc": "你有沒有<tmpstr>？",
          "sc": "你有没有<tmpstr>？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115704,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと入り用でな",
          "tc": "我需要用到。",
          "sc": "我需要用到。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 115715,
          "spk": "四郎治 (シロージ)",
          "ja": "礼はするから余裕があったら",
          "tc": "你有空的話，就幫我拿來吧，",
          "sc": "你有空的话，就帮我拿来吧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 115722,
          "spk": "四郎治 (シロージ)",
          "ja": "用意してもらえると助かる",
          "tc": "我會再答謝你的。",
          "sc": "我会再答谢你的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 115733,
          "spk": "四郎治 (シロージ)",
          "ja": "できれば<gamevalue GAME_VALUE_TALK_NUM>日以内に欲しいんだ",
          "tc": "如果可以，我希望能在<gamevalue GAME_VALUE_TALK_NUM>天內拿到。",
          "sc": "如果可以，我希望能在<gamevalue GAME_VALUE_TALK_NUM>天内拿到。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 115751,
          "spk": "四郎治 (シロージ)",
          "ja": "悪いんだが、よろしく頼むぜ",
          "tc": "抱歉，就麻煩你了。",
          "sc": "抱歉，就麻烦你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 483,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0051",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115775,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>か……",
          "tc": "是<player>啊……",
