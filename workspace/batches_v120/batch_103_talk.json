        },
        {
          "f_idx": 1,
          "pidx_tc": 117136,
          "spk": "四郎治 (シロージ)",
          "ja": "ロッカクさんも使いやすいか？",
          "tc": "六角叔在使用上也很方便吧。",
          "sc": "六角叔在使用上也很方便吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 117147,
          "spk": "四郎治 (シロージ)",
          "ja": "……普段料理しないからな、",
          "tc": "……我平時不做料理，",
          "sc": "……我平时不做料理，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 117154,
          "spk": "四郎治 (シロージ)",
          "ja": "こういう時、どうしたら効率がいいか",
          "tc": "所以這種時候完全不知道",
          "sc": "所以这种时候完全不知道"
        },
        {
          "f_idx": 4,
          "pidx_tc": 117161,
          "spk": "四郎治 (シロージ)",
          "ja": "全くわからねぇ……",
          "tc": "怎麼做比較有效率……",
          "sc": "怎么做比较有效率……"
        }
      ]
    },
    {
      "file": "talk.dat",
