        },
        {
          "f_idx": 1,
          "pidx_tc": 115782,
          "spk": "四郎治 (シロージ)",
          "ja": "それは<tmpstr>か？",
          "tc": "那是<tmpstr>嗎？",
          "sc": "那是<tmpstr>吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115789,
          "spk": "四郎治 (シロージ)",
          "ja": "持ってきてくれたのか？",
