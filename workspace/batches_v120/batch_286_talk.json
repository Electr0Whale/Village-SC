        },
        {
          "f_idx": 7,
          "pidx_tc": 456649,
          "spk": "六角 (ロッカク)",
          "ja": "おむすびを作るのが精いっぱいだったんスよ",
          "tc": "能做得出飯糰就要偷笑了。",
          "sc": "能做得出饭团就要偷笑了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 456660,
          "spk": "六角 (ロッカク)",
          "ja": "けど、これがまた美味くてねえ",
          "tc": "但自己做出來的飯糰卻意外的很好吃。",
          "sc": "但自己做出来的饭团却意外的很好吃。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 456667,
          "spk": "六角 (ロッカク)",
          "ja": "その時の経験からか、",
          "tc": "可能是因為這樣吧，",
          "sc": "可能是因为这样吧，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 456674,
          "spk": "六角 (ロッカク)",
          "ja": "塩むすびは今でもワシのご馳走なんス",
          "tc": "所以鹽味飯糰對我來說依舊是道佳餚。",
          "sc": "所以盐味饭团对我来说依旧是道佳肴。"
        }
      ]
    },
    {
      "file": "talk.dat",
