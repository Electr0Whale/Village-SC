        },
        {
          "f_idx": 4,
          "pidx_tc": 456137,
          "spk": "六角 (ロッカク)",
          "ja": "気にせず食えるのが売りってところっス",
          "tc": "就是連喝醉酒、神智不清的客人都能放心地吃。",
          "sc": "就是连喝醉酒、神智不清的客人都能放心地吃呐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456153,
          "spk": "六角 (ロッカク)",
          "ja": "こいつでキスケさん辺りが",
          "tc": "只要木助他們能配著這道菜喝完整瓶燒酒，",
          "sc": "只要木助他们能配着这道菜喝完整瓶烧酒，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456160,
          "spk": "六角 (ロッカク)",
          "ja": "焼酎の一本でも空けてくれればめっけもんっス",
          "tc": "那我就謝天謝地了。",
          "sc": "那我就谢天谢地呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
