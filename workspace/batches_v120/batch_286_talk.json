      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456105,
          "spk": "六角 (ロッカク)",
          "ja": "定番の塩焼きも美味いっスけど",
          "tc": "經典的鹽烤雖然也很好吃，",
          "sc": "经典的盐烤虽然也很好吃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456112,
          "spk": "六角 (ロッカク)",
          "ja": "丸ごと揚げてがぶっといくのもいいもんっス",
          "tc": "不過把整條丟下去炸，直接這樣吃也不錯。",
          "sc": "不过把整条丢下去炸，直接这样吃也不错呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456130,
          "spk": "六角 (ロッカク)",
          "ja": "特に酔っ払って、前後不覚になった酔客でも",
          "tc": "這道料理的賣點，",
