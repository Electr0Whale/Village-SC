          "spk": "茶梅 (サザンカ)",
          "ja": "だから、ほら",
          "tc": "所以囉，來嘛！",
          "sc": "所以嘛，来嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8378,
      "rec_id": "TALK_ID_70_2080_003_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453371,
          "spk": "六角 (ロッカク)",
          "ja": "そうそう",
          "tc": "就是這樣，",
          "sc": "就是这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453378,
          "spk": "六角 (ロッカク)",
          "ja": "ヒトの好意は受け取っておくもんっスよ",
          "tc": "你就收下別人的好意吧。",
          "sc": "你就收下别人的好意哟。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453389,
          "spk": "六角 (ロッカク)",
          "ja": "特に、ワシみたいな男の善意なんて",
          "tc": "尤其是像我這種男人的善意，",
          "sc": "尤其是像我这种男人的善意，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453396,
          "spk": "六角 (ロッカク)",
          "ja": "いつ品切れしてもおかしくないっスからねえ",
          "tc": "什麼時候缺貨都不奇怪。",
          "sc": "什么时候缺货都不奇怪。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453407,
          "spk": "六角 (ロッカク)",
          "ja": "せっかくだ",
          "tc": "難得都來了，",
          "sc": "难得都来了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453414,
          "spk": "六角 (ロッカク)",
          "ja": "デザートにこの、フルーツも付けましょう",
          "tc": "我就送你這個水果，當作是飯後甜點吧。",
          "sc": "我就送你这个水果，当作是饭后甜点吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 453425,
          "spk": "六角 (ロッカク)",
          "ja": "ま、我が家のおやつの残りなんスが……",
          "tc": "雖然這是我家剩下來的……",
          "sc": "虽然这是我家剩下来的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8379,
      "rec_id": "TALK_ID_70_2080_003_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453457,
          "spk": "六角 (ロッカク)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453464,
          "spk": "六角 (ロッカク)",
          "ja": "もしかして、さっきの帳簿のこと",
          "tc": "難道說你是在在意",
          "sc": "难道说你是在在意"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453471,
          "spk": "六角 (ロッカク)",
          "ja": "気にしてるんスか？",
          "tc": "我剛剛說的記帳的事嗎？",
          "sc": "我刚刚说的记帐的事吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453482,
          "spk": "六角 (ロッカク)",
          "ja": "子どもが遠慮なんてするものじゃないっスよ",
          "tc": "小孩子不必顧慮這些啦，",
          "sc": "小孩子不必顾虑这些啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453489,
          "spk": "六角 (ロッカク)",
          "ja": "そもそも、本当に苦しかったら",
          "tc": "而且要是我日子真的過不下去，",
          "sc": "而且要是我日子真的过不下去，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453496,
          "spk": "六角 (ロッカク)",
          "ja": "とっくの昔に他の村人に泣きついてるっス",
          "tc": "我老早就去找其他村民哭訴了。",
          "sc": "我老早就去找其他村民哭诉呐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 453507,
          "spk": "六角 (ロッカク)",
          "ja": "その時は<player>さんが",
          "tc": "到時候啊，<player>，",
          "sc": "到时候啊，<player>，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 453514,
          "spk": "六角 (ロッカク)",
          "ja": "いの一番の候補っスから",
          "tc": "我一定會第一個去找你幫忙的，",
          "sc": "我一定会第一个去找你帮忙的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 453521,
          "spk": "六角 (ロッカク)",
          "ja": "覚悟しといてくださいね？",
          "tc": "所以你就先做好心理準備吧。",
          "sc": "所以你就先做好心理准备吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 453532,
          "spk": "六角 (ロッカク)",
          "ja": "なぁんて、冗談っスけどね",
          "tc": "我開玩笑的啦。",
          "sc": "我开玩笑呐。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 453539,
          "spk": "六角 (ロッカク)",
          "ja": "お金はほら、大酒呑みの連中から",
          "tc": "錢的話，我會從那群酒鬼們身上",
          "sc": "钱的话，我会从那群酒鬼们身上"
        },
        {
          "f_idx": 11,
          "pidx_tc": 453546,
          "spk": "六角 (ロッカク)",
          "ja": "絞れるだけ絞りますんで",
          "tc": "榨得乾乾淨淨的。",
          "sc": "榨得干干净净的。"
        }
      ]
    },
    {
      "file": "talk.dat",
