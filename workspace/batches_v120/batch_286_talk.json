        {
          "f_idx": 8,
          "pidx_tc": 456756,
          "spk": "六角 (ロッカク)",
          "ja": "ならないためにも、ね",
          "tc": "得過且過的大人。",
          "sc": "得过且过的大人。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8384,
      "rec_id": "TALK_ID_70_2080_009_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 457021,
          "spk": "六角 (ロッカク)",
          "ja": "やっぱそうっスよねぇ……",
          "tc": "果然不行啊……",
          "sc": "果然不行啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 457028,
          "spk": "六角 (ロッカク)",
          "ja": "ケーキ自体は悪くないんスけど、",
          "tc": "蛋糕本身是不賴，",
          "sc": "蛋糕本身是不赖，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 457035,
          "spk": "六角 (ロッカク)",
          "ja": "他のメニューとの食い合わせが……",
          "tc": "但和其他料理一起吃的話就……",
          "sc": "但和其他料理一起吃的话就……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 457046,
          "spk": "六角 (ロッカク)",
          "ja": "さっきも言いましたが、リンさんの発案っス",
          "tc": "我剛剛也說了，這是林的提議。",
          "sc": "我刚刚也说了，这是林的提议呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 457053,
          "spk": "六角 (ロッカク)",
          "ja": "ワシがヨウさんの誕生日に作ってた",
          "tc": "因為被她發現了",
          "sc": "因为被她发现了"
        },
        {
          "f_idx": 5,
          "pidx_tc": 457060,
          "spk": "六角 (ロッカク)",
          "ja": "バースデーケーキの存在に気付かれまして……",
          "tc": "我為洋妹妹做的生日蛋糕……",
          "sc": "我为洋妹妹做的生日蛋糕……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 457071,
          "spk": "六角 (ロッカク)",
          "ja": "出せるものは、安定供給しなさい！",
          "tc": "做得出來的東西，給我持續提供！",
          "sc": "做得出来的东西，给我持续提供！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 457078,
          "spk": "六角 (ロッカク)",
          "ja": "ついでに食堂、居酒屋だけじゃなく、",
          "tc": "不只是餐廳和居酒屋，",
          "sc": "不只是餐厅和居酒屋，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 457085,
          "spk": "六角 (ロッカク)",
          "ja": "喫茶店も名乗りなさい！",
          "tc": "也要自稱是咖啡館！",
          "sc": "也要自称是咖啡馆！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 457096,
          "spk": "六角 (ロッカク)",
          "ja": "なんて言われちまいましてね……",
          "tc": "她這樣說了……",
          "sc": "她这样说了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 457107,
          "spk": "六角 (ロッカク)",
          "ja": "正直、めちゃくちゃ手間がかかるんで、",
