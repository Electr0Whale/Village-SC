        {
          "f_idx": 1,
          "pidx_tc": 456699,
          "spk": "六角 (ロッカク)",
          "ja": "次呼ぶときは、ちゃんとしたモンを",
          "tc": "下次叫你來，",
          "sc": "下次叫你来，"
