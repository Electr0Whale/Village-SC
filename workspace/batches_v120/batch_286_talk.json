      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456592,
          "spk": "六角 (ロッカク)",
          "ja": "こいつは、ワシがこの食堂を継ぐ前に",
          "tc": "這是我在接手這間餐廳之前，",
          "sc": "这是我在接手这间餐厅之前，"
