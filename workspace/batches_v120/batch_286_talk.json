        {
          "f_idx": 4,
          "pidx_tc": 456724,
          "spk": "六角 (ロッカク)",
          "ja": "こんなモンで満足させようとしちゃ",
          "tc": "就想用這種東西來滿足，",
          "sc": "就想用这种东西来满足，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456731,
          "spk": "六角 (ロッカク)",
          "ja": "よくないっスね……",
          "tc": "是不太好的吧……",
          "sc": "是不太好的吧……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456742,
          "spk": "六角 (ロッカク)",
          "ja": "……ワシみたいに、",
          "tc": "……我可不希望你們長大後",
          "sc": "……我可不希望你们长大后"
        },
        {
          "f_idx": 7,
