        {
          "f_idx": 1,
          "pidx_tc": 456599,
          "spk": "六角 (ロッカク)",
          "ja": "作ることができた唯一の料理っス",
          "tc": "唯一會做的料理。",
          "sc": "唯一会做的料理呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456610,
          "spk": "六角 (ロッカク)",
          "ja": "話したとは思うんですが",
          "tc": "我想之前我應該有跟你說過，",
          "sc": "我想之前我应该有跟你说过，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456617,
          "spk": "六角 (ロッカク)",
          "ja": "昔のワシはこう、色々とヤンチャでね",
          "tc": "我以前其實很叛逆，",
          "sc": "我以前其实很叛逆，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456624,
          "spk": "六角 (ロッカク)",
          "ja": "夜毎、遊び歩いてたんスよね",
          "tc": "晚上都會跑去外面亂晃。",
          "sc": "晚上都会跑去外面乱晃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456635,
          "spk": "六角 (ロッカク)",
          "ja": "で、朝起きると家にゃ米くらいしか置いてねえ",
          "tc": "然後每次早上一起來，就會發現家裡只剩下白米。",
          "sc": "然后每次早上一起来，就会发现家里只剩下白米。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456642,
          "spk": "六角 (ロッカク)",
          "ja": "当時は料理もズブの素人で、",
          "tc": "我當時也不會做菜什麼的，是個大外行，",
