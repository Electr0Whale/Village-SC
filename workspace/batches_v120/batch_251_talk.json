      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399972,
          "spk": "林 (リン)",
          "ja": "急なことを聞くんだけど",
          "tc": "雖然這麼問很突然，",
          "sc": "虽然这么问很突然，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399979,
