          "pidx_tc": 399704,
          "spk": "林 (リン)",
          "ja": "ちょうど今、あなたに相談したい",
          "tc": "我正好有件是想跟你商量，",
          "sc": "我正好有件是想跟你商量，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 399711,
          "spk": "林 (リン)",
          "ja": "深刻な悩み事があって……",
          "tc": "是一個很嚴重的問題……",
          "sc": "是一个很严重的问题……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 399722,
          "spk": "林 (リン)",
          "ja": "この屋敷、広いでしょう",
          "tc": "你看，這間屋子不是很大嗎？",
          "sc": "你看，这间屋子不是很大吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 399729,
          "spk": "林 (リン)",
          "ja": "なかなか掃除が間に合わないのよね……",
          "tc": "所以我每次打掃總是掃不完……",
          "sc": "所以我每次打扫总是扫不完……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 399740,
          "spk": "林 (リン)",
          "ja": "好意で泊めてあげるんだから",
          "tc": "我這麼好心讓你留下來過夜，",
          "sc": "我这么好心让你留下来过夜，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 399747,
          "spk": "林 (リン)",
          "ja": "当然、頼まれてくれるわよね？",
          "tc": "你當然會答應我的請求吧？",
          "sc": "你当然会答应我的请求吧？"
        }
      ]
    },
