      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399629,
          "spk": "林 (リン)",
          "ja": "実はね、",
          "tc": "其實，",
          "sc": "其实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399636,
          "spk": "林 (リン)",
          "ja": "今日はあなたにお礼を言いたくて呼んだの",
          "tc": "我今天是為了跟你道謝才找你來的。",
          "sc": "我今天是为了跟你道谢才找你来的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399647,
          "spk": "林 (リン)",
          "ja": "私に……正直に悩みを打ち明けて、",
          "tc": "你教會我……誠實地說出煩惱，",
          "sc": "你教会我……诚实地说出烦恼，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 399654,
          "spk": "林 (リン)",
          "ja": "人に頼ることを教えてくれたでしょう？",
          "tc": "去依賴他人，對吧？",
          "sc": "去依赖他人，对吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 399672,
          "spk": "林 (リン)",
          "ja": "あれから、仕事の量は変わっていないのに、",
