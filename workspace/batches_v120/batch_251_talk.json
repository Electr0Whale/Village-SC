          "f_idx": 7,
          "pidx_tc": 399686,
          "spk": "林 (リン)",
          "ja": "……あなたのおかげね",
          "tc": "……這都是多虧了你。",
          "sc": "……这都是多亏了你。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 399697,
          "spk": "林 (リン)",
          "ja": "そうだ……",
          "tc": "對了……",
          "sc": "对了……"
        },
