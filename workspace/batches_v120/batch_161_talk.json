  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3323,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 177162,
          "spk": "林 (リン)",
          "ja": "さすがは食欲の秋",
          "tc": "真不愧是食欲之秋。",
          "sc": "真不愧是食欲之秋。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 177169,
          "spk": "林 (リン)",
          "ja": "どの料理もおいしくて、箸が止まらないわ",
          "tc": "每道料理都太好吃了，筷子完全停不下來。",
          "sc": "每道料理都太好吃了，筷子完全停不下来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 177189,
          "spk": "帷 (トバリ)",
          "ja": "……太るよ？",
          "tc": "……會胖喔。",
          "sc": "……会胖。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 177202,
          "spk": "林 (リン)",
          "ja": "う、うるさいわね",
          "tc": "妳、妳很囉唆耶。",
          "sc": "你、你很啰嗦啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 177209,
          "spk": "林 (リン)",
          "ja": "考えないようにしてたのに",
          "tc": "我原本一直刻意不去想的說……",
          "sc": "我原本一直刻意不去想的说……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 177224,
          "spk": "驹子 (コマコ)",
          "ja": "食欲が止まらないのは",
          "tc": "食欲旺盛這點，",
          "sc": "食欲旺盛这点，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 177231,
          "spk": "驹子 (コマコ)",
          "ja": "動物も同じみたいだね",
          "tc": "動物好像也是一樣呢。",
          "sc": "动物好像也是一样呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 177242,
          "spk": "驹子 (コマコ)",
          "ja": "今の時期に仕留めた獲物は",
          "tc": "現在這個時節捕到的獵物，",
          "sc": "现在这个时节捕到的猎物，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 177249,
          "spk": "驹子 (コマコ)",
          "ja": "どの子も脂が乗っておいしいんだよ",
          "tc": "每隻都肥滋滋的，很美味喔～",
          "sc": "每只都肥滋滋的，很美味哦～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 177262,
          "spk": "帷 (トバリ)",
          "ja": "そ、そうなんだ……",
          "tc": "這、這樣啊……",
          "sc": "这、这样啊……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 177275,
          "spk": "洋 (ヨウ)",
          "ja": "ここに並んでいるお料理って",
          "tc": "現在擺在桌上的這些料理，",
          "sc": "现在摆在桌上的这些料理，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 177282,
          "spk": "洋 (ヨウ)",
          "ja": "もしかして……",
          "tc": "該不會……",
          "sc": "该不会……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 177295,
          "spk": "驹子 (コマコ)",
          "ja": "うん、ロッカクさんのお店に",
          "tc": "嗯，我送了很多過來六角叔店裡，",
          "sc": "嗯，我送了很多过来六角叔店里，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 177302,
          "spk": "驹子 (コマコ)",
          "ja": "たくさん卸したから、私が仕留めた獲物も",
          "tc": "所以裡面說不定",
          "sc": "所以里面说不定"
        },
        {
          "f_idx": 15,
          "pidx_tc": 177309,
          "spk": "驹子 (コマコ)",
          "ja": "入っているかもしれないね",
          "tc": "也有我打到的獵物呢。",
          "sc": "也有我打到的猎物呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 177322,
          "spk": "林 (リン)",
          "ja": "……これも、考えないようにしてたけど",
          "tc": "……我原本也刻意不去想這件事的，",
          "sc": "……我原本也刻意不去想这件事的，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 177329,
          "spk": "林 (リン)",
          "ja": "人が生きていくのに欠かせないことなのよね",
          "tc": "但這也是人類為了生存所不可或缺的一環吧。",
          "sc": "但这也是人类为了生存所不可或缺的一环吧。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 177349,
          "spk": "帷 (トバリ)",
          "ja": "そうね……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 177356,
          "spk": "帷 (トバリ)",
          "ja": "当たり前すぎて、忘れてた",
          "tc": "太過理所當然，反而忘了。",
          "sc": "太过理所当然，反而忘了。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 177369,
          "spk": "林 (リン)",
          "ja": "こうして生かされているのだと忘れず",
          "tc": "讓我們感念生命所賜予的一切，",
          "sc": "让我们感念生命所赐予的一切，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 177376,
          "spk": "林 (リン)",
          "ja": "命の恵みに感謝していただきましょう",
          "tc": "心懷感激地享用吧。",
          "sc": "心怀感激地享用吧。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 177398,
          "spk": "洋 (ヨウ)",
          "ja": "……動物さん、ありがとうございます",
          "tc": "……動物們，謝謝你們。",
          "sc": "……动物们，谢谢你们。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 177405,
          "spk": "洋 (ヨウ)",
          "ja": "みんなでおいしく、いただきます",
          "tc": "我們大家會一起好好享用的。",
          "sc": "我们大家会一起好好享用的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3324,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0051",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 177441,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねー、そろそろ山がイイ感じに",
          "tc": "我說啊～",
          "sc": "我说啊～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 177448,
          "spk": "茶梅 (サザンカ)",
          "ja": "色付いてきたくない？",
          "tc": "不覺得現在山頭紅得正漂亮嗎？",
          "sc": "不觉得现在山头红得正漂亮吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 177455,
          "spk": "茶梅 (サザンカ)",
          "ja": "紅葉狩り行っちゃう？",
          "tc": "要不要去賞個楓？",
          "sc": "要不要去赏个枫？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 177468,
          "spk": "堇怜 (スミレ)",
          "ja": "紅葉か……綺麗だとは思うけど",
          "tc": "楓葉嗎……漂亮是漂亮啦，",
          "sc": "枫叶吗……漂亮是漂亮啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 177475,
          "spk": "堇怜 (スミレ)",
          "ja": "山なら僕は、",
          "tc": "但說到進山的話，",
          "sc": "但说到进山的话，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 177482,
          "spk": "堇怜 (スミレ)",
          "ja": "キノコ狩りかクリ拾いがしたいな",
          "tc": "我更想去採蘑菇或撿栗子。",
          "sc": "我更想去采蘑菇或捡栗子。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 177495,
          "spk": "裕太 (ユータ)",
          "ja": "山へ行くなら俺も一緒に連れてってよ！",
          "tc": "要進山的話也帶我去嘛！",
          "sc": "要进山的话也带我去嘛！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 177502,
          "spk": "裕太 (ユータ)",
          "ja": "一人では迷っちゃいそうだから、",
          "tc": "自己去的話感覺很容易迷路，",
          "sc": "自己去的话感觉很容易迷路，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 177509,
          "spk": "裕太 (ユータ)",
          "ja": "なかなか奥まで行く勇気が出なかったんだよね！",
          "tc": "總是拿不出勇氣進到深處去！",
          "sc": "总是拿不出勇气进到深处去！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 177524,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、とりま山行くか～",
          "tc": "那總之就決定去山上囉～",
          "sc": "那总之就决定去山上啦～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 177531,
          "spk": "茶梅 (サザンカ)",
          "ja": "で、どの辺り目指してく？",
          "tc": "所以，我們要到哪個地方去？",
          "sc": "所以，我们要到哪个地方去？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 177538,
          "spk": "茶梅 (サザンカ)",
          "ja": "やっぱフツーに頂上かな",
          "tc": "一般來說應該是山頂吧。",
          "sc": "一般来说应该是山顶吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 177551,
          "spk": "名护 (ナゴ)",
          "ja": "地図で見ただけだが、頂上の手前に",
          "tc": "雖然只在地圖上看到過，",
          "sc": "虽然只在地图上看到过，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 177558,
          "spk": "名护 (ナゴ)",
          "ja": "少し開けた場所があるようだ",
          "tc": "不過在山頂前似乎有塊小空地。",
          "sc": "不过在山顶前似乎有块小空地。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 177565,
          "spk": "名护 (ナゴ)",
          "ja": "シロージくんなら案内してくれるだろうか……？",
          "tc": "四郎治應該會願意幫忙帶路吧……？",
          "sc": "四郎治应该会愿意帮忙带路吧……？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 177578,
          "spk": "茶梅 (サザンカ)",
          "ja": "おっ、いいじゃん",
          "tc": "喔，聽起來不錯啊。",
          "sc": "喔，听起来不错啊。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 177585,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、シロージにはアタシから頼んどくわ",
          "tc": "那我去拜託四郎治吧。",
          "sc": "那我去拜托四郎治吧。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 177600,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだし、そこでランチにしようよ",
          "tc": "難得有這個機會，我們就在那邊吃午餐吧。",
          "sc": "难得有这个机会，我们就在那边吃午餐吧。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 177607,
          "spk": "裕太 (ユータ)",
          "ja": "おにぎりとか簡単なものでよければ",
          "tc": "如果大家可以接受飯糰之類的簡單餐點，",
          "sc": "如果大家可以接受饭团之类的简单餐点，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 177614,
          "spk": "裕太 (ユータ)",
          "ja": "俺が作って持っていくよ",
          "tc": "就由我做好帶去吧。",
          "sc": "就由我做好带去吧。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 177627,
          "spk": "堇怜 (スミレ)",
          "ja": "僕もキノコ汁なら持って行けるかも",
          "tc": "我應該也能準備一點蘑菇湯，",
          "sc": "我应该也能准备一点蘑菇汤，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 177634,
          "spk": "堇怜 (スミレ)",
          "ja": "熱々のを水筒に入れてきますよ",
          "tc": "用水壺就能裝著熱騰騰的湯帶去。",
          "sc": "用水壶就能装着热腾腾的汤带去。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 177647,
          "spk": "名护 (ナゴ)",
          "ja": "山の上は冷えるから",
          "tc": "山上還滿冷的，",
          "sc": "山上还满冷的，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 177654,
          "spk": "名护 (ナゴ)",
          "ja": "一枚、羽織るものを忘れないようにね",
          "tc": "別忘了帶件外套喔。",
          "sc": "别忘了带件外套哦。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 177667,
          "spk": "茶梅 (サザンカ)",
          "ja": "トントン拍子に決まったな～",
          "tc": "哎呀～兩三下就敲定了呢。",
          "sc": "哎呀～两三下就敲定了呢。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 177674,
          "spk": "茶梅 (サザンカ)",
          "ja": "みんな秋らしいことに飢えてるんだね",
          "tc": "大家都想進行一些有秋天氣氛的活動啊。",
          "sc": "大家都想进行一些有秋天气氛的活动啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3325,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 177713,
          "spk": "木助 (キスケ)",
          "ja": "カァ……！",
          "tc": "呼……！",
          "sc": "呼……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 177720,
          "spk": "木助 (キスケ)",
          "ja": "働いたあとの焼酎はやっぱ最高だな！",
          "tc": "工作結束後來杯燒酎果然最棒了！",
          "sc": "工作结束后来杯烧酎果然最棒了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 177733,
          "spk": "六角 (ロッカク)",
          "ja": "秋になったっスからねぇ",
          "tc": "畢竟已經秋天了嘛。",
          "sc": "毕竟已经秋天了嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 177740,
          "spk": "六角 (ロッカク)",
          "ja": "やっぱりキスケさんも忙しいんっスか？",
          "tc": "木助你應該也滿忙的吧？",
          "sc": "木助你应该也满忙的吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 177753,
          "spk": "木助 (キスケ)",
          "ja": "まあな、冬の間に何かあったら",
          "tc": "算是啦，",
          "sc": "算是啦，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 177760,
          "spk": "木助 (キスケ)",
          "ja": "すぐに動けるように、今抱えてる仕事は",
          "tc": "我想把現在手上的工作盡量處理掉，",
          "sc": "我想把现在手上的工作尽量处理掉，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 177767,
          "spk": "木助 (キスケ)",
          "ja": "ある程度終わらせておきてえんだよな……",
          "tc": "以便在冬天有狀況時可以馬上抽身處理……",
          "sc": "以便在冬天有状况时可以马上抽身处理……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 177778,
          "spk": "木助 (キスケ)",
          "ja": "万が一に備えて、それ用の準備も",
          "tc": "況且也得做好各種準備，",
          "sc": "况且也得做好各种准备，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 177785,
          "spk": "木助 (キスケ)",
          "ja": "しておかねぇとならねえし……",
          "tc": "以防萬一。",
          "sc": "以防万一。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 177798,
          "spk": "六角 (ロッカク)",
          "ja": "万が一って、なんスか？",
          "tc": "以防什麼萬一？",
          "sc": "以防什么万一？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 177811,
          "spk": "木助 (キスケ)",
          "ja": "身構えんな",
          "tc": "別緊張。",
          "sc": "别紧张。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 177818,
          "spk": "木助 (キスケ)",
          "ja": "そんな大したことじゃねぇよ",
          "tc": "不是什麼大不了的事啦。",
          "sc": "不是什么大不了的事啦。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 177829,
          "spk": "木助 (キスケ)",
          "ja": "畑の柵が壊れたとか",
          "tc": "只是如果有人田裡的柵欄壞掉，",
          "sc": "只是如果有人田里的栅栏坏掉，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 177836,
          "spk": "木助 (キスケ)",
          "ja": "家の壁に穴が空いたとかあっても",
          "tc": "或是房子牆壁破洞之類的，",
          "sc": "或是房子墙壁破洞之类的，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 177843,
          "spk": "木助 (キスケ)",
          "ja": "寒い中、仕事すんのは御免被るからな",
          "tc": "我也不想在大冷天裡工作。",
          "sc": "我也不想在大冷天里工作。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 177854,
          "spk": "木助 (キスケ)",
          "ja": "応急処置でも冬を越せるように",
          "tc": "所以正在做各種準備，",
          "sc": "所以正在做各种准备，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 177861,
          "spk": "木助 (キスケ)",
          "ja": "いろいろ準備してんだよ",
          "tc": "好在冬天時可以靠緊急處理撐過去。",
          "sc": "好在冬天时可以靠紧急处理撑过去。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 177881,
          "spk": "六角 (ロッカク)",
          "ja": "……なんだかんだ",
          "tc": "……不管怎麼說，",
          "sc": "……不管怎么说，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 177888,
          "spk": "六角 (ロッカク)",
          "ja": "キスケさんは頼りになるっスね",
