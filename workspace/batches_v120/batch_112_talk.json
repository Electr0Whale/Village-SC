          "ja": "どれもすごい出来栄えだったよね",
          "tc": "每一個都很漂亮。",
          "sc": "每一个都很漂亮。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 35224,
          "spk": "驹子 (コマコ)",
          "ja": "そういえば、<player>は今回",
          "tc": "話說回來，<player>，",
          "sc": "话说回来，<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 35231,
          "spk": "驹子 (コマコ)",
          "ja": "エントリーしなかったんだね",
          "tc": "你這次沒有報名參加呢。",
          "sc": "你这次没有报名参加呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 35242,
          "spk": "驹子 (コマコ)",
          "ja": "次の品評会は出るのかな？",
          "tc": "你會參加下次的評鑑會嗎？",
          "sc": "你会参加下次的评鉴会吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 35249,
          "spk": "驹子 (コマコ)",
          "ja": "出るなら教えてね、応援するよ",
          "tc": "要參加的話就告訴我，我會替你加油的。",
          "sc": "要参加的话就告诉我，我会替你加油的。"
        }
      ]
    },
    {
