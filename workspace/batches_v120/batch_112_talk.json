  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 965,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34675,
          "spk": "驹子 (コマコ)",
          "ja": "ヨウちゃん、バドミントンするの",
          "tc": "小洋好像很喜歡",
          "sc": "小洋好像很喜欢"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34682,
          "spk": "驹子 (コマコ)",
          "ja": "気に入ったみたいでね",
          "tc": "打羽毛球，",
          "sc": "打羽毛球，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34689,
          "spk": "驹子 (コマコ)",
          "ja": "ずーっと打ち合ってるんだ",
          "tc": "所以我們一直來回打個不停。",
          "sc": "所以我们一直来回打个不停。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34700,
          "spk": "驹子 (コマコ)",
          "ja": "もうちょっと続けたら、",
          "tc": "想說再打一下，",
          "sc": "想说再打一下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34707,
          "spk": "驹子 (コマコ)",
          "ja": "二人で桜を見ながら",
          "tc": "我們就要邊欣賞櫻花，",
          "sc": "我们就要边欣赏樱花，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34714,
          "spk": "驹子 (コマコ)",
          "ja": "ご飯を食べようと思ってて",
          "tc": "邊吃飯了。",
          "sc": "边吃饭了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34725,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も一緒にどう？",
          "tc": "<player>，你要不要和我們一起吃？",
          "sc": "<player>，你要不要和我们一起吃？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 34732,
          "spk": "驹子 (コマコ)",
          "ja": "お弁当たくさん用意したから",
          "tc": "我準備了很多便當，",
          "sc": "我准备了很多便当，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 34739,
          "spk": "驹子 (コマコ)",
          "ja": "遠慮しなくていいよ",
          "tc": "所以你不用客氣喔。",
          "sc": "所以你不用客气哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 966,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34763,
          "spk": "驹子 (コマコ)",
          "ja": "えーっと、今日は焼きそばと、",
          "tc": "我想想，今天是日式炒麵，",
          "sc": "我想想，今天是日式炒面，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34770,
          "spk": "驹子 (コマコ)",
          "ja": "りんご飴と……",
          "tc": "和蘋果糖……",
          "sc": "和苹果糖……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34781,
          "spk": "驹子 (コマコ)",
          "ja": "ひよこ……は今年も我慢…！！",
          "tc": "小雞……今年也要忍住……！！",
          "sc": "小鸡……今年也要忍住……！！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34799,
          "spk": "驹子 (コマコ)",
          "ja": "うー……",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34806,
          "spk": "驹子 (コマコ)",
          "ja": "いつも思うけどかわいいな……",
          "tc": "我一直都覺得好可愛啊……",
          "sc": "我一直都觉得好可爱啊……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34813,
          "spk": "驹子 (コマコ)",
          "ja": "……触らせてくれないかな？",
          "tc": "……不知道能不能讓我摸摸看？",
          "sc": "……不知道能不能让我摸摸看？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 967,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34837,
          "spk": "驹子 (コマコ)",
          "ja": "夏祭りっていいね",
          "tc": "夏日祭典真不錯，",
          "sc": "夏日祭典真不错，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34844,
          "spk": "驹子 (コマコ)",
          "ja": "みんな楽しそうにはしゃいでて",
          "tc": "大家都很開心地在玩鬧，",
          "sc": "大家都很开心地在玩闹，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34851,
          "spk": "驹子 (コマコ)",
          "ja": "ここにいるだけで笑顔になれるよ",
          "tc": "光是待在這裡就很高興呢。",
          "sc": "光是待在这里就很高兴呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34862,
          "spk": "驹子 (コマコ)",
          "ja": "でも、楽しい時間って",
          "tc": "不過快樂的時光",
          "sc": "不过快乐的时光"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34869,
          "spk": "驹子 (コマコ)",
          "ja": "あっという間に過ぎちゃうから……",
          "tc": "總是特別短暫……",
          "sc": "总是特别短暂……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34876,
          "spk": "驹子 (コマコ)",
          "ja": "やりたいことは忘れずにやらなくちゃ",
          "tc": "所以得記得去做自己想做的事呢。",
          "sc": "所以得记得去做自己想做的事呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34887,
          "spk": "驹子 (コマコ)",
          "ja": "<player>はもう屋台は回った？",
          "tc": "<player>，你有去逛攤位了嗎？",
          "sc": "<player>，你有去逛摊位了吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 34894,
          "spk": "驹子 (コマコ)",
          "ja": "せっかくの機会だし、全部回ってみるといいよ",
          "tc": "機會難得，你就去全部逛一圈吧。",
          "sc": "机会难得，你就去全部逛一圈吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 968,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34918,
          "spk": "驹子 (コマコ)",
          "ja": "こうやって季節のものを食べるのって",
          "tc": "像這樣吃些當季的食物，",
          "sc": "像这样吃些当季的食物，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34925,
          "spk": "驹子 (コマコ)",
          "ja": "大事だよね",
          "tc": "也是很重要呢。",
          "sc": "也是很重要呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34936,
          "spk": "驹子 (コマコ)",
          "ja": "山も秋になると美味しいものが",
          "tc": "山裡也是到了秋天就有很多",
          "sc": "山里也是到了秋天就有很多"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34943,
          "spk": "驹子 (コマコ)",
          "ja": "たくさんあるんだよ",
          "tc": "美味的食材喔。",
          "sc": "美味的食材哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34950,
          "spk": "驹子 (コマコ)",
          "ja": "今日も持ってくればよかったな",
          "tc": "我今天應該要帶來的。",
          "sc": "我今天应该要带来的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 969,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34974,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34981,
          "spk": "驹子 (コマコ)",
          "ja": "もうすぐでお鍋、完成するよ",
          "tc": "火鍋就快要煮好了。",
          "sc": "火锅就快要煮好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34992,
          "spk": "驹子 (コマコ)",
          "ja": "今年もみんなの育てた",
          "tc": "今年也多虧了有大家培育的",
          "sc": "今年也多亏了有大家培育的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34999,
          "spk": "驹子 (コマコ)",
          "ja": "おいしい食べ物たちのおかげで、",
          "tc": "美味食材，",
          "sc": "美味食材，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 35006,
          "spk": "驹子 (コマコ)",
          "ja": "いいお鍋ができそうだよ",
          "tc": "所以感覺能夠煮出一鍋好料呢。",
          "sc": "所以感觉能够煮出一锅好料呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 35017,
          "spk": "驹子 (コマコ)",
          "ja": "完成したら教えてあげるよ",
          "tc": "等煮好了我會通知你一聲，",
          "sc": "等煮好了我会通知你一声，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 35024,
          "spk": "驹子 (コマコ)",
          "ja": "他にもおいしいものたくさんあるから、",
          "tc": "其他還有很多美食呢，",
          "sc": "其他还有很多美食呢，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 35031,
          "spk": "驹子 (コマコ)",
          "ja": "めいっぱい楽しんでね！",
          "tc": "盡情享受吧！",
          "sc": "尽情享受吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 970,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 35055,
          "spk": "驹子 (コマコ)",
          "ja": "うー！今日も寒いね！",
          "tc": "唔～！今天好冷喔！",
          "sc": "唔～！今天好冷哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 35062,
          "spk": "驹子 (コマコ)",
          "ja": "今年ももう終わりだなぁ",
          "tc": "今年也即將結束了。",
          "sc": "今年也即将结束了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 35073,
          "spk": "驹子 (コマコ)",
          "ja": "何事もなく来年を迎えられるように",
          "tc": "為了能順利迎接明年的到來，",
          "sc": "为了能顺利迎接明年的到来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 35080,
          "spk": "驹子 (コマコ)",
          "ja": "しっかり準備しないとね",
          "tc": "得確實做好準備才行。",
          "sc": "得确实做好准备才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 971,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 35111,
          "spk": "驹子 (コマコ)",
          "ja": "……ん？　あぁ、<player>",
          "tc": "……嗯？啊，是<player>啊。",
          "sc": "……嗯？啊，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 35118,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんね、集中してたから",
          "tc": "抱歉，我太專心了，",
          "sc": "抱歉，我太专心了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 35125,
          "spk": "驹子 (コマコ)",
          "ja": "気づくのが遅れちゃった",
          "tc": "現在才注意到你。",
          "sc": "现在才注意到你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 35136,
          "spk": "驹子 (コマコ)",
          "ja": "毎年リンに頼まれて、",
          "tc": "林說我手很巧，",
          "sc": "林说我手很巧，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 35143,
          "spk": "驹子 (コマコ)",
          "ja": "お正月祝いの飾りを作ってるんだ",
          "tc": "所以她每年都會拜託我",
          "sc": "所以她每年都会拜托我"
        },
        {
          "f_idx": 5,
          "pidx_tc": 35150,
          "spk": "驹子 (コマコ)",
          "ja": "手先が器用だからって",
          "tc": "製作慶祝新年的裝飾，",
          "sc": "制作庆祝新年的装饰，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 35161,
          "spk": "驹子 (コマコ)",
          "ja": "普段から狩りで使う罠を作ってるから、",
          "tc": "我平常就會做狩獵用的陷阱，",
          "sc": "我平常就会做狩猎用的陷阱，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 35168,
          "spk": "驹子 (コマコ)",
          "ja": "こういう作業は得意なんだよね",
          "tc": "所以很擅長這類工作。",
          "sc": "所以很擅长这类工作。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 35175,
          "spk": "驹子 (コマコ)",
          "ja": "みんなの役に立てて嬉しいよ",
          "tc": "能幫上大家的忙，我也很高興呢。",
          "sc": "能帮上大家的忙，我也很高兴呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 972,
      "rec_id": "TALK_ID_HUNTER_HOLIDAY_20_105_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 35199,
          "spk": "驹子 (コマコ)",
          "ja": "品評会、良かったなぁ",
          "tc": "這次評鑑會真棒呢。",
          "sc": "这次评鉴会真棒呢。"
