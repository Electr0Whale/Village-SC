          "f_idx": 2,
          "pidx_tc": 330105,
          "spk": "驹子 (コマコ)",
          "ja": "さ、サザンカさん……",
          "tc": "茶、茶梅姐……",
          "sc": "茶、茶梅姐……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330112,
          "spk": "驹子 (コマコ)",
          "ja": "思ったより淡泊だね",
          "tc": "妳比我預期的還要冷靜呢。",
          "sc": "你比我预期的还要冷静呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330125,
          "spk": "茶梅 (サザンカ)",
          "ja": "どうせまた幻覚っしょ",
          "tc": "反正應該又是幻覺吧。",
          "sc": "反正应该又是幻觉吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330132,
          "spk": "茶梅 (サザンカ)",
          "ja": "こっちに危害を加えてこないなら、",
          "tc": "既然不會傷害我們，",
          "sc": "既然不会伤害我们，"
        },
