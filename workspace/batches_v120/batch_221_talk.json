          "pidx_tc": 330223,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんなことある？",
          "tc": "真的有可能嗎？",
          "sc": "真的有可能吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330236,
          "spk": "驹子 (コマコ)",
          "ja": "う、嘘じゃないよ！",
          "tc": "我、我沒有說謊！",
          "sc": "我、我没有说谎！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 330243,
          "spk": "驹子 (コマコ)",
          "ja": "本当に",
          "tc": "是真的。",
          "sc": "是真的。"
        }
      ]
