          "pidx_tc": 331094,
          "spk": "驹子 (コマコ)",
          "ja": "そんなの……あんなふうに",
          "tc": "別這麼說……",
          "sc": "别这么说……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 331101,
          "spk": "驹子 (コマコ)",
          "ja": "お父さんとお母さんに言われたら",
          "tc": "聽到爸爸媽媽對自己講那些話，",
          "sc": "听到爸爸妈妈对自己讲那些话，"
