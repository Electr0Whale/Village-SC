          "f_idx": 6,
          "pidx_tc": 330139,
          "spk": "茶梅 (サザンカ)",
          "ja": "無視していこ",
          "tc": "就當作沒看到吧。",
          "sc": "就当作没看到吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 330152,
          "spk": "驹子 (コマコ)",
          "ja": "……サザンカさん",
          "tc": "……茶梅姐，",
          "sc": "……茶梅姐，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 330159,
          "spk": "驹子 (コマコ)",
          "ja": "一緒に来てくれてありがとうね……",
          "tc": "真的很謝謝妳陪我一起來……",
          "sc": "真的很谢谢你陪我一起来……"
        }
      ]
    },
    {
