      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331851,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ……行き止まり？",
          "tc": "咦……沒路了？",
          "sc": "咦……没路了？"
