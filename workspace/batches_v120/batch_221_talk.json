          "ja": "母ちゃん……",
          "tc": "媽媽……",
          "sc": "妈妈……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 331040,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさん……",
          "tc": "茶梅姐……",
          "sc": "茶梅姐……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 331047,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんなさい……",
          "tc": "真的很對不起……",
          "sc": "真的很对不起……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 331054,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんなさい……",
          "tc": "真的很對不起……",
          "sc": "真的很对不起……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 331067,
          "spk": "茶梅 (サザンカ)",
