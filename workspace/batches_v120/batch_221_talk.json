          "sc": "但其实我早就发现了哦。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 331184,
          "spk": "驹子 (コマコ)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 331197,
          "spk": "茶梅 (サザンカ)",
          "ja": "父ちゃんと母ちゃんが死んだ時、",
          "tc": "雖然爸爸媽媽過世的時候，",
          "sc": "虽然爸爸妈妈过世的时候，"
