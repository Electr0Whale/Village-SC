      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 332087,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、お願い！",
          "tc": "<player>，拜託你！",
          "sc": "<player>，拜托你！"
