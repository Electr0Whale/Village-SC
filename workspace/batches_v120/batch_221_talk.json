    {
      "file": "talk.dat",
      "rec_idx": 5704,
      "rec_id": "TALK_ID_10_0503_343_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331742,
          "spk": "驹子 (コマコ)",
          "ja": "さ、サザンカさん……！",
          "tc": "茶、茶梅姐……！",
          "sc": "茶、茶梅姐……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 331749,
          "spk": "驹子 (コマコ)",
          "ja": "なんか、そこかしこから声が……",
          "tc": "有聲音從四面八方傳來……",
          "sc": "有声音从四面八方传来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 331760,
          "spk": "茶梅 (サザンカ)",
          "ja": "もう！",
          "tc": "受不了！",
          "sc": "受不了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 331767,
          "spk": "茶梅 (サザンカ)",
          "ja": "今ダウジングに集中したいんだって！",
          "tc": "我現在想專心探測啦！",
          "sc": "我现在想专心探测啦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 331774,
          "spk": "茶梅 (サザンカ)",
          "ja": "コマコ、弓でも射って黙らせてよ！",
          "tc": "駒子，妳拿弓射一射讓它們閉嘴！",
          "sc": "驹子，你拿弓射一射让它们闭嘴！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 331787,
          "spk": "驹子 (コマコ)",
          "ja": "や、やだよ……！",
          "tc": "我、我才不要……！",
          "sc": "我、我才不要……！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 331794,
          "spk": "驹子 (コマコ)",
          "ja": "なにか出てくるかも……",
          "tc": "搞不好會跑出什麼東西……",
          "sc": "说不定会跑出什么东西……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 331807,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、さっさと通っちゃお",
          "tc": "不然我們趕快通過吧。",
          "sc": "不然我们赶快通过吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 331814,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんな声、無視無視！",
          "tc": "就當作沒聽到這些聲音！",
          "sc": "就当作没听到这些声音！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 331825,
          "spk": "驹子 (コマコ)",
          "ja": "う……わかった",
          "tc": "嗚……我知道了。",
          "sc": "呜……我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
