      "rec_id": "TALK_ID_10_0503_344_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331935,
          "spk": "驹子 (コマコ)",
          "ja": "なんだかちょっと、",
          "tc": "總覺得，",
          "sc": "总觉得，"
