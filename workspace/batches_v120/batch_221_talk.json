    },
    {
      "file": "talk.dat",
      "rec_idx": 5706,
      "rec_id": "TALK_ID_10_0503_344_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331871,
          "spk": "驹子 (コマコ)",
          "ja": "草が高い上に、霧が濃くて視界が悪いね……",
          "tc": "不僅草長得高，霧又很濃，能見度真差……",
          "sc": "不仅草长得高，雾又很浓，能见度真差……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 331878,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、あまり離れないようにしよう……",
          "tc": "<player>，我們要小心別離太遠……",
          "sc": "<player>，我们要小心别离太远……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5707,
      "rec_id": "TALK_ID_10_0503_344_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331903,
          "spk": "茶梅 (サザンカ)",
          "ja": "おかしいなぁ……",
          "tc": "真奇怪……",
          "sc": "真奇怪……"
