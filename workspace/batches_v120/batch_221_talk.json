        {
          "f_idx": 1,
          "pidx_tc": 331942,
          "spk": "驹子 (コマコ)",
          "ja": "イヤな気配がするよ……",
          "tc": "有股不祥的預感……",
          "sc": "有股不祥的预感……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 331949,
          "spk": "驹子 (コマコ)",
          "ja": "戻ろう、サザンカさん……",
          "tc": "茶梅姐，我們回去好了……",
          "sc": "茶梅姐，我们回去好了……"
        },
        {
          "f_idx": 3,
