          "f_idx": 1,
          "pidx_tc": 332138,
          "spk": "茶梅 (サザンカ)",
          "ja": "マシンはこんなに反応してるのに……",
          "tc": "探測器的反應明明這麼強烈……",
          "sc": "探测器的反应明明这么强烈……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 332145,
          "spk": "茶梅 (サザンカ)",
          "ja": "一体どうし",
          "tc": "到底為什──",
          "sc": "到底为什——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5714,
      "rec_id": "TALK_ID_10_0503_344_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 332173,
          "spk": "驹子 (コマコ)",
          "ja": "な、な……なに、あれ……！",
          "tc": "那、那……那是什麼……！",
          "sc": "那、那……那是什么……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 332180,
          "spk": "驹子 (コマコ)",
          "ja": "一体、なにが起きて……",
          "tc": "到底發生了什麼……",
          "sc": "到底发生了什么……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 332191,
          "spk": "茶梅 (サザンカ)",
          "ja": "……一応聞くけど、",
          "tc": "……我還是問一下好了，",
          "sc": "……我还是问一下好了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 332198,
          "spk": "茶梅 (サザンカ)",
          "ja": "コマコって十年前に",
          "tc": "駒子妳十年前，",
          "sc": "驹子你十年前，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 332205,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああいうのも殺したの？",
          "tc": "還殺過那種東西嗎？",
          "sc": "还杀过那种东西吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 332218,
          "spk": "驹子 (コマコ)",
          "ja": "わ、わかんないよ！",
          "tc": "我、我不曉得啊！",
          "sc": "我、我不晓得啊！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 332225,
          "spk": "驹子 (コマコ)",
          "ja": "覚えてないんだもの……！",
          "tc": "我又沒有記憶……！",
          "sc": "我又没有记忆……！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 332236,
          "spk": "驹子 (コマコ)",
          "ja": "でも、さっきの犬とか人影とは",
          "tc": "不過感覺跟剛剛的狗或人影",
          "sc": "不过感觉跟刚刚的狗或人影"
        },
        {
          "f_idx": 8,
          "pidx_tc": 332243,
          "spk": "驹子 (コマコ)",
          "ja": "何か違う気がする……！",
          "tc": "好像不太一樣……！",
          "sc": "好像不太一样……！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 332250,
          "spk": "驹子 (コマコ)",
          "ja": "胸が苦しくならないし……",
          "tc": "胸口也不會覺得悶……",
          "sc": "胸口也不会觉得闷……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 332263,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあもう、怖くないね！",
          "tc": "那就沒什麼好怕的了！",
          "sc": "那就没什么好怕的了！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 332270,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>、影を照らすのは任せて！",
          "tc": "<player>，我會負責照亮影子！",
          "sc": "<player>，我会负责照亮影子！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 332277,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、アンタはあの影を……！",
          "tc": "你就把那個影子給……！",
          "sc": "你就把那个影子给……！"
        }
      ]
    },
