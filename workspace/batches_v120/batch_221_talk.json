      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331543,
          "spk": "驹子 (コマコ)",
          "ja": "な、なんだか霧が深くなってきたね……",
          "tc": "霧、霧氣好像越來越濃了呢……",
          "sc": "雾、雾气好像越来越浓了呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 331556,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、山の天気は変わりやすいらしいから",
          "tc": "聽說山裡的天氣本來就變化得快，",
          "sc": "听说山里的天气本来就变化得快，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 331563,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんくらい普通っしょ？",
          "tc": "這種程度還算正常吧？",
          "sc": "这种程度还算正常吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 331583,
          "spk": "驹子 (コマコ)",
          "ja": "で、でも……こんなに",
          "tc": "可、可是……正常來說，",
          "sc": "可、可是……正常来说，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 331590,
          "spk": "驹子 (コマコ)",
          "ja": "空気が重いのは、普通じゃないよ",
          "tc": "空氣不會變得這麼沉重啊。",
          "sc": "空气不会变得这么沉重啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 331603,
          "spk": "茶梅 (サザンカ)",
          "ja": "そおなの？",
          "tc": "是嗎？",
          "sc": "是吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 331610,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、もっと霧が濃くなる前に",
