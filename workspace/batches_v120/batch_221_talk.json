        },
        {
          "f_idx": 1,
          "pidx_tc": 330016,
          "spk": "茶梅 (サザンカ)",
          "ja": "本物だって証明する日が来るなんて……",
          "tc": "可以證明爺爺的話和我的發明都貨真價實……",
          "sc": "可以证明爷爷的话和我的发明都货真价实……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330034,
          "spk": "茶梅 (サザンカ)",
          "ja": "さあ、気合入れて",
          "tc": "好，我們打起精神，",
          "sc": "好，我们打起精神，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330041,
          "spk": "茶梅 (サザンカ)",
          "ja": "どんどん進も！",
          "tc": "繼續前進吧！",
          "sc": "继续前进吧！"
        }
      ]
    },
