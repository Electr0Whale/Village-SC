        {
          "f_idx": 15,
          "pidx_tc": 331157,
          "spk": "茶梅 (サザンカ)",
          "ja": "……ていうかさ",
          "tc": "……應該說，",
          "sc": "……应该说，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 331164,
          "spk": "茶梅 (サザンカ)",
          "ja": "言ってなかったけど",
          "tc": "雖然我沒跟妳說過，",
          "sc": "虽然我没跟你说过，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 331171,
          "spk": "茶梅 (サザンカ)",
