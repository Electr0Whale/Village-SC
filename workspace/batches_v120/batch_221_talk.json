        },
        {
          "f_idx": 1,
          "pidx_tc": 330931,
          "spk": "驹子 (コマコ)",
          "ja": "うまく光が当たらないよ……",
          "tc": "光一直照不到……",
          "sc": "光一直照不到……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 330940,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさん、この機械の光",
          "tc": "茶梅姐，",
          "sc": "茶梅姐，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330947,
          "spk": "驹子 (コマコ)",
          "ja": "どうしたら強くなるの……？",
          "tc": "要怎麼把機器的光線開得更強……？",
          "sc": "要怎么把机器的光线开得更强……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330960,
          "spk": "茶梅 (サザンカ)",
          "ja": "もうマシンは出力マックスだって……！！",
          "tc": "現在已經開到最大了啦……！！",
          "sc": "现在已经开到最大了啦……！！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330967,
          "spk": "茶梅 (サザンカ)",
          "ja": "草が邪魔なら刈ってよね！！",
          "tc": "草很礙事的話，就把草割掉吧！！",
          "sc": "草很碍事的话，就把草割掉吧！！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 330980,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、聞こえてた？",
          "tc": "<player>，你有聽到吧？",
          "sc": "<player>，你听见了吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 330987,
          "spk": "驹子 (コマコ)",
          "ja": "草を刈ってくれたら",
          "tc": "等你割掉草，",
          "sc": "等你割掉草，"
