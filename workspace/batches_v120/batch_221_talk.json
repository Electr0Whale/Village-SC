          "tc": "我就來找人影！",
          "sc": "我就来找人影！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5694,
      "rec_id": "TALK_ID_10_0503_340_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 331022,
          "spk": "茶梅 (サザンカ)",
          "ja": "父ちゃん……",
          "tc": "爸爸……",
          "sc": "爸爸……"
