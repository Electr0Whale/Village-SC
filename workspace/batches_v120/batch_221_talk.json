    },
    {
      "file": "talk.dat",
      "rec_idx": 5713,
      "rec_id": "TALK_ID_10_0503_344_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 332127,
          "spk": "茶梅 (サザンカ)",
          "ja": "あ……あれ……何も映らない……？",
          "tc": "奇……奇怪……什麼都沒有……？",
          "sc": "奇……奇怪……什么都没有……？"
        },
