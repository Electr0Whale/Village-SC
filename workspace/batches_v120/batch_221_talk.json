          "spk": "茶梅 (サザンカ)",
          "ja": "ちょっと待って……",
          "tc": "等等……",
          "sc": "等等……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 331969,
          "spk": "茶梅 (サザンカ)",
          "ja": "もう少しだけ探させて……",
          "tc": "再讓我找一下……",
          "sc": "再让我找一下……"
        }
      ]
    },
    {
