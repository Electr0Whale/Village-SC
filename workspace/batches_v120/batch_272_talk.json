      "rec_id": "TALK_ID_70_2130_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443951,
          "spk": "堇怜 (スミレ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443958,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、よかったらさ",
          "tc": "<player>，不介意的話，",
          "sc": "<player>，不介意的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443965,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が覚えたこと、聞いてくれない？",
          "tc": "你要聽聽我學會的東西嗎？",
          "sc": "你要听听我学会的东西吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443976,
          "spk": "堇怜 (スミレ)",
          "ja": "誰かに話すと、",
          "tc": "感覺只要告訴別人，",
          "sc": "感觉只要告诉别人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443983,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと自分のものになる気がするんだ！",
          "tc": "就會確實消化成自己的知識！",
          "sc": "就会确实消化成自己的知识！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7746,
      "rec_id": "TALK_ID_70_2130_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444007,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、ここ",
          "tc": "你看，就是這裡。",
          "sc": "你看，就是这里。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444014,
          "spk": "堇怜 (スミレ)",
          "ja": "一緒に見てよ！",
          "tc": "一起看看吧！",
          "sc": "一起看看吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7747,
      "rec_id": "TALK_ID_70_2130_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444032,
          "spk": "堇怜 (スミレ)",
          "ja": "僕はまだ、あんまり勉強は得意じゃないけど、",
          "tc": "雖然我並不是很會念書……",
          "sc": "虽然我并不是很会念书……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444039,
          "spk": "堇怜 (スミレ)",
          "ja": "でもね……",
          "tc": "但是啊……",
          "sc": "但是啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444046,
          "spk": "堇怜 (スミレ)",
          "ja": "少しずつ分かっていくのが、楽しいんだ",
          "tc": "一點一滴地慢慢學會，是一件很有樂趣的事。",
          "sc": "一点一滴地慢慢学会，是一件很有乐趣的事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444057,
          "spk": "堇怜 (スミレ)",
          "ja": "……こういう時間、嫌いじゃないんだ",
          "tc": "……我滿喜歡這樣時間。",
          "sc": "……我满喜欢这样时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7748,
      "rec_id": "TALK_ID_70_2130_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444088,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、もうこんな時間か……",
          "tc": "啊，已經這麼晚了……",
          "sc": "啊，已经这么晚了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444095,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ寝ようか",
          "tc": "差不多該睡了。",
          "sc": "差不多该睡了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444106,
          "spk": "堇怜 (スミレ)",
          "ja": "付き合ってくれて、ありがとう",
          "tc": "謝謝你陪我。",
          "sc": "谢谢你陪我。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444113,
          "spk": "堇怜 (スミレ)",
          "ja": "遊びに来たはずなのに、",
          "tc": "你明明是來玩的，",
          "sc": "你明明是来玩的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444120,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強に付き合わせちゃったね",
          "tc": "我卻讓你陪我念書了。",
          "sc": "我却让你陪我念书了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444131,
          "spk": "堇怜 (スミレ)",
          "ja": "ところで、寝る場所なんだけど……",
          "tc": "話說回來，睡覺的地方……",
          "sc": "话说回来，睡觉的地方……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444138,
          "spk": "堇怜 (スミレ)",
          "ja": "僕のベッドでもいいかな？",
          "tc": "可以在我的床上嗎？",
          "sc": "可以在我的床上吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7749,
      "rec_id": "TALK_ID_70_2130_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444156,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんのお下がりでさ……",
          "tc": "這以前是姊姊的床……",
          "sc": "这以前是姐姐的床……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444163,
          "spk": "堇怜 (スミレ)",
          "ja": "二人で使うと、ちょっと軋むかもしれないけど",
          "tc": "睡兩個人的話，可能會有點不穩，",
          "sc": "睡两个人的话，可能会有点不稳，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7750,
      "rec_id": "TALK_ID_70_2130_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444188,
          "spk": "堇怜 (スミレ)",
          "ja": "朝になって壊れてたら、",
          "tc": "如果明天早上醒來發現床垮了，",
          "sc": "如果明天早上醒来发现床垮了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444195,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがに笑うしかないよね",
          "tc": "真的會很好笑呢。",
          "sc": "真的会很好笑呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444206,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、遠慮しないで！",
          "tc": "來，別客氣！",
          "sc": "来，别客气！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444213,
          "spk": "堇怜 (スミレ)",
          "ja": "ベッドに入りなよ！",
          "tc": "躺上床睡覺吧！",
          "sc": "躺上床睡觉吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7751,
      "rec_id": "TALK_ID_70_2130_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444233,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444240,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、まだ起きてる？",
          "tc": "<player>，你還醒著嗎？",
          "sc": "<player>，你还醒着吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7752,
      "rec_id": "TALK_ID_70_2130_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444256,
          "spk": "堇怜 (スミレ)",
          "ja": "寝る前に勉強したせいかな",
          "tc": "可能是因為睡前念了書，",
          "sc": "可能是因为睡前念了书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444263,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだか頭が冴えちゃってて……",
          "tc": "總覺得頭腦很清醒……",
          "sc": "总觉得头脑很清醒……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444279,
          "spk": "堇怜 (スミレ)",
          "ja": "すこしだけ付き合ってほしいんだ",
          "tc": "希望你可以聽我說幾句話。",
          "sc": "希望你可以听我说几句话。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7753,
      "rec_id": "TALK_ID_70_2130_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444295,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>とゆっくり話せる時が",
          "tc": "有件事我一直想趁能和<player>",
          "sc": "有件事我一直想趁能和<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444302,
          "spk": "堇怜 (スミレ)",
          "ja": "来たら話そうと思ってたことがあってさ",
          "tc": "好好聊一聊的時候對你說。",
          "sc": "好好聊一聊的时候对你说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444311,
          "spk": "堇怜 (スミレ)",
          "ja": "僕と姉さん……それと、チナナさんを",
          "tc": "不論是我和姊姊……還是琪娜娜姐，",
          "sc": "不论是我和姐姐……还是琪娜娜姐，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444318,
          "spk": "堇怜 (スミレ)",
          "ja": "助けてくれてありがとう",
          "tc": "謝謝你幫了我們。",
          "sc": "谢谢你帮了我们。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444327,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>がいなかったら",
          "tc": "要是沒有<player>，",
          "sc": "要是没有<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444334,
          "spk": "堇怜 (スミレ)",
          "ja": "僕たち、すれ違い続けてたと思う",
          "tc": "我們之間大概會一直錯過彼此。",
          "sc": "我们之间大概会一直错过彼此。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444343,
          "spk": "堇怜 (スミレ)",
          "ja": "……姉さんとチナナさんは",
          "tc": "……姊姊和琪娜娜姐的身心，",
          "sc": "……姐姐和琪娜娜姐的身心，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 444350,
          "spk": "堇怜 (スミレ)",
          "ja": "心も身体も傷つけ続けてたはずだ",
          "tc": "恐怕都會一直受傷下去。",
          "sc": "恐怕都会一直受伤下去。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 444366,
          "spk": "堇怜 (スミレ)",
          "ja": "自分がどれだけ浅いところしか",
          "tc": "對於自己看事情的眼光",
          "sc": "对于自己看事情的眼光"
        },
        {
          "f_idx": 10,
          "pidx_tc": 444373,
          "spk": "堇怜 (スミレ)",
          "ja": "見られてなかったか",
          "tc": "究竟有多麼膚淺，",
          "sc": "究竟有多么肤浅，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 444380,
          "spk": "堇怜 (スミレ)",
          "ja": "身に染みてわかったんだ……",
          "tc": "我算是深刻體會到了……",
          "sc": "我算是深刻体会到了……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 444389,
          "spk": "堇怜 (スミレ)",
          "ja": "だからこれからは……",
          "tc": "所以從今以後……",
          "sc": "所以从今以后……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 444396,
          "spk": "堇怜 (スミレ)",
          "ja": "物事をもっと深いところまで",
          "tc": "我想變得能夠",
          "sc": "我想变得能够"
        },
        {
          "f_idx": 14,
          "pidx_tc": 444403,
          "spk": "堇怜 (スミレ)",
          "ja": "見られるようになりたいんだ",
          "tc": "更加看清事物的本質。",
          "sc": "更加看清事物的本质。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7754,
      "rec_id": "TALK_ID_70_2130_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444419,
          "spk": "堇怜 (スミレ)",
          "ja": "この先、大学進学のために",
          "tc": "以後我為了念大學，",
          "sc": "以后我为了念大学，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444426,
          "spk": "堇怜 (スミレ)",
          "ja": "村を出ることになるかもしれない……",
          "tc": "也許必須離開村子……",
          "sc": "也许必须离开村子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444435,
          "spk": "堇怜 (スミレ)",
          "ja": "でも必ず戻ってくるよ",
          "tc": "但我一定會回來的。",
          "sc": "但我一定会回来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444444,
          "spk": "堇怜 (スミレ)",
          "ja": "少しの間、<player>と",
          "tc": "雖然會和<player>",
          "sc": "虽然会和<player>"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444451,
          "spk": "堇怜 (スミレ)",
          "ja": "離れ離れになるけど",
          "tc": "分開一段時間……",
          "sc": "分开一段时间……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444458,
          "spk": "堇怜 (スミレ)",
          "ja": "待っててくれる？",
          "tc": "你願意等我嗎？",
          "sc": "你愿意等我吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444467,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 7,
          "pidx_tc": 444474,
          "spk": "主角心声/旁白/选项",
          "ja": "わからない",
          "tc": "不知道",
          "sc": "不知道"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7755,
      "rec_id": "TALK_ID_70_2130_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444568,
          "spk": "堇怜 (スミレ)",
          "ja": "これからもよろしく、<player>",
          "tc": "今後也請多多指教，<player>。",
          "sc": "今后也请多多指教，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7756,
      "rec_id": "TALK_ID_70_2130_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444584,
          "spk": "堇怜 (スミレ)",
          "ja": "ふわぁ～……",
          "tc": "呼啊……",
          "sc": "呼啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444593,
          "spk": "堇怜 (スミレ)",
          "ja": "話に付き合ってくれてありがとう",
          "tc": "謝謝你陪我聊天。",
          "sc": "谢谢你陪我聊天。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444600,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、おやすみ",
          "tc": "那麼，晚安。",
          "sc": "那么，晚安。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7757,
      "rec_id": "TALK_ID_70_2130_010_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444620,
          "spk": "堇怜 (スミレ)",
          "ja": "昨日は伝えたいことを",
          "tc": "昨天能把想說的話告訴給你，",
          "sc": "昨天能把想说的话告诉给你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444627,
          "spk": "堇怜 (スミレ)",
          "ja": "伝えられてよかった",
          "tc": "真的太好了。",
          "sc": "真的太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444638,
          "spk": "堇怜 (スミレ)",
          "ja": "これからも<player>とは",
          "tc": "從今以後我也想和<player>",
          "sc": "从今以后我也想和<player>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444645,
          "spk": "堇怜 (スミレ)",
          "ja": "いい友達でいたいな",
          "tc": "繼續當好朋友。",
          "sc": "继续当好朋友。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444656,
          "spk": "堇怜 (スミレ)",
          "ja": "また、うちに泊まりにきてよ",
          "tc": "改天再來我家過夜吧。",
          "sc": "改天再来我家过夜吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444663,
          "spk": "堇怜 (スミレ)",
          "ja": "約束だぜ！",
          "tc": "約好囉！",
          "sc": "约好啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7758,
      "rec_id": "TALK_ID_70_2140_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417370,
          "spk": "莲实 (ハスミ)",
          "ja": "あら？",
          "tc": "哎呀？",
          "sc": "哎呀？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417377,
          "spk": "莲实 (ハスミ)",
          "ja": "二人とも、今日は一緒なんですね",
          "tc": "兩位今天一起出現呢。",
          "sc": "两位今天一起出现呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417392,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……そうだな",
          "tc": "嗯……這個嘛。",
          "sc": "嗯……这个嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417405,
          "spk": "驹子 (コマコ)",
          "ja": "私が使っていた机が壊れちゃって……",
          "tc": "我一直使用的桌子壞了……",
          "sc": "我一直使用的桌子坏了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 417412,
          "spk": "驹子 (コマコ)",
          "ja": "新しい机を買うために、",
          "tc": "為了去買新的桌子，",
          "sc": "为了去买新的桌子，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 417419,
          "spk": "驹子 (コマコ)",
          "ja": "一緒についてきてくれたの",
          "tc": "他就陪我一起來了。",
          "sc": "他就陪我一起来了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 417430,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコ一人だと、",
