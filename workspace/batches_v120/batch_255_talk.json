          "tc": "想請你幫忙消滅",
          "sc": "想请你帮忙消灭"
        },
        {
          "f_idx": 2,
          "pidx_tc": 430954,
          "spk": "茶梅 (サザンカ)",
          "ja": "手伝ってほしくて……",
