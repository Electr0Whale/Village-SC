  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7174,
      "rec_id": "TALK_ID_70_2070_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429290,
          "spk": "木助 (キスケ)",
          "ja": "おい！　ものすげぇ音聞こえたけど、",
          "tc": "喂！我聽到好大的聲音，",
          "sc": "喂！我听到好大的声音，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429297,
          "spk": "木助 (キスケ)",
          "ja": "なんかあったのか！？",
          "tc": "出了什麼事嗎！？",
          "sc": "出了什么事吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429312,
          "spk": "茶梅 (サザンカ)",
          "ja": "ゲっ、キスケさん……",
          "tc": "……啊，是木助哥……",
          "sc": "……啊，是木助哥……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429319,
          "spk": "茶梅 (サザンカ)",
          "ja": "な、なんでもないよ……",
          "tc": "沒、沒事……",
          "sc": "没、没事……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 429326,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょっと発明品が爆発しただけだし",
          "tc": "只是新的發明爆炸了而已。",
          "sc": "只是新的发明爆炸了而已。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 429339,
          "spk": "木助 (キスケ)",
          "ja": "おいおい、また面白そうな……",
          "tc": "喂喂，妳別老是做些有趣……",
          "sc": "喂喂，你别老是做些有趣……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 429346,
          "spk": "木助 (キスケ)",
          "ja": "いや、危ねぇことしやがって",
          "tc": "不對，別老是做些危險的事啦。",
          "sc": "不对，别老是做些危险的事啦。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 429357,
          "spk": "木助 (キスケ)",
          "ja": "今回は部屋が散らかっただけで済んだから",
          "tc": "好險這次只有房間的東西",
          "sc": "好险这次只有房间的东西"
        },
        {
          "f_idx": 8,
          "pidx_tc": 429364,
          "spk": "木助 (キスケ)",
          "ja": "よかったものの……",
          "tc": "被炸得亂七八糟……",
          "sc": "被炸得乱七八糟……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 429375,
          "spk": "木助 (キスケ)",
          "ja": "今までが今までだ",
          "tc": "但難保下次不會出事。",
          "sc": "但难保下次不会出事。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 429382,
          "spk": "木助 (キスケ)",
          "ja": "そのうち本当に発明を禁止されるぜ？",
          "tc": "搞不好哪天真的被禁止發明喔！",
          "sc": "说不定哪天真的被禁止发明啊！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 429402,
          "spk": "茶梅 (サザンカ)",
          "ja": "わかってる",
          "tc": "這我知道。",
          "sc": "这我知道。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 429409,
          "spk": "茶梅 (サザンカ)",
          "ja": "けど、部屋は元からこんな感じだしィ",
          "tc": "可是我的房間本來就長這樣。",
          "sc": "可是我的房间本来就长这样。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 429422,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ、掃除しろよ……",
          "tc": "妳啊，還是打掃一下吧……",
          "sc": "你啊，还是打扫一下吧……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 429435,
          "spk": "茶梅 (サザンカ)",
          "ja": "はぁ？　アンタに言われたくないんだけど",
          "tc": "啊？我才不想被你這樣說。",
          "sc": "啊？我才不想被你这样说。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 429442,
          "spk": "茶梅 (サザンカ)",
          "ja": "つか、これは機能的な配置にしてるだけで",
          "tc": "再說了，這是以機能性為考量的布置，",
          "sc": "再说了，这是以机能性为考量的布置，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 429449,
          "spk": "茶梅 (サザンカ)",
          "ja": "散らかってるんじゃないんですけど",
          "tc": "才沒有很亂好嗎！",
          "sc": "才没有很乱好吗！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 429462,
          "spk": "木助 (キスケ)",
          "ja": "へいへい……",
          "tc": "好好好……",
          "sc": "好好好……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 429469,
          "spk": "木助 (キスケ)",
          "ja": "とにかく、気をつけろよ",
          "tc": "總之妳注意點吧。",
          "sc": "总之你注意点吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7175,
      "rec_id": "TALK_ID_70_2070_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429495,
          "spk": "茶梅 (サザンカ)",
          "ja": "う～ん……上手くいくと思ったんだけど……",
          "tc": "唔～嗯……我還以為會成功的說……",
          "sc": "唔～嗯……我还以为会成功的说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429502,
          "spk": "茶梅 (サザンカ)",
          "ja": "また一から作り直しか～",
          "tc": "再從頭來過吧～",
          "sc": "再从头来过吧～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429513,
          "spk": "茶梅 (サザンカ)",
          "ja": "ふふっ……",
          "tc": "呵呵……",
          "sc": "呵呵……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7176,
      "rec_id": "TALK_ID_70_2070_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429531,
          "spk": "茶梅 (サザンカ)",
          "ja": "失敗したのに楽しそうなのが意外？",
          "tc": "你很意外我明明失敗了看起來卻很開心？",
          "sc": "你很意外我明明失败了看起来却很开心？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429538,
          "spk": "茶梅 (サザンカ)",
          "ja": "まぁ、他人からすりゃそうかもね",
          "tc": "也是啦，在旁人看來或許是失敗了，",
          "sc": "也是啦，在旁人看来或许是失败了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429549,
          "spk": "茶梅 (サザンカ)",
          "ja": "けどさ、次にこいつが完成した時は",
          "tc": "但等下次完成的時候，",
          "sc": "但等下次完成的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429556,
          "spk": "茶梅 (サザンカ)",
          "ja": "もっともっといいものになってるんだよ？",
          "tc": "也許能做出更棒的東西喔！",
          "sc": "也许能做出更棒的东西哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 429567,
          "spk": "茶梅 (サザンカ)",
          "ja": "そう考えたらわくわくしない？",
          "tc": "這樣一想不覺得很令人興奮嗎？",
          "sc": "这样一想不觉得很令人兴奋吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7177,
      "rec_id": "TALK_ID_70_2070_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429585,
          "spk": "茶梅 (サザンカ)",
          "ja": "とりあえず、色々と検証したいから……",
          "tc": "總之，我還想做各種測試……",
          "sc": "总之，我还想做各种测试……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429603,
          "spk": "茶梅 (サザンカ)",
          "ja": "せっかく来てくれて悪いんだけど、",
          "tc": "雖然你難得來一趟，",
          "sc": "虽然你难得来一趟，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429610,
          "spk": "茶梅 (サザンカ)",
          "ja": "今日はこれでお開きってことで",
          "tc": "抱歉今天就先解散吧。",
          "sc": "抱歉今天就先解散吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7178,
      "rec_id": "TALK_ID_70_2070_004_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429628,
          "spk": "茶梅 (サザンカ)",
          "ja": "またね",
          "tc": "下次見囉。",
          "sc": "下次见啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7179,
      "rec_id": "TALK_ID_70_2070_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429652,
          "spk": "茶梅 (サザンカ)",
          "ja": "この商品はここで……",
          "tc": "這個商品放這……",
          "sc": "这个商品放这……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429659,
          "spk": "茶梅 (サザンカ)",
          "ja": "こっちの商品はあっちに……",
          "tc": "這個商品放那……",
          "sc": "这个商品放那……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7180,
      "rec_id": "TALK_ID_70_2070_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429677,
          "spk": "茶梅 (サザンカ)",
          "ja": "お、来た来た",
          "tc": "哦，你來啦！",
          "sc": "哦，你来啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429684,
          "spk": "茶梅 (サザンカ)",
          "ja": "いらっしゃい、待ってたよ～",
          "tc": "歡迎，等你好久了～",
          "sc": "欢迎，等你好久了～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7181,
      "rec_id": "TALK_ID_70_2070_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429702,
          "spk": "茶梅 (サザンカ)",
          "ja": "ふふ、新しい商品の陳列してたんだ",
          "tc": "呵呵，我正在上架新商品。",
          "sc": "呵呵，我正在上架新商品。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429709,
          "spk": "茶梅 (サザンカ)",
          "ja": "ここにあるのは全部アタシのおススメ",
          "tc": "這裡擺的都是我的強打商品。",
          "sc": "这里摆的都是我的强打商品。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7182,
      "rec_id": "TALK_ID_70_2070_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429727,
          "spk": "茶梅 (サザンカ)",
          "ja": "そこのコスメは安いのに",
          "tc": "那個彩妝雖然便宜，",
          "sc": "那个彩妆虽然便宜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429734,
          "spk": "茶梅 (サザンカ)",
          "ja": "可愛い色多くて使い易いし",
          "tc": "但有很多可愛的顏色非常實用，",
          "sc": "但有很多可爱的颜色非常实用，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429752,
          "spk": "茶梅 (サザンカ)",
          "ja": "そっちに置いてあるのは",
          "tc": "而那裡擺的，",
          "sc": "而那里摆的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 429759,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの好きなバンドのCDでさ～",
          "tc": "則是我喜歡的樂團出的CD～",
          "sc": "则是我喜欢的乐团出的CD～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 429766,
          "spk": "茶梅 (サザンカ)",
          "ja": "とにかくめっちゃカッコいいんだよ",
          "tc": "總之真的帥到不行啊。",
          "sc": "总之真的帅到不行啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7183,
      "rec_id": "TALK_ID_70_2070_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429784,
          "spk": "茶梅 (サザンカ)",
          "ja": "それに極めつけはこれ",
          "tc": "再來最推薦的是這個，",
          "sc": "再来最推荐的是这个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429791,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの愛読書、ロボット工学の入門書",
          "tc": "我很愛讀的機器人工學入門書。",
          "sc": "我很爱读的机器人工学入门书。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429802,
          "spk": "茶梅 (サザンカ)",
          "ja": "これね～、マジわかりやすくってさ～",
          "tc": "我跟你說～這本真的超好懂～",
          "sc": "我跟你说～这本真的超好懂～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429809,
          "spk": "茶梅 (サザンカ)",
          "ja": "知識ゼロの状態からでも",
          "tc": "即使沒有任何相關知識",
          "sc": "即使没有任何相关知识"
        },
        {
          "f_idx": 4,
          "pidx_tc": 429816,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちゃんと内容理解できるようになってんだよね",
          "tc": "也能理解裡面寫的內容呢。",
          "sc": "也能理解里面写的内容呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7184,
      "rec_id": "TALK_ID_70_2070_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 429834,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんで急にこんなものを置きだしたか、",
          "tc": "你是不是想問，",
          "sc": "你是不是想问，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 429841,
          "spk": "茶梅 (サザンカ)",
          "ja": "気になっちゃう感じ？",
          "tc": "我怎麼突然擺出這種東西？",
          "sc": "我怎么突然摆出这种东西？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 429852,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、単刀直入に言っちゃえば、",
          "tc": "說得直白點，",
          "sc": "说得直白点，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 429859,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの好きを共有するためかな",
          "tc": "算是為了分享我喜歡的東西吧。",
          "sc": "算是为了分享我喜欢的东西吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 429870,
          "spk": "茶梅 (サザンカ)",
          "ja": "それに興味持ってもらえれば",
          "tc": "只要有人感興趣，",
          "sc": "只要有人感兴趣，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 429877,
          "spk": "茶梅 (サザンカ)",
          "ja": "共通の話題で盛り上がったりできるじゃん？",
          "tc": "有了共同的話題也比較好聊起來吧？",
          "sc": "有了共同的话题也比较好聊起来吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 429895,
          "spk": "茶梅 (サザンカ)",
          "ja": "そしたらさ、少しは普段感じてる退屈さも",
          "tc": "這麼一來，也許就能讓日常",
          "sc": "这么一来，也许就能让日常"
        },
        {
          "f_idx": 8,
          "pidx_tc": 429902,
          "spk": "茶梅 (サザンカ)",
          "ja": "和らいだりしたりするのかな～って",
          "tc": "過得沒那麼無聊吧～",
          "sc": "过得没那么无聊吧～"
        },
        {
          "f_idx": 9,
          "pidx_tc": 429913,
          "spk": "茶梅 (サザンカ)",
          "ja": "最近、アンタと一緒に過ごすうちに",
          "tc": "最近和你一起相處之後，",
          "sc": "最近和你一起相处之后，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 429920,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんな風に思ったりしてさ",
          "tc": "我開始有這種想法了。",
          "sc": "我开始有这种想法了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 429931,
          "spk": "茶梅 (サザンカ)",
          "ja": "で、ベストなのは店によく来るアンタが",
          "tc": "要是常來店裡的你能對發明感興趣，",
          "sc": "要是常来店里的你能对发明感兴趣，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 429938,
          "spk": "茶梅 (サザンカ)",
          "ja": "発明に興味持ってくれることなんだけど……",
          "tc": "那當然是最好啦……",
          "sc": "那当然是最好啦……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 429949,
          "spk": "茶梅 (サザンカ)",
          "ja": "いきなりそれはハードル高いだろうから",
          "tc": "但再怎麼說也太強人所難了，",
          "sc": "但再怎么说也太强人所难了，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 429956,
          "spk": "茶梅 (サザンカ)",
          "ja": "まずはとっつきやすい音楽から",
          "tc": "首先就從門檻比較低的音樂",
          "sc": "首先就从门槛比较低的音乐"
        },
        {
          "f_idx": 15,
          "pidx_tc": 429963,
          "spk": "茶梅 (サザンカ)",
          "ja": "聴いてみたりしない？",
          "tc": "開始聽聽看吧？",
          "sc": "开始听听看吧？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 429974,
          "spk": "茶梅 (サザンカ)",
          "ja": "ほら、今日は特別にCDの",
          "tc": "你看，今天我特別準備了",
          "sc": "你看，今天我特别准备了"
        },
        {
          "f_idx": 17,
          "pidx_tc": 429981,
