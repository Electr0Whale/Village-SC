      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208879,
          "spk": "驹子 (コマコ)",
          "ja": "今、ヨウちゃんが走っていったけど……",
          "tc": "剛才小洋跑走了……",
          "sc": "刚才小洋跑走了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208886,
          "spk": "驹子 (コマコ)",
          "ja": "なにかあったの？",
          "tc": "是發生什麼事了嗎？",
          "sc": "是发生什么事了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208897,
          "spk": "驹子 (コマコ)",
          "ja": "どうしたんだろう……",
          "tc": "到底是怎麼了……",
          "sc": "到底是怎么了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208904,
          "spk": "驹子 (コマコ)",
          "ja": "危ない場所に行かなければいいけど……",
          "tc": "希望不是去危險的地方就好了……",
          "sc": "希望不是去危险的地方就好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3720,
      "rec_id": "TALK_ID_10_0102_034_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208929,
          "spk": "驹子 (コマコ)",
          "ja": "……まあ、大丈夫か",
          "tc": "……應該不會有問題吧……",
          "sc": "……应该不会有问题吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208936,
          "spk": "驹子 (コマコ)",
          "ja": "それより、いいところで会えたね、<player>",
          "tc": "話說回來，在這裡遇見你真巧，<player>。",
          "sc": "话说回来，在这里遇见你真巧，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208956,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうどキミを、呼びに行こうと思ってたの",
          "tc": "我正想要去叫你。",
          "sc": "我正想要去叫你。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208963,
          "spk": "驹子 (コマコ)",
          "ja": "よかったらロッカクさんの食堂で、",
          "tc": "不介意的話，我想找你",
          "sc": "不介意的话，我想找你"
        },
        {
          "f_idx": 5,
          "pidx_tc": 208970,
          "spk": "驹子 (コマコ)",
          "ja": "朝ご飯でもどうかなと思って……",
          "tc": "一起去六角叔的餐廳吃早餐……",
          "sc": "一起去六角叔的餐厅吃早餐……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 208983,
          "spk": "驹子 (コマコ)",
          "ja": "もちろん、私の奢りだよ",
          "tc": "當然是我請客！",
          "sc": "当然是我请客！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 208990,
          "spk": "驹子 (コマコ)",
          "ja": "どう……かな……？",
          "tc": "你覺得……怎麼樣……？",
          "sc": "你觉得……怎么样……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3721,
      "rec_id": "TALK_ID_10_0102_034_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209008,
          "spk": "驹子 (コマコ)",
          "ja": "よかった、来てくれるんだね！",
          "tc": "太好了，你願意一起來！",
          "sc": "太好了，你愿意一起来！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209015,
          "spk": "驹子 (コマコ)",
          "ja": "一緒にご飯、嬉しいな！",
          "tc": "真開心可以一起吃飯！",
          "sc": "真开心可以一起吃饭！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209028,
          "spk": "驹子 (コマコ)",
          "ja": "あ、でも、お兄ちゃんにお使いを頼まれていて、",
          "tc": "啊，不過哥哥拜託我幫他跑腿，",
          "sc": "啊，不过哥哥拜托我帮他跑腿，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 209035,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんの仕事場に、",
          "tc": "得把東西送去",
          "sc": "得把东西送去"
        },
        {
          "f_idx": 4,
          "pidx_tc": 209042,
          "spk": "驹子 (コマコ)",
          "ja": "お届け物をしに行かなきゃいけないの",
