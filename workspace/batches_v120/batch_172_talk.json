      "rec_id": "TALK_ID_10_0102_034_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208491,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>……",
          "tc": "啊，<player>……",
          "sc": "啊，<player>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3715,
      "rec_id": "TALK_ID_10_0102_034_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208513,
          "spk": "裕太 (ユータ)",
          "ja": "探さずにはいられないでしょ！",
          "tc": "肯定會忍不住去找吧！",
          "sc": "肯定会忍不住去找吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208520,
          "spk": "裕太 (ユータ)",
          "ja": "村の洞窟には、埋蔵金が眠ってるって",
          "tc": "村子的洞窟裡埋藏著地下寶藏，",
          "sc": "村子的洞窟里埋藏着地下宝藏，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208527,
          "spk": "裕太 (ユータ)",
          "ja": "サザンカが言ってたんだから！",
          "tc": "茶梅她就是這麼說的！",
          "sc": "茶梅她就是这么说的！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208540,
          "spk": "堇怜 (スミレ)",
          "ja": "いやそれ、絶対騙されてますよ",
          "tc": "但我覺得那一定是騙人的啦。",
          "sc": "但我觉得那一定是骗人的啦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 208558,
          "spk": "堇怜 (スミレ)",
          "ja": "そんなのがあったら、",
          "tc": "再說要是真有那種東西，",
          "sc": "再说要是真有那种东西，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 208565,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコやシロージさんがとっくに見つけてます",
          "tc": "那也早就被駒子還有四郎治哥發現了。",
          "sc": "那也早就被驹子还有四郎治哥发现了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 208578,
          "spk": "裕太 (ユータ)",
          "ja": "わからないじゃないか",
          "tc": "那可未必啊。",
          "sc": "那可未必啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 208585,
          "spk": "裕太 (ユータ)",
          "ja": "彼らだってちゃんと探したワケじゃないだろうし",
          "tc": "他們也不一定有認真找過吧。",
          "sc": "他们也不一定有认真找过吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 208603,
          "spk": "裕太 (ユータ)",
          "ja": "それに、スミレくんも",
          "tc": "況且，堇怜你也",
          "sc": "况且，堇怜你也"
        },
        {
          "f_idx": 11,
          "pidx_tc": 208610,
          "spk": "裕太 (ユータ)",
          "ja": "お金はほしいだろう？",
          "tc": "想要錢對吧？",
          "sc": "想要钱对吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 208623,
          "spk": "堇怜 (スミレ)",
          "ja": "そりゃほしいですけど、",
          "tc": "想要是想要啦，",
          "sc": "想要是想要啦，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 208630,
          "spk": "堇怜 (スミレ)",
          "ja": "見つからないなら価値はゼロですからね",
          "tc": "但找不到的話就是一場空啊。",
          "sc": "但找不到的话就是一场空啊。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 208641,
          "spk": "堇怜 (スミレ)",
          "ja": "ハァ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 208648,
          "spk": "堇怜 (スミレ)",
          "ja": "なんで僕まで付き合わされるんだろ……",
          "tc": "為什麼連我都得跟著一起去啊……",
          "sc": "为什么连我都得跟着一起去啊……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 208668,
          "spk": "裕太 (ユータ)",
          "ja": "山にある洞窟を探しにいくんだよ？",
          "tc": "這可是要去探索山裡的洞窟欸！",
          "sc": "这可是要去探索山里的洞窟诶！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 208675,
          "spk": "裕太 (ユータ)",
          "ja": "俺、一人だと迷っちゃうじゃないか",
          "tc": "我一個人的話會迷路的啊！",
          "sc": "我一个人的话会迷路的啊！"
        },
        {
          "f_idx": 20,
          "pidx_tc": 208695,
          "spk": "堇怜 (スミレ)",
          "ja": "そもそも、ユータさんは別にお金に",
          "tc": "說起來，裕太哥，",
          "sc": "说起来，裕太哥，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 208702,
          "spk": "堇怜 (スミレ)",
          "ja": "困ってないじゃないですか……",
          "tc": "你不是不怎麼愁錢嗎？",
          "sc": "你不是不怎么愁钱吗？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 208709,
          "spk": "堇怜 (スミレ)",
          "ja": "一体どうして埋蔵金なんか要るんです？",
          "tc": "為什麼會需要找什麼地下寶藏啊？",
          "sc": "为什么会需要找什么地下宝藏啊？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 208722,
          "spk": "裕太 (ユータ)",
          "ja": "わかってないね、埋蔵金の価値が！",
          "tc": "你太不上道了，不懂地下寶藏的價值嗎！？",
          "sc": "你太不上道了，不懂地下宝藏的价值吗！？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 208729,
          "spk": "裕太 (ユータ)",
          "ja": "お金じゃないんだよ！",
          "tc": "重點不在那值多少錢！",
          "sc": "重点不在那值多少钱！"
        },
        {
          "f_idx": 25,
          "pidx_tc": 208736,
          "spk": "裕太 (ユータ)",
          "ja": "語って欲しいかい？",
          "tc": "要我仔細講給你聽嗎？",
          "sc": "要我仔细讲给你听吗？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 208749,
          "spk": "堇怜 (スミレ)",
          "ja": "いらなーい",
          "tc": "不用了～",
          "sc": "不用了～"
        }
      ]
    },
    {
