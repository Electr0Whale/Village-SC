      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208353,
          "spk": "洋 (ヨウ)",
          "ja": "ねえ、<player>",
          "tc": "我說，<player>，",
          "sc": "我说，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208360,
          "spk": "洋 (ヨウ)",
          "ja": "動物と暮らしてるって、",
          "tc": "跟動物一起生活，",
          "sc": "跟动物一起生活，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208367,
          "spk": "洋 (ヨウ)",
          "ja": "どういうかんじなの？",
          "tc": "是什麼樣的感覺？",
          "sc": "是什么样的感觉？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208378,
          "spk": "洋 (ヨウ)",
          "ja": "いっしょに寝たら、",
          "tc": "如果可以一起睡的話，",
          "sc": "如果可以一起睡的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208385,
          "spk": "洋 (ヨウ)",
          "ja": "暖かくて、よく眠れるのかな……",
          "tc": "會不會暖暖的，更好睡呢……",
          "sc": "会不会暖暖的，更好睡呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 208396,
          "spk": "洋 (ヨウ)",
          "ja": "一人でも、寂しくないだろうな……",
          "tc": "那樣就算是一個人也不會寂寞了吧……",
          "sc": "那样就算是一个人也不会寂寞了吧……"
        }
      ]
    },
    {
