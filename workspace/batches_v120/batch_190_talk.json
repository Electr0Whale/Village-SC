    },
    {
      "file": "talk.dat",
      "rec_idx": 4516,
      "rec_id": "TALK_ID_10_0303_060_43",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259200,
          "spk": "林 (リン)",
          "ja": "さあ、みんな早く帰りなさい",
          "tc": "好了，大家都快點回家吧。",
          "sc": "好了，大家都快点回家吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259207,
          "spk": "林 (リン)",
          "ja": "掟を破ることは、村を危険に晒す……",
          "tc": "打破規矩會令村子陷入危險……",
          "sc": "打破规矩会令村子陷入危险……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259225,
          "spk": "林 (リン)",
          "ja": "今回は大事にならなくてよかったけど、",
          "tc": "幸好這次沒釀成大禍，",
          "sc": "幸好这次没酿成大祸，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259232,
          "spk": "林 (リン)",
          "ja": "贄の儀式が終わるまで、油断できないんだから",
          "tc": "但在祭品儀式完成之前，都不能掉以輕心。",
          "sc": "但在祭品仪式完成之前，都不能掉以轻心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4517,
      "rec_id": "TALK_ID_10_0303_061_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259263,
          "spk": "名护 (ナゴ)",
          "ja": "おお、俺の財布！！",
          "tc": "哦，是我的錢包！！",
          "sc": "哦，是我的钱包！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259274,
          "spk": "名护 (ナゴ)",
          "ja": "あんなに探しても見つからなかったのに……",
          "tc": "明明找了那麼久都沒找到……",
          "sc": "明明找了那么久都没找到……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259281,
          "spk": "名护 (ナゴ)",
          "ja": "一体、どうやって手に入れたんだい？",
          "tc": "你到底是怎麼找到它的？",
          "sc": "你到底是怎么找到它的？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4518,
      "rec_id": "TALK_ID_10_0303_061_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259299,
          "spk": "名护 (ナゴ)",
          "ja": "……どうした？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259306,
          "spk": "名护 (ナゴ)",
          "ja": "そんな浮かない顔をして……",
          "tc": "看起來不太開心的樣子……",
          "sc": "看起来不太开心的样子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259317,
          "spk": "名护 (ナゴ)",
          "ja": "何があったのかは、聞かないでおくよ",
          "tc": "我就不過問發生了什麼事。",
          "sc": "我就不过问发生了什么事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259324,
          "spk": "名护 (ナゴ)",
          "ja": "とりあえず、見つけ出してくれてありがとう",
          "tc": "總之謝謝你找到它。",
          "sc": "总之谢谢你找到它。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259342,
          "spk": "名护 (ナゴ)",
          "ja": "約束通り、中身の10万を……",
          "tc": "我就照著約定，裡面的十萬就……",
          "sc": "我就照着约定，里面的十万就……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 259353,
          "spk": "名护 (ナゴ)",
          "ja": "あれ……ないぞ！",
          "tc": "咦……沒有！？",
          "sc": "咦……没有！？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 259360,
          "spk": "名护 (ナゴ)",
          "ja": "どうして空っぽなんだ！！",
          "tc": "為什麼是空的！？",
          "sc": "为什么是空的！？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 259367,
          "spk": "名护 (ナゴ)",
          "ja": "ココの鈴までなくなってるだなんて……！",
          "tc": "連可可的鈴鐺也都不見了……！",
          "sc": "连可可的铃铛也都不见了……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4519,
      "rec_id": "TALK_ID_10_0303_061_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259385,
          "spk": "名护 (ナゴ)",
          "ja": "嘘だろ……こんなこと……！",
          "tc": "不會吧……怎麼會這樣……！",
          "sc": "不会吧……怎么会这样……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259396,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、財布に入っていた、",
          "tc": "<player>，你有看到",
          "sc": "<player>，你看见"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259403,
          "spk": "名护 (ナゴ)",
          "ja": "小さな鈴を知らないかい？",
          "tc": "本來放在錢包裡的小鈴鐺嗎？",
          "sc": "本来放在钱包里的小铃铛吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259410,
          "spk": "名护 (ナゴ)",
          "ja": "大事な大事なものなんだ……",
          "tc": "那是我非常重要、非常重要的東西……",
          "sc": "那是我非常重要、非常重要的东西……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259421,
          "spk": "名护 (ナゴ)",
          "ja": "俺は財布なんて、お金なんて、",
          "tc": "其實錢包本身或裡面的錢",
          "sc": "其实钱包本身或里面的钱"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259428,
          "spk": "名护 (ナゴ)",
          "ja": "どうでもよかったんだよ……",
          "tc": "對我來說都無所謂……",
          "sc": "对我来说都无所谓……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 259435,
          "spk": "名护 (ナゴ)",
          "ja": "鈴さえ取り戻せたら……",
          "tc": "只要能找回鈴鐺……",
          "sc": "只要能找回铃铛……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 259446,
          "spk": "名护 (ナゴ)",
          "ja": "すまない……",
          "tc": "抱歉……",
          "sc": "抱歉……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 259453,
          "spk": "名护 (ナゴ)",
          "ja": "せっかく取り戻してくれたのに、",
          "tc": "明明你好不容易幫我找回來了，",
          "sc": "明明你好不容易帮我找回来了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 259460,
          "spk": "名护 (ナゴ)",
          "ja": "喜んであげられなくて……",
          "tc": "我卻沒辦法高興……",
          "sc": "我却没办法高兴……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 259469,
          "spk": "名护 (ナゴ)",
          "ja": "もし、鈴を見つけたら……",
          "tc": "如果你能找到鈴鐺……",
          "sc": "如果你能找到铃铛……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 259476,
          "spk": "名护 (ナゴ)",
          "ja": "いや、もうやめよう",
          "tc": "不，還是算了吧。",
          "sc": "不，还是算了吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 259483,
          "spk": "名护 (ナゴ)",
          "ja": "キミに頼りすぎているからね……",
          "tc": "我太依賴你了……",
          "sc": "我太依赖你了……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 259494,
          "spk": "名护 (ナゴ)",
          "ja": "中身のお金も無くなっているから、",
          "tc": "因為裡面的錢也不見了，",
          "sc": "因为里面的钱也不见了，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 259501,
          "spk": "名护 (ナゴ)",
          "ja": "何か別のお礼をできるように準備するよ",
          "tc": "我會準備其他東西當作謝禮的。",
          "sc": "我会准备其他东西当作谢礼的。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 259519,
          "spk": "名护 (ナゴ)",
          "ja": "また、明日以降に、",
          "tc": "你明天之後",
          "sc": "你明天之后"
        },
        {
          "f_idx": 17,
          "pidx_tc": 259526,
          "spk": "名护 (ナゴ)",
          "ja": "図書館に来ておくれ",
          "tc": "再來一趟圖書館吧。",
          "sc": "再来一趟图书馆吧。"
        }
      ]
    },
    {
