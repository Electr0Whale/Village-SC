        },
        {
          "f_idx": 4,
          "pidx_tc": 259095,
          "spk": "林 (リン)",
          "ja": "だから何？",
          "tc": "那又如何？",
          "sc": "那又如何？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259102,
          "spk": "林 (リン)",
          "ja": "私もコマコも、もっと大切なものがあるの",
          "tc": "無論是我還是駒子，都有更重要的事物。",
          "sc": "无论是我还是驹子，都有更重要的事物。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 259109,
          "spk": "林 (リン)",
          "ja": "これは、村を守るために必要なことなのよ",
