      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259059,
          "spk": "帷 (トバリ)",
          "ja": "どうして……",
          "tc": "為什麼……",
          "sc": "为什么……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259068,
          "spk": "帷 (トバリ)",
          "ja": "どうしてこんなことするの……",
          "tc": "為什麼要做出這種事……",
          "sc": "为什么要做出这种事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259075,
          "spk": "帷 (トバリ)",
          "ja": "コダマは、話が通じる幽霊だったのよ……",
          "tc": "木珠是可以溝通的幽靈啊……",
