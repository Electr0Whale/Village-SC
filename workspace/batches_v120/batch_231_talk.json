          "ja": "神の荒ぶる業を鎮め給へ",
          "tc": "平息神之暴行，",
          "sc": "平息神之暴行，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 353548,
          "spk": "木助 (キスケ)",
          "ja": "かしこみ、かしこみ祈り奉る",
          "tc": "誠惶誠恐，謹此相求。",
          "sc": "诚惶诚恐，谨此相求。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353561,
          "spk": "木助 (キスケ)",
          "ja": "<player>ーーーッッ！！",
          "tc": "<player>───！！",
          "sc": "<player>——─！！"
