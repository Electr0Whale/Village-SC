          "tc": "從木珠身上拔出來了！",
          "sc": "从木珠身上拔出来了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353487,
          "spk": "木助 (キスケ)",
          "ja": "今そっちに寄越してやる！！",
          "tc": "現在就丟過去給你！！",
          "sc": "现在就丢过去给你！！"
        }
      ]
