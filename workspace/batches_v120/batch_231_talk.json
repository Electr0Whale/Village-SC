    {
      "file": "talk.dat",
      "rec_idx": 6117,
      "rec_id": "TALK_ID_10_0603_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355914,
          "spk": "木助 (キスケ)",
          "ja": "なんだよあの玉みてえなのは邪魔くせえ！",
          "tc": "那個跟球一樣的東西是什麼鬼，超礙事！",
          "sc": "那个跟球一样的东西是什么鬼，超碍事！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355921,
          "spk": "木助 (キスケ)",
          "ja": "このままじゃ追いつかれて……",
          "tc": "再這樣下去會被追上的……",
          "sc": "再这样下去会被追上的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355934,
          "spk": "木助 (キスケ)",
          "ja": "……あ、そうだ！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 355945,
          "spk": "木助 (キスケ)",
          "ja": "<player>、岩切りナタは",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 355952,
          "spk": "木助 (キスケ)",
          "ja": "幽霊すらも切っちまえるんだったよな",
          "tc": "劈岩柴刀就連幽靈都能砍對吧？",
          "sc": "劈岩柴刀就连幽灵都能砍对吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 355961,
          "spk": "木助 (キスケ)",
          "ja": "あの幽霊どもの集合体、",
          "tc": "那個幽靈們的集合體，",
          "sc": "那个幽灵们的集合体，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 355968,
          "spk": "木助 (キスケ)",
          "ja": "岩切りナタで切れやしねぇか？",
          "tc": "是不是也能用劈岩柴刀劈開？",
          "sc": "是不是也能用劈岩柴刀劈开？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 355979,
          "spk": "木助 (キスケ)",
          "ja": "俺は岩を何とかする！",
          "tc": "我會想辦法處理岩石！",
          "sc": "我会想办法处理岩石！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 355986,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはあの幽霊どもを頼んだぞ！",
          "tc": "那些幽靈就交給你了！",
          "sc": "那些幽灵就交给你了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6118,
      "rec_id": "TALK_ID_10_0603_020_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 356010,
          "spk": "木助 (キスケ)",
          "ja": "……クソッ！",
          "tc": "……可惡！",
          "sc": "……可恶！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 356017,
          "spk": "木助 (キスケ)",
          "ja": "コイツをどかすのは骨が折れそうだ……！",
          "tc": "要把這些樹根移開，看來得費一番功夫了……！",
          "sc": "要把这些树根移开，看来得费一番功夫了……！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 356028,
          "spk": "木助 (キスケ)",
          "ja": "おい、<player>！",
          "tc": "喂，<player>！",
          "sc": "喂，<player>！"
