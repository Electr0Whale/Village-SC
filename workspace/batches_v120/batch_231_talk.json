      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353699,
          "spk": "木珠 (コダマ)",
          "ja": "コダマだよ、神さま……",
          "tc": "我是木珠喔，神明大人……",
          "sc": "我是木珠哦，神明大人……"
