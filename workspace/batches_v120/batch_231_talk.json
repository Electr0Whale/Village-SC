          "ja": "戻ってあげて",
          "tc": "請祢回到那些人身邊吧。",
          "sc": "请你回到那些人身边吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 353852,
          "spk": "木珠 (コダマ)",
          "ja": "あの体は、やっぱり、",
          "tc": "那副身體，",
          "sc": "那副身体，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353859,
          "spk": "木珠 (コダマ)",
          "ja": "神さまにあげるから……",
          "tc": "我決定還是給神明大人了……",
          "sc": "我决定还是给神明大人了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 353868,
          "spk": "木珠 (コダマ)",
          "ja": "これが、コダマのさいごのお願い……",
          "tc": "這就是，木珠最後的願望……",
          "sc": "这就是，木珠最后的愿望……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 353877,
          "spk": "木珠 (コダマ)",
          "ja": "魂をささげて神さまを呼びにきちゃったから、",
          "tc": "我是獻上靈魂把神明大人呼喚來的，",
          "sc": "我是献上灵魂把神明大人呼唤来的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 353884,
          "spk": "木珠 (コダマ)",
          "ja": "もう捧げられるものは",
          "tc": "所以已經沒有可以供奉給祢的東西了，",
          "sc": "所以已经没有可以供奉给你的东西了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 353891,
          "spk": "木珠 (コダマ)",
          "ja": "なにも残っていないけれど……",
          "tc": "但是……",
          "sc": "但是……"
        }
      ]
    },
    {
