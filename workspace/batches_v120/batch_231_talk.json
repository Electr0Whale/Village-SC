    {
      "file": "talk.dat",
      "rec_idx": 6126,
      "rec_id": "TALK_ID_10_1000_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 356357,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、リンからお手伝い券を",
          "tc": "<player>，",
          "sc": "<player>，"
