        {
          "f_idx": 1,
          "pidx_tc": 353708,
          "spk": "木珠 (コダマ)",
          "ja": "ここまで……さがしにきたの……",
          "tc": "我一路找祢……找到了這裡……",
          "sc": "我一路找你……找到了这里……"
        }
