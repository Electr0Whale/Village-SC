      "rec_id": "TALK_ID_10_0602_065_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353724,
          "spk": "木珠 (コダマ)",
          "ja": "あの、ね",
          "tc": "那個啊。",
          "sc": "那个啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 353733,
          "spk": "木珠 (コダマ)",
          "ja": "土地神さま……を、",
          "tc": "謝謝祢……",
          "sc": "谢谢你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 353740,
          "spk": "木珠 (コダマ)",
          "ja": "倒してくれて、ありがとう……",
          "tc": "打倒了土地神大人……",
          "sc": "打倒了土地神大人……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353749,
          "spk": "木珠 (コダマ)",
          "ja": "あの村を……",
          "tc": "也謝謝祢……",
          "sc": "也谢谢你……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 353756,
          "spk": "木珠 (コダマ)",
          "ja": "たすけてくれて、ありがとう……",
          "tc": "拯救了那座村子……",
          "sc": "拯救了那座村子……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 353765,
          "spk": "木珠 (コダマ)",
          "ja": "約束、守ってくれて、嬉しい……",
          "tc": "我很高興祢有遵守約定……",
          "sc": "我很高兴你有遵守约定……"
        },
