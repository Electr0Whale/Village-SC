      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353836,
          "spk": "木珠 (コダマ)",
          "ja": "神さま、あの人たちのところに、",
          "tc": "神明大人，",
          "sc": "神明大人，"
