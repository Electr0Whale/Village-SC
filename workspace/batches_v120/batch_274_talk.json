  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7813,
      "rec_id": "TALK_ID_70_2140_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421400,
          "spk": "莲实 (ハスミ)",
          "ja": "お茶の渋みとアイスのあまーい味わいが",
          "tc": "茶的澀味和甜甜的冰淇淋完美契合……",
          "sc": "茶的涩味和甜甜的冰淇淋完美契合……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421407,
          "spk": "莲实 (ハスミ)",
          "ja": "みごとにマッチして……最高ですね",
          "tc": "真是太棒了。",
          "sc": "真是太棒了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421416,
          "spk": "莲实 (ハスミ)",
          "ja": "これ以上においしい食べ物なんて",
          "tc": "這世上應該找不到",
          "sc": "这世上应该找不到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421423,
          "spk": "莲实 (ハスミ)",
          "ja": "この世に存在しないんじゃないでしょうか？",
          "tc": "比這更好吃的東西了吧？",
          "sc": "比这更好吃的东西了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421434,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも知っての通り",
          "tc": "正如<player>也知道的，",
          "sc": "正如<player>也知道的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421441,
          "spk": "莲实 (ハスミ)",
          "ja": "私はかなりの大酒呑みですけど",
          "tc": "雖然我是個超級大酒鬼，",
          "sc": "虽然我是个超级大酒鬼，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421448,
          "spk": "莲实 (ハスミ)",
          "ja": "甘いものもやめられなくて……",
          "tc": "但也沒辦法戒掉甜點……",
          "sc": "但也没办法戒掉甜点……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421459,
          "spk": "莲实 (ハスミ)",
          "ja": "気づけば、アイスも",
          "tc": "注意到時，",
          "sc": "注意到时，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 421466,
          "spk": "莲实 (ハスミ)",
          "ja": "日常的に食べているのです",
          "tc": "連平常都在吃冰淇淋。",
          "sc": "连平常都在吃冰淇淋。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 421477,
          "spk": "莲实 (ハスミ)",
          "ja": "医学を志す身としては、",
          "tc": "身為以醫學為己願的人，",
          "sc": "身为以医学为己愿的人，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 421484,
          "spk": "莲实 (ハスミ)",
          "ja": "あまり胸を張れる話ではないんですけど……",
          "tc": "這實在不是可以理直氣壯地說出來的事……",
          "sc": "这实在不是可以理直气壮地说出来的事……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 421502,
          "spk": "莲实 (ハスミ)",
          "ja": "まあ、今は楽しい席ですし",
          "tc": "不過現在這麼愉快的場合",
          "sc": "不过现在这么愉快的场合"
        },
        {
          "f_idx": 13,
          "pidx_tc": 421509,
          "spk": "莲实 (ハスミ)",
          "ja": "笑って忘れることにしましょう",
          "tc": "就笑笑帶過吧。",
          "sc": "就笑笑带过吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 421520,
          "spk": "莲实 (ハスミ)",
          "ja": "アイスにもいろんな味がありますけど",
          "tc": "冰淇淋雖然有很多種口味，",
          "sc": "冰淇淋虽然有很多种口味，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 421527,
          "spk": "莲实 (ハスミ)",
          "ja": "私は断然お茶味ですね",
          "tc": "我還是最喜歡茶味的呢。",
          "sc": "我还是最喜欢茶味的呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 421538,
          "spk": "莲实 (ハスミ)",
          "ja": "どれだけ種類があっても",
          "tc": "不論種類有多豐富，",
          "sc": "不论种类有多丰富，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 421545,
          "spk": "莲实 (ハスミ)",
          "ja": "これしか選ぶことはありません",
          "tc": "這都是我的唯一選擇。",
          "sc": "这都是我的唯一选择。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 421556,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも",
          "tc": "<player>也有",
          "sc": "<player>也有"
        },
        {
          "f_idx": 19,
          "pidx_tc": 421563,
          "spk": "莲实 (ハスミ)",
          "ja": "こだわりのフレーバーはありますか？",
          "tc": "特別堅持的口味嗎？",
          "sc": "特别坚持的口味吗？"
        },
        {
          "f_idx": 20,
          "pidx_tc": 421572,
          "spk": "主角心声/旁白/选项",
          "ja": "ある",
          "tc": "會",
          "sc": "会"
        },
        {
          "f_idx": 21,
          "pidx_tc": 421579,
          "spk": "主角心声/旁白/选项",
          "ja": "ない",
          "tc": "不會",
          "sc": "不会"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7814,
      "rec_id": "TALK_ID_70_2140_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421690,
          "spk": "莲实 (ハスミ)",
          "ja": "アイスを食べ終わったら",
          "tc": "等你吃完冰淇淋之後，",
          "sc": "等你吃完冰淇淋之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421697,
          "spk": "莲实 (ハスミ)",
          "ja": "おっしゃってくださいね",
          "tc": "再跟我說一聲喔。",
          "sc": "再跟我说一声哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421708,
          "spk": "莲实 (ハスミ)",
          "ja": "ほうじ茶も、用意してありますから",
          "tc": "我還準備了焙茶。",
          "sc": "我还准备了焙茶。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421726,
          "spk": "莲实 (ハスミ)",
          "ja": "今日はとことん",
          "tc": "今天就盡情享受",
          "sc": "今天就尽情享受"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421733,
          "spk": "莲实 (ハスミ)",
          "ja": "お茶尽くしで、楽しみましょう",
          "tc": "各種茶的風味吧。",
          "sc": "各种茶的风味吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7815,
      "rec_id": "TALK_ID_70_2140_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421757,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、いいタイミングで",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421764,
          "spk": "莲实 (ハスミ)",
          "ja": "いらしてくれました",
          "tc": "你來得正是時候。",
          "sc": "你来得正是时候。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421773,
          "spk": "莲实 (ハスミ)",
          "ja": "ちょうど試作中の料理……",
          "tc": "我還在試作中的料理……",
          "sc": "我还在试作中的料理……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421780,
          "spk": "莲实 (ハスミ)",
          "ja": "「豆腐ハンバーグ」が",
          "tc": "「豆腐漢堡排」",
          "sc": "“豆腐汉堡排”"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421787,
          "spk": "莲实 (ハスミ)",
          "ja": "完成したところなんです",
          "tc": "剛好完成了。",
          "sc": "刚好完成了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421798,
          "spk": "莲实 (ハスミ)",
          "ja": "味の感想も聞かせてもらいたいですし",
          "tc": "我也想聽聽你對味道的感想，",
          "sc": "我也想听听你对味道的感想，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421805,
          "spk": "莲实 (ハスミ)",
          "ja": "すぐ食事にしましょう",
          "tc": "馬上來用餐吧。",
          "sc": "马上来用餐吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7816,
      "rec_id": "TALK_ID_70_2140_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421829,
          "spk": "莲实 (ハスミ)",
          "ja": "せっかくの食事会なのに",
          "tc": "真抱歉難得聚餐，",
          "sc": "真抱歉难得聚餐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421836,
          "spk": "莲实 (ハスミ)",
          "ja": "試作段階の料理でごめんなさい",
          "tc": "卻端出還在試作的料理。",
          "sc": "却端出还在试作的料理。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421847,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、どうしても",
          "tc": "可是我無論如何",
          "sc": "可是我无论如何"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421854,
          "spk": "莲实 (ハスミ)",
          "ja": "食べてもらいたくて……",
          "tc": "都想讓你嘗嘗……",
          "sc": "都想让你尝尝……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421863,
          "spk": "莲实 (ハスミ)",
          "ja": "これは、みんなの健康のことを考えて、",
          "tc": "這是以大家的健康為出發點，",
          "sc": "这是以大家的健康为出发点，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421870,
          "spk": "莲实 (ハスミ)",
          "ja": "私なりの新しい挑戦なんです",
          "tc": "屬於我的全新的挑戰。",
          "sc": "属于我的全新的挑战。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421881,
          "spk": "莲实 (ハスミ)",
          "ja": "健康的に、でもおいしい料理が作れないかと",
          "tc": "我每天都在不斷嘗試",
          "sc": "我每天都在不断尝试"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421888,
          "spk": "莲实 (ハスミ)",
          "ja": "日々試行錯誤しているんですよ",
          "tc": "想要做出健康又美味的料理。",
          "sc": "想要做出健康又美味的料理。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 421899,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬を調合するように",
          "tc": "雖然沒辦法像調配漢方藥那樣",
          "sc": "虽然没办法像调配汉方药那样"
        },
        {
          "f_idx": 9,
          "pidx_tc": 421906,
          "spk": "莲实 (ハスミ)",
          "ja": "すんなりとは成功しませんが……",
          "tc": "一下子就順利成功……",
          "sc": "一下子就顺利成功……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 421917,
          "spk": "莲实 (ハスミ)",
          "ja": "食事療法の面でも",
          "tc": "但我希望在食療方面",
          "sc": "但我希望在食疗方面"
        },
        {
          "f_idx": 11,
          "pidx_tc": 421924,
          "spk": "莲实 (ハスミ)",
          "ja": "みんなの力になりたいですから",
          "tc": "也能幫上大家的忙。",
          "sc": "也能帮上大家的忙。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 421942,
          "spk": "莲实 (ハスミ)",
          "ja": "この料理はおいしくできたはずですし",
          "tc": "加上這次的料理味道應該不錯，",
          "sc": "加上这次的料理味道应该不错，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 421949,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんにも喜んでいただける……",
          "tc": "還能讓<player>也感到開心……",
          "sc": "还能让<player>也感到开心……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 421960,
          "spk": "莲实 (ハスミ)",
          "ja": "そう思ってるんですけど、どうでしょう？",
          "tc": "雖然我是這麼想的，你覺得呢？",
          "sc": "虽然我是这么想的，你觉得呢？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 421967,
          "spk": "莲实 (ハスミ)",
          "ja": "料理の味の方は……？",
          "tc": "料理的味道如何……？",
          "sc": "料理的味道如何……？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 421976,
          "spk": "主角心声/旁白/选项",
          "ja": "おいしい！",
          "tc": "好吃！",
          "sc": "好吃！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 421983,
          "spk": "主角心声/旁白/选项",
          "ja": "あんまり！",
          "tc": "不是很愛！",
          "sc": "不是很爱！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7817,
      "rec_id": "TALK_ID_70_2140_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422094,
          "spk": "莲实 (ハスミ)",
          "ja": "他にも、作ってみようと思っている",
          "tc": "除此之外，",
          "sc": "除此之外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422101,
          "spk": "莲实 (ハスミ)",
          "ja": "料理のアイデアがいくつかあるんです",
          "tc": "我還有幾個關於料理的點子想嘗試。",
          "sc": "我还有几个关于料理的点子想尝试。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422112,
          "spk": "莲实 (ハスミ)",
          "ja": "いずれは、そのメニューの数々が",
          "tc": "有一天，說不定那些菜色",
          "sc": "有一天，说不定那些菜色"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422119,
          "spk": "莲实 (ハスミ)",
          "ja": "食卓に並ぶかもしれませんね",
          "tc": "會一一出現在餐桌上喔！",
          "sc": "会一一出现在餐桌上哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422130,
          "spk": "莲实 (ハスミ)",
          "ja": "健康づくりに欠かせないのは",
          "tc": "要打造健康的身體，",
          "sc": "要打造健康的身体，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 422137,
          "spk": "莲实 (ハスミ)",
          "ja": "毎日の食事からですし",
          "tc": "就必須從每天的飲食開始著手，",
          "sc": "就必须从每天的饮食开始着手，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 422144,
          "spk": "莲实 (ハスミ)",
          "ja": "がんばって挑戦を続けます",
          "tc": "我會持續努力挑戰的。",
          "sc": "我会持续努力挑战的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 422155,
          "spk": "莲实 (ハスミ)",
          "ja": "こうして健康料理を",
          "tc": "只要像這樣",
          "sc": "只要像这样"
        },
        {
          "f_idx": 8,
          "pidx_tc": 422162,
          "spk": "莲实 (ハスミ)",
          "ja": "生みだし続けていったら……",
          "tc": "持續研發健康料理……",
          "sc": "持续研发健康料理……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 422173,
          "spk": "莲实 (ハスミ)",
          "ja": "私自身の食生活も",
          "tc": "說不定我的飲食生活",
          "sc": "说不定我的饮食生活"
        },
        {
          "f_idx": 10,
          "pidx_tc": 422180,
          "spk": "莲实 (ハスミ)",
          "ja": "改善されるかもしれませんね",
          "tc": "也能獲得改善呢。",
          "sc": "也能获得改善呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7818,
      "rec_id": "TALK_ID_70_2140_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422204,
          "spk": "莲实 (ハスミ)",
          "ja": "来てくれたんですね、<player>さん",
          "tc": "歡迎你來，<player>。",
          "sc": "欢迎你来，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422211,
          "spk": "莲实 (ハスミ)",
          "ja": "私の……この部屋に",
          "tc": "這就是……我的房間……",
          "sc": "这就是……我的房间……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7819,
      "rec_id": "TALK_ID_70_2140_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422229,
          "spk": "莲实 (ハスミ)",
          "ja": "本当は、あなたが来る前に",
          "tc": "我本來是打算在你來之前，",
          "sc": "我本来是打算在你来之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422236,
          "spk": "莲实 (ハスミ)",
          "ja": "片づけようかとも思ったんですけど――",
          "tc": "先好好整理一下的──",
          "sc": "先好好整理一下的——"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422247,
          "spk": "莲实 (ハスミ)",
          "ja": "この部屋がありのままの自分ですし",
          "tc": "但這個房間象徵了最真實的我，",
          "sc": "但这个房间象征了最真实的我，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422254,
          "spk": "莲实 (ハスミ)",
          "ja": "堂々と公開することにしました",
          "tc": "所以我決定大大方方公開。",
          "sc": "所以我决定大大方方公开。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422265,
          "spk": "莲实 (ハスミ)",
          "ja": "くつろいでいただける自信はありませんが",
          "tc": "雖然沒自信能讓你感到舒適，",
          "sc": "虽然没自信能让你感到舒适，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 422272,
          "spk": "莲实 (ハスミ)",
          "ja": "どうか……帰らないでください",
