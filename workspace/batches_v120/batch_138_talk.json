  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2391,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57450,
          "spk": "裕太 (ユータ)",
          "ja": "品評会、楽しかったね",
          "tc": "評鑑會好好玩喔～",
          "sc": "评鉴会好好玩哦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57457,
          "spk": "裕太 (ユータ)",
          "ja": "<player>がエントリーしなかったのは",
          "tc": "不過<player>沒有報名參加，",
          "sc": "不过<player>没有报名参加，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57464,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと驚いたけど……",
          "tc": "讓我有點意外……",
          "sc": "让我有点意外……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57475,
          "spk": "裕太 (ユータ)",
          "ja": "でも、馬は誇り高い生き物だからね",
          "tc": "但馬是一種自尊心很高的生物，",
          "sc": "但马是一种自尊心很高的生物，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57482,
          "spk": "裕太 (ユータ)",
          "ja": "値踏みをされるのを嫌がる子も",
          "tc": "可能也有那種",
          "sc": "可能也有那种"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57489,
          "spk": "裕太 (ユータ)",
          "ja": "いるかもしれないし",
          "tc": "不喜歡被品頭論足的馬吧。",
          "sc": "不喜欢被品头论足的马吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 57500,
          "spk": "裕太 (ユータ)",
          "ja": "<player>の判断は",
          "tc": "或許<player>的判斷",
          "sc": "或许<player>的判断"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57507,
          "spk": "裕太 (ユータ)",
          "ja": "優しさなのかもしれないって思ったよ",
          "tc": "才是最溫柔的決定喔。",
          "sc": "才是最温柔的决定哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2392,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57531,
          "spk": "裕太 (ユータ)",
          "ja": "<player>がエントリーした",
          "tc": "<player>報名參賽的那匹馬，",
          "sc": "<player>报名参赛的那匹马，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57538,
          "spk": "裕太 (ユータ)",
          "ja": "あの馬、すごかったね！",
          "tc": "真的好厲害喔！",
          "sc": "真的好厉害哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57545,
          "spk": "裕太 (ユータ)",
          "ja": "Sランクは誰もが納得だよ",
          "tc": "能得到S級也是理所當然的。",
          "sc": "能得到S级也是理所当然的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57556,
          "spk": "裕太 (ユータ)",
          "ja": "首から肩にかけての流れるような線、",
          "tc": "從脖子到肩膀那流暢的線條，",
          "sc": "从脖子到肩膀那流畅的线条，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57563,
          "spk": "裕太 (ユータ)",
          "ja": "しなやかで力強い脚……！",
          "tc": "柔軟又有力的腿……！",
          "sc": "柔软又有力的腿……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57570,
          "spk": "裕太 (ユータ)",
          "ja": "生きた彫刻作品みたいだったな",
          "tc": "簡直就是活生生的雕刻作品啊。",
          "sc": "简直就是活生生的雕刻作品啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2393,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57594,
          "spk": "裕太 (ユータ)",
          "ja": "お疲れ様、<player>",
          "tc": "辛苦你了，<player>，",
          "sc": "辛苦你了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57601,
          "spk": "裕太 (ユータ)",
          "ja": "キミの馬、綺麗だったな",
          "tc": "你的馬很漂亮呢，",
          "sc": "你的马很漂亮呢，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57608,
          "spk": "裕太 (ユータ)",
          "ja": "目が釘付けになっちゃったよ",
          "tc": "我都看入迷了。",
          "sc": "我都看入迷了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57619,
          "spk": "裕太 (ユータ)",
          "ja": "きっと次は最高の評価をもらえるよ",
          "tc": "下次一定可以獲得更高的評價，",
          "sc": "下次一定可以获得更高的评价，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57626,
          "spk": "裕太 (ユータ)",
          "ja": "次も応援してるから頑張ってね",
          "tc": "我會繼續支持你的，要加油喔！",
          "sc": "我会继续支持你的，要加油哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2394,
      "rec_id": "TALK_ID_YOUNG_MAN_PRESENT_20_111_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57657,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、もしかして……",
          "tc": "咦，難道說……",
          "sc": "咦，难道说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57664,
          "spk": "裕太 (ユータ)",
          "ja": "これを俺にくれるの？",
          "tc": "這是要送我的嗎？",
          "sc": "这是要送我的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57675,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう、すごく嬉しいよ！",
          "tc": "謝謝你，我真的很開心！",
          "sc": "谢谢你，我真的很开心！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57682,
          "spk": "裕太 (ユータ)",
          "ja": "これ、俺の好みにぴったりだ！",
          "tc": "這完全就是我會喜歡的！",
          "sc": "这完全就是我会喜欢的！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57693,
          "spk": "裕太 (ユータ)",
          "ja": "……なんだろうな、こうして渡されると、",
          "tc": "……該怎麼說呢，能當面收到這種東西，",
          "sc": "……该怎么说呢，能当面收到这种东西，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57700,
          "spk": "裕太 (ユータ)",
          "ja": "見た目以上に意味がある気がするよ",
          "tc": "就覺得這有著超越物品本身的意義。",
          "sc": "就觉得这有着超越物品本身的意义。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57718,
          "spk": "裕太 (ユータ)",
          "ja": "今度、お返しをしないとね",
          "tc": "下次要好好答謝你才行。",
          "sc": "下次要好好答谢你才行。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 57725,
          "spk": "裕太 (ユータ)",
          "ja": "欲しいものはある？",
          "tc": "你有什麼想要的東西嗎？",
          "sc": "你有什么想要的东西吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 57732,
          "spk": "裕太 (ユータ)",
          "ja": "何か考えておいておくれ",
          "tc": "先想想看吧。",
          "sc": "先想想看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2395,
      "rec_id": "TALK_ID_YOUNG_MAN_PRESENT_20_111_0201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57756,
          "spk": "裕太 (ユータ)",
          "ja": "え……これ、くれるの？",
          "tc": "咦……要送我這個嗎？",
          "sc": "咦……要送我这个吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57763,
          "spk": "裕太 (ユータ)",
          "ja": "もしかして、わざわざ",
          "tc": "這該不會……",
          "sc": "这该不会……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57770,
          "spk": "裕太 (ユータ)",
          "ja": "俺のために用意してくれた？",
          "tc": "是你特地為我準備的？",
          "sc": "是你特地为我准备的？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57781,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57788,
          "spk": "裕太 (ユータ)",
          "ja": "その気持ちが何よりも嬉しいよ",
          "tc": "這份心意比什麼都更讓我開心。",
          "sc": "这份心意比什么都更让我开心。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57799,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと悪い気がするけど",
          "tc": "雖然很不好意思，",
          "sc": "虽然很不好意思，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 57806,
          "spk": "裕太 (ユータ)",
          "ja": "もらっておくね",
          "tc": "但我還是收下吧。",
          "sc": "但我还是收下吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57817,
          "spk": "裕太 (ユータ)",
          "ja": "こういう、なんの変哲もないものにこそ、",
          "tc": "從這種平凡無奇的東西上，",
          "sc": "从这种平凡无奇的东西上，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 57824,
          "spk": "裕太 (ユータ)",
          "ja": "村暮らしの良さを感じるよね",
          "tc": "更能感受到鄉村生活的魅力呢。",
          "sc": "更能感受到乡村生活的魅力呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2396,
      "rec_id": "TALK_ID_YOUNG_MAN_PRESENT_20_111_0202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57855,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、これを……俺に？",
          "tc": "咦，這個……",
          "sc": "咦，这个……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57862,
          "spk": "裕太 (ユータ)",
          "ja": "くれるの？",
          "tc": "要給我？",
          "sc": "要给我？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57873,
          "spk": "裕太 (ユータ)",
          "ja": "そ、そっか……",
          "tc": "這、這樣啊……",
          "sc": "这、这样啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57880,
          "spk": "裕太 (ユータ)",
          "ja": "えっと、大事にするよ",
          "tc": "呃，我會珍惜的。",
          "sc": "呃，我会珍惜的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57891,
          "spk": "裕太 (ユータ)",
          "ja": "もしかしたら、俺よりも",
          "tc": "雖然我是覺得比起我，",
          "sc": "虽然我是觉得比起我，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57898,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が持っていたほうが",
          "tc": "<player>自己拿著",
          "sc": "<player>自己拿着"
        },
        {
          "f_idx": 6,
          "pidx_tc": 57905,
          "spk": "裕太 (ユータ)",
          "ja": "いいような気もするんだけど……",
          "tc": "應該比較好……",
          "sc": "应该比较好……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57916,
          "spk": "裕太 (ユータ)",
          "ja": "でも、せっかくだから",
          "tc": "但機會難得，",
          "sc": "但机会难得，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 57923,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱりもらっておくよ",
          "tc": "我還是收下好了。",
          "sc": "我还是收下好了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 57930,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2397,
      "rec_id": "TALK_ID_YOUNG_MAN_PRESENT_20_111_0203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57954,
          "spk": "裕太 (ユータ)",
          "ja": "うそ、これを俺に？",
          "tc": "不會吧，要給我這個嗎？",
          "sc": "不会吧，要给我这个吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57961,
          "spk": "裕太 (ユータ)",
          "ja": "うわぁ、俺の誕生日を覚えててくれたんだね！",
          "tc": "哇，你記得我的生日啊！",
          "sc": "哇，你记得我的生日啊！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57968,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう、<player>！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57979,
          "spk": "裕太 (ユータ)",
          "ja": "誕生日プレゼントまで用意してくれてるなんて、",
          "tc": "還幫我準備了生日禮物，",
          "sc": "还帮我准备了生日礼物，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57986,
          "spk": "裕太 (ユータ)",
          "ja": "本当に嬉しいな",
          "tc": "我真的好開心。",
          "sc": "我真的好开心。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57997,
          "spk": "裕太 (ユータ)",
          "ja": "その上、手渡しでもらえるだなんて……",
          "tc": "而且還是親手交給我的……",
          "sc": "而且还是亲手交给我的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 58015,
          "spk": "裕太 (ユータ)",
          "ja": "キミの時間まで一緒に",
          "tc": "有種你連時間",
          "sc": "有种你连时间"
        },
        {
          "f_idx": 8,
          "pidx_tc": 58022,
          "spk": "裕太 (ユータ)",
          "ja": "渡してもらえた気がして",
          "tc": "也一起送給我的感覺，",
          "sc": "也一起送给我的感觉，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 58029,
          "spk": "裕太 (ユータ)",
          "ja": "特別な感じがするよ",
          "tc": "真的很特別。",
          "sc": "真的很特别。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2398,
      "rec_id": "TALK_ID_YOUNG_MAN_PRESENT_20_111_0204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58053,
          "spk": "裕太 (ユータ)",
          "ja": "俺、結構贈り物貰ってるよね？",
          "tc": "我好像很常收到你的禮物，",
          "sc": "我好像很常收到你的礼物，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58060,
          "spk": "裕太 (ユータ)",
          "ja": "あんまりもらうのも悪いし、",
          "tc": "這樣一直收你的禮物不太好，",
          "sc": "这样一直收你的礼物不太好，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58067,
          "spk": "裕太 (ユータ)",
          "ja": "……また今度ね？",
          "tc": "……下次再說吧？",
          "sc": "……下次再说吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2399,
      "rec_id": "TALK_ID_YOUNG_MAN_THUNDERSTORM_20_111_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58091,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、こんなに雷がすごいのに",
          "tc": "咦，都打那麼大的雷了，",
          "sc": "咦，都打那么大的雷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58098,
          "spk": "裕太 (ユータ)",
          "ja": "外に出てたの？",
          "tc": "你還到外面來？",
          "sc": "你还到外面来？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58105,
          "spk": "裕太 (ユータ)",
          "ja": "まさか走って来てないよね？",
          "tc": "該不會是一路跑過來的吧？",
          "sc": "该不会是一路跑过来的吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 58116,
          "spk": "裕太 (ユータ)",
          "ja": "雷って速く動くものに落ちやすいって",
          "tc": "我聽說雷很容易打在",
          "sc": "我听说雷很容易打在"
        },
        {
          "f_idx": 4,
          "pidx_tc": 58123,
          "spk": "裕太 (ユータ)",
          "ja": "聞いたことがあるんだけど……あれ？",
          "tc": "快速移動的東西上……咦？",
          "sc": "快速移动的东西上……咦？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 58134,
          "spk": "裕太 (ユータ)",
          "ja": "ごめん、迷信だったかも……？",
          "tc": "抱歉，或許只是迷信吧……？",
          "sc": "抱歉，或许只是迷信吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2400,
      "rec_id": "TALK_ID_YOUNG_MAN_THUNDERSTORM_20_111_0301",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58158,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58165,
          "spk": "裕太 (ユータ)",
          "ja": "こんな日に遊びに来るなんて",
          "tc": "這種日子還跑來玩，",
          "sc": "这种日子还跑来玩，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58172,
          "spk": "裕太 (ユータ)",
