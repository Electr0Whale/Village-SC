        {
          "f_idx": 10,
          "pidx_tc": 22615,
          "spk": "琪娜娜 (チナナ)",
          "ja": "煮込んでおけば、それっぽくなるからね",
          "tc": "丟下鍋燉煮，就能煮出個樣子來了。",
          "sc": "丢下锅炖煮，就能煮出个样子来了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 22624,
          "spk": "琪娜娜 (チナナ)",
          "ja": "野菜をおいしく、たくさん食べられるし",
          "tc": "這樣不但能吃到好吃、大量的蔬菜，",
          "sc": "这样不但能吃到好吃、大量的蔬菜，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 22631,
          "spk": "琪娜娜 (チナナ)",
          "ja": "中途半端に残った野菜の処分までできちゃう",
          "tc": "還能把那些剩下來的蔬菜清空。",
          "sc": "还能把那些剩下来的蔬菜清空。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 22638,
          "spk": "琪娜娜 (チナナ)",
