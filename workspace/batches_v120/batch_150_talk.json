    {
      "file": "talk.dat",
      "rec_idx": 3069,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22260,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いやぁ、助かったよ～",
          "tc": "哎呀，真是幫了我大忙～",
          "sc": "哎呀，真是帮了我大忙～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22267,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうしても手が回らなくってさ",
          "tc": "因為我真的抽不出時間來。",
          "sc": "因为我真的抽不出时间来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22278,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありがとね、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22285,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほい、手間賃！",
          "tc": "來，這是給你的報酬！",
          "sc": "来，这是给你的报酬！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22296,
          "spk": "琪娜娜 (チナナ)",
          "ja": "んじゃ、またなにかあったらよろしくね",
          "tc": "以後我有需要會再麻煩你的，",
          "sc": "以后我有需要会再麻烦你的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22303,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今後ともご贔屓に～",
          "tc": "之後也請你多多關照啦～",
          "sc": "之后也请你多多关照啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3070,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22332,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありゃ、ごめんね",
          "tc": "哎呀，抱歉，",
          "sc": "哎呀，抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22339,
          "spk": "琪娜娜 (チナナ)",
          "ja": "持ってきてくれたのかと",
          "tc": "我還以為",
          "sc": "我还以为"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22346,
          "spk": "琪娜娜 (チナナ)",
          "ja": "勘違いしちゃったよ",
          "tc": "你帶東西來給我了。",
          "sc": "你带东西来给我了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>もやることあるだろうからさ",
          "tc": "畢竟<player>也有自己的事要忙，",
          "sc": "毕竟<player>也有自己的事要忙，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22364,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの件は手が空いたらでいいよ",
          "tc": "所以等你有空再處理我的事就好。",
          "sc": "所以等你有空再处理我的事就好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3071,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22395,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22402,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと聞きたいんだけどさ、あんまり手間を",
          "tc": "我問你喔，你有時候會不會",
          "sc": "我问你哦，你有时候会不会"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22409,
          "spk": "琪娜娜 (チナナ)",
          "ja": "かけないでご飯を食べたいってとき、ない？",
          "tc": "只想做些簡單的食物來吃啊？",
          "sc": "只想做些简单的食物来吃啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22420,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは今まさにその気分でね",
          "tc": "我現在就是這樣。",
          "sc": "我现在就是这样。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か作ろうか考えてたんだけど、",
          "tc": "我一直在想要來做什麼，",
          "sc": "我一直在想要来做什么，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22434,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなときは「オニオンスープ」に限るよ",
          "tc": "但想偷懶的首選果然就是「洋蔥湯」了吧。",
          "sc": "但想偷懒的首选果然就是“洋葱汤”了吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 22445,
          "spk": "琪娜娜 (チナナ)",
          "ja": "タマネギをひたすら炒めるのって、",
          "tc": "不斷翻炒洋蔥雖然花時間，",
          "sc": "不断翻炒洋葱虽然花时间，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 22452,
          "spk": "琪娜娜 (チナナ)",
          "ja": "時間はかかるけどそんなに手間じゃないだろ？",
          "tc": "但並不麻煩對吧？",
          "sc": "但并不麻烦对吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 22470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "飴色に輝くスープと、そこに浸したパン、",
          "tc": "焦糖色的湯與泡在湯裡面的麵包，",
          "sc": "焦糖色的汤与泡在汤里面的面包，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 22477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そして何より、とろとろのチーズ……",
          "tc": "還有最重要的是那融化的起司……",
          "sc": "还有最重要的是那融化的奶酪……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 22484,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この組み合わせは、大正義って感じがするよねえ",
          "tc": "這個組合有種所向無敵的感覺呢。",
          "sc": "这个组合有种所向无敌的感觉呢。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 22495,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>も食べたくなってきたんじゃない？",
          "tc": "<player>是不是也想吃啊？",
          "sc": "<player>是不是也想吃啊？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 22502,
          "spk": "琪娜娜 (チナナ)",
          "ja": "レシピをあげるから、自分で作ってみるといいよ",
          "tc": "我給你食譜，你就自己做做看吧。",
          "sc": "我给你食谱，你就自己做做看吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 22509,
          "spk": "琪娜娜 (チナナ)",
          "ja": "タマネギが手に入ったら、試してみることだね",
          "tc": "等你拿到洋蔥的時候，記得試試看喔。",
          "sc": "等你拿到洋葱的时候，记得试试看哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3072,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22533,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、最近はどうだい？",
          "tc": "<player>，你最近怎麼樣啊？",
          "sc": "<player>，你最近怎么样啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22540,
          "spk": "琪娜娜 (チナナ)",
          "ja": "野菜はちゃんと食べてる？",
          "tc": "有在好好吃蔬菜嗎？",
          "sc": "有在好好吃蔬菜吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "肉ばっかり食べていないだろうね？",
          "tc": "該不會都只吃肉吧？",
          "sc": "该不会都只吃肉吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22558,
          "spk": "琪娜娜 (チナナ)",
          "ja": "野菜、ちゃんと食べようとすると大変だよね",
          "tc": "想要認真吃蔬菜並不容易對吧？",
          "sc": "想要认真吃蔬菜并不容易对吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22565,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ひとつひとつ調理して、味つけして……",
          "tc": "要一個個料理、調味……",
          "sc": "要一个个料理、调味……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22572,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けっこう面倒くさかったりしてね",
          "tc": "有時候還滿麻煩的。",
          "sc": "有时候还满麻烦的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 22583,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そこで今日は、ウチがキミに",
          "tc": "所以我今天要傳授你",
          "sc": "所以我今天要传授你"
        },
        {
          "f_idx": 7,
          "pidx_tc": 22590,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「ミネストローネ」のレシピを教えてあげるよ",
          "tc": "這道「義式蔬菜湯」的食譜。",
          "sc": "这道“义式蔬菜汤”的食谱。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 22601,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こいつは便利な料理なんだよ",
          "tc": "這是很方便的料理，",
          "sc": "这是很方便的料理，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 22608,
          "spk": "琪娜娜 (チナナ)",
          "ja": "余ってたり、使いかけだったりする野菜を",
          "tc": "只要把剩下的、或者用了一半的蔬菜",
          "sc": "只要把剩下的、或者用了一半的蔬菜"
