  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3064,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_ROUTINE_WALK_20_113_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 163322,
          "spk": "莲实 (ハスミ)",
          "ja": "外での寒さが堪える分",
          "tc": "正因為外面冷得讓人受不了，",
          "sc": "正因为外面冷得让人受不了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 163329,
          "spk": "莲实 (ハスミ)",
          "ja": "ゆっくりお風呂に入る時間は幸せですね",
          "tc": "悠閒的泡澡時光更給人幸福的感覺。",
          "sc": "悠闲的泡澡时光更给人幸福的感觉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 163347,
          "spk": "莲实 (ハスミ)",
          "ja": "そのあとのアイスも、密かな楽しみです",
          "tc": "泡完澡再吃冰，也是我的一個小樂趣。",
          "sc": "泡完澡再吃冰，也是我的一个小乐趣。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3065,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_ROUTINE_WALK_20_113_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 163385,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん……こんな時間まで外に？",
          "tc": "<player>……這個時間你還在外面？",
          "sc": "<player>……这个时间你还在外面？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 163403,
          "spk": "莲实 (ハスミ)",
          "ja": "もうすぐ暗くなります",
          "tc": "天很快就要完全暗下來了。",
          "sc": "天很快就要完全暗下来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 163410,
          "spk": "莲实 (ハスミ)",
          "ja": "夜の雪道は本当に危ないので、",
          "tc": "夜晚積雪的道路真的非常危險，",
          "sc": "夜晚积雪的道路真的非常危险，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 163417,
          "spk": "莲实 (ハスミ)",
          "ja": "今日は早めに帰ったほうがいいですよ",
          "tc": "今天你還是早點回去比較好喔。",
          "sc": "今天你还是早点回去比较好哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3066,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22048,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあやあ、彼ヶ津村にようこそ",
          "tc": "嗨，歡迎來到彼津村。",
          "sc": "哟，你好呀，欢迎来到彼津村。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22055,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村に人が増えるってことは、",
          "tc": "村裡的人變多，",
          "sc": "村里的人变多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22062,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチのお得意さんが増えるってわけだ",
          "tc": "就代表我的常客也會變多。",
          "sc": "就代表我的常客也会变多。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22073,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遊び暮らすのもいいけど、",
          "tc": "想遊手好閒是無妨，",
          "sc": "想游手好闲是无妨，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22080,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちゃんと金も稼いでおくれよ",
          "tc": "但也要認真賺錢喔。",
          "sc": "但也要认真赚钱哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22087,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これからいい関係を築いていこうじゃないか",
          "tc": "希望我們以後可以建立起良好的關係。",
          "sc": "希望我们以后可以建立起良好的关系。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3067,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22113,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん～……どうしたもんかねえ",
          "tc": "嗯……該怎麼辦呢？",
          "sc": "嗯……该怎么办呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22120,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、ちょっと聞いてくれるかい？",
          "tc": "<player>，可以聽我說一下嗎？",
          "sc": "<player>，可以听我说一下吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22131,
          "spk": "琪娜娜 (チナナ)",
          "ja": "実は<tmpstr>が欲しいんだけど",
          "tc": "其實我想要<tmpstr>，",
          "sc": "其实我想要<tmpstr>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22138,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチがなんやかんやで忙しくてね",
          "tc": "但我有其他事要忙，",
          "sc": "但我有其他事要忙，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22145,
          "spk": "琪娜娜 (チナナ)",
          "ja": "全然手に入れられないんだよ",
          "tc": "一直都沒空去找。",
          "sc": "一直都没空去找。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22156,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もし<player>が暇なら",
          "tc": "所以如果<player>你有空，",
          "sc": "所以如果<player>你有空，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 22163,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの代わりに調達してくれると",
          "tc": "願意替我拿到這東西的話，",
          "sc": "愿意替我拿到这东西的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 22170,
          "spk": "琪娜娜 (チナナ)",
          "ja": "助かるんだけど、どうだい？",
          "tc": "我會很感激你的，怎麼樣？",
          "sc": "我会很感激你的，怎么样？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 22181,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<gamevalue GAME_VALUE_TALK_NUM>日以内に持ってきてくれたら",
          "tc": "如果能在<gamevalue GAME_VALUE_TALK_NUM>天之內拿來給我的話，",
          "sc": "如果能在<gamevalue GAME_VALUE_TALK_NUM>天之内拿来给我的话，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 22188,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手間賃も渡すからさ",
          "tc": "我會給你報酬的。",
          "sc": "我会给你报酬的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 22195,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よろしく頼んだよ～",
          "tc": "就麻煩你啦～",
          "sc": "就麻烦你啦～"
        }
      ]
    },
    {
