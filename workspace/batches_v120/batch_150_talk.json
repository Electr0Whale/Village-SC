      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3073,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22687,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はあ……まだ足りないね……",
          "tc": "唉……還是不夠啊……",
          "sc": "唉……还是不够啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22694,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう一つ食べたいね……はあ……",
          "tc": "好想再多吃一個……唉……",
          "sc": "好想再多吃一个……唉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 22705,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、<player>",
          "tc": "……啊，是<player>啊。",
          "sc": "……啊，是<player>啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 22712,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いや、ちょっとね",
          "tc": "沒有啦，",
          "sc": "没有啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 22719,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トマトのことを考えていたんだよ",
          "tc": "我在煩惱關於番茄的事。",
          "sc": "我在烦恼关于西红柿的事。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 22730,
          "spk": "琪娜娜 (チナナ)",
          "ja": "新鮮でおいしいトマトがたくさん手に入ってね",
          "tc": "我買到了大量新鮮美味的番茄，",
          "sc": "我买到了大量新鲜美味的西红柿，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 22737,
          "spk": "琪娜娜 (チナナ)",
          "ja": "店に出そうかとも思ったんだけど、",
          "tc": "想說可以拿來賣，卻又捨不得，",
          "sc": "想说可以拿来卖，却又舍不得，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 22744,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もったいなくて全部自分で食べちゃったんだ",
          "tc": "結果就全部自己吃光了。",
          "sc": "结果就全部自己吃光了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 22755,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は、トマトの一番おいしい",
          "tc": "<player>，你知道番茄",
          "sc": "<player>，你知道西红柿"
        },
        {
          "f_idx": 9,
          "pidx_tc": 22762,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べ方って知ってるかい？",
          "tc": "怎麼吃最好吃嗎？",
          "sc": "怎么吃最好吃吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 22769,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、これがそのレシピだよ",
          "tc": "給你，這是食譜。",
          "sc": "给你，这是食谱。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 22780,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「山盛りトマト」はトマトを皿に山盛りにして",
          "tc": "「番茄山」是在盤子上堆一堆番茄的料理，",
          "sc": "“西红柿山”是在盘子上堆一堆西红柿的料理，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 22787,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無心で食べることで完成するレシピだよ！",
          "tc": "心無旁鶩的享受這道料理也是食譜的步驟！",
          "sc": "心无旁鹜的享受这道料理也是食谱的步骤！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 22794,
          "spk": "琪娜娜 (チナナ)",
          "ja": "マヨネーズを添えて、そのままかぶりつくんだ",
          "tc": "而且要搭配上美乃滋，直接大口吃下去。",
          "sc": "而且要搭配上蛋黄酱，直接大口吃下去。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 22805,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トマトの純粋な味を楽しみたくなったら",
          "tc": "如果你想要享受番茄純粹的滋味，",
          "sc": "如果你想要享受西红柿纯粹的滋味，"
