          "f_idx": 1,
          "pidx_tc": 186281,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そこに車を停めるから、",
          "tc": "抱歉，我想把車停在那裡，",
          "sc": "抱歉，我想把车停在那里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 186288,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど、道をあけてくれるかい？",
          "tc": "可以請你讓個路嗎？",
          "sc": "可以请你让个路吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
