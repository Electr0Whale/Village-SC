    {
      "file": "talk.dat",
      "rec_idx": 3483,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186114,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、もう午後５時じゃないか",
          "tc": "哎呀，已經下午5點了嗎？",
          "sc": "哎呀，已经下午5点了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 186121,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはもう帰るよ",
          "tc": "我要回家了，",
          "sc": "我要回家了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 186128,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃあ、またね",
          "tc": "那就下次見囉！",
          "sc": "那就下次见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3484,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186154,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あら、もう午後５時だね",
          "tc": "哎呀，已經下午5點了啊。",
          "sc": "哎呀，已经下午5点了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 186161,
          "spk": "琪娜娜 (チナナ)",
          "ja": "残念だけど、今日はここまで",
          "tc": "雖然很可惜，但今天就到這裡吧。",
          "sc": "虽然很可惜，但今天就到这里吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 186168,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃあ、また来ておくれ",
          "tc": "下次要再來喔！",
          "sc": "下次要再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3485,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186194,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気づけば午後５時じゃないか",
          "tc": "回過神來怎麼已經下午5點了！",
          "sc": "回过神来怎么已经下午5点了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 186201,
          "spk": "琪娜娜 (チナナ)",
          "ja": "名残惜しいけど、今日は店じまいだよ",
          "tc": "雖然很可惜，但今天要打烊了。",
          "sc": "虽然很可惜，但今天要打烊了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 186208,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、次の機会にまたおいで",
          "tc": "<player>，下次有機會再來喔！",
          "sc": "<player>，下次有机会再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3486,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186234,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さて、今日のお仕事はおしまい",
          "tc": "好，今天可以收工了！",
          "sc": "好，今天可以收工了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 186241,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはもう帰るから、",
          "tc": "我要回家了，",
          "sc": "我要回家了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 186248,
          "spk": "琪娜娜 (チナナ)",
          "ja": "買いたかったらまた今度来ておくれ",
          "tc": "想買東西的話下次再來喔！",
          "sc": "想买东西的话下次再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3487,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186274,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おーい、<player>！",
          "tc": "喂～<player>！",
          "sc": "喂～<player>！"
