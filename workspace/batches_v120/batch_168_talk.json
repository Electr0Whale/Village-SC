      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 186314,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>！",
          "tc": "<player>！",
