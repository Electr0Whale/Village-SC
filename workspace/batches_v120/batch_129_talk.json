  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1902,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_PRESENT_20_109_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 141864,
          "spk": "名护 (ナゴ)",
          "ja": "ん？　これを俺に……？",
          "tc": "咦？這個要給我……",
          "sc": "咦？这个要给我……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 141871,
          "spk": "名护 (ナゴ)",
          "ja": "わざわざ用意してくれたのか",
          "tc": "是特地為我準備的？",
          "sc": "是特地为我准备的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 141882,
          "spk": "名护 (ナゴ)",
          "ja": "はは……俺の好み、<player>さんには",
          "tc": "哈哈……看來我的喜好，",
          "sc": "哈哈……看来我的喜好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 141889,
          "spk": "名护 (ナゴ)",
          "ja": "すっかりバレてるみたいだね……",
          "tc": "已經徹底被你看穿了……",
          "sc": "已经彻底被你看穿了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 141900,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 141907,
          "spk": "名护 (ナゴ)",
          "ja": "こういうのは慣れてないけど、嬉しいよ",
          "tc": "雖然我還不習慣這種事，但我很開心。",
          "sc": "虽然我还不习惯这种事，但我很开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1903,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_PRESENT_20_109_0201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 141931,
          "spk": "名护 (ナゴ)",
          "ja": "……これ、俺にくれるのか？",
          "tc": "……這是要送我的嗎？",
          "sc": "……这是要送我的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 141938,
          "spk": "名护 (ナゴ)",
          "ja": "なんだか悪いが……ありがとう",
          "tc": "總覺得不好意思……但謝謝你。",
          "sc": "总觉得不好意思……但谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 141949,
          "spk": "名护 (ナゴ)",
          "ja": "何気ないものでも、",
          "tc": "即使是平凡的東西，",
          "sc": "即使是平凡的东西，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 141956,
          "spk": "名护 (ナゴ)",
          "ja": "こうして手渡されると違って見えるな",
          "tc": "像這樣被親手交到手上時，也會感覺特別不同。",
          "sc": "像这样被亲手交到手上时，也会感觉特别不同。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 141965,
          "spk": "名护 (ナゴ)",
          "ja": "キミの気持ちも含めて",
          "tc": "這個東西也包含了你的心意，",
          "sc": "这个东西也包含了你的心意，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 141972,
          "spk": "名护 (ナゴ)",
          "ja": "受け取らせてもらうよ",
          "tc": "我就一起收下了。",
          "sc": "我就一起收下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1904,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_PRESENT_20_109_0202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 141996,
          "spk": "名护 (ナゴ)",
          "ja": "え……俺にくれるのか？",
          "tc": "咦？……這是要送我的嗎？",
          "sc": "咦？……这是要送我的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142003,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……これを……",
          "tc": "這樣啊……你把這個……",
          "sc": "这样啊……你把这个……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142014,
          "spk": "名护 (ナゴ)",
          "ja": "あ、いや、ちょっと驚いただけだよ",
          "tc": "啊、不，我只是有點意外。",
          "sc": "啊、不，我只是有点意外。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142021,
          "spk": "名护 (ナゴ)",
          "ja": "どう受け取るか迷ってしまって……",
          "tc": "不知道該怎麼解讀你的用意……",
          "sc": "不知道该怎么解读你的用意……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142037,
          "spk": "名护 (ナゴ)",
          "ja": "こういうのを選ぶところが",
          "tc": "會選這個東西送我，",
          "sc": "会选这个东西送我，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142044,
          "spk": "名护 (ナゴ)",
          "ja": "キミらしいと思うよ……",
          "tc": "也是很符合你的作風……",
          "sc": "也是很符合你的作风……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 142055,
          "spk": "名护 (ナゴ)",
          "ja": "大事なのは気持ちだしな……",
          "tc": "畢竟最重要的是心意……",
          "sc": "毕竟最重要的是心意……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142062,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう、ちゃんと受け取るよ……",
          "tc": "所以我會收下的，謝謝你……",
          "sc": "所以我会收下的，谢谢你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1905,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_PRESENT_20_109_0203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142093,
          "spk": "名护 (ナゴ)",
          "ja": "誕生日……！",
          "tc": "生日……！",
          "sc": "生日……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142100,
          "spk": "名护 (ナゴ)",
          "ja": "そうか、すっかり忘れてたよ",
          "tc": "對喔，我完全忘了。",
          "sc": "对哦，我完全忘了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142111,
          "spk": "名护 (ナゴ)",
          "ja": "自分の誕生日なのに",
          "tc": "明明是我自己的生日，",
          "sc": "明明是我自己的生日，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142118,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんの方が覚えてるなんて",
          "tc": "記得的人反而是<player>，",
          "sc": "记得的人反而是<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142125,
          "spk": "名护 (ナゴ)",
          "ja": "おかしな話だな",
          "tc": "還真奇怪呢。",
          "sc": "还真奇怪呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142136,
          "spk": "名护 (ナゴ)",
          "ja": "……ごめんごめん",
          "tc": "……抱歉抱歉。",
          "sc": "……抱歉抱歉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142143,
          "spk": "名护 (ナゴ)",
          "ja": "自分の話ばかりで、お礼がまだだったね",
          "tc": "我顧著講自己的事，都還沒跟你道謝呢。",
          "sc": "我顾着讲自己的事，都还没跟你道谢呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142159,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう、<player>さん",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 142166,
          "spk": "名护 (ナゴ)",
          "ja": "プレゼントまでもらって、幸せだよ",
          "tc": "能收到你送的禮物，我真幸福啊。",
          "sc": "能收到你送的礼物，我真幸福啊。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 142184,
          "spk": "名护 (ナゴ)",
          "ja": "キミの誕生日は俺以上に",
          "tc": "等你生日的時候，",
          "sc": "等你生日的时候，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 142191,
          "spk": "名护 (ナゴ)",
          "ja": "盛大に祝うことにしよう",
          "tc": "我們再來更盛大地慶祝吧。",
          "sc": "我们再来更盛大地庆祝吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 142198,
          "spk": "名护 (ナゴ)",
          "ja": "今から、楽しみだな",
          "tc": "我現在就開始期待了呢。",
          "sc": "我现在就开始期待了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1906,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_PRESENT_20_109_0204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142222,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう、<player>さん",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142229,
          "spk": "名护 (ナゴ)",
          "ja": "でも、流石にもらいすぎだ",
          "tc": "不過，感覺這份禮物過於貴重了。",
          "sc": "不过，感觉这份礼物过于贵重了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142236,
          "spk": "名护 (ナゴ)",
          "ja": "今回は、気持ちだけ受け取っておくよ",
          "tc": "你的好意我就心領了。",
          "sc": "你的好意我就心领了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1907,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_THUNDERSTORM_20_109_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142260,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん……？　なんでここに……",
          "tc": "<player>……？你怎麼會在這裡……",
          "sc": "<player>……？你怎么会在这里……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142267,
          "spk": "名护 (ナゴ)",
          "ja": "まさか、この雷雨で歩いて来たのか？",
          "tc": "難道是冒著雷雨走過來的嗎？",
          "sc": "难道是冒着雷雨走过来的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142285,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんは本当に行動力があるなぁ",
          "tc": "<player>，你真的很有行動力呢。",
          "sc": "<player>，你真的很有行动力呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142292,
          "spk": "名护 (ナゴ)",
          "ja": "やろうと思ったら、すぐ実行に移してる",
          "tc": "一旦想做，就會馬上付諸行動。",
          "sc": "一旦想做，就会马上付诸行动。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142310,
          "spk": "名护 (ナゴ)",
          "ja": "けど……悪天候の日は危ないから",
          "tc": "不過……天氣不好的時候很危險，",
          "sc": "不过……天气不好的时候很危险，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 142317,
          "spk": "名护 (ナゴ)",
          "ja": "家でジッとしていた方がいいかな",
          "tc": "還是乖乖待在家裡比較好吧。",
          "sc": "还是乖乖待在家里比较好吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142324,
          "spk": "名护 (ナゴ)",
          "ja": "これは、大人からのアドバイスだよ",
          "tc": "這是大人給你的建議喔！",
          "sc": "这是大人给你的建议哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1908,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_THUNDERSTORM_20_109_0301",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142348,
          "spk": "名护 (ナゴ)",
          "ja": "雨に降られちゃったのか？",
          "tc": "你淋到雨了嗎？",
          "sc": "你淋到雨了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142355,
          "spk": "名护 (ナゴ)",
          "ja": "災難だったね、<player>さん",
          "tc": "真是不走運呢，<player>。",
          "sc": "真是不走运呢，<player>。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142366,
          "spk": "名护 (ナゴ)",
          "ja": "ちょうど話相手がほしいと",
          "tc": "這下正好，",
          "sc": "这下正好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142373,
          "spk": "名护 (ナゴ)",
          "ja": "思っていたところだったんだ",
          "tc": "反正我也想找人聊聊天。",
          "sc": "反正我也想找人聊聊天。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142380,
          "spk": "名护 (ナゴ)",
          "ja": "しばらく、ここにいるといいよ",
          "tc": "你可以暫時待在這裡喔。",
          "sc": "你可以暂时待在这里哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1909,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142404,
          "spk": "名护 (ナゴ)",
          "ja": "この村にいるのは",
          "tc": "這座村子裡的人，",
          "sc": "这座村子里的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142411,
          "spk": "名护 (ナゴ)",
          "ja": "ひと癖もふた癖もある人ばかりだな……",
          "tc": "一個個都有點難搞呢……",
          "sc": "一个个都有点难搞呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1910,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142435,
          "spk": "名护 (ナゴ)",
          "ja": "何で誰も片づけようとしないんだ……",
          "tc": "為什麼都沒有人要整理啊……",
          "sc": "为什么都没有人要整理啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142442,
          "spk": "名护 (ナゴ)",
          "ja": "これを平気にしておける考えがわからないよ",
          "tc": "真搞不懂，怎麼有辦法這樣放著不管。",
          "sc": "真搞不懂，怎么有办法这样放着不管。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1911,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142473,
          "spk": "名护 (ナゴ)",
          "ja": "この本の汚れは……誰かが濡らしたな……？",
          "tc": "這本書的髒污……到底是誰沾上去的……？",
          "sc": "这本书的脏污……到底是谁沾上去的……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142480,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんは、物を大切にしない",
          "tc": "<player>，你以後可不能成為",
          "sc": "<player>，你以后可不能成为"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142487,
          "spk": "名护 (ナゴ)",
          "ja": "大人になっては駄目だぞ",
          "tc": "不愛惜物品的大人喔。",
          "sc": "不爱惜物品的大人哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1912,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142511,
          "spk": "名护 (ナゴ)",
          "ja": "この図書館、少しは片付けたが、",
          "tc": "這座圖書館雖然稍微整理過了，",
          "sc": "这座图书馆虽然稍微整理过了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142518,
          "spk": "名护 (ナゴ)",
          "ja": "棚の隙間や奥にはまだ手が入れられてないんだ",
          "tc": "但書架之間和深處還有打掃不到的地方。",
          "sc": "但书架之间和深处还有打扫不到的地方。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142536,
          "spk": "名护 (ナゴ)",
          "ja": "たまったホコリの厚さといったら……",
          "tc": "從堆疊起來的灰塵厚度看……",
          "sc": "从堆叠起来的灰尘厚度看……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142543,
          "spk": "名护 (ナゴ)",
          "ja": "一体何年放置したんだろうな……",
          "tc": "到底是有多少年沒人理會了……",
          "sc": "到底是有多少年没人理会了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1913,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142574,
          "spk": "名护 (ナゴ)",
          "ja": "せっかく桜が咲いたのに、",
          "tc": "櫻花好不容易才綻放，",
          "sc": "樱花好不容易才绽放，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142581,
          "spk": "名护 (ナゴ)",
          "ja": "あいにくの雨だね……",
          "tc": "可惜天公不作美……",
          "sc": "可惜天公不作美……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142588,
          "spk": "名护 (ナゴ)",
          "ja": "散らないといいんだが……",
          "tc": "希望這場雨，不會把櫻花都打落了……",
          "sc": "希望这场雨，不会把樱花都打落了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1914,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142612,
          "spk": "名护 (ナゴ)",
          "ja": "少し冷たいけど、",
          "tc": "雖然有點涼，",
          "sc": "虽然有点凉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142619,
          "spk": "名护 (ナゴ)",
          "ja": "春風が心地いいな……",
          "tc": "但春風吹起來真舒服……",
          "sc": "但春风吹起来真舒服……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1915,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142643,
          "spk": "名护 (ナゴ)",
          "ja": "……雨が止むまで、",
          "tc": "……在雨停之前，",
          "sc": "……在雨停之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142650,
          "spk": "名护 (ナゴ)",
          "ja": "読みかけの本でも進めておくか",
          "tc": "來翻翻之前沒看完的書吧。",
          "sc": "来翻翻之前没看完的书吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1916,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142674,
          "spk": "名护 (ナゴ)",
          "ja": "金や財産って、あるところには",
          "tc": "有錢人真的是很有錢呢……",
          "sc": "有钱人真的是很有钱呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142681,
          "spk": "名护 (ナゴ)",
          "ja": "あるものなんだな……大きな屋敷だ",
          "tc": "好大的宅邸。",
          "sc": "好大的宅邸。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1917,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142712,
          "spk": "名护 (ナゴ)",
          "ja": "綺麗だからって、桜の枝を折っては駄目だぞ？",
          "tc": "就算櫻花很漂亮，也不能攀折枝幹喔！",
          "sc": "就算樱花很漂亮，也不能攀折枝干哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142730,
          "spk": "名护 (ナゴ)",
          "ja": "枝を折ると木も傷むし、",
          "tc": "折斷樹枝不僅會傷害樹木，",
          "sc": "折断树枝不仅会伤害树木，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142737,
          "spk": "名护 (ナゴ)",
          "ja": "来年の花つきも悪くなる",
          "tc": "也會影響明年的花開情況。",
          "sc": "也会影响明年的花开情况。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142744,
          "spk": "名护 (ナゴ)",
          "ja": "ちゃんと大事にしないとな",
          "tc": "得好好保護才行。",
          "sc": "得好好保护才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1918,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142768,
          "spk": "名护 (ナゴ)",
          "ja": "美しい自然と人が共存していくには",
          "tc": "你覺得人類該怎麼做，",
          "sc": "你觉得人类该怎么做，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142775,
          "spk": "名护 (ナゴ)",
          "ja": "どうすればいいと思う？",
          "tc": "才能與美麗的自然共存下去？",
          "sc": "才能与美丽的自然共存下去？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142786,
          "spk": "名护 (ナゴ)",
          "ja": "ずっと考えてるが、答えは見つからないよ",
          "tc": "我一直在思考，但始終找不到答案。",
          "sc": "我一直在思考，但始终找不到答案。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1919,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142817,
          "spk": "名护 (ナゴ)",
          "ja": "こういう雨の日は、",
          "tc": "像這樣的雨天，",
          "sc": "像这样的雨天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142824,
          "spk": "名护 (ナゴ)",
          "ja": "いつもより周りが静かに感じるな",
          "tc": "感覺四周比平時還要安靜許多，",
          "sc": "感觉四周比平时还要安静许多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142835,
          "spk": "名护 (ナゴ)",
          "ja": "雨の音はしてるのに、不思議だね",
          "tc": "明明還有雨聲，真是不可思議。",
          "sc": "明明还有雨声，真是不可思议。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1920,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142866,
          "spk": "名护 (ナゴ)",
          "ja": "村の景観には何の文句もないけど、",
          "tc": "我對村子的景色沒有任何不滿，",
          "sc": "我对村子的景色没有任何不满，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142873,
          "spk": "名护 (ナゴ)",
          "ja": "住人の倫理観には戸惑うことが多いよ……",
          "tc": "但居民的道德觀，倒是常常讓我感到困惑……",
          "sc": "但居民的道德观，倒是常常让我感到困惑……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1921,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142904,
          "spk": "名护 (ナゴ)",
          "ja": "……いつかこの光景が",
          "tc": "……這片景象總有一天，",
          "sc": "……这片景象总有一天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142911,
          "spk": "名护 (ナゴ)",
          "ja": "春の思い出になっていくんだろうな",
          "tc": "會逐漸成為我對春天的回憶吧。",
          "sc": "会逐渐成为我对春天的回忆吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1922,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142935,
          "spk": "名护 (ナゴ)",
          "ja": "聞こえてくるのは自然の音だけ",
          "tc": "只聽得到大自然的聲音，",
          "sc": "只听得到大自然的声音，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142953,
          "spk": "名护 (ナゴ)",
          "ja": "こういう生活も、悪くないものだな",
          "tc": "這種生活也不錯呢。",
          "sc": "这种生活也不错呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1923,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142977,
          "spk": "名护 (ナゴ)",
          "ja": "……あぢっ！",
          "tc": "……好燙！",
          "sc": "……好烫！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142988,
          "spk": "名护 (ナゴ)",
          "ja": "もうちょっと冷ました方がいいな……",
          "tc": "還是放涼一點再喝比較好……",
          "sc": "还是放凉一点再喝比较好……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142995,
          "spk": "名护 (ナゴ)",
          "ja": "温かいうちに飲まないともったいない気がして、",
          "tc": "覺得不趁熱喝有點可惜，",
          "sc": "觉得不趁热喝有点可惜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143002,
          "spk": "名护 (ナゴ)",
          "ja": "いつも急いでしまうんだ……",
          "tc": "總是不小心急了點……",
          "sc": "总是不小心急了点……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1924,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143026,
          "spk": "名护 (ナゴ)",
          "ja": "受験勉強をしていた頃も",
          "tc": "我以前準備考試的時候，",
          "sc": "我以前准备考试的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143033,
          "spk": "名护 (ナゴ)",
          "ja": "よくコーヒーを飲んでいたよ",
          "tc": "也很常喝咖啡呢。",
          "sc": "也很常喝咖啡呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143040,
          "spk": "名护 (ナゴ)",
          "ja": "今思うと懐かしいな……",
          "tc": "真令人懷念……",
          "sc": "真令人怀念……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1925,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143064,
          "spk": "名护 (ナゴ)",
          "ja": "本のジャンルや巻数がバラバラに収まってると、",
          "tc": "如果書的種類和集數擺得亂七八糟，",
          "sc": "如果书的种类和集数摆得乱七八糟，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143071,
          "spk": "名护 (ナゴ)",
          "ja": "なぜか体がムズムズするんだ……",
          "tc": "感覺心裡真不踏實……",
          "sc": "感觉心里真不踏实……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143078,
          "spk": "名护 (ナゴ)",
          "ja": "整理しておこう……",
          "tc": "整理一下好了……",
          "sc": "整理一下好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1926,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143102,
          "spk": "名护 (ナゴ)",
          "ja": "本は知識の宝庫だ",
          "tc": "書是知識的寶庫。",
          "sc": "书是知识的宝库。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143113,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんくらいの年から、",
          "tc": "從<player>你這個年齡開始",
          "sc": "从<player>你这个年龄开始"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143120,
          "spk": "名护 (ナゴ)",
          "ja": "読む習慣をつけておいて損はない",
          "tc": "就養成讀書的習慣是百利而無一害的，",
          "sc": "就养成读书的习惯是百利而无一害的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143127,
          "spk": "名护 (ナゴ)",
          "ja": "きっと今後に活きてくるからね",
          "tc": "一定會對未來有所幫助。",
          "sc": "一定会对未来有所帮助。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1927,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143151,
          "spk": "名护 (ナゴ)",
          "ja": "村の歴史をまとめた本もあるんだ",
          "tc": "這裡也有彙整了村子歷史的書籍。",
          "sc": "这里也有汇整了村子历史的书籍。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143169,
          "spk": "名护 (ナゴ)",
          "ja": "俺も読んでるけど、",
          "tc": "我也正在看，",
          "sc": "我也正在看，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143176,
          "spk": "名护 (ナゴ)",
          "ja": "なかなか興味深いぞ？",
          "tc": "還滿有意思的喔！",
          "sc": "还满有意思的哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1928,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143200,
          "spk": "名护 (ナゴ)",
          "ja": "一日中、何も考えずに",
          "tc": "好久沒有像這樣什麼都不去想，",
          "sc": "好久没有像这样什么都不去想，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143207,
          "spk": "名护 (ナゴ)",
          "ja": "ぼんやりして過ごすなんて久しぶりだ……",
          "tc": "放空度過一整天了……",
          "sc": "放空度过一整天了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143218,
          "spk": "名护 (ナゴ)",
          "ja": "村に来る前は、",
          "tc": "來到這個村子之前，",
          "sc": "来到这个村子之前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143225,
          "spk": "名护 (ナゴ)",
          "ja": "時間に追われてたもんな……",
          "tc": "總是被時間追著跑……",
          "sc": "总是被时间追着跑……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1929,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143249,
          "spk": "名护 (ナゴ)",
          "ja": "結構持ち出してきちゃったけど……",
          "tc": "帶出來的書有點多……",
          "sc": "带出来的书有点多……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143260,
          "spk": "名护 (ナゴ)",
          "ja": "利用者も少ないし",
          "tc": "反正也沒什麼人去圖書館，",
          "sc": "反正也没什么人去图书馆，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143267,
          "spk": "名护 (ナゴ)",
          "ja": "まあいいか……",
          "tc": "應該沒關係吧……",
          "sc": "应该没关系吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1930,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143291,
          "spk": "名护 (ナゴ)",
          "ja": "図書館を整理しながら、",
          "tc": "整理圖書館的時候，",
          "sc": "整理图书馆的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143298,
          "spk": "名护 (ナゴ)",
          "ja": "つい本を読んでしまうんだが……",
          "tc": "也養成了讀書的習慣……",
          "sc": "也养成了读书的习惯……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143305,
          "spk": "名护 (ナゴ)",
          "ja": "この村の習俗や伝承、結構面白いんだ",
          "tc": "這個村子的習俗與傳說很有意思。",
          "sc": "这个村子的习俗与传说很有意思。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143316,
          "spk": "名护 (ナゴ)",
          "ja": "保存状態がよかったら、",
          "tc": "要是保存狀態能好一點",
          "sc": "要是保存状态能好一点"
        },
        {
          "f_idx": 4,
          "pidx_tc": 143323,
          "spk": "名护 (ナゴ)",
          "ja": "なおいいんだけどな……",
          "tc": "就更棒了……",
          "sc": "就更棒了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1931,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143347,
          "spk": "名护 (ナゴ)",
          "ja": "人の歴史というのは、",
          "tc": "人類的歷史，",
          "sc": "人类的历史，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143354,
          "spk": "名护 (ナゴ)",
          "ja": "どうしていつもこうなんだろう",
          "tc": "為什麼總是這樣呢。",
          "sc": "为什么总是这样呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 143365,
          "spk": "名护 (ナゴ)",
          "ja": "この村でも、少なくない血が流れている……",
          "tc": "即便是這座村子，也流過不少血……",
          "sc": "即便是这座村子，也流过不少血……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1932,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143396,
          "spk": "名护 (ナゴ)",
          "ja": "これはうまい……",
          "tc": "這個真好吃……",
          "sc": "这个真好吃……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143403,
          "spk": "名护 (ナゴ)",
          "ja": "質素な味付けだが、どこかコクがある……",
          "tc": "味道樸實，但卻很有層次感……",
          "sc": "味道朴实，但却很有层次感……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 143421,
          "spk": "名护 (ナゴ)",
          "ja": "ロッカクさんからおすそ分けしてもらったんだ",
          "tc": "這是六角先生分給我的，",
          "sc": "这是六角先生分给我的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 143428,
          "spk": "名护 (ナゴ)",
          "ja": "気にかけてくれて、ありがたいよ",
          "tc": "真的很感謝他關心我。",
          "sc": "真的很感谢他关心我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1933,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143452,
          "spk": "名护 (ナゴ)",
          "ja": "……間に合わせの物だけじゃなくて",
          "tc": "……不能老是吃現成的東西，",
          "sc": "……不能老是吃现成的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 143459,
          "spk": "名护 (ナゴ)",
          "ja": "いつか、料理にも本腰を入れないと",
          "tc": "哪天也得認真做菜才行呢。",
          "sc": "哪天也得认真做菜才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1934,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 143490,
          "spk": "名护 (ナゴ)",
