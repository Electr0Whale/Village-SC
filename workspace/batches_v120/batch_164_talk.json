        {
          "f_idx": 5,
          "pidx_tc": 185036,
          "spk": "红衣商人 (？？？)",
          "ja": "くれぐれも、足元にはお気をつけなされ",
          "tc": "請千萬要多注意腳邊。",
          "sc": "请千万要多注意脚边。"
        }
      ]
    },
    {
      "file": "talk.dat",
