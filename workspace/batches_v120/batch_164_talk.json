        },
        {
          "f_idx": 4,
          "pidx_tc": 185097,
          "spk": "红衣商人 (？？？)",
          "ja": "されど夜道は長く、",
          "tc": "然而夜路漫長，",
          "sc": "然而夜路漫长，"
