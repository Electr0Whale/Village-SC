      "file": "talk.dat",
      "rec_idx": 3368,
      "rec_id": "TALK_ID_40_0030_121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 184596,
          "spk": "林 (リン)",
          "ja": "まさかあなた……",
          "tc": "你該不會……",
          "sc": "你该不会……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 184603,
          "spk": "林 (リン)",
          "ja": "お金が無いって言うんじゃないでしょうね？",
          "tc": "要跟我說沒錢吧？",
          "sc": "要跟我说没钱吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 184610,
          "spk": "林 (リン)",
          "ja": "なんで「買う」なんて言ったのよ！",
          "tc": "那你幹嘛說要買！",
          "sc": "那你干嘛说要买！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 184621,
          "spk": "林 (リン)",
          "ja": "そんなに欲しいなら、",
          "tc": "真的那麼想買的話，",
          "sc": "真的那么想买的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 184628,
          "spk": "林 (リン)",
          "ja": "村の人たちに頭を下げて",
          "tc": "就去跟村子裡的人低頭借錢",
          "sc": "就去跟村子里的人低头借钱"
        },
        {
          "f_idx": 5,
          "pidx_tc": 184635,
          "spk": "林 (リン)",
          "ja": "借りて集めて来なさいよ！",
          "tc": "再來找我啊！",
          "sc": "再来找我啊！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 184646,
          "spk": "林 (リン)",
          "ja": "それが嫌だったら、",
          "tc": "不想求別人的話，",
          "sc": "不想求别人的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184653,
          "spk": "林 (リン)",
          "ja": "一生懸命今ある畑を耕すことね！",
          "tc": "就好好去耕作你現在有的田地！",
          "sc": "就好好去耕作你现在有的田地！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3369,
      "rec_id": "TALK_ID_40_0030_130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 184682,
          "spk": "林 (リン)",
          "ja": "はあぁ？　なんですって？",
          "tc": "啊？你說什麼？",
          "sc": "啊？你说什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 184689,
          "spk": "林 (リン)",
          "ja": "ここに来てやっぱりやめるなんて",
          "tc": "居然到了這一步還要放棄，",
          "sc": "居然到了这一步还要放弃，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 184696,
          "spk": "林 (リン)",
          "ja": "バカのすることよ！",
          "tc": "只有笨蛋會這麼做！",
          "sc": "只有笨蛋会这么做！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 184707,
          "spk": "林 (リン)",
          "ja": "今買わないなら、",
          "tc": "你現在不買的話，",
          "sc": "你现在不买的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 184714,
          "spk": "林 (リン)",
          "ja": "別の人が買ってしまうかもしれないけれど……",
          "tc": "說不定會被別人買走……",
          "sc": "说不定会被别人买走……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 184721,
          "spk": "林 (リン)",
          "ja": "まあ、しょうがないわよね……",
          "tc": "算了，拿你沒辦法……",
          "sc": "算了，拿你没办法……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 184732,
          "spk": "林 (リン)",
          "ja": "もしかしたら、まだ売れていないかもしれない",
          "tc": "之後也是有可能還沒賣掉。",
          "sc": "之后也是有可能还没卖掉。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184739,
          "spk": "林 (リン)",
          "ja": "だから、気が向いたら",
          "tc": "所以，等你想買的時候",
          "sc": "所以，等你想买的时候"
        },
        {
          "f_idx": 8,
          "pidx_tc": 184746,
          "spk": "林 (リン)",
          "ja": "また呼んでちょうだい",
          "tc": "再找我來吧。",
          "sc": "再找我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3370,
      "rec_id": "TALK_ID_50_0001_001",
      "lines": [
