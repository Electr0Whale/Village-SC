          "spk": "红衣商人 (？？？)",
          "ja": "一つ五百文で譲ろうかと思うが",
          "tc": "就賣你一支五百文吧。",
          "sc": "就卖你一支五百文吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184905,
          "spk": "红衣商人 (？？？)",
          "ja": "買うかえ？",
          "tc": "要買嗎？",
          "sc": "要买吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 184914,
          "spk": "红衣商人 (？？？)",
          "ja": "おやおや……",
          "tc": "哎呀哎呀……",
          "sc": "哎呀哎呀……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 184921,
          "spk": "红衣商人 (？？？)",
          "ja": "またお越しかね、お客人",
          "tc": "這位客官，你又來了呢。",
          "sc": "这位客官，你又来了呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 184930,
          "spk": "红衣商人 (？？？)",
          "ja": "ふふ……",
          "tc": "呵呵……",
          "sc": "呵呵……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 184937,
          "spk": "红衣商人 (？？？)",
          "ja": "さては、蝋燭が尽き申したか",
