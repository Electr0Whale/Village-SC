      "rec_id": "TALK_ID_50_0005_004",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 185063,
          "spk": "红衣商人 (？？？)",
          "ja": "ふふ、ふふふ……",
          "tc": "呵呵、呵呵呵……",
          "sc": "呵呵、呵呵呵……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 185072,
          "spk": "红衣商人 (？？？)",
          "ja": "ケチな者は、いずれ身を滅ぼす",
          "tc": "吝嗇之人，終將自取滅亡。",
          "sc": "吝啬之人，终将自取灭亡。"
        },
        {
