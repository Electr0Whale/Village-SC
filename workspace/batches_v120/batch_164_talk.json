          "pidx_tc": 184768,
          "spk": "主角心声/旁白/选项",
          "ja": "なにかがあらわれたみたい……",
          "tc": "好像有什麼出現了……",
          "sc": "好像有什么出现了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3372,
      "rec_id": "TALK_ID_50_0005_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 184795,
          "spk": "红衣商人 (？？？)",
          "ja": "おや……",
          "tc": "哎呀……",
          "sc": "哎呀……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 184802,
          "spk": "红衣商人 (？？？)",
          "ja": "また顔を見せおったか、お客人",
          "tc": "這位客官，你又來露臉了啊。",
          "sc": "这位客官，你又来露脸了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 184811,
          "spk": "红衣商人 (？？？)",
          "ja": "ふふ……蝋燭は",
          "tc": "呵呵……",
          "sc": "呵呵……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 184818,
          "spk": "红衣商人 (？？？)",
          "ja": "まだ残っているであろう",
          "tc": "蠟燭應該還有剩吧。",
          "sc": "蜡烛应该还有剩吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 184827,
          "spk": "红衣商人 (？？？)",
          "ja": "それが尽きた折に、",
          "tc": "等用盡之際，",
          "sc": "等用尽之际，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 184834,
          "spk": "红衣商人 (？？？)",
          "ja": "またここへお越しなされ",
          "tc": "請再到這裡來。",
          "sc": "请再到这里来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3373,
      "rec_id": "TALK_ID_50_0005_002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 184850,
          "spk": "红衣商人 (？？？)",
          "ja": "おやおや……お客人",
          "tc": "哎呀哎呀……這位客官。",
          "sc": "哎呀哎呀……这位客官。"
