  "record_count": 28,
  "line_count": 196,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3344,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 182769,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチらも子どもの頃は、",
          "tc": "我們小的時候，",
          "sc": "我们小的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 182776,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まぁ毎年飽きることなく、雪が積もると",
          "tc": "每年一下雪就會興奮得不得了，",
          "sc": "每年一下雪就会兴奋得不得了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 182783,
          "spk": "琪娜娜 (チナナ)",
          "ja": "朝から晩まで遊び回ったものだったねえ",
          "tc": "跑去外面從早玩到晚呢。",
          "sc": "跑去外面从早玩到晚呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 182796,
          "spk": "莲实 (ハスミ)",
          "ja": "懐かしいわね",
          "tc": "真讓人懷念。",
          "sc": "真让人怀念。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 182803,
          "spk": "莲实 (ハスミ)",
          "ja": "雪合戦に、雪だるま作り……それに",
          "tc": "打雪仗跟堆雪人……",
          "sc": "打雪仗跟堆雪人……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 182810,
          "spk": "莲实 (ハスミ)",
          "ja": "かまくらもがんばって作っていたわね",
          "tc": "我記得也努力蓋了雪屋吧。",
          "sc": "我记得也努力盖了雪屋吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 182823,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうそう、できあがったかまくらに",
          "tc": "對對對，",
          "sc": "对对对，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 182830,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おしるこを持ちこんだりもしてさ",
          "tc": "還會把紅豆麻糬湯端進蓋好的雪屋裡吃呢。",
          "sc": "还会把红豆年糕汤端进盖好的雪屋里吃呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 182848,
          "spk": "琪娜娜 (チナナ)",
          "ja": "不思議と、普段食べているよりも",
          "tc": "神奇的是，在裡面吃東西的時候，",
          "sc": "神奇的是，在里面吃东西的时候，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 182855,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おいしく感じられたんだよね",
          "tc": "會覺得比平常還好吃耶。",
          "sc": "会觉得比平常还好吃呢。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 182868,
          "spk": "莲实 (ハスミ)",
          "ja": "非日常のワクワクが",
          "tc": "可能是跳脫日常的興奮感",
          "sc": "可能是跳脱日常的兴奋感"
        },
        {
          "f_idx": 12,
          "pidx_tc": 182875,
          "spk": "莲实 (ハスミ)",
          "ja": "そう感じさせたのかもしれないわね",
          "tc": "讓我們產生了那種感覺吧。",
          "sc": "让我们产生了那种感觉吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 182888,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう一度、味わってみたいものだけど……",
          "tc": "我還滿想再體驗一次的……",
          "sc": "我还满想再体验一次的……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 182895,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうは言っても、ねえ？",
          "tc": "但說是這麼說，妳懂吧？",
          "sc": "但说是这么说，你懂吧？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 182908,
          "spk": "莲实 (ハスミ)",
          "ja": "……かまくらを作ろうという",
          "tc": "……我已經提不起勁",
          "sc": "……我已经提不起劲"
        },
        {
          "f_idx": 16,
          "pidx_tc": 182915,
          "spk": "莲实 (ハスミ)",
          "ja": "気力は起きないわね",
          "tc": "去蓋雪屋了。",
          "sc": "去盖雪屋了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 182926,
          "spk": "莲实 (ハスミ)",
          "ja": "筋肉痛になったら仕事に支障がでそうとか",
          "tc": "而且感覺會浮現很多顧慮，",
          "sc": "而且感觉会浮现很多顾虑，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 182933,
          "spk": "莲实 (ハスミ)",
          "ja": "いろいろな考えも頭をよぎりそうだし",
          "tc": "像是擔心肌肉痠痛會影響到工作之類的。",
          "sc": "像是担心肌肉酸痛会影响到工作之类的。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 182953,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう、無心で遊ぶことはできないか",
          "tc": "我們已經無法天真單純地玩耍了啊。",
          "sc": "我们已经无法天真单纯地玩耍了啊。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 182960,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……大人になったってことだね",
          "tc": "……這就是長大了吧。",
          "sc": "……这就是长大了吧。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 182971,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、かまくらは難しくても",
          "tc": "唉～雖然雪屋有點難，",
          "sc": "唉～虽然雪屋有点难，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 182978,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おしるこを作るくらいならできそうだね",
          "tc": "但煮個紅豆麻糬湯還是沒問題的吧。",
          "sc": "但煮个红豆年糕汤还是没问题的吧。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 182985,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寒い日に食べたら、格別の味がするよ",
          "tc": "在天冷的時候吃起來會格外美味喔。",
          "sc": "在天冷的时候吃起来会格外美味哦。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 182998,
          "spk": "莲实 (ハスミ)",
          "ja": "そうねえ……おしるこもいいけど",
          "tc": "也對……紅豆麻糬湯是不錯，",
          "sc": "也对……红豆年糕汤是不错，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 183005,
          "spk": "莲实 (ハスミ)",
          "ja": "どちらかと言えば、ほうじ茶の方がいいわ",
          "tc": "但真要說的話，我更想來杯焙茶呢。",
          "sc": "但真要说的话，我更想来杯焙茶呢。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 183016,
          "spk": "莲实 (ハスミ)",
          "ja": "寒い日と言えば、ほうじ茶",
          "tc": "講到寒冷的日子就會想起焙茶。",
          "sc": "讲到寒冷的日子就会想起焙茶。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 183023,
          "spk": "莲实 (ハスミ)",
          "ja": "飲むとホッと温まるの",
          "tc": "喝下去讓人溫暖又放鬆。",
          "sc": "喝下去让人温暖又放松。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 183036,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おしるこよりもほうじ茶、か……",
          "tc": "比起紅豆麻糬湯更想喝焙茶啊……",
          "sc": "比起红豆年糕汤更想喝焙茶啊……"
        },
        {
          "f_idx": 30,
          "pidx_tc": 183043,
          "spk": "琪娜娜 (チナナ)",
          "ja": "本当、大人になったものだよねえ",
          "tc": "真的是長大了呢。",
          "sc": "真的是长大了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3345,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183071,
          "spk": "木助 (キスケ)",
          "ja": "スミレ、お前の姉ちゃん、すげぇな",
          "tc": "堇怜，你姊姊真是了不起。",
          "sc": "堇怜，你姐姐真是了不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 183078,
          "spk": "木助 (キスケ)",
          "ja": "今日も朝から寒い中",
          "tc": "今天也是一早就頂著寒風，",
          "sc": "今天也是一早就顶着寒风，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 183085,
          "spk": "木助 (キスケ)",
          "ja": "あっちこっちに走り回ってたぜ",
          "tc": "四處來回奔走啊。",
          "sc": "四处来回奔走啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 183098,
          "spk": "堇怜 (スミレ)",
          "ja": "あれ、寒さに強いみたいな顔してますけど、",
          "tc": "她啊，雖然一臉不把低溫放在眼裡的表情，",
          "sc": "她啊，虽然一脸不把低温放在眼里的表情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 183105,
          "spk": "堇怜 (スミレ)",
          "ja": "家だと明らかに動き鈍いんで、",
          "tc": "但在家裡的時候，動作明顯變得慢很多，",
          "sc": "但在家里的时候，动作明显变得慢很多，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 183112,
          "spk": "堇怜 (スミレ)",
          "ja": "たぶん無理してるだけなんですよ",
          "tc": "大概是在硬撐啦。",
          "sc": "大概是在硬撑啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 183125,
          "spk": "木助 (キスケ)",
          "ja": "……そこまで見てるなら、",
          "tc": "……你都觀察到這種細節了，",
          "sc": "……你都观察到这种细节了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 183132,
          "spk": "木助 (キスケ)",
          "ja": "強いフリって言い切っていいだろ",
          "tc": "可以直接說她不怕冷就是裝出來的吧。",
          "sc": "可以直接说她不怕冷就是装出来的吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 183145,
          "spk": "堇怜 (スミレ)",
          "ja": "それに、たまに",
          "tc": "但她有時候",
          "sc": "但她有时候"
        },
        {
          "f_idx": 9,
          "pidx_tc": 183152,
          "spk": "堇怜 (スミレ)",
          "ja": "妙に顔が赤い時あるんだよなぁ……",
          "tc": "臉會莫名地變得很紅……",
          "sc": "脸会莫名地变得很红……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 183165,
          "spk": "堇怜 (スミレ)",
          "ja": "あれ、寒さっていうより、",
          "tc": "那與其說是天氣冷導致的，",
          "sc": "那与其说是天气冷导致的，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 183172,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと熱っぽい感じなんで心配してて……",
          "tc": "倒是會讓人擔心她是不是發燒了……",
          "sc": "倒是会让人担心她是不是发烧了……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 183192,
          "spk": "木助 (キスケ)",
          "ja": "ああ、それは多分呑んで……",
          "tc": "啊，那大概是因為喝了……",
          "sc": "啊，那大概是因为喝了……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 183205,
          "spk": "木助 (キスケ)",
          "ja": "……いや、寒さで",
          "tc": "……沒事，",
          "sc": "……没事，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 183212,
          "spk": "木助 (キスケ)",
          "ja": "血行がよくなってるだけだろうよ",
          "tc": "應該只是因為天氣冷讓血液循環變好了吧。",
          "sc": "应该只是因为天气冷让血液循环变好了吧。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 183225,
          "spk": "堇怜 (スミレ)",
          "ja": "……今、一瞬なんか言いかけませんでした？",
          "tc": "……你剛剛是不是原本想說別的事？",
          "sc": "……你刚刚是不是原本想说别的事？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 183236,
          "spk": "木助 (キスケ)",
          "ja": "……気のせいだぜ",
          "tc": "……你想太多了。",
          "sc": "……你想太多了。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 183251,
          "spk": "堇怜 (スミレ)",
          "ja": "でもあの赤さ、",
          "tc": "可是那臉紅的程度，",
          "sc": "可是那脸红的程度，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 183258,
          "spk": "堇怜 (スミレ)",
          "ja": "どう見ても風邪の初期症状っぽいんですよね",
          "tc": "怎麼看都像是感冒的初期症狀。",
          "sc": "怎么看都像是感冒的初期症状。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 183271,
          "spk": "堇怜 (スミレ)",
          "ja": "あと、近くにいると、",
          "tc": "還有，靠近她的話",
          "sc": "还有，靠近她的话"
        },
        {
          "f_idx": 21,
          "pidx_tc": 183278,
          "spk": "堇怜 (スミレ)",
          "ja": "たまに甘いような変な匂いがして……",
          "tc": "有時還會聞到某種奇妙的甜味……",
          "sc": "有时还会闻到某种奇妙的甜味……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 183291,
          "spk": "木助 (キスケ)",
          "ja": "匂いか……",
          "tc": "甜味啊……",
          "sc": "甜味啊……"
        },
        {
          "f_idx": 23,
          "pidx_tc": 183298,
          "spk": "木助 (キスケ)",
          "ja": "……匂いは、ええっと",
          "tc": "這個嘛……",
          "sc": "这个嘛……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 183311,
          "spk": "堇怜 (スミレ)",
          "ja": "……ああ、なるほど！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 25,
          "pidx_tc": 183318,
          "spk": "堇怜 (スミレ)",
          "ja": "たぶん風邪薬ですね！",
          "tc": "應該是感冒藥吧！",
          "sc": "应该是感冒药吧！"
        },
        {
          "f_idx": 26,
          "pidx_tc": 183325,
          "spk": "堇怜 (スミレ)",
          "ja": "ああいうのってちょっと独特な匂いしますからね",
          "tc": "有些藥聞起來會有種獨特的味道嘛。",
          "sc": "有些药闻起来会有种独特的味道嘛。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 183338,
          "spk": "木助 (キスケ)",
          "ja": "……まあ、そういうことにしておけ",
          "tc": "……就當作是這麼一回事吧。",
          "sc": "……就当作是这么一回事吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3351,
      "rec_id": "TALK_ID_40_0020_000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183765,
          "spk": "木助 (キスケ)",
          "ja": "オーイ！",
          "tc": "喂──！",
          "sc": "喂——！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3352,
      "rec_id": "TALK_ID_40_0020_010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183785,
          "spk": "木助 (キスケ)",
          "ja": "オイオイオイ……",
          "tc": "喂喂喂……",
          "sc": "喂喂喂……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 183792,
          "spk": "木助 (キスケ)",
          "ja": "なんじゃこりゃ……！",
          "tc": "這是什麼啊……！",
          "sc": "这是什么啊……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3353,
      "rec_id": "TALK_ID_40_0020_020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183810,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ……大丈夫か？",
          "tc": "你這傢伙……沒事吧？",
          "sc": "你这家伙……没事吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3354,
      "rec_id": "TALK_ID_40_0020_030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183828,
          "spk": "木助 (キスケ)",
          "ja": "まさかこれは、てめぇの仕業か？",
          "tc": "這難道是你搞的鬼嗎？",
          "sc": "这难道是你搞的鬼吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 183835,
          "spk": "木助 (キスケ)",
          "ja": "まさか出ちまうなんて……！",
          "tc": "沒想到居然冒出來了……！",
          "sc": "没想到居然冒出来了……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3355,
      "rec_id": "TALK_ID_40_0020_040",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183853,
          "spk": "木助 (キスケ)",
          "ja": "こりゃ温泉だぜ！！",
          "tc": "這可是溫泉耶！！",
          "sc": "这可是温泉呢！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 183866,
          "spk": "木助 (キスケ)",
          "ja": "よくやったな、<player>！",
          "tc": "幹得好啊，<player>！",
          "sc": "干得好啊，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 183873,
          "spk": "木助 (キスケ)",
          "ja": "これでいつでも",
          "tc": "這樣一來，",
          "sc": "这样一来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 183880,
          "spk": "木助 (キスケ)",
          "ja": "マジの温泉に入れちまうぞ！",
          "tc": "隨時都能泡到真正的溫泉了！",
          "sc": "随时都能泡到真正的温泉了！"
