        {
          "f_idx": 5,
          "pidx_tc": 185104,
          "spk": "红衣商人 (？？？)",
          "ja": "闇の中には「あれ」もおるゆえ……",
          "tc": "黑暗當中還有「那個」存在……",
          "sc": "黑暗当中还有“那个”存在……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 185113,
          "spk": "红衣商人 (？？？)",
          "ja": "せいぜい、気をつけて行かれよ……",
          "tc": "路上請多加留意……",
          "sc": "路上请多加留意……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 185120,
          "spk": "红衣商人 (？？？)",
          "ja": "ふふ、ふふふ……",
          "tc": "呵呵、呵呵呵……",
          "sc": "呵呵、呵呵呵……"
        }
      ]
    },
