      "rec_id": "TALK_ID_40_0030_030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 184279,
          "spk": "林 (リン)",
          "ja": "はあぁ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 184286,
          "spk": "林 (リン)",
          "ja": "じゃあなんのために",
          "tc": "那你叫我過來",
          "sc": "那你叫我过来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 184293,
          "spk": "林 (リン)",
          "ja": "私をここに呼んだわけ？",
          "tc": "做什麼？",
          "sc": "做什么？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 184304,
          "spk": "林 (リン)",
          "ja": "忙しい私を捕まえて、",
          "tc": "居然讓我從百忙之中過來，",
          "sc": "居然让我从百忙之中过来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 184311,
          "spk": "林 (リン)",
          "ja": "無駄に時間を取らせるなんて……",
          "tc": "還浪費我的時間……",
          "sc": "还浪费我的时间……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 184318,
          "spk": "林 (リン)",
          "ja": "罰金ものよ",
          "tc": "簡直該罰你錢！",
          "sc": "简直该罚你钱！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 184329,
          "spk": "林 (リン)",
          "ja": "……まあいいわ",
          "tc": "……算了。",
          "sc": "……算了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184336,
          "spk": "林 (リン)",
          "ja": "気が向いたら",
          "tc": "等你想買的時候",
          "sc": "等你想买的时候"
        },
        {
          "f_idx": 8,
          "pidx_tc": 184343,
          "spk": "林 (リン)",
          "ja": "また呼んでちょうだい",
          "tc": "再找我來吧。",
          "sc": "再找我来吧。"
        }
      ]
    },
    {
