      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 183981,
          "spk": "林 (リン)",
          "ja": "私があげた土地では",
          "tc": "聽說你覺得",
          "sc": "听说你觉得"
        },
        {
          "f_idx": 1,
          "pidx_tc": 183988,
          "spk": "林 (リン)",
          "ja": "満足できなかったって聞いて",
          "tc": "光是我之前提供的土地還不夠，",
          "sc": "光是我之前提供的土地还不够，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 183995,
          "spk": "林 (リン)",
          "ja": "駆けつけてあげたわ",
          "tc": "我就大發慈悲趕過來了。",
          "sc": "我就大发慈悲赶过来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 184006,
          "spk": "林 (リン)",
          "ja": "値段、見たわよね？",
          "tc": "你有看到價錢對吧？",
          "sc": "你看到价钱了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 184013,
          "spk": "林 (リン)",
          "ja": "一括払いじゃないと",
          "tc": "必須一次付清，",
          "sc": "必须一次付清，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 184020,
          "spk": "林 (リン)",
          "ja": "売らないわよ",
          "tc": "我才會賣喔！",
          "sc": "我才会卖哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 184031,
          "spk": "林 (リン)",
          "ja": "５，０００円ポッキリよ",
          "tc": "只要5,000元整。",
          "sc": "只要5,000元整。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184038,
          "spk": "林 (リン)",
          "ja": "支払う準備は",
          "tc": "你應該已經準備好",
          "sc": "你应该已经准备好"
        },
        {
          "f_idx": 8,
          "pidx_tc": 184045,
          "spk": "林 (リン)",
          "ja": "できているんでしょうね？",
          "tc": "要付錢了吧？",
          "sc": "要付钱了吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 184054,
          "spk": "主角心声/旁白/选项",
