          "pidx_tc": 184417,
          "spk": "林 (リン)",
          "ja": "心配いらないわよ、印鑑もいらない",
          "tc": "不需要擔心，連印章也不用，",
          "sc": "不需要担心，连印章也不用，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 184424,
          "spk": "林 (リン)",
          "ja": "お金さえ払ってくれればね！",
          "tc": "只要付錢就沒問題！",
          "sc": "只要付钱就没问题！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 184431,
          "spk": "林 (リン)",
          "ja": "２０，０００円、さあ、払ってくれるのよね？",
          "tc": "20,000元，來～你願意付吧？",
          "sc": "20,000元，来～你愿意付吧？"
