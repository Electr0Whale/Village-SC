        {
          "f_idx": 14,
          "pidx_tc": 184962,
          "spk": "主角心声/旁白/选项",
          "ja": "かう",
          "tc": "購買",
          "sc": "购买"
        },
        {
          "f_idx": 15,
          "pidx_tc": 184969,
