          "pidx_tc": 355188,
          "spk": "<player> (主角)",
          "ja": "あの村のみんなは",
          "tc": "那座村子裡的居民，",
          "sc": "那座村子里的居民，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355195,
          "spk": "<player> (主角)",
          "ja": "大切な人たちだから、",
          "tc": "都是很重要的人。",
          "sc": "都是很重要的人。"
        },
