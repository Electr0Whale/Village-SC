      "rec_id": "TALK_ID_10_0500_033_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293182,
          "spk": "帷 (トバリ)",
          "ja": "そう……そうだよね",
          "tc": "這樣啊……說得也是呢。",
          "sc": "这样啊……说得也是呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293189,
          "spk": "帷 (トバリ)",
          "ja": "ごめんなさい……",
          "tc": "對不起……",
          "sc": "对不起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293196,
          "spk": "帷 (トバリ)",
          "ja": "私が言い出したのに弱気になってしまって……",
          "tc": "明明是我提議的，現在卻害怕了起來……",
          "sc": "明明是我提议的，现在却害怕了起来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293207,
          "spk": "帷 (トバリ)",
          "ja": "行こう、<player>",
          "tc": "走吧，<player>。",
          "sc": "走吧，<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293214,
          "spk": "帷 (トバリ)",
          "ja": "コダマに会わないと",
          "tc": "得去見木珠才行。",
          "sc": "得去见木珠才行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 293221,
          "spk": "帷 (トバリ)",
          "ja": "土地神を倒すためにも……",
          "tc": "為了打倒土地神……",
          "sc": "为了打倒土地神……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 293230,
          "spk": "帷 (トバリ)",
          "ja": "扉、開けるね",
          "tc": "我要開門囉。",
          "sc": "我要开门喽。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8210,
      "rec_id": "TALK_ID_10_0500_033_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293252,
          "spk": "帷 (トバリ)",
          "ja": "そう……アンタもなのね",
          "tc": "是嗎……你跟我一樣呢。",
          "sc": "是吗……你跟我一样呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293263,
          "spk": "帷 (トバリ)",
          "ja": "いいよ、待ってる",
          "tc": "沒關係，我會等你。",
          "sc": "没关系，我会等你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293270,
          "spk": "帷 (トバリ)",
          "ja": "アンタの覚悟が決まるまで",
          "tc": "等你下定決心。",
          "sc": "等你下定决心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293281,
          "spk": "帷 (トバリ)",
          "ja": "行く気になったら、私に声をかけて",
          "tc": "你想去的時候，再跟我說一聲。",
          "sc": "你想去的时候，再跟我说一声。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8211,
      "rec_id": "TALK_ID_10_0502_203_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 308663,
          "spk": "名护 (ナゴ)",
          "ja": "いいのか？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 308670,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってもらえるなら、",
          "tc": "如果你願意幫忙，",
          "sc": "如果你愿意帮忙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 308677,
          "spk": "名护 (ナゴ)",
          "ja": "もちろんありがたいが",
          "tc": "我當然很高興。",
          "sc": "我当然很高兴。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 308690,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、<player>にも",
          "tc": "那麼，我也教<player>",
          "sc": "那么，我也教<player>"
        },
        {
          "f_idx": 4,
          "pidx_tc": 308697,
          "spk": "堇怜 (スミレ)",
          "ja": "「提灯」の作り方を教えてあげるよ",
          "tc": "怎麼製作「手提燈籠」吧。",
          "sc": "怎么制作“手提灯笼”吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8212,
      "rec_id": "TALK_ID_10_0502_203_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 308717,
          "spk": "堇怜 (スミレ)",
          "ja": "へえ……でもキミ、",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 308724,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだかんだ言って、",
          "tc": "不過你說是這麼說，",
          "sc": "不过你说是这么说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 308731,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさんについて峠に行くんじゃない？",
          "tc": "之後還是會跟著名護哥到隘口去吧？",
          "sc": "之后还是会跟着名护哥到隘口去吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8213,
      "rec_id": "TALK_ID_10_0502_205_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 309599,
          "spk": "名护 (ナゴ)",
          "ja": "わかった",
          "tc": "好吧，",
          "sc": "好吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 309606,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってくれてありがとう",
          "tc": "謝謝你幫忙。",
          "sc": "谢谢你帮忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 309617,
          "spk": "名护 (ナゴ)",
          "ja": "俺はもう少し探索を続けるよ",
          "tc": "我還要再繼續探索一下。",
          "sc": "我还要再继续探索一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 309628,
          "spk": "名护 (ナゴ)",
          "ja": "キミは、気をつけて家まで帰ってくれ",
          "tc": "你回家路上要小心喔！",
          "sc": "你回家路上要小心哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 309635,
          "spk": "名护 (ナゴ)",
          "ja": "夜中には、不気味なことが起きると聞くからね",
          "tc": "我聽說晚上會發生很詭異的事情。",
          "sc": "我听说晚上会发生很诡异的事情。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8214,
      "rec_id": "TALK_ID_10_0502_205_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 309664,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……！",
          "tc": "這樣啊……！",
          "sc": "这样啊……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 309671,
          "spk": "名护 (ナゴ)",
          "ja": "せっかく準備してここまで来たんだから、",
          "tc": "好不容易準備好，都走到這裡了，",
          "sc": "好不容易准备好，都走到这里了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 309678,
          "spk": "名护 (ナゴ)",
          "ja": "もう少し探索したいと思っていたんだ",
          "tc": "所以我本來就想說要再探索一下。",
          "sc": "所以我本来就想说要再探索一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 309689,
          "spk": "名护 (ナゴ)",
          "ja": "……いや、すまない",
          "tc": "……不，抱歉。",
          "sc": "……不，抱歉。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 309696,
          "spk": "名护 (ナゴ)",
          "ja": "訂正させてくれ……",
          "tc": "讓我修正一下……",
          "sc": "让我修正一下……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 309707,
          "spk": "名护 (ナゴ)",
          "ja": "こ、心細いから",
          "tc": "因、因為我很害怕，",
          "sc": "因、因为我很害怕，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 309714,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってくれるとありがたいんだ……",
          "tc": "要是你能幫忙就再好不過了……",
          "sc": "要是你能帮忙就再好不过了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 309721,
          "spk": "名护 (ナゴ)",
          "ja": "悪いけど、頼むよ……",
          "tc": "不好意思，拜託你了……",
          "sc": "不好意思，拜托你了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8215,
      "rec_id": "TALK_ID_10_0502_209_01_01",
      "lines": [
