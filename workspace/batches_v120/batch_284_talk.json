          "f_idx": 9,
          "pidx_tc": 354121,
          "spk": "木珠 (コダマ)",
          "ja": "そうすることを、選んだの……",
          "tc": "木珠才選擇了那麼做……",
          "sc": "木珠才选择了那么做……"
        },
