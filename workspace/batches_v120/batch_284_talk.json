    },
    {
      "file": "talk.dat",
      "rec_idx": 8253,
      "rec_id": "TALK_ID_10_0602_066_02_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355099,
          "spk": "木珠 (コダマ)",
          "ja": "どうやって……",
          "tc": "要怎麼做……",
          "sc": "要怎么做……"
