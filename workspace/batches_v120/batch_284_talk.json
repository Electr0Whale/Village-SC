          "pidx_tc": 354082,
          "spk": "木珠 (コダマ)",
          "ja": "できなかったの……",
          "tc": "什麼都不做……",
          "sc": "什么都不做……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354091,
          "spk": "木珠 (コダマ)",
          "ja": "あの、さみしさに、",
          "tc": "我很想對抗那種寂寞，",
          "sc": "我很想对抗那种寂寞，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 354098,
          "spk": "木珠 (コダマ)",
          "ja": "かなしさに、抗いたかった……",
          "tc": "還有悲傷……",
          "sc": "还有悲伤……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 354114,
          "spk": "木珠 (コダマ)",
          "ja": "だから、コダマは、",
          "tc": "所以，",
          "sc": "所以，"
