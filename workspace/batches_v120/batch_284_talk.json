      "rec_id": "TALK_ID_10_0602_066_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354052,
          "spk": "木珠 (コダマ)",
          "ja": "間違ったことをしてるのは、",
          "tc": "我一直都知道，",
          "sc": "我一直都知道，"
