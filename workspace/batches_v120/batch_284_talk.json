          "ja": "ずっとわかってた……",
          "tc": "自己在做不對的事情……",
          "sc": "自己在做不对的事情……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354068,
          "spk": "木珠 (コダマ)",
          "ja": "それでも……",
          "tc": "即使這樣……",
          "sc": "即使这样……"
        },
