          "f_idx": 2,
          "pidx_tc": 29643,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも風に乗って飛べたらいいなってさ",
          "tc": "真希望自己也能乘風到處飛翔。",
          "sc": "真希望自己也能乘风到处飞翔。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 29661,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……何にも頼らず、身一つでね",
          "tc": "……就只靠我一個，不依賴其他人事物。",
          "sc": "……就只靠我一个，不依赖其他人事物。"
