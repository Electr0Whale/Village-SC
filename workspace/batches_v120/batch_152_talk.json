        {
          "f_idx": 1,
          "pidx_tc": 27673,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何に見えるかって考えてるだけで、",
          "tc": "天上的雲看起來像什麼，",
          "sc": "天上的云看起来像什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27680,
          "spk": "琪娜娜 (チナナ)",
          "ja": "平気で時間が経ったもんだけど",
          "tc": "時間就會不知不覺地過去了呢。",
          "sc": "时间就会不知不觉地过去了呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27691,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人になると、なんの形にも見えなくなるね",
          "tc": "但是長大之後再看，就會覺得什麼都不像啊。",
          "sc": "但是长大之后再看，就会觉得什么都不像啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3162,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27722,
          "spk": "琪娜娜 (チナナ)",
