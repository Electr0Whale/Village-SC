      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27407,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっきから見てると、わりと魚がいるね",
          "tc": "我剛剛觀察了一下，發現其實還滿多魚的耶。",
          "sc": "我刚刚观察了一下，发现其实还满多鱼的呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27425,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここはよく釣れる場所なのかな？",
          "tc": "不知道這個地方是不是很好釣？",
          "sc": "不知道这个地方是不是很好钓？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27432,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スミレに教え……いや、とっくに知ってそうだね",
          "tc": "我要告訴堇怜……不，他應該早就知道了。",
          "sc": "我要告诉堇怜……不，他应该早就知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3157,
