  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3137,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26537,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この感じだと今日はずっと雨かな？",
          "tc": "看這個情況，今天雨應該不會停了。",
          "sc": "看这个情况，今天雨应该不会停了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26544,
          "spk": "琪娜娜 (チナナ)",
          "ja": "荷台の品物が傷まないか心配だよ",
          "tc": "有點擔心載貨台上的貨物會不會受損。",
          "sc": "有点担心载货台上的货物会不会受损。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3138,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26575,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……のどかだねえ",
          "tc": "……好悠哉啊。",
          "sc": "……好悠哉啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26586,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村にいるとホッとするよ",
          "tc": "我只要在村裡就會覺得很放鬆呢。",
          "sc": "我只要在村里就会觉得很放松呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26593,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……やっぱ地元だからかねぇ",
          "tc": "……畢竟這裡是我的故鄉嘛。",
          "sc": "……毕竟这里是我的故乡嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3139,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26617,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ラジオから流れてきた曲が",
          "tc": "剛剛在廣播電台聽到的歌曲",
          "sc": "刚刚在广播电台听到的歌曲"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26624,
          "spk": "琪娜娜 (チナナ)",
          "ja": "頭から離れないんだけど",
          "tc": "一直在我的腦海裡反覆響起。",
          "sc": "一直在我的脑海里反复响起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26635,
          "spk": "琪娜娜 (チナナ)",
          "ja": "曲名がわからなくてモヤモヤするよ",
          "tc": "但就是不知道歌名，讓人好煩躁啊。",
          "sc": "但就是不知道歌名，让人好烦躁啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3140,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26666,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あちこちに花が咲いてるね",
          "tc": "到處都開了花呢，",
          "sc": "到处都开了花呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26673,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今の季節は歩くのが楽しいよ",
          "tc": "在這個季節散步真開心。",
          "sc": "在这个季节散步真开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3141,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26697,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミ、何もこんな悪天候の夜に",
          "tc": "……晚上天氣這麼惡劣，",
          "sc": "……晚上天气这么恶劣，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26704,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外をうろつかなくたっていいんじゃないかい？",
          "tc": "你又何苦在外面晃呢？",
          "sc": "你又何苦在外面晃呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26711,
          "spk": "琪娜娜 (チナナ)",
          "ja": "早く家にお帰りよ",
          "tc": "趕快回家吧。",
          "sc": "赶快回家吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3142,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26735,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はちょっと疲れたよ",
          "tc": "今天有點累了。",
          "sc": "今天有点累了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26746,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうして人間は瞬間移動が",
          "tc": "為什麼人類",
          "sc": "为什么人类"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26753,
          "spk": "琪娜娜 (チナナ)",
          "ja": "できないんだろうねえ",
          "tc": "就不會瞬間移動呢？",
          "sc": "就不会瞬间移动呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3143,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26777,
          "spk": "琪娜娜 (チナナ)",
          "ja": "暗くなってからもキミは元気だね",
          "tc": "你在天色變黑之後還是很有精神耶。",
          "sc": "你在天色变黑之后还是很有精神呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26795,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さすが、子どもは体力が底なしだ",
          "tc": "不愧是小孩子，體力沒有極限啊。",
          "sc": "不愧是小孩子，体力没有极限啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3144,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_1823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26826,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜風に当たりすぎると風邪を引くよ",
          "tc": "吹太多晚風是會感冒的喔。",
          "sc": "吹太多晚风是会感冒的哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26844,
          "spk": "琪娜娜 (チナナ)",
          "ja": "暖かくなってきたからって",
          "tc": "雖然天氣變暖了，",
          "sc": "虽然天气变暖了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 26851,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気を抜かないことだね",
          "tc": "但還是要小心一點才行。",
          "sc": "但还是要小心一点才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3145,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26875,
          "spk": "琪娜娜 (チナナ)",
          "ja": "段ボールが濡れてふやけてないと",
          "tc": "希望紙箱不會",
          "sc": "希望纸箱不会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26882,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいんだけど……",
          "tc": "被淋濕然後軟掉……",
          "sc": "被淋湿然后软掉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26893,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ま、ぱっと見は大丈夫そうだね",
          "tc": "……不過乍看之下應該是沒問題。",
          "sc": "……不过乍看之下应该是没问题。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3146,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26924,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、おはよーさん",
          "tc": "哦，早啊。",
          "sc": "哦，早啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "動物たちをビックリさせないように、",
          "tc": "小心別嚇到動物們，",
          "sc": "小心别吓到动物们，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 26942,
          "spk": "琪娜娜 (チナナ)",
          "ja": "静かに見ていっておくれ",
          "tc": "靜靜地觀察吧。",
          "sc": "静静地观察吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3147,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 26966,
          "spk": "琪娜娜 (チナナ)",
          "ja": "露天商にとって夏は地獄の季節だよ……",
          "tc": "對流動攤販經營者而言，夏天就是地獄……",
          "sc": "对流动摊贩经营者而言，夏天就是地狱……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 26973,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この時間はまだ涼しくて助かるんだけどね……",
          "tc": "幸好這個時段還算涼爽，待起來舒適很多……",
          "sc": "幸好这个时段还算凉爽，待起来舒适很多……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3148,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27004,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、買い物かい？",
          "tc": "嗨，你是來買東西的嗎？",
          "sc": "嗨，你是来买东西的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27011,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それとも話し相手になってくれるのかな",
          "tc": "還是來陪我聊天的？",
          "sc": "还是来陪我聊天的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27022,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミならお喋りだけでも大歓迎だよ",
          "tc": "如果是你，即便只是聊天，我也很樂意喔。",
          "sc": "如果是你，即便只是聊天，我也很乐意哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3149,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27053,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はいはい、いらっしゃーい",
          "tc": "嗨，歡迎光臨。",
          "sc": "嗨，欢迎光临。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27064,
          "spk": "琪娜娜 (チナナ)",
          "ja": "欲しいもんがあったら、ウチが暑さにまいって",
          "tc": "有什麼想要的東西的話，就趁我受不了天氣太熱",
          "sc": "有什么想要的东西的话，就趁我受不了天气太热"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27071,
          "spk": "琪娜娜 (チナナ)",
          "ja": "早じまいしちゃう前に、買っとくんだよ～",
          "tc": "提早收攤之前，趕快買起來吧～",
          "sc": "提早收摊之前，赶快买起来吧～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3150,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27102,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっついね～",
          "tc": "好熱喔～",
          "sc": "好热哦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27113,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どっかにうちわをしまっといたはずなんだけど",
          "tc": "我應該把扇子收在某個地方了，",
          "sc": "我应该把扇子收在某个地方了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27120,
          "spk": "琪娜娜 (チナナ)",
          "ja": "探すのも面倒なくらい、あっついね～",
          "tc": "但太熱了，連要找扇子出來都嫌麻煩啊～",
          "sc": "但太热了，连要找扇子出来都嫌麻烦啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3151,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27151,
          "spk": "琪娜娜 (チナナ)",
          "ja": "朝から雨だと、さすがに涼しいね",
          "tc": "從一大早開始下雨，天氣就涼快多了。",
          "sc": "从一大早开始下雨，天气就凉快多了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27169,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これだけ過ごしやすい気温になるなら",
          "tc": "如果一下雨氣溫都能變得這麼舒適，",
          "sc": "如果一下雨气温都能变得这么舒适，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27176,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夏の間は毎日雨でもいいかもねえ",
          "tc": "那我覺得夏天期間最好每天都下雨。",
          "sc": "那我觉得夏天期间最好每天都下雨。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3152,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27207,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここで、まったりと休憩してるとさ",
          "tc": "在這裡悠哉地休息，",
          "sc": "在这里悠哉地休息，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27225,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いろんな人が通ってくのが見えるんだよ",
          "tc": "就可以看到很多人經過。",
          "sc": "就可以看到很多人经过。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27232,
          "spk": "琪娜娜 (チナナ)",
          "ja": "人間観察にはお薦めのスポットだね",
          "tc": "推薦可以來這裡觀察人類喔。",
          "sc": "推荐可以来这里观察人类哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3153,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27256,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、<player>はあちこち濡れてるね",
          "tc": "哦？<player>，你好多地方都淋濕了。",
          "sc": "哦？<player>，你好多地方都淋湿了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27267,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのままにしとくと風邪引くよ",
          "tc": "繼續這樣下去會感冒的喔，",
          "sc": "继续这样下去会感冒的哦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27274,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちゃんとタオルで拭くか着替えといで",
          "tc": "你去拿個毛巾好好擦乾，或是換個衣服吧。",
          "sc": "你去拿个毛巾好好擦干，或是换个衣服吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3154,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2023",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27298,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あれ、見つかった",
          "tc": "……啊，被你找到了。",
          "sc": "……啊，被你找到了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27309,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど、今日はもう店じまいしたよ",
          "tc": "抱歉，我今天已經打烊囉。",
          "sc": "抱歉，我今天已经打烊啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27316,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今は仕事終わりの休憩中なんだ",
          "tc": "現在是收工後的休息時間。",
          "sc": "现在是收工后的休息时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3155,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2024",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27347,
          "spk": "琪娜娜 (チナナ)",
          "ja": "は～……川風が気持ちいい～",
          "tc": "呼……河邊吹來的風真舒服……",
          "sc": "呼……河边吹来的风真舒服……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27358,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここにいれば暑さとは無縁だね",
          "tc": "待在這裡就不怕天氣熱了。",
          "sc": "待在这里就不怕天气热了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27376,
          "spk": "琪娜娜 (チナナ)",
          "ja": "多少蚊に刺されるくらいは目をつむるよ",
          "tc": "頂多是被蚊子叮而已，我就睜隻眼閉隻眼吧。",
          "sc": "顶多是被蚊子叮而已，我就睁只眼闭只眼吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3156,
