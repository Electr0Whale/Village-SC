          "f_idx": 1,
          "pidx_tc": 28273,
          "spk": "琪娜娜 (チナナ)",
          "ja": "テーブル席よりも料理との距離が",
          "tc": "不覺得比起普通座位，",
          "sc": "不觉得比起普通座位，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28280,
          "spk": "琪娜娜 (チナナ)",
          "ja": "近い感じがして、よくないかい？",
          "tc": "吧台座位與料理的距離更近，感覺更好嗎？",
          "sc": "吧台座位与料理的距离更近，感觉更好吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3174,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2320",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ロッカクさんっていいよねえ",
          "tc": "六角叔人真的很好。",
          "sc": "六角叔人真的很好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "料理がおいしいのはもちろんだけど",
          "tc": "除了他的料理很好吃之外，好就好在",
          "sc": "除了他的料理很好吃之外，好就好在"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あまり話しかけず放っといてくれるのがいいよ",
          "tc": "他會放我一個人獨處，不會一直找我說話。",
          "sc": "他会放我一个人独处，不会一直找我说话。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3175,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28353,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、こんな天気でもキミは元気だねえ",
          "tc": "哦？你在這種天氣還是這麼有活力啊。",
          "sc": "哦？你在这种天气还是这么有活力啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28371,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あまりはしゃぎすぎると、転ぶからね",
          "tc": "要是玩得太瘋會跌倒的喔，",
          "sc": "要是玩得太疯会跌倒的哦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 28378,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気をつけるんだぞ～",
          "tc": "小心一點啊～",
          "sc": "小心一点啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3176,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28402,
          "spk": "琪娜娜 (チナナ)",
          "ja": "暑くなってくると毎年、ゆっくり歩けば",
          "tc": "每年變熱的時候，",
          "sc": "每年变热的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28409,
          "spk": "琪娜娜 (チナナ)",
          "ja": "汗をかかないんじゃないかって思うんだよ",
          "tc": "我都會想說慢慢走應該就不會流汗了吧。",
          "sc": "我都会想说慢慢走应该就不会流汗了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 28427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けど、まったくそんなことないんだよねえ",
          "tc": "但是根本無所謂啊。",
          "sc": "但是根本无所谓啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3177,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28451,
          "spk": "琪娜娜 (チナナ)",
          "ja": "日差しが強いね～",
          "tc": "太陽好大啊～",
          "sc": "太阳好大啊～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28462,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でも村じゃ誰も日焼け気にしてないから",
          "tc": "不過村裡都沒有人會怕曬傷，",
          "sc": "不过村里都没有人会怕晒伤，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28469,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチもつい日焼け止め忘れちゃうんだわ",
          "tc": "所以我也常常不小心忘了要擦防曬。",
          "sc": "所以我也常常不小心忘了要擦防晒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3178,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28500,
          "spk": "琪娜娜 (チナナ)",
          "ja": "服が背中に張り付くねえ",
          "tc": "衣服都黏在背上了。",
          "sc": "衣服都黏在背上了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "正直なところ、かなり気持ち悪いんだけど",
          "tc": "老實說我覺得超不舒服的，",
          "sc": "老实说我觉得超不舒服的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28518,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きな服を着るためなら我慢しないとだねえ",
          "tc": "但為了穿喜歡的衣服，也只好忍耐忍耐了。",
          "sc": "但为了穿喜欢的衣服，也只好忍耐忍耐了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3179,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28549,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うは～……雨だし暑いしで",
          "tc": "嗚哇……不僅下雨還那麼熱，",
          "sc": "呜哇……不仅下雨还那么热，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28556,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やんなっちゃうねえ",
          "tc": "真討厭啊。",
          "sc": "真讨厌啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28567,
          "spk": "琪娜娜 (チナナ)",
          "ja": "湿度が限界突破してるよ",
          "tc": "濕度都破表了。",
          "sc": "湿度都破表了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3180,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28591,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっとさ、頑張って想像してみてるんだよ",
          "tc": "我正在努力地想像，",
          "sc": "我正在努力地想像，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28598,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今ウチは大きな氷の塊を",
          "tc": "想像我現在",
          "sc": "想像我现在"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28605,
          "spk": "琪娜娜 (チナナ)",
          "ja": "抱えて歩いてるところだって……",
          "tc": "是抱著一大塊冰塊走著路……",
          "sc": "是抱着一大块冰块走着路……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 28616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "脳をだまして涼が取れたら最高だろう？",
          "tc": "如果靠著自欺欺人就能變涼，那就再好不過了。",
          "sc": "如果靠着自欺欺人就能变凉，那就再好不过了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3181,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28647,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっき、スミレが元気いっぱいに",
          "tc": "我剛剛看到堇怜",
          "sc": "我刚刚看到堇怜"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28654,
          "spk": "琪娜娜 (チナナ)",
          "ja": "走ってるのを見たよ",
          "tc": "活力充沛地跑了過去。",
          "sc": "活力充沛地跑了过去。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28665,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体力を分けてほしいね……",
          "tc": "真希望他能分一些體力給我……",
          "sc": "真希望他能分一些体力给我……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3182,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28689,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうしてウチは瞬間移動ができないんだろうね",
          "tc": "為什麼我不會瞬間移動呢？",
          "sc": "为什么我不会瞬间移动呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28707,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もしできたら、夏の間は汗水垂らして",
          "tc": "如果能瞬間移動，我在夏天絕對不會用走的，",
          "sc": "如果能瞬间移动，我在夏天绝对不会用走的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 28714,
          "spk": "琪娜娜 (チナナ)",
          "ja": "歩いて移動なんて絶対にしないよ",
          "tc": "把自己搞得滿頭大汗。",
          "sc": "把自己搞得满头大汗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3183,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28745,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……おっと、いたのかい？",
          "tc": "……哦？你在啊？",
          "sc": "……哦？你在啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28756,
          "spk": "琪娜娜 (チナナ)",
          "ja": "誰もいないと思って鼻歌を歌ってたんだけど",
          "tc": "我以為沒人在，所以剛剛在哼歌，",
          "sc": "我以为没人在，所以刚刚在哼歌，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28763,
          "spk": "琪娜娜 (チナナ)",
          "ja": "聞こえなかっただろうね？",
          "tc": "你應該沒聽到吧？",
          "sc": "你应该没听到吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3184,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28787,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お化けでも妖怪でもなんでもいいんだけどさ",
          "tc": "不管是怪物還是妖怪都好，",
          "sc": "不管是怪物还是妖怪都好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28794,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夏に冷たい息で体を冷やしてくれるような、",
          "tc": "不知道有沒有那種",
          "sc": "不知道有没有那种"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28801,
          "spk": "琪娜娜 (チナナ)",
          "ja": "人間に都合のいい化け物はいないもんかねえ",
          "tc": "剛好在夏天會用冰冷氣息幫人體降溫的怪物啊？",
          "sc": "刚好在夏天会用冰空调息帮人体降温的怪物啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3185,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28825,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28832,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜風がわりと気持ちのいい夜だね",
          "tc": "今晚的晚風很舒服呢。",
          "sc": "今晚的晚风很舒服呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28843,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜は寝やすそうでよかったよ",
          "tc": "看來今天應該會很好睡。",
          "sc": "看来今天应该会很好睡。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3186,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_2823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28874,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、どこに行くんだい？",
          "tc": "嗯？你要去哪裡啊？",
          "sc": "嗯？你要去哪里啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28885,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう日が落ちたんだから、",
          "tc": "太陽已經下山了，",
          "sc": "太阳已经下山了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28892,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遠くには行かないようにね",
          "tc": "你不要跑太遠喔。",
          "sc": "你不要跑太远哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3187,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28916,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雨の日の荷下ろしはどうしても濡れるね",
          "tc": "在雨天卸貨無論如何都會被淋濕啊。",
          "sc": "在雨天卸货无论如何都会被淋湿啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28934,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うっかり落としたら水たまり直行だし",
          "tc": "要是不小心手滑，貨物就會掉進水窪裡，",
          "sc": "要是不小心手滑，货物就会掉进水洼里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 28941,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちっとも気が抜けないよ",
          "tc": "所以一點都不能大意。",
          "sc": "所以一点都不能大意。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3188,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 28972,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気持ちのいい朝だね",
          "tc": "真是舒服的早晨。",
          "sc": "真是舒服的早晨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 28983,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋は過ごしやすいから",
          "tc": "秋天天氣比較舒適，",
          "sc": "秋天天气比较舒适，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 28990,
          "spk": "琪娜娜 (チナナ)",
          "ja": "朝から動くのも苦じゃないよ",
          "tc": "所以一早開始動工也不辛苦呢。",
          "sc": "所以一早开始动工也不辛苦呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3189,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29021,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、何か手伝いたいって顔してるね？",
          "tc": "哦？你臉上寫著你很想幫我的忙耶。",
          "sc": "哦？你脸上写着你很想帮我的忙呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29039,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチとしても手伝ってもらいたいところだけど、",
          "tc": "我是也很想請你幫忙，",
          "sc": "我是也很想请你帮忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29046,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もうちょっとキミに筋肉がついてからかな",
          "tc": "但還是等你長多一點肌肉之後再說吧。",
          "sc": "但还是等你长多一点肌肉之后再说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3190,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29077,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやおや、そんなに",
          "tc": "哎呀，",
          "sc": "哎呀，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29084,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見つめないでおくれよ",
          "tc": "你不要一直盯著我嘛，",
          "sc": "你不要一直盯着我嘛，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29091,
          "spk": "琪娜娜 (チナナ)",
          "ja": "照れるじゃないか",
          "tc": "我會不好意思的耶。",
          "sc": "我会不好意思的呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3191,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29115,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は売れ行きがよくないねえ……",
          "tc": "今天業績不太好啊……",
          "sc": "今天业绩不太好啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、そんな日もあるさ",
          "tc": "算了，總是會有一兩天這種日子，",
          "sc": "算了，总是会有一两天这种日子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはのんびりお客を待つよ",
          "tc": "我就悠哉地等客人上門吧。",
          "sc": "我就悠哉地等客人上门吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3192,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29164,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夕飯について考えてたら",
          "tc": "我想了一下晚餐要吃什麼，",
          "sc": "我想了一下晚餐要吃什么，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29171,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹が鳴っちゃったよ",
          "tc": "結果肚子就叫了。",
          "sc": "结果肚子就叫了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29182,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もしかして、聞こえたかな？",
          "tc": "你該不會聽到了吧？",
          "sc": "你该不会听到了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3193,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29206,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだい？　ウチは休憩中だよ",
          "tc": "怎麼了？我正在休息喔。",
          "sc": "怎么了？我正在休息哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "別にサザンカの店の",
          "tc": "我並不是在做茶梅店裡的",
          "sc": "我并不是在做茶梅店里的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "看板娘になったわけじゃないさ",
          "tc": "看板娘喔。",
          "sc": "看板娘哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3194,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29255,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここは風通しがいいから",
          "tc": "這裡很通風，",
          "sc": "这里很通风，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29262,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋の匂いが運ばれてくるよ",
          "tc": "所以能聞到秋天的味道。",
          "sc": "所以能闻到秋天的味道。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29273,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>も深呼吸してごらん",
          "tc": "<player>，你也深呼吸試試看吧。",
          "sc": "<player>，你也深呼吸试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3195,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昔、この側溝の隙間に",
          "tc": "我以前曾經把中獎的冰棒棍弄丟，",
          "sc": "我以前曾经把中奖的冰棒棍弄丢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "アイスの当たり棒を落としてねえ",
          "tc": "掉進了這邊排水溝的縫裡。",
          "sc": "掉进了这边排水沟的缝里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いまだにあの悔しさを思い出すよ",
          "tc": "我到現在都會想起當時我有多懊惱。",
          "sc": "我到现在都会想起当时我有多懊恼。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3196,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29346,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋は夜が長く感じるからね",
          "tc": "秋天的夜晚令人感覺很漫長。",
          "sc": "秋天的夜晚令人感觉很漫长。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29364,
          "spk": "琪娜娜 (チナナ)",
          "ja": "暗くなったからって、すぐに",
          "tc": "所以天一黑就睡覺",
          "sc": "所以天一黑就睡觉"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29371,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝るのはもったいないよ",
          "tc": "是很浪費的。",
          "sc": "是很浪费的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3197,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29395,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミとは、一緒にいる時間が長くてねえ",
          "tc": "我跟蓮實已經相處很久了。",
          "sc": "我跟莲实已经相处很久了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29413,
          "spk": "琪娜娜 (チナナ)",
          "ja": "会話がなくても平気なんだよ",
          "tc": "所以我們之間即便沒有話要說也完全沒關係。",
          "sc": "所以我们之间即便没有话要说也完全没关系。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29420,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういう相手は大事にしないとね",
          "tc": "一定要好好珍惜這樣的對象啊。",
          "sc": "一定要好好珍惜这样的对象啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3198,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29451,
          "spk": "琪娜娜 (チナナ)",
