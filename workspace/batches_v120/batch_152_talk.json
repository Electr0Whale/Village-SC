      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29489,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29496,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪天候の朝っぱらから元気だね",
          "tc": "這種天氣不好的早晨，你還是這麼有活力啊。",
          "sc": "这种天气不好的早晨，你还是这么有活力啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29507,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは二度寝したいくらいだってのに",
          "tc": "我都想睡回籠覺了。",
          "sc": "我都想睡回笼觉了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3200,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29538,
          "spk": "琪娜娜 (チナナ)",
          "ja": "軒下から見上げる空っていいよねえ",
          "tc": "從屋簷仰望天空的感覺很好呢。",
          "sc": "从屋檐仰望天空的感觉很好呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29556,
          "spk": "琪娜娜 (チナナ)",
          "ja": "空の広さを感じながらも、",
          "tc": "既能感覺到天空的遼闊，",
          "sc": "既能感觉到天空的辽阔，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29563,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと守られてる感じが心地いいだろう？",
          "tc": "也有一點被屋簷保護著的感覺，很舒服對吧？",
          "sc": "也有一点被屋檐保护着的感觉，很舒服对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3201,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29587,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は店が休みだからね",
          "tc": "今天我店休，",
          "sc": "今天我店休，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29594,
          "spk": "琪娜娜 (チナナ)",
          "ja": "買い物やら掃除やら",
          "tc": "所以我要來買東西、打掃等等，",
          "sc": "所以我要来买东西、打扫等等，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29601,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれこれ片付けておかないと",
          "tc": "收拾一些有的沒的東西。",
          "sc": "收拾一些有的没的东西。"
