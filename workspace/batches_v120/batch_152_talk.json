      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27666,
          "spk": "琪娜娜 (チナナ)",
          "ja": "子どもの頃は、空に浮かんだ雲が",
          "tc": "小時候光是思考",
          "sc": "小时候光是思考"
