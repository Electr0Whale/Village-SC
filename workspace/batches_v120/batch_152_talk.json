        {
          "f_idx": 1,
          "pidx_tc": 27561,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トラックに鍵、差しっぱなしだった",
          "tc": "卡車的鑰匙還插在上面沒拿走。",
          "sc": "卡车的钥匙还插在上面没拿走。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27572,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……明日まで覚えていられるかな",
          "tc": "……不知道我明天還會不會記得。",
          "sc": "……不知道我明天还会不会记得。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 27579,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気づかずに探し回るのだけは、",
          "tc": "希望我別忘了這件事，",
          "sc": "希望我别忘了这件事，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 27586,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さすがに避けたいんだけどな……",
          "tc": "然後跑去四處翻找……",
          "sc": "然后跑去四处翻找……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3160,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27610,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここらのスペースを借りて花でも育てようかな",
          "tc": "要不要借用這個空間來種些花呢？",
