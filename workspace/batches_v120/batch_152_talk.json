      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29625,
          "spk": "琪娜娜 (チナナ)",
          "ja": "落ち葉が風に吹かれてるの見ると思うんだよ",
          "tc": "看到落葉乘著風的樣子，我就會想，",
          "sc": "看到落叶乘着风的样子，我就会想，"
