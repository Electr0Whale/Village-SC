      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27463,
          "spk": "琪娜娜 (チナナ)",
          "ja": "暑い日の夜はキンキンに冷えたビールで",
          "tc": "天氣炎熱的夜晚，",
          "sc": "天气炎热的夜晚，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カンパイと洒落込みたいところだねえ",
          "tc": "真想拿杯冰涼涼的啤酒乾杯啊。",
          "sc": "真想拿杯冰凉凉的啤酒干杯啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27481,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミも大人になったら混ざってよ",
          "tc": "等你長大之後就來加入我們的行列吧。",
          "sc": "等你长大之后就来加入我们的行列吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3158,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27512,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あくびがうつるって知ってるかい？",
          "tc": "你知道呵欠是會傳染的嗎？",
          "sc": "你知道呵欠是会传染的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 27523,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっきハスミがあくびをしたの見てから",
          "tc": "剛剛看到蓮實打呵欠之後，",
          "sc": "刚刚看到莲实打呵欠之后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 27530,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはあくびが出っぱなしだよ",
          "tc": "我也跟著一直在打呵欠呢。",
          "sc": "我也跟着一直在打呵欠呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3159,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_2032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 27554,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ、そういえば……",
          "tc": "啊，突然想起來……",
          "sc": "啊，突然想起来……"
