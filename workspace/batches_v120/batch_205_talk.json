      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294229,
          "spk": "帷 (トバリ)",
          "ja": "コダマ……どうして……",
          "tc": "木珠……為什麼……",
          "sc": "木珠……为什么……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 294236,
          "spk": "帷 (トバリ)",
          "ja": "そんな……アンタまさか……！！",
          "tc": "怎麼會……難道祢……！！",
          "sc": "怎么会……难道你……！！"
        }
      ]
    },
    {
      "file": "talk.dat",
