      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295653,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱり、どう見てもあの時に見た家だ",
          "tc": "果然不管怎麼看都是當時那間屋子，",
          "sc": "果然不管怎么看都是当时那间屋子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295660,
          "spk": "裕太 (ユータ)",
          "ja": "キミも憶えているだろう？",
          "tc": "你也還記得吧？",
          "sc": "你也还记得吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295671,
          "spk": "裕太 (ユータ)",
          "ja": "けど、あの時とは、",
          "tc": "不過，房子蓋的地方，",
          "sc": "不过，房子盖的地方，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295678,
          "spk": "裕太 (ユータ)",
          "ja": "建っている場所が違うような気がするんだ……",
          "tc": "怎麼好像跟之前不一樣……",
          "sc": "怎么好像跟之前不一样……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 295689,
          "spk": "裕太 (ユータ)",
          "ja": "俺たちの記憶違いなのかな？",
          "tc": "會是我們記錯了嗎？",
          "sc": "会是我们记错了吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 295696,
          "spk": "裕太 (ユータ)",
          "ja": "それとも、まさか――",
          "tc": "還是說，難不成──",
          "sc": "还是说，难不成——"
        },
        {
          "f_idx": 6,
          "pidx_tc": 295707,
          "spk": "裕太 (ユータ)",
          "ja": "この家は、家の幽霊で……",
          "tc": "這間房子是……幽靈屋……",
          "sc": "这间房子是……幽灵屋……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 295714,
          "spk": "裕太 (ユータ)",
          "ja": "この山中を彷徨ってるとか……？",
