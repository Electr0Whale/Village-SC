          "spk": "帷 (トバリ)",
          "ja": "コダマ……？",
          "tc": "木珠……？",
          "sc": "木珠……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 294119,
          "spk": "帷 (トバリ)",
          "ja": "今なんて……",
          "tc": "祢剛剛說什麼……",
          "sc": "你刚刚说什么……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 294130,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 294139,
          "spk": "木珠 (コダマ)",
          "ja": "……こう、いうんだっけ",
          "tc": "……應該，是要這樣……講吧。",
          "sc": "……应该，是要这样……讲吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 294148,
          "spk": "木珠 (コダマ)",
          "ja": "かし、こみ、もうし、ます……",
          "tc": "謹此……相求……",
          "sc": "谨此……相求……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 294155,
          "spk": "木珠 (コダマ)",
          "ja": "ねがわ、くば、こたえ、たまえ……",
          "tc": "願祢……賜應……",
          "sc": "愿你……赐应……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 294164,
          "spk": "木珠 (コダマ)",
          "ja": "<strong>かみさ、ま……おねがい、します……",
          "tc": "<strong>神明大……人……拜託……",
          "sc": "<strong>神明大……人……拜托……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 294171,
          "spk": "木珠 (コダマ)",
          "ja": "そのナタ、で、そのおね、えちゃんを、きって</strong>",
          "tc": "請用，那把柴刀……劈了姐姐。</strong>",
