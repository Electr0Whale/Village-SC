    {
      "file": "talk.dat",
      "rec_idx": 6292,
      "rec_id": "TALK_ID_70_0070_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364490,
          "spk": "茶梅 (サザンカ)",
          "ja": "マジかぁ",
          "tc": "真的假的～",
          "sc": "真的假的～"
