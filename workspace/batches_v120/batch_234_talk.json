          "f_idx": 5,
          "pidx_tc": 364529,
          "spk": "茶梅 (サザンカ)",
          "ja": "探してきてほしいんだよね～",
          "tc": "採集5個銅礦石給我。",
          "sc": "采集5个铜矿石给我。"
        },
