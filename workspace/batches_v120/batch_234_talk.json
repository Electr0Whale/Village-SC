      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376589,
          "spk": "驹子 (コマコ)",
          "ja": "<player>が村で楽しく過ごせますように",
          "tc": "我向神明許願說，",
          "sc": "我向神明许愿说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376596,
          "spk": "驹子 (コマコ)",
          "ja": "……って神さまにお願いしたの",
          "tc": "希望<player>在村裡能過得愉快。",
          "sc": "希望<player>在村里能过得愉快。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 376614,
          "spk": "驹子 (コマコ)",
          "ja": "だからきっと、いいことあると思うよ",
          "tc": "所以一定會有好事發生的。",
          "sc": "所以一定会有好事发生的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 376632,
