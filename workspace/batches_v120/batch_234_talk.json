          "f_idx": 4,
          "pidx_tc": 364522,
          "spk": "茶梅 (サザンカ)",
          "ja": "そこで銅鉱石を５個、",
          "tc": "我想拜託你去那邊",
          "sc": "我想拜托你去那边"
        },
