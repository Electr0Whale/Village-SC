      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376479,
          "spk": "驹子 (コマコ)",
          "ja": "すごいね、<player>！",
          "tc": "太厲害了，<player>！",
          "sc": "太厉害了，<player>！"
        },
        {
