      "rec_id": "TALK_ID_70_0060_001_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376297,
          "spk": "驹子 (コマコ)",
          "ja": "まずはこういう石材や木材を集めてね",
          "tc": "先去收集一些類似的石頭跟木頭吧。",
          "sc": "先去收集一些类似的石头跟木头吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376304,
          "spk": "驹子 (コマコ)",
          "ja": "素材が揃ったらきっと、",
          "tc": "能湊齊材料的話，",
          "sc": "能凑齐材料的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 376311,
          "spk": "驹子 (コマコ)",
          "ja": "祠が直せるようになるよ",
          "tc": "一定就能修好祠堂的。",
          "sc": "一定就能修好祠堂的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 376322,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっと、力仕事になっちゃうけど",
          "tc": "這有一點算是體力活，",
          "sc": "这有一点算是体力活，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 376329,
          "spk": "驹子 (コマコ)",
          "ja": "お願いね、<player>",
          "tc": "但就麻煩你囉，<player>。",
          "sc": "但就麻烦你啦，<player>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 376347,
          "spk": "驹子 (コマコ)",
          "ja": "祠が完成したら、知らせに来てね",
          "tc": "等你修好祠堂後，再來告訴我吧。",
          "sc": "等你修好祠堂后，再来告诉我吧。"
        }
      ]
    },
    {
