      "rec_idx": 6272,
      "rec_id": "TALK_ID_70_0060_001_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376273,
          "spk": "驹子 (コマコ)",
          "ja": "はい、どうぞ",
          "tc": "來，拿著吧。",
