      "rec_id": "TALK_ID_70_0060_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375821,
          "spk": "驹子 (コマコ)",
          "ja": "リンから聞いてるよ",
          "tc": "我聽林說了，",
          "sc": "我听林说了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375828,
          "spk": "驹子 (コマコ)",
          "ja": "お手伝い券を使わないといけないんだって",
          "tc": "你好像得把幫忙券用掉對吧？",
          "sc": "你好像得把帮忙券用掉对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375839,
          "spk": "驹子 (コマコ)",
          "ja": "お手伝い券のことは、",
          "tc": "所有村民都知道",
          "sc": "所有村民都知道"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375846,
          "spk": "驹子 (コマコ)",
          "ja": "村の人ならみんな知ってるから……",
          "tc": "幫忙券這個東西……",
          "sc": "帮忙券这个东西……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375853,
          "spk": "驹子 (コマコ)",
          "ja": "見せるだけで、頼み事をしてくれると思うよ",
          "tc": "所以只要出示幫忙券，他們就會請求幫助。",
          "sc": "所以只要出示帮忙券，他们就会请求帮助。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375864,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ早速……<player>",
          "tc": "那我們就馬上來……<player>，",
          "sc": "那我们就马上来……<player>，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375871,
          "spk": "驹子 (コマコ)",
          "ja": "試しに私に手渡してみて",
          "tc": "你試著交給我看看。",
          "sc": "你试着交给我看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6261,
      "rec_id": "TALK_ID_70_0060_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375895,
          "spk": "驹子 (コマコ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375902,
          "spk": "驹子 (コマコ)",
          "ja": "お手伝い券、ちゃんと受け取ったよ",
          "tc": "我確實收下幫忙券了。",
          "sc": "我确实收下帮忙券了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375913,
          "spk": "驹子 (コマコ)",
          "ja": "それにしても<player>はえらいね",
          "tc": "是說<player>你真了不起，",
          "sc": "是说<player>你真了不起，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375920,
          "spk": "驹子 (コマコ)",
          "ja": "きっと、みんな助かったって",
          "tc": "我想大家一定都會很高興，",
          "sc": "我想大家一定都会很高兴，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375927,
          "spk": "驹子 (コマコ)",
          "ja": "喜んでくれるよ！",
          "tc": "覺得你幫大忙了喔！",
          "sc": "觉得你帮大忙了哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375938,
          "spk": "驹子 (コマコ)",
          "ja": "……あ、それよりお願い考えなきゃだよね",
          "tc": "……啊，比起這個，我得想想要拜託你什麼呢。",
          "sc": "……啊，比起这个，我得想想要拜托你什么呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6262,
      "rec_id": "TALK_ID_70_0060_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375963,
          "spk": "驹子 (コマコ)",
          "ja": "うーん、どうしよう……",
          "tc": "嗯～該怎麼辦呢……",
          "sc": "嗯～该怎么办呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375970,
          "spk": "驹子 (コマコ)",
          "ja": "特に何かしてほしいとかないんだけど……",
          "tc": "我好像沒有特別要拜託你的事……",
          "sc": "我好像没有特别要拜托你的事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375977,
          "spk": "驹子 (コマコ)",
          "ja": "それじゃ<player>が困るもんね……",
          "tc": "但是這樣<player>會很困擾的吧……",
          "sc": "但是这样<player>会很困扰的吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6263,
      "rec_id": "TALK_ID_70_0060_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375995,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……そうだ……",
          "tc": "啊……對了……",
          "sc": "啊……对了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6264,
      "rec_id": "TALK_ID_70_0060_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376013,
          "spk": "驹子 (コマコ)",
          "ja": "もし、できたら、でいいんだけど……",
          "tc": "如果可以的話……",
          "sc": "如果可以的话……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6265,
      "rec_id": "TALK_ID_70_0060_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376044,
          "spk": "驹子 (コマコ)",
          "ja": "これは、祠っていう神さまのお家なんだけど、",
          "tc": "這是祠堂，是神明大人住的家。",
          "sc": "这是祠堂，是神明大人住的家。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376051,
          "spk": "驹子 (コマコ)",
          "ja": "昔から壊れちゃってて……",
          "tc": "但它已經壞掉很長一段時間了……",
          "sc": "但它已经坏掉很长一段时间了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6266,
      "rec_id": "TALK_ID_70_0060_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376076,
          "spk": "驹子 (コマコ)",
          "ja": "これの修復を頼みたいんだけど……",
          "tc": "所以我想麻煩你把這個修好……",
          "sc": "所以我想麻烦你把这个修好……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376083,
          "spk": "驹子 (コマコ)",
          "ja": "お願いできるかな……",
          "tc": "可以拜託你嗎……？",
          "sc": "可以拜托你吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6267,
      "rec_id": "TALK_ID_70_0060_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376108,
          "spk": "驹子 (コマコ)",
          "ja": "ほ、本当！？",
          "tc": "真、真的嗎！？",
          "sc": "真、真的吗！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376119,
          "spk": "驹子 (コマコ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6268,
      "rec_id": "TALK_ID_70_0060_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376143,
          "spk": "驹子 (コマコ)",
          "ja": "この村の神さまは、お供えをすれば",
          "tc": "只要拿供品供奉給村裡的神明大人，",
          "sc": "只要拿供品供奉给村里的神明大人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376150,
          "spk": "驹子 (コマコ)",
          "ja": "どんな願いでも叶えてくれるんだよ",
          "tc": "祂就會實現你的任何願望喔。",
          "sc": "祂就会实现你的任何愿望哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6269,
      "rec_id": "TALK_ID_70_0060_001_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376168,
          "spk": "驹子 (コマコ)",
          "ja": "ほ、本当だよ！　神さまは本当にいるんだから",
          "tc": "真、真的啦！神明大人是真的存在的，",
          "sc": "真、真的啦！神明大人是真的存在的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376175,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんとお願いすれば、必ず願いは叶うんだよ",
          "tc": "只要誠心許願，願望就一定能夠成真。",
          "sc": "只要诚心许愿，愿望就一定能够成真。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 376182,
          "spk": "驹子 (コマコ)",
          "ja": "疑ったら、よくないことが起きそうだし……",
          "tc": "畢竟心存懷疑感覺會遭到報應……",
          "sc": "毕竟心存怀疑感觉会遭到报应……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6270,
      "rec_id": "TALK_ID_70_0060_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376200,
          "spk": "驹子 (コマコ)",
          "ja": "……じゃあ、始めよっか",
          "tc": "……那就開始吧。",
          "sc": "……那就开始吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376207,
          "spk": "驹子 (コマコ)",
          "ja": "まず、材料になりそうなものを集めよう",
          "tc": "首先要先來收集可能可以派上用場的材料。",
          "sc": "首先要先来收集可能可以派上用场的材料。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 376218,
          "spk": "驹子 (コマコ)",
          "ja": "山の中にある、木や石を集めてきて",
          "tc": "要從山中收集木頭或石頭喔，",
          "sc": "要从山中收集木头或石头哦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 376225,
          "spk": "驹子 (コマコ)",
          "ja": "たとえば、そうだなあ……",
          "tc": "比方說，我想想……",
          "sc": "比方说，我想想……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6271,
      "rec_id": "TALK_ID_70_0060_001_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376249,
          "spk": "驹子 (コマコ)",
          "ja": "この石なら、ちょうどよさそうだね",
          "tc": "像這塊石頭好像就滿剛好的。",
          "sc": "像这块石头好像就满刚好的。"
        }
      ]
    },
    {
