  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7618,
      "rec_id": "TALK_ID_70_2120_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434703,
          "spk": "裕太 (ユータ)",
          "ja": "夢だと思う理由？",
          "tc": "你問我為什麼會覺得是夢嗎？",
          "sc": "你问我为什么会觉得是梦吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434710,
          "spk": "裕太 (ユータ)",
          "ja": "そうだな……",
          "tc": "也是……",
          "sc": "也是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 434721,
          "spk": "裕太 (ユータ)",
          "ja": "いろいろあるんだけど……",
          "tc": "雖然有很多理由……",
          "sc": "虽然有很多理由……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 434728,
          "spk": "裕太 (ユータ)",
          "ja": "一番は、俺がチェロを弾けた",
          "tc": "但最大的原因，",
          "sc": "但最大的原因，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 434735,
          "spk": "裕太 (ユータ)",
          "ja": "ことになるのかも",
          "tc": "應該還是因為我演奏了大提琴吧。",
          "sc": "应该还是因为我演奏了大提琴吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 434746,
          "spk": "裕太 (ユータ)",
          "ja": "チェロはね、俺はもう",
          "tc": "還以為，",
          "sc": "还以为，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 434753,
          "spk": "裕太 (ユータ)",
          "ja": "二度と触れないだろうと",
          "tc": "我這輩子都不會",
          "sc": "我这辈子都不会"
        },
        {
          "f_idx": 7,
          "pidx_tc": 434760,
          "spk": "裕太 (ユータ)",
          "ja": "思っていたんだ",
          "tc": "再演奏大提琴了。",
          "sc": "再演奏大提琴了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 434769,
          "spk": "裕太 (ユータ)",
          "ja": "それなのに、俺は",
          "tc": "但是我卻……",
          "sc": "但是我却……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 434776,
          "spk": "裕太 (ユータ)",
          "ja": "またチェロを弾いた",
          "tc": "再次演奏了大提琴。",
          "sc": "再次演奏了大提琴。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 434783,
          "spk": "裕太 (ユータ)",
          "ja": "……ちゃんと奏でられた",
          "tc": "……並且好好地演奏了出來。",
          "sc": "……并且好好地演奏了出来。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 434794,
          "spk": "裕太 (ユータ)",
          "ja": "それがね、",
          "tc": "這件事",
          "sc": "这件事"
        },
        {
          "f_idx": 12,
          "pidx_tc": 434801,
          "spk": "裕太 (ユータ)",
          "ja": "どうにも信じられないんだ",
          "tc": "真的很讓我難以置信。",
          "sc": "真的很让我难以置信。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 434812,
          "spk": "裕太 (ユータ)",
          "ja": "……もっと信じられない",
          "tc": "……但更令我不敢相信的是，",
          "sc": "……但更令我不敢相信的是，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 434819,
          "spk": "裕太 (ユータ)",
          "ja": "ことに、俺はまたチェロを",
          "tc": "我現在竟然又開始",
          "sc": "我现在竟然又开始"
        },
        {
          "f_idx": 15,
          "pidx_tc": 434826,
          "spk": "裕太 (ユータ)",
          "ja": "弾きたいと思っているんだよ",
          "tc": "想要拉大提琴了。",
          "sc": "想要拉大提琴了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 434837,
          "spk": "裕太 (ユータ)",
          "ja": "チェロも音楽も",
          "tc": "明明無論是音樂還是大提琴，",
          "sc": "明明无论是音乐还是大提琴，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 434844,
          "spk": "裕太 (ユータ)",
          "ja": "嫌いになったはずなのに",
          "tc": "我應該都很討厭才對。",
          "sc": "我应该都很讨厌才对。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 434855,
          "spk": "裕太 (ユータ)",
          "ja": "だから……やっぱり",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 434862,
          "spk": "裕太 (ユータ)",
          "ja": "あの家で起きたことは",
          "tc": "我才會覺得在那間房子裡發生的事",
          "sc": "我才会觉得在那间房子里发生的事"
        },
        {
          "f_idx": 20,
          "pidx_tc": 434869,
          "spk": "裕太 (ユータ)",
          "ja": "夢だったのかもしれない",
          "tc": "或許只是一場夢。",
          "sc": "或许只是一场梦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7619,
      "rec_id": "TALK_ID_70_2120_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434887,
          "spk": "裕太 (ユータ)",
          "ja": "……ははは",
          "tc": "……哈哈哈，",
          "sc": "……哈哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434894,
          "spk": "裕太 (ユータ)",
          "ja": "弾きたいなら弾けば",
          "tc": "你會想說我既然想拉大提琴的話，",
          "sc": "你会想说我既然想拉大提琴的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 434901,
          "spk": "裕太 (ユータ)",
          "ja": "いいのにって思う？",
          "tc": "那就去拉不就好了嗎？",
          "sc": "那就去拉不就好了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 434912,
          "spk": "裕太 (ユータ)",
          "ja": "だけど、そんな気持ちで",
          "tc": "但是抱著這種心態去演奏，",
          "sc": "但是抱着这种心态去演奏，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 434919,
          "spk": "裕太 (ユータ)",
          "ja": "触るのはチェロにも",
          "tc": "無論是對大提琴還是音樂，",
          "sc": "无论是对大提琴还是音乐，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 434926,
          "spk": "裕太 (ユータ)",
          "ja": "音楽にも失礼じゃないか",
          "tc": "都是很失禮的吧？",
          "sc": "都是很失礼的吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 434937,
          "spk": "裕太 (ユータ)",
          "ja": "……",
          "tc": "……",
          "sc": "……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 434944,
          "spk": "裕太 (ユータ)",
          "ja": "……あ",
          "tc": "……啊。",
          "sc": "……啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 434955,
          "spk": "裕太 (ユータ)",
          "ja": "なんだ……そうか",
          "tc": "什麼嘛……原來是這樣啊。",
          "sc": "什么嘛……原来是这样啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7620,
      "rec_id": "TALK_ID_70_2120_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434973,
          "spk": "裕太 (ユータ)",
          "ja": "そんなふうに思う時点で",
          "tc": "我會這樣想，",
          "sc": "我会这样想，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434980,
          "spk": "裕太 (ユータ)",
          "ja": "チェロも音楽も嫌いに",
          "tc": "那就代表我根本就",
          "sc": "那就代表我根本就"
        },
        {
          "f_idx": 2,
          "pidx_tc": 434987,
          "spk": "裕太 (ユータ)",
          "ja": "なったわけじゃないんだな",
          "tc": "沒有討厭音樂跟大提琴嘛。",
          "sc": "没有讨厌音乐跟大提琴嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 434998,
          "spk": "裕太 (ユータ)",
          "ja": "なんで気がつかなかったんだろう",
          "tc": "我怎麼都沒發現這點呢？",
          "sc": "我怎么都没发现这点呢？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 435009,
          "spk": "裕太 (ユータ)",
          "ja": "……ねえ、<player>",
          "tc": "……欸，<player>。",
          "sc": "……诶，<player>。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 435016,
          "spk": "裕太 (ユータ)",
          "ja": "意見を聞かせてくれない？",
          "tc": "我可以聽聽你的意見嗎？",
          "sc": "我可以听听你的意见吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 435027,
          "spk": "裕太 (ユータ)",
          "ja": "実はさ……",
          "tc": "其實啊……",
          "sc": "其实啊……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 435034,
          "spk": "裕太 (ユータ)",
          "ja": "ロッカクさんから",
          "tc": "六角叔，",
          "sc": "六角叔，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 435041,
          "spk": "裕太 (ユータ)",
          "ja": "打診があったんだ",
          "tc": "曾經邀請過我。",
          "sc": "曾经邀请过我。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 435052,
          "spk": "裕太 (ユータ)",
          "ja": "食堂でチェロを",
          "tc": "他問我願不願意",
          "sc": "他问我愿不愿意"
        },
        {
          "f_idx": 10,
          "pidx_tc": 435059,
          "spk": "裕太 (ユータ)",
          "ja": "弾いてくれないかって",
          "tc": "在餐廳演奏大提琴。",
          "sc": "在餐厅演奏大提琴。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 435068,
          "spk": "裕太 (ユータ)",
          "ja": "<player>は、どう思う？",
          "tc": "<player>，你覺得如何？",
          "sc": "<player>，你觉得如何？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 435075,
          "spk": "裕太 (ユータ)",
          "ja": "引き受けるべきかな",
          "tc": "我應該要答應嗎？",
          "sc": "我应该要答应吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 435084,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 435091,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7621,
      "rec_id": "TALK_ID_70_2120_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435184,
          "spk": "裕太 (ユータ)",
          "ja": "彼ヶ津村に来てから",
          "tc": "這是我來到彼津村之後，",
          "sc": "这是我来到彼津村之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435191,
          "spk": "裕太 (ユータ)",
          "ja": "求められたのって",
          "tc": "第一次有人",
          "sc": "第一次有人"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435198,
          "spk": "裕太 (ユータ)",
          "ja": "初めてなんだ",
          "tc": "需要我。",
          "sc": "需要我。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 435207,
          "spk": "裕太 (ユータ)",
          "ja": "応えてみたいって",
          "tc": "所以我也想要",
          "sc": "所以我也想要"
        },
        {
          "f_idx": 4,
          "pidx_tc": 435214,
          "spk": "裕太 (ユータ)",
          "ja": "気持ちが出てきてる",
          "tc": "回應對方的期待。",
          "sc": "回应对方的期待。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 435225,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと、やってみようかな",
          "tc": "我就稍微試試看吧。",
          "sc": "我就稍微试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7622,
      "rec_id": "TALK_ID_70_2120_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435243,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435254,
          "spk": "裕太 (ユータ)",
          "ja": "キミが応援してくれてると",
          "tc": "只要一想到有你幫我加油，",
          "sc": "只要一想到有你帮我加油，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435261,
          "spk": "裕太 (ユータ)",
          "ja": "思うと力が湧いてくるよ",
          "tc": "我心底就會湧出一股力量。",
          "sc": "我心底就会涌出一股力量。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 435270,
          "spk": "裕太 (ユータ)",
          "ja": "弾いてほしい曲が",
          "tc": "如果你有什麼想聽的曲子，",
          "sc": "如果你有什么想听的曲子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 435277,
          "spk": "裕太 (ユータ)",
          "ja": "あったら言ってね",
          "tc": "記得告訴我喔。",
          "sc": "记得告诉我哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 435284,
          "spk": "裕太 (ユータ)",
          "ja": "リクエストには応えるよ",
          "tc": "我會接受點歌的。",
          "sc": "我会接受点歌的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7623,
      "rec_id": "TALK_ID_70_2120_005_01",
      "lines": [
        {
