    {
      "file": "talk.dat",
      "rec_idx": 7625,
      "rec_id": "TALK_ID_70_2120_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435342,
          "spk": "裕太 (ユータ)",
          "ja": "わわ……",
          "tc": "哇……",
          "sc": "哇……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435349,
          "spk": "裕太 (ユータ)",
          "ja": "あわわわ……",
          "tc": "嗚哇……",
          "sc": "呜哇……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435360,
          "spk": "名护 (ナゴ)",
          "ja": "な、何が",
          "tc": "這、這是",
          "sc": "这、这是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 435367,
          "spk": "名护 (ナゴ)",
          "ja": "起こったんだ……？",
          "tc": "發生了什麼事……？",
          "sc": "发生了什么事……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7626,
      "rec_id": "TALK_ID_70_2120_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435395,
          "spk": "裕太 (ユータ)",
          "ja": "ナゴさん、<player>",
          "tc": "名護先生、<player>，",
          "sc": "名护先生、<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435402,
          "spk": "裕太 (ユータ)",
          "ja": "片付けを手伝ってくれて",
          "tc": "謝謝你們",
          "sc": "谢谢你们"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435409,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 435422,
          "spk": "名护 (ナゴ)",
          "ja": "それはいいんだが",
          "tc": "這沒什麼，",
          "sc": "这没什么，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 435429,
          "spk": "名护 (ナゴ)",
          "ja": "一体何が起こったんだ？",
          "tc": "但這裡到底是發生了什麼事？",
          "sc": "但这里到底是发生了什么事？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 435440,
          "spk": "名护 (ナゴ)",
          "ja": "俺の認識では",
          "tc": "依我的理解，",
          "sc": "依我的理解，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 435447,
          "spk": "名护 (ナゴ)",
          "ja": "この家に入った途端",
          "tc": "是在我踏入這間房子的瞬間，",
          "sc": "是在我踏入这间房子的瞬间，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 435454,
          "spk": "名护 (ナゴ)",
          "ja": "何かが破裂したんだが……",
          "tc": "有什麼東西爆掉了……",
          "sc": "有什么东西爆掉了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 435467,
          "spk": "裕太 (ユータ)",
          "ja": "味噌が爆発したんだ",
          "tc": "是味噌爆炸了。",
          "sc": "是味噌爆炸了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7627,
      "rec_id": "TALK_ID_70_2120_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435485,
          "spk": "名护 (ナゴ)",
