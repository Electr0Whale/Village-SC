      "rec_id": "TALK_ID_70_2030_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407473,
          "spk": "木助 (キスケ)",
          "ja": "俺から言わせりゃてめぇの声が",
