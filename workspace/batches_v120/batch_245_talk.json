      "rec_id": "TALK_ID_70_2030_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407564,
          "spk": "木助 (キスケ)",
          "ja": "あぁ？　てめぇ、俺がいきなり",
          "tc": "啥～？你這傢伙，",
