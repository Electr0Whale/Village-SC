{
  "batch_id": "batch_245_talk",
  "group": "talk",
  "files": [
    "talk.dat"
  ],
  "record_count": 41,
  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6802,
      "rec_id": "TALK_ID_70_2030_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405720,
          "spk": "木助 (キスケ)",
          "ja": "……なんだよ",
          "tc": "……搞什麼啊？",
          "sc": "……搞什么啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405727,
          "spk": "木助 (キスケ)",
          "ja": "リンのヤツは、",
          "tc": "結果林這傢伙",
          "sc": "结果林这家伙"
        },
        {
          "f_idx": 2,
          "pidx_tc": 405734,
          "spk": "木助 (キスケ)",
          "ja": "結局なにに怒ってたんだ？",
          "tc": "到底在生什麼氣？",
          "sc": "到底在生什么气？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6803,
      "rec_id": "TALK_ID_70_2030_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405758,
          "spk": "木助 (キスケ)",
          "ja": "村長は色々と難しいことを",
          "tc": "身為村長有很多",
          "sc": "身为村长有很多"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405765,
          "spk": "木助 (キスケ)",
          "ja": "考えないといけねぇから大変だな",
          "tc": "複雜的事情要考慮，很辛苦的。",
          "sc": "复杂的事情要考虑，很辛苦的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 405783,
          "spk": "木助 (キスケ)",
          "ja": "なにも、相談相手に",
          "tc": "再怎麼說，要找商量對象，",
          "sc": "再怎么说，要找商量对象，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 405790,
          "spk": "木助 (キスケ)",
          "ja": "俺を選ばなくたって",
          "tc": "也不是非選擇我",
          "sc": "也不是非选择我"
        },
        {
          "f_idx": 5,
          "pidx_tc": 405797,
          "spk": "木助 (キスケ)",
          "ja": "よさそうなもんだが……",
          "tc": "才行吧……",
          "sc": "才行吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6804,
      "rec_id": "TALK_ID_70_2030_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405815,
          "spk": "木助 (キスケ)",
          "ja": "俺はリンの従兄なんだ",
          "tc": "我是林的表哥，",
          "sc": "我是林的表哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405822,
          "spk": "木助 (キスケ)",
          "ja": "小さい頃によく遊んでくれた兄ちゃんって",
          "tc": "她對我的印象大概還停留在",
          "sc": "她对我的印象大概还停留在"
        },
        {
          "f_idx": 2,
          "pidx_tc": 405829,
          "spk": "木助 (キスケ)",
          "ja": "イメージがまんま残ってるんだろうよ",
          "tc": "小時候常常一起玩的大哥哥吧。",
          "sc": "小时候常常一起玩的大哥哥吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 405840,
          "spk": "木助 (キスケ)",
          "ja": "ただ……困ったことに",
          "tc": "但其實……我有點傷腦筋，",
          "sc": "但其实……我有点伤脑筋，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 405847,
          "spk": "木助 (キスケ)",
          "ja": "たまにああやって、",
          "tc": "她有時會像那樣，",
          "sc": "她有时会像那样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 405854,
          "spk": "木助 (キスケ)",
          "ja": "俺に八つ当たりして帰っていきやがる",
          "tc": "來對我發脾氣後就逕自回去了。",
          "sc": "来对我发脾气后就迳自回去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6805,
      "rec_id": "TALK_ID_70_2030_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405872,
          "spk": "木助 (キスケ)",
          "ja": "そもそもよく考えてみろっての",
          "tc": "但其實仔細想想也知道，",
          "sc": "但其实仔细想想也知道，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405881,
          "spk": "木助 (キスケ)",
          "ja": "干支が一回り以上離れた小娘の話が、",
          "tc": "我和年齡相差一輪以上的小女孩之間，",
          "sc": "我和年龄相差一轮以上的小女孩之间，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 405888,
          "spk": "木助 (キスケ)",
          "ja": "俺と噛み合うはずがねぇだろうが……",
          "tc": "話題怎麼可能有交集？",
          "sc": "话题怎么可能有交集？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6806,
      "rec_id": "TALK_ID_70_2030_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405913,
          "spk": "木助 (キスケ)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405920,
          "spk": "木助 (キスケ)",
          "ja": "無駄にキレられて疲れちまったぜ……",
          "tc": "被無緣無故地發脾氣搞得好累……",
          "sc": "被无缘无故地发脾气搞得好累……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 405927,
          "spk": "木助 (キスケ)",
          "ja": "ちょっと昼寝でもするかな……",
          "tc": "去睡個午覺好了……",
          "sc": "去睡个午觉好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6807,
      "rec_id": "TALK_ID_70_2030_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405951,
          "spk": "木助 (キスケ)",
          "ja": "よお、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405958,
          "spk": "木助 (キスケ)",
          "ja": "なんか用か？",
          "tc": "有事嗎？",
          "sc": "有事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6808,
      "rec_id": "TALK_ID_70_2030_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 405976,
          "spk": "木助 (キスケ)",
          "ja": "ああ、これか？",
          "tc": "哦，這個啊？",
          "sc": "哦，这个啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 405983,
          "spk": "木助 (キスケ)",
          "ja": "ヨウの本棚作ってんだ",
          "tc": "我在做洋的書架。",
          "sc": "我在做洋的书架。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 405990,
          "spk": "木助 (キスケ)",
          "ja": "ロッカクのやつに頼まれててな",
          "tc": "是六角那傢伙拜託我的。",
          "sc": "是六角那家伙拜托我的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406001,
          "spk": "木助 (キスケ)",
          "ja": "興味があるのか？",
          "tc": "你有興趣嗎？",
          "sc": "你有兴趣吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406008,
          "spk": "木助 (キスケ)",
          "ja": "見学したけりゃ勝手にしてろよ",
          "tc": "想觀摩的話請自便。",
          "sc": "想观摩的话请自便。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6809,
      "rec_id": "TALK_ID_70_2030_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406039,
          "spk": "木助 (キスケ)",
          "ja": "これで完成だ",
          "tc": "這樣就完成了。",
          "sc": "这样就完成了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406046,
          "spk": "木助 (キスケ)",
          "ja": "どうだ、立派なもんだろ",
          "tc": "怎麼樣？做得很好吧？",
          "sc": "怎么样？做得很好吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6810,
      "rec_id": "TALK_ID_70_2030_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406064,
          "spk": "木助 (キスケ)",
          "ja": "おっ、いい出来だって",
          "tc": "哦！連你都看得出來",
          "sc": "哦！连你都看得出来"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406071,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもわかるか？",
          "tc": "是個好東西啊？",
          "sc": "是个好东西啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406082,
          "spk": "木助 (キスケ)",
          "ja": "俺はな、サザンカやロッカクみてぇに",
          "tc": "要我像茶梅或六角那樣",
          "sc": "要我像茶梅或六角那样"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406089,
          "spk": "木助 (キスケ)",
          "ja": "いつも店開いて店に立ってるような",
          "tc": "每天開店招呼客人，",
          "sc": "每天开店招呼客人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406096,
          "spk": "木助 (キスケ)",
          "ja": "仕事のやり方はしてねえんだ",
          "tc": "那種工作我可做不來。",
          "sc": "那种工作我可做不来。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406107,
          "spk": "木助 (キスケ)",
          "ja": "依頼がなけりゃ何もしねぇからよ、",
          "tc": "只要沒人委託我就不做事，",
          "sc": "只要没人委托我就不做事，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406114,
          "spk": "木助 (キスケ)",
          "ja": "基本は穀潰しか昼行灯とでも",
          "tc": "基本上沒事的時候，",
          "sc": "基本上没事的时候，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406121,
          "spk": "木助 (キスケ)",
          "ja": "思ってもらってもかまわねえ",
          "tc": "我就和米蟲或草包沒兩樣啦。",
          "sc": "我就和米虫或草包没两样啦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 406132,
          "spk": "木助 (キスケ)",
          "ja": "けど、依頼されたらこの通り、",
          "tc": "但是，一旦接到委託，",
          "sc": "但是，一旦接到委托，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406139,
          "spk": "木助 (キスケ)",
          "ja": "意外と丁寧な仕上がりだろ？",
          "tc": "我做出來的成果意外地精緻對吧？",
          "sc": "我做出来的成果意外地精致对吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 406146,
          "spk": "木助 (キスケ)",
          "ja": "適当にやるのは性に合わねえんだ",
          "tc": "我的個性可沒辦法隨便做做。",
          "sc": "我的个性可没办法随便做做。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 406157,
          "spk": "木助 (キスケ)",
          "ja": "ヨウの本棚だって、",
          "tc": "像是洋的書架，",
          "sc": "像是洋的书架，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 406164,
          "spk": "木助 (キスケ)",
          "ja": "作るのはこれで三度目なんだぜ",
          "tc": "這已經是第三次做了。",
          "sc": "这已经是第三次做了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6811,
      "rec_id": "TALK_ID_70_2030_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406182,
          "spk": "木助 (キスケ)",
          "ja": "家具ってのは、成長に合わせて",
          "tc": "畢竟家具這種東西，",
          "sc": "毕竟家具这种东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406189,
          "spk": "木助 (キスケ)",
          "ja": "必要になるもんだからな",
          "tc": "需要配合成長來製作才行啊。",
          "sc": "需要配合成长来制作才行啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406200,
          "spk": "木助 (キスケ)",
          "ja": "ヨウが赤ん坊の頃には",
          "tc": "洋還是小嬰兒的時候，",
          "sc": "洋还是小婴儿的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406207,
          "spk": "木助 (キスケ)",
          "ja": "ベビーベッドだって作ってやったし、",
          "tc": "我還幫她做過嬰兒床，",
          "sc": "我还帮她做过婴儿床，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406214,
          "spk": "木助 (キスケ)",
          "ja": "机や椅子だって俺の制作物だ",
          "tc": "桌子和椅子也都是我做的呢。",
          "sc": "桌子和椅子也都是我做的呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406225,
          "spk": "木助 (キスケ)",
          "ja": "……こうして振り返ってみると、",
          "tc": "……這樣回憶下來，",
          "sc": "……这样回忆下来，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406232,
          "spk": "木助 (キスケ)",
          "ja": "俺の家具が村の連中の生活を",
          "tc": "我製作的家具或許也一路以來",
          "sc": "我制作的家具或许也一路以来"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406239,
          "spk": "木助 (キスケ)",
          "ja": "支えてきたのかもしれねえな……",
          "tc": "支持著村子裡人們的生活……",
          "sc": "支持着村子里人们的生活……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6812,
      "rec_id": "TALK_ID_70_2030_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406263,
          "spk": "六角 (ロッカク)",
          "ja": "ワシらの生活を支えてるって言うなら、",
          "tc": "如果你自認支持著我們的生活，",
          "sc": "如果你自认支持着我们的生活，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406270,
          "spk": "六角 (ロッカク)",
          "ja": "うちのツケを払ってもらいたいっスね",
          "tc": "那就先把在我店裡賒的帳付清吧。",
          "sc": "那就先把在我店里赊的帐付清呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6813,
      "rec_id": "TALK_ID_70_2030_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406297,
          "spk": "木助 (キスケ)",
          "ja": "……あん？",
          "tc": "……啊？",
          "sc": "……啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406304,
          "spk": "木助 (キスケ)",
          "ja": "なんでそうなる？",
          "tc": "為什麼話題變成要付帳？",
          "sc": "为什么话题变成要付帐？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406317,
          "spk": "六角 (ロッカク)",
          "ja": "だって、さすがにツケが多すぎるっスよ？",
          "tc": "因為，實在欠太多了好嗎？",
          "sc": "因为，实在欠太多了好吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406324,
          "spk": "六角 (ロッカク)",
          "ja": "このままだと永遠にうちの店は",
          "tc": "這樣下去只能永遠",
          "sc": "这样下去只能永远"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406331,
          "spk": "六角 (ロッカク)",
          "ja": "キスケさん出禁っス",
          "tc": "把木助你列入黑名單了。",
          "sc": "把木助你列入黑名单呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406344,
          "spk": "木助 (キスケ)",
          "ja": "そこは多少オマケしてくれよ",
          "tc": "你就睜一隻眼閉一隻眼嘛。",
          "sc": "你就睁一只眼闭一只眼嘛。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406351,
          "spk": "木助 (キスケ)",
          "ja": "見ろ、立派な本棚ができたんだぜ？",
          "tc": "你看，我做了很棒的書架耶！",
          "sc": "你看，我做了很棒的书架呢！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406358,
          "spk": "木助 (キスケ)",
          "ja": "なあ、<player>",
          "tc": "對吧？<player>。",
          "sc": "对吧？<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6814,
      "rec_id": "TALK_ID_70_2030_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406376,
          "spk": "六角 (ロッカク)",
          "ja": "本棚は見事な出来だと思うっス",
          "tc": "書架做得很出色對吧。",
          "sc": "书架做得很出色对呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406383,
          "spk": "六角 (ロッカク)",
          "ja": "ただね、ツケがかさむと",
          "tc": "只是啊，要是繼續讓你賒帳下去，",
          "sc": "只是啊，要是继续让你赊帐下去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406390,
          "spk": "六角 (ロッカク)",
          "ja": "うちの赤字が膨らむんスよ",
          "tc": "我的店會越做越賠錢……",
          "sc": "我的店会越做越赔钱……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406399,
          "spk": "六角 (ロッカク)",
          "ja": "赤字が続くとヨウさんの",
          "tc": "一直虧下去對洋妹妹的生活",
          "sc": "一直亏下去对洋妹妹的生活"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406406,
          "spk": "六角 (ロッカク)",
          "ja": "生活にも支障が出るっス",
          "tc": "也會造成影響的。",
          "sc": "也会造成影响呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406419,
          "spk": "木助 (キスケ)",
          "ja": "お、おう……そうか",
          "tc": "是、是喔……這樣啊。",
          "sc": "是、是啊……这样啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406426,
          "spk": "木助 (キスケ)",
          "ja": "そりゃそうだな",
          "tc": "這麼說也是。",
          "sc": "这么说也是。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406437,
          "spk": "木助 (キスケ)",
          "ja": "そんじゃとりあえず、本棚の報酬で",
          "tc": "既然如此，",
          "sc": "既然如此，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 406444,
          "spk": "木助 (キスケ)",
          "ja": "まだ残ってる分があるからな",
          "tc": "書架的工錢還有剩，",
          "sc": "书架的工钱还有剩，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406451,
          "spk": "木助 (キスケ)",
          "ja": "そこから半分くらいツケにあててやる",
          "tc": "就拿其中的一半去付吧。",
          "sc": "就拿其中的一半去付吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6815,
      "rec_id": "TALK_ID_70_2030_002_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406477,
          "spk": "木助 (キスケ)",
          "ja": "残ってんのは……あー……そうか",
          "tc": "還剩下……啊……對了。",
          "sc": "还剩下……啊……对了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406484,
          "spk": "木助 (キスケ)",
          "ja": "チナナに酒代を支払ったんだったな",
          "tc": "我還付了酒錢給琪娜娜。",
          "sc": "我还付了酒钱给琪娜娜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406502,
          "spk": "木助 (キスケ)",
          "ja": "で、残り３０００円だから……",
          "tc": "所以，既然剩下3000元……",
          "sc": "所以，既然剩下3000元……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406509,
          "spk": "木助 (キスケ)",
          "ja": "払えんのは１５００円だ",
          "tc": "就給你1500元。",
          "sc": "就给你1500元。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406524,
          "spk": "六角 (ロッカク)",
          "ja": "全然足りないっス",
          "tc": "根本完全不夠啊。",
          "sc": "根本完全不够呐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406537,
          "spk": "木助 (キスケ)",
          "ja": "そんじゃ、このデカい本棚を",
          "tc": "那我幫忙把這個超大書架",
          "sc": "那我帮忙把这个超大书架"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406544,
          "spk": "木助 (キスケ)",
          "ja": "ヨウの部屋まで運んでやるよ",
          "tc": "搬去洋的房間吧。",
          "sc": "搬去洋的房间吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 406551,
          "spk": "木助 (キスケ)",
          "ja": "それでどうだ？",
          "tc": "這樣如何？",
          "sc": "这样如何？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406564,
          "spk": "六角 (ロッカク)",
          "ja": "それでも全然足りないんスけど……",
          "tc": "就算這樣也完全不夠啊……",
          "sc": "就算这样也完全不够啊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 406571,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、運んでもらえるのはありがたいんで",
          "tc": "不過我還是很謝謝你幫忙搬，",
          "sc": "不过我还是很谢谢你帮忙搬，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 406578,
          "spk": "六角 (ロッカク)",
          "ja": "一杯ぐらいご馳走するっスよ",
          "tc": "就請你喝一杯吧。",
          "sc": "就请你喝一杯哟。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 406591,
          "spk": "木助 (キスケ)",
          "ja": "おっ、ほんとかよ！",
          "tc": "哦！真的假的！",
          "sc": "哦！真的假的！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 406598,
          "spk": "木助 (キスケ)",
          "ja": "よっしゃ、タダ酒だ！",
          "tc": "讚啦，賺到免費的酒！",
          "sc": "赞啦，赚到免费的酒！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6816,
      "rec_id": "TALK_ID_70_2030_002_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406616,
          "spk": "木助 (キスケ)",
          "ja": "そういうわけだから、",
          "tc": "所以說，",
          "sc": "所以说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406623,
          "spk": "木助 (キスケ)",
          "ja": "見学はもう終わりだ",
          "tc": "觀摩到此結束啦。",
          "sc": "观摩到此结束啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406630,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "先走啦。",
          "sc": "先走啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406643,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんは、飲食代をツケにして",
          "tc": "<player>，你可千萬別變成",
          "sc": "<player>，你可千万别变成"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406650,
          "spk": "六角 (ロッカク)",
          "ja": "払えなくなるような大人には",
          "tc": "這種老是賒帳",
          "sc": "这种老是赊帐"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406657,
          "spk": "六角 (ロッカク)",
          "ja": "なったらいけないっスよ……",
          "tc": "付不出餐錢的大人啊……",
          "sc": "付不出餐钱的大人啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6817,
      "rec_id": "TALK_ID_70_2030_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406683,
          "spk": "木助 (キスケ)",
          "ja": "おいこら、<player>",
          "tc": "喂，<player>。",
          "sc": "喂，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6818,
      "rec_id": "TALK_ID_70_2030_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406721,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ、こんな場所でなにしてんだよ……",
          "tc": "你到這種地方來幹嘛……",
          "sc": "你到这种地方来干嘛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406728,
          "spk": "木助 (キスケ)",
          "ja": "一人で来たのか？",
          "tc": "你一個人來嗎？",
          "sc": "你一个人来吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406735,
          "spk": "木助 (キスケ)",
          "ja": "危険な獣は……まぁ、てめぇなら大丈夫か",
          "tc": "小心危險的野獸……唉，你的話應該沒事。",
          "sc": "小心危险的野兽……唉，你的话应该没事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6819,
      "rec_id": "TALK_ID_70_2030_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406753,
          "spk": "木助 (キスケ)",
          "ja": "……それにしても",
          "tc": "……不過話說回來，",
          "sc": "……不过话说回来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406760,
          "spk": "木助 (キスケ)",
          "ja": "コマコやシロージがいねえと思って来たのに、",
          "tc": "我想說駒子或四郎治不在才來的，",
          "sc": "我想说驹子或四郎治不在才来的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406767,
          "spk": "木助 (キスケ)",
          "ja": "まさか人がいるなんて……",
          "tc": "沒想到會有人在……",
          "sc": "没想到会有人在……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406778,
          "spk": "木助 (キスケ)",
          "ja": "……まぁ、てめぇならいいか",
          "tc": "……不過，是你的話就算了。",
          "sc": "……不过，是你的话就算了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406785,
          "spk": "木助 (キスケ)",
          "ja": "口数も少ねぇし、誰にも言わないだろうからな",
          "tc": "你不多話，應該也不會說出去吧。",
          "sc": "你不多话，应该也不会说出去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6820,
      "rec_id": "TALK_ID_70_2030_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406810,
          "spk": "木助 (キスケ)",
          "ja": "俺がここに来た理由は……こいつさ",
          "tc": "我會來這裡是因為……這傢伙。",
          "sc": "我会来这里是因为……这家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6821,
      "rec_id": "TALK_ID_70_2030_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406834,
          "spk": "木助 (キスケ)",
          "ja": "はは、そんなにビビらなくていいぜ",
          "tc": "哈哈，你不用那麼害怕。",
          "sc": "哈哈，你不用那么害怕。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406841,
          "spk": "木助 (キスケ)",
          "ja": "大きな破裂音が鳴るだけの空砲だ",
          "tc": "子彈是會發出巨大爆裂聲的空包彈。",
          "sc": "子弹是会发出巨大爆裂声的空包弹。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406848,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには見せたことなかったか？",
          "tc": "我還沒讓你看過嗎？",
          "sc": "我还没让你看过吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406859,
          "spk": "木助 (キスケ)",
          "ja": "こいつは昔から樹木家で保管してる古い猟銃でな",
          "tc": "這是從很久以前由樹木家保管的古老手槍，",
          "sc": "这是从很久以前由树木家保管的古老手枪，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406866,
          "spk": "木助 (キスケ)",
          "ja": "シロージとコマコの先祖が、",
          "tc": "駒子與四郎治的祖先，",
          "sc": "驹子与四郎治的祖先，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406873,
          "spk": "木助 (キスケ)",
          "ja": "北からこの土地に来た時に持ってきたんだとよ",
          "tc": "由北方來到這裡時帶來的。",
          "sc": "由北方来到这里时带来的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406884,
          "spk": "木助 (キスケ)",
          "ja": "骨董品だが、俺やシロージが",
          "tc": "雖然已經是骨董，但我和四郎治",
          "sc": "虽然已经是骨董，但我和四郎治"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406891,
          "spk": "木助 (キスケ)",
          "ja": "手入れしてるからまだまだ現役だ",
          "tc": "一直都好好地保養著，所以還能使用。",
          "sc": "一直都好好地保养着，所以还能使用。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 406898,
          "spk": "木助 (キスケ)",
          "ja": "ただ、いざって時に動かなかったら困るだろ？",
          "tc": "畢竟必要時才故障也是很困擾對吧？",
          "sc": "毕竟必要时才故障也是很困扰对吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406909,
          "spk": "木助 (キスケ)",
          "ja": "だから俺が、",
          "tc": "……所以我",
          "sc": "……所以我"
        },
        {
          "f_idx": 10,
          "pidx_tc": 406916,
          "spk": "木助 (キスケ)",
          "ja": "こうしてこっそりここに持ってきて、",
          "tc": "就會像這樣偷偷帶來這裡，",
          "sc": "就会像这样偷偷带来这里，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 406923,
          "spk": "木助 (キスケ)",
          "ja": "山に向かってぶっ放してやってるんだ",
          "tc": "朝著山的方向開槍。",
          "sc": "朝着山的方向开枪。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6822,
      "rec_id": "TALK_ID_70_2030_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406941,
          "spk": "木助 (キスケ)",
          "ja": "ついでに山に向けて撃つことで、",
          "tc": "而且像這樣朝山開槍，",
          "sc": "而且像这样朝山开枪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406948,
          "spk": "木助 (キスケ)",
          "ja": "獣どもへの威嚇にもなるだろ？",
          "tc": "也能對野獸產生嚇阻的作用吧？",
          "sc": "也能对野兽产生吓阻的作用吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406955,
          "spk": "木助 (キスケ)",
          "ja": "奴らが村まで降りて来ねぇようにしてんだ",
          "tc": "這樣牠們就不會下山到村子來了。",
          "sc": "这样它们就不会下山到村子来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406966,
          "spk": "木助 (キスケ)",
          "ja": "あいつらをほったらかしにしておくと、",
          "tc": "要是放任那些傢伙不管，",
          "sc": "要是放任那些家伙不管，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406973,
          "spk": "木助 (キスケ)",
          "ja": "こっちはナメられっぱなしだ",
          "tc": "我們可是會被看扁的。",
          "sc": "我们可是会被看扁的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406980,
          "spk": "木助 (キスケ)",
          "ja": "好き勝手にのさばらせてたまるかよ",
          "tc": "怎麼能讓那些傢伙為所欲為。",
          "sc": "怎么能让那些家伙为所欲为。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6823,
      "rec_id": "TALK_ID_70_2030_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406998,
          "spk": "木助 (キスケ)",
          "ja": "それに、厄介な連中は、獣だけじゃねぇ……",
          "tc": "而且，麻煩的還不只有野獸……",
          "sc": "而且，麻烦的还不只有野兽……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407005,
          "spk": "木助 (キスケ)",
          "ja": "ヤツらも、デカい破裂音が苦手らしいからな……",
          "tc": "它們似乎也討厭巨大的爆裂聲……",
          "sc": "它们似乎也讨厌巨大的爆裂声……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407023,
          "spk": "木助 (キスケ)",
          "ja": "……まぁ、というのは建前で、",
          "tc": "……不過這些都是好聽話，",
          "sc": "……不过这些都是好听话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407030,
          "spk": "木助 (キスケ)",
          "ja": "本音を言うと、俺がデカい音を聞いて",
          "tc": "其實只是我想要聽這巨大的聲響，",
          "sc": "其实只是我想要听这巨大的声响，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 407037,
          "spk": "木助 (キスケ)",
          "ja": "ストレス発散したいだけなんだ",
          "tc": "來消除壓力罷了。",
          "sc": "来消除压力罢了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 407048,
          "spk": "木助 (キスケ)",
          "ja": "そうだ、<player>、",
          "tc": "對了，<player>，",
          "sc": "对了，<player>，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 407055,
          "spk": "木助 (キスケ)",
          "ja": "てめぇにも発砲音、聞かせてやるよ",
          "tc": "也讓你聽聽開槍聲吧。",
          "sc": "也让你听听开枪声吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 407062,
          "spk": "木助 (キスケ)",
          "ja": "山中に響き渡って、不思議だぜ",
          "tc": "聲音繚繞在山林間，真的很不可思議。",
          "sc": "声音缭绕在山林间，真的很不可思议。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 407071,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 407078,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6824,
      "rec_id": "TALK_ID_70_2030_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407156,
          "spk": "木助 (キスケ)",
          "ja": "じゃ、撃っちまうぞ",
          "tc": "那我要開槍囉。",
          "sc": "那我可要开枪喽。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6825,
      "rec_id": "TALK_ID_70_2030_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407180,
          "spk": "木助 (キスケ)",
          "ja": "……すげぇよな",
          "tc": "……很厲害吧。",
          "sc": "……很厉害吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407187,
          "spk": "木助 (キスケ)",
          "ja": "……目が覚めるような音だぜ",
          "tc": "……這聲音像是會喚醒人一樣。",
          "sc": "……这声音像是会唤醒人一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6826,
      "rec_id": "TALK_ID_70_2030_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407207,
          "spk": "木助 (キスケ)",
          "ja": "おいおい……大丈夫か？",
          "tc": "喂喂喂……你沒事吧？",
          "sc": "喂喂喂……你没事吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407214,
          "spk": "木助 (キスケ)",
          "ja": "ちゃんと合図したのに……",
          "tc": "我明明跟你示意了……",
          "sc": "我明明跟你示意了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407221,
          "spk": "木助 (キスケ)",
          "ja": "腰が抜けちまったのかよ",
          "tc": "你怎麼還嚇到腿軟啊。",
          "sc": "你怎么还吓到腿软啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407232,
          "spk": "木助 (キスケ)",
          "ja": "……だが、てめぇは逃げ出さなかった",
          "tc": "……不過，既然你沒有逃走，",
          "sc": "……不过，既然你没有逃走，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407239,
          "spk": "木助 (キスケ)",
          "ja": "つまり、厄介な連中とは違うってことだ",
          "tc": "就表示你跟那些麻煩的傢伙不同。",
          "sc": "就表示你跟那些麻烦的家伙不同。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6827,
      "rec_id": "TALK_ID_70_2030_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407270,
          "spk": "木助 (キスケ)",
          "ja": "はは、間抜けな顔しやがって……",
          "tc": "哈哈哈，瞧你一臉呆樣……",
          "sc": "哈哈哈，瞧你一脸呆样……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407277,
          "spk": "木助 (キスケ)",
          "ja": "相変わらず変わったやつだな",
          "tc": "果然是個奇怪的傢伙。",
          "sc": "果然是个奇怪的家伙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407288,
          "spk": "木助 (キスケ)",
          "ja": "今日は楽しかったよ",
          "tc": "今天真開心。",
          "sc": "今天真开心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407295,
          "spk": "木助 (キスケ)",
          "ja": "気が向いたら、また話でも聞いてくれ",
          "tc": "改天想來的時候再過來聊聊吧。",
          "sc": "改天想来的时候再过来聊聊吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6828,
      "rec_id": "TALK_ID_70_2030_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407313,
          "spk": "木助 (キスケ)",
          "ja": "そうだ……",
