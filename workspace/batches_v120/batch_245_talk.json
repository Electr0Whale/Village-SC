          "f_idx": 7,
          "pidx_tc": 407623,
          "spk": "木助 (キスケ)",
          "ja": "庭の隅っこでも借りたほうがいいだろォ",
          "tc": "不如借用庭院一角更好吧～",
          "sc": "不如借用庭院一角更好吧～"
        },
        {
          "f_idx": 8,
          "pidx_tc": 407636,
          "spk": "裕太 (ユータ)",
          "ja": "どういう理屈……？",
          "tc": "這是哪門子歪理……？",
          "sc": "这是哪门子歪理……？"
