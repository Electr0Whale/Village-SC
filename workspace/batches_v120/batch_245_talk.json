          "sc": "对了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407320,
          "spk": "木助 (キスケ)",
          "ja": "これからはてめぇの好きな時に",
          "tc": "今後你想找我的時候，",
          "sc": "今后你想找我的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407327,
          "spk": "木助 (キスケ)",
          "ja": "俺の家に来ていいぜ",
          "tc": "可以來我家。",
          "sc": "可以来我家。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407338,
          "spk": "木助 (キスケ)",
          "ja": "特にもてなしはねぇが",
          "tc": "雖然沒什麼好招待的，",
          "sc": "虽然没什么好招待的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407345,
          "spk": "木助 (キスケ)",
          "ja": "それでもよければな",
          "tc": "只要你不介意的話。",
          "sc": "只要你不介意的话。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6829,
      "rec_id": "TALK_ID_70_2030_003_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407365,
          "spk": "木助 (キスケ)",
          "ja": "おいおい、そんなに喜ぶことかよ",
          "tc": "欸欸，有這麼值得高興嗎？",
