        {
          "f_idx": 4,
          "pidx_tc": 407397,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもほどほどに帰ってこいよ",
          "tc": "你也不要逗留太久，趕緊回去吧。",
          "sc": "你也不要逗留太久，赶紧回去吧。"
        }
      ]
    },
