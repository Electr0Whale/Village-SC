  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6886,
      "rec_id": "TALK_ID_70_2030_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410403,
          "spk": "木助 (キスケ)",
          "ja": "来たな、<player>",
          "tc": "你來啦，<player>。",
          "sc": "你来啦，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410410,
          "spk": "木助 (キスケ)",
          "ja": "待ちくたびれたぜ",
          "tc": "我等你好久了。",
          "sc": "我等你好久了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410421,
          "spk": "木助 (キスケ)",
          "ja": "喜べ！",
          "tc": "你很幸運！",
          "sc": "你很幸运！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410428,
          "spk": "木助 (キスケ)",
          "ja": "今日はてめぇに、",
          "tc": "今天要端出",
          "sc": "今天要端出"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410435,
          "spk": "木助 (キスケ)",
          "ja": "「ステーキ」を食わせてやるぜ！",
          "tc": "「肉排」讓你嘗嘗。",
          "sc": "“肉排”让你尝尝。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410446,
          "spk": "木助 (キスケ)",
          "ja": "チナナが牛の肉を大量に仕入れてな",
          "tc": "剛好琪娜娜進了大量的牛肉，",
          "sc": "刚好琪娜娜进了大量的牛肉，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 410453,
          "spk": "木助 (キスケ)",
          "ja": "そいつを買い占めたんだよ",
          "tc": "我把它們全買下來了。",
          "sc": "我把它们全买下来了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 410464,
          "spk": "木助 (キスケ)",
          "ja": "ビーフステーキは美味いぞ",
          "tc": "牛排可是很美味的喔！",
          "sc": "牛排可是很美味的啊！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 410471,
          "spk": "木助 (キスケ)",
          "ja": "おら、食え食え",
          "tc": "來，快吃吧！",
          "sc": "来，快吃吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6887,
      "rec_id": "TALK_ID_70_2030_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410502,
          "spk": "木助 (キスケ)",
          "ja": "この脂っ気、噛み応え……",
          "tc": "這個油花，還有嚼勁……",
          "sc": "这个油花，还有嚼劲……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410509,
          "spk": "木助 (キスケ)",
          "ja": "やっぱステーキはいいよな",
          "tc": "果然肉排就是讚啊。",
          "sc": "果然肉排就是赞啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410520,
          "spk": "木助 (キスケ)",
          "ja": "俺はステーキが大好物なんだ",
          "tc": "我啊，超愛吃肉排的，",
          "sc": "我啊，超爱吃肉排的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410527,
          "spk": "木助 (キスケ)",
          "ja": "肉は別にウシじゃなくても構わねぇ",
          "tc": "即使不是牛肉也沒關係。",
          "sc": "即使不是牛肉也没关系。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410545,
          "spk": "木助 (キスケ)",
          "ja": "何度かコマコが狩ってきた獣の肉をもらって、",
          "tc": "我有好幾次用駒子獵到的獸肉",
          "sc": "我有好几次用驹子猎到的兽肉"
        },
        {
          "f_idx": 6,
          "pidx_tc": 410552,
          "spk": "木助 (キスケ)",
          "ja": "いろんなステーキを作ったこともあるぜ",
          "tc": "做成各種肉排喔！",
          "sc": "做成各种肉排啊！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 410570,
          "spk": "木助 (キスケ)",
          "ja": "ウサギのステーキだろ",
          "tc": "比方說兔肉排，",
          "sc": "比方说兔肉排，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 410577,
          "spk": "木助 (キスケ)",
          "ja": "キツネに、イノシシ、クマ……",
          "tc": "還有狐狸、野豬、熊……",
          "sc": "还有狐狸、野猪、熊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 410588,
          "spk": "木助 (キスケ)",
          "ja": "あとはヘビとかモグラの",
          "tc": "甚至連蛇肉和鼴鼠肉",
          "sc": "甚至连蛇肉和鼹鼠肉"
        },
        {
          "f_idx": 11,
          "pidx_tc": 410595,
          "spk": "木助 (キスケ)",
          "ja": "ステーキも作って食ったな",
          "tc": "也都做成肉排吃過。",
          "sc": "也都做成肉排吃过。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6888,
      "rec_id": "TALK_ID_70_2030_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410613,
          "spk": "木助 (キスケ)",
          "ja": "なんだ、その反応は",
          "tc": "怎樣，你這什麼反應啊？",
          "sc": "怎样，你这什么反应啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410620,
          "spk": "木助 (キスケ)",
          "ja": "気になるステーキがあるなら、",
          "tc": "如果有想嘗試的肉排，",
          "sc": "如果有想尝试的肉排，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410627,
          "spk": "木助 (キスケ)",
          "ja": "作ってやろうか？",
          "tc": "要我做給你吃嗎？",
          "sc": "要我做给你吃吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410636,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410643,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6889,
      "rec_id": "TALK_ID_70_2030_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410725,
          "spk": "木助 (キスケ)",
          "ja": "とりあえず今日は贅沢な",
          "tc": "總之，今天是奢侈的",
          "sc": "总之，今天是奢侈的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410732,
          "spk": "木助 (キスケ)",
          "ja": "ビーフステーキ祭りだ",
          "tc": "牛排祭典！",
          "sc": "牛排祭典！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410739,
          "spk": "木助 (キスケ)",
          "ja": "ほら、もっと食え",
          "tc": "來，再多吃點！",
          "sc": "来，再多吃点！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6890,
      "rec_id": "TALK_ID_70_2030_008_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410757,
          "spk": "木助 (キスケ)",
          "ja": "どうした、嚙み切れねぇのか？",
          "tc": "怎麼，咬不斷嗎？",
          "sc": "怎么，咬不断吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410764,
          "spk": "木助 (キスケ)",
          "ja": "おいおい、軟弱だなぁ……",
          "tc": "喂喂，也太遜了吧……",
          "sc": "喂喂，也太逊了吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410775,
          "spk": "木助 (キスケ)",
          "ja": "どれ、俺が細かく切ってやろう",
          "tc": "幫你切小塊一點。",
          "sc": "帮你切小块一点。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410782,
          "spk": "木助 (キスケ)",
          "ja": "貸してみろ",
          "tc": "給我吧。",
          "sc": "给我吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410793,
          "spk": "木助 (キスケ)",
          "ja": "これ食ってしっかり",
          "tc": "多吃一點，",
          "sc": "多吃一点，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410800,
          "spk": "木助 (キスケ)",
          "ja": "顎を鍛えろよ",
          "tc": "然後好好鍛鍊下顎吧！",
          "sc": "然后好好锻炼下颚吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6891,
      "rec_id": "TALK_ID_70_2030_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410824,
          "spk": "木助 (キスケ)",
          "ja": "お、<player>じゃねぇか",
          "tc": "喔，這不是<player>嗎！",
          "sc": "喔，这不是<player>吗！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410831,
          "spk": "木助 (キスケ)",
          "ja": "今日は酒を呑もうと思ってな",
          "tc": "我今天打算喝點酒，",
          "sc": "我今天打算喝点酒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410842,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには「レモネード」を用意してある",
          "tc": "至於你嘛，我準備了「檸檬水」。",
          "sc": "至于你嘛，我准备了“柠檬水”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410849,
          "spk": "木助 (キスケ)",
          "ja": "一緒に呑もう",
          "tc": "一起喝吧。",
          "sc": "一起喝吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6892,
      "rec_id": "TALK_ID_70_2030_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410880,
          "spk": "木助 (キスケ)",
          "ja": "……おっと",
          "tc": "……哎呀。",
          "sc": "……哎呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410887,
          "spk": "木助 (キスケ)",
          "ja": "日本酒が切れちまったな",
          "tc": "日本酒喝光啦。",
          "sc": "日本酒喝光啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410894,
          "spk": "木助 (キスケ)",
          "ja": "となると、次は焼酎か",
          "tc": "那接下來換喝燒酎吧。",
          "sc": "那接下来换喝烧酎吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410905,
          "spk": "木助 (キスケ)",
          "ja": "芋と麦があるが……甲乙つけがたいな",
          "tc": "有地瓜和大麥釀的……好難抉擇啊。",
          "sc": "有红薯和大麦酿的……好难抉择啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410912,
          "spk": "木助 (キスケ)",
          "ja": "<player>、選んでくれるか？",
          "tc": "<player>，可以幫我選嗎？",
          "sc": "<player>，可以帮我选吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410919,
          "spk": "木助 (キスケ)",
          "ja": "芋と麦、てめぇならどっちの気分だ？",
          "tc": "地瓜和大麥，你想喝哪個？",
          "sc": "红薯和大麦，你想喝哪个？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 410928,
          "spk": "主角心声/旁白/选项",
          "ja": "芋",
          "tc": "地瓜",
          "sc": "红薯"
        },
        {
          "f_idx": 7,
          "pidx_tc": 410935,
          "spk": "主角心声/旁白/选项",
          "ja": "麦",
          "tc": "大麥",
          "sc": "大麦"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6893,
      "rec_id": "TALK_ID_70_2030_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411017,
          "spk": "木助 (キスケ)",
          "ja": "お、そうだ",
          "tc": "啊，對了。",
          "sc": "啊，对了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411024,
          "spk": "木助 (キスケ)",
          "ja": "そこの皿に盛ってある塩、",
          "tc": "那邊盤子裡裝的鹽，",
          "sc": "那边盘子里装的盐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411031,
          "spk": "木助 (キスケ)",
          "ja": "好きな時に舐めていいからな",
          "tc": "隨時可以舔個幾口喔！",
          "sc": "随时可以舔个几口啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6894,
      "rec_id": "TALK_ID_70_2030_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411049,
          "spk": "木助 (キスケ)",
          "ja": "岩塩てやつだぜ",
          "tc": "這叫做岩鹽，",
          "sc": "这叫做岩盐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411056,
          "spk": "木助 (キスケ)",
          "ja": "こいつは酒のアテに",
          "tc": "用來配酒",
          "sc": "用来配酒"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411063,
          "spk": "木助 (キスケ)",
          "ja": "ピッタリなんだよ",
          "tc": "再適合不過了。",
          "sc": "再适合不过了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411074,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもレモネードで口の中が",
          "tc": "你要是喝了檸檬水覺得太甜膩，",
          "sc": "你要是喝了柠檬水觉得太甜腻，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411081,
          "spk": "木助 (キスケ)",
          "ja": "甘ったるくなったら舐めるといい",
          "tc": "那就舔一口試試吧。",
          "sc": "那就舔一口试试吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6895,
      "rec_id": "TALK_ID_70_2030_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411106,
          "spk": "木助 (キスケ)",
          "ja": "この組み合わせを覚えたら",
          "tc": "要是記住了這種組合，",
          "sc": "要是记住了这种组合，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411113,
          "spk": "木助 (キスケ)",
          "ja": "酒呑みになる可能性が高いな",
          "tc": "將來有可能會很愛喝酒喔！",
          "sc": "将来有可能会很爱喝酒啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411131,
          "spk": "木助 (キスケ)",
          "ja": "将来が楽しみだぜ",
          "tc": "真令人期待啊。",
          "sc": "真令人期待啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6896,
      "rec_id": "TALK_ID_70_2030_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411162,
          "spk": "木助 (キスケ)",
          "ja": "よお、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411169,
          "spk": "木助 (キスケ)",
          "ja": "最高のタイミングで来やがったな",
          "tc": "你來的正是時候。",
          "sc": "你来的正是时候。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6897,
      "rec_id": "TALK_ID_70_2030_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411187,
          "spk": "木助 (キスケ)",
          "ja": "昼はあちこち走り回って",
          "tc": "白天的時候到處跑，",
          "sc": "白天的时候到处跑，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411194,
          "spk": "木助 (キスケ)",
          "ja": "汗かいたんだろ？",
          "tc": "應該流了不少汗吧？",
          "sc": "应该流了不少汗吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411205,
          "spk": "木助 (キスケ)",
          "ja": "俺もひとっ風呂浴びたくてな",
          "tc": "因為我也想泡個澡，",
          "sc": "因为我也想泡个澡，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411212,
          "spk": "木助 (キスケ)",
          "ja": "ちょうど風呂を沸かしたとこだ",
          "tc": "剛好正在燒熱水呢。",
          "sc": "刚好正在烧热水呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411223,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもサッと入ってこい",
          "tc": "你也快點進去吧。",
          "sc": "你也快点进去吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 411230,
          "spk": "木助 (キスケ)",
          "ja": "もちろん、一人で入れるだろ？",
          "tc": "你應該可以一個人泡吧？",
          "sc": "你应该可以一个人泡吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 411239,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 7,
          "pidx_tc": 411246,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6898,
      "rec_id": "TALK_ID_70_2030_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411314,
          "spk": "木助 (キスケ)",
          "ja": "あ……やべ……",
          "tc": "啊……糟了……",
          "sc": "啊……糟了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411321,
          "spk": "木助 (キスケ)",
          "ja": "お湯、いつもの癖でアッツアツにしちまった……",
          "tc": "不小心就照平常的習慣把水燒到滾燙滾燙的……",
          "sc": "不小心就照平常的习惯把水烧到滚烫滚烫的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411328,
          "spk": "木助 (キスケ)",
          "ja": "水足してちょうどいい温度に調整して入るんだぞ",
          "tc": "你自己加冷水把水溫調整到適合溫度吧。",
          "sc": "你自己加冷水把水温调整到适合温度吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411339,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの風呂の合間に、",
          "tc": "在你泡澡的時候，",
          "sc": "在你泡澡的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411346,
          "spk": "木助 (キスケ)",
          "ja": "俺は晩飯を用意しておくぜ",
          "tc": "我就去準備晚餐囉。",
          "sc": "我就去准备晚饭啦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 411353,
          "spk": "木助 (キスケ)",
          "ja": "腕を振るって作ってやるから、楽しみにしてろよ",
          "tc": "看我大顯身手為你做頓好吃的，好好期待吧。",
          "sc": "看我大显身手为你做顿好吃的，好好期待吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6899,
      "rec_id": "TALK_ID_70_2030_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411377,
          "spk": "木助 (キスケ)",
          "ja": "さてと……明日もてめぇは仕事だろ？",
          "tc": "好了……你明天也要工作吧？",
          "sc": "好了……你明天也要工作吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411384,
          "spk": "木助 (キスケ)",
          "ja": "名残惜しいが……そろそろ寝るか",
          "tc": "雖然有點捨不得……但差不多該睡了。",
          "sc": "虽然有点舍不得……但差不多该睡了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411402,
          "spk": "木助 (キスケ)",
          "ja": "一応布団は干しておいたんだが……",
          "tc": "棉被我是曬過了……",
          "sc": "棉被我是晒过了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411409,
          "spk": "木助 (キスケ)",
          "ja": "俺は眠い、文句は明日の朝にしてくれ",
          "tc": "我累了，要抱怨的話，明天早上再說。",
          "sc": "我累了，要抱怨的话，明天早上再说。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 411416,
          "spk": "木助 (キスケ)",
          "ja": "それじゃ、早く布団に入れ！",
          "tc": "那就這樣，快進棉被裡躺好！",
          "sc": "那就这样，快进棉被里躺好！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6900,
      "rec_id": "TALK_ID_70_2030_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411436,
          "spk": "木助 (キスケ)",
          "ja": "……………………",
          "tc": "……………………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6901,
      "rec_id": "TALK_ID_70_2030_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411452,
          "spk": "木助 (キスケ)",
          "ja": "ゲッ……てめぇ……",
          "tc": "欸……你這傢伙……",
          "sc": "诶……你这家伙……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411459,
          "spk": "木助 (キスケ)",
          "ja": "起きてたのかよ……",
          "tc": "還醒著喔……",
          "sc": "还醒着啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6902,
      "rec_id": "TALK_ID_70_2030_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411475,
          "spk": "木助 (キスケ)",
          "ja": "はぁ……悪かったよ……",
          "tc": "唉……抱歉啦……",
          "sc": "唉……抱歉啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411482,
          "spk": "木助 (キスケ)",
          "ja": "じろじろ見ちまって……",
          "tc": "一直盯著你看……",
          "sc": "一直盯着你看……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411491,
          "spk": "木助 (キスケ)",
          "ja": "いや、その……",
          "tc": "沒有啦，就是那個……",
          "sc": "没有啦，就是那个……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411498,
          "spk": "木助 (キスケ)",
          "ja": "……最近どうにも、落ち着かなくてよ",
          "tc": "……最近總覺得坐立不安。",
          "sc": "……最近总觉得坐立不安。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6903,
      "rec_id": "TALK_ID_70_2030_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411514,
          "spk": "木助 (キスケ)",
          "ja": "気づくと、てめぇのこと目で追ってんだ……",
          "tc": "回過神來，才發現我的目光一直追著你……",
          "sc": "回过神来，才发现我的目光一直追着你……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411521,
          "spk": "木助 (キスケ)",
          "ja": "見張ってねぇと、不安で……",
          "tc": "不好好盯著你，就覺得不安……",
          "sc": "不好好盯着你，就觉得不安……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411537,
          "spk": "木助 (キスケ)",
          "ja": "……まぁ、もう隠してもしょうがねぇかァ",
          "tc": "……大概也瞞不下去了吧。",
          "sc": "……大概也瞒不下去了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 411553,
          "spk": "木助 (キスケ)",
          "ja": "<player>……てめぇは……",
          "tc": "<player>……你……",
          "sc": "<player>……你……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 411560,
          "spk": "木助 (キスケ)",
          "ja": "この先も、この彼ヶ津村にいるんだよな……？",
          "tc": "之後也會繼續待在彼津村裡……對吧？",
          "sc": "之后也会继续待在彼津村里……对吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 411569,
          "spk": "木助 (キスケ)",
          "ja": "てめぇのことだからよ……",
          "tc": "畢竟你這個人啊……",
          "sc": "毕竟你这个人啊……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 411576,
          "spk": "木助 (キスケ)",
          "ja": "好奇心旺盛で、退屈が嫌いで……",
          "tc": "就是充滿好奇心，又怕無聊……",
          "sc": "就是充满好奇心，又怕无聊……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 411583,
          "spk": "木助 (キスケ)",
          "ja": "……危ないことにも平気で首突っ込む",
          "tc": "……連危險的事情也若無其事地插手，",
          "sc": "……连危险的事情也若无其事地插手，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6904,
      "rec_id": "TALK_ID_70_2030_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411599,
          "spk": "木助 (キスケ)",
          "ja": "だからさ……ここに飽きたら、",
          "tc": "所以我一直覺得……等你厭倦了，",
          "sc": "所以我一直觉得……等你厌倦了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411606,
          "spk": "木助 (キスケ)",
          "ja": "どっか行っちまうんじゃねぇかって思うんだ",
          "tc": "就會離開這裡去別的地方。",
          "sc": "就会离开这里去别的地方。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6905,
      "rec_id": "TALK_ID_70_2030_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411622,
          "spk": "木助 (キスケ)",
          "ja": "それに……なんていうか……",
          "tc": "而且……怎麼說好呢……",
          "sc": "而且……怎么说好呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411629,
          "spk": "木助 (キスケ)",
          "ja": "……気のせいかもしれねぇけど、",
          "tc": "……也許是我的錯覺，",
          "sc": "……也许是我的错觉，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411636,
          "spk": "木助 (キスケ)",
          "ja": "たまに、てめぇが遠くにいる気がするんだよ……",
          "tc": "但有時候我覺得你離得好遠……",
          "sc": "但有时候我觉得你离得好远……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411645,
          "spk": "木助 (キスケ)",
          "ja": "……いや、変なこと言ってるよな",
          "tc": "……唉，我講了很奇怪的話。",
          "sc": "……唉，我讲了很奇怪的话。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 411652,
          "spk": "木助 (キスケ)",
          "ja": "困らせちまってすまねぇ……",
          "tc": "抱歉，你應該很困擾吧……",
          "sc": "抱歉，你应该很困扰吧……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 411661,
          "spk": "木助 (キスケ)",
          "ja": "でもさ、頼むよ",
          "tc": "可是拜託你。",
          "sc": "可是拜托你。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 411668,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは、できるだけ長く、ここにいてくれ",
          "tc": "拜託你盡可能在這裡待久一點。",
          "sc": "拜托你尽可能在这里待久一点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6906,
      "rec_id": "TALK_ID_70_2030_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411684,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは……",
          "tc": "你……",
          "sc": "你……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411691,
          "spk": "木助 (キスケ)",
          "ja": "コダマのように、急にいなくなったり……",
          "tc": "應該不會像木珠那樣……",
          "sc": "应该不会像木珠那样……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411698,
          "spk": "木助 (キスケ)",
          "ja": "……しないよな？",
          "tc": "……突然消失對吧？",
          "sc": "……突然消失对吧？"
        }
      ]
    },
