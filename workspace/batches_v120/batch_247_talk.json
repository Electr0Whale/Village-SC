      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411755,
          "spk": "木助 (キスケ)",
          "ja": "……やめだやめだ！",
          "tc": "……真是夠了！",
          "sc": "……真是够了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411762,
          "spk": "木助 (キスケ)",
          "ja": "なにを言ってんだ、俺は……！",
          "tc": "我到底在說什麼啊……！",
          "sc": "我到底在说什么啊……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6910,
      "rec_id": "TALK_ID_70_2030_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411778,
          "spk": "木助 (キスケ)",
          "ja": "もう寝る！",
          "tc": "我要睡了！",
          "sc": "我要睡了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411785,
          "spk": "木助 (キスケ)",
          "ja": "起こして悪かったな！",
          "tc": "抱歉吵醒你！",
          "sc": "抱歉吵醒你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6911,
      "rec_id": "TALK_ID_70_2030_010_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411801,
          "spk": "木助 (キスケ)",
          "ja": "おやすみ！",
          "tc": "晚安！",
          "sc": "晚安！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411808,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもさっさと寝ろよ！",
          "tc": "你也快點睡！",
          "sc": "你也快点睡！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6912,
      "rec_id": "TALK_ID_70_2030_010_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411828,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ……まだ眠そうな顔してんな",
          "tc": "你…………看起來還很睏呢。",
          "sc": "你……看起来还很困呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411835,
          "spk": "木助 (キスケ)",
          "ja": "昨日はよく眠れたか？",
          "tc": "昨天有睡好嗎？",
          "sc": "昨天有睡好吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6913,
      "rec_id": "TALK_ID_70_2030_010_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411853,
          "spk": "木助 (キスケ)",
          "ja": "……なかなか寝かせねぇで悪かったよ",
          "tc": "……沒讓你好好睡是我不對。",
          "sc": "……没让你好好睡是我不对。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411860,
          "spk": "木助 (キスケ)",
          "ja": "昨晩の話は忘れてくれていいからな",
          "tc": "昨晚說的事情你就忘了吧。",
          "sc": "昨晚说的事情你就忘了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6914,
      "rec_id": "TALK_ID_70_2030_010_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 411885,
          "spk": "木助 (キスケ)",
          "ja": "でも……まあ、なんだ……",
          "tc": "不過……那個，總之……",
          "sc": "不过……那个，总之……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 411892,
          "spk": "木助 (キスケ)",
          "ja": "気が向いたら、また来いよ",
          "tc": "改天想來的時候再過來吧。",
          "sc": "改天想来的时候再过来吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 411903,
          "spk": "木助 (キスケ)",
          "ja": "<player>なら",
          "tc": "如果是<player>，",
          "sc": "如果是<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 411910,
          "spk": "木助 (キスケ)",
          "ja": "いつだって歓迎するぜ",
          "tc": "我隨時都很歡迎喔。",
          "sc": "我随时都很欢迎啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6915,
      "rec_id": "TALK_ID_70_2040_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423032,
          "spk": "四郎治 (シロージ)",
          "ja": "おい、コマコ……",
          "tc": "喂、駒子……",
          "sc": "喂、驹子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423039,
          "spk": "四郎治 (シロージ)",
          "ja": "罠を設置した場所には、",
          "tc": "要在設置了陷阱的地方，",
          "sc": "要在设置了陷阱的地方，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423046,
          "spk": "四郎治 (シロージ)",
          "ja": "忘れねぇように印をつけるんだぞ",
          "tc": "做好記號，才不會忘記。",
          "sc": "做好记号，才不会忘记。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423057,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、ハンカチは忘れるなよ",
          "tc": "對了，不要忘了手帕。",
          "sc": "对了，不要忘了手帕。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 423064,
          "spk": "四郎治 (シロージ)",
          "ja": "あと、怪我した時のために、",
          "tc": "還有OK繃，",
          "sc": "还有OK绷，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 423071,
          "spk": "四郎治 (シロージ)",
          "ja": "絆創膏も持っていけ",
          "tc": "以防萬一。",
          "sc": "以防万一。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 423084,
          "spk": "驹子 (コマコ)",
          "ja": "えっと……",
          "tc": "那個……",
          "sc": "那个……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 423097,
          "spk": "四郎治 (シロージ)",
          "ja": "そうだ、歯は磨いたか？",
          "tc": "對了，妳刷牙了沒？",
          "sc": "对了，你刷牙了没？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 423104,
          "spk": "四郎治 (シロージ)",
          "ja": "こまめにしねぇと虫歯に……",
          "tc": "記得要常常刷牙，不然會蛀牙……",
          "sc": "记得要常常刷牙，不然会蛀牙……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 423117,
          "spk": "驹子 (コマコ)",
          "ja": "お、お兄ちゃん",
          "tc": "哥、哥哥。",
          "sc": "哥、哥哥。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 423124,
