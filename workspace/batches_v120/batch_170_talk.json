          "spk": "林 (リン)",
          "ja": "それじゃあ",
          "tc": "那就先這樣，",
          "sc": "那就先这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199101,
          "spk": "林 (リン)",
          "ja": "おやすみ<player>、",
          "tc": "晚安了，<player>，",
          "sc": "晚安了，<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199108,
          "spk": "林 (リン)",
          "ja": "暖かくして寝なさい",
          "tc": "記得穿暖一點睡覺喔。",
          "sc": "记得穿暖一点睡觉哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3598,
      "rec_id": "TALK_ID_10_0101_011_31",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199136,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、運がイイですね",
          "tc": "你的運氣真好呢。",
          "sc": "你的运气真好呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199143,
          "spk": "今野 (コンノ)",
          "ja": "リンさんの気まぐれに感謝してくださいヨ",
          "tc": "可得感謝林的心血來潮啊。",
          "sc": "可得感谢林的心血来潮啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3599,
      "rec_id": "TALK_ID_10_0101_011_32",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199174,
          "spk": "驹子 (コマコ)",
          "ja": "大変なことになっちゃったね……",
          "tc": "事情變得複雜好多……",
          "sc": "事情变得复杂好多……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3600,
      "rec_id": "TALK_ID_10_0101_011_33",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199192,
          "spk": "驹子 (コマコ)",
          "ja": "リンは、ああやって言うけど",
          "tc": "雖然林嘴上那麼說，",
          "sc": "虽然林嘴上那么说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199199,
          "spk": "驹子 (コマコ)",
          "ja": "きっと、無茶なことはやらせないよ",
          "tc": "但她肯定不會強人所難的。",
          "sc": "但她肯定不会强人所难的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199210,
          "spk": "驹子 (コマコ)",
          "ja": "……多分だけど",
          "tc": "……大概啦。",
          "sc": "……大概啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199221,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、私も帰るね",
          "tc": "那，我也先回去了。",
          "sc": "那，我也先回去了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199228,
          "spk": "驹子 (コマコ)",
          "ja": "おやすみ、<player>",
          "tc": "晚安，<player>。",
          "sc": "晚安，<player>。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199235,
          "spk": "驹子 (コマコ)",
          "ja": "また明日",
          "tc": "明天見。",
          "sc": "明天见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3601,
      "rec_id": "TALK_ID_10_0101_013_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199259,
          "spk": "林 (リン)",
          "ja": "<player>！　朝よ！",
          "tc": "<player>！早上了！",
          "sc": "<player>！早上了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199266,
          "spk": "林 (リン)",
          "ja": "起きて出てきなさい！",
          "tc": "快起床出來吧！",
          "sc": "快起床出来吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3602,
      "rec_id": "TALK_ID_10_0101_013_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199286,
          "spk": "林 (リン)",
          "ja": "村の一員にするために、",
          "tc": "為了讓你成為村子的一員，",
          "sc": "为了让你成为村子的一员，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199293,
          "spk": "林 (リン)",
          "ja": "早く大切なものを……",
          "tc": "我得快點把重要的東西……",
          "sc": "我得快点把重要的东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199304,
          "spk": "木助 (キスケ)",
          "ja": "……俺は反対だぜ",
          "tc": "……我是反對的。",
          "sc": "……我是反对的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199311,
          "spk": "木助 (キスケ)",
          "ja": "得体の知れんヤツをここに置くわけには……",
          "tc": "怎麼可以讓來路不明的傢伙在這裡……",
          "sc": "怎么可以让来路不明的家伙在这里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3603,
      "rec_id": "TALK_ID_10_0101_013_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199338,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199345,
          "spk": "林 (リン)",
          "ja": "良い朝ね！",
          "tc": "真是個美好的早晨呢！",
          "sc": "真是个美好的早晨呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199356,
          "spk": "林 (リン)",
          "ja": "今日は約束通り、",
          "tc": "今天按照約定，",
          "sc": "今天按照约定，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199363,
          "spk": "林 (リン)",
          "ja": "あなたの仕事について",
          "tc": "本來就是要來向你",
          "sc": "本来就是要来向你"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199370,
          "spk": "林 (リン)",
          "ja": "説明しようと思っていたのだけれど",
          "tc": "說明工作內容的，",
          "sc": "说明工作内容的，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3604,
      "rec_id": "TALK_ID_10_0101_013_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199388,
          "spk": "林 (リン)",
          "ja": "寝ぼけてるの？",
          "tc": "你睡糊塗了？",
          "sc": "你睡糊涂了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199395,
          "spk": "林 (リン)",
          "ja": "この土地の対価に働くんでしょう？",
          "tc": "你是為了使用這片土地而工作的對吧。",
          "sc": "你是为了使用这片土地而工作的对吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199402,
          "spk": "林 (リン)",
          "ja": "約束は守ってもらわなきゃね",
          "tc": "可不能忘了遵守約定啊。",
          "sc": "可不能忘了遵守约定啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199413,
          "spk": "林 (リン)",
          "ja": "ただ……昨日の夜に",
          "tc": "不過……昨天晚上",
          "sc": "不过……昨天晚上"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199420,
          "spk": "林 (リン)",
          "ja": "急な予定が入ってしまって",
          "tc": "突然有要事得辦，",
          "sc": "突然有要事得办，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199427,
          "spk": "林 (リン)",
          "ja": "契約書が、まだ出来ていないのよ……",
          "tc": "結果契約書還沒做好……",
          "sc": "结果契约书还没做好……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 199438,
          "spk": "林 (リン)",
          "ja": "だから、今日は自分で仕事を見つけて",
          "tc": "所以今天你就先自己去找工作做，",
          "sc": "所以今天你就先自己去找工作做，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 199445,
          "spk": "林 (リン)",
          "ja": "過ごしなさい",
          "tc": "度過一整天吧。",
          "sc": "度过一整天吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 199454,
          "spk": "林 (リン)",
          "ja": "働かないと、対価を得られない……",
          "tc": "不工作，就無法得到報酬……",
          "sc": "不工作，就无法得到报酬……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 199461,
          "spk": "林 (リン)",
          "ja": "対価を得たいなら働くことね！",
          "tc": "想獲得報酬，就要好好工作！",
          "sc": "想获得报酬，就要好好工作！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 199479,
          "spk": "林 (リン)",
          "ja": "そうして過ごしているうちに",
          "tc": "而且即使是現在一無所有的你，",
          "sc": "而且即使是现在一无所有的你，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 199486,
          "spk": "林 (リン)",
          "ja": "何も持たないあなたでも、",
          "tc": "也一定能在這段時間裡",
          "sc": "也一定能在这段时间里"
        },
        {
          "f_idx": 13,
          "pidx_tc": 199493,
          "spk": "林 (リン)",
          "ja": "きっと<strong>大切なもの</strong>が見つかるはずだから！",
          "tc": "找到<strong>重要的事物</strong>的！",
          "sc": "找到<strong>重要的事物</strong>的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3605,
      "rec_id": "TALK_ID_10_0101_013_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199513,
          "spk": "木助 (キスケ)",
          "ja": "それにしても",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199520,
          "spk": "木助 (キスケ)",
          "ja": "なんで俺まで、たたき起こされて",
          "tc": "為什麼連我也要被挖起來",
          "sc": "为什么连我也要被挖起来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199527,
          "spk": "木助 (キスケ)",
          "ja": "ここまで来なきゃならねえんだ？",
          "tc": "跟著到這裡才行啊？",
          "sc": "跟着到这里才行啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3606,
      "rec_id": "TALK_ID_10_0101_013_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199545,
          "spk": "林 (リン)",
          "ja": "出荷品をまとめる場所を、",
          "tc": "因為我想請你幫他做個",
          "sc": "因为我想请你帮他做个"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199552,
          "spk": "林 (リン)",
          "ja": "作ってもらおうと思ってたのよ",
          "tc": "可以集中擺放出貨物品的地方。",
          "sc": "可以集中摆放出货物品的地方。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199559,
          "spk": "林 (リン)",
          "ja": "お願いできるわよね？",
          "tc": "你應該辦得到吧？",
          "sc": "你应该办得到吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199572,
          "spk": "木助 (キスケ)",
          "ja": "まあ、仕事っていうなら",
          "tc": "算了，既然是工作就做吧。",
          "sc": "算了，既然是工作就做吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3607,
      "rec_id": "TALK_ID_10_0101_013_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199590,
          "spk": "林 (リン)",
          "ja": "<player>、キスケさんの邪魔はしないように",
          "tc": "<player>，你可不要打擾到木助哥的工作。",
          "sc": "<player>，你可不要打扰到木助哥的工作。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199606,
          "spk": "林 (リン)",
          "ja": "私が見ていなくても、",
          "tc": "即使我沒在一旁看著，",
          "sc": "即使我没在一旁看着，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199613,
          "spk": "林 (リン)",
          "ja": "契約書が巻かれていなくても、",
          "tc": "即使還沒有正式簽訂契約，",
          "sc": "即使还没有正式签订契约，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199620,
          "spk": "林 (リン)",
          "ja": "あなたには労働の義務があるわ",
          "tc": "你也依然有工作的義務。",
          "sc": "你也依然有工作的义务。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199631,
          "spk": "林 (リン)",
          "ja": "私は、午後6時にまたここへ来るから！",
          "tc": "我會在下午6點時再過來這裡！",
          "sc": "我会在下午6点时再过来这里！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 199638,
          "spk": "林 (リン)",
          "ja": "サボっていたらここを追い出すからね！",
          "tc": "要是偷懶了，我就會把你趕出去喔！",
          "sc": "要是偷懒了，我就会把你赶出去哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3608,
      "rec_id": "TALK_ID_10_0101_018_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200648,
          "spk": "木助 (キスケ)",
          "ja": "……健気なもんだ",
          "tc": "……還真是勤奮啊。",
          "sc": "……还真是勤奋啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200657,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ、次の仕事だが……",
          "tc": "那麼，關於下個工作……",
          "sc": "那么，关于下个工作……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3609,
      "rec_id": "TALK_ID_10_0101_018_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200681,
          "spk": "木助 (キスケ)",
          "ja": "リンが言うには、",
          "tc": "林說過，",
          "sc": "林说过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200688,
          "spk": "木助 (キスケ)",
          "ja": "今植えたカブは使い道があるんだとさ",
          "tc": "剛剛種的大頭菜是有用處的，",
          "sc": "刚刚种的大头菜是有用处的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200699,
          "spk": "木助 (キスケ)",
          "ja": "だから、大切に育てるんだ",
          "tc": "所以你得用心培育，",
          "sc": "所以你得用心培育，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200706,
          "spk": "木助 (キスケ)",
          "ja": "間違っても台無しにするんじゃねえぞ",
          "tc": "無論如何都不能搞砸了。",
          "sc": "无论如何都不能搞砸了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200713,
          "spk": "木助 (キスケ)",
          "ja": "わかったか？",
          "tc": "知道了嗎？",
          "sc": "知道了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3610,
      "rec_id": "TALK_ID_10_0101_018_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200737,
          "spk": "木助 (キスケ)",
          "ja": "残念ながら、リン曰く",
          "tc": "可惜的是，照林的說法，",
          "sc": "可惜的是，照林的说法，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200744,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには労働って枷が",
          "tc": "你這傢伙是被逼著套上了",
          "sc": "你这家伙是被逼着套上了"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200751,
          "spk": "木助 (キスケ)",
          "ja": "はめられてるらしいじゃねえか",
          "tc": "名為工作的枷鎖吧？",
          "sc": "名为工作的枷锁吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200760,
          "spk": "木助 (キスケ)",
          "ja": "ただ俺の言うことに従うのは",
          "tc": "只是乖乖照著我說的去做，",
          "sc": "只是乖乖照着我说的去做，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200767,
          "spk": "木助 (キスケ)",
          "ja": "楽しくなかったろ？",
          "tc": "應該不怎麼開心吧？",
          "sc": "应该不怎么开心吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 200785,
          "spk": "木助 (キスケ)",
          "ja": "仕事っていうのは、",
          "tc": "工作這種東西，",
          "sc": "工作这种东西，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 200792,
          "spk": "木助 (キスケ)",
          "ja": "人から命令されると",
          "tc": "要是只能聽從別人的命令，",
          "sc": "要是只能听从别人的命令，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 200799,
          "spk": "木助 (キスケ)",
          "ja": "ただの苦役になっちまう",
          "tc": "那就單純是個苦差事罷了。",
          "sc": "那就单纯是个苦差事罢了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 200810,
          "spk": "木助 (キスケ)",
          "ja": "仕事を楽しくするには、",
          "tc": "要讓工作變得開心，",
          "sc": "要让工作变得开心，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 200817,
          "spk": "木助 (キスケ)",
          "ja": "自分でやりてぇことを見つけて",
          "tc": "就得自己去找想做的事，",
          "sc": "就得自己去找想做的事，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 200824,
          "spk": "木助 (キスケ)",
          "ja": "自由に選び取ることだ",
          "tc": "自由地做出選擇才行。",
          "sc": "自由地做出选择才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3611,
      "rec_id": "TALK_ID_10_0101_018_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200848,
          "spk": "木助 (キスケ)",
          "ja": "あ、俺、まだ名前も名乗ってなかったか",
          "tc": "啊，我還沒報上名字吧。",
          "sc": "啊，我还没报上名字吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3612,
      "rec_id": "TALK_ID_10_0101_018_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200872,
          "spk": "木助 (キスケ)",
          "ja": "俺の名前はキスケだ",
          "tc": "我叫木助。",
          "sc": "我叫木助。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200879,
          "spk": "木助 (キスケ)",
          "ja": "これからよろしくな",
          "tc": "今後請多指教了。",
          "sc": "今后请多指教了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200888,
          "spk": "木助 (キスケ)",
          "ja": "なんかあったら、",
          "tc": "要是你遇上了什麼麻煩，",
          "sc": "要是你遇上了什么麻烦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200895,
          "spk": "木助 (キスケ)",
          "ja": "俺を頼ってくれていい",
          "tc": "都可以來找我幫忙喔。",
          "sc": "都可以来找我帮忙啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3613,
      "rec_id": "TALK_ID_10_0101_018_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200919,
          "spk": "木助 (キスケ)",
          "ja": "さて、俺も俺の仕事にとりかかるか",
          "tc": "好了，我也該專注在我的工作上了。",
          "sc": "好了，我也该专注在我的工作上了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3614,
      "rec_id": "TALK_ID_10_0101_018_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200944,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも暇なんだったら、",
          "tc": "要是你很閒的話，",
          "sc": "要是你很闲的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200951,
          "spk": "木助 (キスケ)",
          "ja": "<strong>そこの荒れ果てた庭を片付けたり……",
          "tc": "<strong>就去整理這片荒蕪的庭院……",
          "sc": "<strong>就去整理这片荒芜的庭院……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200958,
          "spk": "木助 (キスケ)",
          "ja": "村を散策してみたり……</strong>",
          "tc": "或是在村裡四處走走……</strong>",
          "sc": "或是在村里四处走走……</strong>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200967,
          "spk": "木助 (キスケ)",
          "ja": "好きなことをして過ごせばいい",
          "tc": "總之就做你想做的事，",
          "sc": "总之就做你想做的事，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 200985,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはもう<strong>自由</strong>なんだ",
          "tc": "你已經<strong>自由</strong>了。",
          "sc": "你已经<strong>自由</strong>了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 200992,
          "spk": "木助 (キスケ)",
          "ja": "この彼ヶ津村で、ノンキに暮らしを",
          "tc": "只要在這個彼津村",
          "sc": "只要在这个彼津村"
        },
        {
          "f_idx": 7,
          "pidx_tc": 200999,
          "spk": "木助 (キスケ)",
          "ja": "楽しんでいりゃあいいんだ",
          "tc": "悠哉地享受生活就行了。",
          "sc": "悠哉地享受生活就行了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 201010,
          "spk": "木助 (キスケ)",
          "ja": "俺の頼みを、色々聞いてくれて",
          "tc": "謝謝你剛剛",
          "sc": "谢谢你刚刚"
        },
        {
          "f_idx": 9,
          "pidx_tc": 201017,
          "spk": "木助 (キスケ)",
          "ja": "ありがとうな",
          "tc": "聽了我這麼多要求。",
          "sc": "听了我这么多要求。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 201026,
          "spk": "木助 (キスケ)",
          "ja": "疲れたろ、これやるよ",
          "tc": "你也累了吧，這個給你。",
          "sc": "你也累了吧，这个给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3615,
      "rec_id": "TALK_ID_10_0101_018_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201050,
          "spk": "木助 (キスケ)",
          "ja": "ほら、食ってみな",
          "tc": "來，吃看看吧。",
          "sc": "来，吃看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3616,
      "rec_id": "TALK_ID_10_0101_018_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201074,
          "spk": "木助 (キスケ)",
          "ja": "ちょっとは腹の足しになったんじゃねえか？",
          "tc": "應該稍微填飽肚子一些了吧？",
          "sc": "应该稍微填饱肚子一些了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3617,
      "rec_id": "TALK_ID_10_0101_018_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201105,
          "spk": "木助 (キスケ)",
          "ja": "もっと欲しけりゃ",
          "tc": "如果還想要的話，",
          "sc": "如果还想要的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201112,
          "spk": "木助 (キスケ)",
          "ja": "山や村を散策してみな",
          "tc": "就去山裡或在村裡四處走走吧。",
          "sc": "就去山里或在村里四处走走吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3618,
      "rec_id": "TALK_ID_10_0101_018_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201130,
          "spk": "木助 (キスケ)",
          "ja": "そこら中に食えるモンが生えてやがる",
          "tc": "到處都長著能吃的東西。",
          "sc": "到处都长着能吃的东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3619,
      "rec_id": "TALK_ID_10_0101_018_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201155,
          "spk": "木助 (キスケ)",
          "ja": "疲れて何も出来ねぇ時は、",
          "tc": "如果實在是累到什麼都做不了，",
          "sc": "如果实在是累到什么都做不了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201162,
          "spk": "木助 (キスケ)",
          "ja": "野草をつまんで空腹を凌ぐといい",
          "tc": "拔些野草充飢也可以。",
          "sc": "拔些野草充饥也可以。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3620,
      "rec_id": "TALK_ID_10_0101_018_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201186,
          "spk": "木助 (キスケ)",
          "ja": "じゃ、俺はそこで仕事にとりかかるぜ",
          "tc": "好了，我就在那邊專心工作，",
          "sc": "好了，我就在那边专心工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201193,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは自由に遊んでな",
          "tc": "你就自由地去玩吧。",
          "sc": "你就自由地去玩吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3621,
      "rec_id": "TALK_ID_10_0101_019_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201311,
          "spk": "林 (リン)",
          "ja": "<player>、こんばんは",
          "tc": "<player>，你好啊，",
          "sc": "<player>，你好啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201318,
          "spk": "林 (リン)",
          "ja": "待たせたわね",
          "tc": "讓你久等了。",
          "sc": "让你久等了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 201329,
          "spk": "林 (リン)",
          "ja": "見たわよ、早速畑を作ったのね！",
          "tc": "我都看到了，你這麼快就整出田地了啊！",
          "sc": "我都看到了，你这么快就整出田地了啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 201336,
          "spk": "林 (リン)",
          "ja": "よく頑張ってくれたわ",
          "tc": "你真的很努力呢！",
          "sc": "你真的很努力呢！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3622,
      "rec_id": "TALK_ID_10_0101_019_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201361,
          "spk": "木助 (キスケ)",
          "ja": "それはいいんだが、",
          "tc": "他是很努力啦，",
          "sc": "他是很努力啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201368,
          "spk": "木助 (キスケ)",
          "ja": "俺が作ったコイツは、どう使うんだ？",
          "tc": "不過我做的這東西，是要用在哪裡？",
          "sc": "不过我做的这东西，是要用在哪里？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3623,
      "rec_id": "TALK_ID_10_0101_019_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201393,
          "spk": "林 (リン)",
          "ja": "そうね、出荷台のことも含めて",
          "tc": "嗯，包含那個出貨台的用途在內，",
          "sc": "嗯，包含那个出货台的用途在内，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201400,
          "spk": "林 (リン)",
          "ja": "これからの仕事について説明しなくては",
          "tc": "得向你說明今後的工作內容才行呢。",
          "sc": "得向你说明今后的工作内容才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3624,
      "rec_id": "TALK_ID_10_0101_019_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201425,
          "spk": "林 (リン)",
          "ja": "<player>、あなたにも生活費が必要でしょう？",
          "tc": "<player>，你應該也需要生活費吧？",
          "sc": "<player>，你应该也需要生活费吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201432,
          "spk": "林 (リン)",
          "ja": "そこで出荷台の出番よ",
          "tc": "這時候出貨台就能派上用場了。",
          "sc": "这时候出货台就能派上用场了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 201450,
          "spk": "林 (リン)",
          "ja": "売りたいものを出荷台に持っていって、",
          "tc": "把想賣的東西拿到出貨台這裡，",
          "sc": "把想卖的东西拿到出货台这里，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 201457,
          "spk": "林 (リン)",
          "ja": "箱に入れておいてちょうだい",
          "tc": "放進箱子裡去。",
          "sc": "放进箱子里去。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 201464,
          "spk": "林 (リン)",
          "ja": "私が買いとって、翌朝にお金を支払うわ",
          "tc": "我會收購它們，並在隔天早上把錢交給你。",
          "sc": "我会收购它们，并在隔天早上把钱交给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3625,
      "rec_id": "TALK_ID_10_0101_019_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201482,
          "spk": "林 (リン)",
          "ja": "そして私はあなたの荷物を、",
          "tc": "接著我把你的商品",
          "sc": "接着我把你的商品"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201489,
          "spk": "林 (リン)",
          "ja": "村の外に三倍の価格で売る……",
          "tc": "在村外以三倍的價格賣掉……",
          "sc": "在村外以三倍的价格卖掉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 201496,
          "spk": "林 (リン)",
          "ja": "これで村はさらに潤うわ",
          "tc": "這樣村子就會更加富裕了。",
          "sc": "这样村子就会更加富裕了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 201509,
          "spk": "木助 (キスケ)",
          "ja": "そりゃ結構なことだぜ",
          "tc": "那可真是不錯啊。",
          "sc": "那可真是不错啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 201516,
          "spk": "木助 (キスケ)",
          "ja": "んで、てめぇはそれを言いに来たのか？",
          "tc": "不過，妳就只是來講這些的嗎？",
          "sc": "不过，你就只是来讲这些的吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3626,
      "rec_id": "TALK_ID_10_0101_019_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201534,
          "spk": "林 (リン)",
          "ja": "あ……忘れるところだったわ",
          "tc": "啊……差點忘了。",
          "sc": "啊……差点忘了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3627,
      "rec_id": "TALK_ID_10_0101_019_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201554,
          "spk": "林 (リン)",
          "ja": "待たせたわね、やっと契約書が出来たの",
          "tc": "久等了，契約書終於完成囉。",
          "sc": "久等了，契约书终于搞定啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201561,
          "spk": "林 (リン)",
          "ja": "確認しなさい",
          "tc": "你先確認一下。",
          "sc": "你先确认一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3628,
      "rec_id": "TALK_ID_10_0101_019_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201594,
          "spk": "林 (リン)",
          "ja": "はい、サインして",
          "tc": "好了，簽個名。",
          "sc": "好了，签个名。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201601,
          "spk": "林 (リン)",
          "ja": "あ、指印でもいいわ！",
          "tc": "啊，捺指印也可以！",
          "sc": "啊，捺指印也可以！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 201608,
          "spk": "林 (リン)",
          "ja": "ほら、朱肉もあるから",
          "tc": "來，我有準備印泥。",
          "sc": "来，我有准备印泥。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3629,
      "rec_id": "TALK_ID_10_0101_019_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201632,
          "spk": "木助 (キスケ)",
          "ja": "<player>、てめぇ……",
          "tc": "<player>，你這傢伙……",
          "sc": "<player>，你这家伙……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201639,
          "spk": "木助 (キスケ)",
          "ja": "ちゃんと読んだのか？",
          "tc": "真的有仔細讀過嗎？",
          "sc": "真的有仔细读过吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3630,
      "rec_id": "TALK_ID_10_0101_019_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201663,
          "spk": "林 (リン)",
          "ja": "簡単に説明すると、この契約書には",
          "tc": "簡單說明一下，這份契約裡",
          "sc": "简单说明一下，这份契约里"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201670,
          "spk": "林 (リン)",
          "ja": "土地を貸す旨と、彼ヶ津村で暮らすための",
          "tc": "寫著土地租賃，以及在彼津村生活的",
          "sc": "写着土地租赁，以及在彼津村生活的"
        },
        {
          "f_idx": 2,
