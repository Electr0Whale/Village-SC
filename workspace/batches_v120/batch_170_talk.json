          "ja": "支払金額に加えて",
          "tc": "也加進帳單費用裡。",
          "sc": "也加进帐单费用里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199067,
          "spk": "今野 (コンノ)",
          "ja": "はい、456,850円になりました",
          "tc": "好的，目前是456,850元了。",
          "sc": "好的，目前是456,850元了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199074,
          "spk": "今野 (コンノ)",
          "ja": "良心的価格のベッドでよかったですねェ！",
          "tc": "能買到價格這麼划算的床，太好了呢！",
          "sc": "能买到价格这么划算的床，太好呐～！"
        }
      ]
    },
    {
      "file": "talk.dat",
