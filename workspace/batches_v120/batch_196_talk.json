          "spk": "林 (リン)",
          "ja": "そうよ",
          "tc": "沒錯。",
          "sc": "没错。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4799,
      "rec_id": "TALK_ID_10_0403_042_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274509,
          "spk": "林 (リン)",
          "ja": "やってくれたわね、<player>",
          "tc": "看看你們幹了什麼好事，<player>。",
          "sc": "看看你们干了什么好事，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274520,
          "spk": "木助 (キスケ)",
          "ja": "リン、ふらついてるじゃねえか",
          "tc": "林，妳這不是都還站不穩嗎？",
          "sc": "林，你这不是都还站不稳吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 274527,
          "spk": "木助 (キスケ)",
          "ja": "起きて大丈夫なのかよ",
          "tc": "這樣起身沒問題嗎？",
          "sc": "这样起身没问题吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4800,
      "rec_id": "TALK_ID_10_0403_042_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274545,
          "spk": "林 (リン)",
          "ja": "大丈夫よ",
          "tc": "我沒事。",
          "sc": "我没事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274552,
          "spk": "林 (リン)",
          "ja": "それよりも、この子にも教えてあげないと",
          "tc": "比起這個，我得把事情也告訴他才行。",
          "sc": "比起这个，我得把事情也告诉他才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4801,
      "rec_id": "TALK_ID_10_0403_042_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274570,
          "spk": "林 (リン)",
          "ja": "知りたかったんでしょう？",
          "tc": "你一直都很想知道吧？",
          "sc": "你一直都很想知道吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274577,
          "spk": "林 (リン)",
          "ja": "私が何をしていたのか……",
          "tc": "想知道我到底在做些什麼……",
          "sc": "想知道我到底在做些什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4802,
      "rec_id": "TALK_ID_10_0403_042_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274597,
          "spk": "林 (リン)",
          "ja": "私は昨晩、土地神に",
          "tc": "昨天晚上，",
          "sc": "昨天晚上，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274604,
          "spk": "林 (リン)",
          "ja": "この村を祟らないよう願う儀式を",
          "tc": "我本來是打算舉行儀式，",
          "sc": "我本来是打算举行仪式，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 274611,
          "spk": "林 (リン)",
          "ja": "行うつもりだったの",
          "tc": "祈求土地神不要對這座村子作祟的。",
          "sc": "祈求土地神不要对这座村子作祟的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 274622,
          "spk": "林 (リン)",
          "ja": "儀式をするには",
          "tc": "要進行儀式，",
          "sc": "要进行仪式，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 274629,
          "spk": "林 (リン)",
          "ja": "一度、穴を塞ぐ大岩を動かして",
          "tc": "就必須先把堵在洞口的岩石移開，",
          "sc": "就必须先把堵在洞口的岩石移开，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 274636,
          "spk": "林 (リン)",
          "ja": "封印を破らなければならなかった",
          "tc": "破除封印才行。",
          "sc": "破除封印才行。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 274647,
          "spk": "林 (リン)",
          "ja": "だから、ヅ主を呼んで予備の封もして",
          "tc": "所以我召喚了津主，並且做了預備的封印，",
          "sc": "所以我召唤了津主，并且做了预备的封印，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 274654,
          "spk": "林 (リン)",
          "ja": "あとは儀式を行うだけだったのに……",
          "tc": "明明就只差儀式這一步了……",
          "sc": "明明就只差仪式这一步了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 274672,
          "spk": "林 (リン)",
          "ja": "私は……儀式を完遂できなかった",
          "tc": "結果……我沒能完成儀式。",
          "sc": "结果……我没能完成仪式。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 274679,
          "spk": "林 (リン)",
          "ja": "そして封印を再び閉めるのをしくじった",
          "tc": "而且連重新關上封印都失敗了。",
          "sc": "而且连重新关上封印都失败了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 274697,
          "spk": "林 (リン)",
          "ja": "まさか、伝承の「戻ってきた子ども」と",
          "tc": "誰會想到，傳說中的「回歸之子」",
          "sc": "谁会想到，传说中的“回归之子”"
        },
        {
          "f_idx": 13,
          "pidx_tc": 274704,
          "spk": "林 (リン)",
          "ja": "様子がおかしくなったトバリが",
          "tc": "竟然會跟變得不太正常的帷一起擊退津主，",
          "sc": "竟然会跟变得不太正常的帷一起击退津主，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 274711,
          "spk": "林 (リン)",
          "ja": "ヅ主を退け封を壊してしまうだなんてね……",
          "tc": "甚至還破壞了封印……",
          "sc": "击退津主并破坏了封印……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 274724,
          "spk": "木助 (キスケ)",
          "ja": "伝承って……",
          "tc": "妳所謂的傳說……",
          "sc": "你所谓的传说……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 274733,
          "spk": "木助 (キスケ)",
          "ja": "過去に神隠しにあった子どもが",
          "tc": "是指以前被神隱的孩子回到村子，",
          "sc": "是指以前被神隐的孩子回到村子，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 274740,
          "spk": "木助 (キスケ)",
          "ja": "村に戻ってきて福をもたらしたって話だろ",
          "tc": "帶來福氣的那個故事吧。",
          "sc": "带来福气的那个故事吧。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 274758,
          "spk": "木助 (キスケ)",
          "ja": "んな埃被った話、",
          "tc": "那都老掉牙了，",
          "sc": "那都老掉牙了，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 274765,
          "spk": "木助 (キスケ)",
          "ja": "信じるんじゃねえ",
          "tc": "妳別信啦。",
          "sc": "你别信啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4803,
      "rec_id": "TALK_ID_10_0403_042_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274783,
          "spk": "木助 (キスケ)",
          "ja": "……気にしなくていいぜ",
          "tc": "……你不用放在心上喔，",
