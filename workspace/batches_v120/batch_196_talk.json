          "f_idx": 5,
          "pidx_tc": 274041,
          "spk": "木助 (キスケ)",
          "ja": "だから、今でも俺達、彼ヶ津の住人は",
          "tc": "所以，我們這些彼津的居民，",
          "sc": "所以，我们这些彼津的居民，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 274048,
          "spk": "木助 (キスケ)",
          "ja": "神に祟られ続けている……",
          "tc": "直到現在都持續受到神明作祟……",
          "sc": "直到现在都持续受到神明作祟……"
        }
      ]
    },
