          "pidx_tc": 274910,
          "spk": "林 (リン)",
          "ja": "あなた、忠告を無視して……",
          "tc": "妳竟然無視我的忠告……",
          "sc": "你竟然无视我的忠告……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4807,
      "rec_id": "TALK_ID_10_0403_042_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274928,
          "spk": "帷 (トバリ)",
          "ja": "ごめんなさい",
          "tc": "對不起。",
          "sc": "对不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274939,
          "spk": "帷 (トバリ)",
          "ja": "気がついた時には、",
          "tc": "等我回過神來，",
          "sc": "等我回过神来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 274946,
          "spk": "帷 (トバリ)",
          "ja": "血まみれのアンタが倒れていて……",
          "tc": "就看到妳渾身是血倒在地上……",
          "sc": "就看到你浑身是血倒在地上……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 274953,
          "spk": "帷 (トバリ)",
          "ja": "私……ナイフを握ってて……",
