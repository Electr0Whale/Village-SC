  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4761,
      "rec_id": "TALK_ID_10_0402_033_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272516,
          "spk": "驹子 (コマコ)",
          "ja": "な、なに、あれ",
          "tc": "那、那是什麼？",
          "sc": "那、那是什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4762,
      "rec_id": "TALK_ID_10_0402_033_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272534,
          "spk": "林 (リン)",
          "ja": "……チッ",
          "tc": "……嘖。",
          "sc": "……啧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272541,
          "spk": "林 (リン)",
          "ja": "いつもは口もきかないクセに、",
          "tc": "明明平常連屁都不敢放，",
          "sc": "明明平常连屁都不敢放，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272548,
          "spk": "林 (リン)",
          "ja": "急いでいる時に限って……",
          "tc": "為什麼偏偏要挑在我趕時間的時候……",
          "sc": "为什么偏偏要挑在我赶时间的时候……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 272561,
          "spk": "驹子 (コマコ)",
          "ja": "り、リン、私たち、説明が欲しいだけで……",
          "tc": "林、林，我們只是想要一個解釋……",
          "sc": "林、林，我们只是想要一个解释……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 272574,
          "spk": "林 (リン)",
          "ja": "言ったでしょ、時間がないの",
          "tc": "就說了，現在沒那個時間！",
          "sc": "就说了，现在没那个时间！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4763,
      "rec_id": "TALK_ID_10_0402_033_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272592,
          "spk": "林 (リン)",
          "ja": "あなたたち……",
          "tc": "妳們……",
          "sc": "你们……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272599,
          "spk": "林 (リン)",
          "ja": "つけてきたなら、もう気づいてるでしょ？",
          "tc": "既然跟到這裡，應該就已經發現了吧？",
          "sc": "既然跟到这里，应该就已经发现了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272610,
          "spk": "林 (リン)",
          "ja": "私が……恐ろしい鬼を呼べるってことを",
          "tc": "我……有能力召喚出那個恐怖的鬼喔！",
          "sc": "我……有能力召唤出那个恐怖的鬼哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 272617,
          "spk": "林 (リン)",
          "ja": "邪魔をするのなら、どうなっても知らないわよ",
          "tc": "要是敢阻撓我，我可不知道會發生什麼事。",
          "sc": "要是敢阻挠我，我可不知道会发生什么事。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 272639,
          "spk": "驹子 (コマコ)",
          "ja": "リン……！",
          "tc": "林……！",
          "sc": "林……！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 272646,
          "spk": "驹子 (コマコ)",
          "ja": "や、やめてよ、嘘でしょ",
          "tc": "別、別這樣，妳是騙人的吧？",
          "sc": "别、别这样，你是骗人的吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 272666,
          "spk": "林 (リン)",
          "ja": "この私が嘘をついたことがあるかしら？",
          "tc": "我什麼時候騙過人了？",
          "sc": "我什么时候骗过人了？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 272673,
          "spk": "林 (リン)",
          "ja": "舐めないでくれる？",
          "tc": "可以請妳別小看我嗎？",
          "sc": "可以请你别小看我吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 272686,
          "spk": "帷 (トバリ)",
          "ja": "……やってみなさいよ",
          "tc": "……妳試試看啊。",
          "sc": "……你试试看啊。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 272693,
          "spk": "帷 (トバリ)",
          "ja": "私はもう、アンタの指示に",
          "tc": "我已經下定決心，",
          "sc": "我已经下定决心，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 272700,
          "spk": "帷 (トバリ)",
          "ja": "従わないって決めたんだから",
          "tc": "不會再聽從妳的指示了。",
          "sc": "不会再听从你的指示了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4764,
      "rec_id": "TALK_ID_10_0402_033_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272716,
          "spk": "驹子 (コマコ)",
          "ja": "だ、だめだよトバリ、",
          "tc": "不、不行啦，帷！",
          "sc": "不、不行啦，帷！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272723,
          "spk": "驹子 (コマコ)",
          "ja": "もう十分でしょ",
          "tc": "已經夠了吧，",
          "sc": "已经够了吧，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272730,
          "spk": "驹子 (コマコ)",
          "ja": "帰ろうよ",
          "tc": "我們回去吧！",
          "sc": "我们回去吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4765,
      "rec_id": "TALK_ID_10_0402_033_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272805,
          "spk": "林 (リン)",
          "ja": "……度胸があるのね",
          "tc": "……還真有骨氣呢。",
          "sc": "……还真有骨气呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272816,
          "spk": "林 (リン)",
          "ja": "わかったわ……",
          "tc": "我知道了……",
          "sc": "我知道了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272823,
          "spk": "林 (リン)",
          "ja": "私も覚悟を決めなくてはね",
          "tc": "我也得下定決心才行呢。",
          "sc": "我也得下定决心才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4766,
      "rec_id": "TALK_ID_10_0402_033_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272851,
          "spk": "驹子 (コマコ)",
          "ja": "り、リン……！？",
          "tc": "林、林……！？",
          "sc": "林、林……！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272864,
          "spk": "林 (リン)",
          "ja": "言う事を聞かない悪い子には、",
          "tc": "就讓我召喚最最最可怕的鬼，",
          "sc": "就让我召唤最最最可怕的鬼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272871,
          "spk": "林 (リン)",
          "ja": "怖い怖い鬼を呼んであげましょう",
          "tc": "來對付你們幾個不聽話的壞孩子吧。",
          "sc": "来对付你们几个不听话的坏孩子吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 272882,
          "spk": "林 (リン)",
          "ja": "此の供物をもって願い奉る、",
          "tc": "在此奉上供品，",
          "sc": "在此奉上供品，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 272889,
          "spk": "林 (リン)",
          "ja": "御力を以て応え給え――",
          "tc": "願祢展現神威，應我所求──",
          "sc": "愿你展现神威，应我所求——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4767,
      "rec_id": "TALK_ID_10_0402_033_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272917,
          "spk": "林 (リン)",
          "ja": "ヅ主！！",
          "tc": "津主！！",
          "sc": "津主！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272924,
          "spk": "林 (リン)",
          "ja": "お願いよ、この子達を",
          "tc": "拜託祢，",
          "sc": "拜托你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272931,
          "spk": "林 (リン)",
          "ja": "追い払ってちょうだい！",
          "tc": "請將這些人趕出去！",
          "sc": "请将这些人赶出去！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4768,
      "rec_id": "TALK_ID_10_0402_033_25",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272959,
          "spk": "驹子 (コマコ)",
          "ja": "に、逃げよう、<player>……！",
          "tc": "快、快逃吧，<player>……！",
          "sc": "快、快逃吧，<player>……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 272966,
          "spk": "驹子 (コマコ)",
          "ja": "危ないよ！　死んじゃうよ！",
          "tc": "太危險了！會死掉的！",
          "sc": "太危险了！会死掉的！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 272979,
          "spk": "帷 (トバリ)",
          "ja": "飛んでくる岩……",
          "tc": "岩石一直飛過來……",
          "sc": "岩石一直飞过来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 272992,
          "spk": "帷 (トバリ)",
          "ja": "岩を、打ち返して",
          "tc": "把岩石打回去，",
          "sc": "把岩石打回去，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 272999,
          "spk": "帷 (トバリ)",
          "ja": "鬼にぶつけ　て……",
          "tc": "往鬼身上　砸……",
          "sc": "往鬼身上　砸……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 273012,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……トバリ？",
          "tc": "咦……帷？",
          "sc": "咦……帷？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 273025,
          "spk": "帷 (トバリ)",
          "ja": "鬼が怯んだ隙に、",
          "tc": "趁鬼露出破綻的空檔，",
          "sc": "趁鬼露出破绽的空档，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 273032,
          "spk": "帷 (トバリ)",
          "ja": "穴のそばの岩を壊してし　まえ　ば……",
          "tc": "把洞口旁邊的岩石破　壞　掉……",
          "sc": "把洞口旁边的岩石破　坏　掉……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 273045,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ、何を言ってるの！",
          "tc": "帷，妳在說什麼啊！",
          "sc": "帷，你在说什么啊！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 273052,
          "spk": "驹子 (コマコ)",
          "ja": "や、やめようよ！",
          "tc": "算、算了啦！",
          "sc": "算、算了啦！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 273059,
          "spk": "驹子 (コマコ)",
          "ja": "戦って勝てるわけないんだから！",
          "tc": "我們不可能打贏祂的啦！",
          "sc": "我们不可能打赢他的啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4769,
      "rec_id": "TALK_ID_10_0402_034_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273089,
          "spk": "林 (リン)",
          "ja": "そんなまさか……",
          "tc": "怎麼可能……",
          "sc": "怎么可能……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273096,
          "spk": "林 (リン)",
          "ja": "ヅ主の要石を壊すだなんて……",
          "tc": "竟然把津主的要石破壞掉了……",
          "sc": "竟然把津主的要石破坏掉了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4770,
      "rec_id": "TALK_ID_10_0402_034_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273114,
          "spk": "林 (リン)",
          "ja": "あなた、なにをしでかしたか",
          "tc": "你們幾個……",
          "sc": "你们几个……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273121,
          "spk": "林 (リン)",
          "ja": "わかっているの！？",
          "tc": "知道自己到底幹了什麼好事嗎！？",
          "sc": "知道自己到底干了什么好事吗！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4771,
      "rec_id": "TALK_ID_10_0402_034_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273139,
          "spk": "驹子 (コマコ)",
          "ja": "わからないよ、リン……！",
          "tc": "最好知道啦，林……！",
          "sc": "最好知道啦，林……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273150,
          "spk": "驹子 (コマコ)",
          "ja": "リンはなにもかも、",
          "tc": "因為林，",
          "sc": "因为林，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 273157,
          "spk": "驹子 (コマコ)",
          "ja": "私たちには、教えてくれないから……",
          "tc": "什麼都不願意告訴我們啊……",
          "sc": "什么都不愿意告诉我们啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4772,
      "rec_id": "TALK_ID_10_0402_034_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273175,
          "spk": "林 (リン)",
          "ja": "あなた達は黙ってなさい！",
          "tc": "你們給我閉嘴！",
          "sc": "你们给我闭嘴！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4773,
      "rec_id": "TALK_ID_10_0402_034_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273193,
          "spk": "林 (リン)",
          "ja": "……ッ！",
          "tc": "……！",
          "sc": "……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4774,
      "rec_id": "TALK_ID_10_0402_034_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273211,
          "spk": "林 (リン)",
          "ja": "この状況に疑問を持つのはわかってる",
          "tc": "我知道你們對現在的狀況很疑惑。",
          "sc": "我知道你们对现在的状况很疑惑。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273218,
          "spk": "林 (リン)",
          "ja": "なにも言えなくて、ごめんなさい",
          "tc": "但是對不起，我什麼都不能說。",
          "sc": "但是对不起，我什么都不能说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 273231,
          "spk": "驹子 (コマコ)",
          "ja": "……リン？",
          "tc": "……林？",
          "sc": "……林？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 273238,
          "spk": "驹子 (コマコ)",
          "ja": "ど、どうして……",
          "tc": "為、為什麼……",
          "sc": "为、为什么……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 273251,
          "spk": "林 (リン)",
          "ja": "あなた達には見せたくなかった",
          "tc": "我並不想讓你們看到這些……",
          "sc": "我并不想让你们看到这些……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 273258,
          "spk": "林 (リン)",
          "ja": "でも、私にはもう、時間がないの",
          "tc": "可是，我已經沒有時間了。",
          "sc": "可是，我已经没有时间了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 273269,
          "spk": "林 (リン)",
          "ja": "後のことは、あなた達に任せるわ",
          "tc": "剩下的就交給你們了。",
          "sc": "剩下的就交给你们了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 273276,
          "spk": "林 (リン)",
          "ja": "なにが起きたのかは、",
          "tc": "想知道發生了什麼事情，",
          "sc": "想知道发生了什么事情，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 273283,
          "spk": "林 (リン)",
          "ja": "コンノにでも聞いてちょうだい",
          "tc": "你們就去問今野吧。",
          "sc": "你们就去问今野吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4775,
      "rec_id": "TALK_ID_10_0402_034_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273311,
          "spk": "林 (リン)",
          "ja": "――かしこみ、かしこみ申す……",
          "tc": "──誠惶誠恐，謹此相求……",
          "sc": "——诚惶诚恐，谨此相求……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273318,
          "spk": "林 (リン)",
          "ja": "この身、汚れを祓いて……",
          "tc": "請祢祓除，此身汙穢……",
          "sc": "请你祓除，此身污秽……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4776,
      "rec_id": "TALK_ID_10_0402_034_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273345,
          "spk": "驹子 (コマコ)",
          "ja": "リン……！",
          "tc": "林……！",
          "sc": "林……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 273352,
          "spk": "驹子 (コマコ)",
          "ja": "一体、なにをしようとしているの……！",
          "tc": "妳到底，打算做什麼……！",
          "sc": "你到底，打算做什么……！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 273359,
          "spk": "驹子 (コマコ)",
          "ja": "いい加減、教えてよ！",
          "tc": "夠了，快說啊！",
          "sc": "够了，快说啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4777,
      "rec_id": "TALK_ID_10_0402_034_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 273375,
          "spk": "林 (リン)",
          "ja": "怒り猛る土地神よ、",
          "tc": "盛怒不已的土地神啊，",
          "sc": "盛怒不已的土地神啊，"
