        },
        {
          "f_idx": 2,
          "pidx_tc": 274903,
          "spk": "林 (リン)",
          "ja": "それはこっちのセリフよ、トバリ",
          "tc": "那是我的台詞吧，帷。",
          "sc": "那是我的台词吧，帷。"
        },
        {
