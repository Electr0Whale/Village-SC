          "pidx_tc": 273632,
          "spk": "帷 (トバリ)",
          "ja": "<strong>これで、じゆうだ</strong>",
          "tc": "<strong>這樣，就自由了。</strong>",
          "sc": "<strong>这样，就自由了。</strong>"
