          "f_idx": 4,
          "pidx_tc": 274228,
          "spk": "木助 (キスケ)",
          "ja": "こんな状態になってしまうことだけは……",
          "tc": "村子就會變成這樣……",
          "sc": "村子就会变成这样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4796,
      "rec_id": "TALK_ID_10_0403_042_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274321,
          "spk": "木助 (キスケ)",
          "ja": "この村の歴代の村長たちはみな、",
          "tc": "這座村子的歷代村長們，",
          "sc": "这座村子的历代村长们，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274328,
          "spk": "木助 (キスケ)",
          "ja": "新しい神を呼び寄せて、",
          "tc": "一直以來都是透過召喚新的神明，",
          "sc": "一直以来都是透过召唤新的神明，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 274335,
          "spk": "木助 (キスケ)",
          "ja": "土地神の祟りを弱めようとしてきたんだ",
          "tc": "來削弱土地神作祟的力量。",
          "sc": "来削弱土地神作祟的力量。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 274346,
          "spk": "木助 (キスケ)",
          "ja": "深夜徘徊が趣味のてめぇなら気づいているだろ",
          "tc": "既然你總愛在深夜遊蕩，那應該注意到了吧。",
          "sc": "既然你总爱在深夜游荡，那应该注意到了吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 274353,
          "spk": "木助 (キスケ)",
          "ja": "夜中に出くわす化け物のようなものたち……",
          "tc": "那些會在半夜遇到，有如怪物般的傢伙……",
          "sc": "那些会在半夜遇到，有如怪物般的家伙……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 274360,
          "spk": "木助 (キスケ)",
          "ja": "あれらは全部リンが呼んだ<strong>来訪神</strong>なんだよ",
          "tc": "全都是林召喚來的<strong>來訪神</strong>啊。",
          "sc": "全都是林召唤来的<strong>来访神</strong>啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 274371,
          "spk": "木助 (キスケ)",
          "ja": "それなのにてめぇは……",
          "tc": "結果你這個傢伙……",
          "sc": "结果你这个家伙……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 274378,
          "spk": "木助 (キスケ)",
          "ja": "来訪神どもの力を弱めるような",
          "tc": "竟然老是做出那些",
          "sc": "竟然老是做出那些"
        },
        {
          "f_idx": 8,
          "pidx_tc": 274385,
          "spk": "木助 (キスケ)",
          "ja": "行動ばかりしてやがったな",
          "tc": "會削弱來訪神力量的舉動。",
          "sc": "会削弱来访神力量的举动。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 274396,
          "spk": "木助 (キスケ)",
          "ja": "ただ、今までは掟を少し破った程度じゃ、",
          "tc": "不過，以前如果只是稍微違背規矩，",
          "sc": "不过，以前如果只是稍微违背规矩，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 274403,
          "spk": "木助 (キスケ)",
          "ja": "何も起きなかったんだ",
          "tc": "還不至於出什麼大事。",
          "sc": "还不至于出什么大事。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 274414,
          "spk": "木助 (キスケ)",
          "ja": "だが……最近は、ニワトリの一件に、",
          "tc": "但是……像是雞的事，",
          "sc": "但是……像是鸡的事，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 274421,
          "spk": "木助 (キスケ)",
          "ja": "顔のある樹が生えたりと……",
          "tc": "甚至長出了有臉的樹……",
          "sc": "甚至长出了有脸的树……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 274428,
          "spk": "木助 (キスケ)",
          "ja": "妙なことが立て続けに起きてやがる",
          "tc": "接二連三地發生奇怪的事，",
          "sc": "接二连三地发生奇怪的事，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 274437,
          "spk": "木助 (キスケ)",
          "ja": "だからリンは焦っていたんだ",
          "tc": "所以林才會開始著急。",
          "sc": "所以林才会开始着急。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4797,
      "rec_id": "TALK_ID_10_0403_042_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 274453,
          "spk": "木助 (キスケ)",
          "ja": "おかげでてめぇらに",
          "tc": "也因為這樣，",
          "sc": "也因为这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 274460,
          "spk": "木助 (キスケ)",
          "ja": "思惑を暴かれるという失態をしでかしたわけだが",
          "tc": "她才犯下被你們揭穿企圖這種失誤。",
          "sc": "她才犯下被你们揭穿企图这种失误。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4798,
      "rec_id": "TALK_ID_10_0403_042_13",
      "lines": [
        {
          "f_idx": 0,
