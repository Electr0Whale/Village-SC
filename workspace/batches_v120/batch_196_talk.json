        {
          "f_idx": 1,
          "pidx_tc": 274005,
          "spk": "木助 (キスケ)",
          "ja": "ユータの言う理想郷でもなんでもない",
          "tc": "裕太口中的那種理想鄉。",
          "sc": "裕太口中的那种理想乡。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 274016,
          "spk": "木助 (キスケ)",
          "ja": "大昔に山を開拓し、",
          "tc": "很久以前，人們開墾了這座山，",
          "sc": "很久以前，人们开垦了这座山，"
        },
        {
