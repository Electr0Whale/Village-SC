        },
        {
          "f_idx": 4,
          "pidx_tc": 274817,
          "spk": "林 (リン)",
          "ja": "唯一の希望だったのよ……",
          "tc": "曾經是唯一的希望啊……",
          "sc": "曾经是唯一的希望啊……"
        }
      ]
    },
