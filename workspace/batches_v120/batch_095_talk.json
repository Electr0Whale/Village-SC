    {
      "file": "talk.dat",
      "rec_idx": 22,
      "rec_id": "TALK_ID_ORPHAN_SPECIAL_20_101_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10784,
          "spk": "帷 (トバリ)",
          "ja": "……村に受け入れられたからって",
          "tc": "……即使這個村子接納你了，",
          "sc": "……即使这个村子接纳你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10791,
          "spk": "帷 (トバリ)",
          "ja": "気軽に話しかけてこないでくれる",
          "tc": "你也不要隨便來找我說話。",
          "sc": "能不能别随便跑来跟我搭话。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10809,
          "spk": "帷 (トバリ)",
          "ja": "私は他の村人みたいに",
          "tc": "我不像其他的村民，",
          "sc": "我不像其他的村民，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 10816,
          "spk": "帷 (トバリ)",
          "ja": "慣れ合うつもりなんてない",
          "tc": "並沒有打算要跟你搞好關係。",
          "sc": "并没有打算要跟你搞好关系。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 10827,
          "spk": "帷 (トバリ)",
          "ja": "……アンタが、役に立ちそうか",
          "tc": "……除非我確定",
          "sc": "……除非我确定"
        },
        {
          "f_idx": 6,
          "pidx_tc": 10834,
          "spk": "帷 (トバリ)",
          "ja": "ハッキリするまではね",
          "tc": "你能夠派上用場。",
          "sc": "你能够派上用场。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 23,
      "rec_id": "TALK_ID_ORPHAN_SPECIAL_20_101_0040",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10860,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10871,
          "spk": "帷 (トバリ)",
          "ja": "……なに？",
          "tc": "……幹嘛？",
          "sc": "……干嘛？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10878,
          "spk": "帷 (トバリ)",
          "ja": "忙しいからあっちに行って",
          "tc": "我很忙的，你走開吧。",
          "sc": "我很忙的，你走开吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 24,
      "rec_id": "TALK_ID_ORPHAN_SPECIAL_20_101_0041",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10902,
          "spk": "帷 (トバリ)",
          "ja": "……残念ね",
          "tc": "……很遺憾，",
          "sc": "……很遗憾，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10909,
          "spk": "帷 (トバリ)",
          "ja": "村人じゃないアンタと話すことなんてない",
          "tc": "我是不會跟不是村民的你說話的。",
          "sc": "我是不会跟不是村民的你说话的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10920,
          "spk": "帷 (トバリ)",
          "ja": "そういう「掟」なんだって",
          "tc": "這裡的「規矩」就是這樣，",
          "sc": "这里的“规矩”就是这样，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10927,
          "spk": "帷 (トバリ)",
          "ja": "恨むなら、この村を恨むことね",
          "tc": "你要恨就恨這個村子吧。",
          "sc": "你要恨就恨这个村子吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 25,
      "rec_id": "TALK_ID_ORPHAN_SPECIAL_20_101_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10951,
          "spk": "帷 (トバリ)",
          "ja": "<player>、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10958,
          "spk": "帷 (トバリ)",
          "ja": "いいところに来た",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10969,
          "spk": "帷 (トバリ)",
          "ja": "<tmpstr>持ってない？",
          "tc": "你有沒有<tmpstr>？",
          "sc": "你有没有<tmpstr>？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10976,
          "spk": "帷 (トバリ)",
          "ja": "あったら、分けてくれると助かるんだけど",
          "tc": "有的話，希望你能分給我。",
          "sc": "有的话，希望你能分给我。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 10994,
          "spk": "帷 (トバリ)",
          "ja": "ま、気が向いたらでいい",
          "tc": "等你想給的時候再給就行了，",
          "sc": "等你想给的时候再给就行了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 11001,
          "spk": "帷 (トバリ)",
          "ja": "渡してくれたらありがたいなってだけ",
          "tc": "只是如果你能給我的話，",
          "sc": "只是如果你能给我的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 11012,
          "spk": "帷 (トバリ)",
          "ja": "ちゃんとお礼はするから",
          "tc": "我會好好答謝你的，",
          "sc": "我会好好答谢你的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 11019,
          "spk": "帷 (トバリ)",
          "ja": "できれば<gamevalue GAME_VALUE_TALK_NUM>日以内でよろしく",
          "tc": "所以可以的話，希望你能在<gamevalue GAME_VALUE_TALK_NUM>天之內給我。",
          "sc": "所以可以的话，希望你能在<gamevalue GAME_VALUE_TALK_NUM>天之内给我。"
        }
      ]
    },
