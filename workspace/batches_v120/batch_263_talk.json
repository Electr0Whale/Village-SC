      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414243,
          "spk": "名护 (ナゴ)",
          "ja": "そうそう",
          "tc": "沒錯，",
          "sc": "没错，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414250,
          "spk": "名护 (ナゴ)",
          "ja": "全体的な流れを",
          "tc": "必須掌握整體的脈絡，",
          "sc": "必须掌握整体的脉络，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414257,
          "spk": "名护 (ナゴ)",
          "ja": "把握することが、大事なんだ",
          "tc": "這點很重要。",
          "sc": "这点很重要。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414270,
          "spk": "堇怜 (スミレ)",
          "ja": "はい、単に暗記するんじゃなくて",
          "tc": "我知道了，所以不能死背，",
          "sc": "我知道了，所以不能死背，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414277,
          "spk": "堇怜 (スミレ)",
          "ja": "その成り立ちを理解して……",
          "tc": "而是要理解前因後果……",
          "sc": "而是要理解前因后果……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 414290,
          "spk": "洋 (ヨウ)",
          "ja": "ナゴさん、こっちの字は",
          "tc": "名護叔叔，",
          "sc": "名护叔叔，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 414297,
          "spk": "洋 (ヨウ)",
          "ja": "なんて読むの？",
          "tc": "這個字要怎麼念？",
          "sc": "这个字要怎么念？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7432,
      "rec_id": "TALK_ID_70_2100_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414315,
          "spk": "名护 (ナゴ)",
          "ja": "ん？　どれどれ……",
          "tc": "嗯？我看看……",
          "sc": "嗯？我看看……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7433,
      "rec_id": "TALK_ID_70_2100_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414343,
          "spk": "名护 (ナゴ)",
          "ja": "今、スミレくんには歴史を",
          "tc": "我正好一邊在教堇怜歷史，",
          "sc": "我正好一边在教堇怜历史，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414350,
          "spk": "名护 (ナゴ)",
          "ja": "ヨウちゃんには読めない漢字を",
          "tc": "一邊在教小洋",
          "sc": "一边在教小洋"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414357,
          "spk": "名护 (ナゴ)",
          "ja": "教えていたんだけど……",
          "tc": "讀她看不懂的漢字……",
          "sc": "读她看不懂的汉字……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414368,
          "spk": "名护 (ナゴ)",
          "ja": "キミも、勉強していくかい？",
          "tc": "你也要一起學嗎？",
          "sc": "你也要一起学吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7434,
      "rec_id": "TALK_ID_70_2100_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414386,
          "spk": "名护 (ナゴ)",
          "ja": "ははは",
          "tc": "哈哈哈，",
          "sc": "哈哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414393,
          "spk": "名护 (ナゴ)",
          "ja": "その気になったら、",
          "tc": "等你有興趣的時候",
          "sc": "等你有兴趣的时候"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414400,
          "spk": "名护 (ナゴ)",
          "ja": "いつでも声をかけてくれ",
          "tc": "隨時都可以找我。",
          "sc": "随时都可以找我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7435,
      "rec_id": "TALK_ID_70_2100_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414424,
          "spk": "木助 (キスケ)",
          "ja": "うィ～",
          "tc": "呦～",
          "sc": "呦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414431,
          "spk": "木助 (キスケ)",
          "ja": "キスケさまのお通りだぜェ～",
          "tc": "木助大人駕到～",
          "sc": "木助大人驾到～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414446,
          "spk": "堇怜 (スミレ)",
          "ja": "うわっ……",
          "tc": "哇啊……",
          "sc": "哇啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414453,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさん！　また出たよ！",
          "tc": "名護哥！他又出現啦！",
          "sc": "名护哥！他又出现啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7436,
      "rec_id": "TALK_ID_70_2100_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414481,
          "spk": "名护 (ナゴ)",
          "ja": "おい、キスケさん……",
          "tc": "喂，木助先生……",
          "sc": "喂，木助先生……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414488,
          "spk": "名护 (ナゴ)",
          "ja": "ここは図書館だ、静かにしてくれ",
          "tc": "這裡是圖書館，請保持安靜。",
          "sc": "这里是图书馆，请保持安静。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414501,
          "spk": "木助 (キスケ)",
          "ja": "あん？",
          "tc": "啊？",
          "sc": "啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414508,
          "spk": "木助 (キスケ)",
          "ja": "誰の場所だと思ってんだ",
          "tc": "你以為這裡是誰的地方。",
          "sc": "你以为这里是谁的地方。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414515,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ、誰に雇われてるか分かってるのか？",
          "tc": "你有搞清楚自己是被誰雇用嗎？",
          "sc": "你有搞清楚自己是被谁雇用吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 414528,
          "spk": "名护 (ナゴ)",
          "ja": "分かってるよ",
          "tc": "我知道。",
          "sc": "我知道。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 414535,
          "spk": "名护 (ナゴ)",
          "ja": "だから、余計なことには",
          "tc": "所以我本來",
          "sc": "所以我本来"
        },
        {
          "f_idx": 7,
          "pidx_tc": 414542,
          "spk": "名护 (ナゴ)",
          "ja": "関わらないつもりだったが……",
          "tc": "也是不想多管閒事的……",
          "sc": "也是不想多管闲事的……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 414553,
          "spk": "名护 (ナゴ)",
          "ja": "だが、勉強している子どもたちにとっては、",
          "tc": "但是，對於在這邊念書的孩子們來說，",
          "sc": "但是，对于在这边念书的孩子们来说，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 414560,
          "spk": "名护 (ナゴ)",
          "ja": "ここで寝られると、迷惑なんだ",
          "tc": "你在這裡睡覺是一種打擾。",
          "sc": "你在这里睡觉是一种打扰。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 414567,
          "spk": "名护 (ナゴ)",
          "ja": "出て行ってくれ",
          "tc": "請出去。",
          "sc": "请出去。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 414580,
          "spk": "木助 (キスケ)",
          "ja": "俺は大人だぞ、",
          "tc": "我可是大人喔。",
          "sc": "我可是大人啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 414587,
          "spk": "木助 (キスケ)",
          "ja": "好きにさせろよ",
          "tc": "就隨我意嘛。",
          "sc": "就随我意嘛。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 414600,
          "spk": "名护 (ナゴ)",
          "ja": "その「大人」が昼間から酒か？",
          "tc": "所謂的「大人」是從白天就開始喝酒嗎？",
          "sc": "所谓的“大人”是从白天就开始喝酒吗？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 414607,
          "spk": "名护 (ナゴ)",
          "ja": "見せるもんじゃないだろう",
          "tc": "很難看吧。",
          "sc": "很难看吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 414614,
          "spk": "名护 (ナゴ)",
          "ja": "続きは酒が抜けてからにしろ",
          "tc": "有什麼話，等你酒醒了再說。",
          "sc": "有什么话，等你酒醒了再说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7437,
      "rec_id": "TALK_ID_70_2100_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414632,
          "spk": "木助 (キスケ)",
          "ja": "ちっ、なんだってんだ……",
          "tc": "哼，搞什麼嘛……",
          "sc": "哼，搞什么嘛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414639,
          "spk": "木助 (キスケ)",
          "ja": "昼寝くらい、いいじゃねえか……",
          "tc": "來睡個午覺而已，又沒什麼。",
          "sc": "来睡个午觉而已，又没什么。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7438,
      "rec_id": "TALK_ID_70_2100_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414669,
          "spk": "堇怜 (スミレ)",
          "ja": "やったね、ナゴさん！",
          "tc": "成功了！名護哥！",
          "sc": "成功了！名护哥！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414676,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の言った通りだったでしょ！",
          "tc": "就跟我說的一樣對吧！",
          "sc": "就跟我说的一样对吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414683,
          "spk": "堇怜 (スミレ)",
          "ja": "キスケさんは、論破されると弱いって！",
          "tc": "木助哥被駁倒就沒了氣勢！",
          "sc": "木助哥被驳倒就没了气势！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414696,
          "spk": "洋 (ヨウ)",
          "ja": "ナゴさん、ありがとう……",
          "tc": "名護叔叔，謝謝你……",
          "sc": "名护叔叔，谢谢你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7439,
      "rec_id": "TALK_ID_70_2100_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414714,
          "spk": "名护 (ナゴ)",
          "ja": "どういたしまして",
          "tc": "不客氣。",
          "sc": "不客气。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414721,
          "spk": "名护 (ナゴ)",
          "ja": "素直に帰ってくれて、正直ホッとしてるよ……",
          "tc": "還好他乖乖地回去了，老實說我鬆了口氣……",
          "sc": "还好他乖乖地回去了，老实说我松了口气……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414732,
          "spk": "名护 (ナゴ)",
          "ja": "邪魔が入ったけど、",
          "tc": "雖然被人打斷了，",
          "sc": "虽然被人打断了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414739,
          "spk": "名护 (ナゴ)",
          "ja": "勉強の続きに集中しようか",
          "tc": "繼續專心唸書吧。",
          "sc": "继续专心念书吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414754,
          "spk": "堇怜 (スミレ)",
          "ja": "はーい",
          "tc": "好～",
          "sc": "好～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7440,
      "rec_id": "TALK_ID_70_2100_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414782,
          "spk": "名护 (ナゴ)",
          "ja": "キミに何か教えるのは、",
          "tc": "指導你念書的事",
          "sc": "指导你念书的事"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414789,
          "spk": "名护 (ナゴ)",
          "ja": "また別の機会にするとして……",
          "tc": "就等下次有機會再說……",
          "sc": "就等下次有机会再说……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 414800,
          "spk": "名护 (ナゴ)",
          "ja": "今日は、キミから",
          "tc": "今天就先來談談",
          "sc": "今天就先来谈谈"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414807,
          "spk": "名护 (ナゴ)",
          "ja": "教わったことについて",
          "tc": "我從你身上",
          "sc": "我从你身上"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414814,
          "spk": "名护 (ナゴ)",
          "ja": "話しておこうかな",
          "tc": "學到的事吧。",
          "sc": "学到的事吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 414823,
          "spk": "名护 (ナゴ)",
          "ja": "そのうち、お礼を",
          "tc": "我一直想著要找機會",
          "sc": "我一直想着要找机会"
        },
        {
          "f_idx": 6,
          "pidx_tc": 414830,
          "spk": "名护 (ナゴ)",
          "ja": "言わなきゃとは思ってたんだ",
          "tc": "向你道謝才行。",
          "sc": "向你道谢才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7441,
      "rec_id": "TALK_ID_70_2100_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 414846,
          "spk": "名护 (ナゴ)",
          "ja": "この村に来て、<player>さんと関わって",
          "tc": "來到這座村子和<player>交流後，",
          "sc": "来到这座村子和<player>交流后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 414853,
          "spk": "名护 (ナゴ)",
          "ja": "いい変化があったんだ",
          "tc": "我變得更好了。",
          "sc": "我变得更好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 414871,
          "spk": "名护 (ナゴ)",
          "ja": "……いつからか、自分は特別じゃなく",
          "tc": "……曾幾何時，我發現自己並不特別，",
          "sc": "……曾几何时，我发现自己并不特别，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 414878,
          "spk": "名护 (ナゴ)",
          "ja": "平凡な存在だと気づき、苦しかった",
          "tc": "不過是平庸的存在，而感到很痛苦。",
          "sc": "不过是平庸的存在，而感到很痛苦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 414896,
          "spk": "名护 (ナゴ)",
          "ja": "辛い現実に",
          "tc": "面對殘酷的現實，",
          "sc": "面对残酷的现实，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 414903,
          "spk": "名护 (ナゴ)",
          "ja": "打ちのめされてばかりでね……",
          "tc": "不斷遭受打擊……",
          "sc": "不断遭受打击……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 414912,
          "spk": "名护 (ナゴ)",
          "ja": "そうしている間に、自分が何者で、",
          "tc": "不知不覺間，",
          "sc": "不知不觉间，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 414919,
          "spk": "名护 (ナゴ)",
          "ja": "何をしたくて、何を大切にしているのか",
          "tc": "我連自己究竟是誰，又想做些什麼，",
          "sc": "我连自己究竟是谁，又想做些什么，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 414926,
          "spk": "名护 (ナゴ)",
          "ja": "見失ってしまったんだ",
          "tc": "甚至連自己所寶貴的事物，都搞不清楚了。",
          "sc": "甚至连自己所宝贵的事物，都搞不清楚了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 414937,
          "spk": "名护 (ナゴ)",
          "ja": "だけど、<player>さんによって",
          "tc": "然而，因為有<player>，",
          "sc": "然而，因为有<player>，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 414944,
          "spk": "名护 (ナゴ)",
          "ja": "「本当に大切なもの」に",
          "tc": "才讓我察覺到──",
          "sc": "才让我察觉到——"
        },
        {
          "f_idx": 13,
          "pidx_tc": 414951,
          "spk": "名护 (ナゴ)",
          "ja": "気づくことができた",
          "tc": "「真正重要的東西」。",
          "sc": "“真正重要的东西”。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 414962,
          "spk": "名护 (ナゴ)",
          "ja": "そうしてすっかり、",
          "tc": "而我也因此",
          "sc": "而我也因此"
        },
        {
          "f_idx": 15,
          "pidx_tc": 414969,
          "spk": "名护 (ナゴ)",
          "ja": "俺はこの村に「しがらみ」ができてしまった",
          "tc": "與這座村子產生了「羈絆」。",
          "sc": "与这座村子产生了“羁绊”。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 414976,
          "spk": "名护 (ナゴ)",
          "ja": "……いい意味でね",
          "tc": "……我是指好的方面啦。",
          "sc": "……我是指好的方面啦。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 414987,
          "spk": "名护 (ナゴ)",
          "ja": "だから……<player>さん",
          "tc": "所以說……<player>，",
          "sc": "所以说……<player>，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 414994,
          "spk": "名护 (ナゴ)",
          "ja": "俺に大切なものを気づかせてくれて、",
          "tc": "很感謝你，",
          "sc": "很感谢你，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 415001,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう",
          "tc": "讓我發現了對我來說什麼才是最重要的。",
          "sc": "让我发现了对我来说什么才是最重要的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7442,
      "rec_id": "TALK_ID_70_2100_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415027,
          "spk": "洋 (ヨウ)",
          "ja": "ナゴさん、変わったね",
          "tc": "名護叔叔，你變了呢。",
          "sc": "名护叔叔，你变了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415049,
          "spk": "堇怜 (スミレ)",
          "ja": "……前だったら、",
          "tc": "……換作是以前，",
          "sc": "……换作是以前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415056,
          "spk": "堇怜 (スミレ)",
          "ja": "そんな照れくさいこと言わなかったよね",
          "tc": "你才不會說那麼令人害臊的話。",
          "sc": "你才不会说那么令人害臊的话。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7443,
      "rec_id": "TALK_ID_70_2100_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415076,
          "spk": "名护 (ナゴ)",
          "ja": "ちゃんと言葉にしないと",
          "tc": "畢竟有些事情還是要說清楚",
          "sc": "毕竟有些事情还是要说清楚"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415083,
          "spk": "名护 (ナゴ)",
          "ja": "伝えられないこともあるからな",
          "tc": "才能傳達出去啊。",
          "sc": "才能传达出去啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415094,
          "spk": "名护 (ナゴ)",
          "ja": "……いつまでも、俺の顔ばっかり",
          "tc": "……繼續盯著我的臉看",
          "sc": "……继续盯着我的脸看"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415101,
          "spk": "名护 (ナゴ)",
          "ja": "見てたって仕方ないだろ？",
          "tc": "也沒意義吧？",
          "sc": "也没意义吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 415112,
          "spk": "名护 (ナゴ)",
          "ja": "それより、ほら",
          "tc": "比起這個，",
          "sc": "比起这个，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 415119,
          "spk": "名护 (ナゴ)",
          "ja": "勉強に集中して",
          "tc": "還不如專心學習。",
          "sc": "还不如专心学习。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 415130,
          "spk": "名护 (ナゴ)",
          "ja": "今日の課題もあと少しなんだし、",
          "tc": "今天的作業就快做完了，",
          "sc": "今天的作业就快做完了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 415137,
          "spk": "名护 (ナゴ)",
          "ja": "二人とも、もうひと息がんばろう",
          "tc": "你們兩個再努力一下吧。",
          "sc": "你们两个再努力一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7444,
      "rec_id": "TALK_ID_70_2100_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415165,
          "spk": "名护 (ナゴ)",
          "ja": "待っていたよ、<player>さん",
          "tc": "等你很久了，<player>。",
          "sc": "等你很久了，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415174,
          "spk": "名护 (ナゴ)",
          "ja": "キミのために",
          "tc": "我為了你啊，",
          "sc": "我为了你啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415181,
          "spk": "名护 (ナゴ)",
          "ja": "「七草粥」を用意しておいた",
          "tc": "準備了「七草粥」。",
          "sc": "准备了“七草粥”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415192,
          "spk": "名护 (ナゴ)",
          "ja": "冷めないうちに、食事にしようか",
          "tc": "趁還沒冷掉，來吃飯吧。",
          "sc": "趁还没冷掉，来吃饭吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7445,
      "rec_id": "TALK_ID_70_2100_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415223,
          "spk": "名护 (ナゴ)",
          "ja": "図書館で見つけたレシピ本を見て",
          "tc": "這是我參考在圖書館發現的食譜",
          "sc": "这是我参考在图书馆发现的食谱"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415230,
          "spk": "名护 (ナゴ)",
          "ja": "作ってみたんだけど……",
          "tc": "試著做出來的……",
          "sc": "试着做出来的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415241,
          "spk": "名护 (ナゴ)",
          "ja": "これは、この土地の",
          "tc": "據說是這個地區的",
          "sc": "据说是这个地区的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415248,
          "spk": "名护 (ナゴ)",
          "ja": "郷土料理みたいでね",
          "tc": "鄉土料理喔！",
          "sc": "乡土料理哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 415259,
          "spk": "名护 (ナゴ)",
          "ja": "こういったところからも",
          "tc": "從這種地方",
          "sc": "从这种地方"
        },
        {
          "f_idx": 5,
          "pidx_tc": 415266,
          "spk": "名护 (ナゴ)",
          "ja": "歴史の息吹を感じられる……",
          "tc": "也能感受到歷史的氣息……",
          "sc": "也能感受到历史的气息……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 415273,
          "spk": "名护 (ナゴ)",
          "ja": "いい発見をしたよ",
          "tc": "真是發現了好東西。",
          "sc": "真是发现了好东西。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 415284,
          "spk": "名护 (ナゴ)",
          "ja": "……それと、料理に挑戦してみたのも",
          "tc": "……而且試著挑戰做料理，",
          "sc": "……而且试着挑战做料理，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 415291,
          "spk": "名护 (ナゴ)",
          "ja": "新しい発見ではあったかな",
          "tc": "也算是一個新發現吧。",
          "sc": "也算是一个新发现吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 415302,
          "spk": "名护 (ナゴ)",
          "ja": "恥ずかしい話、これまでは",
          "tc": "說來羞愧，",
          "sc": "说来羞愧，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 415309,
          "spk": "名护 (ナゴ)",
          "ja": "同棲していた彼女に",
          "tc": "以前一直都是同居的女友",
          "sc": "以前一直都是同居的女友"
        },
        {
          "f_idx": 11,
          "pidx_tc": 415316,
          "spk": "名护 (ナゴ)",
          "ja": "作ってもらってばかりだったんだ",
          "tc": "在幫我做飯。",
          "sc": "在帮我做饭。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 415325,
          "spk": "名护 (ナゴ)",
          "ja": "だから、自分で作ることも",
          "tc": "所以說，",
          "sc": "所以说，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 415332,
          "spk": "名护 (ナゴ)",
          "ja": "ほとんどなくて……",
          "tc": "我幾乎沒有自己下廚過……",
          "sc": "我几乎没有自己下厨过……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 415343,
          "spk": "名护 (ナゴ)",
          "ja": "慣れない料理だったから、",
          "tc": "因為我不太習慣做菜，",
          "sc": "因为我不太习惯做菜，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 415350,
          "spk": "名护 (ナゴ)",
          "ja": "キミの口にあうといいんだが……",
          "tc": "但願合你的胃口……",
          "sc": "但愿合你的胃口……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 415361,
          "spk": "名护 (ナゴ)",
          "ja": "どうだ、食べられるか……？",
          "tc": "怎麼樣，還算能吃嗎……？",
          "sc": "怎么样，还算能吃吗……？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 415370,
          "spk": "主角心声/旁白/选项",
          "ja": "うん！",
          "tc": "嗯！",
          "sc": "嗯！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 415377,
          "spk": "主角心声/旁白/选项",
          "ja": "おいしいよ",
          "tc": "好吃",
          "sc": "好吃"
        }
      ]
    },
    {
      "file": "talk.dat",
