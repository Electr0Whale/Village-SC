    {
      "file": "talk.dat",
      "rec_idx": 7447,
      "rec_id": "TALK_ID_70_2100_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415519,
          "spk": "名护 (ナゴ)",
          "ja": "……うーん？",
          "tc": "……嗯？",
          "sc": "……嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415526,
          "spk": "名护 (ナゴ)",
          "ja": "何だか妙に、癖のある味だな……",
          "tc": "總覺得，味道有點奇怪……",
          "sc": "总觉得，味道有点奇怪……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415537,
          "spk": "名护 (ナゴ)",
          "ja": "調理の過程でミスをしたのか",
          "tc": "是調理過程出錯了嗎？",
          "sc": "是调理过程出错了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415544,
          "spk": "名护 (ナゴ)",
          "ja": "それとも、レシピが悪いのか……",
          "tc": "還是食譜有問題……？",
          "sc": "还是食谱有问题……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 415555,
          "spk": "名护 (ナゴ)",
          "ja": "……まあ、<player>さんが",
          "tc": "……算了，既然<player>吃得開心，",
          "sc": "……算了，既然<player>吃得开心，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 415562,
          "spk": "名护 (ナゴ)",
          "ja": "喜んで食べてくれているんだし、いいか",
          "tc": "那就這樣吧。",
          "sc": "那就这样吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 415573,
          "spk": "名护 (ナゴ)",
          "ja": "今度は、もっといい料理を作るから",
          "tc": "下次我會做出更棒的料理，",
          "sc": "下次我会做出更棒的料理，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 415580,
          "spk": "名护 (ナゴ)",
          "ja": "期待しててくれ",
          "tc": "你就好好期待吧。",
          "sc": "你就好好期待吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 415591,
          "spk": "名护 (ナゴ)",
          "ja": "ロッカクさんに料理を",
          "tc": "請六角先生教我做菜，",
          "sc": "请六角先生教我做菜，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 415598,
          "spk": "名护 (ナゴ)",
          "ja": "教わるのも、いいかもな",
          "tc": "好像也不錯呢。",
          "sc": "好像也不错呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7448,
      "rec_id": "TALK_ID_70_2100_008_01",
      "lines": [
        {
