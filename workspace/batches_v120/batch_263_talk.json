        {
          "f_idx": 5,
          "pidx_tc": 415663,
          "spk": "名护 (ナゴ)",
          "ja": "さ、早く座ってくれ",
          "tc": "來，快點坐下吧。",
          "sc": "来，快点坐下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7449,
      "rec_id": "TALK_ID_70_2100_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415687,
          "spk": "名护 (ナゴ)",
          "ja": "村に来るまでは、料理という料理は",
          "tc": "來到這座村子前，",
          "sc": "来到这座村子前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415694,
          "spk": "名护 (ナゴ)",
          "ja": "ほとんどしたことはなかったけど……",
          "tc": "我幾乎沒做過像樣的料理……",
          "sc": "我几乎没做过像样的料理……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415705,
          "spk": "名护 (ナゴ)",
          "ja": "この「梅茶漬け」だけは、別だ",
          "tc": "唯獨「梅子茶泡飯」例外。",
          "sc": "唯独“梅子茶泡饭”例外。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415714,
          "spk": "名护 (ナゴ)",
          "ja": "街で暮らしていた頃は、",
          "tc": "我還在市區生活的時候，",
          "sc": "我还在市区生活的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 415721,
          "spk": "名护 (ナゴ)",
          "ja": "よく作ってた得意料理なんだ",
          "tc": "這是我很常做的拿手料理。",
          "sc": "这是我很常做的拿手料理。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 415732,
          "spk": "名护 (ナゴ)",
          "ja": "……ま、お茶を注ぐくらいだし",
          "tc": "……但也只是把茶倒進去而已，",
          "sc": "……但也只是把茶倒进去而已，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 415739,
          "spk": "名护 (ナゴ)",
          "ja": "料理と言えるほどのものか",
          "tc": "能不能稱得上料理",
          "sc": "能不能称得上料理"
        },
        {
          "f_idx": 7,
          "pidx_tc": 415746,
          "spk": "名护 (ナゴ)",
          "ja": "わからないけどね",
          "tc": "好像也很難說。",
          "sc": "好像也很难说。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 415757,
          "spk": "名护 (ナゴ)",
          "ja": "とにかく、味には自信があるから",
          "tc": "總之我對味道很有自信，",
          "sc": "总之我对味道很有自信，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 415764,
          "spk": "名护 (ナゴ)",
          "ja": "食べてみてくれ",
          "tc": "快嘗嘗看吧。",
          "sc": "快尝尝看吧。"
        }
      ]
    },
