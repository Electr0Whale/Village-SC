    {
      "file": "talk.dat",
      "rec_idx": 3674,
      "rec_id": "TALK_ID_10_0102_032_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206556,
          "spk": "洋 (ヨウ)",
          "ja": "あのね、<player>、指笛はね、",
          "tc": "聽好囉，<player>，手哨呢，",
