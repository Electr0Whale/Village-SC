          "tc": "話說回來，我聽說啊，",
          "sc": "话说回来，我听说啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208056,
          "spk": "？？？ (未知角色)",
          "ja": "先月まであの……",
          "tc": "直到上個月，那個……",
