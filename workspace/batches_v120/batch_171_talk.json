      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203813,
          "spk": "林 (リン)",
          "ja": "<strong>あなたの育てた野菜を、",
          "tc": "<strong>將你培育的蔬菜，",
          "sc": "<strong>将你培育的蔬菜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203820,
          "spk": "林 (リン)",
          "ja": "この祭壇に投げ込みなさい</strong>",
          "tc": "丟進這個祭壇裡吧。</strong>",
          "sc": "丢进这个祭坛里吧。</strong>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203831,
          "spk": "林 (リン)",
          "ja": "従ってくれるのであれば、",
          "tc": "只要你照著做，",
          "sc": "只要你照着做，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 203838,
          "spk": "林 (リン)",
          "ja": "私たちはあなたを",
          "tc": "我們就會認同",
          "sc": "我们就会认同"
        },
        {
          "f_idx": 4,
          "pidx_tc": 203845,
          "spk": "林 (リン)",
          "ja": "村の一員として認めてあげる",
          "tc": "你是村子的一員。",
          "sc": "你是村子的一员。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3653,
      "rec_id": "TALK_ID_10_0101_021_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203865,
          "spk": "木助 (キスケ)",
          "ja": "……おいリン、言っただろ",
          "tc": "……喂，林，我說過了吧。",
          "sc": "……喂，林，我说过了吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203872,
          "spk": "木助 (キスケ)",
          "ja": "こいつに言う事を聞かせたいなら",
          "tc": "想讓這傢伙乖乖聽你的話，",
          "sc": "想让这家伙乖乖听你的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203879,
          "spk": "木助 (キスケ)",
          "ja": "対価は先払いだ",
          "tc": "得先預付報酬。",
          "sc": "得先预付报酬。"
        }
      ]
    },
    {
