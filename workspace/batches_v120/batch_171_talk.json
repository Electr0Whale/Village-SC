          "pidx_tc": 203897,
          "spk": "木助 (キスケ)",
          "ja": "ほら、<player>",
          "tc": "來，<player>。",
          "sc": "来，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203904,
          "spk": "木助 (キスケ)",
          "ja": "これが野菜の報酬だ",
          "tc": "這就是那蔬菜的報酬。",
          "sc": "这就是那蔬菜的报酬。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3655,
      "rec_id": "TALK_ID_10_0101_021_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203930,
          "spk": "木助 (キスケ)",
          "ja": "<player>、てめぇの立場を明らかにしな",
          "tc": "<player>，去表明你的立場吧。",
          "sc": "<player>，去表明你的立场吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203939,
          "spk": "木助 (キスケ)",
          "ja": "村の一員になるために、",
          "tc": "為了成為村子的一員，",
          "sc": "为了成为村子的一员，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203946,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの育てた大切な野菜を",
          "tc": "將你用心培育出的寶貝蔬菜，",
          "sc": "将你用心培育出的宝贝蔬菜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 203953,
          "spk": "木助 (キスケ)",
          "ja": "この祭壇に捧げろ",
          "tc": "奉獻到這個祭壇裡吧。",
          "sc": "奉献到这个祭坛里吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 203962,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 5,
          "pidx_tc": 203969,
          "spk": "主角心声/旁白/选项",
          "ja": "わかった",
          "tc": "知道了",
          "sc": "知道了"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3656,
      "rec_id": "TALK_ID_10_0101_021_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204495,
          "spk": "林 (リン)",
          "ja": "みんな、もういいわよ！",
          "tc": "各位，沒問題了！",
          "sc": "各位，没问题了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204502,
          "spk": "林 (リン)",
          "ja": "これで<player>は、",
          "tc": "從今天起，<player>",
          "sc": "从今天起，<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204509,
          "spk": "林 (リン)",
          "ja": "今日から村の一員になったから！",
          "tc": "也是這個村子的一員了！",
          "sc": "也是这个村子的一员了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3657,
      "rec_id": "TALK_ID_10_0101_021_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204529,
          "spk": "茶梅 (サザンカ)",
          "ja": "話せないの",
          "tc": "不能跟你說話",
          "sc": "不能跟你说话"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204536,
          "spk": "茶梅 (サザンカ)",
          "ja": "難しかったあ",
          "tc": "真的好難喔。",
          "sc": "真的好难哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3658,
      "rec_id": "TALK_ID_10_0101_021_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204552,
          "spk": "莲实 (ハスミ)",
          "ja": "かわいそうなことを",
          "tc": "這段時間",
          "sc": "这段时间"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204559,
          "spk": "莲实 (ハスミ)",
          "ja": "してしまいましたね……",
          "tc": "真的是難為你了呢……",
          "sc": "真的是难为你了呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3659,
      "rec_id": "TALK_ID_10_0101_021_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204575,
          "spk": "堇怜 (スミレ)",
          "ja": "今日までごめんよ",
          "tc": "抱歉啊，之前那樣對你。",
          "sc": "抱歉啊，之前那样对你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3660,
      "rec_id": "TALK_ID_10_0101_021_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204595,
          "spk": "林 (リン)",
          "ja": "ふふ、<player>は",
          "tc": "呵呵，<player>",
          "sc": "呵呵，<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204602,
          "spk": "林 (リン)",
          "ja": "今日から真の意味で村の一員よ",
          "tc": "從今天起就是真正意義上村子的一員了。",
          "sc": "从今天起就是真正意义上村子的一员了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204618,
          "spk": "林 (リン)",
          "ja": "これからは村の人たちも、",
          "tc": "以後村裡的大家",
          "sc": "以后村里的大家"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204625,
          "spk": "林 (リン)",
          "ja": "あなたと喋ってくれるわ",
          "tc": "也都會願意跟你說話的。",
          "sc": "也都会愿意跟你说话的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3661,
      "rec_id": "TALK_ID_10_0101_021_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204643,
          "spk": "林 (リン)",
          "ja": "……何よその表情は",
          "tc": "……你這是什麼表情？",
          "sc": "……你这是什么表情？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204650,
          "spk": "林 (リン)",
          "ja": "村のしきたりが理解できないって？",
          "tc": "不能理解村子的規矩？",
          "sc": "不能理解村子的规矩？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204661,
          "spk": "林 (リン)",
          "ja": "この村には、",
          "tc": "這個村子",
          "sc": "这个村子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204668,
          "spk": "林 (リン)",
          "ja": "古くからの習わしがたくさんあるの",
          "tc": "傳承了很多自古以來的習俗，",
          "sc": "传承了很多自古以来的习俗，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204677,
          "spk": "林 (リン)",
          "ja": "しきたりを守ることが、",
          "tc": "遵守這些規矩，",
          "sc": "遵守这些规矩，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 204684,
          "spk": "林 (リン)",
          "ja": "村を守ることにもつながる",
          "tc": "就等同於是在守護村子。",
          "sc": "就等同于是在守护村子。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 204695,
          "spk": "林 (リン)",
          "ja": "きっといつか",
          "tc": "總有一天，",
          "sc": "总有一天，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 204702,
          "spk": "林 (リン)",
          "ja": "あなたにもその理由がわかるはず",
          "tc": "你也會理解其中意義。",
          "sc": "你也会理解其中意义。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 204713,
          "spk": "林 (リン)",
          "ja": "掟を守ることを忘れずに、",
          "tc": "總之不要忘記遵守規矩，",
          "sc": "总之不要忘记遵守规矩，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 204720,
          "spk": "林 (リン)",
          "ja": "この暮らしに慣れていってほしいわ",
          "tc": "慢慢習慣在這裡的生活吧。",
          "sc": "慢慢习惯在这里的生活吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3662,
      "rec_id": "TALK_ID_10_0101_021_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204744,
          "spk": "林 (リン)",
          "ja": "改めて、ようこそ彼ヶ津村へ",
          "tc": "再次歡迎你來到彼津村！",
          "sc": "再次欢迎你来到彼津村！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204751,
          "spk": "林 (リン)",
          "ja": "<player>、あなたを歓迎するわ",
          "tc": "<player>，歡迎你的到來！",
          "sc": "<player>，欢迎你的到来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3663,
      "rec_id": "TALK_ID_10_0101_023_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204771,
          "spk": "茶梅 (サザンカ)",
          "ja": "……なにしてんの？",
          "tc": "……你怎麼了？",
          "sc": "……你怎么了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3664,
      "rec_id": "TALK_ID_10_0101_023_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204791,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああ……",
          "tc": "喔……",
          "sc": "喔……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204798,
          "spk": "茶梅 (サザンカ)",
          "ja": "大切に育てた野菜を奪われて",
          "tc": "是因為自己用心種的蔬菜被奪走，",
          "sc": "是因为自己用心种的蔬菜被夺走，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204805,
          "spk": "茶梅 (サザンカ)",
          "ja": "がっかりしてたんだ",
          "tc": "心裡很失落啊。",
          "sc": "心里很失落啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3665,
      "rec_id": "TALK_ID_10_0101_023_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204823,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんなに食べたかったの？",
          "tc": "你很期待可以吃到嗎？",
          "sc": "你很期待可以吃到吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3666,
      "rec_id": "TALK_ID_10_0101_023_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204847,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、そんなに落ち込んでるなら",
          "tc": "不過，你要是那麼失落的話，",
          "sc": "不过，你要是那么失落的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204854,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょうどよかったかもな……",
          "tc": "或許現在很剛好……",
          "sc": "或许现在很刚好……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204865,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシさぁ、",
          "tc": "我呢，",
          "sc": "我呢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204872,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタが村の一員になったって聞いて、",
          "tc": "我聽說你成為了這個村子的一分子，",
          "sc": "我听说你成为了这个村子的一分子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204879,
          "spk": "茶梅 (サザンカ)",
          "ja": "営業しに来たんだよね",
          "tc": "就過來推銷了。",
          "sc": "就过来推销了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3667,
      "rec_id": "TALK_ID_10_0101_023_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204897,
          "spk": "茶梅 (サザンカ)",
          "ja": "改めて、アタシはサザンカっていうの",
          "tc": "我再重新跟你自我介紹一次，我叫茶梅，",
          "sc": "我再重新跟你自我介绍一次，我叫茶梅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204904,
          "spk": "茶梅 (サザンカ)",
          "ja": "村で雑貨店をやってるんだ",
          "tc": "在村子裡是開雜貨店的。",
          "sc": "在村子里是开杂货店的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204922,
          "spk": "茶梅 (サザンカ)",
          "ja": "実った野菜が奪われて悲しいのはわかるけど、",
          "tc": "我可以體會辛苦培育的蔬菜被搶走的悲傷，",
          "sc": "我可以体会辛苦培育的蔬菜被抢走的悲伤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204929,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの店は作物の種も売ってるからさ、",
          "tc": "不過我店裡有賣作物的種子，",
          "sc": "不过我店里有卖作物的种子，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 204936,
          "spk": "茶梅 (サザンカ)",
          "ja": "またイチから育てればいいじゃん",
          "tc": "可以再重新種就好啦。",
          "sc": "可以再重新种就好啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 204947,
          "spk": "茶梅 (サザンカ)",
          "ja": "あ、そーだ！",
          "tc": "啊，對了！",
          "sc": "啊，对了！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 204954,
          "spk": "茶梅 (サザンカ)",
          "ja": "せっかくだし今から一緒に",
          "tc": "機會難得，",
          "sc": "机会难得，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 204961,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの店行こうよ",
          "tc": "現在一起到我店裡去吧。",
          "sc": "现在一起到我店里去吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 204972,
          "spk": "茶梅 (サザンカ)",
          "ja": "本当は今日……金曜日は定休日なんだけど、",
          "tc": "其實今天……星期五本來是公休日，",
          "sc": "其实今天……星期五本来是休息日，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 204979,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタのために店、開けてあげる",
          "tc": "但我可以為你開店。",
          "sc": "但我可以为你开店。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 204997,
          "spk": "茶梅 (サザンカ)",
          "ja": "作物の種以外にも、アンタが気に入りそうな",
          "tc": "除了作物的種子以外，",
          "sc": "除了作物的种子以外，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 205004,
          "spk": "茶梅 (サザンカ)",
          "ja": "素敵なシロモノを取り揃えてるからさ",
          "tc": "還有你一定會喜歡的商品喔。",
          "sc": "还有你一定会喜欢的商品哦。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 205011,
          "spk": "茶梅 (サザンカ)",
          "ja": "ほら、着いておいで",
          "tc": "跟我來吧。",
          "sc": "跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3668,
      "rec_id": "TALK_ID_10_0101_024_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205035,
          "spk": "洋 (ヨウ)",
          "ja": "ヤギさん、今年もいなくなっちゃった……",
          "tc": "山羊，怎麼今年也不見了……",
          "sc": "山羊，怎么今年也不见了……"
