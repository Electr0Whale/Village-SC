    {
      "file": "talk.dat",
      "rec_idx": 7088,
      "rec_id": "TALK_ID_70_2060_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 401095,
          "spk": "驹子 (コマコ)",
          "ja": "ざるそば、アップルパイ、大人なカレー……",
          "tc": "竹籠蕎麥麵、蘋果派、大人咖哩……",
          "sc": "竹笼荞麦面、苹果派、大人咖喱……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 401102,
          "spk": "驹子 (コマコ)",
          "ja": "ピーマンの肉詰め、カボチャの煮物……",
          "tc": "青椒鑲肉、燉南瓜……",
          "sc": "青椒镶肉、炖南瓜……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 401109,
          "spk": "驹子 (コマコ)",
          "ja": "うう……や、やっぱり選べないよぅ……",
          "tc": "唔……還、還是無法選擇啦……",
          "sc": "唔……还、还是无法选择啦……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 401122,
          "spk": "六角 (ロッカク)",
          "ja": "あれっ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 401129,
          "spk": "六角 (ロッカク)",
          "ja": "コマコさん、どうしたっスか！？",
          "tc": "駒子妹妹是怎麼了！？",
          "sc": "驹子妹妹是怎么了！？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 401142,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、あはは……",
          "tc": "啊、啊哈哈……",
          "sc": "啊、啊哈哈……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 401149,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっとした遊びの",
          "tc": "我們本來",
          "sc": "我们本来"
        },
        {
          "f_idx": 7,
          "pidx_tc": 401156,
          "spk": "堇怜 (スミレ)",
          "ja": "つもりだったんだけど……",
          "tc": "只是想跟她玩個小遊戲而已……",
          "sc": "只是想跟她玩个小游戏而已……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 401169,
          "spk": "莲实 (ハスミ)",
          "ja": "ごめんなさい",
          "tc": "對不起，",
          "sc": "对不起，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 401176,
          "spk": "莲实 (ハスミ)",
          "ja": "好奇心でお願いしたばかりに……",
          "tc": "都怪我太好奇，要妳試試看……",
          "sc": "都怪我太好奇，要你试试看……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 401189,
          "spk": "驹子 (コマコ)",
          "ja": "う、ううん、大丈夫……",
          "tc": "不、不會，沒關係的……",
          "sc": "不、不会，没关系的……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 401196,
