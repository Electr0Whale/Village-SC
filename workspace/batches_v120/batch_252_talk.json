          "pidx_tc": 402002,
          "spk": "林 (リン)",
          "ja": "あたふたしがちなのよね",
          "tc": "因此時常慌慌張張的。",
          "sc": "因此时常慌慌张张的。"
        }
      ]
    },
    {
      "file": "talk.dat",
