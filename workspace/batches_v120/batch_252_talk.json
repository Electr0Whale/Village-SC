          "sc": "我……不算没事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 401427,
          "spk": "驹子 (コマコ)",
          "ja": "平気だよ、あはは……",
          "tc": "但應該不會有事的，啊哈哈……",
          "sc": "但应该不会有事的，啊哈哈……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 401438,
          "spk": "驹子 (コマコ)",
          "ja": "さっき、リンにお願いされた",
          "tc": "我剛剛都在處理",
          "sc": "我刚刚都在处理"
        },
        {
          "f_idx": 4,
          "pidx_tc": 401445,
          "spk": "驹子 (コマコ)",
          "ja": "お仕事をしてたんだけど",
          "tc": "林交給我的工作。",
          "sc": "林交给我的工作。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 401456,
          "spk": "驹子 (コマコ)",
          "ja": "「臨機応変にやって」って言われて、",
          "tc": "她叫我要「隨機應變」，",
          "sc": "她叫我要“随机应变”，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 401463,
          "spk": "驹子 (コマコ)",
          "ja": "どうすればいいか悩んじゃって……",
          "tc": "但我不知道該怎麼辦才好……",
          "sc": "但我不知道该怎么办才好……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 401479,
          "spk": "驹子 (コマコ)",
          "ja": "忙しそうなリンに、",
          "tc": "所以即便林很忙，",
          "sc": "所以即便林很忙，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 401486,
          "spk": "驹子 (コマコ)",
          "ja": "何回も指示をもらいに行ってたの",
          "tc": "我還是多番跑去請求她的指示。",
          "sc": "我还是多番跑去请求她的指示。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 401497,
          "spk": "驹子 (コマコ)",
          "ja": "そうしたら……",
          "tc": "結果……",
          "sc": "结果……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 401504,
          "spk": "驹子 (コマコ)",
          "ja": "「それくらい自分で判断しなさい！」",
          "tc": "她就罵我說",
          "sc": "她就骂我说"
        },
        {
          "f_idx": 12,
          "pidx_tc": 401511,
          "spk": "驹子 (コマコ)",
          "ja": "って怒られちゃったんだ……",
          "tc": "「這點小事妳自己判斷！」",
          "sc": "“这点小事你自己判断！”"
        },
        {
          "f_idx": 13,
          "pidx_tc": 401522,
          "spk": "驹子 (コマコ)",
          "ja": "自分で考えて決めろって",
          "tc": "我經常被說要自己思考、做決定，",
          "sc": "我经常被说要自己思考、做决定，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 401529,
          "spk": "驹子 (コマコ)",
          "ja": "よく言われるけど、難しいよ……",
