      "rec_id": "TALK_ID_70_2060_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400380,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400391,
          "spk": "驹子 (コマコ)",
          "ja": "み、見ててもつまんなくないかな……？",
          "tc": "你、你這樣看著不會無聊嗎……？",
          "sc": "你、你这样看着不会无聊吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 400400,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 400407,
          "spk": "主角心声/旁白/选项",
