          "sc": "叫她意志坚定点，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402034,
          "spk": "林 (リン)",
          "ja": "あなたからも言っておいてちょうだい",
          "tc": "不要遇到事情都要別人幫她作主。",
          "sc": "不要遇到事情都要别人帮她作主。"
        }
      ]
    },
