      "rec_id": "TALK_ID_70_2060_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 401945,
          "spk": "林 (リン)",
          "ja": "コマコったら……",
          "tc": "駒子真是的……",
          "sc": "驹子真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 401952,
          "spk": "林 (リン)",
          "ja": "ちゃんと能力はあるんだけど……",
          "tc": "其實她是很有能力的……",
          "sc": "其实她是很有能力的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 401963,
          "spk": "林 (リン)",
          "ja": "狩りの腕前も良いし、",
          "tc": "雖然她偶爾會發呆，",
          "sc": "虽然她偶尔会发呆，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 401970,
          "spk": "林 (リン)",
          "ja": "たまにぼんやりするけど",
          "tc": "不過她狩獵技巧很高超，",
          "sc": "不过她狩猎技巧很高超，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 401977,
          "spk": "林 (リン)",
          "ja": "一生懸命働くし……",
          "tc": "每次工作也都很賣力……",
          "sc": "每次工作也都很卖力……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 401988,
          "spk": "林 (リン)",
          "ja": "でも、判断する力がなくて……",
          "tc": "但她沒有判斷能力……",
          "sc": "但她没有判断能力……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 401995,
          "spk": "林 (リン)",
          "ja": "ちょっとしたことも決められずに",
          "tc": "連點芝麻小事都無法自己做決定，",
