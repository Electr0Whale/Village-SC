      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400342,
          "spk": "驹子 (コマコ)",
          "ja": "あぁ、これ？",
          "tc": "喔，這個嗎？",
          "sc": "喔，这个吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400349,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんの木こり道具だよ",
          "tc": "這是我哥的伐木工具。",
          "sc": "这是我哥的伐木工具。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 400356,
