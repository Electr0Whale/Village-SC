    {
      "file": "talk.dat",
      "rec_idx": 7081,
      "rec_id": "TALK_ID_70_2060_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400475,
          "spk": "驹子 (コマコ)",
          "ja": "……手入れの仕方なんだけどね",
          "tc": "……關於保養的方法……",
          "sc": "……关于保养的方法……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400486,
          "spk": "驹子 (コマコ)",
          "ja": "まずは汚れをしっかり落として、",
          "tc": "首先要把髒汙清理乾淨，",
          "sc": "首先要把脏污清理干净，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 400493,
          "spk": "驹子 (コマコ)",
          "ja": "それから……油を塗っていくんだ",
          "tc": "再來……要上油。",
          "sc": "再来……要上油。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 400502,
          "spk": "驹子 (コマコ)",
          "ja": "刃が錆びにくくなったり、",
          "tc": "這樣刀刃比較不容易生鏽，",
          "sc": "这样刀刃比较不容易生锈，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 400509,
          "spk": "驹子 (コマコ)",
          "ja": "柄のところが丈夫になるの",
          "tc": "握柄也會變得比較堅固。",
          "sc": "握柄也会变得比较坚固。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 400520,
          "spk": "驹子 (コマコ)",
          "ja": "あと、刃こぼれ……",
          "tc": "還有崩刃……",
          "sc": "还有崩刃……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 400527,
          "spk": "驹子 (コマコ)",
          "ja": "えっと、刃の部分が欠けてたら",
          "tc": "呃，就是刀刃有缺口的話，",
          "sc": "呃，就是刀刃有缺口的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 400534,
          "spk": "驹子 (コマコ)",
          "ja": "研いであげたりとか",
          "tc": "就要磨一磨之類的。",
          "sc": "就要磨一磨之类的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 400545,
          "spk": "驹子 (コマコ)",
          "ja": "時間はかかるけど、",
          "tc": "雖然保養很花時間，",
          "sc": "虽然保养很花时间，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 400552,
          "spk": "驹子 (コマコ)",
          "ja": "慣れてきたら楽しいんだ",
          "tc": "但習慣之後就滿有趣的。",
          "sc": "但习惯之后就满有趣的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 400563,
          "spk": "驹子 (コマコ)",
          "ja": "えーっと……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 400570,
          "spk": "驹子 (コマコ)",
          "ja": "それからね……",
          "tc": "接下來要……",
          "sc": "接下来要……"
        }
      ]
    },
    {
