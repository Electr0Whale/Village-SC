    {
      "file": "talk.dat",
      "rec_idx": 7085,
      "rec_id": "TALK_ID_70_2060_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400750,
          "spk": "六角 (ロッカク)",
          "ja": "はい、<player>さんはざるそばっスね",
          "tc": "好的，<player>點的是竹籠蕎麥麵。",
          "sc": "好的，<player>点的是竹笼荞麦面呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400765,
          "spk": "莲实 (ハスミ)",
          "ja": "私はカボチャの煮物でお願いします",
          "tc": "我要燉南瓜。",
          "sc": "我要炖南瓜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 400787,
          "spk": "堇怜 (スミレ)",
          "ja": "僕はピーマンの肉詰めで",
          "tc": "我要青椒鑲肉。",
          "sc": "我要青椒镶肉。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 400794,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコはどうする？",
          "tc": "駒子，妳呢？",
          "sc": "驹子，你呢？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 400809,
          "spk": "驹子 (コマコ)",
          "ja": "ええと、じゃあ……",
          "tc": "呃，那……",
          "sc": "呃，那……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 400816,
          "spk": "驹子 (コマコ)",
          "ja": "今日は、<player>と同じので",
          "tc": "我點跟<player>一樣的。",
          "sc": "我点跟<player>一样的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 400831,
          "spk": "六角 (ロッカク)",
          "ja": "了解っス！",
          "tc": "知道了！",
          "sc": "知道了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7086,
      "rec_id": "TALK_ID_70_2060_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400853,
          "spk": "莲实 (ハスミ)",
          "ja": "コマコってよく、",
          "tc": "駒子，",
          "sc": "驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400860,
          "spk": "莲实 (ハスミ)",
          "ja": "だれかと同じメニューを頼みますよね",
          "tc": "妳常常跟其他人點一樣的餐點呢。",
          "sc": "你常常跟其他人点一样的餐点呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 400875,
          "spk": "驹子 (コマコ)",
          "ja": "あ、うん",
          "tc": "啊，嗯。",
          "sc": "啊，嗯。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 400882,
          "spk": "驹子 (コマコ)",
          "ja": "自分じゃなかなか決められなくて……",
          "tc": "因為我老是無法自己做決定……",
          "sc": "因为我老是无法自己做决定……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 400889,
          "spk": "驹子 (コマコ)",
          "ja": "人に合わせたほうが楽だなって",
          "tc": "所以我覺得配合別人比較輕鬆。",
          "sc": "所以我觉得配合别人比较轻松。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 400902,
          "spk": "堇怜 (スミレ)",
          "ja": "それだと、あまり好きじゃないメニューを",
          "tc": "但是妳這麼做，",
          "sc": "但是你这么做，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 400909,
          "spk": "堇怜 (スミレ)",
          "ja": "頼んじゃうこともあるよね？",
          "tc": "會點到自己不太愛吃的吧？",
          "sc": "会点到自己不太爱吃的吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 400929,
          "spk": "驹子 (コマコ)",
          "ja": "あはは……たまにはね",
          "tc": "啊哈哈……偶爾會吧，",
          "sc": "啊哈哈……偶尔会吧，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 400936,
          "spk": "驹子 (コマコ)",
          "ja": "でも好き嫌いはそんなにないから",
          "tc": "但是我不怎麼挑食的。",
          "sc": "但是我不怎么挑食的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 400958,
          "spk": "莲实 (ハスミ)",
          "ja": "ふむ……ねえ、コマコ",
          "tc": "這樣啊……欸，駒子，",
          "sc": "这样啊……诶，驹子，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 400969,
          "spk": "莲实 (ハスミ)",
          "ja": "試しに、今一番食べたいものを",
          "tc": "妳要不要試試看",
          "sc": "你要不要试试看"
        },
        {
          "f_idx": 13,
          "pidx_tc": 400976,
          "spk": "莲实 (ハスミ)",
          "ja": "メニューから選んでみては？",
          "tc": "選一個現在最想吃的？",
          "sc": "选一个现在最想吃的？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 400996,
          "spk": "驹子 (コマコ)",
          "ja": "ええっ？",
          "tc": "咦咦？",
          "sc": "咦咦？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 401003,
          "spk": "驹子 (コマコ)",
          "ja": "でも、もう頼んじゃったし……",
          "tc": "可是我已經點餐了……",
          "sc": "可是我已经点餐了……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 401016,
          "spk": "莲实 (ハスミ)",
          "ja": "ちょっとしたお遊びですよ",
          "tc": "只是跟妳玩個小遊戲而已，",
          "sc": "只是跟你玩个小游戏而已，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 401023,
          "spk": "莲实 (ハスミ)",
          "ja": "もし自分で決めるなら……って",
          "tc": "就叫做「如果我要自己決定的話……」",
          "sc": "就叫做“如果我要自己决定的话……”"
        },
        {
          "f_idx": 19,
          "pidx_tc": 401030,
          "spk": "莲实 (ハスミ)",
          "ja": "やってみませんか？",
          "tc": "怎麼樣，要不要試試看？",
          "sc": "怎么样，要不要试试看？"
        },
        {
          "f_idx": 20,
          "pidx_tc": 401043,
          "spk": "驹子 (コマコ)",
          "ja": "わ、わかった……やってみるね",
          "tc": "好、好吧……那我試試看。",
          "sc": "好、好吧……那我试试看。"
        }
      ]
    },
    {
