          "f_idx": 3,
          "pidx_tc": 254875,
          "spk": "帷 (トバリ)",
          "ja": "ずっと吹いてるんだけど……",
          "tc": "「奇蹟的呼笛」……",
          "sc": "“奇迹的呼笛”……"
