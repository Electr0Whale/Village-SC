      "rec_id": "TALK_ID_10_0303_058_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 257030,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうどよかった！",
          "tc": "你來得正好！",
          "sc": "你来得正好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 257037,
          "spk": "驹子 (コマコ)",
          "ja": "今、お家まで行こうと思ってたんだ！",
          "tc": "我正打算去你家找你！",
          "sc": "我正打算去你家找你！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 257044,
          "spk": "驹子 (コマコ)",
          "ja": "キミに伝えたいことがあって……",
          "tc": "我有件事要告訴你……",
          "sc": "我有件事要告诉你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 257055,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんのお財布、ちゃんと見つけたよ",
          "tc": "名護先生的錢包順利找到了喔。",
          "sc": "名护先生的钱包顺利找到了哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 257066,
          "spk": "驹子 (コマコ)",
          "ja": "ヨウちゃんがね、山でお財布みたいなものを",
          "tc": "小洋說她在山裡看到狐狸",
          "sc": "小洋说她在山里看到狐狸"
        },
        {
          "f_idx": 5,
          "pidx_tc": 257073,
          "spk": "驹子 (コマコ)",
          "ja": "くわえたキツネを見たって、教えてくれたの",
          "tc": "叼著像錢包的東西。",
          "sc": "叼着像钱包的东西。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 257091,
          "spk": "驹子 (コマコ)",
          "ja": "今まで、山では見つからなかったんだけど、",
          "tc": "雖然之前都沒有在山裡找到，",
          "sc": "虽然之前都没有在山里找到，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 257098,
          "spk": "驹子 (コマコ)",
          "ja": "コダマの桃の樹がある場所は、",
          "tc": "但木珠的桃樹的那個地方還沒有找過……",
          "sc": "但木珠的桃树的那个地方还没有找过……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 257105,
          "spk": "驹子 (コマコ)",
          "ja": "まだ探してなかったから……行ってみたんだ",
          "tc": "所以我就去找看看，",
          "sc": "所以我就去找看看，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 257116,
          "spk": "驹子 (コマコ)",
          "ja": "ついでにコダマに会おうと思って、",
          "tc": "想說順便見一下木珠，",
          "sc": "想说顺便见一下木珠，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 257123,
          "spk": "驹子 (コマコ)",
          "ja": "夜中に行ったんだけど、",
          "tc": "於是就在半夜過去，",
          "sc": "于是就在半夜过去，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 257130,
          "spk": "驹子 (コマコ)",
          "ja": "その時に不思議なことが起きて……",
          "tc": "結果那時發生了不可思議的事情……",
          "sc": "结果那时发生了不可思议的事情……"
        }
      ]
    },
