      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4426,
      "rec_id": "TALK_ID_10_0302_036_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254910,
          "spk": "驹子 (コマコ)",
          "ja": "はぁ……はぁ……",
          "tc": "呼……呼……",
          "sc": "呼……呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254917,
          "spk": "驹子 (コマコ)",
          "ja": "どう、かな……",
          "tc": "怎麼、樣……？",
          "sc": "怎么、样……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 254928,
          "spk": "？？？ (未知角色)",
          "ja": "か、かわ、いそ……う",
          "tc": "好、好可、憐……",
          "sc": "好、好可、怜……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 254935,
          "spk": "？？？ (未知角色)",
          "ja": "いき、かえら、せて、、……",
          "tc": "復活、牠吧……",
          "sc": "复活、它吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4427,
      "rec_id": "TALK_ID_10_0302_036_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254953,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……もう、わかったから",
          "tc": "唉……好啦，知道了。",
          "sc": "唉……好啦，知道了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254960,
          "spk": "帷 (トバリ)",
          "ja": "アンタもうるさいお化けね……",
          "tc": "祢這妖怪還真吵耶……",
          "sc": "你这妖怪还真吵呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4428,
      "rec_id": "TALK_ID_10_0302_036_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254985,
          "spk": "帷 (トバリ)",
          "ja": "このままじゃ、コマコが息切れで",
          "tc": "再這樣下去，",
          "sc": "再这样下去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254992,
          "spk": "帷 (トバリ)",
          "ja": "倒れてしまうわ",
          "tc": "駒子會吹到缺氧暈倒的。",
          "sc": "驹子会吹到缺氧晕倒的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4429,
      "rec_id": "TALK_ID_10_0302_036_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255010,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も、「奇跡の呼笛」を",
          "tc": "<player>，你也可以試著吹一下",
          "sc": "<player>，你也可以试着吹一下"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255017,
          "spk": "驹子 (コマコ)",
          "ja": "試しに吹いてみてほしいんだけど、いいかな……",
          "tc": "「奇蹟的呼笛」嗎……？",
          "sc": "“奇迹的呼笛”吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4430,
      "rec_id": "TALK_ID_10_0302_036_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255035,
          "spk": "驹子 (コマコ)",
          "ja": "キミの方が、",
          "tc": "說不定",
          "sc": "说不定"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255042,
          "spk": "驹子 (コマコ)",
          "ja": "上手く吹けるかもしれないから……",
          "tc": "你會吹得比我更好……",
          "sc": "你会吹得比我更好……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4432,
      "rec_id": "TALK_ID_10_0302_036_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255071,
          "spk": "？？？ (未知角色)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4433,
      "rec_id": "TALK_ID_10_0302_036_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255095,
          "spk": "驹子 (コマコ)",
          "ja": "……だめ、みたいだね",
          "tc": "……看起來是不行。",
          "sc": "……看起来是不行。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255106,
          "spk": "？？？ (未知角色)",
          "ja": "い、いきか、、えら……せ",
          "tc": "復、復活……",
          "sc": "复、复活……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4434,
      "rec_id": "TALK_ID_10_0302_036_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255124,
          "spk": "帷 (トバリ)",
          "ja": "これ以上はもう、やめましょう",
          "tc": "到此為止吧，別再繼續了。",
          "sc": "到此为止吧，别再继续了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255131,
          "spk": "帷 (トバリ)",
          "ja": "死んだものが生き返るなんて",
          "tc": "想要復活已死之物，",
          "sc": "想要复活已死之物，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255138,
          "spk": "帷 (トバリ)",
          "ja": "やっぱり、どう考えてもありえない",
          "tc": "怎麼想都不可能實現啊。",
          "sc": "怎么想都不可能实现啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255149,
          "spk": "？？？ (未知角色)",
          "ja": "や、いや……いや、だ……",
          "tc": "不、不要……不要、啊……",
          "sc": "不、不要……不要、啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4435,
      "rec_id": "TALK_ID_10_0302_036_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255167,
          "spk": "驹子 (コマコ)",
          "ja": "だ、だめだよ、トバリ……",
          "tc": "不、不行啦，帷……",
          "sc": "不、不行啦，帷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255174,
          "spk": "驹子 (コマコ)",
          "ja": "歌は本当にあったんだし、もしかしたら……",
          "tc": "都真的有這首歌了，說不定復活也……",
          "sc": "都真的有这首歌了，说不定复活也……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4436,
      "rec_id": "TALK_ID_10_0302_036_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255192,
          "spk": "帷 (トバリ)",
          "ja": "そもそもコマコがヨウから頼まれたのは、",
          "tc": "說起來，駒子想要幫洋的，",
          "sc": "说起来，驹子想要帮洋的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255199,
          "spk": "帷 (トバリ)",
          "ja": "ニワトリの幽霊を",
          "tc": "應該只是想辦法解決",
          "sc": "应该只是想办法解决"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255206,
          "spk": "帷 (トバリ)",
          "ja": "なんとかすることだけだったんでしょ",
          "tc": "雞的幽靈而已吧。",
          "sc": "鸡的幽灵而已吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255217,
          "spk": "帷 (トバリ)",
          "ja": "この樹のお化けがごちゃごちゃ言うから、",
          "tc": "都是因為這棵樹的妖怪吵了一堆，",
          "sc": "都是因为这棵树的妖怪吵了一堆，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 255224,
          "spk": "帷 (トバリ)",
          "ja": "最初の目的を忘れて、",
          "tc": "才會忘記一開始的目的，",
          "sc": "才会忘记一开始的目的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 255231,
          "spk": "帷 (トバリ)",
          "ja": "無駄なことをさせられてるの",
          "tc": "跑來做些沒有意義的事。",
          "sc": "跑来做些没有意义的事。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 255244,
          "spk": "驹子 (コマコ)",
          "ja": "う……でも……",
          "tc": "唔……可是……",
          "sc": "唔……可是……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 255251,
          "spk": "驹子 (コマコ)",
          "ja": "もしかしたらって思って……",
          "tc": "一想到萬一真的有可能……",
          "sc": "一想到万一真的有可能……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 255264,
          "spk": "帷 (トバリ)",
          "ja": "そもそも、一度死んだニワトリが",
          "tc": "再說，一隻已經死過的雞",
          "sc": "再说，一只已经死过的鸡"
        },
        {
          "f_idx": 9,
          "pidx_tc": 255271,
          "spk": "帷 (トバリ)",
          "ja": "生き返って戻って来たって、",
          "tc": "就算復活回來了，",
          "sc": "就算复活回来了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 255278,
          "spk": "帷 (トバリ)",
          "ja": "みんな気持ち悪くて受け入れられないわ",
          "tc": "大家也會覺得噁心、無法接受。",
          "sc": "大家也会觉得恶心、无法接受。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 255289,
          "spk": "帷 (トバリ)",
          "ja": "ヨウは喜ぶかもしれないけど、",
          "tc": "洋或許會高興，",
          "sc": "洋或许会高兴，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 255296,
          "spk": "帷 (トバリ)",
          "ja": "リンが知ればもう一度殺してしまうでしょ",
          "tc": "但被林知道的話，會再殺死雞一次吧。",
          "sc": "但被林知道的话，会再杀死鸡一次吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 255316,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4437,
      "rec_id": "TALK_ID_10_0302_036_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255334,
          "spk": "帷 (トバリ)",
          "ja": "死んだものは生き返らない",
          "tc": "死者是不能復生的，",
          "sc": "死者是不能复生的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255345,
          "spk": "帷 (トバリ)",
          "ja": "もしそれができるなら、",
          "tc": "要是死者真的可以復生，",
          "sc": "要是死者真的可以复生，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255352,
          "spk": "帷 (トバリ)",
          "ja": "この村にあんなに広い墓地はないはずよ",
          "tc": "這村子就不會有那麼大一片墓地了。",
          "sc": "这村子就不会有那么大一片墓地了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255363,
          "spk": "？？？ (未知角色)",
          "ja": "……いや、",
          "tc": "……不要，",
          "sc": "……不要，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 255372,
          "spk": "？？？ (未知角色)",
          "ja": "いや、いやだ、いきか、え……らせ……",
          "tc": "不要，不要啊，快復、活……牠……",
          "sc": "不要，不要啊，快复、活……它……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4438,
      "rec_id": "TALK_ID_10_0302_036_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255390,
          "spk": "帷 (トバリ)",
          "ja": "全く、しつこい……",
          "tc": "受不了，真頑固……",
          "sc": "受不了，真顽固……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255397,
          "spk": "帷 (トバリ)",
          "ja": "アンタの思惑はもうわかってるんだから",
          "tc": "我已經看穿祢的盤算了。",
          "sc": "我已经看穿你的盘算了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255408,
          "spk": "帷 (トバリ)",
          "ja": "アンタが私たちに蘇らせたいのは、",
          "tc": "祢希望我們復活的，",
          "sc": "你希望我们复活的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255415,
          "spk": "帷 (トバリ)",
          "ja": "ニワトリじゃなくて、アンタ自身なんでしょう",
          "tc": "並不是雞，而是祢自己吧。",
          "sc": "并不是鸡，而是你自己吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 255426,
          "spk": "？？？ (未知角色)",
          "ja": "……あ、あぁ、、",
          "tc": "……啊、啊啊……",
          "sc": "……啊、啊啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4439,
      "rec_id": "TALK_ID_10_0302_036_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255444,
          "spk": "驹子 (コマコ)",
          "ja": "え……じゃ、じゃあ、このお化けはやっぱり、",
          "tc": "咦……那、那麼，這妖怪果然",
          "sc": "咦……那、那么，这妖怪果然"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255451,
          "spk": "驹子 (コマコ)",
          "ja": "元々生きていた人ってこと……？",
          "tc": "原本也是活著的人嗎……？",
          "sc": "原本也是活着的人吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255466,
          "spk": "帷 (トバリ)",
          "ja": "……この世界は、生きているモノの世界なの",
          "tc": "……這個世界是屬於生者的世界。",
          "sc": "……这个世界是属于生者的世界。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255475,
          "spk": "帷 (トバリ)",
          "ja": "アンタや、このニワトリが",
          "tc": "說到底，就算祢和這隻雞",
          "sc": "说到底，就算你和这只鸡"
        },
        {
          "f_idx": 4,
          "pidx_tc": 255482,
          "spk": "帷 (トバリ)",
          "ja": "都合よく生き返れたとしても、",
          "tc": "真的如願以償復活了，",
          "sc": "真的如愿以偿复活了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 255489,
          "spk": "帷 (トバリ)",
          "ja": "誰も受け入れてくれない",
          "tc": "也沒有人會接受祢們的。",
          "sc": "也没有人会接受你们的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 255500,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちの場所は、きっとこの村にはない",
          "tc": "這個村子裡，一定沒有屬於祢們的位置。",
          "sc": "这个村子里，一定没有属于你们的位置。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 255518,
          "spk": "？？？ (未知角色)",
          "ja": "い、や……いや……",
          "tc": "不、要……不要……",
          "sc": "不、要……不要……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 255525,
          "spk": "？？？ (未知角色)",
          "ja": "いやだ、いや、だ……",
          "tc": "不要啊、不要、啊……",
          "sc": "不要啊、不要、啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4440,
      "rec_id": "TALK_ID_10_0302_036_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255543,
          "spk": "驹子 (コマコ)",
          "ja": "と、トバリ……この子、また怒って……",
          "tc": "呃，帷……這棵樹、又開始生氣了……",
          "sc": "呃，帷……这棵树、又开始生气了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255550,
          "spk": "驹子 (コマコ)",
          "ja": "逃げたほうがいいかな……？",
          "tc": "是不是該快點逃跑了……？",
          "sc": "是不是该快点逃跑了……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 255561,
          "spk": "？？？ (未知角色)",
          "ja": "や、いや……いき、かえ……し……",
          "tc": "不、不要……快、復……活……",
          "sc": "不、不要……快、复……活……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 255570,
          "spk": "？？？ (未知角色)",
          "ja": "かえし、かえし……て……",
          "tc": "還、還給……我……",
          "sc": "还、还给……我……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 255583,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……いい加減にしてよ",
          "tc": "唉……給我適可而止吧。",
          "sc": "唉……给我适可而止吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 255590,
          "spk": "帷 (トバリ)",
          "ja": "そうやって癇癪を起こしても、もう怖くないから",
          "tc": "就算祢這樣鬧脾氣，我也已經不害怕了。",
          "sc": "就算你这样闹脾气，我也已经不害怕了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4441,
      "rec_id": "TALK_ID_10_0302_036_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 255615,
          "spk": "驹子 (コマコ)",
          "ja": "でも、このままじゃ私たち、",
          "tc": "可是，再這樣下去，",
          "sc": "可是，再这样下去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 255622,
          "spk": "驹子 (コマコ)",
