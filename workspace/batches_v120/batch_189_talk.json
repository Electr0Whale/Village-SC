          "tc": "幸好木珠是個能溝通的妖怪呢……",
          "sc": "幸好木珠是个能沟通的妖怪呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256496,
          "spk": "驹子 (コマコ)",
          "ja": "ピロもきっと、コダマのそばなら",
          "tc": "在木珠身邊的話，",
          "sc": "在木珠身边的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 256503,
          "spk": "驹子 (コマコ)",
          "ja": "安心して眠れるよ",
          "tc": "嗶羅一定也能安心長眠吧。",
          "sc": "哔罗一定也能安心长眠吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 256514,
          "spk": "驹子 (コマコ)",
          "ja": "私も眠るなら、",
          "tc": "如果是我的話，",
          "sc": "如果是我的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 256521,
          "spk": "驹子 (コマコ)",
          "ja": "こんな綺麗な樹の下がいいな……",
          "tc": "也會想睡在這麼漂亮的樹下……",
          "sc": "也会想睡在这么漂亮的树下……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4455,
      "rec_id": "TALK_ID_10_0302_038_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256554,
          "spk": "驹子 (コマコ)",
          "ja": "次は、ナゴさんのお財布だね",
          "tc": "再來該找名護先生的錢包了。",
          "sc": "再来该找名护先生的钱包了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256561,
          "spk": "驹子 (コマコ)",
          "ja": "頑張って探さないと……",
          "tc": "我們得努力尋找才行……",
          "sc": "我们得努力寻找才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4456,
      "rec_id": "TALK_ID_10_0302_039_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256585,
          "spk": "帷 (トバリ)",
          "ja": "はぁ、これでやっとお手伝い券が終わった……",
          "tc": "唉，這下終於把幫忙券用完了……",
          "sc": "唉，这下终于把帮忙券用完了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256592,
          "spk": "帷 (トバリ)",
          "ja": "解放されてせいせいする……",
          "tc": "無事一身輕，真爽快……",
          "sc": "无事一身轻，真爽快……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 256603,
          "spk": "帷 (トバリ)",
          "ja": "でも……結果的に、",
          "tc": "不過……就結果來說，",
          "sc": "不过……就结果来说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 256610,
          "spk": "帷 (トバリ)",
          "ja": "全て丸く収まってよかったわ",
          "tc": "一切都圓滿收場，真是太好了。",
          "sc": "一切都圆满收场，真是太好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4457,
      "rec_id": "TALK_ID_10_0302_039_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256636,
          "spk": "帷 (トバリ)",
          "ja": "……なに？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256643,
          "spk": "帷 (トバリ)",
          "ja": "私の顔に何かついてる？",
          "tc": "我臉上有什麼東西嗎？",
          "sc": "我脸上有什么东西吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 256652,
          "spk": "帷 (トバリ)",
          "ja": "ジロジロ見ないでくれる？",
          "tc": "別一直盯著我看好嗎？",
          "sc": "别一直盯着我看好吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4458,
      "rec_id": "TALK_ID_10_0302_040_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256672,
          "spk": "驹子 (コマコ)",
          "ja": "とにかくね、ピロはもう大丈夫だよ",
          "tc": "總之呢，嗶羅已經沒事了。",
          "sc": "总之呢，哔罗已经没事了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4459,
      "rec_id": "TALK_ID_10_0302_040_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256694,
          "spk": "驹子 (コマコ)",
          "ja": "すっごく綺麗な場所で、",
          "tc": "牠已經在一個非常漂亮的地方",
          "sc": "它已经在一个非常漂亮的地方"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256701,
          "spk": "驹子 (コマコ)",
          "ja": "眠りについたんだから",
          "tc": "長眠了。",
          "sc": "长眠了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4460,
      "rec_id": "TALK_ID_10_0302_040_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256717,
          "spk": "洋 (ヨウ)",
          "ja": "でも、もう会えないの、",
          "tc": "可是再也見不到嗶羅，",
          "sc": "可是再也见不到哔罗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256724,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱり寂しいよ",
          "tc": "還是覺得很寂寞啊……",
          "sc": "还是觉得很寂寞啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 256733,
          "spk": "洋 (ヨウ)",
          "ja": "せっかくできたお友達なのに……",
          "tc": "牠是我好不容易才交到的朋友……",
          "sc": "它是我好不容易才交到的朋友……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 256753,
          "spk": "驹子 (コマコ)",
          "ja": "そうだね……",
          "tc": "也是……",
          "sc": "也是……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 256760,
          "spk": "驹子 (コマコ)",
          "ja": "でも、一人で夜を彷徨うほうが",
          "tc": "不過，一直孤零零地在夜裡徘徊，",
          "sc": "不过，一直孤零零地在夜里徘徊，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 256767,
          "spk": "驹子 (コマコ)",
          "ja": "きっとピロも寂しいよ",
          "tc": "牠也會很寂寞呀。",
          "sc": "它也会很寂寞呀。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 256780,
          "spk": "洋 (ヨウ)",
          "ja": "そうなのかな……",
          "tc": "是這樣嗎……？",
          "sc": "是这样吗……？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 256791,
          "spk": "洋 (ヨウ)",
          "ja": "……ピロちゃんがそれでよかったなら、",
          "tc": "……如果嗶羅也覺得這樣比較好，",
          "sc": "……如果哔罗也觉得这样比较好，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 256798,
          "spk": "洋 (ヨウ)",
          "ja": "よかったのかも",
          "tc": "那也許這樣就好吧。",
          "sc": "那也许这样就好吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 256811,
          "spk": "驹子 (コマコ)",
          "ja": "ヨウちゃんも、お墓に一緒にお参りに行こう",
          "tc": "小洋以後也一起去掃墓吧。",
          "sc": "小洋以后也一起去扫墓吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 256818,
          "spk": "驹子 (コマコ)",
          "ja": "連れて行ってあげるから……",
          "tc": "我會幫妳帶路的……",
          "sc": "我会帮你带路的……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 256829,
          "spk": "驹子 (コマコ)",
          "ja": "そうだ！",
          "tc": "對了！",
          "sc": "对了！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 256836,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんが、お財布を",
          "tc": "名護先生的錢包",
          "sc": "名护先生的钱包"
        },
        {
          "f_idx": 14,
          "pidx_tc": 256843,
          "spk": "驹子 (コマコ)",
          "ja": "落としちゃったらしいんだ",
          "tc": "不見了對吧。",
          "sc": "不见了对吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4461,
      "rec_id": "TALK_ID_10_0302_040_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 256861,
          "spk": "洋 (ヨウ)",
          "ja": "探しているの？",
          "tc": "妳在幫忙找嗎？",
          "sc": "你在帮忙找吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 256872,
          "spk": "洋 (ヨウ)",
          "ja": "そういえばこの前、",
          "tc": "說起來，上次我在山上看到",
          "sc": "说起来，上次我在山上看到"
        },
        {
          "f_idx": 2,
          "pidx_tc": 256879,
          "spk": "洋 (ヨウ)",
          "ja": "山でキツネさんが、何かくわえてたけど……",
          "tc": "狐狸好像叼著什麼東西……",
          "sc": "狐狸好像叼着什么东西……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 256886,
          "spk": "洋 (ヨウ)",
          "ja": "もしかしたら……",
          "tc": "該不會就是……",
          "sc": "该不会就是……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 256899,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……キツネが……？",
          "tc": "咦……狐狸嗎……？",
          "sc": "咦……狐狸吗……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 256910,
          "spk": "驹子 (コマコ)",
          "ja": "良かった……キツネが持って逃げただけなら、",
          "tc": "那太好了……如果只是被狐狸叼走，",
          "sc": "那太好了……如果只是被狐狸叼走，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 256917,
          "spk": "驹子 (コマコ)",
          "ja": "お化けに怯えながら、夜に探さなくてすむよ……",
          "tc": "就不需要在晚上邊躲著妖怪邊找東西了……",
          "sc": "就不需要在晚上边躲着妖怪边找东西了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 256937,
          "spk": "洋 (ヨウ)",
          "ja": "……？",
          "tc": "……？",
          "sc": "……？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 256950,
          "spk": "驹子 (コマコ)",
          "ja": "あ、ううん、こっちの話だから気にしないで！",
          "tc": "啊，沒什麼，只是自言自語罷了，不用在意！",
          "sc": "啊，没什么，只是自言自语罢了，不用在意！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 256968,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんのお財布は、",
          "tc": "我會趁天還亮著，",
          "sc": "我会趁天还亮着，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 256975,
          "spk": "驹子 (コマコ)",
          "ja": "明るいうちに山で探すようにしてみるよ",
          "tc": "到山裡找找看名護先生的錢包。",
          "sc": "到山里找找看名护先生的钱包。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 256988,
          "spk": "洋 (ヨウ)",
          "ja": "うん、わたしも、見つけたら言うね",
          "tc": "嗯，我也會幫忙留意的，要是有看到就跟妳說。",
          "sc": "嗯，我也会帮忙留意的，要是看到了就跟你说。"
        }
      ]
    },
