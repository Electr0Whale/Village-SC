        },
        {
          "f_idx": 2,
          "pidx_tc": 254868,
          "spk": "帷 (トバリ)",
          "ja": "今、コマコが「奇跡の呼笛」を",
          "tc": "駒子已經吹了一陣子的",
          "sc": "驹子已经吹了一阵子的"
