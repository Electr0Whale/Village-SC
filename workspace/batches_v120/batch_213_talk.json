  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5408,
      "rec_id": "TALK_ID_10_0502_208_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312342,
          "spk": "堇怜 (スミレ)",
          "ja": "ありがとう！",
          "tc": "謝謝！",
          "sc": "谢谢！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312349,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>なら、手伝ってくれると思ったよ",
          "tc": "我就知道<player>你一定會願意幫忙的。",
          "sc": "我就知道<player>你一定会愿意帮忙的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312360,
          "spk": "堇怜 (スミレ)",
          "ja": "実は少し前、",
          "tc": "其實不久前，",
          "sc": "其实不久前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312367,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺に、傷を負わせてやったことがあるんだ",
          "tc": "我已經讓那隻鵺受傷了。",
          "sc": "我已经让那只鵺受伤了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312374,
          "spk": "堇怜 (スミレ)",
          "ja": "あの怪物、<strong>血は赤いんだぜ</strong>？",
          "tc": "那隻怪物的<strong>血是紅色的耶</strong>！",
          "sc": "那只怪物的<strong>血是红色的啊</strong>！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312385,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、ちゃんと",
          "tc": "所以我已經知道，",
          "sc": "所以我已经知道，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312392,
          "spk": "堇怜 (スミレ)",
          "ja": "武器で倒せるってことはわかってる",
          "tc": "用武器是可以打倒祂的。",
          "sc": "用武器是可以打倒他的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 312403,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、弓の腕は磨いてるよね？",
          "tc": "<player>，你應該有在練弓術吧？",
          "sc": "<player>，你应该有在练弓术吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 312410,
          "spk": "堇怜 (スミレ)",
          "ja": "深夜に弓を持って、あの場所……",
          "tc": "你晚上帶著弓，到那個地方……",
          "sc": "你晚上带着弓，到那个地方……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312417,
          "spk": "堇怜 (スミレ)",
          "ja": "峠のはずれ道に集合しよう！",
          "tc": "到隘口的岔路跟我會合吧！",
          "sc": "到隘口的岔路跟我会合吧！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 312428,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと提灯を用意してくるんだよ？",
          "tc": "要記得帶手提燈籠過來喔！",
          "sc": "要记得带手提灯笼过来哦！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 312435,
          "spk": "堇怜 (スミレ)",
          "ja": "いいね？",
          "tc": "知道了嗎？",
          "sc": "知道了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5409,
      "rec_id": "TALK_ID_10_0502_208_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312459,
          "spk": "堇怜 (スミレ)",
          "ja": "よし、約束だ",
          "tc": "好，就這麼說定了。",
          "sc": "好，就这么说定了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312466,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃ、また夜にね",
          "tc": "那晚上見囉。",
          "sc": "那晚上见啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5410,
      "rec_id": "TALK_ID_10_0502_209_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312490,
          "spk": "堇怜 (スミレ)",
          "ja": "あ！　<player>！",
          "tc": "啊！<player>！",
          "sc": "啊！<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312497,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと来てくれたんだ",
          "tc": "你依約過來了呢。",
          "sc": "你依约过来了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312508,
          "spk": "堇怜 (スミレ)",
          "ja": "ただ……せっかく来てくれたのに悪いんだけど、",
          "tc": "只是……雖然你都特地過來了，",
          "sc": "只是……虽然你都特地过来了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312515,
          "spk": "堇怜 (スミレ)",
          "ja": "今夜は諦めたほうがいいかもね",
          "tc": "抱歉，今晚可能還是放棄比較好。",
          "sc": "抱歉，今晚可能还是放弃比较好。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312533,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺は毎晩ここにいるわけじゃ",
          "tc": "鵺好像不是每天晚上",
          "sc": "鵺好像不是每天晚上"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312540,
          "spk": "堇怜 (スミレ)",
          "ja": "ないみたいなんだ",
          "tc": "都會出現在這裡。",
          "sc": "都会出现在这里。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 312551,
          "spk": "堇怜 (スミレ)",
          "ja": "会える夜と、",
          "tc": "同樣是夜晚，有些日子碰得到，",
          "sc": "同样是夜晚，有些日子碰得到，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 312558,
          "spk": "堇怜 (スミレ)",
          "ja": "会えない夜がある",
          "tc": "有些日子則碰不到。",
          "sc": "有些日子则碰不到。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312569,
          "spk": "堇怜 (スミレ)",
          "ja": "多分、今日は会えない日だね",
          "tc": "今天大概是見不到祂的日子。",
          "sc": "今天大概是见不到他的日子。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 312576,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなに探してるのに、",
          "tc": "我都找這麼久了，",
          "sc": "我都找这么久了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 312583,
          "spk": "堇怜 (スミレ)",
          "ja": "鳴き声すら聞こえないんだから",
          "tc": "卻連祂的叫聲都沒聽到。",
          "sc": "却连他的叫声都没听到。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 312594,
          "spk": "堇怜 (スミレ)",
          "ja": "悪いけど、別の日に出直そうか",
          "tc": "所以不好意思，我們改天再來好了。",
          "sc": "所以不好意思，我们改天再来好了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 312601,
          "spk": "堇怜 (スミレ)",
          "ja": "また夜中に、ここに集合しよう",
          "tc": "之後晚上再到這裡集合吧。",
          "sc": "之后晚上再到这里集合吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 312612,
          "spk": "堇怜 (スミレ)",
          "ja": "しばらく付き合ってもらうことに",
          "tc": "可能要麻煩你陪我一陣子了，",
          "sc": "可能要麻烦你陪我一阵子了，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 312619,
          "spk": "堇怜 (スミレ)",
          "ja": "なるかもしれないけど、よろしく",
          "tc": "再拜託你囉。",
          "sc": "再拜托你啦。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 312630,
          "spk": "堇怜 (スミレ)",
          "ja": "んじゃ、僕は帰るけど",
          "tc": "那我要回去了，",
          "sc": "那我要回去了，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 312637,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>はどうする？",
          "tc": "<player>你呢？",
          "sc": "<player>你呢？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 312646,
          "spk": "主角心声/旁白/选项",
          "ja": "かえる",
          "tc": "回去",
          "sc": "回去"
        },
        {
          "f_idx": 19,
          "pidx_tc": 312653,
          "spk": "主角心声/旁白/选项",
          "ja": "のこる",
          "tc": "留下來",
          "sc": "留下来"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5411,
      "rec_id": "TALK_ID_10_0502_210_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312742,
          "spk": "堇怜 (スミレ)",
          "ja": "わあっ！",
          "tc": "哇！",
          "sc": "哇！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312749,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>か",
          "tc": "原來是<player>啊。",
          "sc": "原来是<player>啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312756,
          "spk": "堇怜 (スミレ)",
          "ja": "驚かせないでよ",
          "tc": "別嚇人啦。",
          "sc": "别吓人啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312767,
          "spk": "堇怜 (スミレ)",
          "ja": "約束通り、",
          "tc": "你有遵守約定",
          "sc": "你有遵守约定"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312774,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと来てくれたんだね",
          "tc": "過來呢。",
          "sc": "过来呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5412,
      "rec_id": "TALK_ID_10_0502_210_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312792,
          "spk": "堇怜 (スミレ)",
          "ja": "それより……",
          "tc": "先不說這個了……",
          "sc": "先不说这个了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312799,
          "spk": "堇怜 (スミレ)",
          "ja": "さっきから声がするんだ",
          "tc": "我從剛才就一直聽到聲音。",
          "sc": "我从刚才就一直听到声音。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312806,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺じゃない幽霊かもしれない",
          "tc": "可能不是鵺，而是其他幽靈。",
          "sc": "可能不是鵺，而是其他幽灵。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5413,
      "rec_id": "TALK_ID_10_0502_210_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312824,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと怖いけど、",
          "tc": "雖然有點害怕，",
          "sc": "虽然有点害怕，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312831,
          "spk": "堇怜 (スミレ)",
          "ja": "肝試しに見に行ってみようぜ",
          "tc": "但我們就當作試膽大會去看看吧。",
          "sc": "但我们就当作试胆大会去看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5414,
      "rec_id": "TALK_ID_10_0502_210_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312862,
          "spk": "堇怜 (スミレ)",
          "ja": "……って、あれ？",
          "tc": "……呃，奇怪？",
          "sc": "……呃，奇怪？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312869,
          "spk": "堇怜 (スミレ)",
          "ja": "もしかして……",
          "tc": "難道說……",
          "sc": "难道说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5415,
      "rec_id": "TALK_ID_10_0502_210_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312893,
          "spk": "名护 (ナゴ)",
          "ja": "び、び、びっくりした！！！",
          "tc": "嚇、嚇、嚇死我了！！！",
          "sc": "吓、吓、吓死我了！！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312908,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだ、ナゴさんか",
          "tc": "什麼嘛，原來是名護哥，",
          "sc": "什么嘛，原来是名护哥，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312915,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなところに生きている人がいるなんて",
          "tc": "真沒想到這裡會有活人在。",
          "sc": "真没想到这里会有活人在。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312935,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんに、スミレくんも？",
          "tc": "是<player>和堇怜？",
          "sc": "是<player>和堇怜？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312942,
          "spk": "名护 (ナゴ)",
          "ja": "どうしてここに……？",
          "tc": "你們怎麼會在這裡……？",
          "sc": "你们怎么会在这里……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312955,
          "spk": "堇怜 (スミレ)",
          "ja": "それはこっちのセリフですよ",
          "tc": "我才想問你呢。",
          "sc": "我才想问你呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 312962,
          "spk": "堇怜 (スミレ)",
          "ja": "何してるんですか？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5416,
      "rec_id": "TALK_ID_10_0502_210_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312980,
          "spk": "名护 (ナゴ)",
          "ja": "ココに会いに来たんだ",
          "tc": "我是來見可可的，",
          "sc": "我是来见可可的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312987,
          "spk": "名护 (ナゴ)",
          "ja": "どうしても、また会いたくてね",
          "tc": "我真的很想再見到牠。",
          "sc": "我真的很想再见到它。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 313000,
          "spk": "堇怜 (スミレ)",
          "ja": "猫の幽霊……",
          "tc": "幽靈貓……",
          "sc": "幽灵猫……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 313007,
          "spk": "堇怜 (スミレ)",
          "ja": "その子がナゴさんのことを、",
          "tc": "就是這孩子把名護哥",
          "sc": "就是这孩子把名护哥"
        },
        {
          "f_idx": 4,
          "pidx_tc": 313014,
          "spk": "堇怜 (スミレ)",
          "ja": "引き留めてるんですね",
          "tc": "留在了村子裡對吧。",
          "sc": "留在了村子里对吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 313027,
          "spk": "名护 (ナゴ)",
          "ja": "そばにいてやりたいんだ……",
          "tc": "我想陪在牠身邊……",
          "sc": "我想陪在它身边……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 313034,
          "spk": "名护 (ナゴ)",
          "ja": "俺も、ココの毛を撫でた時の手触りを、",
          "tc": "因為我也一直忘不了",
          "sc": "因为我也一直忘不了"
        },
        {
          "f_idx": 7,
          "pidx_tc": 313041,
          "spk": "名护 (ナゴ)",
          "ja": "ずっと忘れられなかったから……",
          "tc": "以前撫摸牠時的那種觸感……",
          "sc": "以前抚摸它时的那种触感……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 313050,
          "spk": "名护 (ナゴ)",
          "ja": "どんな姿になったって、",
          "tc": "而且無論可可變成什麼模樣，",
          "sc": "而且无论可可变成什么模样，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 313057,
          "spk": "名护 (ナゴ)",
          "ja": "ココが俺の猫であることは変わりないから……",
          "tc": "牠也依舊是我的貓……",
          "sc": "它也依旧是我的猫……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5417,
      "rec_id": "TALK_ID_10_0502_210_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 313075,
          "spk": "名护 (ナゴ)",
          "ja": "キミたちも、",
          "tc": "你們也是",
          "sc": "你们也是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 313082,
          "spk": "名护 (ナゴ)",
          "ja": "死んでしまった誰かに会いに来たのか？",
          "tc": "來見已逝的對象嗎？",
          "sc": "来见已逝的对象吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 313095,
          "spk": "堇怜 (スミレ)",
          "ja": "別に",
          "tc": "不是，",
          "sc": "不是，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 313102,
          "spk": "堇怜 (スミレ)",
          "ja": "探検しに来ただけです",
          "tc": "我們只是來探險的。",
          "sc": "我们只是来探险的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 313115,
          "spk": "名护 (ナゴ)",
          "ja": "こんな時間に探検……？",
          "tc": "這種時間來探險……？",
          "sc": "这种时间来探险……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 313122,
          "spk": "名护 (ナゴ)",
          "ja": "ここは明らかに、普通の場所じゃないよ",
          "tc": "這裡擺明不是個普通地方，",
          "sc": "这里摆明不是个普通地方，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 313129,
          "spk": "名护 (ナゴ)",
          "ja": "来ないほうがいいと思うが……",
          "tc": "還是別來比較好吧……",
          "sc": "还是别来比较好吧……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 313138,
          "spk": "名护 (ナゴ)",
          "ja": "変な怪物が、現れるかもしれないんだ",
          "tc": "說不定會有奇怪的怪物跑出來。",
          "sc": "说不定会有奇怪的怪物跑出来。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 313158,
          "spk": "堇怜 (スミレ)",
          "ja": "「鵺」のことですね……？",
          "tc": "是在說「鵺」吧……？",
          "sc": "是在说“鵺”吧……？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 313165,
          "spk": "堇怜 (スミレ)",
          "ja": "僕たち、そいつに用があるんです",
          "tc": "我們就是在找那個怪物。",
          "sc": "我们就是在找那个怪物。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 313172,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は現れましたか？",
          "tc": "祂今天有出現嗎？",
          "sc": "他今天有出现吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 313185,
          "spk": "名护 (ナゴ)",
          "ja": "いや、見ていないが……",
          "tc": "不，我沒看到……",
          "sc": "不，我没看到……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 313192,
          "spk": "名护 (ナゴ)",
          "ja": "それより、今のは聞き捨てならないな",
          "tc": "比起這個，剛才的話我可不能當作沒聽見。",
          "sc": "比起这个，刚才的话我可不能当作没听见。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 313199,
          "spk": "名护 (ナゴ)",
          "ja": "危険な「鵺」とやらになんの用があるんだ？",
          "tc": "你們要找危險的「鵺」做什麼？",
          "sc": "你们要找危险的“鵺”做什么？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 313212,
          "spk": "堇怜 (スミレ)",
          "ja": "そんな心配しなくても大丈夫ですよ！",
          "tc": "你不用那麼擔心啦！",
          "sc": "你不用那么担心啦！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 313219,
          "spk": "堇怜 (スミレ)",
          "ja": "あいつは急いでどこかへ行くだけで、",
          "tc": "那傢伙只是急著去其他地方，",
          "sc": "那家伙只是急着去其他地方，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 313226,
          "spk": "堇怜 (スミレ)",
          "ja": "わざわざ人を襲ったりはしないから",
          "tc": "並不會刻意襲擊人。",
          "sc": "并不会刻意袭击人。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 313241,
          "spk": "名护 (ナゴ)",
          "ja": "だから大丈夫とは言えないだろう……",
          "tc": "就算那樣也稱不上安全吧……",
          "sc": "就算那样也称不上安全吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5418,
      "rec_id": "TALK_ID_10_0502_210_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 313259,
          "spk": "名护 (ナゴ)",
          "ja": "ココのことも心配だ……",
          "tc": "而且我也擔心可可……",
          "sc": "而且我也担心可可……"
