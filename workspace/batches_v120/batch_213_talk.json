          "pidx_tc": 313386,
          "spk": "堇怜 (スミレ)",
          "ja": "見当もつかないや",
          "tc": "我可是一點頭緒也沒有。",
          "sc": "我可是一点头绪也没有。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 313399,
          "spk": "名护 (ナゴ)",
          "ja": "ふむ……いる時といない時、か",
          "tc": "嗯……有時在，有時不在嗎……",
          "sc": "嗯……有时在，有时不在吗……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 313406,
          "spk": "名护 (ナゴ)",
          "ja": "何か理由が……？",
          "tc": "是不是有什麼原因……？",
          "sc": "是不是有什么原因……？"
        }
      ]
    },
