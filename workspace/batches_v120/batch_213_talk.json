    {
      "file": "talk.dat",
      "rec_idx": 5419,
      "rec_id": "TALK_ID_10_0502_210_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 313291,
          "spk": "名护 (ナゴ)",
          "ja": "……ついでに聞きたいんだが、",
          "tc": "……我想順便問問，",
          "sc": "……我想顺便问问，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 313298,
          "spk": "名护 (ナゴ)",
          "ja": "その……化け物「鵺」は",
          "tc": "那個……妖怪「鵺」",
          "sc": "那个……妖怪“鵺”"
        },
        {
          "f_idx": 2,
          "pidx_tc": 313305,
          "spk": "名护 (ナゴ)",
          "ja": "ずっとここにいるわけじゃないのか？",
          "tc": "並不會一直待在這裡嗎？",
          "sc": "并不会一直待在这里吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 313318,
          "spk": "堇怜 (スミレ)",
          "ja": "いる時といない時があるんですけど、",
          "tc": "祂有時在，有時不在，",
          "sc": "他有时在，有时不在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 313325,
          "spk": "堇怜 (スミレ)",
          "ja": "今日の峠は雷が鳴っていた……",
          "tc": "不過今天隘口有雷聲響起……",
          "sc": "不过今天隘口有雷声响起……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 313332,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、あいつはきっと現れるはず……",
          "tc": "所以，那傢伙肯定會出現才對……",
          "sc": "所以，那家伙肯定会出现才对……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 313345,
          "spk": "名护 (ナゴ)",
          "ja": "雷が鵺が現れる前兆なんだね？",
