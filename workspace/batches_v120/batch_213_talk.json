        },
        {
          "f_idx": 7,
          "pidx_tc": 313352,
          "spk": "名护 (ナゴ)",
          "ja": "しかし、いる日といない日があるのは不思議だな",
          "tc": "不過真奇妙，竟然有的日子在，有的日子不在。",
          "sc": "不过真奇妙，竟然有的日子在，有的日子不在。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 313359,
          "spk": "名护 (ナゴ)",
          "ja": "何か法則性があるのか？",
          "tc": "會不會有什麼規律呢？",
          "sc": "会不会有什么规律呢？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 313372,
          "spk": "堇怜 (スミレ)",
          "ja": "さあ……相手は化け物だしな……",
          "tc": "天曉得……畢竟祂是妖怪……",
          "sc": "天晓得……毕竟他是妖怪……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 313379,
          "spk": "堇怜 (スミレ)",
          "ja": "僕には、あいつが何を考えているのかなんて、",
