      "rec_id": "TALK_ID_70_2140_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419005,
          "spk": "莲实 (ハスミ)",
          "ja": "え、ええ？",
          "tc": "什、什麼？",
          "sc": "什、什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419012,
          "spk": "莲实 (ハスミ)",
          "ja": "それは……さすがに",
          "tc": "那……再怎麼說……",
          "sc": "那……再怎么说……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419019,
          "spk": "莲实 (ハスミ)",
          "ja": "恥ずかしいというか……",
          "tc": "也太丟人了……",
          "sc": "也太丢人了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419030,
          "spk": "莲实 (ハスミ)",
          "ja": "……いえ、迷っては駄目ですね",
          "tc": "……不行，我不能逃避！",
          "sc": "……不行，我不能逃避！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419037,
          "spk": "莲实 (ハスミ)",
          "ja": "そのくらいしなければ",
          "tc": "要是連這點程度都做不到，",
          "sc": "要是连这点程度都做不到，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 419044,
          "spk": "莲实 (ハスミ)",
          "ja": "変わろうと思えないですから",
          "tc": "想要改變根本是癡人說夢。",
          "sc": "想要改变根本是痴人说梦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7781,
      "rec_id": "TALK_ID_70_2140_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419064,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん",
          "tc": "<player>。",
          "sc": "<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419071,
          "spk": "莲实 (ハスミ)",
          "ja": "もしよければ、私の部屋に",
          "tc": "你不介意的話，",
          "sc": "你不介意的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419078,
          "spk": "莲实 (ハスミ)",
          "ja": "遊びに来てください",
          "tc": "請到我房間來玩吧。",
          "sc": "请到我房间来玩吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419089,
          "spk": "莲实 (ハスミ)",
          "ja": "でも……約束してください",
          "tc": "只不過……請答應我。",
          "sc": "只不过……请答应我。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419096,
          "spk": "莲实 (ハスミ)",
          "ja": "何を見ようと、決して引かないと……",
          "tc": "不論你看到什麼，都不會退縮……",
          "sc": "不论你看到什么，都不会退缩……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7782,
      "rec_id": "TALK_ID_70_2140_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419129,
          "spk": "莲实 (ハスミ)",
          "ja": "ちょうどいいところに、来てくれました",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419136,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、あれを見てください",
          "tc": "<player>，請看看那個。",
          "sc": "<player>，请看看那个。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7783,
      "rec_id": "TALK_ID_70_2140_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419160,
          "spk": "莲实 (ハスミ)",
          "ja": "私はここに、誓いを立てます",
          "tc": "我在此發誓，",
          "sc": "我在此发誓，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419178,
          "spk": "莲实 (ハスミ)",
          "ja": "今後はお酒の量を控えるようにと",
          "tc": "本人已經下定決心",
          "sc": "本人已经下定决心"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419185,
          "spk": "莲实 (ハスミ)",
          "ja": "一大決心を固めました！",
          "tc": "今後會控制飲酒量！",
          "sc": "今后会控制饮酒量！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7784,
      "rec_id": "TALK_ID_70_2140_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419209,
          "spk": "莲实 (ハスミ)",
          "ja": "……断酒！　と言えれば",
          "tc": "……雖然要是能說出要戒酒",
          "sc": "……虽然要是能说出要戒酒"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419216,
          "spk": "莲实 (ハスミ)",
          "ja": "よかったんですけどね",
          "tc": "就更好了呢。",
          "sc": "就更好了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419227,
          "spk": "莲实 (ハスミ)",
          "ja": "前々からチナナにたしなめられてましたし、",
          "tc": "很久之前琪娜娜就告誡過我了，",
          "sc": "很久之前琪娜娜就告诫过我了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419234,
          "spk": "莲实 (ハスミ)",
          "ja": "いい機会です",
          "tc": "剛好趁這個機會。",
          "sc": "刚好趁这个机会。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419243,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレが医者を目指しているという話も",
          "tc": "而且我也聽說",
          "sc": "而且我也听说"
        },
        {
          "f_idx": 5,
          "pidx_tc": 419250,
          "spk": "莲实 (ハスミ)",
          "ja": "耳にしたもので",
          "tc": "堇怜以後想要成為醫生，",
          "sc": "堇怜以后想要成为医生，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 419261,
          "spk": "莲实 (ハスミ)",
          "ja": "少しでも貯えを増やして",
          "tc": "所以我想多存一點積蓄，",
          "sc": "所以我想多存一点积蓄，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 419268,
          "spk": "莲实 (ハスミ)",
          "ja": "学費の足しにできればと考えたんです",
          "tc": "希望能用來補貼學費。",
          "sc": "希望能用来补贴学费。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 419279,
          "spk": "莲实 (ハスミ)",
          "ja": "……スミレにはこれまで、家計のことで",
          "tc": "……至今為止，",
          "sc": "……至今为止，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 419286,
          "spk": "莲实 (ハスミ)",
          "ja": "面倒をかけることも少なくありませんでした",
          "tc": "為了家計也給堇怜添了不少麻煩。",
          "sc": "为了家计也给堇怜添了不少麻烦。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 419304,
          "spk": "莲实 (ハスミ)",
          "ja": "今度は、私が助けになりたいんです",
          "tc": "所以這次換我來支持他了。",
          "sc": "所以这次换我来支持他了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7785,
      "rec_id": "TALK_ID_70_2140_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419335,
          "spk": "莲实 (ハスミ)",
          "ja": "……正直、こんな日が来るとは",
          "tc": "……老實說，",
          "sc": "……老实说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419342,
          "spk": "莲实 (ハスミ)",
          "ja": "思いませんでした",
          "tc": "我從沒想過會有這麼一天。",
          "sc": "我从没想过会有这么一天。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419353,
          "spk": "莲实 (ハスミ)",
          "ja": "どこか、諦めてたんです",
          "tc": "心裡早就不抱任何期望，",
          "sc": "心里早就不抱任何期望，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419360,
          "spk": "莲实 (ハスミ)",
          "ja": "たぶんこの先も、ズルズルと",
          "tc": "覺得未來多半也只會繼續",
          "sc": "觉得未来多半也只会继续"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419367,
          "spk": "莲实 (ハスミ)",
          "ja": "変わらない毎日を送り続けるだけだろうと",
          "tc": "過上一成不變的日子。",
          "sc": "过上一成不变的日子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 419378,
          "spk": "莲实 (ハスミ)",
          "ja": "……けど、変わったんです",
          "tc": "……然而，變化發生了。",
          "sc": "……然而，变化发生了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 419385,
          "spk": "莲实 (ハスミ)",
          "ja": "たぶんあなたが来た日を境に",
          "tc": "也許是從你到來的那天開始，",
          "sc": "也许是从你到来的那天开始，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 419396,
          "spk": "莲实 (ハスミ)",
          "ja": "これまでは、嫌なことがあると",
          "tc": "在這之前一旦遇到討厭的事，",
          "sc": "在这之前一旦遇到讨厌的事，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 419403,
          "spk": "莲实 (ハスミ)",
          "ja": "お酒を呑んで考えないようにしていましたが……",
          "tc": "我總是藉著喝酒盡可能不去思考……",
          "sc": "我总是藉着喝酒尽可能不去思考……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 419414,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、お酒に逃げなくても",
          "tc": "但似乎已經不需要",
          "sc": "但似乎已经不需要"
        },
        {
          "f_idx": 10,
          "pidx_tc": 419421,
          "spk": "莲实 (ハスミ)",
          "ja": "よさそうです",
          "tc": "再靠喝酒逃避了。",
          "sc": "再靠喝酒逃避了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 419430,
          "spk": "莲实 (ハスミ)",
          "ja": "これからは、楽しむために",
          "tc": "從今以後，",
          "sc": "从今以后，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 419437,
          "spk": "莲实 (ハスミ)",
          "ja": "お酒を呑むようにしたいですね",
          "tc": "希望能把喝酒當作一種享受呢。",
          "sc": "希望能把喝酒当作一种享受呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 419448,
          "spk": "莲实 (ハスミ)",
          "ja": "……私は嫌なことから目を背け",
          "tc": "……一直以來每當遇到討厭的事，",
          "sc": "……一直以来每当遇到讨厌的事，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 419455,
          "spk": "莲实 (ハスミ)",
          "ja": "逃げ続けてきました",
          "tc": "我都會選擇逃避。",
          "sc": "我都会选择逃避。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 419466,
          "spk": "莲实 (ハスミ)",
          "ja": "辛いことから、すぐに逃避してしまう……",
          "tc": "遇到痛苦的事情就立刻逃走……",
          "sc": "遇到痛苦的事情就立刻逃走……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 419473,
          "spk": "莲实 (ハスミ)",
          "ja": "そんな、弱い自分が嫌になります……",
          "tc": "我很討厭那麼軟弱的自己……",
          "sc": "我很讨厌那么软弱的自己……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 419480,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんは、逃げたりしないんでしょう？",
          "tc": "<player>你不會逃避對吧？",
          "sc": "<player>你不会逃避对吧？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 419489,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 19,
          "pidx_tc": 419496,
          "spk": "主角心声/旁白/选项",
          "ja": "にげる",
          "tc": "我會逃",
          "sc": "我会逃"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7786,
      "rec_id": "TALK_ID_70_2140_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419582,
          "spk": "莲实 (ハスミ)",
          "ja": "……長い間、過去にとらわれ",
          "tc": "……長久以來，我都無法擺脫過去，",
          "sc": "……长久以来，我都无法摆脱过去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419589,
          "spk": "莲实 (ハスミ)",
          "ja": "後悔するだけの日々を過ごしてきました",
          "tc": "過著只有後悔的日子。",
          "sc": "过着只有后悔的日子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419600,
          "spk": "莲实 (ハスミ)",
          "ja": "けど、ようやく",
          "tc": "然而，如今似乎終於",
          "sc": "然而，如今似乎终于"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419607,
          "spk": "莲实 (ハスミ)",
          "ja": "前を向いて歩きだせそうです",
          "tc": "可以向前邁進了。",
          "sc": "可以向前迈进了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419618,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレや<player>さんが",
          "tc": "不曉得堇怜和<player>",
          "sc": "不晓得堇怜和<player>"
        },
        {
          "f_idx": 5,
          "pidx_tc": 419625,
          "spk": "莲实 (ハスミ)",
          "ja": "どんな素晴らしい大人へと",
          "tc": "長大成人之後",
          "sc": "长大成人之后"
        },
        {
          "f_idx": 6,
          "pidx_tc": 419632,
          "spk": "莲实 (ハスミ)",
          "ja": "成長していくのか……",
          "tc": "會有多麼出色呢……",
          "sc": "会有多么出色呢……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 419643,
          "spk": "莲实 (ハスミ)",
          "ja": "明るい未来を夢見て",
          "tc": "抱持著對美好未來的想望──",
          "sc": "抱持着对美好未来的想望——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 419650,
          "spk": "莲实 (ハスミ)",
          "ja": "私もしっかりした大人に",
          "tc": "我也必須成為一個",
          "sc": "我也必须成为一个"
        },
        {
          "f_idx": 9,
          "pidx_tc": 419657,
          "spk": "莲实 (ハスミ)",
          "ja": "ならないといけませんよね",
          "tc": "像樣的大人才行呢。",
          "sc": "像样的大人才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7787,
      "rec_id": "TALK_ID_70_2140_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419683,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419690,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいところに来たね",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419705,
          "spk": "莲实 (ハスミ)",
          "ja": "これから飲み会をするんですけど",
          "tc": "我們準備一起小酌一下，",
          "sc": "我们准备一起小酌一下，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419712,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも、ご一緒しませんか？",
          "tc": "<player>要不要也加入呢？",
          "sc": "<player>要不要也加入呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7788,
      "rec_id": "TALK_ID_70_2140_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419732,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうそう、そうこなくっちゃ",
          "tc": "很好，這樣才對嘛。",
          "sc": "很好，这样才对嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419743,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミがお酒を控えていたみたいだし",
          "tc": "看到蓮實有在控制酒量，",
          "sc": "看到莲实有在控制酒量，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419750,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご褒美として、お酒を差し入れに来たんだよ",
          "tc": "所以我帶了酒來當作獎勵呢。",
          "sc": "所以我带了酒来当作奖励呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7789,
      "rec_id": "TALK_ID_70_2140_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419777,
          "spk": "堇怜 (スミレ)",
          "ja": "……矛盾してませんか？",
          "tc": "……這不是很矛盾嗎？",
          "sc": "……这不是很矛盾吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7790,
      "rec_id": "TALK_ID_70_2140_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419795,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいのいいの",
          "tc": "沒關係沒關係～",
          "sc": "没关系没关系～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419802,
          "spk": "琪娜娜 (チナナ)",
          "ja": "楽しいお酒なら、少しくらいはさ",
          "tc": "只要開心，喝一點也無妨啦。",
          "sc": "只要开心，喝一点也无妨啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7791,
      "rec_id": "TALK_ID_70_2140_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419820,
