      "rec_id": "TALK_ID_70_2110_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382467,
          "spk": "洋 (ヨウ)",
          "ja": "お魚はね、",
          "tc": "據說吃魚的時候，",
          "sc": "据说吃鱼的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382474,
          "spk": "洋 (ヨウ)",
          "ja": "そこは食べずに残すのが作法なんだって",
          "tc": "把內臟剩下來不吃才符合禮儀喔。",
          "sc": "把内脏剩下来不吃才符合礼仪哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 382485,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも前は知らなくて、",
          "tc": "我以前也不知道這件事，",
          "sc": "我以前也不知道这件事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 382492,
          "spk": "洋 (ヨウ)",
          "ja": "大人はこんなの食べるんだって",
          "tc": "還很驚訝大人竟然",
          "sc": "还很惊讶大人竟然"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382499,
          "spk": "洋 (ヨウ)",
          "ja": "驚いていたんだけど",
          "tc": "會吃這種東西。",
          "sc": "会吃这种东西。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 382510,
          "spk": "洋 (ヨウ)",
          "ja": "お魚を食べる時はね",
          "tc": "吃魚的時候呢，",
          "sc": "吃鱼的时候呢，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 382517,
          "spk": "洋 (ヨウ)",
          "ja": "こうやって……背中のほうから",
          "tc": "要像這樣……從背部開始取下魚肉，",
          "sc": "要像这样……从背部开始取下鱼肉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 382524,
          "spk": "洋 (ヨウ)",
          "ja": "身を取っていくときれいに食べられるよ",
          "tc": "就能吃得很乾淨喔。",
          "sc": "就能吃得很干净哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 382535,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも、サザンカさんに教えてもらったの",
          "tc": "我也是茶梅姐姐教我才學會的。",
          "sc": "我也是茶梅姐姐教我才学会的。"
        }
      ]
    },
    {
      "file": "talk.dat",
