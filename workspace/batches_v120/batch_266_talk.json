  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7561,
      "rec_id": "TALK_ID_70_2110_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381155,
          "spk": "洋 (ヨウ)",
          "ja": "えへへ……",
          "tc": "嘿嘿……",
          "sc": "嘿嘿……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381162,
          "spk": "洋 (ヨウ)",
          "ja": "いっぱい遊んじゃったね",
          "tc": "玩得好過癮喔。",
          "sc": "玩得好过瘾哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381169,
          "spk": "洋 (ヨウ)",
          "ja": "こんなにはしゃいだの、初めてかも",
          "tc": "我說不定是第一次玩得這麼開心。",
          "sc": "我说不定是第一次玩得这么开心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381180,
          "spk": "洋 (ヨウ)",
          "ja": "でも……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381187,
          "spk": "洋 (ヨウ)",
          "ja": "そろそろおじちゃんが心配するから、帰るね",
          "tc": "再玩下去叔叔會擔心的，我先回去了喔！",
          "sc": "再玩下去叔叔会担心的，我先回去了哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381198,
          "spk": "洋 (ヨウ)",
          "ja": "今日はありがとう、<player>",
          "tc": "今天真的謝謝你，<player>。",
          "sc": "今天真的谢谢你，<player>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 381205,
          "spk": "洋 (ヨウ)",
          "ja": "また、明日ね",
          "tc": "明天見喔！",
          "sc": "明天见哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7562,
      "rec_id": "TALK_ID_70_2110_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381229,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381236,
          "spk": "洋 (ヨウ)",
          "ja": "来てくれたんだね",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381247,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが、ご飯の用意してくれてるよ",
          "tc": "叔叔正在幫我們準備飯菜，",
          "sc": "叔叔正在帮我们准备饭菜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381254,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんとお腹すかせて来てくれたよね",
          "tc": "你有空著肚子來吧。",
          "sc": "你有空着肚子来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7563,
      "rec_id": "TALK_ID_70_2110_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381278,
          "spk": "洋 (ヨウ)",
          "ja": "見てみて、今日はカレーなんだよ",
          "tc": "快看看，今天吃咖哩喔。",
          "sc": "快看看，今天吃咖喱哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381285,
          "spk": "洋 (ヨウ)",
          "ja": "わたしね、この「おこさまカレー」大好きなの",
          "tc": "我很喜歡這個「兒童咖哩」喔！",
          "sc": "我很喜欢这个“儿童咖喱”哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7564,
      "rec_id": "TALK_ID_70_2110_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381303,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、わたしの分は牛乳を入れてくれるの",
          "tc": "叔叔另外幫我加了牛奶。",
          "sc": "叔叔另外帮我加了牛奶。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381310,
          "spk": "洋 (ヨウ)",
          "ja": "熱くなくなるし、辛くなくなるし、",
          "tc": "這樣就不燙，也不辣了，",
          "sc": "这样就不烫，也不辣了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381317,
          "spk": "洋 (ヨウ)",
          "ja": "まろやかになるんだよ",
          "tc": "味道變得很順口喔。",
          "sc": "味道变得很顺口哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381328,
          "spk": "洋 (ヨウ)",
          "ja": "お代わりもあるからね",
          "tc": "因為準備了很多，",
          "sc": "因为准备了很多，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381335,
          "spk": "洋 (ヨウ)",
          "ja": "<player>もいっぱい食べてね",
          "tc": "<player>可以盡量多吃一點喔。",
          "sc": "<player>可以尽量多吃一点哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381344,
          "spk": "主角心声/旁白/选项",
          "ja": "甘い",
          "tc": "好甜",
          "sc": "好甜"
        },
        {
          "f_idx": 6,
          "pidx_tc": 381351,
          "spk": "主角心声/旁白/选项",
          "ja": "美味しい",
          "tc": "好吃",
          "sc": "好吃"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7565,
      "rec_id": "TALK_ID_70_2110_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381534,
          "spk": "洋 (ヨウ)",
          "ja": "このカレーが気に入ったなら、",
          "tc": "如果你喜歡這個咖哩的話，",
          "sc": "如果你喜欢这个咖喱的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381541,
          "spk": "洋 (ヨウ)",
          "ja": "いつでも食べに来ていいからね",
          "tc": "隨時都可以來吃喔。",
          "sc": "随时都可以来吃哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381552,
          "spk": "洋 (ヨウ)",
          "ja": "おこさまカレーはお店のメニューにはない",
          "tc": "雖然兒童咖哩不在店裡的菜單上，",
          "sc": "虽然儿童咖喱不在店里的菜单上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381559,
          "spk": "洋 (ヨウ)",
          "ja": "特別なお料理なんだけど……",
          "tc": "是道特別的料理……",
          "sc": "是道特别的料理……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381570,
          "spk": "洋 (ヨウ)",
          "ja": "<player>がお願いすれば、",
          "tc": "但只要<player>說想吃，",
          "sc": "但只要<player>说想吃，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381577,
          "spk": "洋 (ヨウ)",
          "ja": "きっと作ってくれると思うから",
          "tc": "我想叔叔一定會幫你做的。",
          "sc": "我想叔叔一定会帮你做的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7566,
      "rec_id": "TALK_ID_70_2110_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381597,
          "spk": "六角 (ロッカク)",
          "ja": "これ、一応鍋物っスから",
          "tc": "這姑且算是燉煮料理，",
          "sc": "这姑且算是炖煮料理，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381604,
          "spk": "六角 (ロッカク)",
          "ja": "前日から言っといてくれないと出ませんけどねー",
          "tc": "沒有前一天先講可做不出來喔～",
          "sc": "没有前一天先讲可做不出来呐～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381624,
          "spk": "洋 (ヨウ)",
          "ja": "え、そうなんだ",
          "tc": "咦，是這樣嗎？",
          "sc": "咦，是这样吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381631,
          "spk": "洋 (ヨウ)",
          "ja": "でも、わたしの時は",
          "tc": "但我想吃的時候，",
          "sc": "但我想吃的时候，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381638,
          "spk": "洋 (ヨウ)",
          "ja": "食べたい時に出てくるよ？",
          "tc": "都會立刻端出來啊？",
          "sc": "都会立刻端出来啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 381651,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんの場合、一週間に一度は",
          "tc": "洋妹妹的話，",
          "sc": "洋妹妹的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 381658,
          "spk": "六角 (ロッカク)",
          "ja": "カレーが食べたいって言うじゃないっスか",
          "tc": "通常每週至少會說一次想吃咖哩吧？",
          "sc": "通常每周至少会说一次想吃咖喱吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 381665,
          "spk": "六角 (ロッカク)",
          "ja": "だから、一食分の材料は用意してあるんスよ",
          "tc": "所以我都有準備好一人份的材料。",
          "sc": "所以我都有准备好一人份的材料。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 381678,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、<player>がおこさまカレーを",
          "tc": "那<player>想吃兒童咖哩的時候，",
          "sc": "那<player>想吃儿童咖喱的时候，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 381685,
          "spk": "洋 (ヨウ)",
          "ja": "食べたくなったら、いってね",
          "tc": "就跟我說吧。",
          "sc": "就跟我说吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 381694,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがおじちゃんに、お願いしてあげるから",
          "tc": "我會幫你拜託叔叔的。",
          "sc": "我会帮你拜托叔叔的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 381714,
          "spk": "六角 (ロッカク)",
          "ja": "せめて、週一でお願いするっス……",
          "tc": "拜託一週一次就好……",
          "sc": "拜托一周一次就好……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7567,
      "rec_id": "TALK_ID_70_2110_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381747,
          "spk": "洋 (ヨウ)",
          "ja": "<player>！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381754,
          "spk": "洋 (ヨウ)",
          "ja": "やっと来てくれた！",
          "tc": "你終於來了！",
          "sc": "你终于来了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381765,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが「牛乳寒天」を作ってくれたの",
          "tc": "叔叔做了「牛奶寒天凍」給我，",
          "sc": "叔叔做了“牛奶寒天冻”给我，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381772,
          "spk": "洋 (ヨウ)",
          "ja": "<player>が来るまで待ってたんだよ",
          "tc": "我一直在等<player>你來！",
          "sc": "我一直在等<player>你来！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381779,
          "spk": "洋 (ヨウ)",
          "ja": "一緒に食べようね",
          "tc": "一起吃吧。",
          "sc": "一起吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7568,
      "rec_id": "TALK_ID_70_2110_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381803,
          "spk": "洋 (ヨウ)",
          "ja": "……甘くて、美味しいね",
          "tc": "……甜甜的，真好吃。",
          "sc": "……甜甜的，真好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381810,
          "spk": "洋 (ヨウ)",
          "ja": "あ、今日はミカンが入ってるんだ",
          "tc": "啊，今天還放了橘子耶。",
          "sc": "啊，今天还放了橘子呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381821,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、牛乳寒天、大好きなの",
          "tc": "我很喜歡吃牛奶寒天凍。",
          "sc": "我很喜欢吃牛奶寒天冻。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381828,
          "spk": "洋 (ヨウ)",
          "ja": "だって、優しい味がするでしょう？",
          "tc": "不覺得味道吃起來很溫柔嗎？",
          "sc": "不觉得味道吃起来很温柔吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381837,
          "spk": "主角心声/旁白/选项",
          "ja": "優しい？",
          "tc": "溫柔的味道？",
          "sc": "温柔的味道？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381844,
          "spk": "主角心声/旁白/选项",
          "ja": "どうして？",
          "tc": "為什麼？",
          "sc": "为什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7569,
      "rec_id": "TALK_ID_70_2110_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382098,
          "spk": "洋 (ヨウ)",
          "ja": "ご馳走様でした",
          "tc": "我吃飽了。",
          "sc": "我吃饱了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382109,
          "spk": "洋 (ヨウ)",
          "ja": "それじゃ、わたしはお外に行くけど……",
          "tc": "那我要出去外面玩了……",
          "sc": "那我要出去外面玩了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 382116,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はどうするの？",
          "tc": "<player>有要做什麼嗎？",
          "sc": "<player>有要做什么吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 382127,
          "spk": "洋 (ヨウ)",
          "ja": "えっと、もし暇だったら……",
          "tc": "那個，如果沒事的話……",
          "sc": "那个，如果没事的话……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382134,
          "spk": "洋 (ヨウ)",
          "ja": "今日も、一緒に遊んでくれると嬉しいな",
          "tc": "要是今天也能一起玩，我會很高興的。",
          "sc": "要是今天也能一起玩，我会很高兴的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7570,
      "rec_id": "TALK_ID_70_2110_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382158,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、いらっしゃい",
          "tc": "<player>，歡迎光臨！",
          "sc": "<player>，欢迎光临！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382165,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんがお魚、",
          "tc": "聽叔叔說，",
          "sc": "听叔叔说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 382172,
          "spk": "洋 (ヨウ)",
          "ja": "いっぱい仕入れてきたんだって",
          "tc": "他買到了很多魚喔。",
          "sc": "他买到了很多鱼哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 382183,
          "spk": "洋 (ヨウ)",
          "ja": "これから、たくさん焼いてくれるよ",
          "tc": "等等好像要拿很多來烤，",
          "sc": "等等好像要拿很多来烤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382190,
          "spk": "洋 (ヨウ)",
          "ja": "楽しみだね",
          "tc": "真令人期待。",
          "sc": "真令人期待。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7571,
      "rec_id": "TALK_ID_70_2110_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382214,
          "spk": "洋 (ヨウ)",
          "ja": "このお魚はね、ヤマメっていうの",
          "tc": "這種魚啊，叫做山女魚。",
          "sc": "这种鱼啊，叫做山女鱼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382221,
          "spk": "洋 (ヨウ)",
          "ja": "塩焼きにすると、とっても美味しいんだよ",
          "tc": "用鹽烤會非常好吃喔！",
          "sc": "用盐烤会非常好吃哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 382239,
          "spk": "洋 (ヨウ)",
          "ja": "……骨を除けるのが、",
          "tc": "……雖然挑魚刺",
          "sc": "……虽然挑鱼刺"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382246,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ大変だけど",
          "tc": "有一點點麻煩。",
          "sc": "有一点点麻烦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 382257,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はお魚、好き？",
          "tc": "<player>喜歡吃魚嗎？",
          "sc": "<player>喜欢吃鱼吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 382266,
          "spk": "主角心声/旁白/选项",
          "ja": "好き",
          "tc": "喜歡",
          "sc": "喜欢"
        },
        {
          "f_idx": 7,
          "pidx_tc": 382273,
          "spk": "主角心声/旁白/选项",
          "ja": "苦手",
          "tc": "不喜歡",
          "sc": "不喜欢"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7572,
      "rec_id": "TALK_ID_70_2110_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382438,
          "spk": "洋 (ヨウ)",
          "ja": "どうしたの？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382449,
          "spk": "洋 (ヨウ)",
          "ja": "あ、ハラワタ食べちゃったんだね",
          "tc": "啊，你吃到內臟了啊。",
