      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 216401,
          "spk": "六角 (ロッカク)",
          "ja": "リンさん、ヨウさん連れてきたっスよ",
          "tc": "林小姐，我把洋妹妹帶來了。",
          "sc": "林小姐，我把洋妹妹带来哟。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216408,
          "spk": "六角 (ロッカク)",
          "ja": "……願わくば、ほんの少しお手柔らかに",
          "tc": "……但願妳能稍微手下留情。",
          "sc": "……但愿你能稍微手下留情。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216415,
          "spk": "六角 (ロッカク)",
          "ja": "お願いしたいっスけど",
          "tc": "拜託了。",
          "sc": "拜托呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 216428,
          "spk": "林 (リン)",
          "ja": "ありがとう、ロッカク",
          "tc": "謝謝你，六角。",
          "sc": "谢谢你，六角。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 216435,
          "spk": "林 (リン)",
          "ja": "でも、これは大事なことなの",
          "tc": "不過，這件事很重要，",
          "sc": "不过，这件事很重要，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 216442,
          "spk": "林 (リン)",
          "ja": "しっかり彼女に言い聞かせておかないとね……",
          "tc": "我得好好跟她說清楚才行……",
          "sc": "我得好好跟她说清楚才行……"
        }
      ]
    },
