      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 216502,
          "spk": "林 (リン)",
          "ja": "……ヨウ",
          "tc": "……洋。",
          "sc": "……洋。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216513,
          "spk": "洋 (ヨウ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216526,
          "spk": "林 (リン)",
          "ja": "ヨウ、あなたは掟を覚えている？",
          "tc": "洋，妳還記得規矩嗎？",
          "sc": "洋，你还记得规矩吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 216544,
          "spk": "洋 (ヨウ)",
          "ja": "掟の一……",
          "tc": "規矩之一……",
          "sc": "规矩之一……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 216551,
          "spk": "洋 (ヨウ)",
          "ja": "午後十一時以降外出禁止……",
          "tc": "夜間十一點後禁止外出……",
          "sc": "夜间十一点后禁止外出……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 216564,
          "spk": "林 (リン)",
          "ja": "残念だわ……",
          "tc": "我很遺憾……",
          "sc": "我很遗憾……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 216571,
          "spk": "林 (リン)",
          "ja": "あなたの行動が、",
          "tc": "妳的行為，",
          "sc": "你的行为，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 216578,
          "spk": "林 (リン)",
          "ja": "村の皆を危険に晒すのに",
          "tc": "會讓村子裡的大家都陷入危險。",
          "sc": "会让村子里的大家都陷入危险。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 216591,
          "spk": "洋 (ヨウ)",
          "ja": "……ごめんなさい",
          "tc": "……對不起。",
          "sc": "……对不起。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 216598,
          "spk": "洋 (ヨウ)",
          "ja": "わたし……",
          "tc": "我……",
          "sc": "我……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 216609,
          "spk": "洋 (ヨウ)",
          "ja": "……でも",
          "tc": "……可是，",
          "sc": "……可是，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 216616,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃんが、死んじゃうなんて……",
          "tc": "嗶羅居然會死掉……",
          "sc": "哔罗居然会死掉……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 216636,
          "spk": "林 (リン)",
          "ja": "まだ死体は見つかってないわ",
          "tc": "還沒發現屍體，",
          "sc": "还没发现尸体，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 216643,
          "spk": "林 (リン)",
          "ja": "死んだとは限らない",
          "tc": "所以不能斷定已經死了。",
          "sc": "所以不能断定已经死了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3830,
      "rec_id": "TALK_ID_10_0102_050_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 216661,
          "spk": "洋 (ヨウ)",
          "ja": "……じゃ、じゃあ！",
          "tc": "……那、那麼！",
          "sc": "……那、那么！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216668,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、さがしに……",
          "tc": "我要去、找……",
          "sc": "我要去、找……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216681,
          "spk": "林 (リン)",
          "ja": "……ヨウ、",
          "tc": "……洋，",
          "sc": "……洋，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 216688,
          "spk": "林 (リン)",
          "ja": "掟の七を言ってみなさい",
          "tc": "複誦一次規矩之七。",
          "sc": "复诵一次规矩之七。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 216701,
          "spk": "洋 (ヨウ)",
          "ja": "……掟の七、",
          "tc": "……規矩之七，",
          "sc": "……规矩之七，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 216708,
          "spk": "洋 (ヨウ)",
          "ja": "失った物を探すな……",
          "tc": "別尋找遺失的物品……",
          "sc": "别寻找遗失的物品……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 216721,
          "spk": "林 (リン)",
          "ja": "意味は分かるでしょう？",
          "tc": "妳懂這是什麼意思吧？",
          "sc": "你懂这是什么意思吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 216728,
          "spk": "林 (リン)",
          "ja": "それとも、また掟を破るつもり？",
          "tc": "還是說，妳打算再次打破規矩？",
          "sc": "还是说，你打算再次打破规矩？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 216739,
          "spk": "洋 (ヨウ)",
          "ja": "……破らないよ",
          "tc": "……我不會了。",
          "sc": "……我不会了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 216752,
          "spk": "林 (リン)",
          "ja": "ならいいわ",
          "tc": "那就好。",
          "sc": "那就好。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 216763,
          "spk": "洋 (ヨウ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 216776,
          "spk": "林 (リン)",
          "ja": "あなたのニワトリは、",
          "tc": "你的雞，",
          "sc": "你的鸡，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 216783,
          "spk": "林 (リン)",
          "ja": "コマコやシロージが山で",
          "tc": "或許駒子與四郎治他們",
          "sc": "或许驹子与四郎治他们"
        },
        {
          "f_idx": 13,
          "pidx_tc": 216790,
          "spk": "林 (リン)",
          "ja": "見つけ出すかもしれないわ",
          "tc": "會在山裡找到。",
          "sc": "会在山里找到。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 216801,
          "spk": "林 (リン)",
          "ja": "……でも、あなたには、",
          "tc": "……但是，等待著妳的，",
          "sc": "……但是，等待着你的，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 216808,
          "spk": "林 (リン)",
          "ja": "きついお仕置きが待っているからね",
          "tc": "將會是很嚴厲的處罰。",
          "sc": "将会是很严厉的处罚。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 216815,
          "spk": "林 (リン)",
          "ja": "今日はもう帰りなさい",
          "tc": "妳今天就先回去吧。",
          "sc": "你今天就先回去吧。"
        }
      ]
    },
