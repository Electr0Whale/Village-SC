          "ja": "どうぞ、受け取ってください",
          "tc": "請你收下吧。",
          "sc": "请你收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6529,
      "rec_id": "TALK_ID_70_0140_005_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363254,
          "spk": "莲实 (ハスミ)",
          "ja": "<strong>この村は行事が多いので、",
          "tc": "<strong>這個村子有很多活動，",
          "sc": "<strong>这个村子有很多活动，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363261,
          "spk": "莲实 (ハスミ)",
          "ja": "カレンダーを一つ用意しておくと便利ですよ</strong>",
          "tc": "所以手邊有一份日曆會比較方便喔。</strong>",
          "sc": "所以手边有一份日历会比较方便哦。</strong>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363279,
          "spk": "莲实 (ハスミ)",
          "ja": "<strong>確認する習慣を身につければ、",
          "tc": "<strong>只要養成確認日期的習慣，",
          "sc": "<strong>只要养成确认日期的习惯，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363286,
          "spk": "莲实 (ハスミ)",
          "ja": "忘れず行事に参加できると思いますから、",
          "tc": "就不會錯過活動了。",
          "sc": "就不会错过活动了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 363293,
          "spk": "莲实 (ハスミ)",
          "ja": "よかったら使ってくださいね</strong>",
          "tc": "可以的話，請拿去用吧。</strong>",
          "sc": "可以的话，请拿去用吧。</strong>"
        },
        {
          "f_idx": 6,
          "pidx_tc": 363304,
          "spk": "莲实 (ハスミ)",
          "ja": "それと……チナナが色々とごめんなさい",
          "tc": "還有……我要替琪娜娜說聲抱歉，",
          "sc": "还有……我要替琪娜娜说声抱歉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 363311,
          "spk": "莲实 (ハスミ)",
          "ja": "昔からああいう人なんです",
          "tc": "她從以前就是那個樣子。",
          "sc": "她从以前就是那个样子。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 363322,
          "spk": "莲实 (ハスミ)",
          "ja": "でも明るくて優しい人だから",
          "tc": "但她是個開朗又溫柔的人，",
          "sc": "但她是个开朗又温柔的人，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 363329,
          "spk": "莲实 (ハスミ)",
          "ja": "仲良くしてあげてくださいね",
          "tc": "還請你要好好跟她相處喔。",
          "sc": "还请你要好好跟她相处哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 363338,
          "spk": "莲实 (ハスミ)",
          "ja": "それでは、今後ともよろしくお願いします",
          "tc": "那麼今後也請你多多關照了。",
          "sc": "那么今后也请你多多关照了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6530,
      "rec_id": "TALK_ID_70_0150_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372175,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、お手伝い券じゃないか",
          "tc": "哦？這不是幫忙券嗎？",
          "sc": "哦？这不是帮忙券吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372186,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さてはキミ、",
          "tc": "讓我猜猜看，",
          "sc": "让我猜猜看，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372193,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンの言いつけを",
          "tc": "你是不是沒有遵守",
          "sc": "你是不是没有遵守"
        },
        {
          "f_idx": 3,
          "pidx_tc": 372200,
          "spk": "琪娜娜 (チナナ)",
          "ja": "守らなかったな？",
          "tc": "林的規矩啊？",
          "sc": "林的规矩啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 372211,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンは小さい頃から",
          "tc": "林從小個性就",
          "sc": "林从小个性就"
        },
        {
          "f_idx": 5,
          "pidx_tc": 372218,
          "spk": "琪娜娜 (チナナ)",
          "ja": "真面目だからねえ",
          "tc": "一板一眼的。",
          "sc": "一板一眼的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 372227,
          "spk": "琪娜娜 (チナナ)",
          "ja": "掟を破ったことがバレると",
          "tc": "所以只要不守規矩",
          "sc": "所以只要不守规矩"
        },
        {
          "f_idx": 7,
          "pidx_tc": 372234,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こういう目に遭うんだよ",
          "tc": "就會落得這個下場。",
          "sc": "就会落得这个下场。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 372245,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、これに懲りたら",
          "tc": "反正你如果學乖了，",
          "sc": "反正你如果学乖了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 372252,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の掟には従うことだね",
          "tc": "就要記得遵守村裡的規矩喔。",
          "sc": "就要记得遵守村里的规矩哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 372263,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにしても……ああ、懐かしいなァ……",
          "tc": "不過……真令人懷念啊……",
          "sc": "不过……真令人怀念啊……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 372270,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンも昔はもう少し大人しかったのに……",
          "tc": "林以前個性還比較沉穩的……",
          "sc": "林以前个性还比较沉稳的……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 372277,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつの間にかあんな感じになっちゃって……",
          "tc": "結果不知不覺間就變成現在這樣了……",
          "sc": "结果不知不觉间就变成现在这样了……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 372288,
          "spk": "琪娜娜 (チナナ)",
          "ja": "実は、ウチもこの村の出身なんだよ",
          "tc": "其實我也是在這個村裡長大的，",
          "sc": "其实我也是在这个村里长大的，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 372295,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ワケあって今は、住んでいないんだけどね",
          "tc": "是因為一些緣故所以沒有住在這裡。",
          "sc": "是因为一些缘故所以没有住在这里。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 372313,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この村だけじゃ、生活が成り立たない……",
          "tc": "單靠這個村莊的話，是沒辦法維持生活的……",
          "sc": "单靠这个村庄的话，是没办法维持生活的……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 372320,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外から品物を持ってくる商人が必要だからね！",
          "tc": "因為村裡需要有商人送外面的物資進來！",
          "sc": "因为村里需要有商人送外面的物资进来！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 372338,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……で、何か",
          "tc": "……話說回來，",
          "sc": "……话说回来，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 372345,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手伝ってくれるんだろ？",
          "tc": "你會幫我的忙對吧？",
          "sc": "你会帮我的忙对吧？"
        },
        {
          "f_idx": 21,
          "pidx_tc": 372352,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それなら、うってつけの頼みごとがあるよ",
          "tc": "我有一個很適合用在幫忙券上的委託喔。",
          "sc": "我有一个很适合用在帮忙券上的委托哦。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 372361,
          "spk": "琪娜娜 (チナナ)",
          "ja": "石を探してほしいんだよね",
          "tc": "我希望你能幫我找石頭。",
          "sc": "我希望你能帮我找石头。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6531,
      "rec_id": "TALK_ID_70_0150_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372379,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今まで使っていた石を",
          "tc": "我之前用的石頭",
          "sc": "我之前用的石头"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372386,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこかに落としちゃったみたいで",
          "tc": "好像掉到了某個地方，",
          "sc": "好像掉到了某个地方，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372393,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困ってるんだ",
          "tc": "讓我很困擾呢。",
          "sc": "让我很困扰呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 372404,
          "spk": "琪娜娜 (チナナ)",
          "ja": "特徴は……うーんと",
          "tc": "石頭的特徵是……嗯……",
          "sc": "石头的特征是……嗯……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 372411,
          "spk": "琪娜娜 (チナナ)",
          "ja": "２キロぐらいの丸い石でね",
          "tc": "是大概兩公斤左右的圓形石頭，",
          "sc": "是大概两公斤左右的圆形石头，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 372418,
          "spk": "琪娜娜 (チナナ)",
          "ja": "明るい灰色をしてるよ",
          "tc": "顏色是亮灰色。",
          "sc": "颜色是亮灰色。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6532,
      "rec_id": "TALK_ID_70_0150_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372436,
          "spk": "琪娜娜 (チナナ)",
          "ja": "他の特徴か……うーん……",
          "tc": "其他特徵啊……嗯……",
          "sc": "其他特征啊……嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372447,
          "spk": "琪娜娜 (チナナ)",
          "ja": "明るい灰色だけど、",
          "tc": "雖然是亮灰色，",
          "sc": "虽然是亮灰色，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372454,
          "spk": "琪娜娜 (チナナ)",
          "ja": "黒いブツブツがビッシリと混じってて",
          "tc": "但上面混雜著密密麻麻的黑點，",
          "sc": "但上面混杂着密密麻麻的黑点，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 372461,
          "spk": "琪娜娜 (チナナ)",
          "ja": "墓石にそっくりの石だね",
          "tc": "跟墓碑是一樣的石頭。",
          "sc": "跟墓碑是一样的石头。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 372472,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村に来る途中で落としたっぽいんだよ",
          "tc": "好像是在來村子的途中弄丟的，",
          "sc": "好像是在来村子的途中弄丢的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 372479,
          "spk": "琪娜娜 (チナナ)",
          "ja": "急ぎってわけじゃないけど",
          "tc": "雖然這事不急，",
          "sc": "虽然这事不急，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 372486,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見つけたら持って来てくれると助かるね",
          "tc": "但希望你找到了就拿來給我。",
          "sc": "但希望你找到了就拿来给我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6533,
      "rec_id": "TALK_ID_70_0150_001_04",
      "lines": [
