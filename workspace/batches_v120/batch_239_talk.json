    {
      "file": "talk.dat",
      "rec_idx": 6528,
      "rec_id": "TALK_ID_70_0140_005_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363216,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、お待たせしてすみません",
          "tc": "<player>，抱歉讓你久等了。",
