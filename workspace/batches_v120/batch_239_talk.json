  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6503,
      "rec_id": "TALK_ID_70_0140_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "このお姉さんは",
          "tc": "這位大姐姐啊，",
          "sc": "这位大姐姐啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362336,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昔っから心配症が過ぎるんだよ",
          "tc": "從以前就總是在擔心這擔心那的。",
          "sc": "从以前就总是在担心这担心那的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362349,
          "spk": "莲实 (ハスミ)",
          "ja": "だって、私のせいで何か起きたらと思うと",
          "tc": "一想到要是因為我的緣故出了什麼事的話，",
          "sc": "一想到要是因为我的缘故出了什么事的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362356,
          "spk": "莲实 (ハスミ)",
          "ja": "気が気じゃなくて……",
          "tc": "我就擔心得不得了……",
          "sc": "我就担心得不得了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6504,
      "rec_id": "TALK_ID_70_0140_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362383,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ？　ウチとハスミの関係",
          "tc": "咦？我跟你沒提過",
          "sc": "咦？我跟你没提过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362390,
          "spk": "琪娜娜 (チナナ)",
          "ja": "話してなかった？",
          "tc": "我和蓮實是什麼關係嗎？",
          "sc": "我和莲实是什么关系吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362401,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチらは幼馴染でさ",
          "tc": "我們從小一起長大，",
          "sc": "我们从小一起长大，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362408,
          "spk": "琪娜娜 (チナナ)",
          "ja": "付き合いが長いんだよ",
          "tc": "已經是老交情了。",
          "sc": "已经是老交情了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6505,
      "rec_id": "TALK_ID_70_0140_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362433,
          "spk": "琪娜娜 (チナナ)",
          "ja": "姉妹同然の仲、と言ってもいいくらいにね",
          "tc": "可以說是情同姊妹吧，",
          "sc": "可以说是情同姐妹吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362440,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でしょ？　ハスミ？",
          "tc": "妳說是吧，蓮實？",
          "sc": "你说是吧，莲实？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6506,
      "rec_id": "TALK_ID_70_0140_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362458,
          "spk": "莲实 (ハスミ)",
          "ja": "まあ、確かに本音で語りあえる",
          "tc": "的確是少數可以互相",
          "sc": "的确是少数可以互相"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362465,
          "spk": "莲实 (ハスミ)",
          "ja": "数少ない相手ね",
          "tc": "吐露真心的對象呢。",
          "sc": "吐露真心的对象呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6507,
      "rec_id": "TALK_ID_70_0140_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362492,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミにお使いを頼んだあと",
          "tc": "在拜託你幫忙之後，",
          "sc": "在拜托你帮忙之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362499,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミが相談に来たんだよ",
          "tc": "蓮實就跑來找我商量了。",
          "sc": "莲实就跑来找我商量了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362510,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「もし山で、<player>さんが",
          "tc": "「萬一<player>在山上受傷了怎麼辦？」",
          "sc": "“万一<player>在山上受伤了怎么办？”"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362517,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ケガしたらどうしよう」……って",
          "tc": "……這樣。",
          "sc": "……这样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6508,
      "rec_id": "TALK_ID_70_0140_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362535,
          "spk": "莲实 (ハスミ)",
          "ja": "当たり前でしょう",
          "tc": "會這麼擔心不是理所當然的嗎，",
          "sc": "会这么担心不是理所当然的吗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362542,
          "spk": "莲实 (ハスミ)",
          "ja": "山には危険な獣だっているんだから……",
          "tc": "畢竟山裡還有很多危險的野獸……",
          "sc": "毕竟山里还有很多危险的野兽……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6509,
      "rec_id": "TALK_ID_70_0140_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362560,
          "spk": "琪娜娜 (チナナ)",
          "ja": "心配ばかりしてたら",
          "tc": "一天到晚操心這些有的沒的，",
          "sc": "一天到晚操心这些有的没的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362567,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体に毒だよ",
          "tc": "可是很傷身體的喔。",
          "sc": "可是很伤身体的哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362580,
          "spk": "莲实 (ハスミ)",
          "ja": "わかってるわ……",
          "tc": "我知道啦……",
          "sc": "我知道啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6510,
      "rec_id": "TALK_ID_70_0140_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362598,
          "spk": "莲实 (ハスミ)",
          "ja": "でもこういう性格だから",
          "tc": "但我就是這種個性，",
          "sc": "但我就是这种个性，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362605,
          "spk": "莲实 (ハスミ)",
          "ja": "仕方ないじゃない",
          "tc": "沒辦法啊。",
          "sc": "没办法啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6511,
      "rec_id": "TALK_ID_70_0140_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは",
          "tc": "啊哈哈，",
          "sc": "啊哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362630,
          "spk": "琪娜娜 (チナナ)",
          "ja": "意外と可愛いところがあるんだよ",
          "tc": "這傢伙意外地也有可愛的一面呢。",
          "sc": "这家伙意外地也有可爱的一面呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362641,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小さい頃とは大違い",
          "tc": "妳以前明明很調皮的，",
          "sc": "你以前明明很调皮的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362648,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昔はお転婆だったのにねえ",
          "tc": "跟現在差超多的。",
          "sc": "跟现在差超多的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6512,
      "rec_id": "TALK_ID_70_0140_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362673,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、いつの話？　大人になれば、",
          "tc": "那都什麼時候的事了？",
          "sc": "那都什么时候的事了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362680,
          "spk": "莲实 (ハスミ)",
          "ja": "みんな変わっていくものでしょう",
          "tc": "長大之後不論是誰都會改變的吧。",
          "sc": "长大之后不论是谁都会改变的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6513,
      "rec_id": "TALK_ID_70_0140_004_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362698,
          "spk": "莲实 (ハスミ)",
          "ja": "ごめんなさい",
          "tc": "對不起。",
          "sc": "对不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362705,
          "spk": "莲实 (ハスミ)",
          "ja": "話が脱線してしまいましたね",
          "tc": "我們偏離原本的話題了呢。",
          "sc": "我们偏离原本的话题了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6514,
      "rec_id": "TALK_ID_70_0140_004_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362725,
          "spk": "莲实 (ハスミ)",
          "ja": "今回はお手伝いいただき",
          "tc": "這次真的非常",
          "sc": "这次真的非常"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362732,
          "spk": "莲实 (ハスミ)",
          "ja": "ありがとうございます",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362745,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬の調合が済んだら",
          "tc": "等到漢方藥調合完成之後",
          "sc": "等到汉方药调合完成之后"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362752,
          "spk": "莲实 (ハスミ)",
          "ja": "ちゃんとお礼もお渡ししますので",
          "tc": "我會給你正式的謝禮的。",
          "sc": "我会给你正式的谢礼的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 362759,
          "spk": "莲实 (ハスミ)",
          "ja": "<strong>明日また、診療所にいらしてください</strong>",
          "tc": "<strong>所以請你明天再來診所一趟吧</strong>。",
          "sc": "<strong>所以请你明天再来诊所一趟吧</strong>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6515,
      "rec_id": "TALK_ID_70_0140_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362781,
          "spk": "莲实 (ハスミ)",
          "ja": "……だから、『あれ』のことは、",
          "tc": "……所以，關於「那個」的事，",
          "sc": "……所以，关于“那个”的事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362788,
          "spk": "莲实 (ハスミ)",
          "ja": "くれぐれも……勘づかれないように……",
          "tc": "要小心……千萬別被發現了……",
          "sc": "要小心……千万别被发现了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362795,
          "spk": "莲实 (ハスミ)",
          "ja": "……スミレは……だから、巻き込みたくない……",
          "tc": "……堇怜是……所以我不想把他捲進來……",
          "sc": "……堇怜是……所以我不想把他卷进来……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6516,
      "rec_id": "TALK_ID_70_0140_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362815,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ、<player>",
          "tc": "咦？<player>，",
          "sc": "咦？<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362822,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつからそこにいたの？",
          "tc": "你什麼時候來的？",
          "sc": "你什么时候来的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362833,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何の話してたか気になる？",
          "tc": "你很在意我們在聊什麼嗎？",
          "sc": "你很在意我们在聊什么吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 362840,
          "spk": "琪娜娜 (チナナ)",
          "ja": "幼馴染同士の内緒の話だよ",
          "tc": "這是兒時玩伴之間的悄悄話喔。",
          "sc": "这是儿时玩伴之间的悄悄话哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 362851,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ねえ、ハスミ？",
          "tc": "對吧，蓮實？",
          "sc": "对吧，莲实？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6517,
      "rec_id": "TALK_ID_70_0140_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362871,
          "spk": "莲实 (ハスミ)",
          "ja": "え、ええ……",
          "tc": "嗯、嗯……",
          "sc": "嗯、嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362884,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、大した内容じゃないから",
          "tc": "不過也不是什麼大不了的事，",
          "sc": "不过也不是什么大不了的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362891,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミに教えてもいいけど……",
          "tc": "所以也不是不能告訴你……",
          "sc": "所以也不是不能告诉你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6518,
      "rec_id": "TALK_ID_70_0140_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362909,
          "spk": "莲实 (ハスミ)",
          "ja": "ちょ、ちょっと……！",
          "tc": "等、等等……！",
          "sc": "等、等等……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6519,
      "rec_id": "TALK_ID_70_0140_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いやね、ハスミったら",
          "tc": "其實蓮實她啊，",
          "sc": "其实莲实她啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362942,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この前スミレに黙って",
          "tc": "前陣子瞞著堇怜",
          "sc": "前阵子瞒着堇怜"
        },
        {
          "f_idx": 2,
          "pidx_tc": 362949,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あるものを買ったんだよ",
          "tc": "買了某個東西。",
          "sc": "买了某个东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6520,
      "rec_id": "TALK_ID_70_0140_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362971,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのあるものって言うのがね、",
          "tc": "而那個東西，",
          "sc": "而那个东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 362978,
          "spk": "琪娜娜 (チナナ)",
          "ja": "有名な酒造で作られた一品で……",
          "tc": "其實就是知名酒廠釀的酒……",
          "sc": "其实就是知名酒厂酿的酒……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6521,
      "rec_id": "TALK_ID_70_0140_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 362996,
          "spk": "莲实 (ハスミ)",
          "ja": "っ……チナナ！",
          "tc": "等……琪娜娜！",
          "sc": "等……琪娜娜！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363003,
          "spk": "莲实 (ハスミ)",
          "ja": "そ、その話も秘密だって",
          "tc": "我、我不是再三強調過",
          "sc": "我、我不是再三强调过"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363010,
          "spk": "莲实 (ハスミ)",
          "ja": "いつも言っているでしょ！",
          "tc": "這件事也要保密的嗎！",
          "sc": "这件事也要保密的吗！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6522,
      "rec_id": "TALK_ID_70_0140_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363028,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは、ごめんごめん",
          "tc": "啊哈哈，抱歉抱歉，",
          "sc": "啊哈哈，抱歉抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363035,
          "spk": "琪娜娜 (チナナ)",
          "ja": "つい口が滑っちゃった",
          "tc": "不小心就說溜嘴了。",
          "sc": "不小心就说溜嘴了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363042,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、そんな怖い顔で睨まないでよ",
          "tc": "所以不要用那麼恐怖的表情瞪我啦。",
          "sc": "所以不要用那么恐怖的表情瞪我啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363055,
          "spk": "莲实 (ハスミ)",
          "ja": "まったく……",
          "tc": "真是的……",
          "sc": "真是的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6523,
      "rec_id": "TALK_ID_70_0140_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363075,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、今の話は",
