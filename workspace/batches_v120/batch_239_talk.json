      "rec_id": "TALK_ID_70_0150_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372626,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっぱりウチの石だね",
          "tc": "果然是我的石頭，",
          "sc": "果然是我的石头，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372633,
          "spk": "琪娜娜 (チナナ)",
          "ja": "間違いないよ！",
          "tc": "不會有錯的！",
          "sc": "不会有错的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6537,
      "rec_id": "TALK_ID_70_0150_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372651,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いや～、助かった",
          "tc": "哎呀～幫大忙了。",
          "sc": "哎呀～帮大忙了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372658,
          "spk": "琪娜娜 (チナナ)",
          "ja": "きっと荷台から転がり落ちたんだね",
          "tc": "八成是從載貨台掉出來的。",
          "sc": "八成是从载货台掉出来的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372665,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありが――",
          "tc": "謝──",
          "sc": "谢——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6538,
      "rec_id": "TALK_ID_70_0150_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372685,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うっ……！",
          "tc": "唔……！",
          "sc": "唔……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6539,
      "rec_id": "TALK_ID_70_0150_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372701,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うぐ……なんだこの痛み……",
          "tc": "嗚……這陣疼痛是怎麼回事……",
          "sc": "呜……这阵疼痛是怎么回事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372710,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ク……クソ……",
          "tc": "可……可惡……",
          "sc": "可……可恶……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372717,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんでこんなに……痺れて……",
          "tc": "怎麼會……這麼麻……",
          "sc": "怎么会……这么麻……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6540,
      "rec_id": "TALK_ID_70_0150_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372735,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ……ごめんよ、<player>",
          "tc": "啊……抱歉，<player>。",
          "sc": "啊……抱歉，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372744,
          "spk": "主角心声/旁白/选项",
          "ja": "石が……",
          "tc": "石頭……",
          "sc": "石头……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372751,
          "spk": "主角心声/旁白/选项",
          "ja": "大丈夫？",
          "tc": "沒事吧？",
          "sc": "没事吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6541,
      "rec_id": "TALK_ID_70_0150_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372819,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この石は片付けておくよ",
          "tc": "這塊石頭我會自己收拾好的，",
          "sc": "这块石头我会自己收拾好的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372826,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は触らなくて大丈夫",
          "tc": "<player>你不用碰沒關係。",
          "sc": "<player>你不用碰没关系。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6542,
      "rec_id": "TALK_ID_70_0150_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372844,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372851,
          "spk": "琪娜娜 (チナナ)",
          "ja": "割れたことなんて",
          "tc": "石頭裂掉的事",
          "sc": "石头裂掉的事"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372858,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気にしなくてもいいんだよ",
          "tc": "你不必放在心上。",
          "sc": "你不必放在心上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 372869,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはちゃんと石を持ってきてくれたしね",
          "tc": "你都把石頭原封不動送來了，",
          "sc": "你都把石头原封不动送来了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 372876,
          "spk": "琪娜娜 (チナナ)",
          "ja": "割れたのはウチの責任さ",
          "tc": "所以裂掉是我自己的責任。",
          "sc": "所以裂掉是我自己的责任。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 372885,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ漬物石の代わりくらい、",
          "tc": "不過就是找個醃菜石的替代品而已嘛，",
          "sc": "不过就是找个腌菜石的替代品而已嘛，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 372892,
          "spk": "琪娜娜 (チナナ)",
          "ja": "車の中を引っかき回せば",
          "tc": "我在車子裡翻一下，",
          "sc": "我在车子里翻一下，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 372899,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かしら見つかるだろうさ",
          "tc": "總是能找到的啦。",
          "sc": "总是能找到的啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6543,
      "rec_id": "TALK_ID_70_0150_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 372917,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ、言ってなかったかい？",
          "tc": "咦？我沒跟你說過嗎？",
          "sc": "咦？我没跟你说过吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 372924,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そう、キミに頼んでいたのは",
          "tc": "我委託你找的",
          "sc": "我委托你找的"
        },
        {
          "f_idx": 2,
          "pidx_tc": 372931,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつも使っていた漬物石でね",
          "tc": "就是我平常在用的醃菜石。",
          "sc": "就是我平常在用的腌菜石。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 372942,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こう言ったらなんだけど、",
          "tc": "不是我在說，",
          "sc": "不是我在说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 372949,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチお手製の漬物は",
          "tc": "我自製的醃漬物",
          "sc": "我自制的腌渍物"
        },
        {
          "f_idx": 5,
          "pidx_tc": 372956,
          "spk": "琪娜娜 (チナナ)",
          "ja": "かなりおいしいんだよ",
          "tc": "可是很好吃的喔。",
          "sc": "可是很好吃的哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 372967,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだ、<strong>今度ウチの店においで</strong>",
          "tc": "對了，<strong>你下次來我店裡一趟吧</strong>。",
          "sc": "对了，<strong>你下次来我店里一趟吧</strong>。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 372974,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お手伝いのお礼に",
          "tc": "作為謝禮，",
          "sc": "作为谢礼，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 372981,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物を分けてあげよう",
          "tc": "我拿一些醃漬物給你。",
          "sc": "我拿一些腌渍物给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6544,
      "rec_id": "TALK_ID_70_0150_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373005,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミが来るまでに",
          "tc": "我會小心",
          "sc": "我会小心"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373012,
          "spk": "琪娜娜 (チナナ)",
          "ja": "たいらげないよう、気をつけておくよ",
          "tc": "不要在你來之前就吃光光的。",
          "sc": "不要在你来之前就吃光光的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6545,
      "rec_id": "TALK_ID_70_0150_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373036,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お、来たね",
          "tc": "哦，你來啦，",
          "sc": "哦，你来啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373043,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待ってたよ",
          "tc": "等你很久了。",
          "sc": "等你很久了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6546,
      "rec_id": "TALK_ID_70_0150_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373067,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この前は、石を探してくれてありがとね",
          "tc": "謝謝你之前幫我找石頭，",
          "sc": "谢谢你之前帮我找石头，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373074,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これ、約束の漬物だよ",
          "tc": "這是我說要給你的醃漬物。",
          "sc": "这是我说要给你的腌渍物。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6547,
      "rec_id": "TALK_ID_70_0150_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373098,
          "spk": "琪娜娜 (チナナ)",
          "ja": "結局、漬物石になりそうなものが",
          "tc": "結果到頭來我還是沒找到",
          "sc": "结果到头来我还是没找到"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373105,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見つからなくてさ",
          "tc": "可以拿來當醃菜石的東西。",
          "sc": "可以拿来当腌菜石的东西。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373123,
          "spk": "琪娜娜 (チナナ)",
          "ja": "試しに、割れた石を縄で縛ってみたら",
          "tc": "所以我就試著用繩子綁起了裂掉的石頭，",
          "sc": "所以我就试着用绳子绑起了裂掉的石头，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373130,
          "spk": "琪娜娜 (チナナ)",
          "ja": "縄が持ち手になって使い勝手がよくてね",
          "tc": "結果發現繩子可以當手把用，用起來挺順手的，",
          "sc": "结果发现绳子可以当手柄用，用起来挺顺手的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 373137,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あの石をそのまま使ってるんだ",
          "tc": "所以我就沿用原本那顆石頭了。",
          "sc": "所以我就沿用原本那颗石头了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 373148,
          "spk": "琪娜娜 (チナナ)",
          "ja": "その漬物も、あの石で漬けたんだよ",
          "tc": "這份醃漬物也是用那個石頭醃出來的喔，",
          "sc": "这份腌渍物也是用那个石头腌出来的哦，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 373155,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今回もいい味に仕上がってるよ",
          "tc": "這次的味道也很不錯。",
          "sc": "这次的味道也很不错。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 373173,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一仕事終えた後に、",
          "tc": "完成工作之後，",
          "sc": "完成工作之后，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 373180,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ビールと一緒につまむのが最高でさ",
          "tc": "拿醃漬物搭配啤酒一起享用是最棒的了，",
          "sc": "拿腌渍物搭配啤酒一起享用是最棒的了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 373187,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっという間になくなっちゃうんだ",
          "tc": "轉眼間就會吃光光了呢。",
          "sc": "转眼间就会吃光光了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6548,
      "rec_id": "TALK_ID_70_0150_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373205,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっ？　漬物に興味があるかい？",
          "tc": "喔？你對醃漬物有興趣嗎？",
          "sc": "喔？你对腌渍物有兴趣吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373212,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それなら、ついでにこれもあげようか",
          "tc": "那我順便把這個送你好了。",
          "sc": "那我顺便把这个送你好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6549,
      "rec_id": "TALK_ID_70_0150_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373236,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物樽のレシピだよ",
          "tc": "這是醃菜桶的製作方法，",
          "sc": "这是腌菜桶的制作方法，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373243,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それを使って",
          "tc": "你也試著用醃菜桶",
          "sc": "你也试着用腌菜桶"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373250,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自分好みの漬物を作ってみたらいい",
          "tc": "製作自己想吃的醃漬物吧。",
          "sc": "制作自己想吃的腌渍物吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373261,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんならビールも",
          "tc": "不然我乾脆",
          "sc": "不然我干脆"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373268,
          "spk": "琪娜娜 (チナナ)",
          "ja": "分けてあげようか？",
          "tc": "也分點啤酒給你好了？",
          "sc": "也分点啤酒给你好了？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 373279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あの味を一回知れば",
          "tc": "只要嘗過了這個滋味，",
          "sc": "只要尝过了这个滋味，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 373286,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミもきっとクセに――",
          "tc": "你肯定也會上癮──",
          "sc": "你肯定也会上瘾——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6550,
      "rec_id": "TALK_ID_70_0150_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373306,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナ？",
          "tc": "琪娜娜？",
          "sc": "琪娜娜？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373313,
          "spk": "莲实 (ハスミ)",
          "ja": "なんの話をしてるの？",
          "tc": "你們在聊什麼？",
          "sc": "你们在聊什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6551,
      "rec_id": "TALK_ID_70_0150_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373331,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ～……っはははは",
          "tc": "啊……哈哈哈哈，",
          "sc": "啊……哈哈哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373338,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やだな、冗談だよ、冗談",
          "tc": "討厭啦，我只是開玩笑的。",
          "sc": "讨厌啦，我只是开玩笑的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373351,
          "spk": "莲实 (ハスミ)",
          "ja": "……それならいいんだけど",
          "tc": "……那就好。",
          "sc": "……那就好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6552,
      "rec_id": "TALK_ID_70_0150_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373369,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
