{
  "batch_id": "batch_177_talk",
  "group": "talk",
  "files": [
    "talk.dat"
  ],
  "record_count": 35,
  "line_count": 192,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3961,
      "rec_id": "TALK_ID_10_0201_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223651,
          "spk": "林 (リン)",
          "ja": "そっちの様子はどうかしら？",
          "tc": "那邊的狀況如何？",
          "sc": "那边的状况如何？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223669,
          "spk": "今野 (コンノ)",
          "ja": "今夜も滞りなく、",
          "tc": "今晚也是一如往常地",
          "sc": "今晚也是一如往常地"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223676,
          "spk": "今野 (コンノ)",
          "ja": "百鬼夜行って感じですねェ",
          "tc": "很有百鬼夜行的感覺呢。",
          "sc": "很有百鬼夜行的感觉呐～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223687,
          "spk": "林 (リン)",
          "ja": "でも……私が見た所では、",
          "tc": "不過……就我觀察，",
          "sc": "不过……就我观察，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223694,
          "spk": "林 (リン)",
          "ja": "怪異が少ない気がするの……",
          "tc": "妖怪似乎有點少……",
          "sc": "妖怪似乎有点少……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 223710,
          "spk": "林 (リン)",
          "ja": "もっと蔓延ってもらわないと困るのに",
          "tc": "滋生的數量不夠多就不好了。",
          "sc": "滋生的数量不够多就不好了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 223728,
          "spk": "今野 (コンノ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 223735,
          "spk": "今野 (コンノ)",
          "ja": "この調子では、時間の問題かもしれません",
          "tc": "照這樣看來，或許只是時間早晚的問題。",
          "sc": "照这样看来，或许只是时间早晚的问题。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 223751,
          "spk": "今野 (コンノ)",
          "ja": "まったく、祀らないと祟るだなんて……",
          "tc": "真是的，不去祭祀就會作祟……",
          "sc": "真是的，不去祭祀就会作祟……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 223758,
          "spk": "今野 (コンノ)",
          "ja": "本当に面倒な連中ですヨ",
          "tc": "實在是群麻煩的傢伙呀。",
          "sc": "实在是群麻烦的家伙哟～。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 223776,
          "spk": "林 (リン)",
          "ja": "やっぱり二十年前も十年前も、",
          "tc": "畢竟不管是二十年前還是十年前",
          "sc": "毕竟不管是二十年前还是十年前"
        },
        {
          "f_idx": 16,
          "pidx_tc": 223783,
          "spk": "林 (リン)",
          "ja": "儀式を正しくやり遂げられていないから……",
          "tc": "都沒有正確執行完儀式……",
          "sc": "都没有正确执行完仪式……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 223790,
          "spk": "林 (リン)",
          "ja": "きっともう限界なのでしょう……",
          "tc": "終究到極限了吧……",
          "sc": "终究到极限了吧……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 223801,
          "spk": "今野 (コンノ)",
          "ja": "それだけが原因じゃない気がしますけどねェ",
          "tc": "我倒是覺得原因不只如此。",
          "sc": "我倒是觉得原因不只如此呐～。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 223808,
          "spk": "今野 (コンノ)",
          "ja": "近頃、妙な気配もありますし……",
          "tc": "再說最近有種不尋常的氣氛……",
          "sc": "再说最近有种不寻常的气氛……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 223824,
          "spk": "今野 (コンノ)",
          "ja": "今この瞬間も、どっかの誰かが",
          "tc": "或許此時此刻，",
          "sc": "或许此时此刻，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 223831,
          "spk": "今野 (コンノ)",
          "ja": "掟を軽んじているかもしれませんからァ",
          "tc": "又有哪個傢伙沒把規矩當作一回事了。",
          "sc": "又有哪个家伙没把规矩当作一回事了。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 223849,
          "spk": "林 (リン)",
          "ja": "……………",
          "tc": "……………",
          "sc": "……"
        },
        {
          "f_idx": 25,
          "pidx_tc": 223858,
          "spk": "林 (リン)",
          "ja": "早く儀式を執り行わなければいけない……",
          "tc": "必須盡快執行儀式……",
          "sc": "必须尽快执行仪式……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 223865,
          "spk": "林 (リン)",
          "ja": "やはり、ちゃんとした贄は欠かせないのよ……",
          "tc": "果然還是不能少了合適的祭品……",
          "sc": "果然还是不能少了合适的祭品……"
        },
        {
          "f_idx": 27,
          "pidx_tc": 223876,
          "spk": "今野 (コンノ)",
          "ja": "……リンさん",
          "tc": "……林小姐，",
          "sc": "……林小姐，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 223883,
          "spk": "今野 (コンノ)",
          "ja": "アナタ……本当にやるんですか？",
          "tc": "妳……真的要那麼做嗎？",
          "sc": "你……真的要那么做吗？"
        },
        {
          "f_idx": 29,
          "pidx_tc": 223894,
          "spk": "林 (リン)",
          "ja": "私はもう、覚悟を決めたわ",
          "tc": "我已經下定決心了。",
          "sc": "我已经下定决心了。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 223901,
          "spk": "林 (リン)",
          "ja": "あなたも準備しておきなさい",
          "tc": "你也去做好準備吧。",
          "sc": "你也去做好准备吧。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 223912,
          "spk": "今野 (コンノ)",
          "ja": "ハァ……ホントに",
          "tc": "唉……真是",
          "sc": "唉……真是"
        },
        {
          "f_idx": 32,
          "pidx_tc": 223919,
          "spk": "今野 (コンノ)",
          "ja": "哀れな話ですねェ……",
          "tc": "可悲啊……",
          "sc": "可悲啊……"
        },
        {
          "f_idx": 33,
          "pidx_tc": 223930,
          "spk": "林 (リン)",
          "ja": "いくわよ",
          "tc": "該走了。",
          "sc": "该走了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3962,
      "rec_id": "TALK_ID_10_0201_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224230,
          "spk": "林 (リン)",
          "ja": "畏み、畏み、申します……",
          "tc": "誠惶誠恐，至誠奉告……",
          "sc": "诚惶诚恐，至诚奉告……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 224239,
          "spk": "林 (リン)",
          "ja": "此の供物の数々、",
          "tc": "謹此將諸多供品，",
          "sc": "谨此将诸多供品，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 224246,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉りまつる",
          "tc": "悉數虔誠供奉予祢。",
          "sc": "悉数虔诚供奉予你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 224255,
          "spk": "林 (リン)",
          "ja": "今宵の闇、この地の境もろとも、",
          "tc": "亦將今宵之闇與此地之境界，",
          "sc": "亦将今宵之暗与此地之境界，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 224262,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉りまつる",
          "tc": "悉數虔誠供奉予祢。",
          "sc": "悉数虔诚供奉予你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 224271,
          "spk": "林 (リン)",
          "ja": "――願わくは、御力を以て応え給え",
          "tc": "──但求祢展現神威，應我所求。",
          "sc": "——但求你展现神威，应我所求。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3963,
      "rec_id": "TALK_ID_10_0201_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224295,
          "spk": "林 (リン)",
          "ja": "もう少しだけ……",
          "tc": "只要再稍微……",
          "sc": "只要再稍微……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 224302,
          "spk": "林 (リン)",
          "ja": "もう少しだけ、私に時間をください……",
          "tc": "再稍微給我一點時間……",
          "sc": "再稍微给我一点时间……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3964,
      "rec_id": "TALK_ID_10_0201_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224322,
          "spk": "林 (リン)",
          "ja": "ユータ！",
          "tc": "裕太！",
          "sc": "裕太！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 224329,
          "spk": "林 (リン)",
          "ja": "ちょっと、待ちなさい！",
          "tc": "給我等一下！",
          "sc": "给我等一下！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3965,
      "rec_id": "TALK_ID_10_0201_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224351,
          "spk": "裕太 (ユータ)",
          "ja": "おや、リンちゃん",
          "tc": "哦，是林啊。",
          "sc": "哦，是林啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 224358,
          "spk": "裕太 (ユータ)",
          "ja": "どうしたの？",
          "tc": "怎麼了嗎？",
          "sc": "怎么了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 224371,
          "spk": "林 (リン)",
          "ja": "どうしたのじゃないわよ",
          "tc": "還問「怎麼了」？",
          "sc": "还问“怎么了”？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 224378,
          "spk": "林 (リン)",
          "ja": "探してたんだから",
          "tc": "我一直在找你啊。",
          "sc": "我一直在找你啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 224389,
          "spk": "林 (リン)",
          "ja": "……まあいいわ",
          "tc": "……算了，無所謂。",
          "sc": "……算了，无所谓。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 224396,
          "spk": "林 (リン)",
          "ja": "あなたはもう、村には慣れたかしら？",
          "tc": "你應該已經習慣村裡的生活了吧？",
          "sc": "你应该已经习惯村里的生活了吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 224409,
          "spk": "裕太 (ユータ)",
          "ja": "もちろん",
          "tc": "當然。",
          "sc": "当然。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 224416,
          "spk": "裕太 (ユータ)",
          "ja": "彼ヶ津村はほんとに静かでいいね",
          "tc": "彼津村真是個平靜的好地方，",
          "sc": "彼津村真是个平静的好地方，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 224423,
          "spk": "裕太 (ユータ)",
          "ja": "ここでの暮らしは、持病にもよく効くよ",
          "tc": "在這裡的生活很適合養病。",
          "sc": "在这里的生活很适合养病。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 224436,
          "spk": "林 (リン)",
          "ja": "それはよかったわ",
          "tc": "那就太好了。",
          "sc": "那就太好了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 224443,
          "spk": "林 (リン)",
          "ja": "だったら、どうして私が来たか、",
          "tc": "既然如此，你應該知道",
          "sc": "既然如此，你应该知道"
        },
        {
          "f_idx": 11,
          "pidx_tc": 224450,
          "spk": "林 (リン)",
          "ja": "わかるわよね",
          "tc": "我為什麼來吧？",
          "sc": "我为什么来吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 224463,
          "spk": "裕太 (ユータ)",
          "ja": "……なんだろう？",
          "tc": "……是為什麼？",
          "sc": "……是为什么？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 224470,
          "spk": "裕太 (ユータ)",
          "ja": "あ、来月の草刈りの件？",
          "tc": "啊，是下個月割草的事嗎？",
          "sc": "啊，是下个月割草的事吗？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 224483,
          "spk": "林 (リン)",
          "ja": "ちがうわよ……",
          "tc": "並不是……",
          "sc": "并不是……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 224494,
          "spk": "林 (リン)",
          "ja": "今月の「お根付け料」を、",
          "tc": "我是來收這個月的",
          "sc": "我是来收这个月的"
        },
        {
          "f_idx": 16,
          "pidx_tc": 224501,
          "spk": "林 (リン)",
          "ja": "受け取りに来たの",
          "tc": "「生根費」。",
          "sc": "“生根费”。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 224514,
          "spk": "裕太 (ユータ)",
          "ja": "ああ、寄進ね！",
          "tc": "喔，捐獻啊！",
          "sc": "喔，捐献啊！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 224521,
          "spk": "裕太 (ユータ)",
          "ja": "いや、お賽銭かな？",
          "tc": "不對，該說是香油錢嗎？",
          "sc": "不对，该说是香油钱吗？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 224534,
          "spk": "林 (リン)",
          "ja": "……お根付け料と言ってもらえるかしら",
          "tc": "……請你用「生根費」來稱呼。",
          "sc": "……请你用“生根费”来称呼。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 224552,
          "spk": "林 (リン)",
          "ja": "わかってる？",
          "tc": "你真的明白嗎？",
          "sc": "你真的明白吗？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 224559,
          "spk": "林 (リン)",
          "ja": "あなたの大好きな静けさも、",
          "tc": "你最愛的「平靜」，",
          "sc": "你最爱的“平静”，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 224566,
          "spk": "林 (リン)",
          "ja": "あなたのお布施次第なのよ",
          "tc": "也都取決於你的捐獻喔。",
          "sc": "也都取决于你的捐献。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 224579,
          "spk": "裕太 (ユータ)",
          "ja": "えっと……いくらだっけ？",
          "tc": "呃……是要捐多少錢？",
          "sc": "呃……是要捐多少钱？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 224599,
          "spk": "林 (リン)",
          "ja": "あなたの気持ち次第……",
          "tc": "看你的心意……",
          "sc": "看你的心意……"
        },
        {
          "f_idx": 27,
          "pidx_tc": 224606,
          "spk": "林 (リン)",
          "ja": "だけど気持ちは、額に表れるわ",
          "tc": "不過，心意會反應在金額上嘛。",
          "sc": "不过，心意会反应在金额上嘛。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 224624,
          "spk": "林 (リン)",
          "ja": "あなたのようなよそ者なら……",
          "tc": "像你這樣的外地人……",
          "sc": "像你这样的外地人……"
        },
        {
          "f_idx": 30,
          "pidx_tc": 224631,
          "spk": "林 (リン)",
          "ja": "そうね、3万円くらいが妥当かしら",
          "tc": "我想想，三萬元應該差不多吧。",
          "sc": "我想想，三万元应该差不多吧。"
        },
        {
          "f_idx": 32,
          "pidx_tc": 224651,
          "spk": "裕太 (ユータ)",
          "ja": "おお、それで静けさが買えるだなんて",
          "tc": "哦，這樣就能買到平靜了啊。",
          "sc": "哦，这样就能买到平静了啊。"
        },
        {
          "f_idx": 33,
          "pidx_tc": 224658,
          "spk": "裕太 (ユータ)",
          "ja": "神さまはなんて良心的なんだろう！",
          "tc": "神明大人還真是有良心！",
          "sc": "神明大人还真是有良心！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3966,
      "rec_id": "TALK_ID_10_0201_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224685,
          "spk": "裕太 (ユータ)",
          "ja": "はい、3万円",
          "tc": "來，三萬元。",
          "sc": "来，三万元。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3967,
      "rec_id": "TALK_ID_10_0201_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 224703,
          "spk": "林 (リン)",
          "ja": "……あなたの清き心、",
          "tc": "……我確實收下",
          "sc": "……我确实收下"
        },
        {
          "f_idx": 1,
          "pidx_tc": 224710,
          "spk": "林 (リン)",
          "ja": "しかと受け取りましたわ",
          "tc": "你純淨的心意了。",
          "sc": "你纯净的心意了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 224723,
          "spk": "裕太 (ユータ)",
          "ja": "ねえリンちゃん、",
          "tc": "林，我問妳，",
          "sc": "林，我问你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 224730,
          "spk": "裕太 (ユータ)",
          "ja": "これで俺も、正式な村民って感じが",
          "tc": "這麼一來，我是不是更有",
