          "f_idx": 14,
          "pidx_tc": 225422,
          "spk": "今野 (コンノ)",
          "ja": "色々な不幸が起きるのです",
          "tc": "總是會發生各種不幸之事。",
          "sc": "总是会发生各种不幸之事。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 225433,
          "spk": "今野 (コンノ)",
          "ja": "気のせい、ではあると思うのですがねェ",
          "tc": "雖然我認為只是多心了啦。",
          "sc": "虽然我认为只是多心呐～。"
        },
