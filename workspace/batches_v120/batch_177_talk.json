          "f_idx": 13,
          "pidx_tc": 225415,
          "spk": "今野 (コンノ)",
          "ja": "「根付け」をしない者には、",
          "tc": "沒有好好「生根」的人，",
          "sc": "没有好好“生根”的人，"
        },
