          "f_idx": 8,
          "pidx_tc": 225372,
          "spk": "今野 (コンノ)",
          "ja": "金でも穀物でも構いません",
          "tc": "無論是金錢或是穀物都可以，",
          "sc": "无论是金钱或是谷物都可以，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 225379,
          "spk": "今野 (コンノ)",
          "ja": "心がこもっていれば、",
          "tc": "只要飽含心意，",
          "sc": "只要饱含心意，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 225386,
          "spk": "今野 (コンノ)",
          "ja": "神様は受け取ってくれるでしょうから",
          "tc": "神明大人都會接受的。",
          "sc": "神明大人都会接受的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 225397,
          "spk": "今野 (コンノ)",
          "ja": "いや、強制ではありませんよォ",
