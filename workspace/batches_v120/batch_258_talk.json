  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7288,
      "rec_id": "TALK_ID_70_2080_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455663,
          "spk": "六角 (ロッカク)",
          "ja": "オワンさんは本当に賢いっスね",
          "tc": "歐宛真的很聰明呢。",
          "sc": "欧宛真的很聪明呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455670,
          "spk": "六角 (ロッカク)",
          "ja": "ワシらの言葉を理解してるみたいっス",
          "tc": "就好像聽得懂我們說的話一樣。",
          "sc": "就好像听得懂我们说的话一样呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455677,
          "spk": "六角 (ロッカク)",
          "ja": "ただ、言葉に反応してるだけでしょうけど……",
          "tc": "雖然應該只是對言語有反應而已……",
          "sc": "虽然应该只是对言语有反应而已……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455688,
          "spk": "六角 (ロッカク)",
          "ja": "ま、なんにしても",
          "tc": "算了，無論如何，",
          "sc": "算了，无论如何，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 455695,
          "spk": "六角 (ロッカク)",
          "ja": "この看板料理の復活は",
          "tc": "我看這道招牌料理",
          "sc": "我看这道招牌料理"
        },
        {
          "f_idx": 5,
          "pidx_tc": 455702,
          "spk": "六角 (ロッカク)",
          "ja": "もうちょっと先のことになりそう――",
          "tc": "大概還要再過一陣子才能復活了──",
          "sc": "大概还要再过一阵子才能复活了——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7289,
      "rec_id": "TALK_ID_70_2080_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455726,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "ニモノ！　ニモノ！",
          "tc": "煮物！煮物！",
          "sc": "煮物！煮物！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455733,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "カクシアジ！　カクシアジ！",
          "tc": "祕密調味料！祕密調味料！",
          "sc": "秘密调味料！秘密调味料！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7290,
      "rec_id": "TALK_ID_70_2080_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455751,
          "spk": "六角 (ロッカク)",
          "ja": "オワンさん？　いきなりなにを……",
          "tc": "歐宛？你怎麼突然……",
          "sc": "欧宛？你怎么突然……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455758,
          "spk": "六角 (ロッカク)",
          "ja": "って、こいつは……お味噌っスか？",
          "tc": "這個是……味噌嗎？",
          "sc": "这个是……味噌不？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7291,
      "rec_id": "TALK_ID_70_2080_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455776,
          "spk": "六角 (ロッカク)",
          "ja": "は……？",
          "tc": "啊……？",
          "sc": "啊……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455783,
          "spk": "六角 (ロッカク)",
          "ja": "今なんと……",
          "tc": "剛才是……",
          "sc": "刚才是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7292,
      "rec_id": "TALK_ID_70_2080_006_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455809,
          "spk": "六角 (ロッカク)",
          "ja": "こいつがウチの新メニューっス",
          "tc": "這就是我們的新菜色，",
          "sc": "这就是我们的新菜色，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455816,
          "spk": "六角 (ロッカク)",
          "ja": "驚くと思うんで、食ってみてほしいっス",
          "tc": "你也來吃吃看吧，一定會很驚喜的。",
          "sc": "你也来吃吃看吧，一定会很惊喜呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455836,
          "spk": "木助 (キスケ)",
          "ja": "……なんだよ改まって",
          "tc": "……怎麼這麼慎重啊？",
          "sc": "……怎么这么慎重啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 455843,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの「カボチャの煮物」なんて、今更……",
          "tc": "事到如今，你做的「燉南瓜」……",
          "sc": "事到如今，你做的“炖南瓜”……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7293,
      "rec_id": "TALK_ID_70_2080_006_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455868,
          "spk": "木助 (キスケ)",
          "ja": "……うわ、嘘だろ！",
          "tc": "……哇啊，騙人的吧！",
          "sc": "……哇啊，骗人的吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455875,
          "spk": "木助 (キスケ)",
          "ja": "これ、知ってる味だぞ！",
          "tc": "這味道我很熟悉！",
          "sc": "这味道我很熟悉！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455888,
          "spk": "六角 (ロッカク)",
          "ja": "気に入っていただけたっスか？",
          "tc": "還滿意嗎？",
          "sc": "还满意不？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455901,
          "spk": "木助 (キスケ)",
          "ja": "まぁな、確かに前の店の味だ",
          "tc": "確實是以前的店的味道。",
          "sc": "确实是以前的店的味道。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 455908,
          "spk": "木助 (キスケ)",
          "ja": "しかし急にどうしたんだよ、",
          "tc": "但怎麼會突然做出來了，",
          "sc": "但怎么会突然做出来了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 455915,
          "spk": "木助 (キスケ)",
          "ja": "レシピでも見つかったのか？",
          "tc": "是找到了食譜嗎？",
          "sc": "是找到了食谱吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7294,
      "rec_id": "TALK_ID_70_2080_006_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455941,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの新しい家族が、",
          "tc": "因為我們的新家人",
          "sc": "因为我们的新家人"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455948,
          "spk": "六角 (ロッカク)",
          "ja": "福を運んできてくれたんスよ",
          "tc": "為我們帶來了福氣啊。",
          "sc": "为我们带来了福气啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455959,
          "spk": "六角 (ロッカク)",
          "ja": "ささ、<player>さんも",
          "tc": "來，<player>，",
          "sc": "来，<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455966,
          "spk": "六角 (ロッカク)",
          "ja": "食べてみてほしいっス",
          "tc": "你也來吃吃看吧。",
          "sc": "你也来吃吃看呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 455977,
          "spk": "六角 (ロッカク)",
          "ja": "こいつがウチの新しい",
          "tc": "這就是我們這間店的……",
          "sc": "这就是我们这间店的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 455984,
          "spk": "六角 (ロッカク)",
          "ja": "看板メニューになるんスから",
          "tc": "新的招牌菜。",
          "sc": "新的招牌菜。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7295,
      "rec_id": "TALK_ID_70_2080_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456008,
          "spk": "六角 (ロッカク)",
          "ja": "お、<player>さん",
          "tc": "哦，<player>，",
          "sc": "哦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456015,
          "spk": "六角 (ロッカク)",
          "ja": "いいところに来たっスね",
          "tc": "你來得正好。",
          "sc": "你来得正好呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456026,
          "spk": "六角 (ロッカク)",
          "ja": "ちょうど今、イイ感じに揚がったところっス",
          "tc": "我剛好炸得差不多了，",
          "sc": "我刚好炸得差不多了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456033,
          "spk": "六角 (ロッカク)",
          "ja": "アツアツ、食べれるっスか？",
          "tc": "熱騰騰的，你有辦法吃嗎？",
          "sc": "热腾腾的，你有办法吃不？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7296,
      "rec_id": "TALK_ID_70_2080_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456057,
          "spk": "六角 (ロッカク)",
          "ja": "そう来なくっちゃあ",
          "tc": "這樣才對嘛。",
          "sc": "这样才对嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456064,
          "spk": "六角 (ロッカク)",
          "ja": "ささ、「小魚の唐揚げ」っス",
          "tc": "來，這是油炸小魚，",
          "sc": "来，这是油炸小鱼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456071,
          "spk": "六角 (ロッカク)",
          "ja": "冷めないうちにかぶりついちゃってください",
          "tc": "快趁熱，直接給他大口咬下去吧。",
          "sc": "快趁热，直接给他大口咬下去吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456080,
          "spk": "主角心声/旁白/选项",
          "ja": "たべる",
          "tc": "吃",
          "sc": "吃"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456087,
          "spk": "主角心声/旁白/选项",
          "ja": "お金は？",
          "tc": "不用錢嗎？",
          "sc": "不用钱吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7297,
      "rec_id": "TALK_ID_70_2080_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456260,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんのお墨付きなら、",
          "tc": "如果有<player>你的認可，",
          "sc": "如果有<player>你的认可，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456267,
          "spk": "六角 (ロッカク)",
          "ja": "このまま新メニューに載せても問題ないっスね",
          "tc": "看來是可以直接拿來當作新菜色了。",
          "sc": "看来是可以直接拿来当作新菜色呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7298,
      "rec_id": "TALK_ID_70_2080_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456285,
          "spk": "六角 (ロッカク)",
          "ja": "いえね、毎回同じメニューじゃ",
          "tc": "你想嘛，每次都只有那幾道菜的話，",
          "sc": "你想嘛，每次都只有那几道菜的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456292,
          "spk": "六角 (ロッカク)",
          "ja": "村の人らに飽きられちまうっス",
          "tc": "村裡的人也是會膩的。",
          "sc": "村里的人也是会腻呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456310,
          "spk": "六角 (ロッカク)",
          "ja": "だからこうして、",
          "tc": "所以我時不時就會推出一些新菜單，",
          "sc": "所以我时不时就会推出一些新菜单，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456317,
          "spk": "六角 (ロッカク)",
          "ja": "時々新メニューを出してテコ入れするんスよ",
          "tc": "好拯救餐廳的營收。",
          "sc": "好拯救餐厅的营收。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456328,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、たまにとんでもねえ失敗作が",
          "tc": "不過我偶爾還是會不小心做出一些",
          "sc": "不过我偶尔还是会不小心做出一些"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456335,
          "spk": "六角 (ロッカク)",
          "ja": "できちまったりもしますけど",
          "tc": "不得了的失敗品就是了。",
          "sc": "不得了的失败品就是了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456346,
          "spk": "六角 (ロッカク)",
          "ja": "……せっかく受け継いだんだ",
          "tc": "……既然我都繼承這間店了，",
          "sc": "……既然我都继承这间店了，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 456353,
          "spk": "六角 (ロッカク)",
          "ja": "この店をできる限り、盛り上げてやらねえと",
          "tc": "那我就要盡可能地把生意做起來才行。",
          "sc": "那我就要尽可能地把生意做起来才行。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 456371,
          "spk": "六角 (ロッカク)",
          "ja": "あ、おかわりもいるっスか？",
          "tc": "對了，要再吃嗎？",
          "sc": "对了，要再吃不？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 456378,
          "spk": "六角 (ロッカク)",
          "ja": "いっぱい揚げるので、待っててほしいっス",
          "tc": "我多炸點給你，稍微等我一下。",
          "sc": "我多炸点给你，稍微等我一下呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7299,
      "rec_id": "TALK_ID_70_2080_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456402,
          "spk": "六角 (ロッカク)",
          "ja": "おや、来てくれたっスね、<player>さん",
          "tc": "喔？歡迎你來，<player>。",
          "sc": "喔？欢迎你来，<player>呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456409,
          "spk": "六角 (ロッカク)",
          "ja": "約束の時間っスもんね",
          "tc": "畢竟約好的時間到了。",
          "sc": "毕竟约好的时间到呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456420,
          "spk": "六角 (ロッカク)",
          "ja": "ただ、せっかくお誘いしたのに",
          "tc": "只是，難得你來了，",
          "sc": "只是，难得你来了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456427,
          "spk": "六角 (ロッカク)",
          "ja": "申し訳ねぇんスけど、別の用事を片付けてたら",
          "tc": "我卻因為處理其他事情，",
          "sc": "我却因为处理其他事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456434,
          "spk": "六角 (ロッカク)",
          "ja": "簡単なモンしか用意できなかったっス……",
          "tc": "只準備了些簡單的東西，真抱歉……",
          "sc": "只准备了些简单的东西，真抱歉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7300,
      "rec_id": "TALK_ID_70_2080_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456452,
          "spk": "六角 (ロッカク)",
          "ja": "でも、美味いモンはなんとか",
          "tc": "不過，美味的東西，",
          "sc": "不过，美味的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456459,
          "spk": "六角 (ロッカク)",
          "ja": "間に合わせで用意できてるっス！",
          "tc": "我算是趕上時間準備好了！",
          "sc": "我算是赶上时间准备好了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456470,
          "spk": "六角 (ロッカク)",
          "ja": "ってことで……今日のメニューは、",
          "tc": "所以說……今天的料理是，",
          "sc": "所以说……今天的料理是，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456477,
          "spk": "六角 (ロッカク)",
          "ja": "スペシャルただの「塩むすび」っス！",
          "tc": "特製的普通「鹽味飯糰」！",
          "sc": "特制的普通“盐味饭团”！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456488,
          "spk": "六角 (ロッカク)",
          "ja": "……たまには悪くないでしょ？",
          "tc": "……偶爾吃這個也不錯吧？",
          "sc": "……偶尔吃这个也不错吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7301,
      "rec_id": "TALK_ID_70_2080_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456513,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんが話がわかる人でよかった！",
          "tc": "還好<player>是個配合很高的人！",
          "sc": "还好<player>是个配合很高的人！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456520,
          "spk": "六角 (ロッカク)",
          "ja": "じゃ、すぐに用意するんでお待ちっス",
          "tc": "很快就會準備好，稍等一下……",
          "sc": "很快就会准备好，稍等一下……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7302,
      "rec_id": "TALK_ID_70_2080_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456551,
          "spk": "六角 (ロッカク)",
          "ja": "どうっスか？",
          "tc": "如何？",
          "sc": "如何？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456558,
          "spk": "六角 (ロッカク)",
