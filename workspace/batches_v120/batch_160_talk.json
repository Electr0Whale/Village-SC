  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3316,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0043",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 175292,
          "spk": "驹子 (コマコ)",
          "ja": "チナナさんって大人って感じで",
          "tc": "琪娜娜姐有種成熟大人的感覺，",
          "sc": "琪娜娜姐有种成熟大人的感觉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 175299,
          "spk": "驹子 (コマコ)",
          "ja": "憧れちゃうな……",
          "tc": "真讓人嚮往……",
          "sc": "真让人向往……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 175312,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやおや",
          "tc": "哎呀哎呀，",
          "sc": "哎呀哎呀，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 175319,
          "spk": "琪娜娜 (チナナ)",
          "ja": "面と向かって照れることを",
          "tc": "真虧妳能面對面地對我說出",
          "sc": "真亏你能面对面地对我说出"
        },
        {
          "f_idx": 4,
          "pidx_tc": 175326,
          "spk": "琪娜娜 (チナナ)",
          "ja": "言ってくれるじゃないか",
          "tc": "這麼肉麻的話呢～",
          "sc": "这么肉麻的话呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 175339,
          "spk": "驹子 (コマコ)",
          "ja": "チナナさんみたく",
          "tc": "要怎麼樣，",
          "sc": "要怎么样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 175346,
          "spk": "驹子 (コマコ)",
          "ja": "大人っぽくなるには",
          "tc": "才能像琪娜娜姐一樣",
          "sc": "才能像琪娜娜姐一样"
        },
        {
          "f_idx": 7,
          "pidx_tc": 175353,
          "spk": "驹子 (コマコ)",
          "ja": "どうしたらいいんだろう？",
          "tc": "變得成熟呢？",
          "sc": "变得成熟呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 175366,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なら、お姉さんからひとつ",
          "tc": "那就讓大姐姐",
          "sc": "那就让大姐姐"
        },
        {
          "f_idx": 9,
          "pidx_tc": 175373,
          "spk": "琪娜娜 (チナナ)",
          "ja": "アドバイスをしてあげようかな",
          "tc": "來給妳一個建議好了。",
          "sc": "来给你一个建议好了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 175386,
          "spk": "驹子 (コマコ)",
          "ja": "お、お願いします……！",
          "tc": "麻、麻煩妳了……！",
          "sc": "麻、麻烦你了……！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 175399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだね……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 175406,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なら好きな人を作ってみるといいよ",
          "tc": "妳可以試著去喜歡上誰喔！",
          "sc": "你可以试着去喜欢上谁哦！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 175419,
          "spk": "驹子 (コマコ)",
          "ja": "す、好きな人って……",
          "tc": "去、去喜歡誰……",
          "sc": "去、去喜欢谁……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 175432,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思い切って五人くらい",
          "tc": "乾脆一口氣喜歡上五個人的話，",
          "sc": "干脆一口气喜欢上五个人的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 175439,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きな人を作ってみたら",
          "tc": "說不定就能一舉登上",
          "sc": "说不定就能一举登上"
        },
        {
          "f_idx": 16,
          "pidx_tc": 175446,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一気に大人の階段を登れるかもね",
          "tc": "成為大人的階梯了呢。",
          "sc": "成为大人的阶梯了呢。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 175459,
          "spk": "驹子 (コマコ)",
          "ja": "ご、五人も……",
          "tc": "一、一口氣五個人……",
          "sc": "一、一口气五个人……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 175466,
          "spk": "驹子 (コマコ)",
          "ja": "大人ってすごい……",
          "tc": "大人還真厲害……",
          "sc": "大人还真厉害……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 175479,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ふふ、冗談だよ",
          "tc": "呵呵，開玩笑的啦。",
          "sc": "呵呵，开玩笑的啦。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 175486,
          "spk": "琪娜娜 (チナナ)",
          "ja": "可愛い反応をありがとう",
          "tc": "謝謝妳露出這麼可愛的反應。",
          "sc": "谢谢你露出这么可爱的反应。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 175499,
          "spk": "驹子 (コマコ)",
          "ja": "もう、チナナさん！",
          "tc": "真是的，琪娜娜姐怎麼這樣！",
          "sc": "真是的，琪娜娜姐怎么这样！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3317,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0044",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 175529,
          "spk": "四郎治 (シロージ)",
          "ja": "山入ってると、美味そうなキノコが",
          "tc": "一進到山裡，就可以看到",
          "sc": "一进到山里，就可以看到"
        },
        {
          "f_idx": 1,
          "pidx_tc": 175536,
          "spk": "四郎治 (シロージ)",
          "ja": "そこら中に生えてるから",
          "tc": "四處都長著看起來很美味的菇類，",
          "sc": "四处都长着看起来很美味的菇类，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 175543,
          "spk": "四郎治 (シロージ)",
          "ja": "つい食いたくなるんだよな",
          "tc": "真的會讓人忍不住想吃呢。",
          "sc": "真的会让人忍不住想吃呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 175556,
          "spk": "莲实 (ハスミ)",
          "ja": "え？　まさか……調べずにそのまま",
          "tc": "咦？你該不會……",
          "sc": "咦？你该不会……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 175563,
          "spk": "莲实 (ハスミ)",
          "ja": "食べているワケではありませんよね？",
          "tc": "完全沒確認就直接吃了吧？",
          "sc": "完全没确认就直接吃了吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 175576,
          "spk": "四郎治 (シロージ)",
          "ja": "さすがに、俺もそこまで食い意地は張ってないさ",
          "tc": "我還不至於那麼貪吃。",
          "sc": "我还不至于那么贪吃。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 175583,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカがデコッたような見た目のもあったしな",
          "tc": "況且有些菇類還長得像被茶梅裝飾過的一樣。",
          "sc": "况且有些菇类还长得像被茶梅装饰过的一样。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 175603,
          "spk": "茶梅 (サザンカ)",
          "ja": "マジで～？　そりゃ、猛毒だわ",
          "tc": "真的假的～？那一定有劇毒！",
          "sc": "真的假的～？那一定有剧毒！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 175610,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシとキノコのセンスが同じとかウケる",
          "tc": "我跟菇類的品味居然一樣，太好笑了～",
          "sc": "我跟菇类的品味居然一样，太好笑了～"
        },
        {
          "f_idx": 11,
          "pidx_tc": 175630,
          "spk": "四郎治 (シロージ)",
          "ja": "……毒キノコと一緒で、嬉しいか？",
          "tc": "……妳覺得跟毒菇是同類，很開心嗎？",
          "sc": "……你觉得跟毒菇是同类，很开心吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 175643,
          "spk": "莲实 (ハスミ)",
          "ja": "そこまでわかりやすければいいですけど",
          "tc": "要是真有那麼容易看出來就好了，",
          "sc": "要是真有那么容易看出来就好了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 175650,
          "spk": "莲实 (ハスミ)",
          "ja": "中には、判別が難しい種類もあります",
          "tc": "但也有一些菇類很難辨識。",
          "sc": "但也有一些菇类很难辨识。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 175668,
          "spk": "莲实 (ハスミ)",
          "ja": "シロージも、くれぐれも気をつけて……",
          "tc": "四郎治也要多多留意啊……",
          "sc": "四郎治也要多多留意啊……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 175681,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、わかってる",
          "tc": "嗯，這我知道。",
          "sc": "嗯，这我知道。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 175688,
          "spk": "四郎治 (シロージ)",
          "ja": "採らない、食わない、触らない",
          "tc": "不摘、不吃、不碰。",
          "sc": "不摘、不吃、不碰。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 175695,
          "spk": "四郎治 (シロージ)",
          "ja": "それでいいんだろ？",
          "tc": "這樣就可以了吧？",
          "sc": "这样就可以了吧？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 175708,
          "spk": "茶梅 (サザンカ)",
          "ja": "その毒キノコも、生き残るのに",
          "tc": "那些毒菇為了活下去，",
          "sc": "那些毒菇为了活下去，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 175715,
          "spk": "茶梅 (サザンカ)",
          "ja": "必死なんだろうね～",
          "tc": "應該也很拚命吧～",
          "sc": "应该也很拚命吧～"
        },
        {
          "f_idx": 21,
          "pidx_tc": 175724,
          "spk": "茶梅 (サザンカ)",
          "ja": "周りから変な目で見られても",
          "tc": "就算周圍都是異樣的眼光，",
          "sc": "就算周围都是异样的眼光，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 175731,
          "spk": "茶梅 (サザンカ)",
          "ja": "自分を変えるつもりはないんだよ、たぶん",
          "tc": "它們大概也不打算改變自己吧。",
          "sc": "它们大概也不打算改变自己吧。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 175751,
          "spk": "四郎治 (シロージ)",
          "ja": "少し癖があるくらいなら",
          "tc": "單純有點獨特的話，我完全不介意。",
          "sc": "单纯有点独特的话，我完全不介意。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 175758,
          "spk": "四郎治 (シロージ)",
          "ja": "全然構わないけどな、ただ……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 175771,
          "spk": "莲实 (ハスミ)",
          "ja": "毒となると話は別ですよ……",
          "tc": "說到毒就另當別論了……",
          "sc": "说到毒就另当别论了……"
        },
        {
          "f_idx": 27,
          "pidx_tc": 175778,
          "spk": "莲实 (ハスミ)",
          "ja": "最悪、命の危険がありますから",
          "tc": "最糟的情況下，甚至會危及生命的。",
          "sc": "最糟的情况下，甚至会危及生命的。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 175785,
          "spk": "莲实 (ハスミ)",
          "ja": "決して近づかないようにしましょうね",
          "tc": "所以記得千萬別靠近。",
          "sc": "所以记得千万别靠近。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3318,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0045",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 175815,
          "spk": "洋 (ヨウ)",
          "ja": "ふぅ～……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 175822,
          "spk": "洋 (ヨウ)",
          "ja": "あはは、とんだ、とんだ！",
          "tc": "啊哈哈！飛走了、飛走了！",
          "sc": "啊哈哈！飞走了、飞走了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 175835,
          "spk": "名护 (ナゴ)",
          "ja": "飛んだねぇ",
          "tc": "飛走了呢。",
          "sc": "飞走了呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 175842,
          "spk": "名护 (ナゴ)",
          "ja": "あんな遠くまで",
          "tc": "飛到那麼遠去了。",
          "sc": "飞到那么远去了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 175855,
          "spk": "洋 (ヨウ)",
          "ja": "もっと思いっきり吹けば",
          "tc": "要是我再用力一點吹，",
          "sc": "要是我再用力一点吹，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 175862,
          "spk": "洋 (ヨウ)",
          "ja": "あの雲まで届くかな？",
          "tc": "會不會飛到那朵雲那裡啊？",
          "sc": "会不会飞到那朵云那里啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 175875,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 175882,
          "spk": "名护 (ナゴ)",
          "ja": "どうだろうね",
          "tc": "這很難說呢。",
          "sc": "这很难说呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 175895,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと試してみる",
          "tc": "我來試試看。",
          "sc": "我来试试看。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 175902,
          "spk": "洋 (ヨウ)",
          "ja": "いくよー、ふぅ～……",
          "tc": "要吹囉──！呼～",
          "sc": "要吹喽——！呼～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 175915,
          "spk": "名护 (ナゴ)",
          "ja": "おっ……",
          "tc": "喔……",
          "sc": "喔……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 175922,
          "spk": "名护 (ナゴ)",
          "ja": "さっきより高く飛んだんじゃないか？",
          "tc": "是不是飛得比剛才更高了？",
          "sc": "是不是飞得比刚才更高了？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 175935,
          "spk": "洋 (ヨウ)",
          "ja": "うん！",
          "tc": "嗯！",
          "sc": "嗯！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 175942,
          "spk": "洋 (ヨウ)",
          "ja": "でも、途中で割れちゃった……",
          "tc": "不過，飛到一半就破掉了……",
          "sc": "不过，飞到一半就破掉了……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 175955,
          "spk": "名护 (ナゴ)",
          "ja": "もう一回やってみるといいさ",
          "tc": "可以再試一次啊！",
          "sc": "可以再试一次啊！"
        },
        {
          "f_idx": 15,
          "pidx_tc": 175962,
          "spk": "名护 (ナゴ)",
          "ja": "けどそれだけじゃ飽きるだろうから",
          "tc": "不過一直這樣玩也會膩吧，",
          "sc": "不过一直这样玩也会腻吧，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 175969,
          "spk": "名护 (ナゴ)",
          "ja": "他のシャボン玉も作ってみるのはどうかな？",
          "tc": "我們來吹吹看別種肥皂泡泡怎麼樣？",
          "sc": "我们来吹吹看别种肥皂泡泡怎么样？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 175982,
          "spk": "洋 (ヨウ)",
          "ja": "他のって？",
          "tc": "例如呢？",
          "sc": "例如呢？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 175995,
          "spk": "名护 (ナゴ)",
          "ja": "大きなシャボン玉を作って",
          "tc": "像是先吹一個大泡泡，",
          "sc": "像是先吹一个大泡泡，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 176002,
          "spk": "名护 (ナゴ)",
          "ja": "その中に小さなシャボン玉を作ったりとか",
          "tc": "再往裡面吹一個小泡泡之類的。",
          "sc": "再往里面吹一个小泡泡之类的。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 176015,
          "spk": "洋 (ヨウ)",
          "ja": "なにそれ、おもしろそう！",
          "tc": "哇！感覺好好玩！",
          "sc": "哇！感觉好好玩！"
        },
        {
          "f_idx": 21,
          "pidx_tc": 176022,
          "spk": "洋 (ヨウ)",
          "ja": "あとはあとは？",
          "tc": "還有呢還有呢？",
          "sc": "还有呢还有呢？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 176035,
          "spk": "名护 (ナゴ)",
          "ja": "そうだねぇ……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 23,
          "pidx_tc": 176042,
          "spk": "名护 (ナゴ)",
          "ja": "同じ大きさのシャボン玉を",
