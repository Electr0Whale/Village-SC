          "spk": "堇怜 (スミレ)",
          "ja": "すごく助かるんですけどぉ……",
          "tc": "我會很謝謝你的……",
          "sc": "我会很谢谢你的……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 176231,
          "spk": "六角 (ロッカク)",
          "ja": "まったく商売上手っスね",
          "tc": "你還真會做生意呢。",
          "sc": "你还真会做生意呐。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 176238,
          "spk": "六角 (ロッカク)",
          "ja": "いいでしょう、言い値で",
          "tc": "好吧，",
          "sc": "好吧，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 176245,
