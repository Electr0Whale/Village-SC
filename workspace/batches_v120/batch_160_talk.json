    {
      "file": "talk.dat",
      "rec_idx": 3321,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0048",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 176618,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねえヨウ～",
          "tc": "我說洋～",
          "sc": "我说洋～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 176625,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょいとお仕事を手伝ってくんない？",
          "tc": "有些工作想請妳幫忙可以嗎？",
          "sc": "有些工作想请你帮忙可以吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 176638,
          "spk": "洋 (ヨウ)",
          "ja": "うん、いいよ",
          "tc": "嗯，好啊。",
          "sc": "嗯，好啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 176645,
          "spk": "洋 (ヨウ)",
          "ja": "なにをお手伝いすればいい？",
          "tc": "我要幫忙做什麼呢？",
          "sc": "我要帮忙做什么呢？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 176658,
          "spk": "茶梅 (サザンカ)",
          "ja": "実はさ、そこの陳列棚にあるお菓子の",
          "tc": "老實說，那邊架上的點心，",
          "sc": "老实说，那边架上的点心，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 176665,
          "spk": "茶梅 (サザンカ)",
          "ja": "賞味期限が過ぎちゃいそうなんだよね",
          "tc": "保存期限就快到了。",
          "sc": "保存期限就快到了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 176674,
          "spk": "茶梅 (サザンカ)",
          "ja": "このままじゃ誰にも買われず",
          "tc": "要是再沒有人來買，",
          "sc": "要是再没有人来买，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 176681,
          "spk": "茶梅 (サザンカ)",
          "ja": "廃棄処分か私の腹の中に",
          "tc": "恐怕只能報廢",
          "sc": "恐怕只能报废"
        },
        {
          "f_idx": 8,
          "pidx_tc": 176688,
          "spk": "茶梅 (サザンカ)",
          "ja": "入ることになるから……",
          "tc": "或是進我的肚子了……",
          "sc": "或是进我的肚子了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 176701,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが買えばいいんだ！",
          "tc": "我來買就好了對吧！",
          "sc": "我来买就好了对吧！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 176714,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちゃうちゃう",
          "tc": "不是啦不是啦～",
          "sc": "不是啦不是啦～"
        },
        {
          "f_idx": 11,
          "pidx_tc": 176721,
          "spk": "茶梅 (サザンカ)",
          "ja": "捨てるのはもったいないから",
          "tc": "我是覺得報廢太可惜了，",
          "sc": "我是觉得报废太可惜了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 176728,
          "spk": "茶梅 (サザンカ)",
          "ja": "ヨウに食べてほしいってわけ",
          "tc": "所以想請妳幫忙吃。",
          "sc": "所以想请你帮忙吃。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 176741,
          "spk": "洋 (ヨウ)",
          "ja": "え、でも、お金払わないと",
          "tc": "咦？可是沒有付錢的話，",
          "sc": "咦？可是没有付钱的话，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 176748,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんに怒られちゃうよ……",
          "tc": "叔叔會生氣的……",
          "sc": "叔叔会生气的……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 176761,
          "spk": "茶梅 (サザンカ)",
          "ja": "いいのいいの",
          "tc": "沒關係沒關係～",
          "sc": "没关系没关系～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 176768,
          "spk": "茶梅 (サザンカ)",
          "ja": "どーせ誰も買わないだろうし、",
          "tc": "反正應該也不會有人買了，",
          "sc": "反正应该也不会有人买了，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 176775,
          "spk": "茶梅 (サザンカ)",
          "ja": "お菓子もヨウに食べられる方がいいっしょ",
          "tc": "而且點心也比較想讓洋吃掉吧。",
          "sc": "而且点心也比较想让洋吃掉吧。"
        },
        {
          "f_idx": 18,
