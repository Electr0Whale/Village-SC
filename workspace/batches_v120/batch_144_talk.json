          "pidx_tc": 98750,
          "spk": "堇怜 (スミレ)",
          "ja": "彼ヶ津村周回耐久マラソンしたんだ",
          "tc": "進行了彼津村耐力路跑。",
          "sc": "进行了彼津村耐力路跑。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98757,
          "spk": "堇怜 (スミレ)",
          "ja": "もちろん、僕の勝ちだったよ",
          "tc": "最後當然是我贏啦。",
          "sc": "最后当然是我赢啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98768,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も一緒にどう？",
          "tc": "<player>要不要也一起來比比看啊？",
          "sc": "<player>要不要也一起来比比看啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
