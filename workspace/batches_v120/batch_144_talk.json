        {
          "f_idx": 3,
          "pidx_tc": 98848,
          "spk": "堇怜 (スミレ)",
          "ja": "……また今度かな",
          "tc": "……還是下次再說吧。",
          "sc": "……还是下次再说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
