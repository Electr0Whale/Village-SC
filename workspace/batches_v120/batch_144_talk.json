      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98656,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98663,
          "spk": "堇怜 (スミレ)",
          "ja": "木陰で雨宿りしたいの？",
          "tc": "你想在樹下躲雨嗎？",
          "sc": "你想在树下躲雨吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98681,
          "spk": "堇怜 (スミレ)",
          "ja": "水が跳ねたらごめんよ",
          "tc": "如果水濺到你就抱歉了。",
          "sc": "如果水溅到你就抱歉了。"
        }
      ]
    },
    {
      "file": "talk.dat",
