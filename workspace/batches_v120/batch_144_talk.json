      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98994,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがにちょっと眠くなってきたな……",
          "tc": "開始有點睏了啊……",
          "sc": "开始有点困了啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99005,
          "spk": "堇怜 (スミレ)",
          "ja": "寝る前に水を飲んでおこう……",
          "tc": "睡覺前先喝杯水吧……",
          "sc": "睡觉前先喝杯水吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2735,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99036,
          "spk": "堇怜 (スミレ)",
          "ja": "うう……寝付けないや……",
          "tc": "唔……睡不著……",
          "sc": "唔……睡不着……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99043,
          "spk": "堇怜 (スミレ)",
          "ja": "空気がじめっとしてて蒸し暑いな……",
          "tc": "空氣潮濕又悶熱……",
          "sc": "空气潮湿又闷热……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2736,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99067,
          "spk": "堇怜 (スミレ)",
          "ja": "残念ながら、",
          "tc": "很可惜，",
          "sc": "很可惜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99074,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は一日中雨なんだって",
          "tc": "聽說今天一整天都會下雨。",
          "sc": "听说今天一整天都会下雨。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99085,
          "spk": "堇怜 (スミレ)",
          "ja": "それならちょっとは",
          "tc": "不過這樣天氣也許會",
          "sc": "不过这样天气也许会"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99092,
          "spk": "堇怜 (スミレ)",
          "ja": "涼しくなるかもね",
          "tc": "稍微涼快一點吧。",
          "sc": "稍微凉快一点吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2737,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99116,
          "spk": "堇怜 (スミレ)",
          "ja": "こうも暑いと、アイスか",
          "tc": "天氣熱成這樣，就會很想吃冰，",
          "sc": "天气热成这样，就会很想吃冰，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99123,
          "spk": "堇怜 (スミレ)",
          "ja": "冷やしたスイカが食べたくなるよ",
          "tc": "或是冰鎮過的西瓜呢。",
          "sc": "或是冰镇过的西瓜呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99134,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、節約しないといけないしなぁ",
          "tc": "但我又得省錢。",
          "sc": "但我又得省钱。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2738,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99158,
          "spk": "堇怜 (スミレ)",
          "ja": "ユータさんから、一緒にカブトムシを",
          "tc": "裕太哥約我",
          "sc": "裕太哥约我"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99165,
          "spk": "堇怜 (スミレ)",
          "ja": "捕まえに行こうって誘われてるんだ",
          "tc": "一起去抓獨角仙。",
          "sc": "一起去抓独角仙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99176,
          "spk": "堇怜 (スミレ)",
          "ja": "せっかくならデカいのを捕まえたいよな",
          "tc": "真想趁這個機會抓隻大隻的。",
          "sc": "真想趁这个机会抓只大只的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2739,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99207,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、水分は摂ってる？",
          "tc": "<player>，你有好好補充水分嗎？",
          "sc": "<player>，你有好好补充水分吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99225,
          "spk": "堇怜 (スミレ)",
          "ja": "暑いときはこまめに飲んだほうがいいって",
          "tc": "姊姊說過，天氣熱的時候",
          "sc": "姐姐说过，天气热的时候"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99232,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが言ってたよ",
          "tc": "最好要隨時補充水分。",
          "sc": "最好要随时补充水分。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2740,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99263,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は雨降りだからか、",
          "tc": "也許是因為今天下雨，",
          "sc": "也许是因为今天下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99270,
          "spk": "堇怜 (スミレ)",
          "ja": "さっき小さいカエルを見かけたんだ",
          "tc": "我在河邊看到了小小的青蛙。",
          "sc": "我在河边看到了小小的青蛙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99281,
          "spk": "堇怜 (スミレ)",
          "ja": "何考えてるのかわかんないけど、",
          "tc": "不知道牠在想什麼，",
          "sc": "不知道它在想什么，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99288,
          "spk": "堇怜 (スミレ)",
          "ja": "全然逃げなくて……食べてほしかったのかな？",
          "tc": "竟然完全不逃走……是想要我吃牠嗎？",
          "sc": "竟然完全不逃走……是想要我吃它吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2741,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99319,
          "spk": "堇怜 (スミレ)",
          "ja": "夏は脂が乗ったアユを釣れるのが",
          "tc": "夏天就是能釣到肥美香魚這點",
          "sc": "夏天就是能钓到肥美香鱼这点"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99326,
          "spk": "堇怜 (スミレ)",
          "ja": "いいところだよな～",
          "tc": "最棒了～",
          "sc": "最棒了～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99333,
          "spk": "堇怜 (スミレ)",
          "ja": "想像したらお腹が減ってきたよ",
          "tc": "光是想到就肚子餓了呢。",
          "sc": "光是想到就肚子饿了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2742,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99357,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、暑くて参ってない？",
          "tc": "<player>，你是不是熱得受不了？",
          "sc": "<player>，你是不是热得受不了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99364,
          "spk": "堇怜 (スミレ)",
          "ja": "涼みたくなったら川遊びでもしようよ",
          "tc": "想要消暑的話，就去河邊玩吧。",
          "sc": "想要消暑的话，就去河边玩吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99382,
          "spk": "堇怜 (スミレ)",
          "ja": "この時期でも心臓が止まるぐらい冷たいんだぜ！",
          "tc": "即使是這個季節也冰到嚇死人喔！",
          "sc": "即使是这个季节也冰到吓死人哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 99389,
          "spk": "堇怜 (スミレ)",
          "ja": "きっと死ぬほど涼しくなれるよ！",
          "tc": "肯定涼死你！",
          "sc": "肯定凉死你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2743,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99420,
          "spk": "堇怜 (スミレ)",
          "ja": "あちこちでセミを見かけるよな",
          "tc": "到處都可以看到蟬呢。",
          "sc": "到处都可以看到蝉呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99431,
          "spk": "堇怜 (スミレ)",
          "ja": "暇な日にでもヨウを誘って",
          "tc": "哪天有空",
          "sc": "哪天有空"
