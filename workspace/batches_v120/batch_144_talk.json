        {
          "f_idx": 1,
          "pidx_tc": 98712,
          "spk": "堇怜 (スミレ)",
          "ja": "しっかり身体は動かしておいたほうがいいよ",
          "tc": "你也要好好活動筋骨喔！",
          "sc": "你也要好好活动筋骨哦！"
        }
      ]
    },
    {
