          "pidx_tc": 99438,
          "spk": "堇怜 (スミレ)",
          "ja": "捕まえに行こうかな",
          "tc": "就約洋一起去抓蟬好了。",
          "sc": "就约洋一起去抓蝉好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2744,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99462,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は雨が止むといいなぁ",
          "tc": "真希望明天不要下雨。",
          "sc": "真希望明天不要下雨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99473,
          "spk": "堇怜 (スミレ)",
          "ja": "からっと晴れたせいで",
          "tc": "雖然要是突然出大太陽，",
          "sc": "虽然要是突然出大太阳，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99480,
          "spk": "堇怜 (スミレ)",
          "ja": "暑くなっても困るんだけどさ",
          "tc": "天氣變得超熱也很困擾就是了。",
          "sc": "天气变得超热也很困扰就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2745,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99511,
          "spk": "堇怜 (スミレ)",
          "ja": "夏だからって肝試しでもしようとしてる？",
          "tc": "你是因為夏天到了，所以出來試膽嗎？",
          "sc": "你是因为夏天到了，所以出来试胆吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99518,
          "spk": "堇怜 (スミレ)",
          "ja": "もう遅いから帰ったほうがいいと思うよ",
          "tc": "但已經很晚了，還是快點回家比較好。",
          "sc": "但已经很晚了，还是快点回家比较好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2746,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99549,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はもう終わりだね",
          "tc": "今天要結束了啊。",
          "sc": "今天要结束了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99556,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は何をしようかな",
          "tc": "明天要做什麼好呢……",
          "sc": "明天要做什么好呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99567,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコに弓を教えてもらおうかな？",
          "tc": "要請駒子教我練習射箭嗎？",
          "sc": "要请驹子教我练习射箭吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99574,
          "spk": "堇怜 (スミレ)",
          "ja": "それとも釣りをしに行こうかな？",
          "tc": "還是去釣魚呢？",
          "sc": "还是去钓鱼呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2747,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99598,
          "spk": "堇怜 (スミレ)",
          "ja": "昼間よりは涼しくなってきたかな",
          "tc": "感覺比白天涼快多了。",
          "sc": "感觉比白天凉快多了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99616,
          "spk": "堇怜 (スミレ)",
          "ja": "ずっとこのくらいの気温なら",
          "tc": "如果一直都是這樣的氣溫就好了，",
          "sc": "如果一直都是这样的气温就好了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 99623,
          "spk": "堇怜 (スミレ)",
          "ja": "行動しやすくっていいのに",
          "tc": "活動起來會更舒服。",
          "sc": "活动起来会更舒服。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2748,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99647,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん、美味しいなぁ",
          "tc": "嗯～真好吃。",
          "sc": "嗯～真好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99658,
          "spk": "堇怜 (スミレ)",
          "ja": "おかわりしたばっかりなのに、",
          "tc": "明明才剛添過一碗，",
          "sc": "明明才刚添过一碗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99665,
          "spk": "堇怜 (スミレ)",
          "ja": "まだまだ食べられそうだよ",
          "tc": "但感覺我還能吃更多呢。",
          "sc": "但感觉我还能吃更多呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2749,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99689,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさんにもらったキノコを使った汁物、",
          "tc": "用四郎治哥給我的蘑菇做成的湯，",
          "sc": "用四郎治哥给我的蘑菇做成的汤，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99696,
          "spk": "堇怜 (スミレ)",
          "ja": "いい味が出てるんだよな",
          "tc": "味道很好呢。",
          "sc": "味道很好呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2750,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99720,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ栗ごはんを",
          "tc": "開始想吃",
          "sc": "开始想吃"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99727,
          "spk": "堇怜 (スミレ)",
          "ja": "食べたいんだけど……",
          "tc": "栗子飯了……",
          "sc": "栗子饭了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99734,
          "spk": "堇怜 (スミレ)",
          "ja": "山のどっかでたくさん拾えないかな？",
          "tc": "不知道山上有沒有哪裡可以撿到很多栗子？",
          "sc": "不知道山上有没有哪里可以捡到很多栗子？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2751,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99758,
          "spk": "堇怜 (スミレ)",
          "ja": "食べられる木の実と、食べられない木の実",
          "tc": "可以吃的果實跟不能吃的果實，",
          "sc": "可以吃的果实跟不能吃的果实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99765,
          "spk": "堇怜 (スミレ)",
          "ja": "選別なら僕に任せてよ",
          "tc": "就交給我來分辨吧。",
          "sc": "就交给我来分辨吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2752,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99796,
          "spk": "堇怜 (スミレ)",
          "ja": "美味しい木の実をたくさん拾って、",
          "tc": "要是能撿到很多好吃的果實，",
          "sc": "要是能捡到很多好吃的果实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99803,
          "spk": "堇怜 (スミレ)",
          "ja": "ご飯に使えるといいな",
          "tc": "然後能拿來做飯的話就好了。",
          "sc": "然后能拿来做饭的话就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2753,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99827,
          "spk": "堇怜 (スミレ)",
          "ja": "前にロッカクさんに作ってもらった",
          "tc": "之前拜託六角叔用樹果做點心給我，",
          "sc": "之前拜托六角叔用树果做点心给我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99834,
