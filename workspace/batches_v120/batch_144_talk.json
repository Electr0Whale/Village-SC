      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98131,
          "spk": "堇怜 (スミレ)",
          "ja": "夏の川魚は美味いんだよね",
          "tc": "夏天的淡水魚很好吃喔。",
          "sc": "夏天的淡水鱼很好吃哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98149,
          "spk": "堇怜 (スミレ)",
          "ja": "一番美味そうなのが",
          "tc": "要是能釣到",
          "sc": "要是能钓到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98156,
          "spk": "堇怜 (スミレ)",
          "ja": "釣れるといいけど……",
          "tc": "看起來最好吃的就好了……",
          "sc": "看起来最好吃的就好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2714,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98180,
          "spk": "堇怜 (スミレ)",
          "ja": "水温が上がってるせいで",
          "tc": "四郎治哥之前說過，",
          "sc": "四郎治哥之前说过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98187,
          "spk": "堇怜 (スミレ)",
          "ja": "魚も夏バテしてるかもしれないって",
          "tc": "因為水溫上升了，",
          "sc": "因为水温上升了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98194,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさんが言ってたよ",
          "tc": "所以說不定連魚也會熱到不想動。",
          "sc": "所以说不定连鱼也会热到不想动。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2715,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98218,
          "spk": "堇怜 (スミレ)",
          "ja": "うう、お腹減った……",
          "tc": "嗚，肚子好餓喔……",
          "sc": "呜，肚子好饿哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98229,
          "spk": "堇怜 (スミレ)",
          "ja": "大きいアマゴが釣れないかな……",
          "tc": "釣不到大隻的淡水石川鮭嗎……",
          "sc": "钓不到大只的淡水石川鲑吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98236,
          "spk": "堇怜 (スミレ)",
          "ja": "塩をまぶしてじっくり焼いて、",
          "tc": "真想要撒上鹽慢慢烤，",
          "sc": "真想要撒上盐慢慢烤，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98243,
          "spk": "堇怜 (スミレ)",
          "ja": "思いっきりかぶりつきたいよ……",
          "tc": "然後大快朵頤一番……",
          "sc": "然后大快朵颐一番……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2716,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98267,
          "spk": "堇怜 (スミレ)",
          "ja": "早いところ大きい魚が釣れないと",
          "tc": "不趕快釣到大魚的話，",
          "sc": "不赶快钓到大鱼的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98274,
          "spk": "堇怜 (スミレ)",
          "ja": "暑さで倒れそう……",
          "tc": "感覺我就要熱到昏倒了……",
          "sc": "感觉我就要热到昏倒了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2717,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98305,
          "spk": "堇怜 (スミレ)",
          "ja": "もう少し粘っても釣れなかったら、",
          "tc": "要是再堅持一下還是沒釣到，",
          "sc": "要是再坚持一下还是没钓到，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98312,
          "spk": "堇怜 (スミレ)",
          "ja": "サザンカさんのお店に涼みにいこうかなぁ",
          "tc": "就去茶梅姐的店裡納涼好了～",
          "sc": "就去茶梅姐的店里纳凉好了～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2718,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98336,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はオイカワがたくさん釣れたから、",
          "tc": "今天釣到了很多日本溪哥，",
          "sc": "今天钓到了很多日本溪哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98343,
          "spk": "堇怜 (スミレ)",
          "ja": "唐揚げにして食べるんだ！",
          "tc": "我要炸來吃！",
          "sc": "我要炸来吃！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98350,
          "spk": "堇怜 (スミレ)",
          "ja": "いつもより夕飯が豪華になるぞ……！",
          "tc": "晚餐會比平常來得豪華喔……！",
          "sc": "晚餐会比平常来得豪华哦……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2719,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98374,
          "spk": "堇怜 (スミレ)",
          "ja": "魚料理が一品二品……",
          "tc": "魚料理有一道、兩道……",
          "sc": "鱼料理有一道、两道……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98385,
          "spk": "堇怜 (スミレ)",
          "ja": "これだけあれば夏バテ気味の",
          "tc": "有了這些，我想就算是快熱昏頭的姊姊，",
          "sc": "有了这些，我想就算是快热昏头的姐姐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98392,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんも元気になるはずだよな",
          "tc": "吃了應該也能打起精神吧。",
          "sc": "吃了应该也能打起精神吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2720,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98416,
          "spk": "堇怜 (スミレ)",
          "ja": "塩焼きが一番美味いけど、",
          "tc": "雖然鹽烤還是最好吃的，",
          "sc": "虽然盐烤还是最好吃的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98423,
          "spk": "堇怜 (スミレ)",
          "ja": "たまには凝った料理も悪くないよね",
          "tc": "但偶爾吃些精緻的料理也不錯。",
          "sc": "但偶尔吃些精致的料理也不错。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2721,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98454,
          "spk": "堇怜 (スミレ)",
          "ja": "釣り具の手入れは、",
          "tc": "保養釣具",
          "sc": "保养钓具"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98461,
          "spk": "堇怜 (スミレ)",
          "ja": "大体こんな感じで大丈夫かな……",
          "tc": "差不多這樣就可以了吧……",
          "sc": "差不多这样就可以了吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98472,
          "spk": "堇怜 (スミレ)",
          "ja": "今度キスケさんにも見てもらおっと",
          "tc": "下次也請木助哥幫我看看好了。",
          "sc": "下次也请木助哥帮我看看好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2722,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98503,
          "spk": "堇怜 (スミレ)",
          "ja": "大きな魚を釣るためにも",
          "tc": "為了能釣到大魚，",
          "sc": "为了能钓到大鱼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98510,
          "spk": "堇怜 (スミレ)",
          "ja": "手入れは欠かさずしないとね……",
          "tc": "也必須勤奮地保養釣具才行……",
          "sc": "也必须勤奋地保养钓具才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2723,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98534,
          "spk": "堇怜 (スミレ)",
          "ja": "うわ……",
          "tc": "嗚哇……",
          "sc": "呜哇……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98541,
          "spk": "堇怜 (スミレ)",
          "ja": "釣り竿、ちょっと傷がついてるような……",
          "tc": "釣桿上好像有一點傷痕……",
          "sc": "钓杆上好像有一点伤痕……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98552,
          "spk": "堇怜 (スミレ)",
          "ja": "折れる前に直さないと……",
          "tc": "得在斷掉之前修好才行……",
          "sc": "得在断掉之前修好才行……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98559,
          "spk": "堇怜 (スミレ)",
          "ja": "これくらいは僕でも直せそうだな",
          "tc": "這點損傷感覺我就能修好。",
          "sc": "这点损伤感觉我就能修好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2724,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98583,
          "spk": "堇怜 (スミレ)",
          "ja": "ひゃー……今日はすごい雨だな",
          "tc": "哇……今天雨還真大……",
          "sc": "哇……今天雨还真大……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98590,
          "spk": "堇怜 (スミレ)",
          "ja": "じめじめしてて気持ち悪いね",
          "tc": "又濕又悶的，真鬱悶。",
          "sc": "又湿又闷的，真郁闷。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2725,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_2201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98614,
          "spk": "堇怜 (スミレ)",
          "ja": "雨だけど……雨だけど……",
