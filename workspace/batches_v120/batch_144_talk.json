        {
          "f_idx": 1,
          "pidx_tc": 98963,
          "spk": "堇怜 (スミレ)",
          "ja": "こんな大きいスイカ、",
          "tc": "這麼大顆的西瓜，",
          "sc": "这么大颗的西瓜，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98970,
          "spk": "堇怜 (スミレ)",
          "ja": "一人じゃ食べきれないよ……",
          "tc": "我沒辦法自己吃完啦……",
          "sc": "我没办法自己吃完啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
