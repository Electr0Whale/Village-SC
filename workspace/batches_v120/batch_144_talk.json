        {
          "f_idx": 2,
          "pidx_tc": 98932,
          "spk": "堇怜 (スミレ)",
          "ja": "これならいくらでも食べられそうだね！",
          "tc": "這樣的話要我吃多少都沒問題！",
          "sc": "这样的话要我吃多少都没问题！"
