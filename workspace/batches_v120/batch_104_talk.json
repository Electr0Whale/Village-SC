      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118609,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコの持っていった傘",
          "tc": "駒子帶著的傘",
          "sc": "驹子带着的伞"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118616,
          "spk": "四郎治 (シロージ)",
          "ja": "壊れたやつじゃないよな？",
          "tc": "應該不是壞掉的那把吧？",
          "sc": "应该不是坏掉的那把吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118627,
          "spk": "四郎治 (シロージ)",
          "ja": "あとで壊れた傘は捨てとくか……",
          "tc": "等等把壞掉的傘拿去丟掉好了……",
          "sc": "等等把坏掉的伞拿去丢掉好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 526,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1012",
      "lines": [
