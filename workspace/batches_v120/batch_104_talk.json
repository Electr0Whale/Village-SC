        {
          "f_idx": 1,
          "pidx_tc": 118547,
          "spk": "四郎治 (シロージ)",
          "ja": "我ながらいい仕事をしたぜ",
          "tc": "我這工作做得還滿不錯的嘛。",
          "sc": "我这工作做得还满不错的嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 524,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118578,
          "spk": "四郎治 (シロージ)",
          "ja": "しばらく止みそうにないな……",
          "tc": "短時間之內雨好像不會停啊……",
