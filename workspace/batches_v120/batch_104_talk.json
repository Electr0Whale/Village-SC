          "ja": "お疲れ、<player>",
          "tc": "辛苦了，<player>，",
          "sc": "辛苦了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 117933,
          "spk": "四郎治 (シロージ)",
          "ja": "ずっと見てたけど悪くなかったぞ",
          "tc": "我剛剛一直在看你，你表現還滿不錯的。",
          "sc": "我刚刚一直在看你，你表现还满不错的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 117949,
          "spk": "四郎治 (シロージ)",
          "ja": "次があればいい評価になる気がしてる",
          "tc": "如果有下次，我想你會得到更好的評價，",
          "sc": "如果有下次，我想你会得到更好的评价，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 117956,
          "spk": "四郎治 (シロージ)",
          "ja": "お前の馬と一緒に気張っていけよ",
          "tc": "你就跟你的馬一起繼續加油吧。",
          "sc": "你就跟你的马一起继续加油吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 514,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 117987,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、どうしたんだ？",
          "tc": "<player>，怎麼了嗎？",
          "sc": "<player>，怎么了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 117998,
          "spk": "四郎治 (シロージ)",
          "ja": "ん？ なんだこれ……",
          "tc": "嗯？這是什麼……",
          "sc": "嗯？这是什么……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118005,
          "spk": "四郎治 (シロージ)",
          "ja": "もしかして俺にくれるのか",
          "tc": "難道是要送我的嗎？",
          "sc": "难道是要送我的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118016,
          "spk": "四郎治 (シロージ)",
          "ja": "へえ、いいセンスしてるじゃん",
          "tc": "哦，你品味很好嘛，",
          "sc": "哦，你品味很好嘛，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118023,
          "spk": "四郎治 (シロージ)",
          "ja": "気に入ったぜ",
          "tc": "我喜歡。",
          "sc": "我喜欢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118034,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがとな",
          "tc": "謝啦，",
          "sc": "谢啦，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118041,
          "spk": "四郎治 (シロージ)",
          "ja": "遠慮なくもらっとくよ",
          "tc": "那我就不客氣地收下了！",
          "sc": "那我就不客气地收下了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 515,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118065,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>か、奇遇だな",
          "tc": "是<player>啊，真巧。",
          "sc": "是<player>啊，真巧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118076,
          "spk": "四郎治 (シロージ)",
          "ja": "プレゼントくれんのか？",
          "tc": "要送我禮物？",
          "sc": "要送我礼物？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118083,
          "spk": "四郎治 (シロージ)",
          "ja": "まぁ、気持ちは嬉しいが",
          "tc": "你有這心意我就很高興了。",
          "sc": "你有这心意我就很高兴了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118094,
          "spk": "四郎治 (シロージ)",
          "ja": "へえ、悪くないな……",
          "tc": "哦，還不錯嘛……",
          "sc": "哦，还不错嘛……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118103,
          "spk": "四郎治 (シロージ)",
          "ja": "それじゃ、これは受け取っておく",
          "tc": "那我就收下了。",
          "sc": "那我就收下了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118110,
          "spk": "四郎治 (シロージ)",
          "ja": "今度、何か礼でもさせてくれ",
          "tc": "下次再讓我答謝你吧。",
          "sc": "下次再让我答谢你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 516,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118134,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、何かそわそわしてるな",
          "tc": "<player>，你怎麼看起來有點緊張啊？",
          "sc": "<player>，你怎么看起来有点紧张啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118145,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、俺にプレゼントくれるのか",
          "tc": "喔，是要送我禮物嗎？",
          "sc": "喔，是要送我礼物吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118152,
          "spk": "四郎治 (シロージ)",
          "ja": "別に気を使わなくっていいのにさ",
          "tc": "你不必這麼費心的。",
          "sc": "你不必这么费心的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118163,
          "spk": "四郎治 (シロージ)",
          "ja": "ん？ これか……？",
          "tc": "嗯？你要送的就是這個嗎……？",
          "sc": "嗯？你要送的就是这个吗……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118170,
          "spk": "四郎治 (シロージ)",
          "ja": "渡す相手、間違ってねぇか？",
          "tc": "你是不是送錯人了？",
          "sc": "你是不是送错人了？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118181,
          "spk": "四郎治 (シロージ)",
          "ja": "いや、まあ別にいいや……",
          "tc": "不，算了……",
          "sc": "不，算了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118188,
          "spk": "四郎治 (シロージ)",
          "ja": "次からは変な気回さなくていいからな",
          "tc": "你以後就不用這麼多禮了。",
          "sc": "你以后就不用这么多礼了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 517,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118212,
          "spk": "四郎治 (シロージ)",
          "ja": "……ん？ ああ、今日は俺の誕生日か",
          "tc": "……嗯？喔，今天是我生日啊，",
          "sc": "……嗯？喔，今天是我生日啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118219,
          "spk": "四郎治 (シロージ)",
          "ja": "すっかり忘れてたぜ",
          "tc": "我都忘得一乾二淨了。",
          "sc": "我都忘得一干二净了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118230,
          "spk": "四郎治 (シロージ)",
          "ja": "プレゼントまで用意してくれて",
          "tc": "你還幫我準備了禮物，",
          "sc": "你还帮我准备了礼物，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118237,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがとうな、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118248,
          "spk": "四郎治 (シロージ)",
          "ja": "こういうのって中身が何でも",
          "tc": "不管是什麼樣的生日禮物，",
          "sc": "不管是什么样的生日礼物，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118255,
          "spk": "四郎治 (シロージ)",
          "ja": "もらえるだけで嬉しいもんだな",
          "tc": "能夠收到禮物就很令人開心了。",
          "sc": "能够收到礼物就很令人开心了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118264,
          "spk": "四郎治 (シロージ)",
          "ja": "気に入ったよ",
          "tc": "我很喜歡。",
          "sc": "我很喜欢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 118271,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがたく受け取っておくぜ",
          "tc": "那我滿懷感激地就收下了。",
          "sc": "那我满怀感激地就收下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 518,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118295,
          "spk": "四郎治 (シロージ)",
          "ja": "ここんとこよくプレゼントくれるけど、",
          "tc": "你最近常常送東西給我，",
          "sc": "你最近常常送东西给我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118302,
          "spk": "四郎治 (シロージ)",
          "ja": "一方的にもらってばっかってのもな",
          "tc": "但我也不好意思一直收啊，",
          "sc": "但我也不好意思一直收啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118309,
          "spk": "四郎治 (シロージ)",
          "ja": "また今度にしてくれ",
          "tc": "下次再說吧。",
          "sc": "下次再说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 519,
      "rec_id": "TALK_ID_LUMBERJACK_THUNDERSTORM_20_103_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118333,
          "spk": "四郎治 (シロージ)",
          "ja": "すごい雷雨だな……",
          "tc": "好大的雷雨啊……",
          "sc": "好大的雷雨啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118344,
          "spk": "四郎治 (シロージ)",
          "ja": "呑気な顔してると",
          "tc": "你要是再發呆，",
          "sc": "你要是再发呆，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118351,
          "spk": "四郎治 (シロージ)",
          "ja": "お前のとこに雷が落ちるかもしれないぞ",
          "tc": "雷可能會劈到你身上喔。",
          "sc": "小心雷劈到你身上啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118362,
          "spk": "四郎治 (シロージ)",
          "ja": "なんて、冗談だ",
          "tc": "我開玩笑的，",
          "sc": "我开玩笑的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118369,
          "spk": "四郎治 (シロージ)",
          "ja": "けど危ないのは本当だから早いところ帰れよ",
          "tc": "不過打雷真的很危險，你快點回家吧。",
          "sc": "不过打雷真的很危险，你快点回家吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 520,
      "rec_id": "TALK_ID_LUMBERJACK_THUNDERSTORM_20_103_0301",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118400,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、雷が怖くないのか？",
          "tc": "你不怕打雷嗎？",
          "sc": "你不怕打雷吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118407,
          "spk": "四郎治 (シロージ)",
          "ja": "勇ましいのはいいと思うけどな……",
          "tc": "這麼勇敢是很好啦……",
          "sc": "这么勇敢是很好啦……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118418,
          "spk": "四郎治 (シロージ)",
          "ja": "自然の力を甘く見ない方がいいぞ",
          "tc": "但勸你不要小看了大自然的威力喔。",
          "sc": "劝你别小看了大自然的威力啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118425,
          "spk": "四郎治 (シロージ)",
          "ja": "雷がおさまったらさっさと帰れよ",
          "tc": "等到沒有打雷了，你就趕快回去吧。",
          "sc": "等到没有打雷了，你就赶快回去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 521,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118456,
          "spk": "四郎治 (シロージ)",
          "ja": "さて、ひと仕事終わったな",
          "tc": "好了，做完這工作了。",
          "sc": "好了，做完这工作了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118467,
          "spk": "四郎治 (シロージ)",
          "ja": "こんだけいい薪なら",
          "tc": "這些木柴品質這麼好，",
          "sc": "这些木柴品质这么好，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118474,
          "spk": "四郎治 (シロージ)",
          "ja": "リンも文句は言わないだろ",
          "tc": "林看到應該也不會再抱怨了吧。",
          "sc": "林看到应该也不会再抱怨了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 522,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118498,
          "spk": "四郎治 (シロージ)",
          "ja": "ここに置いといて帰ったら",
          "tc": "如果我丟在這裡就走，",
          "sc": "如果我丢在这里就走，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118505,
          "spk": "四郎治 (シロージ)",
          "ja": "リンのヤツ、また怒るか……？",
          "tc": "林那傢伙應該又要生氣了吧……？",
          "sc": "林那家伙应该又要生气了吧……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118516,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱちゃんと伝えねぇと駄目か",
          "tc": "果然還是得跟她說一聲嗎。",
          "sc": "果然还是得跟她说一声吗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 523,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118540,
          "spk": "四郎治 (シロージ)",
          "ja": "からっと乾燥しててよく燃えそうだ",
          "tc": "這些木柴都很乾燥，感覺很能燒啊。",
          "sc": "这些木柴都很干燥，感觉很能烧啊。"
