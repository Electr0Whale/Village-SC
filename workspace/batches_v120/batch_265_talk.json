        {
          "f_idx": 1,
          "pidx_tc": 380510,
          "spk": "洋 (ヨウ)",
          "ja": "お話してくるね",
          "tc": "去找叔叔。",
          "sc": "去找叔叔。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7547,
      "rec_id": "TALK_ID_70_2110_005_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380536,
          "spk": "洋 (ヨウ)",
          "ja": "さっきはごめんなさい",
          "tc": "剛剛很對不起。",
          "sc": "刚刚很对不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 380543,
          "spk": "洋 (ヨウ)",
          "ja": "でも、おじちゃんも言い方が",
          "tc": "但叔叔的說法，",
          "sc": "但叔叔的说法，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380550,
          "spk": "洋 (ヨウ)",
          "ja": "ヒドかったと思う……",
          "tc": "我覺得也很過分……",
          "sc": "我觉得也很过分……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380563,
          "spk": "六角 (ロッカク)",
          "ja": "あ、はい……申し訳ないっス……",
          "tc": "啊，嗯……很抱歉……",
          "sc": "啊，嗯……很抱歉……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 380570,
          "spk": "六角 (ロッカク)",
          "ja": "ワシもちぃとばかり、言い方が悪かった",
          "tc": "我的用詞也有點不太恰當，",
          "sc": "我的用词也有点不太恰当，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 380581,
          "spk": "六角 (ロッカク)",
          "ja": "けど、物によっては本当に危なかったり",
          "tc": "只是有些東西真的會有危險",
          "sc": "只是有些东西真的会有危险"
        },
        {
          "f_idx": 6,
          "pidx_tc": 380588,
          "spk": "六角 (ロッカク)",
          "ja": "バッチいものもあるんで、気をつけてくださいね",
          "tc": "或是不太乾淨，還是要小心喔！",
          "sc": "或是不太干净，还是要小心呐！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 380608,
          "spk": "洋 (ヨウ)",
          "ja": "……うん、気をつける",
          "tc": "……嗯，我會注意。",
          "sc": "……嗯，我会注意。"
        }
      ]
    },
