  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7512,
      "rec_id": "TALK_ID_70_2110_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378777,
          "spk": "洋 (ヨウ)",
          "ja": "……本当はね？",
          "tc": "……其實啊，",
          "sc": "……其实啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378784,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも仲間に入れてほしいの",
          "tc": "我也想加入他們。",
          "sc": "我也想加入他们。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 378795,
          "spk": "洋 (ヨウ)",
          "ja": "スミレくんもユータさんも",
          "tc": "堇怜哥哥和裕太哥哥",
          "sc": "堇怜哥哥和裕太哥哥"
        },
        {
          "f_idx": 3,
          "pidx_tc": 378802,
          "spk": "洋 (ヨウ)",
          "ja": "時々、わたしとも遊んでくれるけど……",
          "tc": "雖然常常會和我一起玩……",
          "sc": "虽然常常会和我一起玩……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 378813,
          "spk": "洋 (ヨウ)",
          "ja": "「遊んでもらってる」って感じで",
          "tc": "但總覺得更像是「陪我玩」，",
          "sc": "但总觉得更像是“陪我玩”，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 378820,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが危なくないように",
          "tc": "為了避免發生危險，",
          "sc": "为了避免发生危险，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 378827,
          "spk": "洋 (ヨウ)",
          "ja": "合わせてもらってるなって、そう思うの",
          "tc": "感覺他們都在配合我。",
          "sc": "感觉他们都在配合我。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 378838,
          "spk": "洋 (ヨウ)",
          "ja": "それってちょっと寂しいよね",
          "tc": "那樣子讓我覺得有點寂寞。",
          "sc": "那样子让我觉得有点寂寞。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 378845,
          "spk": "洋 (ヨウ)",
          "ja": "でも、どうすればいいのかな",
          "tc": "但是我也不是很清楚，",
          "sc": "但是我也不是很清楚，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 378852,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、よくわかんなくって",
          "tc": "該怎麼樣才好……",
          "sc": "该怎么样才好……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 378861,
          "spk": "洋 (ヨウ)",
          "ja": "わたしでも大丈夫ってわかってもらえれば、",
          "tc": "只要讓他們知道我沒問題，",
          "sc": "只要让他们知道我没问题，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 378868,
          "spk": "洋 (ヨウ)",
          "ja": "仲間に入れてくれるのかな……",
          "tc": "他們是不是就會讓我加入呢……",
          "sc": "他们是不是就会让我加入呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7513,
      "rec_id": "TALK_ID_70_2110_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378886,
          "spk": "洋 (ヨウ)",
          "ja": "一度、ちゃんと話した方がいい？",
          "tc": "應該找機會，好好跟他們說？",
          "sc": "应该找机会，好好跟他们说？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7514,
      "rec_id": "TALK_ID_70_2110_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378904,
          "spk": "洋 (ヨウ)",
          "ja": "……そっか",
          "tc": "……這樣啊。",
          "sc": "……这样啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378911,
          "spk": "洋 (ヨウ)",
          "ja": "そうだよね",
          "tc": "也對。",
          "sc": "也对。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 378918,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、二人が戻ってきたら聞いてみるね",
          "tc": "等他們回來，我會問問看的。",
          "sc": "等他们回来，我会问问看的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7515,
      "rec_id": "TALK_ID_70_2110_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378944,
          "spk": "裕太 (ユータ)",
          "ja": "うーん",
          "tc": "這……",
          "sc": "这……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378951,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱり木の上に秘密基地を作るのは",
          "tc": "要在樹上蓋祕密基地",
          "sc": "要在树上盖秘密基地"
        },
        {
          "f_idx": 2,
          "pidx_tc": 378958,
          "spk": "裕太 (ユータ)",
          "ja": "けっこう大変だね",
          "tc": "果然沒那麼容易呢。",
          "sc": "果然没那么容易呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 378971,
          "spk": "堇怜 (スミレ)",
          "ja": "ユータさんがログハウスみたいにしたいとか",
          "tc": "還不都是因為裕太哥說",
          "sc": "还不都是因为裕太哥说"
        },
        {
          "f_idx": 4,
          "pidx_tc": 378978,
          "spk": "堇怜 (スミレ)",
          "ja": "言い出したからじゃないですか……",
          "tc": "要蓋得像小木屋一樣……",
          "sc": "要盖得像小木屋一样……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 378985,
          "spk": "堇怜 (スミレ)",
          "ja": "僕らだけじゃ無理ですって",
          "tc": "只靠我們哪有辦法啊。",
          "sc": "只靠我们哪有办法啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 378998,
          "spk": "裕太 (ユータ)",
          "ja": "……いっそ、先輩に協力してもらう？",
          "tc": "……還是乾脆請學長幫忙？",
          "sc": "……还是干脆请学长帮忙？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 379011,
          "spk": "堇怜 (スミレ)",
          "ja": "それ、一体幾らかかると――",
          "tc": "你知道那樣要花多少錢──",
          "sc": "你知道那样要花多少钱——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7516,
      "rec_id": "TALK_ID_70_2110_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379041,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、ヨウちゃん？　<player>まで",
          "tc": "咦，是小洋？連<player>也在。",
          "sc": "咦，是小洋？连<player>也在。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379048,
          "spk": "裕太 (ユータ)",
          "ja": "そんなところでなにやってるの？",
          "tc": "你們在那邊做什麼？",
          "sc": "你们在那边做什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7517,
      "rec_id": "TALK_ID_70_2110_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379073,
          "spk": "洋 (ヨウ)",
          "ja": "あ、えっと……",
          "tc": "啊，呃……",
          "sc": "啊，呃……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7518,
      "rec_id": "TALK_ID_70_2110_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379101,
          "spk": "洋 (ヨウ)",
          "ja": "あのね、二人とも",
          "tc": "那個，你們聽我說。",
          "sc": "那个，你们听我说。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379108,
          "spk": "洋 (ヨウ)",
          "ja": "今度、山に遊びに行く時は……",
          "tc": "下次，你們要去山裡玩的時候，",
          "sc": "下次，你们要去山里玩的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379115,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも、一緒に行って、いい？",
          "tc": "我也可以，一起去嗎？",
          "sc": "我也可以，一起去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7519,
      "rec_id": "TALK_ID_70_2110_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379143,
          "spk": "裕太 (ユータ)",
          "ja": "ついに気付かれちゃったかぁ",
          "tc": "結果還是被發現了啊～",
          "sc": "结果还是被发现了啊～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379150,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんには完成してから",
          "tc": "本來打算等完成之後",
          "sc": "本来打算等完成之后"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379157,
          "spk": "裕太 (ユータ)",
          "ja": "知らせようと思ってたんだけど",
          "tc": "再告訴小洋的。",
          "sc": "再告诉小洋的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379170,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は危ないから、",
          "tc": "我覺得太危險了，",
          "sc": "我觉得太危险了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379177,
          "spk": "堇怜 (スミレ)",
          "ja": "正直反対なんですけど……",
          "tc": "實在不贊成……",
          "sc": "实在不赞成……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379190,
          "spk": "裕太 (ユータ)",
          "ja": "そこは俺たちが見ていればいい話だしね",
          "tc": "只要我們好好盯著就沒事啦。",
          "sc": "只要我们好好盯着就没事啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 379197,
          "spk": "裕太 (ユータ)",
          "ja": "よーし、今からキミたちも仲間だ",
          "tc": "決定了，從現在開始你們也是夥伴。",
          "sc": "决定了，从现在开始你们也是伙伴。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 379204,
          "spk": "裕太 (ユータ)",
          "ja": "一緒に最高の秘密基地を作っちゃおう！",
          "tc": "一起打造出最棒的祕密基地吧！",
          "sc": "一起打造出最棒的秘密基地吧！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 379217,
          "spk": "洋 (ヨウ)",
          "ja": "秘密、基地……！",
          "tc": "祕密……基地……！",
          "sc": "秘密……基地……！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 379224,
          "spk": "洋 (ヨウ)",
          "ja": "そんなすごいことしてたんだ",
          "tc": "原來你們在做這麼厲害的事情啊。",
          "sc": "原来你们在做这么厉害的事情啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 379237,
          "spk": "堇怜 (スミレ)",
          "ja": "まあ、まだ木の上に足場置いたくらいだけどね",
          "tc": "但也才在樹上搭了個平台而已啦。",
          "sc": "但也才在树上搭了个平台而已啦。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 379244,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、ロッカクさんには許可取ってね？",
          "tc": "啊，不過還是要取得六角叔同意喔！",
          "sc": "啊，不过还是要取得六角叔同意哦！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 379251,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがに、ここは譲れない",
          "tc": "再怎樣這點也不能退讓。",
          "sc": "再怎样这点也不能退让。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7520,
      "rec_id": "TALK_ID_70_2110_003_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379275,
          "spk": "洋 (ヨウ)",
          "ja": "<player>が背中を押してくれたから、",
          "tc": "都是多虧有<player>推了我一把，",
          "sc": "都是多亏有<player>推了我一把，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379282,
          "spk": "洋 (ヨウ)",
          "ja": "言えたんだとおもう",
          "tc": "我才能說出來。",
          "sc": "我才能说出来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379289,
          "spk": "洋 (ヨウ)",
          "ja": "だから、その……",
          "tc": "所以，那個……",
          "sc": "所以，那个……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379300,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はわたしの、",
          "tc": "因為<player>是我",
          "sc": "因为<player>是我"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379307,
          "spk": "洋 (ヨウ)",
          "ja": "大事な友達だから……",
          "tc": "很重要的朋友……",
          "sc": "很重要的朋友……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379314,
          "spk": "洋 (ヨウ)",
          "ja": "今度はわたしのお部屋にも、遊びに来てね",
          "tc": "下次也到我房間來玩吧。",
          "sc": "下次也到我房间来玩吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7521,
      "rec_id": "TALK_ID_70_2110_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379338,
          "spk": "洋 (ヨウ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7522,
      "rec_id": "TALK_ID_70_2110_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379356,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379363,
          "spk": "洋 (ヨウ)",
          "ja": "遊びに来てくれたの？",
          "tc": "你來找我玩了嗎？",
          "sc": "你来找我玩了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379370,
          "spk": "洋 (ヨウ)",
          "ja": "待ってね、今片づけるから",
          "tc": "等等喔，我收拾一下。",
          "sc": "等等哦，我收拾一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7523,
      "rec_id": "TALK_ID_70_2110_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379388,
          "spk": "洋 (ヨウ)",
          "ja": "この鳥籠が気になるの？",
          "tc": "你對這個鳥籠很好奇嗎？",
          "sc": "你对这个鸟笼很好奇吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379395,
          "spk": "洋 (ヨウ)",
          "ja": "これはね、オワンがお休みするところ",
          "tc": "這個啊，是歐宛休息的地方。",
          "sc": "这个啊，是欧宛休息的地方。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379406,
          "spk": "洋 (ヨウ)",
          "ja": "鳥さんはね、お布団じゃなくて",
          "tc": "據說小鳥不是睡在床上，",
          "sc": "据说小鸟不是睡在床上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379413,
          "spk": "洋 (ヨウ)",
          "ja": "木とか枝につかまって眠るんだって",
          "tc": "而是停在木頭或樹枝上睡覺的喔。",
          "sc": "而是停在木头或树枝上睡觉的哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379420,
          "spk": "洋 (ヨウ)",
          "ja": "それにね、毎日の運動も大切で――",
          "tc": "還有啊，每天運動也很重要──",
          "sc": "还有啊，每天运动也很重要——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7524,
      "rec_id": "TALK_ID_70_2110_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379444,
          "spk": "六角 (ロッカク)",
          "ja": "おやおや、ヨウさん",
          "tc": "哎呀哎呀，洋妹妹。",
          "sc": "哎呀哎呀，洋妹妹。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379451,
          "spk": "六角 (ロッカク)",
          "ja": "もうすっかり鳥博士っスねえ",
          "tc": "妳簡直像位鳥博士呢。",
          "sc": "你简直像位鸟博士呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7525,
      "rec_id": "TALK_ID_70_2110_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379471,
          "spk": "洋 (ヨウ)",
          "ja": "オワンを飼うなら",
          "tc": "是叔叔說",
          "sc": "是叔叔说"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379478,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんと調べろって言ったのは、",
          "tc": "要養歐宛的話，",
          "sc": "要养欧宛的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379485,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんだよ",
          "tc": "就必須好好做功課的啊。",
          "sc": "就必须好好做功课的啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379496,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "オジチャンダヨ、オジチャンダヨ",
          "tc": "是叔叔說，是叔叔說。",
          "sc": "是叔叔说，是叔叔说。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379509,
          "spk": "六角 (ロッカク)",
          "ja": "おっと、こいつは旗色が悪いや",
          "tc": "哎呀，看來苗頭不對呢～",
          "sc": "哎呀，看来苗头不对呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379516,
          "spk": "六角 (ロッカク)",
          "ja": "じゃ、ワシは仕込みがありますんで",
