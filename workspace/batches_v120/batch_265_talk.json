          "pidx_tc": 381029,
          "spk": "洋 (ヨウ)",
          "ja": "今日はいっぱい遊ぼうね",
          "tc": "今天就來大玩特玩吧。",
          "sc": "今天就来大玩特玩吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7559,
      "rec_id": "TALK_ID_70_2110_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381045,
          "spk": "洋 (ヨウ)",
          "ja": "大丈夫だよ",
