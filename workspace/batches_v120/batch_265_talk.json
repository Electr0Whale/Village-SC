          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "イツマデ……イツマデ――",
          "tc": "要永遠……永遠──",
          "sc": "要永远……永远——"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380409,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "イツマデ、モ――",
          "tc": "永遠──",
          "sc": "永远——"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380416,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "ソノヒトトイッショニ、ナカヨクネ",
          "tc": "和那個人，當好朋友喔。",
          "sc": "和那个人，当好朋友哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 380423,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "ヨウチャン……",
          "tc": "洋妹妹……",
          "sc": "洋妹妹……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7545,
      "rec_id": "TALK_ID_70_2110_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380447,
          "spk": "洋 (ヨウ)",
          "ja": "オワン",
          "tc": "歐宛，",
          "sc": "欧宛，"
