      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380888,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "オヨウフク！　ヨゴレルッス！",
          "tc": "衣服！會弄髒！",
          "sc": "衣服！会弄脏！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 380895,
          "spk": "欧万 (オワン/鹦鹉)",
