    {
      "file": "talk.dat",
      "rec_idx": 7557,
      "rec_id": "TALK_ID_70_2110_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380933,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんはね、ちょっと心配性なの",
          "tc": "叔叔他啊，有點太愛操心了。",
          "sc": "叔叔他啊，有点太爱操心了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 380940,
          "spk": "洋 (ヨウ)",
          "ja": "いつも「お外で元気にあそぶっスよ」って",
          "tc": "明明每次都說",
          "sc": "明明每次都说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380947,
          "spk": "洋 (ヨウ)",
          "ja": "言ってるのに",
          "tc": "「要在外面玩得開心喔」。",
          "sc": "“要在外面玩得开心哦”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380958,
          "spk": "洋 (ヨウ)",
          "ja": "泥んこになって帰るとね",
          "tc": "但要是全身髒兮兮回去的話，",
          "sc": "但要是全身脏兮兮回去的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 380965,
          "spk": "洋 (ヨウ)",
          "ja": "「怪我はないっスか！？」って大騒ぎ",
          "tc": "又會大驚小怪喊說「有沒有受傷！？」",
          "sc": "又会大惊小怪喊说“有没有受伤！？”"
        },
        {
          "f_idx": 6,
          "pidx_tc": 380983,
          "spk": "洋 (ヨウ)",
          "ja": "わたしのこと、",
          "tc": "雖然我知道",
          "sc": "虽然我知道"
        },
        {
          "f_idx": 7,
          "pidx_tc": 380990,
          "spk": "洋 (ヨウ)",
          "ja": "大事にしてくれてるってことはわかるんだ……",
          "tc": "這是因為他很重視我……",
          "sc": "这是因为他很重视我……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 380997,
          "spk": "洋 (ヨウ)",
          "ja": "でも、ちょっと、大げさだよ……",
          "tc": "但還是有點太誇張了。",
          "sc": "但还是有点太夸张了。"
        }
      ]
    },
