          "tc": "我去的話感覺她會鬧彆扭……",
          "sc": "我去的话感觉她会闹别扭……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7543,
      "rec_id": "TALK_ID_70_2110_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380322,
          "spk": "洋 (ヨウ)",
          "ja": "……飛び出して、きちゃった……",
          "tc": "……不小心跑出來了……",
          "sc": "……不小心跑出来了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 380329,
          "spk": "洋 (ヨウ)",
          "ja": "ひどいよ、おじちゃん",
          "tc": "叔叔好過分，",
          "sc": "叔叔好过分，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380336,
          "spk": "洋 (ヨウ)",
          "ja": "わたしとオワンの宝物をゴミだなんて……",
          "tc": "竟然說我跟歐宛的寶物是垃圾……",
          "sc": "竟然说我跟欧宛的宝物是垃圾……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380347,
          "spk": "洋 (ヨウ)",
          "ja": "……でも、わたしも",
          "tc": "……但是，",
          "sc": "……但是，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 380354,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんとお話、しようとしてなかったな",
          "tc": "我也沒有試著好好跟他說。",
          "sc": "我也没有试着好好跟他说。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 380365,
          "spk": "洋 (ヨウ)",
          "ja": "でも、でも、でも――",
          "tc": "可是、可是、可是──",
          "sc": "可是、可是、可是——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7544,
      "rec_id": "TALK_ID_70_2110_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380389,
          "spk": "洋 (ヨウ)",
          "ja": "オワン……？",
          "tc": "歐宛……？",
