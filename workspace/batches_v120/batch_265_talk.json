          "spk": "洋 (ヨウ)",
          "ja": "これはオワンと見つけた、宝物だもん……",
          "tc": "明明是我和歐宛，一起找到的寶物……",
          "sc": "明明是我和欧宛，一起找到的宝物……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380201,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさん、聞いてます？",
          "tc": "洋妹妹，妳有在聽嗎？",
          "sc": "洋妹妹，你有在听吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380208,
          "spk": "六角 (ロッカク)",
          "ja": "部屋に飾るなら、ちゃんと洗った方が……って",
          "tc": "要放在房間裡的話，就該先清洗……",
