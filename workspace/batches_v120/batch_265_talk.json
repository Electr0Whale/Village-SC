          "sc": "那些话是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 380465,
          "spk": "洋 (ヨウ)",
          "ja": "……そうだよね",
          "tc": "……說得也是。",
          "sc": "……说得也是。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 380472,
          "spk": "洋 (ヨウ)",
          "ja": "すれ違ったら謝って、",
          "tc": "如果誤會了就該道歉，",
          "sc": "如果误会了就该道歉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 380479,
          "spk": "洋 (ヨウ)",
          "ja": "仲直りすればいいんだよね",
          "tc": "然後再和好就可以了。",
          "sc": "然后再和好就可以了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7546,
      "rec_id": "TALK_ID_70_2110_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380503,
          "spk": "洋 (ヨウ)",
          "ja": "わたし……おじちゃんと、",
