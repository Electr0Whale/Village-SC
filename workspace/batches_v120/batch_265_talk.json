          "tc": "說不定上面有很多細菌啊。",
          "sc": "说不定上面有很多细菌哟。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7541,
      "rec_id": "TALK_ID_70_2110_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 380181,
          "spk": "洋 (ヨウ)",
