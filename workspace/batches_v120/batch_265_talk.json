          "tc": "衣服弄髒了只要拿去洗就好。",
          "sc": "衣服弄脏了只要拿去洗就好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381063,
          "spk": "洋 (ヨウ)",
          "ja": "そんなことより今は、",
          "tc": "比起這個，現在更重要的，",
          "sc": "比起这个，现在更重要的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381070,
          "spk": "洋 (ヨウ)",
          "ja": "みんなで楽しく過ごすことのほうが大切だもんね",
          "tc": "是和大家一起度過開心的一天。",
          "sc": "是和大家一起度过开心的一天。"
        }
      ]
    },
