        {
          "f_idx": 18,
          "pidx_tc": 195219,
          "spk": "莲实 (ハスミ)",
          "ja": "私は医者などではありませんよ……",
          "tc": "我並不是什麼醫生……",
          "sc": "我并不是什么医生……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 195226,
          "spk": "莲实 (ハスミ)",
          "ja": "ただ、医学を少し学んだことがあり、",
          "tc": "只是稍微學過一點醫，",
          "sc": "只是稍微学过一点医，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 195233,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬を調合できる程度で……",
          "tc": "懂得調合漢方藥的程度而已……",
          "sc": "懂得调合汉方药的程度而已……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 195244,
          "spk": "莲实 (ハスミ)",
          "ja": "医師や薬剤師の免許を持っていないので、",
          "tc": "並沒有醫生或藥劑師的執照，",
          "sc": "并没有医生或药剂师的执照，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 195251,
          "spk": "莲实 (ハスミ)",
          "ja": "正式な治療はできないんですが……",
          "tc": "所以不能進行正式的治療……",
          "sc": "所以不能进行正式的治疗……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 195271,
          "spk": "驹子 (コマコ)",
          "ja": "でもハスミさんが塗ってくれるお薬は、",
          "tc": "不過，蓮實姐幫我們擦的藥",
          "sc": "不过，莲实姐帮我们擦的药"
        },
        {
          "f_idx": 25,
          "pidx_tc": 195278,
          "spk": "驹子 (コマコ)",
          "ja": "すごくよく効くんだよ",
          "tc": "都非常有效喔。",
          "sc": "都非常有效哦。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 195289,
          "spk": "驹子 (コマコ)",
          "ja": "私はよく怪我するから、",
          "tc": "我常常受傷，",
          "sc": "我常常受伤，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 195296,
          "spk": "驹子 (コマコ)",
          "ja": "いつもハスミさんにお世話になってるんだ……",
          "tc": "所以總是受到蓮實姐的照顧……",
          "sc": "所以总是受到莲实姐的照顾……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 195309,
          "spk": "莲实 (ハスミ)",
          "ja": "素人の手当てで構わないのであれば、",
          "tc": "只要你們不嫌棄我這個外行人的技術，",
          "sc": "只要你们不嫌弃我这个外行人的技术，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 195316,
          "spk": "莲实 (ハスミ)",
          "ja": "遠慮しないで来てください",
          "tc": "隨時都可以過來，不要客氣。",
          "sc": "随时都可以过来，不要客气。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 195323,
          "spk": "莲实 (ハスミ)",
          "ja": "怪我を放置するほうが、危険ですから",
          "tc": "畢竟放任傷口不管更危險。",
          "sc": "毕竟放任伤口不管更危险。"
        }
      ]
    },
