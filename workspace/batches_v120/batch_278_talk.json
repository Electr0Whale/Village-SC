    {
      "file": "talk.dat",
      "rec_idx": 7954,
      "rec_id": "TALK_ID_10_0101_008_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 195678,
          "spk": "？？？ (未知角色)",
          "ja": "おや、コマコちゃん",
          "tc": "哦？駒子，",
          "sc": "哦？驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 195685,
          "spk": "？？？ (未知角色)",
          "ja": "見慣れない子を連れてるね",
          "tc": "妳帶著一個沒看過的孩子啊。",
          "sc": "你带着一个没看过的孩子啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 195698,
          "spk": "驹子 (コマコ)",
          "ja": "こんにちは、ユータさん",
          "tc": "你好，裕太哥。",
          "sc": "你好，裕太哥。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 195705,
          "spk": "驹子 (コマコ)",
          "ja": "この子は<player>",
          "tc": "這孩子叫<player>。",
          "sc": "这孩子叫<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 195712,
          "spk": "驹子 (コマコ)",
          "ja": "さっき村に来たばかりなの",
          "tc": "才剛來到這個村子。",
          "sc": "才刚来到这个村子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 195725,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、ここに住むんだね！",
          "tc": "那麼，他會住在這裡對吧！",
          "sc": "那么，他会住在这里对吧！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 195732,
          "spk": "裕太 (ユータ)",
          "ja": "ここはいいところだよ～？",
          "tc": "這裡可是個好地方啊～",
          "sc": "这里可是个好地方啊～"
        },
        {
          "f_idx": 7,
          "pidx_tc": 195745,
          "spk": "驹子 (コマコ)",
          "ja": "ち、ちがうよユータさん",
          "tc": "不、不是啦，裕太哥。",
          "sc": "不、不是啦，裕太哥。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 195752,
          "spk": "驹子 (コマコ)",
          "ja": "この子は迷子なだけだから、",
          "tc": "這孩子只是迷路了，",
          "sc": "这孩子只是迷路了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 195759,
          "spk": "驹子 (コマコ)",
          "ja": "お家を探してあげなきゃいけないの",
          "tc": "所以得幫他找到該回去的地方。",
          "sc": "所以得帮他找到该回去的地方。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 195772,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、せっかく来たんだから",
          "tc": "咦？難得都來了，",
          "sc": "咦？难得都来了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 195779,
          "spk": "裕太 (ユータ)",
          "ja": "ゆっくり村暮らしを楽しめばいいのに",
          "tc": "悠閒享受村裡的生活也可以啊。",
          "sc": "悠闲享受村里的生活也可以啊。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 195799,
          "spk": "驹子 (コマコ)",
          "ja": "確かに、お家が見つかるまでは",
          "tc": "在我們找到他該回去的地方前，",
          "sc": "在我们找到他该回去的地方前，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 195806,
          "spk": "驹子 (コマコ)",
          "ja": "住むことになっちゃうだろうけど……",
          "tc": "是得住在這裡沒錯啦……",
          "sc": "是得住在这里没错啦……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 195826,
          "spk": "裕太 (ユータ)",
          "ja": "それは大変だ！",
          "tc": "那可不得了！",
          "sc": "那可不得了！"
        },
        {
          "f_idx": 17,
          "pidx_tc": 195833,
          "spk": "裕太 (ユータ)",
          "ja": "一度住めば、",
          "tc": "因為一旦住下來，",
          "sc": "因为一旦住下来，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 195840,
          "spk": "裕太 (ユータ)",
          "ja": "帰りたくなくなっちゃうだろうから！",
          "tc": "就會變得不想回去了啊！",
          "sc": "就会变得不想回去了啊！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 195853,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、<player>",
          "tc": "我說，<player>，",
          "sc": "我说，<player>，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 195860,
          "spk": "裕太 (ユータ)",
          "ja": "俺のことはユータって呼んで！",
          "tc": "你就叫我裕太吧！",
          "sc": "你就叫我裕太吧！"
        },
        {
          "f_idx": 21,
          "pidx_tc": 195867,
          "spk": "裕太 (ユータ)",
          "ja": "困ったことがあれば気軽に相談してね",
          "tc": "有什麼煩惱都可以盡量找我商量。",
          "sc": "有什么烦恼都可以尽量找我商量。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7955,
      "rec_id": "TALK_ID_10_0101_008_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 195895,
          "spk": "驹子 (コマコ)",
          "ja": "ところでユータさんは、",
          "tc": "話說回來，裕太哥，",
          "sc": "话说回来，裕太哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 195902,
          "spk": "驹子 (コマコ)",
          "ja": "ここで何してたの？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 195915,
          "spk": "裕太 (ユータ)",
          "ja": "先輩に相談しようと思って来たんだ",
          "tc": "我是來這裡找學長商量事情的。",
          "sc": "我是来这里找学长商量事情的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 195922,
          "spk": "裕太 (ユータ)",
          "ja": "昨日のお祭りの後片付け、",
          "tc": "因為昨天祭典的收拾善後工作",
          "sc": "因为昨天祭典的收拾善后工作"
        },
        {
          "f_idx": 4,
          "pidx_tc": 195929,
          "spk": "裕太 (ユータ)",
          "ja": "俺も手伝わせてほしくてね",
          "tc": "我也想幫點忙啊。",
          "sc": "我也想帮点忙啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 195942,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんが手伝わなくていいって",
          "tc": "我聽木助哥說",
          "sc": "我听木助哥说"
        },
        {
          "f_idx": 6,
          "pidx_tc": 195949,
          "spk": "驹子 (コマコ)",
          "ja": "言ってたけど……",
          "tc": "不需要幫忙的……",
          "sc": "不需要帮忙的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 195962,
          "spk": "裕太 (ユータ)",
          "ja": "俺、いつもなにもしてないから",
          "tc": "我平時什麼都沒做，",
          "sc": "我平时什么都没做，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 195969,
          "spk": "裕太 (ユータ)",
          "ja": "たまには、片付けまで参加したいんだ",
          "tc": "偶爾也想要參與到最後的收拾啊。",
          "sc": "偶尔也想要参与到最后的收拾啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
