      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7924,
      "rec_id": "TALK_ID_GAMEOVER_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465995,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 466002,
          "spk": "莲实 (ハスミ)",
          "ja": "大丈夫ですか！？",
          "tc": "你還好嗎！？",
          "sc": "你还好吗！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7925,
      "rec_id": "TALK_ID_GAMEOVER_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 466026,
          "spk": "莲实 (ハスミ)",
          "ja": "はぁ……よかった",
          "tc": "呼……太好了。",
          "sc": "呼……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 466033,
          "spk": "莲实 (ハスミ)",
          "ja": "ご無事のようですね……",
          "tc": "看來你沒事……",
          "sc": "看来你没事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 466042,
          "spk": "莲实 (ハスミ)",
          "ja": "シロージが倒れているところを見つけて、",
          "tc": "四郎治看到你倒在地上，",
          "sc": "四郎治看到你倒在地上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 466049,
          "spk": "莲实 (ハスミ)",
          "ja": "ここまで運んでくれたんですよ",
          "tc": "就把你送到這裡來了。",
          "sc": "就把你送到这里来了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 466060,
          "spk": "莲实 (ハスミ)",
          "ja": "見た時には、",
          "tc": "看到你這樣，",
          "sc": "看到你这样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 466067,
          "spk": "莲实 (ハスミ)",
          "ja": "心臓が止まるかと思いました……",
          "tc": "我心臟差點就要停了……",
          "sc": "我心脏差点就要停了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 466078,
          "spk": "莲实 (ハスミ)",
          "ja": "ご自身の体力を見誤って、",
          "tc": "像這樣高估自己的體力，",
          "sc": "像这样高估自己的体力，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 466085,
          "spk": "莲实 (ハスミ)",
          "ja": "無理をしてはいけませんよ",
          "tc": "勉強自己苦撐是不行的喔！",
          "sc": "勉强自己苦撑是不行的哦！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 466103,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れてきたら、何か食べて",
          "tc": "累了就吃點東西，",
          "sc": "累了就吃点东西，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 466110,
          "spk": "莲实 (ハスミ)",
          "ja": "体力を回復してから行動してくださいね",
          "tc": "等恢復體力之後再行動吧！",
          "sc": "等恢复体力之后再行动吧！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 466126,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、無理はされないように",
          "tc": "要好好保重，",
          "sc": "要好好保重，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 466133,
          "spk": "莲实 (ハスミ)",
          "ja": "お大事にしてください",
          "tc": "別再勉強自己囉！",
          "sc": "可别再硬撑了哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7926,
      "rec_id": "TALK_ID_GAMEOVER_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 466157,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん……",
          "tc": "<player>……",
          "sc": "<player>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7927,
      "rec_id": "TALK_ID_GAMEOVER_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 466181,
          "spk": "莲实 (ハスミ)",
          "ja": "……はぁ、本当に安心しました",
          "tc": "……呼～總算能安心了。",
          "sc": "……呼～总算能安心了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 466188,
          "spk": "莲实 (ハスミ)",
          "ja": "大きな怪我もないようで何よりです",
          "tc": "幸好沒受到什麼嚴重的傷。",
          "sc": "幸好没受到什么严重的伤。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7928,
      "rec_id": "TALK_ID_GAMEOVER_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 466212,
          "spk": "莲实 (ハスミ)",
          "ja": "ご自身の体調を軽く見て、",
          "tc": "不可以輕忽自己的身體狀況，",
          "sc": "不可以轻忽自己的身体状况，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 466219,
          "spk": "莲实 (ハスミ)",
          "ja": "無茶をするのは禁物ですよ",
          "tc": "勉強自己可是大忌喔！",
          "sc": "勉强自己可是大忌哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 466235,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れを感じたら、少し休んだり、",
          "tc": "覺得累就稍微休息一下，",
          "sc": "觉得累就稍微休息一下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 466242,
          "spk": "莲实 (ハスミ)",
          "ja": "何か口にして力を戻してから",
          "tc": "先吃點東西恢復體力之後，",
          "sc": "先吃点东西恢复体力之后，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 466249,
          "spk": "莲实 (ハスミ)",
          "ja": "動くようにしてくださいね",
          "tc": "再繼續活動喔！",
          "sc": "再继续活动哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 466260,
          "spk": "莲实 (ハスミ)",
          "ja": "どうか、もう無理をなさらないで",
          "tc": "以後千萬別再勉強自己了，",
          "sc": "以后千万别再勉强自己了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 466267,
          "spk": "莲实 (ハスミ)",
          "ja": "ゆっくり休んで、しっかり治してください",
          "tc": "慢慢休息，讓身體好好恢復吧。",
          "sc": "慢慢休息，让身体好好恢复吧。"
        }
      ]
    },
