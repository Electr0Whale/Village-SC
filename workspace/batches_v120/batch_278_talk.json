    {
      "file": "talk.dat",
      "rec_idx": 7930,
      "rec_id": "TALK_ID_GAMEOVER_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 466322,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 466329,
          "spk": "莲实 (ハスミ)",
          "ja": "大丈夫ですか？",
          "tc": "你還好嗎？",
          "sc": "你还好吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 466340,
          "spk": "莲实 (ハスミ)",
          "ja": "……もう、またなんですね",
          "tc": "……真是的，怎麼又來了。",
          "sc": "……真是的，怎么又来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 466347,
          "spk": "莲实 (ハスミ)",
          "ja": "驚くより先に、ため息が出てしまいました",
          "tc": "我還沒來得及驚訝，就先嘆一口氣了。",
          "sc": "我还没来得及惊讶，就先叹一口气了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 466358,
          "spk": "莲实 (ハスミ)",
          "ja": "何度も言ってますけど、",
          "tc": "之前也說過很多次了，",
          "sc": "之前也说过很多次了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 466365,
          "spk": "莲实 (ハスミ)",
          "ja": "限界ギリギリまで頑張る癖、",
          "tc": "你那種拚命到極限的壞習慣，",
          "sc": "你那种拚命到极限的坏习惯，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 466372,
          "spk": "莲实 (ハスミ)",
          "ja": "そろそろ直してください",
          "tc": "差不多該改掉了吧！",
          "sc": "差不多该改掉了吧！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 466381,
          "spk": "莲实 (ハスミ)",
          "ja": "休むべきときは休む……",
          "tc": "該休息的時候就要休息……",
          "sc": "该休息的时候就要休息……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 466388,
          "spk": "莲实 (ハスミ)",
          "ja": "そんなに難しいことじゃないでしょう？",
          "tc": "這件事應該沒有那麼困難吧？",
          "sc": "这件事应该没有那么困难吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 466399,
          "spk": "莲实 (ハスミ)",
          "ja": "ほんと、心配する身にもなってくださいね",
          "tc": "真是的，好歹也要替擔心你的人想想啊。",
          "sc": "真是的，好歹也要替担心你的人想想啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 466406,
          "spk": "莲实 (ハスミ)",
          "ja": "今度こそ、無茶は厳禁ですから……",
          "tc": "以後真的嚴禁你再勉強自己了……",
          "sc": "以后真的严禁你再勉强自己了……"
        }
      ]
    },
    {
