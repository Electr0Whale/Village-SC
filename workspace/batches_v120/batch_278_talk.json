    {
      "file": "talk.dat",
      "rec_idx": 7951,
      "rec_id": "TALK_ID_10_0101_008_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 195498,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、ロッカクさん",
          "tc": "奇怪，六角叔，",
          "sc": "奇怪，六角叔，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 195505,
          "spk": "驹子 (コマコ)",
          "ja": "今日はもう店じまい？",
          "tc": "今天已經打烊了嗎？",
          "sc": "今天已经打烊了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 195518,
          "spk": "六角 (ロッカク)",
          "ja": "この後、祭りの片付けがあるんスよ",
          "tc": "因為晚一點還要去幫祭典收拾善後。",
          "sc": "因为晚一点还要去帮祭典收拾善后。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 195525,
          "spk": "六角 (ロッカク)",
          "ja": "なんか食べたかったっスか？",
          "tc": "你們本來是想吃點什麼嗎？",
          "sc": "你们本来是想吃点什么不？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 195538,
          "spk": "驹子 (コマコ)",
          "ja": "ううん、大丈夫",
          "tc": "沒關係啦，不要緊。",
          "sc": "没关系啦，不要紧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7952,
      "rec_id": "TALK_ID_10_0101_008_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 195566,
          "spk": "驹子 (コマコ)",
          "ja": "ロッカクさん、お祭りの後片付け、",
          "tc": "六角叔，你不是",
          "sc": "六角叔，你不是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 195573,
          "spk": "驹子 (コマコ)",
          "ja": "行かなくてもいいの？",
          "tc": "要去幫祭典收拾善後嗎？",
          "sc": "要去帮祭典收拾善后吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 195586,
          "spk": "六角 (ロッカク)",
          "ja": "呼ばれるまで待ってるっス",
          "tc": "等那邊叫我過去。",
          "sc": "等那边叫我过去呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 195599,
          "spk": "驹子 (コマコ)",
          "ja": "それは、体よく",
          "tc": "你不會是想找個理由",
          "sc": "你不会是想找个理由"
        },
        {
          "f_idx": 4,
          "pidx_tc": 195606,
          "spk": "驹子 (コマコ)",
          "ja": "サボろうとしてるんじゃなくて……？",
          "tc": "偷懶吧……？",
          "sc": "偷懒吧……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 195619,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの手伝いがなくても",
          "tc": "說不定就算沒有我幫忙，",
          "sc": "说不定就算没有我帮忙，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 195626,
          "spk": "六角 (ロッカク)",
          "ja": "片付くかもしれないじゃないスか",
          "tc": "也能收拾好不是嗎？",
          "sc": "也能收拾好不是吗？"
        }
      ]
    },
