  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7920,
      "rec_id": "TALK_ID_90_2002_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465724,
          "spk": "木助 (キスケ)",
          "ja": "それにしても……てめぇもまた、",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 465731,
          "spk": "木助 (キスケ)",
          "ja": "めんどくさいモンを買っちまったなァ",
          "tc": "你還真是買了個麻煩的東西啊。",
          "sc": "你还真是买了个麻烦的东西啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 465749,
          "spk": "木助 (キスケ)",
          "ja": "土地が増えるってことは、",
          "tc": "土地變多，",
          "sc": "土地变多，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 465756,
          "spk": "木助 (キスケ)",
          "ja": "管理しなきゃならねぇ場所が増える……",
          "tc": "就代表必須管理的地方變多……",
          "sc": "就代表必须管理的地方变多……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 465763,
          "spk": "木助 (キスケ)",
          "ja": "つまり、仕事が増えるってことだ",
          "tc": "工作也就會跟著變多。",
          "sc": "工作也就会跟着变多。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 465774,
          "spk": "木助 (キスケ)",
          "ja": "見たところ、ここはずっと使われてなくて、",
          "tc": "這裡看起來已經很久沒人打理，",
          "sc": "这里看起来已经很久没人打理，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 465781,
          "spk": "木助 (キスケ)",
          "ja": "すっかり自然に戻っちまってるみてぇだから……",
          "tc": "幾乎都變回原本的自然樣貌了……",
          "sc": "几乎都变回原本的自然样貌了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 465797,
          "spk": "木助 (キスケ)",
          "ja": "畑を作るどころか、",
          "tc": "別說是打造農田了，",
          "sc": "别说是打造农田了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 465804,
          "spk": "木助 (キスケ)",
          "ja": "まずは開拓からになるだろうよ",
          "tc": "恐怕得先從開荒整地開始做起。",
          "sc": "恐怕得先从开荒整地开始做起。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 465822,
          "spk": "木助 (キスケ)",
          "ja": "ただ、整備したら悪くない土地になるだろう",
          "tc": "但好好整地的話，應該會是塊滿不錯的土地。",
          "sc": "但好好整地的话，应该会是块满不错的土地。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 465829,
          "spk": "木助 (キスケ)",
          "ja": "かなりの広さがある上に、",
          "tc": "不只面積相當寬廣，",
          "sc": "不只面积相当宽广，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 465836,
          "spk": "木助 (キスケ)",
          "ja": "下には<strong>石が掘れそうな場所</strong>があるんだ",
          "tc": "下方還有<strong>似乎能挖到石頭的地方</strong>。",
          "sc": "下方还有<strong>似乎能挖到石头的地方</strong>。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 465847,
          "spk": "木助 (キスケ)",
          "ja": "これからは石切場に出向かなくても、",
          "tc": "之後或許不用特地跑去採石場，",
          "sc": "之后或许不用特地跑去采石场，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 465854,
          "spk": "木助 (キスケ)",
          "ja": "ここで石材や鉱石を",
          "tc": "在這裡就能取得",
          "sc": "在这里就能取得"
        },
        {
          "f_idx": 17,
          "pidx_tc": 465861,
          "spk": "木助 (キスケ)",
          "ja": "調達できるようになるんじゃねえかな",
          "tc": "石材和礦石了。",
          "sc": "石材和矿石了。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 465872,
          "spk": "木助 (キスケ)",
          "ja": "また骨が折れる仕事になるだろうが、",
          "tc": "接下來恐怕得花不少力氣整地，",
          "sc": "接下来恐怕得花不少力气整地，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 465879,
          "spk": "木助 (キスケ)",
          "ja": "せっかく買った土地なんだ",
          "tc": "不過既然你都買下這塊土地了，",
          "sc": "不过既然你都买下这块土地了，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 465886,
          "spk": "木助 (キスケ)",
          "ja": "上手く使ってやってくれ",
          "tc": "就好好善加利用吧。",
          "sc": "就好好善加利用吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7921,
      "rec_id": "TALK_ID_90_2002_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465904,
          "spk": "木助 (キスケ)",
          "ja": "じゃ、がんばれよ",
          "tc": "加油啊。",
          "sc": "加油啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 465911,
          "spk": "木助 (キスケ)",
          "ja": "応援してるぜ",
          "tc": "我會幫你打氣的。",
          "sc": "我会帮你打气的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7922,
      "rec_id": "TALK_ID_TUTORIAL_GRASS_HARVEST",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 465933,
          "spk": "主角心声/旁白/选项",
          "ja": "この草は手では",
          "tc": "這些草好像",
          "sc": "这些草好像"
        },
        {
          "f_idx": 1,
          "pidx_tc": 465940,
          "spk": "主角心声/旁白/选项",
          "ja": "抜けないみたい……",
          "tc": "沒辦法用手拔……",
          "sc": "没办法用手拔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 465951,
          "spk": "主角心声/旁白/选项",
          "ja": "道具があれば刈れるかも",
          "tc": "或許可以用工具割掉。",
          "sc": "或许可以用工具割掉。"
        }
      ]
    },
    {
