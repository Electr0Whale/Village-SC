      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202091,
          "spk": "林 (リン)",
          "ja": "ありがとう！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202098,
          "spk": "林 (リン)",
          "ja": "協力に感謝するわ！",
          "tc": "謝謝你願意配合！",
          "sc": "谢谢你愿意配合！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8009,
      "rec_id": "TALK_ID_10_0101_019_22_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202120,
          "spk": "林 (リン)",
          "ja": "……あら、なにか不都合でもあるの？",
          "tc": "……哎呀，難道有什麼不方便的嗎？",
          "sc": "……哎呀，难道有什么不方便的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202127,
          "spk": "林 (リン)",
          "ja": "あなたは契約書にサインしたのに、",
          "tc": "你都簽好契約書了，",
          "sc": "你都签好契约书了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202134,
          "spk": "林 (リン)",
          "ja": "守れない理由を聞いてみたいわね",
          "tc": "我倒是想知道你為什麼不能遵守。",
          "sc": "我倒是想知道你为什么不能遵守。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202145,
          "spk": "林 (リン)",
          "ja": "そうね……もし規則を破ったら、",
          "tc": "嗯……要是你沒有守規矩的話，",
          "sc": "嗯……要是你没有守规矩的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202152,
          "spk": "林 (リン)",
          "ja": "その時は……どうしようかしら",
          "tc": "到時候……該怎麼辦才好呢？",
          "sc": "到时候……该怎么办才好呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8011,
      "rec_id": "TALK_ID_10_0101_019_22_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202177,
          "spk": "木助 (キスケ)",
          "ja": "リン、そんなに心配しなくていいだろ",
          "tc": "林，不需要那麼擔心吧。",
          "sc": "林，不需要那么担心吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202184,
          "spk": "木助 (キスケ)",
          "ja": "こいつは必ず、守ってくれるだろうよ",
          "tc": "這傢伙肯定會遵守的啦。",
          "sc": "这家伙肯定会遵守的啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8012,
      "rec_id": "TALK_ID_10_0101_019_22_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202202,
          "spk": "木助 (キスケ)",
          "ja": "<player>、手を出しな",
          "tc": "<player>，把手伸出來吧。",
          "sc": "<player>，把手伸出来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8013,
      "rec_id": "TALK_ID_10_0101_019_22_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202228,
          "spk": "木助 (キスケ)",
          "ja": "リンが、ここまで願ってるんだ",
          "tc": "林都這樣拜託你了，",
          "sc": "林都这样拜托你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202235,
          "spk": "木助 (キスケ)",
          "ja": "あの紙の規則を破るなよ",
          "tc": "可別打破那些紙上的規則啊。",
          "sc": "可别打破那些纸上的规则啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8014,
      "rec_id": "TALK_ID_10_0101_019_22_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202255,
          "spk": "林 (リン)",
          "ja": "……なんで金を握らせたのよ",
          "tc": "……你為什麼要塞錢給他啊？",
          "sc": "……你为什么要塞钱给他啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8015,
      "rec_id": "TALK_ID_10_0101_019_22_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202273,
          "spk": "木助 (キスケ)",
          "ja": "俺は大工だからよ、",
          "tc": "我可是個木匠。",
          "sc": "我可是个木匠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202280,
          "spk": "木助 (キスケ)",
          "ja": "人にモノを頼むときには先払いするのが",
          "tc": "拜託人家做事時，",
          "sc": "拜托人家做事时，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202287,
          "spk": "木助 (キスケ)",
          "ja": "仕事柄の習慣なんだよ",
          "tc": "業界慣例就是先付報酬。",
          "sc": "业界惯例就是先付报酬。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8016,
      "rec_id": "TALK_ID_10_0101_019_22_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202305,
          "spk": "木助 (キスケ)",
          "ja": "おい、<player>",
