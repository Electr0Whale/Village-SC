    {
      "file": "talk.dat",
      "rec_idx": 8019,
      "rec_id": "TALK_ID_10_0101_020_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202520,
          "spk": "林 (リン)",
          "ja": "おはよう<player>、",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202527,
          "spk": "林 (リン)",
          "ja": "いい天気ね！",
          "tc": "今天天氣真好！",
          "sc": "今天天气真好！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202538,
          "spk": "林 (リン)",
          "ja": "まずは今日も畑に水を撒くところからね！",
          "tc": "今天也要從幫田地澆水開始喔！",
          "sc": "今天也要从帮田地浇水开始哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202545,
          "spk": "林 (リン)",
          "ja": "さあ、働きなさい！",
          "tc": "好了，去工作吧！",
          "sc": "好了，去工作吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8020,
      "rec_id": "TALK_ID_10_0101_020_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202569,
          "spk": "林 (リン)",
          "ja": "ちゃんと働いたらご褒美をあげるわよ、",
          "tc": "只要好好工作，我就會給你獎勵。",
          "sc": "只要好好工作，我就会给你奖励。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202576,
          "spk": "林 (リン)",
          "ja": "あなたのために用意しておいた、",
          "tc": "我可是為了你準備好",
          "sc": "我可是为了你准备好"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202583,
          "spk": "林 (リン)",
          "ja": "特別なものをね",
          "tc": "特別的東西囉。",
          "sc": "特别的东西哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202594,
          "spk": "林 (リン)",
          "ja": "ほら、自分の大切な野菜に",
          "tc": "好了，快去幫你重要的",
          "sc": "好了，快去帮你重要的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202601,
          "spk": "林 (リン)",
          "ja": "水をまいてらっしゃい",
          "tc": "蔬菜澆水吧。",
          "sc": "蔬菜浇水吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8021,
      "rec_id": "TALK_ID_10_0101_020_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202627,
          "spk": "林 (リン)",
          "ja": "どうしたの？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202634,
          "spk": "林 (リン)",
          "ja": "聞こえなかった？",
          "tc": "沒聽見嗎？",
          "sc": "没听见吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202641,
          "spk": "林 (リン)",
          "ja": "それとも働くのが“苦手”ってやつ？",
          "tc": "還是說，你「不太喜歡」工作？",
          "sc": "还是说，你“不太喜欢”工作？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202652,
          "spk": "林 (リン)",
          "ja": "私はここで監視してるから、",
          "tc": "我會在這裡監視著，",
          "sc": "我会在这里监视着，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202659,
          "spk": "林 (リン)",
          "ja": "早めに片付けてくれると助かるわ",
          "tc": "能盡快完成的話我會很感激的。",
          "sc": "能尽快完成的话我会很感激的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8022,
      "rec_id": "TALK_ID_10_0101_020_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202690,
          "spk": "林 (リン)",
          "ja": "コラーッ！！",
          "tc": "真是的──！！",
          "sc": "真是的——！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202697,
          "spk": "林 (リン)",
          "ja": "あなたの仕事は、",
          "tc": "你的工作",
          "sc": "你的工作"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202704,
          "spk": "林 (リン)",
          "ja": "この野菜の生死がかかってるのよ！",
          "tc": "可是攸關這些蔬菜的生死存亡啊！",
          "sc": "可是攸关这些蔬菜的生死存亡啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202713,
          "spk": "林 (リン)",
          "ja": "まずは植物に",
          "tc": "總之，",
          "sc": "总之，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202720,
          "spk": "林 (リン)",
          "ja": "ちゃんと水を与えなさい！",
          "tc": "先好好幫植物澆水！",
          "sc": "先好好帮植物浇水！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8023,
      "rec_id": "TALK_ID_10_0101_020_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202744,
          "spk": "林 (リン)",
          "ja": "よろしい！",
          "tc": "很好！",
          "sc": "很好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202751,
          "spk": "林 (リン)",
          "ja": "それじゃあ報酬をあげなくちゃね",
          "tc": "那麼，我得給你報酬才行。",
          "sc": "那么，我得给你报酬才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8024,
      "rec_id": "TALK_ID_10_0101_020_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202775,
          "spk": "林 (リン)",
          "ja": "これがあれば、素材を加工して",
          "tc": "只要有這個，",
          "sc": "只要有这个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202782,
          "spk": "林 (リン)",
          "ja": "役立つものを作ることができるの",
          "tc": "就可以加工材料，做出有用的東西。",
          "sc": "就可以加工材料，做出有用的东西。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202793,
          "spk": "林 (リン)",
          "ja": "よかったわね、<player>！",
          "tc": "很棒吧，<player>！",
          "sc": "很棒吧，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202800,
          "spk": "林 (リン)",
          "ja": "これでますます仕事が捗るわ！",
          "tc": "這樣工作起來就能更順利了！",
          "sc": "这样工作起来就能更顺利了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202811,
          "spk": "林 (リン)",
          "ja": "じゃ、私はこれで……",
          "tc": "那麼，我就先走了……",
          "sc": "那么，我就先走了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8025,
      "rec_id": "TALK_ID_10_0101_020_04_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202835,
          "spk": "林 (リン)",
          "ja": "ああっ！　忘れてた！",
          "tc": "對了！我都忘了！",
          "sc": "对了！我都忘了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8026,
      "rec_id": "TALK_ID_10_0101_020_04_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202853,
          "spk": "林 (リン)",
          "ja": "作業台を渡しても、",
          "tc": "即使把工作台給你，",
          "sc": "即使把工作台给你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202860,
          "spk": "林 (リン)",
          "ja": "作れるものがなければ意味がないわね",
          "tc": "要是沒有可以製作的東西也沒意義。",
          "sc": "要是没有可以制作的东西也没意义。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202869,
          "spk": "林 (リン)",
          "ja": "これも渡しておくわ",
          "tc": "這個也一併交給你吧。",
          "sc": "这个也一并交给你吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202876,
          "spk": "林 (リン)",
          "ja": "使ってちょうだい",
          "tc": "你要好好使用。",
          "sc": "你要好好使用。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8027,
      "rec_id": "TALK_ID_10_0101_020_04_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 202900,
          "spk": "林 (リン)",
          "ja": "<strong>設計図</strong>があれば、",
          "tc": "只要有<strong>設計圖</strong>，",
          "sc": "只要有<strong>设计图</strong>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 202907,
          "spk": "林 (リン)",
          "ja": "あなたでも作業台で",
          "tc": "即使是你，",
          "sc": "即使是你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 202914,
          "spk": "林 (リン)",
          "ja": "DIYができるでしょう",
          "tc": "也能用工作台自製吧。",
          "sc": "也能用工作台自制吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 202923,
          "spk": "林 (リン)",
          "ja": "素材が足りなければ、",
          "tc": "要是材料不夠，",
          "sc": "要是材料不够，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 202930,
          "spk": "林 (リン)",
          "ja": "そこら辺に生えてる<strong>木を切り倒して</strong>",
          "tc": "你可以四處走走，<strong>砍砍樹</strong>，",
          "sc": "你可以四处走走，<strong>砍砍树</strong>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 202937,
          "spk": "林 (リン)",
          "ja": "<strong>木材</strong>を調達することね",
          "tc": "獲得<strong>木材</strong>。",
          "sc": "获得<strong>木材</strong>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 202948,
          "spk": "林 (リン)",
          "ja": "木なら腐るほどあるからね！",
          "tc": "畢竟這裡就是樹多到不行！",
          "sc": "毕竟这里就是树多到不行！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 202955,
          "spk": "林 (リン)",
          "ja": "遠慮せずに、切っちゃってちょうだい！",
          "tc": "不用客氣，儘管砍吧！",
          "sc": "不用客气，尽管砍吧！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 202973,
          "spk": "林 (リン)",
          "ja": "ただし、自分の体力を見誤って",
          "tc": "不過你要小心不要誤判自己的體力，",
          "sc": "不过你要小心不要误判自己的体力，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 202980,
          "spk": "林 (リン)",
          "ja": "倒れてしまわないように注意しなさいね",
          "tc": "導致自己累倒了啊。",
          "sc": "导致自己累倒了啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 202998,
          "spk": "林 (リン)",
          "ja": "まずは<strong>収納箱</strong>でも",
          "tc": "總之，你先試著做出<strong>收納箱</strong>",
          "sc": "总之，你先试着做出<strong>收纳箱</strong>"
        },
        {
          "f_idx": 13,
          "pidx_tc": 203005,
          "spk": "林 (リン)",
          "ja": "作ってみたらどうかしら？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 203012,
          "spk": "林 (リン)",
          "ja": "身軽になっていいわよ",
          "tc": "可以讓你身上輕便不少喔。",
          "sc": "可以让你身上轻便不少哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8028,
      "rec_id": "TALK_ID_10_0101_020_04_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203067,
          "spk": "林 (リン)",
          "ja": "村は川に囲まれているでしょう？",
          "tc": "你看村子周圍都有河川對吧？",
          "sc": "你看村子周围都有河川对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203074,
          "spk": "林 (リン)",
          "ja": "どの川でも、上手くやれば魚が釣れるわ",
          "tc": "技術好的話，無論哪條河都能釣到魚。",
          "sc": "技术好的话，无论哪条河都能钓到鱼。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8029,
      "rec_id": "TALK_ID_10_0101_020_04_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203105,
          "spk": "林 (リン)",
          "ja": "釣り場には釣り竿が置いてあるから、",
          "tc": "釣魚點那邊都會放著釣竿，",
          "sc": "钓鱼点那边都会放着钓竿，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203112,
          "spk": "林 (リン)",
          "ja": "勝手に使って釣りしていいわよ",
          "tc": "你都可以隨便使用，盡情釣魚。",
          "sc": "你都可以随便使用，尽情钓鱼。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 203130,
          "spk": "林 (リン)",
          "ja": "時には何も考えずに、川に糸を垂らす……",
          "tc": "偶爾什麼放空腦袋，在河邊垂釣……",
          "sc": "偶尔什么放空脑袋，在河边垂钓……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 203137,
          "spk": "林 (リン)",
          "ja": "これも、彼ヶ津村ならではの暇の潰し方ね",
          "tc": "這也是彼津村特有的消磨時間的方式。",
          "sc": "这也是彼津村特有的消磨时间的方式。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8030,
      "rec_id": "TALK_ID_10_0101_020_04_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203168,
          "spk": "林 (リン)",
          "ja": "……まぁ、あなたには関係の無い話ね",
          "tc": "……不過，這跟你應該無關。",
          "sc": "……不过，这跟你应该无关。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203175,
          "spk": "林 (リン)",
          "ja": "だって、あなたはこの村の為に働くのだから、",
          "tc": "因為你得為了村子工作，",
          "sc": "因为你得为了村子工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203182,
          "spk": "林 (リン)",
          "ja": "暇ができるハズがないもの",
          "tc": "所以不會有閒下來的時候嘛。",
          "sc": "所以不会有闲下来的时候嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8031,
      "rec_id": "TALK_ID_10_0101_020_04_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203200,
          "spk": "林 (リン)",
          "ja": "さて、私も仕事に戻らなくては",
          "tc": "好了，我也差不多該回去工作了。",
          "sc": "好了，我也差不多该回去工作了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8032,
      "rec_id": "TALK_ID_10_0101_020_04_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203224,
          "spk": "林 (リン)",
          "ja": "いい？",
          "tc": "聽好了，",
          "sc": "听好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203231,
          "spk": "林 (リン)",
          "ja": "私が見ていなくとも、ちゃんと働くのよ",
          "tc": "即使我沒在一旁看著，你也要乖乖工作。",
          "sc": "即使我没在一旁看着，你也要乖乖工作。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 203249,
          "spk": "林 (リン)",
          "ja": "それじゃあね",
          "tc": "那就下次見了。",
          "sc": "那就下次见了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8033,
      "rec_id": "TALK_ID_10_0101_021_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203416,
          "spk": "林 (リン)",
          "ja": "さあ、とうとう収穫よ！",
          "tc": "來，終於要採收了！",
          "sc": "来，终于要采收了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203427,
          "spk": "林 (リン)",
          "ja": "見事に実ったじゃない！",
          "tc": "成果很豐碩嘛！",
          "sc": "成果很丰硕嘛！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203434,
          "spk": "林 (リン)",
          "ja": "あなたが頑張ったからね！",
          "tc": "都是因為你有好好努力！",
          "sc": "都是因为你有好好努力！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8034,
      "rec_id": "TALK_ID_10_0101_021_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203460,
          "spk": "林 (リン)",
          "ja": "抜くのをためらうのもわかるけど、",
          "tc": "我明白你捨不得拔出它們的心情，",
          "sc": "我明白你舍不得拔出它们的心情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203467,
          "spk": "林 (リン)",
          "ja": "土の中のままじゃ宝の持ち腐れよ？",
          "tc": "但讓它們一直待在土裡也是暴殄天物。",
          "sc": "但让它们一直待在土里也是暴殄天物。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203474,
          "spk": "林 (リン)",
          "ja": "さあ、しっかり収穫してあげて",
          "tc": "好了，快去採收它們吧。",
          "sc": "好了，快去采收它们吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8035,
      "rec_id": "TALK_ID_10_0101_021_05_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203498,
          "spk": "林 (リン)",
          "ja": "こらっ！",
          "tc": "真是的！",
          "sc": "真是的！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 203505,
          "spk": "林 (リン)",
          "ja": "どこへ行くの！",
          "tc": "你要去哪！？",
          "sc": "你要去哪！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 203514,
          "spk": "林 (リン)",
          "ja": "ずっと待っていた収穫の日なのよ！",
          "tc": "這可是等待已久的收成日呀！",
          "sc": "这可是等待已久的收成日呀！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 203521,
          "spk": "林 (リン)",
          "ja": "天気のいいうちに、",
          "tc": "趁著天氣好，",
          "sc": "趁着天气好，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 203528,
          "spk": "林 (リン)",
          "ja": "さっさと作物を収穫しなさい！",
          "tc": "趕快把作物採收起來！",
          "sc": "赶快把作物采收起来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8036,
      "rec_id": "TALK_ID_10_0101_021_14_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 203993,
          "spk": "林 (リン)",
          "ja": "よくやったわ、<player>",
          "tc": "做得好，<player>。",
          "sc": "做得好，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8037,
      "rec_id": "TALK_ID_10_0101_021_14_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204011,
          "spk": "林 (リン)",
          "ja": "私も、捧げ物があるの",
          "tc": "我自己也有要獻上的祭品，",
          "sc": "我自己也有要献上的祭品，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204018,
          "spk": "林 (リン)",
          "ja": "ちょっと待ってなさい",
          "tc": "你先等我一下吧。",
          "sc": "你先等我一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8038,
      "rec_id": "TALK_ID_10_0101_021_14_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204098,
          "spk": "林 (リン)",
          "ja": "待たせたわね！",
          "tc": "讓你久等了！",
          "sc": "让你久等了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8039,
      "rec_id": "TALK_ID_10_0101_021_14_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204118,
          "spk": "木助 (キスケ)",
          "ja": "リン……",
          "tc": "林……",
          "sc": "林……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204125,
          "spk": "木助 (キスケ)",
          "ja": "まさかそのヤギ……",
          "tc": "難道那山羊……",
          "sc": "难道那山羊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204138,
          "spk": "林 (リン)",
          "ja": "去年の、祭りの後の奉納がまだでしょう？",
          "tc": "去年祭典之後還沒進行奉納儀式吧？",
          "sc": "去年祭典之后还没进行奉纳仪式吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204145,
          "spk": "林 (リン)",
          "ja": "今年も平穏を、",
          "tc": "今年也一樣",
          "sc": "今年也一样"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204152,
          "spk": "林 (リン)",
          "ja": "祈らなくてはいけないからね",
          "tc": "得祈求平安才行。",
          "sc": "得祈求平安才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8040,
      "rec_id": "TALK_ID_10_0101_021_14_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204170,
          "spk": "木助 (キスケ)",
          "ja": "<player>、てめぇは目を閉じてな",
          "tc": "<player>，你把眼睛閉上吧。",
          "sc": "<player>，你把眼睛闭上吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8041,
      "rec_id": "TALK_ID_10_0101_021_14_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204188,
          "spk": "林 (リン)",
          "ja": "はぁ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204195,
          "spk": "林 (リン)",
          "ja": "これから<player>のためにも",
          "tc": "接下來不也是要為<player>",
          "sc": "接下来不也是要为<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204202,
          "spk": "林 (リン)",
          "ja": "祈ろうとしているのに？",
          "tc": "獻上祈禱嗎？",
          "sc": "献上祈祷吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204215,
          "spk": "木助 (キスケ)",
          "ja": "いいんだよ",
          "tc": "沒事的。",
          "sc": "没事的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204222,
          "spk": "木助 (キスケ)",
          "ja": "ほら、<player>、",
          "tc": "好了，<player>，",
          "sc": "好了，<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 204229,
          "spk": "木助 (キスケ)",
          "ja": "早く背を向けて目を閉じろ",
          "tc": "快轉過身去，閉上眼睛。",
          "sc": "快转过身去，闭上眼睛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8042,
      "rec_id": "TALK_ID_10_0101_021_14_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204255,
          "spk": "林 (リン)",
          "ja": "畏み、畏み、申します……",
          "tc": "誠惶誠恐，至誠奉告……",
          "sc": "诚惶诚恐，至诚奉告……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204264,
          "spk": "林 (リン)",
          "ja": "此の供物の数々、",
          "tc": "謹此將諸多供品，",
          "sc": "谨此将诸多供品，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204271,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉りまつる",
          "tc": "悉數虔誠供奉予祢。",
          "sc": "悉数虔诚供奉予你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204280,
          "spk": "林 (リン)",
          "ja": "去年も、この地に我らを住まわせ給いしこと、",
          "tc": "無比感謝祢去年也",
          "sc": "无比感谢你去年也"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204287,
          "spk": "林 (リン)",
          "ja": "まことに厚く御礼申し上げ奉りまつる",
          "tc": "賜予我們棲身之地，",
          "sc": "赐予我们栖身之地，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 204303,
          "spk": "林 (リン)",
          "ja": "さらに願わくば、ここに在る一人の子どもを、",
          "tc": "另祈求祢能開恩，",
          "sc": "另祈求你能开恩，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 204310,
          "spk": "林 (リン)",
          "ja": "この村に住まうこと、御許し賜りますよう、",
          "tc": "恩准此孩童安居村裡，",
          "sc": "恩准此孩童安居村里，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 204317,
          "spk": "林 (リン)",
          "ja": "慎み敬いて、祈り奉りまつる",
          "tc": "在此謹以至誠，獻上祈求。",
          "sc": "在此谨以至诚，献上祈求。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8043,
      "rec_id": "TALK_ID_10_0101_021_14_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204404,
          "spk": "林 (リン)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204413,
          "spk": "林 (リン)",
          "ja": "あなたも、もう彼ヶ津村の一員なのだから、",
          "tc": "你以後就是彼津村的一員了，",
          "sc": "你以后就是彼津村的一员了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204420,
          "spk": "林 (リン)",
          "ja": "この村の秘密を教えてあげるわ",
          "tc": "我就把這個村子的祕密告訴你吧。",
          "sc": "我就把这个村子的秘密告诉你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8044,
      "rec_id": "TALK_ID_10_0101_021_14_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204445,
          "spk": "林 (リン)",
          "ja": "<strong>「彼ヶ津村の神さまは捧げ物をすると、",
          "tc": "<strong>「將祭品獻給彼津村的神明大人，",
          "sc": "<strong>“将祭品献给彼津村的神明大人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204452,
          "spk": "林 (リン)",
          "ja": "それに釣り合う願いを叶えてくれる」</strong>",
          "tc": "祂就會幫你實現與之相應的願望。」</strong>",
          "sc": "祂就会帮你实现与之相应的愿望。”</strong>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204463,
          "spk": "林 (リン)",
          "ja": "覚えておきなさい……",
          "tc": "你要記住……",
          "sc": "你要记住……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204470,
          "spk": "林 (リン)",
          "ja": "<strong>この彼ヶ津村で願いを叶えようとするなら、",
          "tc": "<strong>在這彼津村中，如果想要實現願望，",
          "sc": "<strong>在这彼津村中，如果想要实现愿望，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204477,
          "spk": "林 (リン)",
          "ja": "対価を支払わなければならないことを</strong>",
          "tc": "你就必須付出與之相應的代價。</strong>",
          "sc": "你就必须付出与之相应的代价。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8045,
      "rec_id": "TALK_ID_10_0102_030_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205082,
          "spk": "裕太 (ユータ)",
          "ja": "サザンカ！",
          "tc": "茶梅！",
          "sc": "茶梅！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205089,
          "spk": "裕太 (ユータ)",
          "ja": "待ってたよ！",
          "tc": "我一直在等妳！",
          "sc": "我一直在等你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8046,
      "rec_id": "TALK_ID_10_0102_030_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205111,
          "spk": "裕太 (ユータ)",
          "ja": "おや、<player>も一緒だったんだね",
          "tc": "喔？<player>也跟妳在一起啊？",
          "sc": "喔？<player>也跟你在一起啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205118,
          "spk": "裕太 (ユータ)",
          "ja": "キミも雑貨店で買い物かい？",
          "tc": "你也要在雜貨店買東西嗎？",
          "sc": "你也要在杂货店买东西吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205131,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>に、営業かけに行ってたんだよ",
          "tc": "我剛剛去跟<player>推銷。",
          "sc": "我刚刚去跟<player>推销。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205138,
          "spk": "茶梅 (サザンカ)",
          "ja": "ついでに買い物させてやろうと思って、",
          "tc": "順便就把他帶來我店裡",
          "sc": "顺便就把他带来我店里"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205145,
          "spk": "茶梅 (サザンカ)",
          "ja": "連れてきたんだ",
          "tc": "買東西。",
          "sc": "买东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8047,
      "rec_id": "TALK_ID_10_0102_030_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205317,
          "spk": "裕太 (ユータ)",
          "ja": "キミもそのお金で、",
          "tc": "你也可以用這些錢",
          "sc": "你也可以用这些钱"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205324,
          "spk": "裕太 (ユータ)",
          "ja": "お買い物してみてごらん",
          "tc": "買些東西看看。",
          "sc": "买些东西看看。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205337,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、二人とも、入って入って",
          "tc": "那麼兩位快請進吧。",
          "sc": "那么两位快请进吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8048,
      "rec_id": "TALK_ID_10_0102_030_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205365,
          "spk": "茶梅 (サザンカ)",
          "ja": "ほら、どうぞ",
          "tc": "來，請～",
          "sc": "来，请～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205372,
          "spk": "茶梅 (サザンカ)",
          "ja": "商品選んでいきなよ",
          "tc": "挑挑看、選選看～",
          "sc": "挑挑看、选选看～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8049,
      "rec_id": "TALK_ID_10_0102_030_01_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205390,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、ここは村唯一の雑貨店だよ",
          "tc": "<player>，這裡是村中唯一的雜貨店喔。",
          "sc": "<player>，这里是村中唯一的杂货店哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205397,
          "spk": "裕太 (ユータ)",
          "ja": "何から何まで揃えられるから、",
          "tc": "各種商品應有盡有，",
          "sc": "各种商品应有尽有，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205404,
          "spk": "裕太 (ユータ)",
          "ja": "キミも欲しいものがあればここで探すといいよ",
          "tc": "如果你有想要的東西，都可以來這裡找找。",
          "sc": "如果你有想要的东西，都可以来这里找找。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8050,
      "rec_id": "TALK_ID_10_0102_030_01_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205440,
          "spk": "裕太 (ユータ)",
          "ja": "今日は……種を10種類と、フライパン3種類",
          "tc": "今天要買……十種作物的種子、三種平底鍋，",
          "sc": "今天要买……十种作物的种子、三种平底锅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205447,
          "spk": "裕太 (ユータ)",
          "ja": "それからキャンプのセットと……",
          "tc": "還有露營用具組……",
          "sc": "还有露营用具组……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205454,
          "spk": "裕太 (ユータ)",
          "ja": "あ、あと新しいジョウロも必要だし……",
          "tc": "啊，還需要新的澆水壺……",
          "sc": "啊，还需要新的浇水壶……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205467,
          "spk": "茶梅 (サザンカ)",
          "ja": "毎度あり……",
          "tc": "謝謝惠顧……",
          "sc": "谢谢惠顾……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205474,
          "spk": "茶梅 (サザンカ)",
          "ja": "ってか相変わらず忙しないね",
          "tc": "話說你還是一樣很忙的樣子啊。",
          "sc": "话说你还是一样很忙的样子啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 205483,
          "spk": "茶梅 (サザンカ)",
          "ja": "よくそんなに買うモノ、覚えてられるわ",
          "tc": "居然能記得那麼多要買的東西。",
          "sc": "居然能记得那么多要买的东西。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 205503,
          "spk": "裕太 (ユータ)",
          "ja": "覚えてないよ",
          "tc": "我記不住啦。",
          "sc": "我记不住啦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 205510,
          "spk": "裕太 (ユータ)",
          "ja": "でもやりたいことをメモしてたら、",
          "tc": "只是把想做的事記下來，",
          "sc": "只是把想做的事记下来，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 205517,
          "spk": "裕太 (ユータ)",
          "ja": "欲しい物も増えちゃってね……",
          "tc": "想要的東西就變得越來越多了……",
          "sc": "想要的东西就变得越来越多了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8051,
      "rec_id": "TALK_ID_10_0102_030_01_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205537,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>も欲しいものや、",
          "tc": "啊，如果<player>你也有想要的東西",
          "sc": "啊，如果<player>你也有想要的东西"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205544,
          "spk": "裕太 (ユータ)",
          "ja": "やりたいことがあるなら、",
          "tc": "或想要做的事，",
          "sc": "或想要做的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205551,
          "spk": "裕太 (ユータ)",
          "ja": "忘れないようにメモしたら？",
          "tc": "也可以記下來以免忘記喔。",
          "sc": "也可以记下来以免忘记哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205562,
          "spk": "裕太 (ユータ)",
          "ja": "俺の鉛筆とメモ帳、分けてあげるよ",
          "tc": "我把鉛筆與筆記本分給你吧。",
          "sc": "我把铅笔与笔记本分给你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8052,
      "rec_id": "TALK_ID_10_0102_030_01_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205590,
          "spk": "裕太 (ユータ)",
          "ja": "お店とかで欲しいものがあったら、",
          "tc": "如果在店裡之類的看到想要的東西，",
          "sc": "如果在店里之类的看到想要的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205597,
          "spk": "裕太 (ユータ)",
          "ja": "すぐにメモするといいよ",
          "tc": "最好馬上把它們記下來。",
          "sc": "最好马上把它们记下来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8053,
      "rec_id": "TALK_ID_10_0102_030_01_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205615,
          "spk": "裕太 (ユータ)",
          "ja": "サザンカもいる？",
          "tc": "茶梅，妳需要嗎？",
          "sc": "茶梅，你需要吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205628,
          "spk": "茶梅 (サザンカ)",
          "ja": "忘れるほどやりたいことねーし、",
          "tc": "我想做的事還沒有多到會忘記，",
          "sc": "我想做的事还没有多到会忘记，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205635,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシはいらないや",
          "tc": "就先不用了。",
          "sc": "就先不用了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8054,
      "rec_id": "TALK_ID_10_0102_030_01_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205660,
          "spk": "裕太 (ユータ)",
          "ja": "俺はもう用事が済んだから行くけど",
          "tc": "我的事辦完了，就先回去囉。",
          "sc": "我的事情办完了，就先回去啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205667,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も、買い物してみたら？",
          "tc": "<player>你要不要也買點東西？",
          "sc": "<player>你要不要也买点东西？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205678,
          "spk": "裕太 (ユータ)",
          "ja": "俺からのお願いだよ",
          "tc": "就算是我個人的請託啦。",
          "sc": "就算是我个人的请托啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205685,
          "spk": "裕太 (ユータ)",
          "ja": "せっかく来たんだから、",
          "tc": "難得都來了，",
          "sc": "难得都来了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205692,
          "spk": "裕太 (ユータ)",
          "ja": "商品だけでも見ていってあげてね",
          "tc": "至少也看看有哪些商品吧。",
          "sc": "至少也看看有哪些商品吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8055,
      "rec_id": "TALK_ID_10_0102_030_01_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205710,
          "spk": "裕太 (ユータ)",
          "ja": "じゃ、俺はもう行くよ",
          "tc": "那麼，我先走了。",
          "sc": "那么，我先走了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205717,
          "spk": "裕太 (ユータ)",
          "ja": "今日中に、畑に種を撒きたいんだ",
          "tc": "我想在今天之內把種子播到田裡。",
          "sc": "我想在今天之内把种子播到田里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8056,
      "rec_id": "TALK_ID_10_0102_030_01_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205750,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタに必要な日用雑貨とかは、",
          "tc": "你需要的日用雜貨之類的",
          "sc": "你需要的日用杂货之类的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205757,
          "spk": "茶梅 (サザンカ)",
          "ja": "真ん中の棚にあるよ",
          "tc": "都在中間的架子上。",
          "sc": "都在中间的架子上。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205764,
          "spk": "茶梅 (サザンカ)",
          "ja": "せっかく来たんだし、見ていきなよ",
          "tc": "難得來一趟，就看一看吧。",
          "sc": "难得来一趟，就看一看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8057,
      "rec_id": "TALK_ID_10_0102_030_01_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205790,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタさ、あの庭を開拓するんよね？",
          "tc": "你是要開墾那片庭院對吧？",
          "sc": "你是要开垦那片庭院对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205797,
          "spk": "茶梅 (サザンカ)",
          "ja": "だったらカマとか必要じゃね？",
          "tc": "那應該需要鐮刀之類的？",
          "sc": "那应该需要镰刀之类的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205804,
          "spk": "茶梅 (サザンカ)",
          "ja": "もちろん取り揃えてるから見てってよ",
          "tc": "當然，這裡應有盡有，你可以慢慢逛。",
          "sc": "当然，这里应有尽有，你可以慢慢逛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8058,
      "rec_id": "TALK_ID_10_0102_030_01_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205830,
          "spk": "茶梅 (サザンカ)",
          "ja": "どしたん？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205837,
          "spk": "茶梅 (サザンカ)",
          "ja": "雑貨よりアタシが気になる？",
          "tc": "比起雜貨，你更在意我嗎？",
          "sc": "比起杂货，你更在意我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205844,
          "spk": "茶梅 (サザンカ)",
          "ja": "それとも、見られてたら選びにくいタイプ？",
          "tc": "還是說，你是那種被盯著就不太敢買東西的人？",
          "sc": "还是说，你是那种被盯着就不太敢买东西的人？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8060,
      "rec_id": "TALK_ID_10_0102_030_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213500,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、チナナさんに、<player>じゃないか",
          "tc": "哦，是琪娜娜姐和<player>！",
          "sc": "哦，是琪娜娜姐和<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213507,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなところで何してるの？",
          "tc": "你們在這裡做什麼？",
          "sc": "你们在这里做什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213522,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、お二人とも",
          "tc": "嗨，兩位。",
          "sc": "嗨，两位。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213529,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>がハスミに用事だよ",
          "tc": "<player>有事找蓮實。",
          "sc": "<player>有事找莲实。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213536,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと時間とれるかな？",
          "tc": "現在有空嗎？",
          "sc": "现在有空吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213549,
          "spk": "莲实 (ハスミ)",
          "ja": "診療所に来るだなんて、",
          "tc": "居然會來診所，",
          "sc": "居然会来诊所，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 213556,
          "spk": "莲实 (ハスミ)",
          "ja": "どこか、お加減でも悪いのですか？",
          "tc": "有什麼地方不舒服嗎？",
          "sc": "有什么地方不舒服吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 213567,
          "spk": "莲实 (ハスミ)",
          "ja": "ここには病室もありますし、",
          "tc": "診所裡面也有病房，",
          "sc": "诊所里面也有病房，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 213574,
          "spk": "莲实 (ハスミ)",
          "ja": "私もすぐに診察できますから……",
          "tc": "我也可以馬上幫你看病……",
          "sc": "我也可以马上帮你看病……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 213587,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは、ハスミ、心配し過ぎだよ",
          "tc": "啊哈哈，蓮實，妳擔心過頭了。",
          "sc": "啊哈哈，莲实，你担心过头了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 213594,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>の顔色を見てみなよ、",
          "tc": "妳看看<player>的臉色，",
          "sc": "你看看<player>的脸色，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 213601,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこも悪いようには見えないだろう？",
          "tc": "怎麼看都不像是生病的樣子嘛。",
          "sc": "怎么看都不像是生病的样子嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8061,
      "rec_id": "TALK_ID_10_0102_030_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213619,
          "spk": "莲实 (ハスミ)",
          "ja": "だって、あの土地の管理を言い渡されたのよ",
          "tc": "但他可是被分配去管理那片土地呀。",
          "sc": "但他可是被分配去管理那片土地呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213626,
          "spk": "莲实 (ハスミ)",
          "ja": "きっと大変なお仕事だから、",
          "tc": "想必是很辛苦的工作，",
          "sc": "想必是很辛苦的工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213633,
