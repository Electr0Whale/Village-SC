      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114596,
          "spk": "林 (リン)",
          "ja": "あら、なにか蔵に用事？",
          "tc": "哎呀，來倉庫有什麼事嗎？",
          "sc": "哎呀，来仓库有什么事吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114603,
          "spk": "林 (リン)",
          "ja": "遊び場所なら他を当たってちょうだい",
          "tc": "要玩的話去其他地方玩吧。",
          "sc": "要玩的话去其他地方玩吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 114621,
          "spk": "林 (リン)",
          "ja": "寒い時期だし、",
          "tc": "畢竟天氣寒冷，",
          "sc": "毕竟天气寒冷，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 114628,
          "spk": "林 (リン)",
          "ja": "室内で過ごしたいのはわかるけどね",
          "tc": "我也明白你想待在室內的心情。",
          "sc": "我也明白你想待在室内的心情。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 927,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114652,
          "spk": "林 (リン)",
          "ja": "チナナに渡す予定の商品は",
          "tc": "預定要交給琪娜娜的商品",
          "sc": "预定要交给琪娜娜的商品"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114659,
          "spk": "林 (リン)",
          "ja": "ここにしまってあるのよ",
          "tc": "都收在這裡喔。",
          "sc": "都收在这里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114670,
          "spk": "林 (リン)",
          "ja": "あとで運び出すから、手が空いてたら手伝って",
          "tc": "待會要搬出去，有空的話幫忙一下吧。",
          "sc": "待会要搬出去，有空的话帮忙一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 928,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114701,
          "spk": "林 (リン)",
          "ja": "そろそろガタついてきたし",
          "tc": "差不多開始鬆動了，",
          "sc": "差不多开始松动了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114708,
          "spk": "林 (リン)",
          "ja": "キスケさんに修繕を頼もうかしら……",
          "tc": "要不要拜託木助哥來修繕呢……",
          "sc": "要不要拜托木助哥来修缮呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114719,
          "spk": "林 (リン)",
          "ja": "でも高いのよね……",
          "tc": "但費用很貴啊……",
          "sc": "但费用很贵啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 929,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114743,
          "spk": "林 (リン)",
          "ja": "素朴なご飯、素朴な美味しさ……",
          "tc": "樸實的餐點、樸實的美味……",
          "sc": "朴实的餐点、朴实的美味……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114750,
          "spk": "林 (リン)",
          "ja": "こういう当たり前を大切に思うのが",
          "tc": "珍惜這些理所當然的事，",
          "sc": "珍惜这些理所当然的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114757,
          "spk": "林 (リン)",
          "ja": "節約生活のコツなのよね",
          "tc": "就是節儉生活的訣竅呢。",
          "sc": "就是节俭生活的诀窍呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 930,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114781,
          "spk": "林 (リン)",
          "ja": "仕事も無事に終わったから",
          "tc": "工作也順利完成了，",
          "sc": "工作也顺利完成了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114788,
          "spk": "林 (リン)",
          "ja": "今日はゆっくり眠れそうだわ……",
          "tc": "今天應該可以好好睡一覺……",
          "sc": "今天应该可以好好睡一觉……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 114806,
          "spk": "林 (リン)",
          "ja": "これもみんなの働きのおかげね",
          "tc": "這都是多虧了大家的努力呢。",
          "sc": "这都是多亏了大家的努力呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 931,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114837,
          "spk": "林 (リン)",
          "ja": "あれ……コマコに頼んだ仕事って",
          "tc": "咦……拜託駒子做的工作，",
          "sc": "咦……拜托驹子做的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114844,
          "spk": "林 (リン)",
          "ja": "ちゃんと終わったんだっけ……？",
          "tc": "到底有沒有好好完成……？",
          "sc": "到底有没有好好完成……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114855,
          "spk": "林 (リン)",
          "ja": "まぁいいわ、明日確認しましょう……",
          "tc": "算了，明天再確認吧……",
          "sc": "算了，明天再确认吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 932,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_4232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114886,
          "spk": "林 (リン)",
          "ja": "夜ごはんを多めに食べたからかしら、",
          "tc": "是因為晚餐吃得比較多嗎？",
          "sc": "是因为晚餐吃得比较多吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114893,
          "spk": "林 (リン)",
          "ja": "眠気が来るのが早いわ……",
          "tc": "好快就想睡了……",
          "sc": "好快就想睡了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114904,
          "spk": "林 (リン)",
          "ja": "まだやりたいことが……すう……",
          "tc": "我還有想做的事……呼……",
          "sc": "我还有想做的事……呼……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 933,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114928,
          "spk": "林 (リン)",
          "ja": "雪はあまり好きじゃないのよね……",
          "tc": "我不太喜歡下雪……",
          "sc": "我不太喜欢下雪……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 114935,
          "spk": "林 (リン)",
          "ja": "服も汚れるし、踏むと転びそうになるし",
          "tc": "因為會弄髒衣服，踩到雪又可能滑倒。",
          "sc": "因为会弄脏衣服，踩到雪又可能滑倒。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 114953,
          "spk": "林 (リン)",
          "ja": "早く降り止んでほしいわ……",
          "tc": "真希望雪快點停……",
          "sc": "真希望雪快点停……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 934,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 114977,
          "spk": "林 (リン)",
          "ja": "冬とはいえ、朝からこんなに寒いなんて……",
          "tc": "雖說是冬天，但一大早就這麼冷……",
          "sc": "虽说是冬天，但一大早就这么冷……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 114995,
          "spk": "林 (リン)",
          "ja": "あなたも風邪をひかないようにね",
          "tc": "你也要小心別感冒了。",
          "sc": "你也要小心别感冒了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115002,
          "spk": "林 (リン)",
          "ja": "人手が足りなくなったら困るんだから！",
          "tc": "要是人手不夠，我會很困擾的！",
          "sc": "要是人手不够，我会很困扰的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 935,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115033,
          "spk": "林 (リン)",
          "ja": "書類仕事がかなり溜まってるのよね",
          "tc": "累積了不少文書工作呢。",
          "sc": "累积了不少文书工作呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115040,
          "spk": "林 (リン)",
          "ja": "コンノにしっかり動いてもらわないと",
          "tc": "要讓今野好好做事才行。",
          "sc": "要让今野好好做事才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 936,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115064,
          "spk": "林 (リン)",
          "ja": "屋敷の雪かきをしてくれる人を探してるのよ",
          "tc": "我正在找人幫忙清理宅邸的雪。",
          "sc": "我正在找人帮忙清理宅邸的雪。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115071,
          "spk": "林 (リン)",
          "ja": "あなたも手伝ってくれると助かるわ",
          "tc": "如果你也能來幫忙就太感激了。",
          "sc": "如果你也能来帮忙就太感激了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115089,
          "spk": "林 (リン)",
          "ja": "ちゃんとお礼もするから",
          "tc": "我會好好答謝你的。",
          "sc": "我会好好答谢你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 937,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115113,
          "spk": "林 (リン)",
          "ja": "積もる前に、日の光で",
          "tc": "在雪積起來之前，",
          "sc": "在雪积起来之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115120,
          "spk": "林 (リン)",
          "ja": "溶けてくれるといいんだけど……",
          "tc": "能靠陽光融化就好了……",
          "sc": "能靠阳光融化就好了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115131,
          "spk": "林 (リン)",
          "ja": "いや、下手に溶けると滑りやすくなるわね……",
          "tc": "不，如果融化得不夠恰當，會更容易滑倒……",
          "sc": "不，如果融化得不够恰当，会更容易滑倒……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 938,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115162,
          "spk": "林 (リン)",
          "ja": "防寒具は忘れずに着けるようにしてるの",
          "tc": "我總是會記得穿好禦寒用品。",
          "sc": "我总是会记得穿好御寒用品。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115180,
          "spk": "林 (リン)",
          "ja": "あなたもちょっと薄着じゃない？",
          "tc": "你是不是也穿得有點少了？",
          "sc": "你是不是也穿得有点少了？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115187,
          "spk": "林 (リン)",
          "ja": "もっと寒くなる前に準備しておきなさい",
          "tc": "在變得更冷之前，先做好準備吧。",
          "sc": "在变得更冷之前，先做好准备吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 939,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115211,
          "spk": "林 (リン)",
          "ja": "シロージに用事があるけど",
          "tc": "我有事要找四郎治，",
          "sc": "我有事要找四郎治，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115218,
          "spk": "林 (リン)",
          "ja": "山まで登るのが面倒ね……",
          "tc": "但要爬山實在很麻煩……",
          "sc": "但要爬山实在很麻烦……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115229,
          "spk": "林 (リン)",
          "ja": "……まあいいわ",
          "tc": "……算了，無所謂。",
          "sc": "……算了，无所谓。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115236,
          "spk": "林 (リン)",
          "ja": "今度コマコから伝えてもらいましょう",
          "tc": "下次就請駒子代為轉達吧。",
          "sc": "下次就请驹子代为转达吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 940,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115267,
          "spk": "林 (リン)",
          "ja": "この時期の川は危ないから",
          "tc": "這個時期的河川很危險，",
          "sc": "这个时期的河川很危险，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115274,
          "spk": "林 (リン)",
          "ja": "近づかないほうがいいわよ？",
          "tc": "不要靠近比較好喔。",
          "sc": "不要靠近比较好哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115285,
          "spk": "林 (リン)",
          "ja": "間違って落ちて、体が凍っても知らないから",
          "tc": "萬一不小心掉下去而凍僵了，我可不管喔。",
          "sc": "万一不小心掉下去而冻僵了，我可不管哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 941,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115316,
          "spk": "林 (リン)",
          "ja": "年々雪の量が多くなってる気がするのよね",
          "tc": "感覺降雪量一年比一年還要多呢。",
          "sc": "感觉降雪量一年比一年还要多呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115334,
          "spk": "林 (リン)",
          "ja": "そのうち村ごと雪に埋もれたりして……",
          "tc": "說不定哪天全村都會被雪掩埋……",
          "sc": "说不定哪天全村都会被雪掩埋……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115345,
          "spk": "林 (リン)",
          "ja": "笑えない冗談ね",
          "tc": "真是讓人笑不出來的玩笑啊。",
          "sc": "真是让人笑不出来的玩笑啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 942,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115369,
          "spk": "林 (リン)",
          "ja": "遅くまでがんばってるわね、<player>",
          "tc": "你努力到這麼晚啊，<player>。",
          "sc": "你努力到这么晚啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115376,
          "spk": "林 (リン)",
          "ja": "私もまだ仕事が残ってるの",
          "tc": "我也還有工作沒做完，",
          "sc": "我也还有工作没做完，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 115387,
          "spk": "林 (リン)",
          "ja": "お互いにがんばりましょう！",
          "tc": "一起加油吧！",
          "sc": "一起加油吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 943,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115411,
          "spk": "林 (リン)",
          "ja": "この時期はやっぱり鍋がいいわよね",
          "tc": "這個時期果然還是吃火鍋最棒了。",
          "sc": "这个时期果然还是吃火锅最棒了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 115418,
          "spk": "林 (リン)",
          "ja": "何を入れてもおいしいし、体もちゃんと温まるし",
          "tc": "放什麼進去都很好吃，還可以溫暖身體。",
          "sc": "放什么进去都很好吃，还可以温暖身体。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 115436,
          "spk": "林 (リン)",
          "ja": "冷蔵庫の残り物でも、",
          "tc": "即使是冰箱裡剩下的食材，",
          "sc": "即使是冰箱里剩下的食材，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 115443,
          "spk": "林 (リン)",
          "ja": "それなりに形になるのがありがたいけど……",
          "tc": "也能做出還不錯的料理，很方便……",
          "sc": "也能做出还不错的料理，很方便……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 115450,
          "spk": "林 (リン)",
          "ja": "今日はちょっと贅沢にしてみようかしら？",
          "tc": "不過今天要不要稍微奢侈一點呢？",
          "sc": "不过今天要不要稍微奢侈一点呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 944,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 115474,
