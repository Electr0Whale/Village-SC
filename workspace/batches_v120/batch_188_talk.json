          "ja": "う、うん……",
          "tc": "唔、嗯……",
          "sc": "唔、嗯……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 254552,
          "spk": "驹子 (コマコ)",
          "ja": "<strong>奇跡を呼ぶ歌</strong>、吹いてみるね",
