  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4377,
      "rec_id": "TALK_ID_10_0302_031_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252377,
          "spk": "驹子 (コマコ)",
          "ja": "あ……おはよう、<player>……！",
          "tc": "啊……早安，<player>……！",
          "sc": "啊……早安，<player>……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252384,
          "spk": "驹子 (コマコ)",
          "ja": "急にごめんね……",
          "tc": "抱歉這麼突然打擾……",
          "sc": "抱歉这么突然打扰……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252391,
          "spk": "驹子 (コマコ)",
          "ja": "でも、どうしても来てほしくって……！",
          "tc": "但我真的很想快點找你一起來……！",
          "sc": "但我真的很想快点找你一起来……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252402,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんがね、",
          "tc": "名護先生說，",
          "sc": "名护先生说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252409,
          "spk": "驹子 (コマコ)",
          "ja": "探していた「巻き戻りの奇跡」の物語、",
          "tc": "他幫我們找到了",
          "sc": "他帮我们找到了"
        },
        {
          "f_idx": 5,
          "pidx_tc": 252416,
          "spk": "驹子 (コマコ)",
          "ja": "見つけてくれたんだよ！",
          "tc": "那個「倒轉的奇蹟」的故事！",
          "sc": "那个“倒转的奇迹”的故事！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 252427,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も気になるよね？",
          "tc": "<player>也很好奇吧？",
          "sc": "<player>也很好奇吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 252434,
          "spk": "驹子 (コマコ)",
          "ja": "一緒に見に行こうよ！",
          "tc": "我們一起去看看吧！",
          "sc": "我们一起去看看吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4378,
      "rec_id": "TALK_ID_10_0302_031_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252462,
          "spk": "名护 (ナゴ)",
          "ja": "おや、<player>さん……",
          "tc": "哦，是<player>……",
          "sc": "哦，是<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252469,
          "spk": "名护 (ナゴ)",
          "ja": "おはよう、来てくれたんだね",
          "tc": "早安，你來了啊。",
          "sc": "早安，你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252480,
          "spk": "名护 (ナゴ)",
          "ja": "キミが見つけてきた本じゃなかったが……",
          "tc": "雖然不是你找到的那本書……",
          "sc": "虽然不是你找到的那本书……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252487,
          "spk": "名护 (ナゴ)",
          "ja": "あったよ、<strong>神が時間を巻き戻す",
          "tc": "但找到那個<strong>神明倒轉時間",
          "sc": "但找到那个<strong>神明倒转时间"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252494,
          "spk": "名护 (ナゴ)",
          "ja": "奇跡を起こした</strong>という例の物語が……",
          "tc": "引發奇蹟</strong>的那個故事了……",
          "sc": "引发奇迹</strong>的那个故事了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4379,
      "rec_id": "TALK_ID_10_0302_031_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252512,
          "spk": "帷 (トバリ)",
          "ja": "まさか……本当に見つかるなんて……",
          "tc": "沒想到……真的能找到……",
          "sc": "没想到……真的能找到……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4380,
      "rec_id": "TALK_ID_10_0302_031_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252537,
          "spk": "名护 (ナゴ)",
          "ja": "こっちもあんなこと言われたら、",
          "tc": "畢竟聽到妳那樣說，",
          "sc": "毕竟听到你那样说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252544,
          "spk": "名护 (ナゴ)",
          "ja": "気になって眠れないからな",
          "tc": "我自己也在意到睡不著覺啊。",
          "sc": "我自己也在意到睡不着觉啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4381,
      "rec_id": "TALK_ID_10_0302_031_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252576,
          "spk": "名护 (ナゴ)",
          "ja": "これだ……",
          "tc": "就是這個……",
          "sc": "就是这个……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252583,
          "spk": "名护 (ナゴ)",
          "ja": "彼ヶ津伝承集、犬飼鹿郎著",
          "tc": "《彼津傳說集》，犬飼鹿郎著。",
          "sc": "《彼津传说集》，犬饲鹿郎着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4382,
      "rec_id": "TALK_ID_10_0302_031_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252601,
          "spk": "帷 (トバリ)",
          "ja": "犬飼って……",
          "tc": "犬飼……",
          "sc": "犬饲……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252608,
          "spk": "帷 (トバリ)",
          "ja": "コマコの名字じゃない？",
          "tc": "這不是駒子的姓氏嗎？",
          "sc": "这不是驹子的姓氏吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252621,
          "spk": "驹子 (コマコ)",
          "ja": "……うん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252628,
          "spk": "驹子 (コマコ)",
          "ja": "これが多分、私のおじいちゃん……かも",
          "tc": "這應該是，我的爺爺……",
          "sc": "这应该是，我的爷爷……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252635,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんが昔話を聞いてたらしいから……",
          "tc": "哥哥以前好像聽爺爺說過故事……",
          "sc": "哥哥以前好像听爷爷说过故事……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 252648,
          "spk": "名护 (ナゴ)",
          "ja": "ほら、見てくれ",
          "tc": "來，你看，",
          "sc": "来，你看，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 252655,
          "spk": "名护 (ナゴ)",
          "ja": "ここの文章だ……",
          "tc": "這段文字……",
          "sc": "这段文字……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4383,
      "rec_id": "TALK_ID_10_0302_031_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252677,
          "spk": "名护 (ナゴ)",
          "ja": "昔、村に住む男が寝込んでいる間に",
          "tc": "從前，一位住在村裡的男人正在熟睡時，",
          "sc": "从前，一位住在村里的男人正在熟睡时，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252684,
          "spk": "名护 (ナゴ)",
          "ja": "火の不始末をし、火事によって",
          "tc": "因為沒有注意火源而引發了火災，",
          "sc": "因为没有注意火源而引发了火灾，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252691,
          "spk": "名护 (ナゴ)",
          "ja": "妻を亡くすという事故を起こした",
          "tc": "導致妻子因此喪命。",
          "sc": "导致妻子因此丧命。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252700,
          "spk": "名护 (ナゴ)",
          "ja": "目覚めた男は深く後悔し、",
          "tc": "男人醒來後深感後悔，",
          "sc": "男人醒来后深感后悔，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252707,
          "spk": "名护 (ナゴ)",
          "ja": "守り神様の前で三日三晩謝り続けた",
          "tc": "在守護神前持續懺悔了三天三夜。",
          "sc": "在守护神前持续忏悔了三天三夜。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 252723,
          "spk": "名护 (ナゴ)",
          "ja": "「命と引き換えに時を戻してください」と",
          "tc": "「請以我的生命為代價，倒轉時光吧。」",
          "sc": "“请以我的生命为代价，倒转时光吧。”"
        },
        {
          "f_idx": 7,
          "pidx_tc": 252730,
          "spk": "名护 (ナゴ)",
          "ja": "男が願うので、守り神様は",
          "tc": "男人如此祈願，",
          "sc": "男人如此祈愿，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 252737,
          "spk": "名护 (ナゴ)",
          "ja": "男の命を受け取った",
          "tc": "於是守護神收下了男人的生命。",
          "sc": "于是守护神收下了男人的生命。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 252746,
          "spk": "名护 (ナゴ)",
          "ja": "翌日、守り神様は焼けた家の前で歌いかけると、",
          "tc": "次日，守護神在燒成廢墟的房子前唱起歌，",
          "sc": "次日，守护神在烧成废墟的房子前唱起歌，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 252753,
          "spk": "名护 (ナゴ)",
          "ja": "燃えた家と家族は、",
          "tc": "房子和家人就像時間被倒轉一樣",
          "sc": "房子和家人就像时间被倒转一样"
        },
        {
          "f_idx": 11,
          "pidx_tc": 252760,
          "spk": "名护 (ナゴ)",
          "ja": "時間が巻き戻るかのように蘇った",
          "tc": "復原重生了。",
          "sc": "复原重生了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 252769,
          "spk": "名护 (ナゴ)",
          "ja": "村人たちはこの奇跡を忘れぬようにと",
          "tc": "村民們為了不要忘記這場奇蹟，",
          "sc": "村民们为了不要忘记这场奇迹，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 252776,
          "spk": "名护 (ナゴ)",
          "ja": "時計塔を建て、その歌を鐘に刻んだ……",
          "tc": "建造了鐘樓，並將歌刻在鐘上……",
          "sc": "建造了钟楼，并将歌刻在钟上……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4384,
      "rec_id": "TALK_ID_10_0302_031_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252803,
          "spk": "帷 (トバリ)",
          "ja": "……コマコ、この話で間違いない？",
          "tc": "……駒子，是這個故事對嗎？",
          "sc": "……驹子，是这个故事对吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4385,
      "rec_id": "TALK_ID_10_0302_031_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252821,
          "spk": "驹子 (コマコ)",
          "ja": "うん……多分、お兄ちゃんが言ってた話……",
          "tc": "嗯……哥哥提到的應該是這個故事……",
          "sc": "嗯……哥哥提到的应该是这个故事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252828,
          "spk": "驹子 (コマコ)",
          "ja": "神さまの力を借りて、時間を巻き戻して",
          "tc": "他說是借助神明大人的力量，倒轉時間，",
          "sc": "他说是借助神明大人的力量，倒转时间，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252835,
          "spk": "驹子 (コマコ)",
          "ja": "死んだ人を生き返らせたっていう……",
          "tc": "讓死掉的人復活的故事……",
          "sc": "让死掉的人复活的故事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252848,
          "spk": "帷 (トバリ)",
          "ja": "ここに書かれている時計塔って……",
          "tc": "這裡寫到的鐘樓……",
          "sc": "这里写到的钟楼……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252855,
          "spk": "帷 (トバリ)",
          "ja": "村の広場にある、アレのこと？",
          "tc": "是村子廣場上的那座嗎？",
          "sc": "是村子广场上的那座吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 252868,
          "spk": "驹子 (コマコ)",
          "ja": "もしかして、時計塔にある鐘に、",
          "tc": "難道說，鐘樓的鐘上",
          "sc": "难道说，钟楼的钟上"
        },
        {
          "f_idx": 6,
          "pidx_tc": 252875,
          "spk": "驹子 (コマコ)",
          "ja": "神さまが歌った「時間を巻き戻す歌」が、",
          "tc": "真的刻有神明大人所唱的",
          "sc": "真的刻有神明大人所唱的"
        },
        {
          "f_idx": 7,
          "pidx_tc": 252882,
          "spk": "驹子 (コマコ)",
          "ja": "本当に書かれているのかも……",
          "tc": "「倒轉時間之歌」……",
          "sc": "“倒转时间之歌”……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4386,
      "rec_id": "TALK_ID_10_0302_031_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252900,
          "spk": "名护 (ナゴ)",
          "ja": "……えーっと、よくわからないけど",
          "tc": "……呃……雖然不清楚是怎麼回事……",
          "sc": "……呃……虽然不清楚是怎么回事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252907,
          "spk": "名护 (ナゴ)",
          "ja": "とりあえず約束通り、伝承は見つけたからね",
          "tc": "但總之我按照約定，找出傳說故事給妳了喔。",
          "sc": "但总之我按照约定，找出传说故事给你了哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4387,
      "rec_id": "TALK_ID_10_0302_031_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252929,
          "spk": "驹子 (コマコ)",
          "ja": "ありがとう、ナゴさん！",
          "tc": "謝謝你，名護先生！",
          "sc": "谢谢你，名护先生！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252940,
          "spk": "帷 (トバリ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252947,
          "spk": "帷 (トバリ)",
          "ja": "思ったよりやるじゃない",
          "tc": "你比我想得還能幹呢。",
          "sc": "你比我想得还能干呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4388,
      "rec_id": "TALK_ID_10_0302_031_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252965,
          "spk": "名护 (ナゴ)",
          "ja": "……どういたしまして",
          "tc": "……不客氣。",
          "sc": "……不客气。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4389,
      "rec_id": "TALK_ID_10_0302_031_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252995,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ、次は時計塔に入るための",
          "tc": "帷，接下來我們得為了進入鐘樓",
          "sc": "帷，接下来我们得为了进入钟楼"
        },
        {
          "f_idx": 1,
          "pidx_tc": 253002,
          "spk": "驹子 (コマコ)",
          "ja": "計画をたてなきゃ……！",
          "tc": "做好計畫才行……！",
          "sc": "做好计划才行……！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 253015,
          "spk": "帷 (トバリ)",
          "ja": "簡単には入れなさそうだから、",
          "tc": "應該沒辦法輕易進去，",
          "sc": "应该没办法轻易进去，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 253022,
          "spk": "帷 (トバリ)",
          "ja": "なにか方法を考えないとね",
          "tc": "只能另想對策了。",
          "sc": "只能另想对策了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4390,
      "rec_id": "TALK_ID_10_0302_031_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253048,
          "spk": "名护 (ナゴ)",
          "ja": "あ、トバリさん、ちょっと待ってくれ",
          "tc": "啊，帷小姐，妳先等一下。",
          "sc": "啊，帷小姐，你先等一下。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 253055,
          "spk": "名护 (ナゴ)",
          "ja": "キミが興味を持ちそうな本を見つけたんだ",
          "tc": "我找到了一本妳應該會有興趣的書。",
          "sc": "我找到了一本你应该会有兴趣的书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4391,
      "rec_id": "TALK_ID_10_0302_031_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253082,
          "spk": "帷 (トバリ)",
          "ja": "……私が？",
          "tc": "……我？",
          "sc": "……我？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 253089,
          "spk": "帷 (トバリ)",
          "ja": "それは一体……",
          "tc": "到底是……？",
          "sc": "到底是……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4392,
      "rec_id": "TALK_ID_10_0302_031_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253107,
          "spk": "名护 (ナゴ)",
          "ja": "キミが言っていた「十年前」の話について",
