          "sc": "林到底藏了什么秘密啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4416,
      "rec_id": "TALK_ID_10_0302_035_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254477,
          "spk": "驹子 (コマコ)",
