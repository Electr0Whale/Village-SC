          "tc": "簡直跟手哨的樂譜一模一樣……",
          "sc": "简直跟手哨的乐谱一模一样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4417,
      "rec_id": "TALK_ID_10_0302_035_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254525,
          "spk": "帷 (トバリ)",
