          "tc": "我們得快快進去完事才行。",
          "sc": "我们得快快进去完事才行。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 253902,
          "spk": "驹子 (コマコ)",
          "ja": "じゃ、開けるね",
          "tc": "那我要開門了。",
          "sc": "那我要开门了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4405,
      "rec_id": "TALK_ID_10_0302_032_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253930,
          "spk": "帷 (トバリ)",
          "ja": "ここが時計塔の中……",
          "tc": "這就是鐘樓裡面啊……",
          "sc": "这就是钟楼里面啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 253948,
          "spk": "驹子 (コマコ)",
          "ja": "私も、初めて入ったよ……",
          "tc": "我也是第一次進來……",
          "sc": "我也是第一次进来……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4406,
      "rec_id": "TALK_ID_10_0302_032_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253966,
          "spk": "帷 (トバリ)",
          "ja": "さあ、伝承にあった",
          "tc": "好了，來調查傳說裡提到的",
          "sc": "好了，来调查传说里提到的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 253973,
          "spk": "帷 (トバリ)",
          "ja": "「歌が刻まれた鐘」を調べましょう",
          "tc": "「刻著歌的鐘」吧。",
          "sc": "“刻着歌的钟”吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4407,
      "rec_id": "TALK_ID_10_0302_033_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 253999,
          "spk": "驹子 (コマコ)",
          "ja": "伝承通りなら、時計塔の鐘には",
          "tc": "如果傳說是真的，那麼鐘樓的鐘",
          "sc": "如果传说是真的，那么钟楼的钟"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254006,
          "spk": "驹子 (コマコ)",
          "ja": "「時間を巻き戻す奇跡を呼ぶ歌」が",
          "tc": "就刻有",
          "sc": "就刻有"
        },
        {
          "f_idx": 2,
          "pidx_tc": 254013,
          "spk": "驹子 (コマコ)",
          "ja": "書かれてるんだよね",
          "tc": "「倒轉時間呼喚奇蹟之歌」。",
          "sc": "“倒转时间呼唤奇迹之歌”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 254024,
          "spk": "驹子 (コマコ)",
          "ja": "さっそくだけど、",
          "tc": "事不宜遲，",
          "sc": "事不宜迟，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 254031,
          "spk": "驹子 (コマコ)",
          "ja": "鐘を調べてみよう",
          "tc": "我們就來看看調查那口鐘吧。",
          "sc": "我们就来看看调查那口钟吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4408,
      "rec_id": "TALK_ID_10_0302_033_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254057,
          "spk": "驹子 (コマコ)",
          "ja": "もっと近くで鐘を見たいな……",
          "tc": "我想更靠近一點看鐘……",
          "sc": "我想更靠近一点看钟……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254064,
          "spk": "驹子 (コマコ)",
          "ja": "その階段から近づけそうだね",
          "tc": "從那邊的樓梯上去，應該可以靠得更近。",
          "sc": "从那边的楼梯上去，应该可以靠得更近。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4409,
      "rec_id": "TALK_ID_10_0302_034_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254095,
          "spk": "帷 (トバリ)",
          "ja": "神さまが歌った「時間を巻き戻す歌」ね……",
          "tc": "神明大人所唱的「倒轉時間之歌」啊……",
          "sc": "神明大人所唱的“倒转时间之歌”啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254102,
          "spk": "帷 (トバリ)",
          "ja": "そんな奇跡のような出来事、",
          "tc": "實在很難相信",
          "sc": "实在很难相信"
        },
        {
          "f_idx": 2,
          "pidx_tc": 254109,
          "spk": "帷 (トバリ)",
          "ja": "にわかには信じられないけれど……",
          "tc": "會發生那種奇蹟般的事啊……",
          "sc": "会发生那种奇迹般的事啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 254120,
          "spk": "帷 (トバリ)",
          "ja": "……でも、深夜にはお化けが蔓延ってるし、",
          "tc": "……不過，深夜都能有妖怪橫行了，",
          "sc": "……不过，深夜都能有妖怪横行了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 254127,
          "spk": "帷 (トバリ)",
          "ja": "時間を戻す奇跡もあるのかもね",
          "tc": "發生倒轉時間的奇蹟也不無可能。",
          "sc": "发生倒转时间的奇迹也不无可能。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4410,
      "rec_id": "TALK_ID_10_0302_034_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 254160,
          "spk": "帷 (トバリ)",
          "ja": "鐘って、あそこにあるのよね……",
          "tc": "鐘應該就在那裡吧……",
          "sc": "钟应该就在那里吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 254167,
          "spk": "帷 (トバリ)",
