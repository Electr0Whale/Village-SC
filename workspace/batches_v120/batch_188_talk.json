          "sc": "那我就试着吹奏<strong>呼唤奇迹之歌</strong>啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4418,
      "rec_id": "TALK_ID_10_0302_035_08",
      "lines": [
