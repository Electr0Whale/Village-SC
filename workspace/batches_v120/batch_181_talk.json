      "rec_id": "TALK_ID_10_0301_003_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236936,
          "spk": "今野 (コンノ)",
          "ja": "いいですけど、入るときはその羽織を",
          "tc": "可以是可以，但進房之前，",
          "sc": "可以是可以，但进房之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236943,
          "spk": "今野 (コンノ)",
          "ja": "必ず脱いでくださいねェ",
          "tc": "請您一定要先脫下那外套。",
          "sc": "请您一定要先脱下那外套呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236950,
          "spk": "今野 (コンノ)",
          "ja": "間違っても木屑を、床に落とさないように",
          "tc": "千萬不能讓木屑掉到地板上。",
          "sc": "千万不能让木屑掉到地板上。"
        }
      ]
    },
    {
      "file": "talk.dat",
