    {
      "file": "talk.dat",
      "rec_idx": 4105,
      "rec_id": "TALK_ID_10_0301_002_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236295,
          "spk": "木助 (キスケ)",
          "ja": "おい、<player>",
          "tc": "喂，<player>，",
          "sc": "喂，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236302,
          "spk": "木助 (キスケ)",
          "ja": "話は変わるんだが、",
          "tc": "我們先換個話題，",
          "sc": "我们先换个话题，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236309,
          "spk": "木助 (キスケ)",
          "ja": "ちょっと頼まれてくれねぇか？",
          "tc": "可以拜託你一件事嗎？",
          "sc": "可以拜托你一件事吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236320,
          "spk": "木助 (キスケ)",
          "ja": "唐突だが、俺は久しぶりに",
          "tc": "雖然有點突然，",
          "sc": "虽然有点突然，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236327,
          "spk": "木助 (キスケ)",
          "ja": "読みたい本があるんだよ",
          "tc": "但我最近難得有本想看的書。",
          "sc": "但我最近难得有本想看的书。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 236340,
          "spk": "裕太 (ユータ)",
          "ja": "……は？",
          "tc": "……啊？",
          "sc": "……啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 236347,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、どうしちゃったの……",
          "tc": "學長，你是怎麼了……？",
          "sc": "学长，你是怎么了……？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 236358,
          "spk": "裕太 (ユータ)",
          "ja": "土地を売るって言ったり、",
          "tc": "一下說要賣土地，",
          "sc": "一下说要卖土地，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 236365,
          "spk": "裕太 (ユータ)",
          "ja": "本を読むとか言ったり……",
          "tc": "一下又說要看書……",
          "sc": "一下又说要看书……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 236372,
          "spk": "裕太 (ユータ)",
          "ja": "らしくないよ！",
          "tc": "一點都不像你啊！",
          "sc": "一点都不像你啊！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 236385,
          "spk": "木助 (キスケ)",
          "ja": "俺だって、本くらい読むぜ",
          "tc": "我也是會看書的好嗎。",
          "sc": "我也是会看书的好吗。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 236396,
          "spk": "木助 (キスケ)",
          "ja": "だが、村の図書館は閉まってるだろ？",
          "tc": "只是，現在村子的圖書館還關著吧？",
          "sc": "只是，现在村子的图书馆还关着吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 236403,
          "spk": "木助 (キスケ)",
          "ja": "図書館の鍵は、リンが管理してんだよ",
          "tc": "圖書館的鑰匙是由林保管的，",
          "sc": "图书馆的钥匙是由林保管的，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 236414,
          "spk": "木助 (キスケ)",
          "ja": "俺は、ちょっと用事が出来たんだ",
          "tc": "而我還有別的事要去做，",
          "sc": "而我还有别的事要去做，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 236421,
          "spk": "木助 (キスケ)",
          "ja": "だから俺の代わりに、",
          "tc": "所以說，你能幫我去向林",
          "sc": "所以说，你能帮我去向林"
        },
        {
          "f_idx": 15,
          "pidx_tc": 236428,
          "spk": "木助 (キスケ)",
          "ja": "図書館の鍵をリンに借りてきてくれねえか？",
          "tc": "借圖書館的鑰匙嗎？",
          "sc": "借图书馆的钥匙吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4106,
      "rec_id": "TALK_ID_10_0301_002_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236456,
          "spk": "木助 (キスケ)",
          "ja": "悪いが、頼んだぜ",
          "tc": "不好意思啊，麻煩你了。",
          "sc": "不好意思啊，麻烦你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4107,
      "rec_id": "TALK_ID_10_0301_002_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236474,
          "spk": "木助 (キスケ)",
          "ja": "さて、俺はコンノに用事があるんだ",
          "tc": "那我還有事要找今野，",
          "sc": "那我还有事要找今野，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236481,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "先走啦。",
          "sc": "先走啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4108,
      "rec_id": "TALK_ID_10_0301_002_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236503,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと、今のはどういうこと……",
          "tc": "等等，剛剛說的到底是……",
          "sc": "等等，刚刚说的到底是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236510,
          "spk": "裕太 (ユータ)",
          "ja": "先輩！　まだ話の途中でしょ！",
          "tc": "學長！我們還沒講完啊！",
          "sc": "学长！我们还没讲完啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4109,
      "rec_id": "TALK_ID_10_0301_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236534,
          "spk": "林 (リン)",
          "ja": "あら、<player>",
          "tc": "哎呀，是<player>啊。",
          "sc": "哎呀，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236541,
          "spk": "林 (リン)",
          "ja": "私に何か用かしら？",
          "tc": "找我有什麼事嗎？",
          "sc": "找我有什么事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4110,
      "rec_id": "TALK_ID_10_0301_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236559,
          "spk": "林 (リン)",
          "ja": "キスケさん、図書館の鍵が欲しいって……？",
          "tc": "木助哥想要圖書館的鑰匙……？",
          "sc": "木助哥想要图书馆的钥匙……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236566,
          "spk": "林 (リン)",
          "ja": "……急にどうしたのかしら",
          "tc": "……怎麼會這麼突然？",
          "sc": "……怎么会这么突然？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4111,
      "rec_id": "TALK_ID_10_0301_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236584,
          "spk": "林 (リン)",
          "ja": "うーん……まあ、いいわ",
          "tc": "嗯哼……算了，無所謂。",
          "sc": "嗯哼……算了，无所谓。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236595,
          "spk": "林 (リン)",
          "ja": "鍵は私の家に保管してあるから、",
          "tc": "鑰匙我保管在家裡，",
          "sc": "钥匙我保管在家里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236602,
          "spk": "林 (リン)",
          "ja": "一緒に家に来てちょうだい",
          "tc": "跟我來吧。",
          "sc": "跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4112,
      "rec_id": "TALK_ID_10_0301_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236626,
          "spk": "林 (リン)",
          "ja": "はい、待たせたわね",
          "tc": "來，久等了。",
          "sc": "来，久等了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236633,
          "spk": "林 (リン)",
          "ja": "これが図書館の鍵だから、",
          "tc": "這是圖書館的鑰匙，",
          "sc": "这是图书馆的钥匙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236640,
          "spk": "林 (リン)",
          "ja": "キスケさんの所に持っていってあげなさい",
          "tc": "你就拿去給木助哥吧。",
          "sc": "你就拿去给木助哥吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4113,
      "rec_id": "TALK_ID_10_0301_003_05",
      "lines": [
        {
