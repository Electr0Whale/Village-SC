      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236886,
          "spk": "木助 (キスケ)",
          "ja": "よし、ありがとうよ",
          "tc": "很好，謝啦。",
          "sc": "很好，谢啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236893,
          "spk": "木助 (キスケ)",
          "ja": "これで話が進められるぜ",
          "tc": "這下就能繼續進行了。",
          "sc": "这下就能继续进行了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4120,
      "rec_id": "TALK_ID_10_0301_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236911,
          "spk": "木助 (キスケ)",
          "ja": "じゃあコンノ、続きはてめぇの部屋で……",
          "tc": "那麼今野，再來就到你房間……",
          "sc": "那么今野，再来就到你房间……"
