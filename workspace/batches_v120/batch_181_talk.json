      "rec_id": "TALK_ID_10_0301_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237909,
          "spk": "帷 (トバリ)",
          "ja": "村と峠を繋ぐトンネルがあるでしょう？",
