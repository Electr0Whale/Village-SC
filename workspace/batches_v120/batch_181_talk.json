      "rec_id": "TALK_ID_10_0301_003_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236978,
          "spk": "林 (リン)",
          "ja": "ねえ、<player>……",
          "tc": "我說啊，<player>……",
          "sc": "我说啊，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236985,
          "spk": "林 (リン)",
          "ja": "……キスケさん、何か企んでいるんじゃない？",
          "tc": "……木助哥在盤算著什麼吧？",
          "sc": "……木助哥在盘算着什么吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236992,
          "spk": "林 (リン)",
          "ja": "あなた、何か知っているかしら？",
          "tc": "你是不是知道些什麼？",
          "sc": "你是不是知道些什么？"
