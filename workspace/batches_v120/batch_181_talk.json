          "sc": "才刚提到人……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236674,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんじゃないですかァ",
          "tc": "這不是<player>嗎？",
          "sc": "这不是<player>吗～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4114,
      "rec_id": "TALK_ID_10_0301_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236698,
          "spk": "木助 (キスケ)",
          "ja": "よお、てめぇもここにいたのか",
          "tc": "嗨，原來你也在這裡啊。",
          "sc": "嗨，原来你也在这里啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236713,
          "spk": "林 (リン)",
          "ja": "あら、コンノに……キスケさん？",
          "tc": "哎呀，是今野……還有木助哥？",
          "sc": "哎呀，是今野……还有木助哥？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236720,
          "spk": "林 (リン)",
          "ja": "二人して一体なにしているの？",
          "tc": "你們兩個在這裡做什麼？",
          "sc": "你们两个在这里做什么？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236740,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんの話を少しですね……",
          "tc": "我們正聊到有關<player>的事……",
          "sc": "我们正聊到有关<player>的事……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 236747,
          "spk": "今野 (コンノ)",
          "ja": "この村を発展させるための計画について、",
          "tc": "木助先生說是關乎村子發展的計畫，",
          "sc": "木助先生说是关乎村子发展的计划，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 236754,
          "spk": "今野 (コンノ)",
          "ja": "キスケさんが相談したいと言うものですからァ",
          "tc": "想要找我商量一下。",
          "sc": "想要找我商量一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4115,
      "rec_id": "TALK_ID_10_0301_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236772,
          "spk": "林 (リン)",
          "ja": "はぁ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236779,
          "spk": "林 (リン)",
          "ja": "その話を私抜きでしていたの？",
          "tc": "你們居然背著我討論這種話題？",
          "sc": "你们居然背着我讨论这种话题？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236786,
          "spk": "林 (リン)",
          "ja": "詳しく教えなさい",
          "tc": "快把詳情說給我聽。",
          "sc": "快把详情说给我听。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4116,
      "rec_id": "TALK_ID_10_0301_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236806,
          "spk": "木助 (キスケ)",
          "ja": "いやいや、図書館の復旧の話さ",
          "tc": "沒什麼，只是關於恢復圖書館的事，",
          "sc": "没什么，只是关于恢复图书馆的事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236813,
          "spk": "木助 (キスケ)",
          "ja": "大した話じゃねぇって……",
          "tc": "不是什麼大不了的……",
          "sc": "不是什么大不了的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4117,
      "rec_id": "TALK_ID_10_0301_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236831,
          "spk": "木助 (キスケ)",
          "ja": "それより、<player>",
          "tc": "先不說那個，<player>，",
          "sc": "先不说那个，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236838,
          "spk": "木助 (キスケ)",
          "ja": "リンは図書館の鍵を貸してくれたか？",
          "tc": "你向林借來圖書館的鑰匙了嗎？",
          "sc": "你向林借来图书馆的钥匙了吗？"
