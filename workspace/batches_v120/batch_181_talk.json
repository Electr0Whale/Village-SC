      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4123,
      "rec_id": "TALK_ID_10_0301_003_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237010,
          "spk": "林 (リン)",
          "ja": "あの人のことだから、きっと裏があるんでしょう",
          "tc": "畢竟他會這樣，肯定還有內幕吧。",
          "sc": "毕竟他会这样，肯定还有内幕吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237017,
          "spk": "林 (リン)",
          "ja": "あなたも気をつけなさいね",
          "tc": "你也要小心一點，",
          "sc": "你也要小心一点，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237028,
          "spk": "林 (リン)",
          "ja": "キスケさんはバカじゃないわ",
          "tc": "木助哥可不是傻子。",
          "sc": "木助哥可不是傻子。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237035,
          "spk": "林 (リン)",
          "ja": "あなたも知らぬ間に、あの人の「計画」に",
          "tc": "你或許在不知不覺中，",
          "sc": "你或许在不知不觉中，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237042,
          "spk": "林 (リン)",
          "ja": "乗せられているかもしれないから",
          "tc": "就成為他「計畫」中的棋子了。",
          "sc": "就成为他“计划”中的棋子了。"
