      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151130,
          "spk": "名护 (ナゴ)",
          "ja": "コーヒーを飲んできたからか、",
          "tc": "是不是因為我剛喝了咖啡，",
          "sc": "是不是因为我刚喝了咖啡，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151137,
          "spk": "名护 (ナゴ)",
          "ja": "少しは寒さもマシかな……",
          "tc": "才覺得好像沒那麼冷了……",
          "sc": "才觉得好像没那么冷了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151148,
          "spk": "名护 (ナゴ)",
          "ja": "体の芯まで冷えないうちに、",
          "tc": "趁還沒冷到骨頭裡，",
          "sc": "趁还没冷到骨头里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151155,
          "spk": "名护 (ナゴ)",
          "ja": "早く向かおう……",
          "tc": "我們趕快過去吧……",
          "sc": "我们赶快过去吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2096,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151179,
          "spk": "名护 (ナゴ)",
          "ja": "雪が降ると子どもは大喜びだろうけど",
          "tc": "下雪時孩子們應該都會很開心，",
          "sc": "下雪时孩子们应该都会很开心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151186,
          "spk": "名护 (ナゴ)",
          "ja": "大人は雪かきしないといけないから大変なんだ",
          "tc": "但大人還得鏟雪，真的很辛苦。",
          "sc": "但大人还得铲雪，真的很辛苦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151204,
          "spk": "名护 (ナゴ)",
          "ja": "ロッカクさんがヒーヒー言いながら作業してたよ",
          "tc": "之前還看到六角先生一邊哀嚎一邊鏟雪呢。",
          "sc": "之前还看到六角先生一边哀嚎一边铲雪呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2097,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151235,
          "spk": "名护 (ナゴ)",
          "ja": "溶けた雪が、氷を張っているところも",
          "tc": "有些融雪的地方好像結冰了，",
          "sc": "有些融雪的地方好像结冰了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151242,
          "spk": "名护 (ナゴ)",
          "ja": "あるみたいだから気をつけるんだよ",
          "tc": "走路要小心喔！",
          "sc": "走路要小心哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151253,
          "spk": "名护 (ナゴ)",
          "ja": "さっき、キスケさんがステンと転んでたからね",
          "tc": "像剛才木助先生就突然滑倒了。",
          "sc": "像刚才木助先生就突然滑倒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2098,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151284,
          "spk": "名护 (ナゴ)",
          "ja": "息を吐くと白くなるのは、体内で温まった空気が",
          "tc": "據說呼出的氣之所以會變白，",
          "sc": "据说呼出的气之所以会变白，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151291,
          "spk": "名护 (ナゴ)",
          "ja": "外気に触れて急激に冷えるから、という話だよ",
          "tc": "是因為體內溫暖的空氣接觸到冷空氣後急劇降溫。",
          "sc": "是因为体内温暖的空气接触到冷空气后急剧降温。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151309,
          "spk": "名护 (ナゴ)",
          "ja": "……俺は文系だから",
          "tc": "……但我是念文科的，",
          "sc": "……但我是念文科的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 151316,
          "spk": "名护 (ナゴ)",
          "ja": "詳しい原理はわからないけどね",
          "tc": "所以不清楚詳細原理。",
          "sc": "所以不清楚详细原理。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2099,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151340,
          "spk": "名护 (ナゴ)",
          "ja": "ウィンタースポーツが得意な人なら",
          "tc": "如果是擅長冬季運動的人，",
          "sc": "如果是擅长冬季运动的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151347,
          "spk": "名护 (ナゴ)",
          "ja": "雪山を見て、滑りたいと思うんだろうね",
          "tc": "看到雪山應該會很想滑雪吧。",
          "sc": "看到雪山应该会很想滑雪吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151365,
          "spk": "名护 (ナゴ)",
          "ja": "……俺はするよりも観る派かな",
          "tc": "……我可能比較喜歡用看的就好。",
          "sc": "……我可能比较喜欢用看的就好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2100,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151389,
          "spk": "名护 (ナゴ)",
          "ja": "俺たち生き物が寒さに打ち震えても",
          "tc": "就算我們這些生物被冷得直打哆嗦，",
          "sc": "就算我们这些生物被冷得直打哆嗦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151396,
          "spk": "名护 (ナゴ)",
          "ja": "自然というのは、まったくのお構いなしだ",
          "tc": "大自然也完全不會在意。",
          "sc": "大自然也完全不会在意。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151403,
          "spk": "名护 (ナゴ)",
          "ja": "こっちが順応していくしかないね",
          "tc": "只能由我們去適應它了呢。",
          "sc": "只能由我们去适应它了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2101,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151427,
          "spk": "名护 (ナゴ)",
          "ja": "極寒の地で観測されるオーロラだけど",
          "tc": "在極地觀測到的極光",
          "sc": "在极地观测到的极光"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151434,
          "spk": "名护 (ナゴ)",
          "ja": "寒さとは関係ないみたいだね",
          "tc": "似乎跟氣溫冷不冷沒有關係，",
          "sc": "似乎跟气温冷不冷没有关系，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151452,
          "spk": "名护 (ナゴ)",
          "ja": "稀に日本でも観測できるらしいけど……",
          "tc": "據說在日本偶爾也有機會可以觀測到……",
          "sc": "据说在日本偶尔也有机会可以观测到……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 151459,
          "spk": "名护 (ナゴ)",
          "ja": "この村からじゃさすがに無理かな……？",
          "tc": "但在這座村子應該沒辦法吧……？",
          "sc": "但在这座村子应该没办法吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2102,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151483,
          "spk": "名护 (ナゴ)",
          "ja": "夜道は暗いし、寒さも増してきた",
          "tc": "夜路這麼黑，天氣也越來越冷了。",
          "sc": "夜路这么黑，天气也越来越冷了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151501,
          "spk": "名护 (ナゴ)",
          "ja": "いつまでも出歩いていると危ないから、",
          "tc": "在外面晃太久很危險的，",
          "sc": "在外面晃太久很危险的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151508,
          "spk": "名护 (ナゴ)",
          "ja": "早めに帰るんだよ",
          "tc": "要早點回家喔。",
          "sc": "要早点回家哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 151515,
