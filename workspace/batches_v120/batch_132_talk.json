        {
          "f_idx": 2,
          "pidx_tc": 151557,
          "spk": "名护 (ナゴ)",
          "ja": "これは天体観測が楽しいね",
          "tc": "可以盡情進行天文觀測呢。",
          "sc": "可以尽情进行天文观测呢。"
        }
      ]
