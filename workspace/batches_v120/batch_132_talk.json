      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150777,
          "spk": "名护 (ナゴ)",
          "ja": "はぁ……温まるな……",
          "tc": "呼……真暖和……",
          "sc": "呼……真暖和……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150788,
          "spk": "名护 (ナゴ)",
          "ja": "手作りの料理は、体だけじゃなくて",
          "tc": "享用手作的料理，不只能暖和身體，",
          "sc": "享用手作的料理，不只能暖和身体，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150795,
          "spk": "名护 (ナゴ)",
          "ja": "心まで温めてくれる気がするね",
          "tc": "連心都感覺變暖了呢。",
          "sc": "连心都感觉变暖了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2089,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150819,
          "spk": "名护 (ナゴ)",
          "ja": "暖かい布団でぐっすり寝る……",
          "tc": "在溫暖的被窩裡睡個好覺……",
          "sc": "在温暖的被窝里睡个好觉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150826,
          "spk": "名护 (ナゴ)",
          "ja": "冬はツラいことも多いけど、この幸せが",
          "tc": "冬天雖然有滿多不好受的地方，",
          "sc": "冬天虽然有满多不好受的地方，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150833,
          "spk": "名护 (ナゴ)",
          "ja": "全部を帳消しにしてくれるよ……",
          "tc": "但這份幸福可以將一切一筆勾銷……",
          "sc": "但这份幸福可以将一切一笔勾销……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2090,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150857,
          "spk": "名护 (ナゴ)",
          "ja": "……ココも、布団に入りたいのか？",
          "tc": "……可可也想進被窩裡嗎？",
          "sc": "……可可也想进被窝里吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150875,
          "spk": "名护 (ナゴ)",
          "ja": "ふふ……猫は本当に、暖かいところが好きだなぁ",
          "tc": "呵呵……貓真的很喜歡溫暖的地方呢～",
          "sc": "呵呵……猫真的很喜欢温暖的地方呢～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150882,
          "spk": "名护 (ナゴ)",
          "ja": "おいで、俺の隣で……むにゃむにゃ……",
          "tc": "過來吧，到我旁邊……呼嚕呼嚕……",
          "sc": "过来吧，到我旁边……呼噜呼噜……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2091,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150913,
          "spk": "名护 (ナゴ)",
          "ja": "ちょっと体を動かしただけで、",
          "tc": "只是稍微活動一下身體，",
          "sc": "只是稍微活动一下身体，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150920,
          "spk": "名护 (ナゴ)",
          "ja": "どっと疲れたんだ……",
          "tc": "就累到不行了……",
          "sc": "就累到不行了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150931,
          "spk": "名护 (ナゴ)",
          "ja": "俺も、<player>さんたちと雪遊びして",
          "tc": "我是不是該跟<player>你們一起玩雪，",
          "sc": "我是不是该跟<player>你们一起玩雪，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150938,
          "spk": "名护 (ナゴ)",
          "ja": "体力をつけた方がいいかな……",
          "tc": "鍛鍊一下體力呢……",
          "sc": "锻炼一下体力呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2092,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150969,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさんから聞いたんだけど、",
          "tc": "我聽琪娜娜說，",
          "sc": "我听琪娜娜说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150976,
          "spk": "名护 (ナゴ)",
          "ja": "凍った道は少し歩幅を狭めて歩くと",
          "tc": "走在結冰的道路上，把步伐間距縮短，",
          "sc": "走在结冰的道路上，把步伐间距缩短，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150983,
          "spk": "名护 (ナゴ)",
          "ja": "転びにくいんだってね",
          "tc": "比較不容易滑倒。",
          "sc": "比较不容易滑倒。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150994,
          "spk": "名护 (ナゴ)",
          "ja": "ペンギンのように、",
          "tc": "聽說像企鵝那樣",
          "sc": "听说像企鹅那样"
        },
        {
          "f_idx": 4,
          "pidx_tc": 151001,
          "spk": "名护 (ナゴ)",
          "ja": "よちよち歩くといいらしいんだ",
          "tc": "搖搖晃晃地走路最有用。",
          "sc": "摇摇晃晃地走路最有用。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2093,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151025,
          "spk": "名护 (ナゴ)",
          "ja": "猫はこたつで丸くなる、なんて言うけど",
          "tc": "大家都說貓會窩在暖桌裡縮成一團。",
          "sc": "大家都说猫会窝在暖桌里缩成一团。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151043,
          "spk": "名护 (ナゴ)",
          "ja": "俺も部屋でゴロゴロしていたかったよ……",
          "tc": "我也好想窩在房間裡無所事事喔……",
          "sc": "我也好想窝在房间里无所事事哦……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151050,
          "spk": "名护 (ナゴ)",
          "ja": "この時期はもう、外に出るのがツラくて……",
          "tc": "這種季節出門真的太痛苦了……",
          "sc": "这种季节出门真的太痛苦了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2094,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151081,
          "spk": "名护 (ナゴ)",
          "ja": "歩くだけでこんなに疲れるのか……",
          "tc": "只是走路居然會這麼累嗎……",
          "sc": "只是走路居然会这么累吗……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151088,
          "spk": "名护 (ナゴ)",
          "ja": "雪って厄介なんだな",
          "tc": "雪真是太讓人困擾了。",
          "sc": "雪真是太让人困扰了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151099,
          "spk": "名护 (ナゴ)",
          "ja": "一歩進むだけで体力を持ってかれる……",
          "tc": "光是跨出一步就消耗這麼多體力……",
          "sc": "光是跨出一步就消耗这么多体力……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151106,
          "spk": "名护 (ナゴ)",
          "ja": "はあ……雪の無い道が恋しいよ",
          "tc": "唉……真是想念沒有積雪的道路啊。",
          "sc": "唉……真是想念没有积雪的道路啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
