      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_3810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8126,
          "spk": "木助 (キスケ)",
          "ja": "秋の雨は降りだすと長いんだ",
          "tc": "秋天一旦下起雨就會下很久，",
          "sc": "秋天一旦下起雨就会下很久，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 8144,
          "spk": "木助 (キスケ)",
          "ja": "早く晴れてくれねぇかなァ……",
          "tc": "真希望趕快放晴啊……",
          "sc": "真希望赶快放晴啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
