          "sc": "就让她见识见识木匠使出浑身解数所盖的雪屋！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 457,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9766,
          "spk": "木助 (キスケ)",
