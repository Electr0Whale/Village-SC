      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_3811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8175,
          "spk": "木助 (キスケ)",
          "ja": "今日の夜もロッカクの店に行くんだ",
          "tc": "今晚我也要去六角的店裡吃飯。",
          "sc": "今晚我也要去六角的店里吃饭。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 8182,
          "spk": "木助 (キスケ)",
          "ja": "……秋は美味いもん多いから、",
          "tc": "……秋天好吃的東西很多，",
          "sc": "……秋天好吃的东西很多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 8189,
          "spk": "木助 (キスケ)",
          "ja": "頻繁に通わねぇと食いきれねぇからな",
          "tc": "如果不常常去就沒辦法全部嘗過一遍啊。",
          "sc": "如果不常常去就没办法全部尝过一遍啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
