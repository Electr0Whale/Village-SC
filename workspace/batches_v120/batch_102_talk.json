      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9063,
          "spk": "木助 (キスケ)",
          "ja": "なんだかピューピューと音が鳴るな……",
          "tc": "怎麼一直聽到咻咻聲……",
