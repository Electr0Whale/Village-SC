        {
          "f_idx": 2,
          "pidx_tc": 10662,
          "spk": "木助 (キスケ)",
          "ja": "どうしようが俺の自由だろ？",
          "tc": "但我想怎麼做是我的自由吧？",
          "sc": "但我想怎么做是我的自由吧？"
        }
      ]
    },
