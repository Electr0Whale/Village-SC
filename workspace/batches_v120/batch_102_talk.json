      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9456,
          "spk": "木助 (キスケ)",
          "ja": "身体が芯から冷えてる時は、",
          "tc": "覺得全身上下都在發冷的時候，",
          "sc": "觉得全身上下都在发冷的时候，"
        },
