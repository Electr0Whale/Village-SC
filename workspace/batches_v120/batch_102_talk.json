      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4025",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8958,
          "spk": "木助 (キスケ)",
          "ja": "仕事終わりにここで休憩すんの、",
