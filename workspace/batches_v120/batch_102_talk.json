      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_3812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8213,
          "spk": "木助 (キスケ)",
          "ja": "ギンナンがあちこちに落ちてらぁ",
          "tc": "地上到處都是掉下來的銀杏果，",
          "sc": "地上到处都是掉下来的银杏果，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 8220,
          "spk": "木助 (キスケ)",
          "ja": "今夜の酒のアテにでもするかね",
          "tc": "不如拿來當今晚的下酒菜好了。",
          "sc": "不如拿来当今晚的下酒菜好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 8238,
          "spk": "木助 (キスケ)",
          "ja": "炒るだけでも美味えんだぜ、あれ",
          "tc": "只要炒一炒就會很好吃喔。",
          "sc": "只要炒一炒就会很好吃啊。"
        }
