          "spk": "木助 (キスケ)",
          "ja": "滑って転んだらいっかんの終わりだからな",
          "tc": "要是滑倒摔跤可就完了。",
          "sc": "要是滑倒摔跤可就完了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10436,
          "spk": "木助 (キスケ)",
          "ja": "どこまで滑り落ちるかわかったもんじゃねぇ",
          "tc": "天曉得會滑落到哪裡去。",
          "sc": "天晓得会滑落到哪里去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 472,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10467,
          "spk": "木助 (キスケ)",
          "ja": "ひとつ忠告しといてやるが、",
          "tc": "給你一個忠告，",
          "sc": "给你一个忠告，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10474,
          "spk": "木助 (キスケ)",
          "ja": "あんまり軒先を歩かねぇほうがいいぜ？",
          "tc": "盡量別走在屋簷下比較好。",
          "sc": "尽量别走在屋檐下比较好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10485,
          "spk": "木助 (キスケ)",
          "ja": "屋根から雪が落ちてくるかもしれねぇからな",
          "tc": "因為積雪有可能會從屋頂滑下來。",
          "sc": "因为积雪有可能会从屋顶滑下来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 473,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10516,
          "spk": "木助 (キスケ)",
          "ja": "さっさと外での用事を済ませねぇとな",
          "tc": "得趕快把在外頭的事做完，",
          "sc": "得赶快把在外头的事做完，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10523,
          "spk": "木助 (キスケ)",
          "ja": "じゃねぇと、凍えちまいそうだぜ",
          "tc": "不然感覺要凍僵了。",
          "sc": "不然感觉要冻僵了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 474,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10554,
          "spk": "木助 (キスケ)",
          "ja": "サザンカのところでカイロ買っとかねぇとな",
          "tc": "得去茶梅那裡買暖暖包才行。",
          "sc": "得去茶梅那里买暖暖包才行。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10561,
          "spk": "木助 (キスケ)",
          "ja": "仕事中、指先を温めるのに便利なんだよ",
          "tc": "工作的時候用來暖手很方便。",
          "sc": "工作的时候用来暖手很方便。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 475,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10592,
          "spk": "木助 (キスケ)",
          "ja": "よお、この雪の中に一人で散歩かよ",
          "tc": "嗨，你一個人在雪中散步啊。",
          "sc": "嗨，你一个人在雪中散步啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10599,
          "spk": "木助 (キスケ)",
          "ja": "……まあ気持ちはわかるけどな",
          "tc": "……雖然我能理解你的心情啦。",
          "sc": "……虽然我能理解你的心情啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10610,
          "spk": "木助 (キスケ)",
          "ja": "雪の夜は怖いほど静かで穏やかだからな、",
          "tc": "下雪的夜晚安靜得嚇人，",
          "sc": "下雪的夜晚安静得吓人，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10617,
          "spk": "木助 (キスケ)",
          "ja": "物思いにふけって歩くのにぴったりだ",
          "tc": "所以很適合邊想事情邊散步。",
          "sc": "所以很适合边想事情边散步。"
        }
      ]
    },
    {
      "file": "talk.dat",
