      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9494,
          "spk": "木助 (キスケ)",
          "ja": "おっ、暖まりに来たのか？",
          "tc": "哦，你是來取暖的嗎？",
          "sc": "哦，你是来取暖的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 9505,
          "spk": "木助 (キスケ)",
          "ja": "だったら、ちょうどよかったな",
          "tc": "這樣的話你來得正好，",
          "sc": "这样的话你来得正好，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 9512,
          "spk": "木助 (キスケ)",
          "ja": "炭にいい感じで火が入ってきたところだぜ",
          "tc": "炭火剛好開始燒起來了呢。",
          "sc": "炭火刚好开始烧起来了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 452,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9536,
          "spk": "木助 (キスケ)",
          "ja": "トバリのやつ、最近は外に出てんのかね？",
          "tc": "帷那傢伙，最近有沒有出門啊？",
          "sc": "帷那家伙，最近有没有出门啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 9543,
          "spk": "木助 (キスケ)",
          "ja": "寒いから引きこもってんじゃねぇか？",
          "tc": "該不會是因為很冷，所以都窩在家裡吧？",
          "sc": "该不会是因为很冷，所以都窝在家里吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 9561,
          "spk": "木助 (キスケ)",
          "ja": "あんまとやかく言ってもしかたねぇけどよ",
          "tc": "雖然也輪不到我說三道四的啦。",
          "sc": "虽然也轮不到我说三道四的啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 453,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9585,
          "spk": "木助 (キスケ)",
          "ja": "てめぇとはよく顔を合わせると思ってたが、",
          "tc": "雖然我也覺得很常跟你碰到面，",
          "sc": "虽然我也觉得很常跟你碰到面，"
        },
