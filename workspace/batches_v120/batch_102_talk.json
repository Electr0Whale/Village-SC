      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8032,
          "spk": "木助 (キスケ)",
          "ja": "さっきコマコに会ったんだが、",
          "tc": "我剛剛碰見了駒子，",
          "sc": "我刚刚碰见了驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 8039,
          "spk": "木助 (キスケ)",
          "ja": "また困った顔して走り回ってたぜ",
          "tc": "看她又一臉困擾地跑來跑去的。",
          "sc": "看她又一脸困扰地跑来跑去的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 8046,
          "spk": "木助 (キスケ)",
          "ja": "まったく、忙しないヤツだよな",
          "tc": "真是個慌慌張張的傢伙啊。",
          "sc": "真是个慌慌张张的家伙啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 419,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_3803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8070,
          "spk": "木助 (キスケ)",
          "ja": "夏の暑さも彼岸まで、だな",
          "tc": "都說夏天就熱到秋分為止，",
          "sc": "都说夏天就热到秋分为止，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 8077,
          "spk": "木助 (キスケ)",
          "ja": "この前までの暑さが嘘みてえだ",
          "tc": "前陣子那麼熱都像假的一樣。",
          "sc": "前阵子那么热都像假的一样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 8095,
          "spk": "木助 (キスケ)",
          "ja": "んで、気がつくと雪降ってんだよなぁ……",
          "tc": "然後再回過神來就會發現下雪了……",
          "sc": "然后再回过神来就会发现下雪了……"
        }
      ]
    },
    {
      "file": "talk.dat",
