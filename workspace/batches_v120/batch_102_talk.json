          "pidx_tc": 7990,
          "spk": "木助 (キスケ)",
          "ja": "最近は朝が冷えてきたな",
          "tc": "最近早上開始變冷了，",
          "sc": "最近早上开始变冷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 7997,
          "spk": "木助 (キスケ)",
          "ja": "油断すると風邪引いちまいそうだぜ",
          "tc": "感覺一不小心就會感冒了。",
          "sc": "感觉一不小心就会感冒了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 8008,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも気をつけろよ",
          "tc": "你也要小心點啊。",
          "sc": "你也要小心点啊。"
