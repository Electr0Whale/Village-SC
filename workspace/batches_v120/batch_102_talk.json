          "f_idx": 1,
          "pidx_tc": 9592,
          "spk": "木助 (キスケ)",
          "ja": "冬の朝にこんな水場でも会うとはな……",
          "tc": "但沒想到連在冬天早上的水邊都能遇見你……",
          "sc": "但没想到连在冬天早上的水边都能遇见你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 9599,
          "spk": "木助 (キスケ)",
          "ja": "よっぽど気が合うのかもな、俺たち",
          "tc": "看來我們挺合得來的嘛。",
          "sc": "看来我们挺合得来的嘛。"
