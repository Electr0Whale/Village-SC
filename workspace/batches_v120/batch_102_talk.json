      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4024",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8902,
          "spk": "木助 (キスケ)",
          "ja": "最近、山道でシロージを見かけたんだが……",
