          "pidx_tc": 9463,
          "spk": "木助 (キスケ)",
          "ja": "熱々の風呂に入るのに限るぜ",
          "tc": "就該泡個熱水澡。",
          "sc": "就该泡个热水澡。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 9470,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもそう思うだろ？",
          "tc": "你也這麼覺得吧？",
          "sc": "你也这么觉得吧？"
