        {
          "f_idx": 1,
          "pidx_tc": 8909,
          "spk": "木助 (キスケ)",
          "ja": "あいつ、遠目で見るとクマにしか見えねぇよな",
          "tc": "你不覺得那傢伙從遠處看根本就是頭熊嗎？",
          "sc": "你不觉得那家伙从远处看根本就是头熊吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 8927,
          "spk": "木助 (キスケ)",
          "ja": "穴持たずのクマかと思って、",
          "tc": "害我以為是沒冬眠的熊，",
          "sc": "害我以为是没冬眠的熊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 8934,
          "spk": "木助 (キスケ)",
          "ja": "一瞬焦っちまったぜ",
          "tc": "嚇了我一跳。",
          "sc": "吓了我一跳。"
