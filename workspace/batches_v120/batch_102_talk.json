      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 8558,
          "spk": "木助 (キスケ)",
          "ja": "凍って滑る道を行くのは面倒だが、",
          "tc": "在結凍會打滑的路上走雖然很麻煩，",
