      "rec_id": "TALK_ID_CARPENTER_ROUTINE_20_102_4210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 9710,
          "spk": "木助 (キスケ)",
          "ja": "せっかくの休みなのに雪かァ……",
