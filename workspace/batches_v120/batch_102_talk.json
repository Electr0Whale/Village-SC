          "f_idx": 1,
          "pidx_tc": 8965,
          "spk": "木助 (キスケ)",
          "ja": "結構気に入ってるんだが……",
          "tc": "在這裡小歇一下……",
          "sc": "在这里小歇一下……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 8976,
          "spk": "木助 (キスケ)",
          "ja": "風邪は引きたくねぇから、長居はできねぇなァ",
          "tc": "但要是待太久感冒就不好了。",
