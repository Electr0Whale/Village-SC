        {
          "f_idx": 2,
          "pidx_tc": 125223,
          "spk": "四郎治 (シロージ)",
          "ja": "びっくりするんだよな……",
          "tc": "我都會嚇到……",
          "sc": "我都会吓到……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 684,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125247,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろコンノに上等な",
          "tc": "今野差不多也該把",
          "sc": "今野差不多也该把"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125254,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかい上着を譲ってもらえねぇかな",
          "tc": "高級的溫暖外套讓給我了吧。",
