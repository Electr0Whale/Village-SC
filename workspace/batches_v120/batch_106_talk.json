    },
    {
      "file": "talk.dat",
      "rec_idx": 689,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125488,
          "spk": "四郎治 (シロージ)",
          "ja": "整理整頓ってのは",
          "tc": "為什麼打掃跟整理東西",
          "sc": "为什么打扫跟整理东西"
