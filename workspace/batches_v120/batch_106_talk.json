        },
        {
          "f_idx": 2,
          "pidx_tc": 125597,
          "spk": "四郎治 (シロージ)",
          "ja": "ゼロの数が一つおかしいんじゃねぇか？",
          "tc": "這是不是多了一個零啊？",
          "sc": "这是不是多了一个零啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
