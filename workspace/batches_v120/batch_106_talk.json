      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123635,
          "spk": "四郎治 (シロージ)",
          "ja": "カエデの木は家具をつくるのに",
          "tc": "楓樹好像很適合拿來",
          "sc": "枫树好像很适合拿来"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123642,
          "spk": "四郎治 (シロージ)",
          "ja": "向いてるらしくてな",
          "tc": "製作家具，",
          "sc": "制作家具，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123649,
          "spk": "四郎治 (シロージ)",
          "ja": "持ってくとキスケが喜ぶんだ",
          "tc": "所以拿去給木助的話他都會很高興。",
          "sc": "所以拿去给木助的话他都会很高兴。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 646,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123673,
          "spk": "四郎治 (シロージ)",
          "ja": "早めに薪割りが終わったら",
          "tc": "如果砍柴能提早結束，",
          "sc": "如果砍柴能提早结束，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123680,
          "spk": "四郎治 (シロージ)",
          "ja": "夜、趣味に時間を割ける",
          "tc": "晚上應該就能把時間",
          "sc": "晚上应该就能把时间"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123687,
          "spk": "四郎治 (シロージ)",
          "ja": "かもしれねぇな……",
          "tc": "用在我的興趣上了……",
          "sc": "用在我的兴趣上了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 647,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123711,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかく乾燥してきたってのに",
          "tc": "好不容易乾得差不多了，",
          "sc": "好不容易干得差不多了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123718,
          "spk": "四郎治 (シロージ)",
          "ja": "雨が降ると、木が水分吸って",
          "tc": "一下雨樹木就會吸收水分，",
          "sc": "一下雨树木就会吸收水分，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123725,
          "spk": "四郎治 (シロージ)",
          "ja": "重くなるから面倒なんだよな",
          "tc": "會變得很重，很麻煩的啊。",
          "sc": "会变得很重，很麻烦的啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 648,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123749,
          "spk": "四郎治 (シロージ)",
          "ja": "……腹が減ったな",
          "tc": "……肚子餓了。",
          "sc": "……肚子饿了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123760,
          "spk": "四郎治 (シロージ)",
          "ja": "最近、やけに食欲が増してる気がするのは",
          "tc": "感覺最近食欲莫名地增加了，",
          "sc": "感觉最近食欲莫名地增加了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123767,
          "spk": "四郎治 (シロージ)",
          "ja": "秋だからか？",
          "tc": "是秋天的緣故嗎？",
          "sc": "是秋天的缘故吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 649,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123798,
          "spk": "四郎治 (シロージ)",
          "ja": "いつまで降り続けるんだろうな",
          "tc": "雨到底會下到什麼時候？",
          "sc": "雨到底会下到什么时候？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123805,
          "spk": "四郎治 (シロージ)",
          "ja": "夜までずっとか……",
          "tc": "會一直下到晚上嗎……",
          "sc": "会一直下到晚上吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 650,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3213",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123829,
          "spk": "四郎治 (シロージ)",
          "ja": "涼しい時期になってくると",
          "tc": "進入涼爽的時期後，",
          "sc": "进入凉爽的时期后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123836,
          "spk": "四郎治 (シロージ)",
          "ja": "だんだんと空気が乾燥するからな……",
          "tc": "空氣也會漸漸變乾燥……",
          "sc": "空气也会渐渐变干燥……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123847,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱり水分はちゃんと摂らねぇと",
          "tc": "所以還是要好好補充水分才行。",
          "sc": "所以还是要好好补充水分才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 651,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3214",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123878,
          "spk": "四郎治 (シロージ)",
          "ja": "少し秋の風に当たって涼んだら",
          "tc": "稍微吹點秋風、乘涼一下之後，",
          "sc": "稍微吹点秋风、乘凉一下之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123885,
          "spk": "四郎治 (シロージ)",
          "ja": "また戻るとするか……",
          "tc": "就繼續回去工作吧……",
          "sc": "就继续回去工作吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 652,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123909,
          "spk": "四郎治 (シロージ)",
          "ja": "秋の魚もキノコも",
          "tc": "不管是秋季漁產還是菇類，",
          "sc": "不管是秋季渔产还是菇类，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123916,
          "spk": "四郎治 (シロージ)",
          "ja": "ロッカクさんが調理すると",
          "tc": "只要拿給六角叔料理，",
          "sc": "只要拿给六角叔料理，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123923,
          "spk": "四郎治 (シロージ)",
          "ja": "美味いご馳走になるもんだな",
          "tc": "都會變成美味的佳餚。",
          "sc": "都会变成美味的佳肴。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 653,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123947,
          "spk": "四郎治 (シロージ)",
          "ja": "俺はもう寝る……",
          "tc": "我要睡了……",
          "sc": "我要睡了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123954,
          "spk": "四郎治 (シロージ)",
          "ja": "お前も早く寝とけ……",
          "tc": "你也早點睡吧……",
          "sc": "你也早点睡吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 654,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123978,
          "spk": "四郎治 (シロージ)",
          "ja": "鈴虫の声を聞いてると",
          "tc": "只要聽著鈴蟲的叫聲，",
          "sc": "只要听着铃虫的叫声，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123985,
          "spk": "四郎治 (シロージ)",
          "ja": "気分が落ち着いて眠くなってくる……",
          "tc": "心情就會沉澱下來，也會開始變得想睡……",
          "sc": "心情就会沉淀下来，也会开始变得想睡……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 655,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124009,
          "spk": "四郎治 (シロージ)",
          "ja": "明日の仕事は……",
          "tc": "明天的工作是……",
          "sc": "明天的工作是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124016,
          "spk": "四郎治 (シロージ)",
          "ja": "駄目だ、ねみぃ……",
          "tc": "不行了，好睏……",
          "sc": "不行了，好困……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 656,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124040,
          "spk": "四郎治 (シロージ)",
          "ja": "ただでさえ涼しいのに",
          "tc": "本來就很涼爽了，",
          "sc": "本来就很凉爽了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124047,
          "spk": "四郎治 (シロージ)",
          "ja": "雨まで降るとさすがに寒いな",
          "tc": "一下雨感覺就變得更冷了。",
          "sc": "一下雨感觉就变得更冷了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124058,
          "spk": "四郎治 (シロージ)",
          "ja": "風邪ひかねぇようにしないと",
          "tc": "得小心別感冒啊。",
          "sc": "得小心别感冒啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 657,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124082,
          "spk": "四郎治 (シロージ)",
          "ja": "木の葉の色が変わってくると",
          "tc": "樹葉一變色，",
          "sc": "树叶一变色，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124089,
          "spk": "四郎治 (シロージ)",
          "ja": "秋が来たって感じがするんだよな",
          "tc": "就會有種秋天到了的感覺。",
          "sc": "就会有种秋天到了的感觉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 658,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124120,
          "spk": "四郎治 (シロージ)",
          "ja": "涼しいと薪割りも",
          "tc": "天氣變涼之後，",
          "sc": "天气变凉之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124127,
          "spk": "四郎治 (シロージ)",
          "ja": "少し楽になるから助かるぜ",
          "tc": "劈柴也變得比較輕鬆了。",
          "sc": "劈柴也变得比较轻松了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124138,
          "spk": "四郎治 (シロージ)",
          "ja": "夏は暑くて大変だったんだ",
          "tc": "夏天太熱，會劈得很辛苦。",
          "sc": "夏天太热，会劈得很辛苦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 659,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124162,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウに綺麗なドングリを",
          "tc": "洋給了我漂亮的橡實，",
          "sc": "洋给了我漂亮的橡实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124169,
          "spk": "四郎治 (シロージ)",
          "ja": "もらったお返しをしねぇとな",
          "tc": "我也得回送她一些東西才行。",
          "sc": "我也得回送她一些东西才行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124180,
          "spk": "四郎治 (シロージ)",
          "ja": "後で山の中で探しとくか",
          "tc": "晚點去山裡找找好了。",
          "sc": "晚点去山里找找好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 660,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124211,
          "spk": "四郎治 (シロージ)",
          "ja": "雨に濡れた紅葉っていうのは",
          "tc": "被雨打濕的楓葉",
          "sc": "被雨打湿的枫叶"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124218,
          "spk": "四郎治 (シロージ)",
          "ja": "やけにキレイなんだよな",
          "tc": "看起來特別漂亮。",
          "sc": "看起来特别漂亮。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 661,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124242,
          "spk": "四郎治 (シロージ)",
          "ja": "秋になると山でいろんな",
          "tc": "入秋之後，就可以在山裡",
          "sc": "入秋之后，就可以在山里"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124249,
          "spk": "四郎治 (シロージ)",
          "ja": "食材が採れるんだぜ",
          "tc": "採集到各式各樣的食材喔。",
          "sc": "采集到各式各样的食材啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124260,
          "spk": "四郎治 (シロージ)",
          "ja": "後で行ってみろよ",
          "tc": "你晚點也去看看吧。",
          "sc": "你晚点也去看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 662,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124284,
          "spk": "四郎治 (シロージ)",
          "ja": "少し風が冷たいな……",
          "tc": "風有點冷啊……",
          "sc": "风有点冷啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124295,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコに身体を冷やさないよう",
          "tc": "得叮嚀駒子",
          "sc": "得叮咛驹子"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124302,
          "spk": "四郎治 (シロージ)",
          "ja": "言っておかないとな",
          "tc": "不要讓自己著涼了。",
          "sc": "不要让自己着凉了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 663,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124326,
          "spk": "四郎治 (シロージ)",
          "ja": "ギンナンの匂いがするな",
          "tc": "有銀杏果的味道。",
          "sc": "有银杏果的味道。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124337,
          "spk": "四郎治 (シロージ)",
          "ja": "放っておくのはもったいねぇし",
          "tc": "就這樣丟在這裡太可惜了，",
          "sc": "就这样丢在这里太可惜了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124344,
          "spk": "四郎治 (シロージ)",
          "ja": "あとで拾って帰るか",
          "tc": "晚點撿回家好了。",
          "sc": "晚点捡回家好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 664,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124375,
          "spk": "四郎治 (シロージ)",
          "ja": "明日は雨じゃねぇといいな",
          "tc": "希望明天不會下雨，",
          "sc": "希望明天不会下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124382,
          "spk": "四郎治 (シロージ)",
          "ja": "仕事に支障が出て嫌なんだよ",
          "tc": "不然工作進展會被干擾，很討厭啊。",
          "sc": "不然工作进展会被干扰，很讨厌啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 665,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124406,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は星が綺麗に見えるな",
          "tc": "今天能很清楚地看見星星啊。",
          "sc": "今天能很清楚地看见星星啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124417,
          "spk": "四郎治 (シロージ)",
          "ja": "ま、星座や何やらは",
          "tc": "但我搞不懂",
          "sc": "但我搞不懂"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124424,
          "spk": "四郎治 (シロージ)",
          "ja": "よく知らねぇんだけどな",
          "tc": "星座什麼的。",
          "sc": "星座什么的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 666,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124448,
          "spk": "四郎治 (シロージ)",
          "ja": "あまり遅くまで出歩くなよ",
          "tc": "不要太晚出門，",
          "sc": "不要太晚出门，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124455,
          "spk": "四郎治 (シロージ)",
          "ja": "夜は冷えるし風邪ひくぞ",
          "tc": "不然晚上降溫很容易感冒的。",
          "sc": "不然晚上降温很容易感冒的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 667,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_3823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124479,
          "spk": "四郎治 (シロージ)",
          "ja": "こんくらいの気温がちょうどいいよな",
          "tc": "這種氣溫是最剛好的了，",
          "sc": "这种气温是最刚好的了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124486,
          "spk": "四郎治 (シロージ)",
          "ja": "夏は暑すぎるし、冬は寒くて仕方がねぇ",
          "tc": "不然夏天太熱，冬天又冷到不行。",
          "sc": "不然夏天太热，冬天又冷到不行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 668,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124517,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと雪かきしておかねぇと",
          "tc": "得記得好好剷雪啊，",
          "sc": "得记得好好铲雪啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124524,
          "spk": "四郎治 (シロージ)",
          "ja": "ろくに道を歩けないからな",
          "tc": "不然會沒辦法正常走路。",
          "sc": "不然会没办法正常走路。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124531,
          "spk": "四郎治 (シロージ)",
          "ja": "サボると後で痛い目見るぜ",
          "tc": "偷懶的後果可是很嚴重的。",
          "sc": "偷懒的后果可是很严重的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 669,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124555,
          "spk": "四郎治 (シロージ)",
          "ja": "雪が降ってる日は一段と冷え込む",
          "tc": "一下雪感覺就更冷了，",
          "sc": "一下雪感觉就更冷了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124573,
          "spk": "四郎治 (シロージ)",
          "ja": "暖房をつけて部屋を暖かくしないと",
          "tc": "不開暖氣讓房間暖起來，",
          "sc": "不开暖气让房间暖起来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 124580,
          "spk": "四郎治 (シロージ)",
          "ja": "凍っちまうかもしれねぇ",
          "tc": "是有可能會凍僵的。",
          "sc": "是有可能会冻僵的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 670,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124604,
          "spk": "四郎治 (シロージ)",
          "ja": "リンのやつがケチって薪を",
          "tc": "林那傢伙省東省西的，",
          "sc": "林那家伙省东省西的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124611,
          "spk": "四郎治 (シロージ)",
          "ja": "節約しようとするんだよ",
          "tc": "就連木柴也想要省。",
          "sc": "就连木柴也想要省。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124622,
          "spk": "四郎治 (シロージ)",
          "ja": "お前からも止めるように言っといてくれ",
          "tc": "你也去講幾句勸勸她吧。",
          "sc": "你也去讲几句劝劝她吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 671,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124653,
          "spk": "四郎治 (シロージ)",
          "ja": "リンとか他の家の分だけじゃなくて",
          "tc": "除了林和其他人家的之外，",
          "sc": "除了林和其他人家的之外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124660,
          "spk": "四郎治 (シロージ)",
          "ja": "自分ちの薪もちゃんと用意しないとな",
          "tc": "也得準備我們自己用的木柴才行。",
          "sc": "也得准备我们自己用的木柴才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 672,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124691,
          "spk": "四郎治 (シロージ)",
          "ja": "小さい頃、コマコとかまくらを作って",
          "tc": "我小時候好像和駒子蓋過雪屋，",
          "sc": "我小时候好像和驹子盖过雪屋，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124698,
          "spk": "四郎治 (シロージ)",
          "ja": "秘密基地代わりにしたことがあったっけな",
          "tc": "然後當作是我們的祕密基地。",
          "sc": "然后当作是我们的秘密基地。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 124716,
          "spk": "四郎治 (シロージ)",
          "ja": "もう覚えてないだろうけどさ",
          "tc": "不過她應該不記得了吧。",
          "sc": "不过她应该不记得了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 673,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124740,
          "spk": "四郎治 (シロージ)",
          "ja": "雪が積もってるのを見ると",
          "tc": "看到這片積雪，",
          "sc": "看到这片积雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124747,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと雪合戦したくなるんだよな",
          "tc": "就讓人有點想打雪仗。",
          "sc": "就让人有点想打雪仗。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124758,
          "spk": "四郎治 (シロージ)",
          "ja": "スミレあたりなら付き合ってくれるか……？",
          "tc": "堇怜他們應該會願意陪我吧……？",
          "sc": "堇怜他们应该会愿意陪我吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 674,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124782,
          "spk": "四郎治 (シロージ)",
          "ja": "俺そっくりな雪だるまを作ったら",
          "tc": "如果做出了跟我一模一樣的雪人，",
          "sc": "如果做出了跟我一模一样的雪人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124789,
          "spk": "四郎治 (シロージ)",
          "ja": "動き出して俺の代わりに仕事を……",
          "tc": "它就會代替我去工作……",
          "sc": "它就会代替我去工作……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 124807,
          "spk": "四郎治 (シロージ)",
          "ja": "してくれるわけねぇよな",
          "tc": "沒這可能嗎。",
          "sc": "没这可能吗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 675,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4023",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124831,
          "spk": "四郎治 (シロージ)",
          "ja": "冬の時期は寒さもそうだが",
          "tc": "冬天除了寒冷的問題，",
          "sc": "冬天除了寒冷的问题，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124838,
          "spk": "四郎治 (シロージ)",
          "ja": "空気が乾燥するのも厄介だな",
          "tc": "空氣乾燥也很讓人困擾。",
          "sc": "空气干燥也很让人困扰。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124845,
          "spk": "四郎治 (シロージ)",
          "ja": "喉が痛くなって困るぜ",
          "tc": "喉嚨好痛啊，真傷腦筋。",
          "sc": "喉咙好痛啊，真伤脑筋。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 676,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4024",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124869,
          "spk": "四郎治 (シロージ)",
          "ja": "そんな驚いた顔してどうした",
          "tc": "你怎麼一臉驚訝的？",
          "sc": "你怎么一脸惊讶的？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124880,
          "spk": "四郎治 (シロージ)",
          "ja": "冬ごもりから起きたクマでも見たのか？",
          "tc": "你是看到結束冬眠的熊了嗎？",
          "sc": "你是看到结束冬眠的熊了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 124898,
          "spk": "四郎治 (シロージ)",
          "ja": "……ん？　俺をクマと見間違えた？",
          "tc": "……嗯？所以你把我看成熊了？",
          "sc": "……嗯？所以你把我看成熊了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 677,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4025",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124922,
          "spk": "四郎治 (シロージ)",
          "ja": "この季節は空気が澄んでる",
          "tc": "這個季節的空氣很清新。",
          "sc": "这个季节的空气很清新。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 124933,
          "spk": "四郎治 (シロージ)",
          "ja": "空がいつも以上に透き通って見えるのは",
          "tc": "天空看起來比平常更純淨，",
          "sc": "天空看起来比平常更纯净，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124940,
          "spk": "四郎治 (シロージ)",
          "ja": "気のせいじゃないんだろうな",
          "tc": "這應該不是我的錯覺吧？",
          "sc": "这应该不是我的错觉吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 678,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 124964,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>にとっての冬の幸せってなんだ？",
          "tc": "對<player>你來說，冬天最幸福的是什麼？",
          "sc": "对<player>你来说，冬天最幸福的是什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 124982,
          "spk": "四郎治 (シロージ)",
          "ja": "俺はこうしてあったかい部屋で",
          "tc": "我大概就是在溫暖的房間裡，",
          "sc": "我大概就是在温暖的房间里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 124989,
          "spk": "四郎治 (シロージ)",
          "ja": "スニーカーの手入れをしてる時かもしれねぇ",
          "tc": "保養球鞋的時候最幸福吧。",
          "sc": "保养球鞋的时候最幸福吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 679,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125020,
          "spk": "四郎治 (シロージ)",
          "ja": "このスニーカーは水に強いから",
          "tc": "這雙球鞋的防水力很強，",
          "sc": "这双球鞋的防水力很强，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125027,
          "spk": "四郎治 (シロージ)",
          "ja": "雪の中でも履けるんだよな",
          "tc": "所以在雪地裡也可以穿。",
          "sc": "所以在雪地里也可以穿。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125045,
          "spk": "四郎治 (シロージ)",
          "ja": "もったいないから履かないけどさ",
          "tc": "但這樣穿太糟蹋了，所以我是不會穿的。",
          "sc": "但这样穿太糟蹋了，所以我是不会穿的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 680,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125069,
          "spk": "四郎治 (シロージ)",
          "ja": "冬は雪と土が混じって靴が汚れやすいから",
          "tc": "冬天的地面混雜著雪和泥土，所以鞋子很容易髒，",
          "sc": "冬天的地面混杂着雪和泥土，所以鞋子很容易脏，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125076,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も定期的に手入れしたほうがいいぞ",
          "tc": "<player>你最好也要定期保養鞋子喔。",
          "sc": "<player>你最好也要定期保养鞋子啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125094,
          "spk": "四郎治 (シロージ)",
          "ja": "なんなら道具も貸してやる",
          "tc": "我還可以把工具借給你。",
          "sc": "我还可以把工具借给你。"
        }
