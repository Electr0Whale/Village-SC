      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125125,
          "spk": "四郎治 (シロージ)",
          "ja": "寒くても身体を動かしてると",
          "tc": "天氣冷的時候，",
          "sc": "天气冷的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125132,
          "spk": "四郎治 (シロージ)",
          "ja": "だいぶマシになるもんだ",
          "tc": "動動身體感覺就會好很多。",
          "sc": "动动身体感觉就会好很多。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125143,
          "spk": "四郎治 (シロージ)",
          "ja": "汗まで掻いてきちまった",
          "tc": "我甚至出汗了呢。",
          "sc": "我甚至出汗了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 682,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125167,
          "spk": "四郎治 (シロージ)",
          "ja": "さっきは通りかかったウサギを",
          "tc": "剛剛嚇到了一隻",
          "sc": "刚刚吓到了一只"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125174,
          "spk": "四郎治 (シロージ)",
          "ja": "びびらせちまった……",
          "tc": "路過的兔子……",
          "sc": "路过的兔子……"
