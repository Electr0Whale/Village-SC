        },
        {
          "f_idx": 3,
          "pidx_tc": 125272,
          "spk": "四郎治 (シロージ)",
          "ja": "今度様子を窺ってみるか",
          "tc": "下次看看他怎麼想的好了。",
          "sc": "下次看看他怎么想的好了。"
