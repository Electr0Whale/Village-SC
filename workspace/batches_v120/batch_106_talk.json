      "rec_idx": 690,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125530,
          "spk": "四郎治 (シロージ)",
          "ja": "冬はスキー場が人気なのか",
          "tc": "冬天滑雪場很受歡迎嗎？",
          "sc": "冬天滑雪场很受欢迎吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125548,
          "spk": "四郎治 (シロージ)",
          "ja": "わざわざそんなとこ行かないでも",
          "tc": "不用專程跑去滑雪場，",
          "sc": "不用专程跑去滑雪场，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125555,
          "spk": "四郎治 (シロージ)",
          "ja": "そこの山でできちまうんだよな",
          "tc": "我們這附近的山區就可以滑雪了。",
          "sc": "我们这附近的山区就可以滑雪了。"
