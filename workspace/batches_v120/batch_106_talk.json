        {
          "f_idx": 1,
          "pidx_tc": 125495,
          "spk": "四郎治 (シロージ)",
          "ja": "どうしてこんなに難しいもんなんだろうな",
          "tc": "這麼難啊？",
          "sc": "这么难啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125506,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱり俺にはどうにも才能がないみたいだ",
          "tc": "看來我真的是沒有這方面的天分。",
          "sc": "看来我真的是没有这方面的天分。"
        }
