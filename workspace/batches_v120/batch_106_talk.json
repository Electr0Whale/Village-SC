          "pidx_tc": 125345,
          "spk": "四郎治 (シロージ)",
          "ja": "こう地面が綺麗だと",
          "tc": "看地面這麼乾淨漂亮，",
          "sc": "看地面这么干净漂亮，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125352,
          "spk": "四郎治 (シロージ)",
          "ja": "自分の足跡をつけたくなっちまう",
          "tc": "反而會想留下自己的腳印。",
          "sc": "反而会想留下自己的脚印。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125359,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>もこの気持ちわかるか？",
          "tc": "<player>能明白這種心情嗎？",
          "sc": "<player>能明白这种心情吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 687,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125383,
          "spk": "四郎治 (シロージ)",
          "ja": "俺たちの家系は、大昔から猟師をやってるんだ",
          "tc": "我的家族從很久以前就是獵人，",
          "sc": "我的家族从很久以前就是猎人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125390,
          "spk": "四郎治 (シロージ)",
          "ja": "じいさんに聞いた話だと、先祖は北の方から",
          "tc": "聽爺爺說，祖先是從北方",
          "sc": "听爷爷说，祖先是从北方"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125397,
          "spk": "四郎治 (シロージ)",
          "ja": "この土地に流れてきたらしい",
          "tc": "輾轉來到這片土地上。",
          "sc": "辗转来到这片土地上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125408,
          "spk": "四郎治 (シロージ)",
          "ja": "先祖から受け継がれてきた狩りの知恵が、",
          "tc": "代代流傳下來的狩獵知識",
          "sc": "代代流传下来的狩猎知识"
        },
        {
          "f_idx": 4,
          "pidx_tc": 125415,
          "spk": "四郎治 (シロージ)",
          "ja": "今のやり方にも活かされてるんだぜ",
          "tc": "依然可以活用在現在的狩獵活動上。",
          "sc": "依然可以活用在现在的狩猎活动上。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 688,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4121",
      "lines": [
        {
