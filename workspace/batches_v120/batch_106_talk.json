        {
          "f_idx": 2,
          "pidx_tc": 125185,
          "spk": "四郎治 (シロージ)",
          "ja": "そんなつもりはなかったんだけどな",
          "tc": "但我沒有想要嚇牠的意思啊。",
          "sc": "但我没有想要吓它的意思啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 683,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125209,
          "spk": "四郎治 (シロージ)",
          "ja": "ふう……息を吸い込むとたまに",
          "tc": "呼……有時呼吸的時候，",
          "sc": "呼……有时呼吸的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125216,
          "spk": "四郎治 (シロージ)",
          "ja": "すげぇ冷たい空気が入ってくるから",
