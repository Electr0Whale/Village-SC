      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125296,
          "spk": "四郎治 (シロージ)",
          "ja": "さみぃ……",
          "tc": "好冷……",
          "sc": "好冷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125303,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかいもんでも飲みてぇけど",
