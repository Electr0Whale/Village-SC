        },
        {
          "f_idx": 4,
          "pidx_tc": 446933,
          "spk": "今野 (コンノ)",
          "ja": "感性を伸ばすのも",
          "tc": "藝術素養，",
          "sc": "艺术素养，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446940,
          "spk": "今野 (コンノ)",
          "ja": "大人の役目ですからァ？",
          "tc": "也是大人的職責嘛？",
          "sc": "也是大人的职责嘛？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446951,
          "spk": "今野 (コンノ)",
          "ja": "あァ、ワタシはなんて",
          "tc": "啊，我真是個",
          "sc": "啊，我真是个"
        },
        {
          "f_idx": 7,
          "pidx_tc": 446958,
          "spk": "今野 (コンノ)",
          "ja": "素晴らしい大人なんでしょう！",
          "tc": "了不起的大人啊！",
          "sc": "了不起的大人啊！"
        },
