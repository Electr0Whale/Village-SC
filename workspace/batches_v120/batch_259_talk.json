        },
        {
          "f_idx": 9,
          "pidx_tc": 446976,
          "spk": "今野 (コンノ)",
          "ja": "感謝してくださいネ",
          "tc": "我的氣度喔。",
          "sc": "我的气度哟～。"
        }
      ]
    },
    {
