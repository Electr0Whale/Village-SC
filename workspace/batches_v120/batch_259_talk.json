  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7327,
      "rec_id": "TALK_ID_70_2090_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444941,
          "spk": "今野 (コンノ)",
          "ja": "ンフフフフフフフ",
          "tc": "呵呵呵呵呵呵呵呵，",
          "sc": "呵呵呵呵呵呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444948,
          "spk": "今野 (コンノ)",
          "ja": "本気にしちゃいましたァ？",
          "tc": "您當真了嗎？",
          "sc": "您当真了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444955,
          "spk": "今野 (コンノ)",
          "ja": "冗談ですヨォ",
          "tc": "我是開玩笑的。",
          "sc": "我是开玩笑哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444966,
          "spk": "今野 (コンノ)",
          "ja": "せっかく狩ってきた獲物を",
          "tc": "獵物可是我自己打到的，",
          "sc": "猎物可是我自己打到的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444973,
          "spk": "今野 (コンノ)",
          "ja": "タダで分け与えるわけ",
          "tc": "我怎麼可能",
          "sc": "我怎么可能"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444980,
          "spk": "今野 (コンノ)",
          "ja": "ないじゃないですかァ",
          "tc": "平白無故地跟您分享呢？",
          "sc": "平白无故地跟您分享呢～？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444991,
          "spk": "今野 (コンノ)",
          "ja": "自分の食いぶちくらいは",
          "tc": "自己的伙食",
          "sc": "自己的伙食"
        },
        {
          "f_idx": 7,
          "pidx_tc": 444998,
          "spk": "今野 (コンノ)",
          "ja": "自分で稼いでもらいませんと",
          "tc": "可要自己努力爭取才行。",
          "sc": "可要自己努力争取才行。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 445007,
          "spk": "今野 (コンノ)",
          "ja": "子どもだからといって",
          "tc": "即便您只是個孩子，",
          "sc": "即便您只是个孩子，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 445014,
          "spk": "今野 (コンノ)",
          "ja": "甘えられては困りますヨ",
          "tc": "這樣子撒嬌要東西，我也是會很頭痛的。",
          "sc": "这样子撒娇要东西，我也是会很头痛哟～。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 445025,
          "spk": "今野 (コンノ)",
          "ja": "――ハッ！",
          "tc": "──啊！",
          "sc": "——啊！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 445034,
          "spk": "今野 (コンノ)",
          "ja": "こうしてはいられません",
          "tc": "我不能再繼續跟您說話了。",
          "sc": "我不能再继续跟您说话了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 445041,
          "spk": "今野 (コンノ)",
          "ja": "ウサギの鮮度が",
          "tc": "這樣野兔的鮮度",
          "sc": "这样野兔的鲜度"
        },
        {
          "f_idx": 13,
          "pidx_tc": 445048,
          "spk": "今野 (コンノ)",
          "ja": "落ちてしまいます",
          "tc": "會下降的。",
          "sc": "会下降的。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 445059,
          "spk": "今野 (コンノ)",
          "ja": "アナタのせいで",
          "tc": "都怪您，",
          "sc": "都怪您，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 445066,
          "spk": "今野 (コンノ)",
          "ja": "余計な時間を取られて",
          "tc": "害我浪費了",
          "sc": "害我浪费了"
        },
        {
          "f_idx": 16,
          "pidx_tc": 445073,
          "spk": "今野 (コンノ)",
          "ja": "しまったじゃないですかァ",
          "tc": "不必要的時間。",
          "sc": "不必要的时间呀～？。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 445084,
          "spk": "今野 (コンノ)",
          "ja": "急いでいるので",
          "tc": "我趕時間，",
          "sc": "我赶时间，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 445091,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはこれで",
          "tc": "我就先說到這邊，",
          "sc": "我就先说到这边，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 445098,
          "spk": "今野 (コンノ)",
          "ja": "失礼しますヨ",
          "tc": "告辭了。",
          "sc": "告辞哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7328,
      "rec_id": "TALK_ID_70_2090_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445124,
          "spk": "今野 (コンノ)",
          "ja": "オ……オォォォ……",
          "tc": "喔……喔喔喔喔……",
          "sc": "喔……喔喔喔喔……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445131,
          "spk": "今野 (コンノ)",
          "ja": "ホワァァァァ……",
          "tc": "哇啊啊啊啊……",
          "sc": "哇啊啊啊啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445144,
          "spk": "林 (リン)",
          "ja": "だから言ってるじゃない",
          "tc": "所以我才說了嘛，",
          "sc": "所以我才说了嘛，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 445151,
          "spk": "林 (リン)",
          "ja": "投資は地道にコツコツと",
          "tc": "投資一定要",
          "sc": "投资一定要"
        },
        {
          "f_idx": 4,
          "pidx_tc": 445158,
          "spk": "林 (リン)",
          "ja": "やるべきだって",
          "tc": "腳踏實地來才行。",
          "sc": "脚踏实地来才行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 445169,
          "spk": "今野 (コンノ)",
          "ja": "ウグゥ……",
          "tc": "唔唔……",
          "sc": "唔唔……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 445182,
          "spk": "林 (リン)",
          "ja": "ハイリスクな株に",
          "tc": "我不是已經跟您講過很多次了，",
          "sc": "我不是已经跟您讲过很多次了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 445189,
          "spk": "林 (リン)",
          "ja": "手を出すなと",
          "tc": "請您不要",
          "sc": "请您不要"
        },
        {
          "f_idx": 8,
          "pidx_tc": 445196,
          "spk": "林 (リン)",
          "ja": "何度も言ってるわよね？",
          "tc": "去碰高風險的股票了嗎？",
          "sc": "去碰高风险的股票了吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 445207,
          "spk": "今野 (コンノ)",
          "ja": "ヒギィ……",
          "tc": "嗚……",
          "sc": "呜……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 445220,
          "spk": "林 (リン)",
          "ja": "どうして言うことが",
          "tc": "您為什麼",
          "sc": "您为什么"
        },
        {
          "f_idx": 11,
          "pidx_tc": 445227,
          "spk": "林 (リン)",
          "ja": "聞けないのかしら",
          "tc": "就是不聽我的勸呢？",
          "sc": "就是不听我的劝呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7329,
      "rec_id": "TALK_ID_70_2090_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445245,
          "spk": "今野 (コンノ)",
          "ja": "……お言葉ですがネ",
          "tc": "……恕我直言，",
          "sc": "……恕我直言，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445252,
          "spk": "今野 (コンノ)",
          "ja": "そもそもアナタに投資を",
          "tc": "一開始教您做投資的",
          "sc": "一开始教您做投资的"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445259,
          "spk": "今野 (コンノ)",
          "ja": "教えたのはワタシですヨ",
          "tc": "可是我。",
          "sc": "可是我哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 445270,
          "spk": "今野 (コンノ)",
          "ja": "金策についてワタシは",
          "tc": "在投資理財上，",
          "sc": "在投资理财上，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 445277,
          "spk": "今野 (コンノ)",
          "ja": "リンさんの師匠とも",
          "tc": "我幾乎能堪稱是",
          "sc": "我几乎能堪称是"
        },
        {
          "f_idx": 5,
          "pidx_tc": 445284,
          "spk": "今野 (コンノ)",
          "ja": "呼べる存在では？",
          "tc": "林小姐您的師父吧？",
          "sc": "林小姐您的师父吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 445295,
          "spk": "今野 (コンノ)",
          "ja": "ですからワタシは、",
          "tc": "所以身為學生的您，",
          "sc": "所以身为学生的您，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 445302,
          "spk": "今野 (コンノ)",
          "ja": "教え子であるアナタに",
          "tc": "應該沒有資格",
          "sc": "应该没有资格"
        },
        {
          "f_idx": 8,
          "pidx_tc": 445309,
          "spk": "今野 (コンノ)",
          "ja": "お説教される筋合いは――",
          "tc": "對我說教──",
          "sc": "对我说教——"
        },
        {
          "f_idx": 9,
          "pidx_tc": 445322,
          "spk": "林 (リン)",
          "ja": "そういうことは、師と仰がれる",
          "tc": "只有一直保持著",
          "sc": "只有一直保持着"
        },
        {
          "f_idx": 10,
          "pidx_tc": 445329,
          "spk": "林 (リン)",
          "ja": "姿勢を保ち続けている人が",
          "tc": "為人師父尊嚴的人",
          "sc": "为人师父尊严的人"
        },
        {
          "f_idx": 11,
          "pidx_tc": 445336,
          "spk": "林 (リン)",
          "ja": "言うべきなんじゃない？",
          "tc": "才有資格講這種話吧？",
          "sc": "才有资格讲这种话吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7330,
      "rec_id": "TALK_ID_70_2090_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445354,
          "spk": "今野 (コンノ)",
          "ja": "アウア……",
          "tc": "噢……",
          "sc": "噢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445361,
          "spk": "今野 (コンノ)",
          "ja": "オロロロロロ……",
          "tc": "嗚嗚嗚嗚嗚嗚……",
          "sc": "呜呜呜呜呜呜……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7331,
      "rec_id": "TALK_ID_70_2090_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445387,
          "spk": "林 (リン)",
          "ja": "あら、<player>",
          "tc": "哎呀，<player>，",
          "sc": "哎呀，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445394,
          "spk": "林 (リン)",
          "ja": "いたのね",
          "tc": "你在啊？",
          "sc": "你在啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7332,
      "rec_id": "TALK_ID_70_2090_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445414,
          "spk": "今野 (コンノ)",
          "ja": "おやおや、これはこれは",
          "tc": "哎呀哎呀，",
          "sc": "哎呀哎呀，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445421,
          "spk": "今野 (コンノ)",
          "ja": "いいところに来ましたネ",
          "tc": "您來得可真是時候。",
          "sc": "您来得可真是时候。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7333,
      "rec_id": "TALK_ID_70_2090_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445447,
          "spk": "今野 (コンノ)",
          "ja": "今の話、聞いてましたァ？",
          "tc": "剛剛的對話您都聽到了嗎？",
          "sc": "刚刚的对话您都听到了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445454,
          "spk": "今野 (コンノ)",
          "ja": "ワタシ先ほど株で大損害を",
          "tc": "我剛剛在投資股票上",
          "sc": "我刚刚在投资股票上"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445461,
          "spk": "今野 (コンノ)",
          "ja": "出してしまいましてェ",
          "tc": "不小心賠慘了。",
          "sc": "不小心赔惨了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 445472,
          "spk": "今野 (コンノ)",
          "ja": "とっても可哀想だと",
          "tc": "不覺得",
          "sc": "不觉得"
        },
        {
          "f_idx": 4,
          "pidx_tc": 445479,
          "spk": "今野 (コンノ)",
          "ja": "思いませんか？",
          "tc": "我很可憐嗎？",
          "sc": "我很可怜吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 445486,
          "spk": "今野 (コンノ)",
          "ja": "同情しちゃいますよネ？",
          "tc": "是不是很同情我啊？",
          "sc": "是不是很同情我啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 445497,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんは",
          "tc": "<player>可是一個",
          "sc": "<player>可是一个"
        },
        {
          "f_idx": 7,
          "pidx_tc": 445504,
          "spk": "今野 (コンノ)",
          "ja": "心根が優しく、大人を敬う",
          "tc": "本性善良、",
          "sc": "本性善良、"
        },
        {
          "f_idx": 8,
          "pidx_tc": 445511,
          "spk": "今野 (コンノ)",
          "ja": "素晴らしい子どもですから",
          "tc": "尊重長輩的好孩子。",
          "sc": "尊重长辈的好孩子。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 445522,
          "spk": "今野 (コンノ)",
          "ja": "とってもとっても可哀想な",
          "tc": "所以看到我這麼可憐兮兮的，",
          "sc": "所以看到我这么可怜兮兮的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 445529,
          "spk": "今野 (コンノ)",
          "ja": "ワタシを、励ましたいという",
          "tc": "肯定是滿心想要",
          "sc": "肯定是满心想要"
        },
        {
          "f_idx": 11,
          "pidx_tc": 445536,
          "spk": "今野 (コンノ)",
          "ja": "気持ちでいっぱいでしょう？",
          "tc": "安慰我的吧？",
          "sc": "安慰我的吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 445547,
          "spk": "今野 (コンノ)",
          "ja": "さァ、遠慮はいりませんヨ",
          "tc": "來吧，您不必客氣，",
          "sc": "来吧，您不必客气，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 445554,
          "spk": "今野 (コンノ)",
          "ja": "可哀想なワタシにお恵みをォ",
          "tc": "就儘管打開錢包施捨可憐的我吧。",
          "sc": "就尽管打开钱包施舍可怜的我吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 445570,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 16,
          "pidx_tc": 445577,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7334,
      "rec_id": "TALK_ID_70_2090_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445739,
          "spk": "今野 (コンノ)",
          "ja": "あァ嫌だ……",
          "tc": "唉，真討厭……",
          "sc": "唉，真讨厌……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445746,
          "spk": "今野 (コンノ)",
          "ja": "世知辛い世の中ですヨ……",
          "tc": "這世道也太難混了……",
          "sc": "这世道也太难混了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445753,
          "spk": "今野 (コンノ)",
          "ja": "ハアァ……",
          "tc": "唉……",
          "sc": "唉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7335,
      "rec_id": "TALK_ID_70_2090_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445777,
          "spk": "林 (リン)",
          "ja": "ちょっといい？",
          "tc": "我可以插個嘴嗎？",
          "sc": "我可以插个嘴吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7336,
      "rec_id": "TALK_ID_70_2090_002_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445795,
          "spk": "林 (リン)",
          "ja": "あなた、コンノに",
          "tc": "你要拿錢給",
          "sc": "你要拿钱给"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445802,
          "spk": "林 (リン)",
          "ja": "金を渡すくらいなら",
          "tc": "今野的話，",
          "sc": "今野的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445809,
          "spk": "林 (リン)",
          "ja": "村に寄付しなさい",
          "tc": "還不如捐給村子比較好呢。",
          "sc": "还不如捐给村子比较好呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 445820,
          "spk": "林 (リン)",
          "ja": "わかったわね？",
          "tc": "知道了沒？",
          "sc": "知道了没？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7337,
      "rec_id": "TALK_ID_70_2090_002_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 445838,
          "spk": "林 (リン)",
          "ja": "……呆れた",
          "tc": "……真是令人傻眼，",
          "sc": "……真是令人傻眼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 445845,
          "spk": "林 (リン)",
          "ja": "あんな態度を取られたのに",
          "tc": "今野對你是這種態度，",
          "sc": "今野对你是这种态度，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 445852,
          "spk": "林 (リン)",
          "ja": "まだコンノの心配をしてるの？",
          "tc": "你居然還在擔心他嗎？",
          "sc": "你居然还在担心他吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 445863,
          "spk": "林 (リン)",
          "ja": "コンノなら大丈夫よ",
          "tc": "今野他不會有事的，",
          "sc": "今野他不会有事的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 445870,
          "spk": "林 (リン)",
          "ja": "ああなるのは",
          "tc": "他常常都是",
          "sc": "他常常都是"
        },
        {
          "f_idx": 5,
          "pidx_tc": 445877,
          "spk": "林 (リン)",
          "ja": "しょっちゅうだから",
          "tc": "這種狀態。",
          "sc": "这种状态。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 445888,
          "spk": "林 (リン)",
          "ja": "翌日にはけろっとしてるから",
          "tc": "他明天就又會若無其事的了，",
          "sc": "他明天就又会若无其事的了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 445895,
          "spk": "林 (リン)",
          "ja": "気にするだけ損というものよ",
          "tc": "所以擔心他都是白擔心的。",
          "sc": "所以担心他都是白担心的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 445913,
          "spk": "林 (リン)",
          "ja": "どうせ気にするなら",
          "tc": "如果要擔心別人，",
          "sc": "如果要担心别人，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 445920,
          "spk": "林 (リン)",
          "ja": "もう少しマシな相手に",
          "tc": "還不如換一個",
          "sc": "还不如换一个"
        },
        {
          "f_idx": 11,
          "pidx_tc": 445927,
          "spk": "林 (リン)",
          "ja": "することね",
          "tc": "好一點的對象呢。",
          "sc": "好一点的对象呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7338,
      "rec_id": "TALK_ID_70_2090_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446050,
          "spk": "今野 (コンノ)",
          "ja": "ハァ……何度見ても",
          "tc": "唉……不管看幾次，",
          "sc": "唉……不管看几次，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446057,
          "spk": "今野 (コンノ)",
          "ja": "素晴らしい絵画ですネ……",
          "tc": "都是幅美妙的畫作呢……",
          "sc": "都是幅美妙的画作呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446075,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、この素晴らしさが",
          "tc": "您能明白這幅畫的",
          "sc": "您能明白这幅画的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446082,
          "spk": "今野 (コンノ)",
          "ja": "わかりますかァ？",
          "tc": "美妙之處嗎？",
          "sc": "美妙之处吗～？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446093,
          "spk": "今野 (コンノ)",
          "ja": "これは、世界的に有名な",
          "tc": "這出自於世界知名的",
          "sc": "这出自于世界知名的"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446100,
          "spk": "今野 (コンノ)",
          "ja": "ストリートアーティストによる",
          "tc": "街頭藝術家之手，",
          "sc": "街头艺术家之手，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 446107,
          "spk": "今野 (コンノ)",
          "ja": "一点モノの絵画なんですヨ",
          "tc": "是絕無僅有的作品喔。",
          "sc": "是绝无仅有的作品哟～。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 446118,
          "spk": "今野 (コンノ)",
          "ja": "彼は、英国王室ご用達の",
          "tc": "他大量使用了英國皇室御用的",
          "sc": "他大量使用了英国皇室御用的"
        },
        {
          "f_idx": 9,
          "pidx_tc": 446125,
          "spk": "今野 (コンノ)",
          "ja": "万年筆とインクをたっぷり",
          "tc": "鋼筆和墨水，",
          "sc": "钢笔和墨水，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 446132,
          "spk": "今野 (コンノ)",
          "ja": "使ってこの絵を描き上げ――",
          "tc": "完成了這幅作品──",
          "sc": "完成了这幅作品——"
        },
        {
          "f_idx": 11,
          "pidx_tc": 446141,
          "spk": "今野 (コンノ)",
          "ja": "更に、貴婦人が纏うパリの名香を",
          "tc": "並且在畫布的各個角落",
          "sc": "并且在画布的各个角落"
        },
        {
          "f_idx": 12,
          "pidx_tc": 446148,
          "spk": "今野 (コンノ)",
          "ja": "キャンバスの隅々まで",
          "tc": "都噴上了大量的、",
          "sc": "都喷上了大量的、"
        },
        {
          "f_idx": 13,
          "pidx_tc": 446155,
          "spk": "今野 (コンノ)",
          "ja": "たっぷりと吹きかけたんです",
          "tc": "貴婦都會使用的巴黎名牌香水。",
          "sc": "贵妇都会使用的巴黎名牌香水。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 446166,
          "spk": "今野 (コンノ)",
          "ja": "すべてが一級品の構成……",
          "tc": "構成這幅畫的所有元素都是最高級的……",
          "sc": "构成这幅画的所有元素都是最高级的……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 446173,
          "spk": "今野 (コンノ)",
          "ja": "アートはこうでなくては",
          "tc": "所謂藝術，",
          "sc": "所谓艺术，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 446180,
          "spk": "今野 (コンノ)",
          "ja": "いけませんヨ",
          "tc": "就是得這樣才行啊。",
          "sc": "就是得这样才行啊。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 446191,
          "spk": "今野 (コンノ)",
          "ja": "ここに立って静かに",
          "tc": "能夠站在這裡",
          "sc": "能够站在这里"
        },
        {
          "f_idx": 18,
          "pidx_tc": 446198,
          "spk": "今野 (コンノ)",
          "ja": "絵画を楽しむ時間の",
          "tc": "靜靜地欣賞畫作，",
          "sc": "静静地欣赏画作，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 446205,
          "spk": "今野 (コンノ)",
          "ja": "贅沢さといったら……",
          "tc": "這段時光實在是太奢侈了……",
          "sc": "这段时光实在是太奢侈了……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 446216,
          "spk": "今野 (コンノ)",
          "ja": "チナナさんに大枚はたいて",
          "tc": "真是不枉費我砸重本",
          "sc": "真是不枉费我砸重本"
        },
        {
          "f_idx": 21,
          "pidx_tc": 446223,
          "spk": "今野 (コンノ)",
          "ja": "手に入れた甲斐がありますヨ",
          "tc": "向琪娜娜小姐買下來。",
          "sc": "向琪娜娜小姐买下来哟～。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 446234,
          "spk": "今野 (コンノ)",
          "ja": "本当は一人で楽しもうと",
          "tc": "其實我本來是想要",
          "sc": "其实我本来是想要"
        },
        {
          "f_idx": 23,
          "pidx_tc": 446241,
          "spk": "今野 (コンノ)",
          "ja": "思っていたんですが",
          "tc": "自己一個人獨享的。",
          "sc": "自己一个人独享的。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 446252,
          "spk": "今野 (コンノ)",
          "ja": "あんまりにも素晴らしい絵画なので、",
          "tc": "然而這幅畫實在是過於美妙，",
          "sc": "然而这幅画实在是过于美妙，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 446259,
          "spk": "今野 (コンノ)",
          "ja": "ちょっとだけ誰かに見せてあげても",
          "tc": "所以我才覺得應該可以稍微",
          "sc": "所以我才觉得应该可以稍微"
        },
        {
          "f_idx": 26,
          "pidx_tc": 446266,
          "spk": "今野 (コンノ)",
          "ja": "いいと思いましてネ",
          "tc": "給別人瞄個幾眼。",
          "sc": "给别人瞄个几眼。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 446277,
          "spk": "今野 (コンノ)",
          "ja": "ヒマそうなアナタを見かけたので",
          "tc": "然後我正好就發現了看起來似乎很閒的您，",
          "sc": "然后我正好就发现了看起来似乎很闲的您，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 446284,
          "spk": "今野 (コンノ)",
          "ja": "こうして披露しているというわけです",
          "tc": "於是才會帶您來見識一下這幅作品。",
          "sc": "于是才会带您来见识一下这幅作品。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 446302,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはこんな気まぐれ",
          "tc": "我可不常會有這種",
          "sc": "我可不常会有这种"
        },
        {
          "f_idx": 31,
          "pidx_tc": 446309,
          "spk": "今野 (コンノ)",
          "ja": "滅多に起こしませんからネ",
          "tc": "想要大發慈悲的心情，",
          "sc": "想要大发慈悲的心情，"
        },
        {
          "f_idx": 32,
          "pidx_tc": 446316,
          "spk": "今野 (コンノ)",
          "ja": "アナタは実に運がいいですヨ",
          "tc": "所以您運氣真的很好呢。",
          "sc": "所以您运气真的很好哟～。"
        },
        {
          "f_idx": 33,
          "pidx_tc": 446327,
          "spk": "今野 (コンノ)",
          "ja": "見せてもらえたことに",
          "tc": "您可記得要對我感恩戴德，",
          "sc": "您可记得要对我感恩戴德，"
        },
        {
          "f_idx": 34,
          "pidx_tc": 446334,
          "spk": "今野 (コンノ)",
          "ja": "深く感謝することですネ",
          "tc": "感謝我讓您欣賞這幅畫喔。",
          "sc": "感谢我让您欣赏这幅画哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7339,
      "rec_id": "TALK_ID_70_2090_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446359,
          "spk": "今野 (コンノ)",
          "ja": "ンフフフ",
          "tc": "呵呵呵呵，",
          "sc": "呵呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446366,
          "spk": "今野 (コンノ)",
          "ja": "素直で結構",
          "tc": "真是個聽話的好孩子。",
          "sc": "真是个听话的好孩子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446377,
          "spk": "今野 (コンノ)",
          "ja": "アァ、気分がいいですねェ",
          "tc": "啊，心情真好。",
          "sc": "啊，心情真好呐～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446384,
          "spk": "今野 (コンノ)",
          "ja": "そうだ、他のコレクションも",
          "tc": "對了，我就破例讓您欣賞",
          "sc": "对了，我就破例让您欣赏"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446391,
          "spk": "今野 (コンノ)",
          "ja": "特別に見せてあげますヨ",
          "tc": "我的其他收藏吧。",
          "sc": "我的其他收藏哟～。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446402,
          "spk": "今野 (コンノ)",
          "ja": "まずは……そうですネ",
          "tc": "首先……我想想。",
          "sc": "首先……我想想。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7340,
      "rec_id": "TALK_ID_70_2090_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446426,
          "spk": "今野 (コンノ)",
          "ja": "やはり、この椅子から",
          "tc": "就從這張椅子",
          "sc": "就从这张椅子"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446433,
          "spk": "今野 (コンノ)",
          "ja": "いきましょうか",
          "tc": "開始吧。",
          "sc": "开始吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446444,
          "spk": "今野 (コンノ)",
          "ja": "あ、くれぐれも触らないように",
          "tc": "啊，您可千萬不要碰到了喔，",
          "sc": "啊，您可千万不要碰到了哟～，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446451,
          "spk": "今野 (コンノ)",
          "ja": "お願いしますヨ",
          "tc": "拜託您了。",
          "sc": "拜托您哟～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446462,
          "spk": "今野 (コンノ)",
          "ja": "ワタシでさえ、座る時は",
          "tc": "就連我自己也是，",
          "sc": "就连我自己也是，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446469,
          "spk": "今野 (コンノ)",
          "ja": "手袋をするように",
          "tc": "我在坐這張椅子的時候",
          "sc": "我在坐这张椅子的时候"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446476,
          "spk": "今野 (コンノ)",
          "ja": "しているんですからネ",
          "tc": "還都會戴著手套呢。",
          "sc": "还都会戴着手套呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 446487,
          "spk": "今野 (コンノ)",
          "ja": "実はこの椅子、元々は",
          "tc": "其實這張椅子",
          "sc": "其实这张椅子"
        },
        {
          "f_idx": 8,
          "pidx_tc": 446494,
          "spk": "今野 (コンノ)",
          "ja": "ヨーロッパの宮殿にあった",
          "tc": "是來自",
          "sc": "是来自"
        },
        {
          "f_idx": 9,
          "pidx_tc": 446501,
          "spk": "今野 (コンノ)",
          "ja": "ものでしてネ",
          "tc": "歐洲的某座宮殿的。",
          "sc": "欧洲的某座宫殿的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7341,
      "rec_id": "TALK_ID_70_2090_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446519,
          "spk": "今野 (コンノ)",
          "ja": "宮殿の持ち主が国王を招いた際に",
          "tc": "據說這是宮殿主人當初在招待國王的時候，",
          "sc": "据说这是宫殿主人当初在招待国王的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446526,
          "spk": "今野 (コンノ)",
          "ja": "特別に拵えたという逸品でして",
          "tc": "特別準備的寶貝。",
          "sc": "特别准备的宝贝。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446544,
          "spk": "今野 (コンノ)",
          "ja": "座面のベルベットは当時の職人が",
          "tc": "椅面的天鵝絨是當時的工匠",
          "sc": "椅面的天鹅绒是当时的工匠"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446551,
          "spk": "今野 (コンノ)",
          "ja": "一本一本手織りをしていて、",
          "tc": "以手工一條一條織成的，",
          "sc": "以手工一条一条织成的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446558,
          "spk": "今野 (コンノ)",
          "ja": "金の装飾はすべて二十四金の――",
          "tc": "而這些金色的裝飾全都是以24K金──",
          "sc": "而这些金色的装饰全都是以24K金——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7342,
      "rec_id": "TALK_ID_70_2090_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446582,
          "spk": "今野 (コンノ)",
          "ja": "世界三大映画祭すべてで",
          "tc": "您知道有一部電影",
          "sc": "您知道有一部电影"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446589,
          "spk": "今野 (コンノ)",
          "ja": "輝かしい賞を獲った映画、",
          "tc": "在世界三大電影節",
          "sc": "在世界三大电影节"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446596,
          "spk": "今野 (コンノ)",
          "ja": "ご存じですかァ？",
          "tc": "都奪得了榮譽大獎嗎？",
          "sc": "都夺得了荣誉大奖吗～？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446607,
          "spk": "今野 (コンノ)",
          "ja": "このコートはネ、あの映画の",
          "tc": "這件大衣啊，",
          "sc": "这件大衣啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446614,
          "spk": "今野 (コンノ)",
          "ja": "主演女優がレッドカーペットで",
          "tc": "和那部電影的女主角演員",
          "sc": "和那部电影的女主角演员"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446621,
          "spk": "今野 (コンノ)",
          "ja": "羽織っていたものと同じなんです",
          "tc": "走紅毯時穿的是同款。",
          "sc": "走红毯时穿的是同款。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7343,
      "rec_id": "TALK_ID_70_2090_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446639,
          "spk": "今野 (コンノ)",
          "ja": "しかも、同じ工房の同じロットで",
          "tc": "而且還是同一間製造廠商的",
          "sc": "而且还是同一间制造厂商的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446646,
          "spk": "今野 (コンノ)",
          "ja": "作られたものですから、これは",
          "tc": "同一批貨，這就代表",
          "sc": "同一批货，这就代表"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446653,
          "spk": "今野 (コンノ)",
          "ja": "あの伝説の瞬間と通じ合って――",
          "tc": "這件大衣通往了那傳奇的瞬間──",
          "sc": "这件大衣通往了那传奇的瞬间——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7344,
      "rec_id": "TALK_ID_70_2090_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446677,
          "spk": "今野 (コンノ)",
          "ja": "なんとこれは、百年前に",
          "tc": "這是從一百年前",
          "sc": "这是从一百年前"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446684,
          "spk": "今野 (コンノ)",
          "ja": "嵐に遭って沈没した船から",
          "tc": "因暴風雨而沉沒的船上",
          "sc": "因暴风雨而沉没的船上"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446691,
          "spk": "今野 (コンノ)",
          "ja": "発掘されたワインです",
          "tc": "所挖掘出來的葡萄酒，沒想到吧？",
          "sc": "所挖掘出来的葡萄酒，没想到吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7345,
      "rec_id": "TALK_ID_70_2090_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446709,
          "spk": "今野 (コンノ)",
          "ja": "もちろん、瓶もラベルも",
          "tc": "當然了，酒瓶和酒標",
          "sc": "当然了，酒瓶和酒标"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446716,
          "spk": "今野 (コンノ)",
          "ja": "当時のままで、百年もの間",
          "tc": "都維持著當年的樣貌，",
          "sc": "都维持着当年的样貌，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446723,
          "spk": "今野 (コンノ)",
          "ja": "海底で熟成されたレアさときたら――",
          "tc": "這可是百年間在海底熟成的珍寶──",
          "sc": "这可是百年间在海底熟成的珍宝——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7346,
      "rec_id": "TALK_ID_70_2090_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446747,
          "spk": "今野 (コンノ)",
          "ja": "――ふぅ",
          "tc": "──呼。",
          "sc": "——呼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446758,
          "spk": "今野 (コンノ)",
          "ja": "今日のところは",
          "tc": "今天",
          "sc": "今天"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446765,
          "spk": "今野 (コンノ)",
          "ja": "これくらいに",
          "tc": "就先介紹到",
          "sc": "就先介绍到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446772,
          "spk": "今野 (コンノ)",
          "ja": "しておきましょうかァ",
          "tc": "這邊吧。",
          "sc": "这边呀～？。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446783,
          "spk": "今野 (コンノ)",
          "ja": "しかし、<player>さんは",
          "tc": "不過，<player>，",
          "sc": "不过，<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446790,
          "spk": "今野 (コンノ)",
          "ja": "どれもきちんと興味を持って",
          "tc": "每條介紹您都聽得很入神呢，",
          "sc": "每条介绍您都听得很入神呢，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446797,
          "spk": "今野 (コンノ)",
          "ja": "聞けてえらいですねェ",
          "tc": "真是個好孩子。",
          "sc": "真是个好孩子呐～。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 446808,
          "spk": "今野 (コンノ)",
          "ja": "まさか、ものの値打ちが",
          "tc": "也真沒想到",
          "sc": "也真没想到"
        },
        {
          "f_idx": 8,
          "pidx_tc": 446815,
          "spk": "今野 (コンノ)",
          "ja": "わかる子どもだったとは",
          "tc": "您是個識貨的孩子，",
          "sc": "您是个识货的孩子，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 446822,
          "spk": "今野 (コンノ)",
          "ja": "見直しましたヨ",
          "tc": "我可是對您改觀了。",
          "sc": "我可是对您改观了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 446833,
          "spk": "今野 (コンノ)",
          "ja": "どうやらワタシたちは",
          "tc": "看來我們的價值觀",
          "sc": "看来我们的价值观"
        },
        {
          "f_idx": 11,
          "pidx_tc": 446840,
          "spk": "今野 (コンノ)",
          "ja": "価値観が合う、と言えない",
          "tc": "似乎可以說是",
          "sc": "似乎可以说是"
        },
        {
          "f_idx": 12,
          "pidx_tc": 446847,
          "spk": "今野 (コンノ)",
          "ja": "こともないのかもしれませんネ",
          "tc": "很合拍了。",
          "sc": "很合拍了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 446858,
          "spk": "今野 (コンノ)",
          "ja": "――よろしい",
          "tc": "──那麼好吧。",
          "sc": "——那么好吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 446869,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんは特別に",
          "tc": "我就為<player>破例，",
          "sc": "我就为<player>破例，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 446876,
          "spk": "今野 (コンノ)",
          "ja": "今後ワタシの部屋へ",
          "tc": "允許您以後可以",
          "sc": "允许您以后可以"
        },
        {
          "f_idx": 16,
          "pidx_tc": 446883,
          "spk": "今野 (コンノ)",
          "ja": "自由に入っていいこととします",
          "tc": "自由進出我的房間。",
          "sc": "自由进出我的房间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7347,
      "rec_id": "TALK_ID_70_2090_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446901,
          "spk": "今野 (コンノ)",
          "ja": "本当は入室料を",
          "tc": "照理說，",
          "sc": "照理说，"
