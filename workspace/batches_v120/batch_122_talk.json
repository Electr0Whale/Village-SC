      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76043,
          "spk": "六角 (ロッカク)",
          "ja": "そろそろ、ユータさんやスミレさんが",
          "tc": "這個季節，裕太和堇怜弟弟他們",
