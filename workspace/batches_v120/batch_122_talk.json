          "f_idx": 2,
          "pidx_tc": 76012,
          "spk": "六角 (ロッカク)",
          "ja": "こいつは中々……",
          "tc": "還滿不錯的……",
          "sc": "还满不错的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76019,
          "spk": "六角 (ロッカク)",
          "ja": "新メニューにいいかもしれねえ",
          "tc": "或許可以拿來當作新菜色。",
          "sc": "或许可以拿来当作新菜色。"
        }
      ]
    },
    {
