      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 75882,
          "spk": "六角 (ロッカク)",
          "ja": "スイートポテト特集ねえ……",
          "tc": "地瓜甜點的特輯啊……",
          "sc": "红薯甜点的特辑啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 75900,
          "spk": "六角 (ロッカク)",
          "ja": "ワシは大学イモのほうが好きっスけど",
          "tc": "我是比較喜歡拔絲地瓜啦，",
          "sc": "我是比较喜欢拔丝红薯啦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 75907,
          "spk": "六角 (ロッカク)",
          "ja": "若い人はこっちのほうが嬉しいんスかね？",
          "tc": "但年輕人會比較喜歡這種的嗎？",
          "sc": "但年轻人会比较喜欢这种的吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1550,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 75938,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの村が旅雑誌にでも載って、",
          "tc": "如果我們村子登上了旅遊雜誌，",
          "sc": "如果我们村子登上了旅游杂志，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 75945,
          "spk": "六角 (ロッカク)",
          "ja": "観光客が増えたら嬉しいんスけど",
          "tc": "觀光客也增加了的話，我是會很高興啦。",
          "sc": "观光客也增加了的话，我是会很高兴啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 75963,
          "spk": "六角 (ロッカク)",
          "ja": "ついでに食堂の客足も増えりゃあ",
          "tc": "但如果能順便帶動餐廳的人潮，",
          "sc": "但如果能顺便带动餐厅的人潮，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 75970,
          "spk": "六角 (ロッカク)",
          "ja": "万々歳っス",
          "tc": "那就皆大歡喜了。",
          "sc": "那就皆大欢喜呐。"
        }
      ]
    },
    {
