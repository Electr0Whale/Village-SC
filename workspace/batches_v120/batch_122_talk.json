      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 75819,
          "spk": "六角 (ロッカク)",
          "ja": "おや、世間様では昨日はこんな出来事が……",
          "tc": "哦？昨天發生了這種事啊……",
          "sc": "哦？昨天发生了这种事啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 75826,
          "spk": "六角 (ロッカク)",
          "ja": "……と思ったら、これ一週間前の記事っスね",
          "tc": "……仔細一看已經是一個星期前的報導了。",
          "sc": "……仔细一看已经是一个星期前的报导呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 75844,
          "spk": "六角 (ロッカク)",
          "ja": "この村じゃ、モノが届くのが遅いんスよね……",
          "tc": "外面的東西要送來這村子裡都要很久啊……",
          "sc": "外面的东西要送来这村子里都要很久啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 75851,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、しょうがないんスけども",
          "tc": "這也是沒辦法的事。",
          "sc": "这也是没办法的事。"
        }
      ]
    },
    {
      "file": "talk.dat",
