      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76123,
          "spk": "六角 (ロッカク)",
          "ja": "もう月見の季節っスか",
          "tc": "已經到了賞月的季節了嗎？",
          "sc": "已经到了赏月的季节了不？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76141,
          "spk": "六角 (ロッカク)",
          "ja": "そろそろ店ん中に",
          "tc": "那店裡差不多",
          "sc": "那店里差不多"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76148,
          "spk": "六角 (ロッカク)",
          "ja": "ススキでも飾っておきますかね",
          "tc": "可以用芒草來裝飾一下了。",
          "sc": "可以用芒草来装饰一下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
