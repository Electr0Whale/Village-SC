        {
          "f_idx": 2,
          "pidx_tc": 76057,
          "spk": "六角 (ロッカク)",
          "ja": "料理してくれって言いだす季節っス",
          "tc": "在山裡採到的地瓜或菇類了。",
          "sc": "在山里采到的红薯或菇类呐。"
        }
      ]
    },
    {
