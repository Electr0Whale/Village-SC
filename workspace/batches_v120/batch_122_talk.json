      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76172,
          "spk": "六角 (ロッカク)",
          "ja": "そろそろ、冬着も出しとかねえと",
          "tc": "差不多該拿出冬衣了。",
          "sc": "差不多该拿出冬衣了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76179,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんの毛糸の手袋、どこに仕舞ったっけか",
          "tc": "洋妹妹的毛線手套我收去哪裡了？",
          "sc": "洋妹妹的毛线手套我收去哪里了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1556,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76210,
          "spk": "六角 (ロッカク)",
          "ja": "だんだんと肌寒くなってきて、",
          "tc": "天氣開始漸漸變冷了，",
          "sc": "天气开始渐渐变冷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76217,
          "spk": "六角 (ロッカク)",
          "ja": "温かい飯が恋しい季節なんスよね",
          "tc": "到了這個季節就想吃熱騰騰的飯呢。",
          "sc": "到了这个季节就想吃热腾腾的饭呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76235,
          "spk": "六角 (ロッカク)",
          "ja": "……そろそろ店でも出してみるか",
          "tc": "……差不多可以在店裡賣了。",
          "sc": "……差不多可以在店里卖了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1557,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76266,
          "spk": "六角 (ロッカク)",
          "ja": "ロッカクよ、今日も一日善き人であれ",
          "tc": "六角啊，你今天也要當個好人喔。",
          "sc": "六角啊，今天也要当个好人呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76284,
          "spk": "六角 (ロッカク)",
          "ja": "じゃないと、",
          "tc": "不然，",
          "sc": "不然，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76291,
          "spk": "六角 (ロッカク)",
          "ja": "あの人たちに顔向けできないっスからね……",
          "tc": "你會對不起那些人的……",
          "sc": "你会对不起那些人的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1558,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76315,
          "spk": "六角 (ロッカク)",
          "ja": "こうしてみると、秋の空ってのは",
          "tc": "這樣一看，會發現秋天的天空",
          "sc": "这样一看，会发现秋天的天空"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76322,
          "spk": "六角 (ロッカク)",
          "ja": "本当に高いんスよねえ……不思議っス",
          "tc": "真的很高很遠……真是神奇啊。",
          "sc": "真的很高很远……真是神奇呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1559,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76353,
          "spk": "六角 (ロッカク)",
          "ja": "こうして朝からのんびりする時間ってのは、",
          "tc": "能像這樣從一早就度過這麼愜意的時光，",
          "sc": "能像这样从一早就度过这么惬意的时光，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76360,
          "spk": "六角 (ロッカク)",
          "ja": "最高の贅沢の一つだと思うんスよ",
          "tc": "我覺得這就是最奢侈的享受之一。",
          "sc": "我觉得这就是最奢侈的享受之一。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76371,
          "spk": "六角 (ロッカク)",
          "ja": "ふぁーあ、朝から眠くなってきちまった……",
          "tc": "呼啊，明明還一大早的卻開始想睡了……",
          "sc": "呼啊，明明还一大早的却开始想睡了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1560,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76402,
          "spk": "六角 (ロッカク)",
          "ja": "最近、ここで妙に人に会うんスよね",
          "tc": "最近莫名常常在這裡遇到其他人。",
          "sc": "最近莫名常常在这里遇到其他人。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76420,
          "spk": "六角 (ロッカク)",
          "ja": "もしかして、この小さい村の中で",
          "tc": "難道這個小小的村子",
          "sc": "难道这个小小的村子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76427,
          "spk": "六角 (ロッカク)",
          "ja": "釣りが流行ってたりするんスかね……？",
          "tc": "正在流行釣魚嗎……？",
          "sc": "正在流行钓鱼吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1561,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76451,
          "spk": "六角 (ロッカク)",
          "ja": "最近、目が悪くなったのか",
          "tc": "最近不知道是不是視力變差了，",
          "sc": "最近不知道是不是视力变差了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76458,
          "spk": "六角 (ロッカク)",
          "ja": "ウキがよく見えないんスよ……年かな",
          "tc": "開始有點看不清楚浮標……可能是年紀到了吧。",
          "sc": "开始有点看不清楚浮标……可能是年纪到了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1562,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76489,
          "spk": "六角 (ロッカク)",
          "ja": "今日はずいぶんとに食いつきがいいな",
          "tc": "今天釣得還不錯，",
          "sc": "今天钓得还不错，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76496,
          "spk": "六角 (ロッカク)",
          "ja": "気がつけば、籠の中がもう一杯だ",
          "tc": "一回過神來就發現竹簍已經滿了。",
          "sc": "一回过神来就发现竹篓已经满了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76507,
          "spk": "六角 (ロッカク)",
          "ja": "魚たちも冬に備えてるのかもしれないっスね",
          "tc": "這些魚可能也在準備過冬吧。",
          "sc": "这些鱼可能也在准备过冬呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1563,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76538,
          "spk": "六角 (ロッカク)",
          "ja": "雨後の筍じゃあないんスけど、",
          "tc": "雖然不是所謂的雨後春筍，",
          "sc": "虽然不是所谓的雨后春笋，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76545,
          "spk": "六角 (ロッカク)",
          "ja": "雨の時って妙に山菜が見つかる気がするんスよ",
          "tc": "不過在下雨天好像都能莫名地發現一些山菜呢。",
          "sc": "不过在下雨天好像都能莫名地发现一些山菜呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76563,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、気のせいかもしれないっス",
          "tc": "也有可能是我的錯覺吧。",
          "sc": "也有可能是我的错觉呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1564,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76587,
          "spk": "六角 (ロッカク)",
          "ja": "……毒キノコには十分、注意しねえと",
          "tc": "……要小心毒菇才行啊。",
          "sc": "……要小心毒菇才行啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76605,
          "spk": "六角 (ロッカク)",
          "ja": "前に間違って食っちまった時、",
          "tc": "我以前曾經誤食過，",
          "sc": "我以前曾经误食过，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76612,
          "spk": "六角 (ロッカク)",
          "ja": "ハスミさんに迷惑かけちまったっスから……",
          "tc": "造成了蓮實的困擾……",
          "sc": "造成了莲实的困扰……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1565,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76643,
          "spk": "六角 (ロッカク)",
          "ja": "おっと、こいつは渋柿か",
          "tc": "哦，這是澀柿子呢。",
          "sc": "哦，这是涩柿子呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 76661,
          "spk": "六角 (ロッカク)",
          "ja": "干し柿にするくらいしか",
          "tc": "雖然除了做成柿餅",
          "sc": "虽然除了做成柿饼"
        },
        {
          "f_idx": 3,
          "pidx_tc": 76668,
          "spk": "六角 (ロッカク)",
          "ja": "使い道はないんスけど……",
          "tc": "也沒有其他用途了……",
          "sc": "也没有其他用途了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 76679,
          "spk": "六角 (ロッカク)",
          "ja": "渋抜きするの、けっこう手間なんスよね……",
          "tc": "但是要脫澀是非常麻煩的啊……",
          "sc": "但是要脱涩是非常麻烦的啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1566,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 76703,
          "spk": "六角 (ロッカク)",
          "ja": "秋は実りの季節というだけあって、",
          "tc": "秋天不愧是豐收的季節啊，",
          "sc": "秋天不愧是丰收的季节啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 76710,
          "spk": "六角 (ロッカク)",
