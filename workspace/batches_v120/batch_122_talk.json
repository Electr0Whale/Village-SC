        {
          "f_idx": 1,
          "pidx_tc": 76050,
          "spk": "六角 (ロッカク)",
          "ja": "山で採ってきた芋やらキノコやらを",
          "tc": "差不多要開始叫我幫他們煮",
          "sc": "差不多要开始叫我帮他们煮"
