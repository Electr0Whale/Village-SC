        },
        {
          "f_idx": 1,
          "pidx_tc": 359714,
          "spk": "今野 (コンノ)",
          "ja": "そんなにお手伝いがしたいんですかァ？",
          "tc": "您就這麼想幫我的忙嗎？",
          "sc": "您就这么想帮我的忙吗～？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359721,
          "spk": "今野 (コンノ)",
          "ja": "え～～困りましたねェ～～",
