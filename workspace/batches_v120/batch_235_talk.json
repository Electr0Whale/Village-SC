          "f_idx": 5,
          "pidx_tc": 359151,
          "spk": "六角 (ロッカク)",
          "ja": "痛いほどわかるんですがね",
          "tc": "真的非常努力。",
          "sc": "真的非常努力。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 359162,
          "spk": "六角 (ロッカク)",
          "ja": "だからこそ、近づき難いと言いますか……",
          "tc": "所以可能正因為如此，才覺得她很難親近吧……",
          "sc": "所以可能正因为如此，才觉得她很难亲近吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6325,
      "rec_id": "TALK_ID_70_0080_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359187,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、いや",
          "tc": "啊，沒什麼，",
