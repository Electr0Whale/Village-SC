    },
    {
      "file": "talk.dat",
      "rec_idx": 6332,
      "rec_id": "TALK_ID_70_0080_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359517,
          "spk": "六角 (ロッカク)",
          "ja": "――山の中で、",
          "tc": "──你在山裡",
          "sc": "——你在山里"
