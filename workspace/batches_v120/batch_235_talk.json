          "sc": "有没有被奇怪的声音呼唤过？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6333,
      "rec_id": "TALK_ID_70_0080_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359542,
          "spk": "六角 (ロッカク)",
          "ja": "ないなら、いいんス",
          "tc": "沒有就好，",
