    },
    {
      "file": "talk.dat",
      "rec_idx": 6329,
      "rec_id": "TALK_ID_70_0080_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359346,
          "spk": "六角 (ロッカク)",
          "ja": "なら、料理のひとつくらいは、",
          "tc": "既然如此，",
