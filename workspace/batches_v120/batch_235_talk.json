          "f_idx": 1,
          "pidx_tc": 359083,
          "spk": "六角 (ロッカク)",
          "ja": "リンさん、怒ってなかったっスか？",
          "tc": "林沒生氣嗎？",
          "sc": "林没生气不？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359090,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんが無事に戻ってきてよかったっス",
          "tc": "還好<player>你有平安回來。",
          "sc": "还好<player>你有平安回来呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6324,
      "rec_id": "TALK_ID_70_0080_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359108,
          "spk": "六角 (ロッカク)",
          "ja": "……ってのは冗談で",
          "tc": "……我開玩笑的，",
          "sc": "……我开玩笑的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 359115,
          "spk": "六角 (ロッカク)",
          "ja": "手間をおかけして、申し訳ないっス",
          "tc": "真是不好意思麻煩你了。",
          "sc": "真是不好意思麻烦你呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359126,
          "spk": "六角 (ロッカク)",
          "ja": "実はワシ、リンさんのことが",
          "tc": "其實我真的不太會",
