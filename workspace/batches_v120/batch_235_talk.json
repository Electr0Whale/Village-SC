    {
      "file": "talk.dat",
      "rec_idx": 6347,
      "rec_id": "TALK_ID_70_0090_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360264,
          "spk": "今野 (コンノ)",
          "ja": "何やら金の匂いがすると思ったら",
          "tc": "我才想說怎麼好像有錢的味道，",
          "sc": "我才想说怎么好像有钱的味道，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 360271,
          "spk": "今野 (コンノ)",
          "ja": "アナタでしたかァ",
          "tc": "原來是您啊。",
          "sc": "原来是您呀～？。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6348,
      "rec_id": "TALK_ID_70_0090_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360289,
          "spk": "今野 (コンノ)",
          "ja": "いやァ、実は先ほど",
          "tc": "唉，",
          "sc": "唉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 360296,
          "spk": "今野 (コンノ)",
          "ja": "株で大損をしてしまいましてネ",
          "tc": "其實我剛剛股票賠慘了。",
          "sc": "其实我刚刚股票赔惨了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 360307,
          "spk": "今野 (コンノ)",
          "ja": "ショックで立ち直れないところでしたが",
          "tc": "我的心靈大受打擊，已經一蹶不振了。",
          "sc": "我的心灵大受打击，已经一蹶不振了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 360314,
          "spk": "今野 (コンノ)",
          "ja": "多少なりとも恵みをもらえれば",
          "tc": "但若如果能獲得一些施捨，",
          "sc": "但若如果能获得一些施舍，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 360321,
          "spk": "今野 (コンノ)",
          "ja": "傷ついた心も癒されるというものです",
          "tc": "我受傷的心便能得到治癒。",
          "sc": "我受伤的心便能得到治愈。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6349,
      "rec_id": "TALK_ID_70_0090_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360337,
          "spk": "今野 (コンノ)",
          "ja": "そもそも、子どもが金を持っていたって",
          "tc": "說起來，小孩子拿著錢",
          "sc": "说起来，小孩子拿着钱"
        },
        {
          "f_idx": 1,
          "pidx_tc": 360344,
          "spk": "今野 (コンノ)",
          "ja": "仕方がないでしょう？",
          "tc": "應該也沒地方花吧？",
          "sc": "应该也没地方花吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 360355,
          "spk": "今野 (コンノ)",
          "ja": "ワタシが持っていたほうが",
          "tc": "錢放到我這裡來的話，",
          "sc": "钱放到我这里来的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 360362,
          "spk": "今野 (コンノ)",
          "ja": "有効活用できるというものですヨ",
          "tc": "我還能有效運用呢。",
          "sc": "我还能有效运用哟～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 360373,
          "spk": "今野 (コンノ)",
          "ja": "金を預けてくれれば、",
          "tc": "只要您交給我投資，",
          "sc": "只要您交给我投资，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 360380,
          "spk": "今野 (コンノ)",
          "ja": "いつか倍にしてお返ししますからネ",
          "tc": "我總有一天能加倍奉還給您的。",
          "sc": "我总有一天能加倍奉还给您的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6350,
      "rec_id": "TALK_ID_70_0090_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360398,
          "spk": "今野 (コンノ)",
