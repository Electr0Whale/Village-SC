        {
          "f_idx": 1,
          "pidx_tc": 359194,
          "spk": "六角 (ロッカク)",
          "ja": "下らねえことを口走っちまいましたねぇ！",
          "tc": "我不小心說溜嘴了呢！",
          "sc": "我不小心说溜嘴了呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359201,
          "spk": "六角 (ロッカク)",
          "ja": "今のは、忘れて欲しいっス",
