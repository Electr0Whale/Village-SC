    },
    {
      "file": "talk.dat",
      "rec_idx": 6338,
      "rec_id": "TALK_ID_70_0090_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359882,
          "spk": "今野 (コンノ)",
          "ja": "……えっ？",
          "tc": "……咦？",
          "sc": "……咦？"
