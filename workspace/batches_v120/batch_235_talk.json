    {
      "file": "talk.dat",
      "rec_idx": 6334,
      "rec_id": "TALK_ID_70_0090_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359605,
          "spk": "今野 (コンノ)",
