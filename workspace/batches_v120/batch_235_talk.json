          "ja": "次はありませんヨ？",
          "tc": "下不為例喔。",
          "sc": "下不为例哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6339,
      "rec_id": "TALK_ID_70_0090_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359945,
          "spk": "今野 (コンノ)",
          "ja": "まさか……アナタ……",
