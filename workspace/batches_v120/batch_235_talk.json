        {
          "f_idx": 3,
          "pidx_tc": 359634,
          "spk": "今野 (コンノ)",
          "ja": "とはいえ、<player>さんのような",
          "tc": "但是像<player>這樣的小孩子，",
          "sc": "但是像<player>这样的小孩子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 359641,
          "spk": "今野 (コンノ)",
          "ja": "小さな子どもに一体何ができるのやら",
          "tc": "到底能做些什麼啊？",
          "sc": "到底能做些什么啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 359657,
          "spk": "今野 (コンノ)",
          "ja": "ワタシは村長の秘書ですからねェ……",
          "tc": "我畢竟是村長的秘書……",
          "sc": "我毕竟是村长的秘书……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 359664,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの仕事はアナタのようなガキに",
          "tc": "我的工作可不能託付給",
          "sc": "我的工作可不能托付给"
        },
        {
          "f_idx": 8,
          "pidx_tc": 359671,
          "spk": "今野 (コンノ)",
          "ja": "任せるわけにはいかないですし……",
          "tc": "您這樣的小鬼頭啊……",
          "sc": "您这样的小鬼头啊……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 359682,
          "spk": "今野 (コンノ)",
          "ja": "アナタに手伝えることなんて",
          "tc": "我完全想不到",
          "sc": "我完全想不到"
        },
        {
          "f_idx": 10,
          "pidx_tc": 359689,
          "spk": "今野 (コンノ)",
          "ja": "ぜーんぜん、思いつきませんよォ",
          "tc": "您能幫我什麼呢。",
          "sc": "您能帮我什么哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6335,
      "rec_id": "TALK_ID_70_0090_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359707,
          "spk": "今野 (コンノ)",
          "ja": "おやおや",
