          "f_idx": 3,
          "pidx_tc": 359461,
          "spk": "六角 (ロッカク)",
          "ja": "隠すことはなにもないっスからねぇ",
          "tc": "我可沒什麼好隱瞞的，",
          "sc": "我可没什么好隐瞒的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 359468,
          "spk": "六角 (ロッカク)",
          "ja": "ウチはごく普通の食堂なんで",
          "tc": "這裡只是一家再普通不過的餐廳罷了。",
          "sc": "这里只是一家再普通不过的餐厅罢了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6331,
      "rec_id": "TALK_ID_70_0080_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359492,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、そういえば一つ",
          "tc": "啊，對了，",
