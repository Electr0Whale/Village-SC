        {
          "f_idx": 3,
          "pidx_tc": 359133,
          "spk": "六角 (ロッカク)",
          "ja": "ちょっとばかり苦手でして",
          "tc": "應付林。",
          "sc": "应付林。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 359144,
          "spk": "六角 (ロッカク)",
          "ja": "あの人が村のために頑張ってくれているのは、",
          "tc": "雖然我很明白她為了整個村子",
          "sc": "虽然我很明白她为了整个村子"
