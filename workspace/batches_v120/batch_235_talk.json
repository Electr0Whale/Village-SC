      "rec_id": "TALK_ID_70_0070_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365484,
          "spk": "茶梅 (サザンカ)",
          "ja": "それは、余った鉱石で作ってみた",
          "tc": "這是我用剩下的礦石試著做出來的",
          "sc": "这是我用剩下的矿石试着做出来的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365491,
          "spk": "茶梅 (サザンカ)",
          "ja": "「醸造樽」だよ",
          "tc": "「釀造桶」喔。",
          "sc": "“酿造桶”哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 365500,
          "spk": "茶梅 (サザンカ)",
          "ja": "作物や果物を入れて置いとくだけで、",
          "tc": "只要把作物或水果放進去，",
          "sc": "只要把作物或水果放进去，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365507,
          "spk": "茶梅 (サザンカ)",
          "ja": "野菜の出汁やリキュールが作れる",
          "tc": "就可以做出蔬菜高湯或是利口酒，",
          "sc": "就可以做出蔬菜高汤或是利口酒，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365514,
          "spk": "茶梅 (サザンカ)",
          "ja": "スグレモノなんだ",
          "tc": "是個超級方便的東西唷。",
          "sc": "可是个超级方便的好东西呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365525,
          "spk": "茶梅 (サザンカ)",
          "ja": "美味しいお酒ができたら……",
          "tc": "如果你釀出了美酒……",
          "sc": "如果你酿出了美酒……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 365532,
          "spk": "茶梅 (サザンカ)",
          "ja": "もちろん、分けてよね～？",
          "tc": "記得一定要和我分享喔～",
          "sc": "记得一定要和我分享哦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6308,
      "rec_id": "TALK_ID_70_0070_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365556,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああ、そうだ……",
          "tc": "啊，對了……",
          "sc": "啊，对了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6309,
      "rec_id": "TALK_ID_70_0070_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365574,
          "spk": "茶梅 (サザンカ)",
          "ja": "さっき言った「埋蔵金」だけど……",
          "tc": "關於我剛剛提到的「地下寶藏」……",
          "sc": "关于我刚刚提到的“地下宝藏”……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365581,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタは探しちゃダメだからね？",
          "tc": "你可不能去找喔？",
          "sc": "你可不能去找哦？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 365592,
          "spk": "茶梅 (サザンカ)",
          "ja": "独り占めしたいとか、そういうのじゃなくてさ",
          "tc": "這不是因為我想獨占寶藏什麼的，",
          "sc": "这不是因为我想独占宝藏什么的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365599,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんに「絶対に探すな」って",
          "tc": "而是以前爺爺曾經很嚴厲地叮嚀過我，",
          "sc": "而是以前爷爷曾经很严厉地叮咛过我，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365606,
          "spk": "茶梅 (サザンカ)",
          "ja": "かなり強めに言われてるんだよね……",
          "tc": "叫我「絕對不可以去找」……",
          "sc": "叫我“绝对不可以去找”……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365617,
          "spk": "茶梅 (サザンカ)",
          "ja": "実際、探そうとしたら死ぬほど怒られたし",
          "tc": "實際上我以前試著去找過，結果被痛罵了一頓。",
          "sc": "实际上我以前试着去找过，结果被痛骂了一顿。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 365624,
          "spk": "茶梅 (サザンカ)",
          "ja": "たぶん、見つけたらなんかあるんだと思う",
          "tc": "所以我猜要是找到了，應該會發生些什麼。",
          "sc": "所以我猜要是找到了，应该会发生些什么。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 365642,
          "spk": "茶梅 (サザンカ)",
          "ja": "あんまり、よくないこと……",
          "tc": "而且應該是不太好的事……",
          "sc": "而且应该是不太好的事……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 365649,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、約束ね？",
          "tc": "所以我們約好囉？",
          "sc": "所以我们约好啦？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6310,
      "rec_id": "TALK_ID_70_0070_004_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365674,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、そういうことで",
          "tc": "總之就是這麼回事，",
          "sc": "总之就是这么回事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365681,
          "spk": "茶梅 (サザンカ)",
          "ja": "よろしくね～",
          "tc": "拜託你囉～",
          "sc": "拜托你啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6311,
      "rec_id": "TALK_ID_70_0080_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358403,
          "spk": "六角 (ロッカク)",
          "ja": "おや？",
          "tc": "……哦？",
          "sc": "……哦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358410,
          "spk": "六角 (ロッカク)",
          "ja": "こいつは、お手伝い券っスか……？",
          "tc": "這是幫忙券嗎……？",
          "sc": "这是帮忙券吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358421,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、リンさんに命令されたんですか",
          "tc": "啊，是林的指示啊。",
          "sc": "啊，是林的指示啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 358428,
          "spk": "六角 (ロッカク)",
          "ja": "ご苦労様っスねぇ、<player>さん",
          "tc": "辛苦你啦，<player>。",
          "sc": "辛苦你啦，<player>呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6312,
      "rec_id": "TALK_ID_70_0080_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358446,
          "spk": "六角 (ロッカク)",
          "ja": "ふむ、とはいえ、だ……",
          "tc": "嗯，可是呢……",
          "sc": "嗯，可是呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358453,
          "spk": "六角 (ロッカク)",
          "ja": "正直、困っていることはなにもないんスが……",
          "tc": "老實說我現在沒有什麼需要幫忙的啊……",
          "sc": "老实说我现在没有什么需要帮忙的啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6313,
      "rec_id": "TALK_ID_70_0080_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358478,
          "spk": "六角 (ロッカク)",
          "ja": "……ああ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358496,
          "spk": "六角 (ロッカク)",
          "ja": "それなら、出前をお願いしてもいいっスか？",
          "tc": "這樣好了，可以麻煩你幫我外送嗎？",
          "sc": "这样好了，可以麻烦你帮我外送不？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6314,
      "rec_id": "TALK_ID_70_0080_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358514,
          "spk": "六角 (ロッカク)",
          "ja": "いやね？",
          "tc": "你聽我說，",
          "sc": "你听我说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358525,
          "spk": "六角 (ロッカク)",
          "ja": "実は、お忙しい我らが村長さんに",
          "tc": "其實我被",
          "sc": "其实我被"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358532,
          "spk": "六角 (ロッカク)",
          "ja": "「自分のところまで料理を持ってこい」って",
          "tc": "我們忙碌的村長吩咐說，",
          "sc": "我们忙碌的村长吩咐说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 358539,
          "spk": "六角 (ロッカク)",
          "ja": "仰せつかっているんスが……",
          "tc": "要把料理送過去給她……",
          "sc": "要把料理送过去给她……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 358550,
          "spk": "六角 (ロッカク)",
          "ja": "ワシが持ってくとねぇ",
          "tc": "可是如果我親自送去，",
          "sc": "可是如果我亲自送去，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 358557,
          "spk": "六角 (ロッカク)",
          "ja": "ちと面倒なことになるんスよ",
          "tc": "有可能會節外生枝。",
          "sc": "有可能会节外生枝。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 358568,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、今月はやりくりが厳しくて",
          "tc": "其實我這個月的手頭很緊，",
          "sc": "其实我这个月的手头很紧，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 358575,
          "spk": "六角 (ロッカク)",
          "ja": "「住民税的なアレ」を払えてねえんスよねぇ",
          "tc": "還沒付「居民稅」。",
          "sc": "还没付“居民税”。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 358582,
          "spk": "六角 (ロッカク)",
          "ja": "いやぁ、困った困った",
          "tc": "唉，真是傷腦筋。",
          "sc": "唉，真是伤脑筋。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 358591,
          "spk": "六角 (ロッカク)",
          "ja": "そういうわけで、",
          "tc": "所以啊，",
          "sc": "所以啊，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 358598,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんが代わりに行ってくれると",
          "tc": "<player>，如果你能代替我去送的話，",
          "sc": "<player>，如果你能代替我去送的话，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 358605,
          "spk": "六角 (ロッカク)",
          "ja": "助かるんスが……どうでしょう？",
          "tc": "我會很感激的……怎麼樣？",
          "sc": "我会很感激的……怎么样？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 358616,
          "spk": "六角 (ロッカク)",
          "ja": "暮らしが厳しいわけじゃないんスけど……",
          "tc": "雖然我們生活上倒還過得去……",
          "sc": "虽然我们生活上倒还过得去……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 358623,
          "spk": "六角 (ロッカク)",
          "ja": "……ヨウさんのためにね",
          "tc": "……但我還是想為了洋妹妹",
          "sc": "……但我还是想为了洋妹妹"
        },
        {
          "f_idx": 14,
          "pidx_tc": 358630,
          "spk": "六角 (ロッカク)",
          "ja": "色々残してやりたいんスよ",
          "tc": "多留點東西。",
          "sc": "多留点东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6315,
      "rec_id": "TALK_ID_70_0080_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358648,
          "spk": "六角 (ロッカク)",
          "ja": "おっと、少しばかり辛気くさい話になったっスね",
          "tc": "哎呀，話題好像變得有點沉重了，",
          "sc": "哎呀，话题好像变得有点沉重了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358655,
          "spk": "六角 (ロッカク)",
          "ja": "とにかく、出前を頼みたいって話っス",
          "tc": "總之我想麻煩你去外送，",
          "sc": "总之我想麻烦你去外送，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358662,
          "spk": "六角 (ロッカク)",
          "ja": "お願い、できますかね？",
          "tc": "不知道可不可以？",
          "sc": "不知道可不可以？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6316,
      "rec_id": "TALK_ID_70_0080_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358680,
          "spk": "六角 (ロッカク)",
          "ja": "おお、良いお返事だ",
          "tc": "哦，很好的回答，",
          "sc": "哦，很好的回答，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358687,
          "spk": "六角 (ロッカク)",
          "ja": "頼んでみるもんっスねぇ",
          "tc": "果然有問有機會。",
          "sc": "果然有问有机会呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6317,
      "rec_id": "TALK_ID_70_0080_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358711,
          "spk": "六角 (ロッカク)",
          "ja": "それじゃあ、これをお願いするっス",
          "tc": "那就請你送這個過去。",
          "sc": "那就请你送这个过去呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6318,
      "rec_id": "TALK_ID_70_0080_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358735,
          "spk": "六角 (ロッカク)",
          "ja": "別に汁物とかじゃないっスけど、",
          "tc": "雖然這不是什麼湯湯水水的，",
          "sc": "虽然这不是什么汤汤水水的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358742,
          "spk": "六角 (ロッカク)",
          "ja": "斜めにしたら多分、あの人怒るんで",
          "tc": "但是你拿歪了她應該會生氣，",
          "sc": "但是你拿歪了她应该会生气，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358749,
          "spk": "六角 (ロッカク)",
          "ja": "少しだけ、注意して運んで欲しいっス",
          "tc": "所以外送的時候稍微注意一點喔。",
          "sc": "所以外送的时候稍微注意一点呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6319,
      "rec_id": "TALK_ID_70_0080_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358773,
          "spk": "林 (リン)",
          "ja": "これは、ロッカクに頼んでいたお弁当？",
          "tc": "這是我跟六角點的便當嗎？",
          "sc": "这是我跟六角点的便当吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358780,
          "spk": "林 (リン)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358787,
          "spk": "林 (リン)",
          "ja": "持ってきてくれたのね",
          "tc": "你幫忙送來了啊。",
          "sc": "你帮忙送来了啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 358798,
          "spk": "林 (リン)",
          "ja": "真面目にお手伝い券を消化しているようね",
          "tc": "你很認真在消化幫忙券呢，",
          "sc": "你很认真在消化帮忙券呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 358805,
          "spk": "林 (リン)",
          "ja": "その調子で頑張りなさい",
          "tc": "繼續努力下去吧。",
          "sc": "继续努力下去吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 358816,
          "spk": "林 (リン)",
          "ja": "村人のお願いをこなした数だけ、",
          "tc": "你替越多村民幫忙，",
          "sc": "你替越多村民帮忙，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 358823,
          "spk": "林 (リン)",
          "ja": "あなたはこの村に馴染むことができるでしょう",
          "tc": "就越能融入這個村子。",
          "sc": "就越能融入这个村子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6320,
      "rec_id": "TALK_ID_70_0080_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358848,
          "spk": "林 (リン)",
          "ja": "それにしても、ロッカクめ……",
          "tc": "不過六角那傢伙也真是的……",
          "sc": "不过六角那家伙也真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358855,
          "spk": "林 (リン)",
          "ja": "早めにお願いって言ったのに……",
          "tc": "我明明就叫他要趕快繳款了……",
          "sc": "我明明就叫他要赶快缴款了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358866,
          "spk": "林 (リン)",
          "ja": "来月はしっかり搾り取ってやるんだから……",
          "tc": "下個月看我怎麼好好壓榨他……",
          "sc": "下个月看我怎么好好压榨他……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 358877,
          "spk": "林 (リン)",
          "ja": "あら？",
          "tc": "哎呀？",
          "sc": "哎呀？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 358884,
          "spk": "林 (リン)",
          "ja": "注文した料理以外に、",
          "tc": "除了我點的料理之外",
          "sc": "除了我点的料理之外"
        },
        {
          "f_idx": 5,
          "pidx_tc": 358891,
          "spk": "林 (リン)",
          "ja": "何か入っているわね",
          "tc": "還有其他東西呢。",
          "sc": "还有其他东西呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 358900,
          "spk": "林 (リン)",
          "ja": "リンゴのタルト？",
          "tc": "這是蘋果塔？",
          "sc": "这是苹果塔？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 358907,
          "spk": "林 (リン)",
          "ja": "……と、メモ書きね",
          "tc": "……還有張紙條。",
          "sc": "……还有张纸条。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 358918,
          "spk": "林 (リン)",
          "ja": "「今回はこれでお許しを」ね……",
          "tc": "「聊表心意，敬請海涵」……",
          "sc": "“聊表心意，敬请海涵”……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 358925,
          "spk": "林 (リン)",
          "ja": "相変わらず、変に気が回るというか",
          "tc": "他還是跟以前一樣，莫名地體貼，",
          "sc": "他还是跟以前一样，莫名地体贴，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 358932,
          "spk": "林 (リン)",
          "ja": "世渡りが上手いというか……",
          "tc": "或者說很會做人……",
          "sc": "或者说很会做人……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 358943,
          "spk": "林 (リン)",
          "ja": "まあ、いいわ",
          "tc": "算了，",
          "sc": "算了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 358950,
          "spk": "林 (リン)",
          "ja": "私も、この村唯一の食堂を潰したいわけじゃない",
          "tc": "我也不想搞垮全村唯一的餐廳，",
          "sc": "我也不想搞垮全村唯一的餐厅，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 358957,
          "spk": "林 (リン)",
          "ja": "今回だけは、もう少し猶予を与えましょう",
          "tc": "這次就寬限他一點時間吧。",
          "sc": "这次就宽限他一点时间吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6321,
      "rec_id": "TALK_ID_70_0080_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 358977,
          "spk": "林 (リン)",
          "ja": "ロッカクは少しうさんくさい男だけれど、",
          "tc": "六角雖然是個有點可疑的男人，",
          "sc": "六角虽然是个有点可疑的男人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358984,
          "spk": "林 (リン)",
          "ja": "その料理の腕は私も認めるところよ",
          "tc": "但是他的廚藝是我也認可的。",
          "sc": "但是他的厨艺是我也认可的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358995,
          "spk": "林 (リン)",
          "ja": "もし、あなたが今後も一人暮らしを続けるなら",
          "tc": "如果你以後要繼續自己生活，",
          "sc": "如果你以后要继续自己生活，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 359002,
          "spk": "林 (リン)",
          "ja": "彼に料理を習ってみるのもいいんじゃないかしら",
          "tc": "跟他學一下怎麼做菜會比較好吧。",
          "sc": "跟他学一下怎么做菜会比较好吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6322,
      "rec_id": "TALK_ID_70_0080_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359027,
          "spk": "林 (リン)",
          "ja": "それじゃあ、お手伝い券の消化に戻りなさい",
          "tc": "那你就繼續去消化幫忙券吧。",
          "sc": "那你就继续去消化帮忙券吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359045,
          "spk": "林 (リン)",
          "ja": "これもあなたの大事な仕事なんだから、",
          "tc": "這也是你重要的工作，",
          "sc": "这也是你重要的工作，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 359052,
          "spk": "林 (リン)",
          "ja": "手抜きなんてしちゃダメよ？",
          "tc": "不可以偷懶喔。",
          "sc": "不可以偷懒哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6323,
      "rec_id": "TALK_ID_70_0080_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359076,
          "spk": "六角 (ロッカク)",
          "ja": "おや、出前は終わったみたいっスねぇ",
          "tc": "哦，你去外送回來了啊，",
