        {
          "f_idx": 3,
          "pidx_tc": 359212,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、村の掟にもあるでしょう？",
          "tc": "村裡不是有規矩嗎？",
          "sc": "村里不是有规矩吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6326,
      "rec_id": "TALK_ID_70_0080_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359230,
          "spk": "六角 (ロッカク)",
          "ja": "「他人の秘密を暴くな」ってね",
