          "sc": "咦～～真伤脑筋啊～～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 359732,
          "spk": "今野 (コンノ)",
          "ja": "どうしてもと言うのなら、",
          "tc": "如果您執意要幫的話，",
          "sc": "如果您执意要帮的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 359739,
          "spk": "今野 (コンノ)",
          "ja": "出すものを出していただかないと……",
          "tc": "那我也要請您付出相應的代價才行……",
          "sc": "那我也要请您付出相应的代价才行……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 359746,
          "spk": "今野 (コンノ)",
          "ja": "いや～～、なんだか悪いですねェ～",
          "tc": "哎呀～感覺真是不太好意思啊～",
          "sc": "哎呀～感觉真是不太好意思啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6336,
      "rec_id": "TALK_ID_70_0090_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359764,
