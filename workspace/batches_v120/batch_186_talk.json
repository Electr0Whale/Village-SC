  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4305,
      "rec_id": "TALK_ID_10_0302_023_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247920,
          "spk": "帷 (トバリ)",
          "ja": "だってこんな樹なんて、なかった……",
          "tc": "因為這裡之前根本沒有這種樹……",
          "sc": "因为这里之前根本没有这种树……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247927,
          "spk": "帷 (トバリ)",
          "ja": "気持ち悪い……なんで急に現れたの……",
          "tc": "好詭異……為什麼會突然長出來……",
          "sc": "好诡异……为什么会突然长出来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247940,
          "spk": "驹子 (コマコ)",
          "ja": "そうだよね……",
          "tc": "也是呢……",
          "sc": "也是呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247947,
          "spk": "驹子 (コマコ)",
          "ja": "こんな樹が生えてたら、",
          "tc": "如果本來就長著這樣的樹，",
          "sc": "如果本来就长着这样的树，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247954,
          "spk": "驹子 (コマコ)",
          "ja": "嫌でも記憶に残るだろうから……",
          "tc": "再怎麼樣都會留下印象才對……",
          "sc": "再怎么样都会留下印象才对……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4306,
      "rec_id": "TALK_ID_10_0302_023_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247972,
          "spk": "帷 (トバリ)",
          "ja": "それよりコマコ、あれを見て",
          "tc": "先不管了，駒子，妳看那個，",
          "sc": "先不管了，驹子，你看那个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247979,
          "spk": "帷 (トバリ)",
          "ja": "ニワトリ、いたわよ",
          "tc": "雞在那裡。",
          "sc": "鸡在那里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4307,
      "rec_id": "TALK_ID_10_0302_023_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248007,
          "spk": "驹子 (コマコ)",
          "ja": "ピロは……こんな所に居たんだね……",
          "tc": "嗶羅……原來在這裡啊……",
          "sc": "哔罗……原来在这里啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248014,
          "spk": "驹子 (コマコ)",
          "ja": "でも、一体どうして樹に引っかかって……",
          "tc": "可是，為什麼會卡在樹上……？",
          "sc": "可是，为什么会卡在树上……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248027,
          "spk": "帷 (トバリ)",
          "ja": "<player>の鶏小屋から逃げ出して、",
          "tc": "大概是從<player>的雞舍逃出來之後，",
          "sc": "大概是从<player>的鸡舍逃出来之后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248034,
          "spk": "帷 (トバリ)",
          "ja": "この樹の上で力尽きたとかじゃない？",
          "tc": "在這棵樹上耗盡體力了吧？",
          "sc": "在这棵树上耗尽体力了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248041,
          "spk": "帷 (トバリ)",
          "ja": "それよりも、このままでいいの？",
          "tc": "先別說那個了，要這樣放著牠不管嗎？",
          "sc": "先别说那个了，要这样放着它不管吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248054,
          "spk": "驹子 (コマコ)",
          "ja": "た、確かに……！",
          "tc": "對、對喔……！",
          "sc": "对、对哦……！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248061,
          "spk": "驹子 (コマコ)",
          "ja": "早く降ろしてあげよう！",
          "tc": "快點把牠放下來吧！",
          "sc": "快点把它放下来吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4308,
      "rec_id": "TALK_ID_10_0302_023_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248087,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、手元が暗いと上手く取れないから、",
          "tc": "<player>，手邊太黑的話會不好弄，",
          "sc": "<player>，手边太黑的话会不好弄，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248094,
          "spk": "驹子 (コマコ)",
          "ja": "懐中電灯で照らしておいてくれると",
          "tc": "如果能幫我用手電筒照著的話",
          "sc": "如果能帮我用手电筒照着的话"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248101,
          "spk": "驹子 (コマコ)",
          "ja": "助かるんだけど……いいかな？",
          "tc": "就幫大忙了……可以拜託你嗎？",
          "sc": "就帮大忙了……可以拜托你吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4309,
      "rec_id": "TALK_ID_10_0302_023_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248130,
          "spk": "驹子 (コマコ)",
          "ja": "落とさないように、",
          "tc": "得小心一點，",
          "sc": "得小心一点，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248137,
          "spk": "驹子 (コマコ)",
          "ja": "慎重に取ってあげなきゃね……",
          "tc": "別讓牠掉下去了……",
          "sc": "别让它掉下去了……"
        }
      ]
    },
    {
