        {
          "f_idx": 2,
          "pidx_tc": 248175,
          "spk": "驹子 (コマコ)",
          "ja": "ピロを降ろせな",
          "tc": "會沒辦法把嗶羅弄下……",
          "sc": "会没办法把哔罗弄下……"
