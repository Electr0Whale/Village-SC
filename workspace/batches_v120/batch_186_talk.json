      "rec_id": "TALK_ID_10_0302_023_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249687,
          "spk": "驹子 (コマコ)",
          "ja": "ねぇトバリ、<player>",
          "tc": "帷、<player>！",
