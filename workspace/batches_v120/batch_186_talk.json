      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4319,
      "rec_id": "TALK_ID_10_0302_023_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248568,
          "spk": "帷 (トバリ)",
          "ja": "ニワトリを返してほしいのはアンタでしょ？",
          "tc": "想要帶回雞的不就是妳嗎？",
          "sc": "想要带回鸡的不就是你吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248575,
          "spk": "帷 (トバリ)",
          "ja": "私が言ってやるから、黙って見てなさい",
          "tc": "我來跟祂說，妳就安靜看著吧。",
          "sc": "我来跟他说，你就安静看着吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248586,
          "spk": "？？？ (未知角色)",
          "ja": "だ、め、ニワト、リ、、……",
          "tc": "不、行、那隻雞……",
          "sc": "不、行、那只鸡……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248593,
          "spk": "？？？ (未知角色)",
          "ja": "と、とら、ないで……、",
          "tc": "不、不要、帶走……",
          "sc": "不、不要、带走……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4320,
      "rec_id": "TALK_ID_10_0302_023_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248613,
          "spk": "帷 (トバリ)",
          "ja": "どうしてニワトリを返したくないの？",
          "tc": "為什麼不把雞還給我們？",
          "sc": "为什么不把鸡还给我们？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248620,
          "spk": "帷 (トバリ)",
          "ja": "ただの死体なのに、何をするつもり？",
          "tc": "那只是個屍體，祢打算做什麼？",
          "sc": "那只是个尸体，你打算做什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248627,
          "spk": "帷 (トバリ)",
          "ja": "まさかむしゃむしゃ食べるとか……",
          "tc": "該不會是要啃掉牠……",
          "sc": "该不会是要啃掉它……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248638,
          "spk": "？？？ (未知角色)",
          "ja": "……さ、、い",
          "tc": "……好、寂……",
          "sc": "……好、寂……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248651,
          "spk": "帷 (トバリ)",
          "ja": "……え",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248662,
          "spk": "？？？ (未知角色)",
          "ja": "さ、みし、い、さみし、いよ……",
          "tc": "好寂、寞……好寂寞、啊……",
          "sc": "好寂、寞……好寂寞、啊……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248669,
          "spk": "？？？ (未知角色)",
          "ja": "だか、ら、おね、おねが、い……",
          "tc": "所、以，求、求求你們……",
          "sc": "所、以，求、求求你们……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 248678,
          "spk": "？？？ (未知角色)",
          "ja": "ニワト、、リを、と、とらな、いで……",
          "tc": "不、不要、帶走……那隻雞……",
          "sc": "不、不要、带走……那只鸡……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 248685,
          "spk": "？？？ (未知角色)",
          "ja": "おね、おねが……い……",
          "tc": "求、求求……你們……",
          "sc": "求、求求……你们……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 248698,
          "spk": "驹子 (コマコ)",
