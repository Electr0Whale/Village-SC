      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248352,
          "spk": "驹子 (コマコ)",
          "ja": "しゃ、喋った……！？",
          "tc": "說、說話了……！？",
          "sc": "说、说话了……！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248359,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ、お化けが喋ってるよ……！",
          "tc": "帷，妖怪說話了……！",
          "sc": "帷，妖怪说话了……！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248370,
          "spk": "帷 (トバリ)",
          "ja": "喋るお化けなんて、初めて見た……",
          "tc": "我也是第一次看到會說話的妖怪……",
          "sc": "我也是第一次看到会说话的妖怪……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248388,
          "spk": "？？？ (未知角色)",
          "ja": "やめ、て、、……",
          "tc": "住、手……",
          "sc": "住、手……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248401,
          "spk": "帷 (トバリ)",
          "ja": "アンタ、一体なんなの？",
          "tc": "祢到底是什麼東西？",
          "sc": "你到底是什么东西？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248408,
          "spk": "帷 (トバリ)",
          "ja": "この桃の樹に取り憑いた幽霊？",
          "tc": "是附身在這棵桃樹上的幽靈嗎？",
          "sc": "是附身在这棵桃树上的幽灵吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 248419,
          "spk": "？？？ (未知角色)",
          "ja": "あ……え、あ……",
          "tc": "啊……呃、啊……",
          "sc": "啊……呃、啊……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 248426,
          "spk": "？？？ (未知角色)",
          "ja": "うー……あ、",
          "tc": "嗚……啊……",
          "sc": "呜……啊……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 248435,
          "spk": "？？？ (未知角色)",
          "ja": "たす、け、て……",
          "tc": "救、救、我……",
          "sc": "救、救、我……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 248446,
          "spk": "驹子 (コマコ)",
          "ja": "ヒッ……",
          "tc": "咿……",
          "sc": "咿……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 248453,
          "spk": "驹子 (コマコ)",
          "ja": "このお化け、助けてって言ってるよ……",
          "tc": "這個妖怪，在求救……",
          "sc": "这个妖怪，在求救……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 248464,
          "spk": "？？？ (未知角色)",
          "ja": "た、す……け",
          "tc": "救……救……",
          "sc": "救……救……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 248477,
          "spk": "帷 (トバリ)",
          "ja": "私たち、アンタに用はないの",
          "tc": "我們不是來找祢的。",
          "sc": "我们不是来找你的。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 248484,
          "spk": "帷 (トバリ)",
          "ja": "ここに来たのは、",
          "tc": "我們來這裡，",
          "sc": "我们来这里，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 248491,
          "spk": "帷 (トバリ)",
          "ja": "そのニワトリを返してもらうためだから……",
          "tc": "只是為了要帶回那隻雞而已……",
          "sc": "只是为了要带回那只鸡而已……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 248502,
          "spk": "？？？ (未知角色)",
          "ja": "やめ、やめ……て……",
          "tc": "住、住……手……",
          "sc": "住、住……手……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 248511,
          "spk": "？？？ (未知角色)",
          "ja": "ニワト、リ、、……",
          "tc": "那、那隻雞……",
          "sc": "那、那只鸡……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 248518,
          "spk": "？？？ (未知角色)",
          "ja": "と、と、とら、ないで……",
          "tc": "不、不要、帶走……",
          "sc": "不、不要、带走……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 248525,
          "spk": "？？？ (未知角色)",
          "ja": "や、めて……",
          "tc": "住、手……",
          "sc": "住、手……"
        }
      ]
    },
    {
      "file": "talk.dat",
