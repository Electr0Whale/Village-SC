          "tc": "剛剛跟那個妖怪說話以後，",
          "sc": "刚刚跟那个妖怪说话以后，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 249486,
          "spk": "驹子 (コマコ)",
          "ja": "私、思い出したことがあって……",
          "tc": "想起了一件事……",
          "sc": "想起了一件事……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 249499,
          "spk": "驹子 (コマコ)",
          "ja": "私、この前お兄ちゃんから、",
          "tc": "那個妖怪剛才說的事情，",
          "sc": "那个妖怪刚才说的事情，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 249506,
          "spk": "驹子 (コマコ)",
          "ja": "あのお化けが言ってた話とよく似た、",
          "tc": "我之前聽哥哥說過",
          "sc": "我之前听哥哥说过"
        },
        {
          "f_idx": 17,
          "pidx_tc": 249513,
          "spk": "驹子 (コマコ)",
          "ja": "昔話を聞いたことあるの……",
          "tc": "跟那很類似的故事……",
          "sc": "跟那很类似的故事……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 249524,
          "spk": "驹子 (コマコ)",
          "ja": "ある村の人が神さまの奇跡の力を借りて、",
          "tc": "某個村子的人借助了神明大人的奇蹟之力，",
          "sc": "某个村子的人借助了神明大人的奇迹之力，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 249531,
          "spk": "驹子 (コマコ)",
          "ja": "時間を巻き戻し、",
          "tc": "倒轉了時間，",
          "sc": "倒转了时间，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 249538,
          "spk": "驹子 (コマコ)",
          "ja": "死んだ人を生き返らせたという話……",
          "tc": "讓死掉的人復活……",
          "sc": "让死掉的人复活……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 249547,
          "spk": "驹子 (コマコ)",
          "ja": "あのお化けが村の昔話を知っているなんて、",
          "tc": "那妖怪居然知道村裡流傳下來的故事，",
          "sc": "那妖怪居然知道村里流传下来的故事，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 249554,
          "spk": "驹子 (コマコ)",
          "ja": "気味が悪いけど……",
          "tc": "這點讓人覺得很詭異，不過……",
          "sc": "这点让人觉得很诡异，不过……"
        },
        {
          "f_idx": 23,
          "pidx_tc": 249565,
          "spk": "驹子 (コマコ)",
          "ja": "でも、ピロが生き返ったら……",
          "tc": "如果能讓嗶羅復活的話……",
          "sc": "如果能让哔罗复活的话……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 249572,
          "spk": "驹子 (コマコ)",
          "ja": "ヨウちゃんと<player>の元に、",
          "tc": "牠願意回到小洋與<player>的",
          "sc": "它愿意回到小洋与<player>的"
        },
        {
          "f_idx": 25,
          "pidx_tc": 249579,
          "spk": "驹子 (コマコ)",
          "ja": "戻って来てくれないかな……",
          "tc": "身邊嗎……？",
          "sc": "身边吗……？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 249592,
          "spk": "帷 (トバリ)",
          "ja": "はあ？",
          "tc": "啊？",
          "sc": "啊？"
        },
        {
          "f_idx": 27,
          "pidx_tc": 249599,
          "spk": "帷 (トバリ)",
          "ja": "まさか、その昔話のやり方でニワトリを",
          "tc": "妳該不會打算用那個故事講的方法，",
          "sc": "你该不会打算用那个故事讲的方法，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 249606,
          "spk": "帷 (トバリ)",
          "ja": "生き返らせるつもりじゃないでしょうね",
          "tc": "讓雞復活吧？",
          "sc": "让鸡复活吧？"
        },
        {
          "f_idx": 29,
          "pidx_tc": 249615,
          "spk": "帷 (トバリ)",
          "ja": "バカじゃない、アンタ何歳なの？",
          "tc": "妳是笨蛋嗎？都幾歲了？",
          "sc": "你是笨蛋吗？都几岁了？"
        },
        {
          "f_idx": 30,
          "pidx_tc": 249628,
          "spk": "驹子 (コマコ)",
          "ja": "でもここは彼ヶ津村だから……",
          "tc": "可是這裡畢竟是彼津村……",
          "sc": "可是这里毕竟是彼津村……"
        },
        {
          "f_idx": 31,
          "pidx_tc": 249635,
          "spk": "驹子 (コマコ)",
          "ja": "お化けが出るなら、昔話の「奇跡」も",
          "tc": "連妖怪都會出沒了，故事裡的「奇蹟」",
          "sc": "连妖怪都会出没了，故事里的“奇迹”"
        },
        {
          "f_idx": 32,
          "pidx_tc": 249642,
          "spk": "驹子 (コマコ)",
          "ja": "本当に起きるかもしれないよ……？",
          "tc": "說不定也真的會發生呀……？",
          "sc": "说不定也真的会发生呀……？"
        },
        {
          "f_idx": 33,
          "pidx_tc": 249655,
          "spk": "帷 (トバリ)",
          "ja": "それは……確かに",
          "tc": "這……倒也是，",
          "sc": "这……倒也是，"
        },
        {
          "f_idx": 34,
          "pidx_tc": 249662,
          "spk": "帷 (トバリ)",
          "ja": "この村のことだから、",
          "tc": "畢竟是這個村子，",
          "sc": "毕竟是这个村子，"
        },
        {
          "f_idx": 35,
          "pidx_tc": 249669,
          "spk": "帷 (トバリ)",
          "ja": "どんな突飛なことが起きても驚かないけれど……",
          "tc": "不管發生多離奇的事都不奇怪了……",
          "sc": "不管发生多离奇的事都不奇怪了……"
        }
      ]
    },
    {
      "file": "talk.dat",
