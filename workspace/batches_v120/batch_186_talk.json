      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248543,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ……なんだか",
          "tc": "帷……祂好像，",
          "sc": "帷……他好像，"
