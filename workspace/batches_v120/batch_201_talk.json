  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4935,
      "rec_id": "TALK_ID_10_0403_055_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 283934,
          "spk": "木助 (キスケ)",
          "ja": "なんだか俺も信じられねえよ",
          "tc": "連我自己都覺得真不敢相信啊！",
          "sc": "连我自己都觉得真不敢相信啊！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 283943,
          "spk": "木助 (キスケ)",
          "ja": "また明日から、普段の暮らしが",
          "tc": "竟然從明天起，",
          "sc": "竟然从明天起，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 283950,
          "spk": "木助 (キスケ)",
          "ja": "戻ってくるなんてな",
          "tc": "就能像以前一樣正常過日子了。",
          "sc": "就能像以前一样正常过日子了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 283961,
          "spk": "木助 (キスケ)",
          "ja": "妙な気分だ……",
          "tc": "感覺還真奇妙啊……",
          "sc": "感觉还真奇妙啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 283968,
          "spk": "木助 (キスケ)",
          "ja": "何も変わらない暮らしを",
          "tc": "明明想維持",
          "sc": "明明想维持"
        },
        {
          "f_idx": 5,
          "pidx_tc": 283975,
          "spk": "木助 (キスケ)",
          "ja": "続けたいはずなのに……",
          "tc": "一成不變的生活……",
          "sc": "一成不变的生活……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 283986,
          "spk": "木助 (キスケ)",
          "ja": "村が、変わるときが来たような気もする",
          "tc": "卻又覺得，村子也是時候該改變了。",
          "sc": "却又觉得，村子也是时候该改变了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4936,
      "rec_id": "TALK_ID_10_0403_055_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284011,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ……また明日",
          "tc": "就這樣啦……明天見！",
          "sc": "就这样啦……明天见！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4939,
      "rec_id": "TALK_ID_10_0403_055_52",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284049,
          "spk": "四郎治 (シロージ)",
          "ja": "ずっと眠っていたらしいな",
          "tc": "聽說我這段日子都在沉睡。",
          "sc": "听说我这段日子都在沉睡。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284056,
          "spk": "四郎治 (シロージ)",
          "ja": "……事情ならコマコから聞いたよ",
          "tc": "……事情的經過我已經聽駒子說了。",
          "sc": "……事情的经过我已经听驹子说了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284063,
          "spk": "四郎治 (シロージ)",
          "ja": "大雑把にだけどな",
          "tc": "雖然她說得很攏統就是了。",
          "sc": "虽然她说得很拢统就是了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284074,
          "spk": "四郎治 (シロージ)",
          "ja": "この村で暮らすなら、",
          "tc": "既然要在這座村子生活，",
          "sc": "既然要在这座村子生活，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284081,
          "spk": "四郎治 (シロージ)",
          "ja": "こういうこともあるだろうさ",
          "tc": "發生這種事也是難免的吧。",
          "sc": "发生这种事也是难免的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4941,
      "rec_id": "TALK_ID_10_0403_055_54",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284114,
          "spk": "驹子 (コマコ)",
          "ja": "トバリから聞いたよ",
          "tc": "帷都跟我說了喔！",
          "sc": "帷都跟我说了哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284125,
          "spk": "驹子 (コマコ)",
          "ja": "私たちがしばらく寝ていたこと……",
          "tc": "包括我們睡了好一陣子的事……",
          "sc": "包括我们睡了好一阵子的事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284132,
          "spk": "驹子 (コマコ)",
          "ja": "私たちが何の上に暮らしているのか……",
          "tc": "還有我們的生活是建立在什麼犧牲上……",
          "sc": "还有我们的生活是建立在什么牺牲上……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284139,
          "spk": "驹子 (コマコ)",
          "ja": "そして、リンがやろうとしていたこと……",
          "tc": "還聽說了林原本打算做的事……",
          "sc": "还听说了林原本打算做的事……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284150,
          "spk": "驹子 (コマコ)",
          "ja": "リンは、こんな大変なことを",
          "tc": "沒想到林竟然獨自一人，",
          "sc": "没想到林竟然独自一人，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284157,
          "spk": "驹子 (コマコ)",
          "ja": "一人で抱え込んでいたんだね",
          "tc": "背負著這麼沉重的負擔呢。",
          "sc": "背负着这么沉重的负担呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4942,
      "rec_id": "TALK_ID_10_0403_055_55",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284183,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんかアタシ、超寝てたみたいだね",
          "tc": "總覺得我睡了超長的一場覺啊。",
          "sc": "总觉得我睡了超长的一场觉啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284190,
          "spk": "茶梅 (サザンカ)",
          "ja": "しかも、アタシだけじゃなくて村のみんなも",
          "tc": "而且不只是我，還有村裡的大家也是。",
          "sc": "而且不只是我，还有村里的大家也是。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284201,
          "spk": "茶梅 (サザンカ)",
          "ja": "ね～、<player>",
          "tc": "我說啊～<player>。",
          "sc": "我说啊～<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284208,
          "spk": "茶梅 (サザンカ)",
          "ja": "何があったのか知らない？",
          "tc": "你知道發生了什麼事嗎？",
          "sc": "你知道发生了什么事吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284219,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>は寝てなかったって聞いたよ",
          "tc": "我有聽說<player>都醒著喔！",
          "sc": "我有听说<player>都醒着哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284226,
          "spk": "茶梅 (サザンカ)",
          "ja": "何があったのか教えてよ",
          "tc": "告訴我發生了什麼事嘛！",
          "sc": "告诉我发生了什么事嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4943,
      "rec_id": "TALK_ID_10_0403_055_56",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284252,
          "spk": "六角 (ロッカク)",
          "ja": "どうも、ほとんどの村人が",
          "tc": "聽說，",
          "sc": "听说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284259,
          "spk": "六角 (ロッカク)",
          "ja": "眠っちゃってたみたいっスね",
          "tc": "好像幾乎所有村民都睡著了。",
          "sc": "好像几乎所有村民都睡着呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284270,
          "spk": "六角 (ロッカク)",
          "ja": "とりあえず、ヨウさんが無事だったので",
          "tc": "總之，既然洋妹妹平安無事，",
          "sc": "总之，既然洋妹妹平安无事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284277,
          "spk": "六角 (ロッカク)",
          "ja": "ワシとしては安心したっス",
          "tc": "那我就放心了。",
          "sc": "那我就放心呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284288,
          "spk": "六角 (ロッカク)",
          "ja": "いや、もちろん他の人がどうでもいいって",
          "tc": "啊，當然不是說其他人怎樣都好，",
          "sc": "啊，当然不是说其他人怎样都好，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284295,
          "spk": "六角 (ロッカク)",
          "ja": "ワケじゃないっスけどね",
          "tc": "我沒有那個意思喔！",
          "sc": "我没有那个意思呐！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4944,
      "rec_id": "TALK_ID_10_0403_055_57",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284321,
          "spk": "今野 (コンノ)",
          "ja": "おや、<player>さん",
          "tc": "哎呀，是<player>啊。",
          "sc": "哎呀，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284328,
          "spk": "今野 (コンノ)",
          "ja": "ずいぶんなご活躍でしたネ",
          "tc": "您表現得相當活躍呢。",
          "sc": "您表现得相当活跃呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284339,
          "spk": "今野 (コンノ)",
          "ja": "ん……ワタシも眠ってたから、",
          "tc": "嗯……不過我也睡著了，",
          "sc": "嗯……不过我也睡着了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284346,
          "spk": "今野 (コンノ)",
          "ja": "リンさんから聞いただけです",
          "tc": "所以也只是聽林小姐轉述而已。",
          "sc": "所以也只是听林小姐转述而已。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284353,
          "spk": "今野 (コンノ)",
          "ja": "言葉の綾ってやつですよォ",
          "tc": "這就是說話的藝術呢～",
          "sc": "这就是说话的艺术呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284364,
          "spk": "今野 (コンノ)",
          "ja": "さて、ワタシは<player>さんと違って",
          "tc": "好了，我跟<player>不一樣，",
          "sc": "好了，我跟<player>不一样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 284371,
          "spk": "今野 (コンノ)",
          "ja": "忙しいので、そろそろ帰ってもらえますかネ？",
          "tc": "可是很忙的，您差不多可以回去了。",
          "sc": "可是很忙的，您差不多可以回去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4945,
      "rec_id": "TALK_ID_10_0403_055_58",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284397,
          "spk": "名护 (ナゴ)",
          "ja": "ああ、<player>さん……",
          "tc": "哦，<player>……",
          "sc": "哦，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284404,
          "spk": "名护 (ナゴ)",
          "ja": "俺はしばらくの間、",
          "tc": "我似乎",
          "sc": "我似乎"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284411,
          "spk": "名护 (ナゴ)",
          "ja": "眠ってしまっていたみたいなんだが……",
          "tc": "睡了好一陣子……",
          "sc": "睡了好一阵子……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284422,
          "spk": "名护 (ナゴ)",
          "ja": "キミは大丈夫だったそうだね",
          "tc": "你看起來沒事的樣子，",
          "sc": "你看起来没事的样子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284429,
          "spk": "名护 (ナゴ)",
          "ja": "どこも悪いところはないかい？",
          "tc": "身體有哪裡不舒服嗎？",
          "sc": "身体有哪里不舒服吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284436,
          "spk": "名护 (ナゴ)",
          "ja": "……だったらよかった",
          "tc": "……那就好。",
          "sc": "……那就好。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 284447,
          "spk": "名护 (ナゴ)",
          "ja": "それにしても、一体なにがあったんだろう",
          "tc": "不過話說回來，到底發生了什麼事呢？",
          "sc": "不过话说回来，到底发生了什么事呢？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 284454,
          "spk": "名护 (ナゴ)",
          "ja": "気味が悪いな……",
          "tc": "真讓人毛骨悚然……",
          "sc": "真让人毛骨悚然……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4946,
      "rec_id": "TALK_ID_10_0403_055_59",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284487,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、ずっと寝てたんだよね？",
          "tc": "我一直都在睡覺吧？",
          "sc": "我一直都在睡觉吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284494,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんから聞いたよ",
          "tc": "我有聽叔叔說過了喔！",
          "sc": "我有听叔叔说过了哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284512,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんもずっと寝てたって",
          "tc": "叔叔好像也一直在睡覺的樣子。",
          "sc": "叔叔好像也一直在睡觉的样子。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284519,
          "spk": "洋 (ヨウ)",
          "ja": "……なにがあったんだろう？",
          "tc": "……到底是發生了什麼是呢？",
          "sc": "……到底是发生了什么是呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4947,
      "rec_id": "TALK_ID_10_0403_055_60",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284545,
          "spk": "裕太 (ユータ)",
          "ja": "いやぁ、なんか何日も寝ちゃってたみたいだ",
          "tc": "哎呀，我好像睡了好幾天的樣子。",
          "sc": "哎呀，我好像睡了好几天的样子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284563,
          "spk": "裕太 (ユータ)",
          "ja": "俺が疲れてたのかと思ってたけど、",
          "tc": "我本來還以為是自己太累了，",
          "sc": "我本来还以为是自己太累了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284570,
          "spk": "裕太 (ユータ)",
          "ja": "他のみんなも一斉に眠ってたみたいだね",
          "tc": "但其他人好像也都一起睡著了的樣子。",
          "sc": "但其他人好像也都一起睡着了的样子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284588,
          "spk": "裕太 (ユータ)",
          "ja": "不思議なこともあるもんだよね",
          "tc": "這還真是不可思議呢，",
          "sc": "这还真是不可思议呢，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 284595,
          "spk": "裕太 (ユータ)",
          "ja": "キミはなにか知らない？",
          "tc": "你有什麼頭緒嗎？",
          "sc": "你有什么头绪吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4948,
      "rec_id": "TALK_ID_10_0403_055_61",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284621,
          "spk": "堇怜 (スミレ)",
          "ja": "なんかさ、僕だけじゃなくて",
          "tc": "聽說不是只有我睡著而已，",
          "sc": "听说不是只有我睡着而已，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 284628,
          "spk": "堇怜 (スミレ)",
          "ja": "みんなしてずっと眠り込んでたらしいよな",
          "tc": "好像大家都一直在昏睡耶。",
          "sc": "好像大家都一直在昏睡呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284646,
          "spk": "堇怜 (スミレ)",
          "ja": "んで、<player>がなんとかしたらしいじゃん？",
          "tc": "然後啊，聽說是<player>解決這件事的吧？",
          "sc": "然后啊，听说是<player>解决这件事的吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284653,
          "spk": "堇怜 (スミレ)",
          "ja": "何があったんだよ？",
          "tc": "到底發生了什麼事啊？",
          "sc": "到底发生了什么事啊？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284660,
          "spk": "堇怜 (スミレ)",
          "ja": "教えてくれよ～",
          "tc": "告訴我啦～",
          "sc": "告诉我啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4949,
      "rec_id": "TALK_ID_10_0403_055_62",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 284686,
          "spk": "莲实 (ハスミ)",
          "ja": "私、ずっと眠っていたみたいで……",
          "tc": "我這陣子好像一直在沉睡……",
          "sc": "我这阵子好像一直在沉睡……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 284702,
          "spk": "莲实 (ハスミ)",
          "ja": "目が覚めたら、",
          "tc": "結果清醒後發現……",
          "sc": "结果清醒后发现……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 284709,
          "spk": "莲实 (ハスミ)",
          "ja": "リンだけじゃなく、トバリやキスケさんも",
          "tc": "不只是林，甚至連帷和木助哥，",
          "sc": "不只是林，甚至连帷和木助哥，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 284716,
          "spk": "莲实 (ハスミ)",
          "ja": "腕を切っていて……",
          "tc": "都劃破了自己的手臂……",
          "sc": "都划破了自己的手臂……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 284727,
