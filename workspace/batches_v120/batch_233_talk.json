    },
    {
      "file": "talk.dat",
      "rec_idx": 6229,
      "rec_id": "TALK_ID_70_0040_001_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367989,
          "spk": "四郎治 (シロージ)",
          "ja": "くれぐれも自分で罠に",
          "tc": "千萬要注意，",
          "sc": "千万要注意，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367996,
          "spk": "四郎治 (シロージ)",
          "ja": "かかんないように注意しな",
          "tc": "不要中了自己放的陷阱喔！",
          "sc": "不要中了自己放的陷阱啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6230,
      "rec_id": "TALK_ID_70_0040_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368020,
          "spk": "四郎治 (シロージ)",
          "ja": "よし、次は罠にエサを置いてみろ",
          "tc": "很好，接下來試著在陷阱裡放餌食吧。",
          "sc": "很好，接下来试着在陷阱里放饵食吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6231,
      "rec_id": "TALK_ID_70_0040_001_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368044,
          "spk": "四郎治 (シロージ)",
          "ja": "よし……ご苦労さん",
          "tc": "很好……辛苦啦。",
          "sc": "很好……辛苦啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368051,
          "spk": "四郎治 (シロージ)",
          "ja": "これで動物が捕まえられるはずだ",
          "tc": "這麼一來應該就能捕到動物了。",
          "sc": "这么一来应该就能捕到动物了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368062,
          "spk": "四郎治 (シロージ)",
          "ja": "明日以降にでも様子を見に来るといい",
          "tc": "等明天後再找時間來看看吧。",
          "sc": "等明天后再找时间来看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6232,
      "rec_id": "TALK_ID_70_0040_001_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368085,
          "spk": "四郎治 (シロージ)",
          "ja": "んじゃ、頼んだぜ",
          "tc": "那就交給你了。",
          "sc": "那就交给你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6233,
      "rec_id": "TALK_ID_70_0040_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368105,
          "spk": "主角心声/旁白/选项",
          "ja": "動物が罠にかかっている！",
          "tc": "陷阱抓到動物了！",
          "sc": "陷阱抓到动物了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368112,
          "spk": "主角心声/旁白/选项",
          "ja": "シロージに報告しに行こう",
          "tc": "去向四郎治報告吧。",
          "sc": "去向四郎治报告吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6234,
      "rec_id": "TALK_ID_70_0040_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368132,
          "spk": "四郎治 (シロージ)",
          "ja": "おつかれさん",
          "tc": "辛苦了！",
          "sc": "辛苦了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368139,
          "spk": "四郎治 (シロージ)",
          "ja": "もう捕まえたのか",
          "tc": "已經抓到了嗎？",
          "sc": "已经抓到了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368150,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ、罠の場所まで案内してくれ",
          "tc": "那你帶我去設置陷阱的地方吧。",
          "sc": "那你带我去设置陷阱的地方吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6235,
      "rec_id": "TALK_ID_70_0040_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368174,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと捕まえられてすげーじゃん",
          "tc": "竟然真的抓到動物了，厲害喔！",
          "sc": "竟然真的抓到动物了，厉害啊！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368181,
          "spk": "四郎治 (シロージ)",
          "ja": "初めてにしちゃ上出来だ",
          "tc": "第一次就有這麼好的成果。",
          "sc": "第一次就有这么好的成果。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6236,
      "rec_id": "TALK_ID_70_0040_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368199,
          "spk": "四郎治 (シロージ)",
          "ja": "訳あって狩人の仕事は",
          "tc": "雖然因為某些原因，",
          "sc": "虽然因为某些原因，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368206,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコに譲っちまったんだが……",
          "tc": "我把獵人的工作讓給駒子了……",
          "sc": "我把猎人的工作让给驹子了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368217,
          "spk": "四郎治 (シロージ)",
          "ja": "俺も、お前と同じ年の頃には",
          "tc": "但我在你這個年紀的時候，",
          "sc": "但我在你这个年纪的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368224,
          "spk": "四郎治 (シロージ)",
          "ja": "狩人をやってたんだぜ",
          "tc": "也是在當獵人喔。",
          "sc": "也是在当猎人啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6237,
      "rec_id": "TALK_ID_70_0040_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368242,
          "spk": "四郎治 (シロージ)",
          "ja": "でも……山ってさ、放っておくと木が増えすぎて",
          "tc": "只是……要是放著山這種東西不管，",
          "sc": "只是……要是放着山这种东西不管，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368249,
          "spk": "四郎治 (シロージ)",
          "ja": "大きな日陰ができるんだ",
          "tc": "樹就會長過頭，形成巨大的陰影。",
          "sc": "树就会长过头，形成巨大的阴影。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368267,
          "spk": "四郎治 (シロージ)",
          "ja": "すると低い草や山菜が育たなくなって、",
          "tc": "這麼一來，地上的草或山菜都會長不大，",
          "sc": "这么一来，地上的草或山菜都会长不大，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 368274,
          "spk": "四郎治 (シロージ)",
          "ja": "山が荒れ果てちまう……",
          "tc": "最後整座山都會荒廢掉……",
          "sc": "最后整座山都会荒废掉……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 368292,
          "spk": "四郎治 (シロージ)",
          "ja": "だからこそ、誰かが定期的に手入れをして",
          "tc": "所以要有人定期砍伐、整理環境，",
          "sc": "所以要有人定期砍伐、整理环境，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 368299,
          "spk": "四郎治 (シロージ)",
          "ja": "環境を整えてやる必要がある……",
          "tc": "這可是很重要的……",
          "sc": "这可是很重要的……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 368306,
          "spk": "四郎治 (シロージ)",
          "ja": "それが村での暮らしを守ることに繋がるんだ",
          "tc": "那也是守護村子生活的一環。",
          "sc": "那也是守护村子生活的一环。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 368317,
          "spk": "四郎治 (シロージ)",
          "ja": "なんつーか……俺は戦う相手が",
          "tc": "該怎麼說呢……",
          "sc": "该怎么说呢……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 368324,
          "spk": "四郎治 (シロージ)",
          "ja": "動物から木に変わったって感じかもな",
          "tc": "就是我的對手從動物變成樹木的感覺吧。",
          "sc": "就是我的对手从动物变成树木的感觉吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 368342,
          "spk": "四郎治 (シロージ)",
          "ja": "それに……",
          "tc": "而且啊……",
          "sc": "而且啊……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 368349,
          "spk": "四郎治 (シロージ)",
          "ja": "でかい木を切るとスカッとすんだ",
          "tc": "把大樹砍下來有種快感。",
          "sc": "把大树砍下来有种快感。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 368360,
          "spk": "四郎治 (シロージ)",
          "ja": "刈った木材がみんなの役に立ってんのを",
          "tc": "看到砍好的木材可以幫上大家的忙，",
          "sc": "看到砍好的木材可以帮上大家的忙，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 368367,
          "spk": "四郎治 (シロージ)",
          "ja": "見るのも結構楽しいもんだよ",
          "tc": "我也覺得很開心。",
          "sc": "我也觉得很开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6238,
      "rec_id": "TALK_ID_70_0040_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368385,
          "spk": "四郎治 (シロージ)",
          "ja": "そうだ、お前に",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368392,
          "spk": "四郎治 (シロージ)",
          "ja": "狩りの手伝いをしてくれたお礼をしなくちゃな",
          "tc": "我得好好答謝你幫忙狩獵才行。",
          "sc": "我得好好答谢你帮忙狩猎才行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368403,
          "spk": "四郎治 (シロージ)",
          "ja": "だが……今はなんも持ってねえんだ",
          "tc": "但是……我現在身上什麼都沒帶。",
          "sc": "但是……我现在身上什么都没带。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368410,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>明日以降にまたここに来てくれ</strong>",
          "tc": "你等<strong>明天之後再到這裡來吧</strong>，",
          "sc": "你等<strong>明天之后再到这里来吧</strong>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 368417,
          "spk": "四郎治 (シロージ)",
          "ja": "なにか準備しておくからよ",
          "tc": "我會準備東西給你的。",
          "sc": "我会准备东西给你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6239,
      "rec_id": "TALK_ID_70_0040_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368435,
          "spk": "四郎治 (シロージ)",
          "ja": "これからはお前も",
          "tc": "從今以後，",
          "sc": "从今以后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368442,
          "spk": "四郎治 (シロージ)",
          "ja": "自力で狩りをやってみるといい",
          "tc": "你也可以靠自己狩獵看看。",
          "sc": "你也可以靠自己狩猎看看。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368453,
          "spk": "四郎治 (シロージ)",
          "ja": "獣が増えすぎると、",
          "tc": "要是野獸過度繁殖，",
          "sc": "要是野兽过度繁殖，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368460,
          "spk": "四郎治 (シロージ)",
          "ja": "獣害で村が困ることになる",
          "tc": "可能會對村子造成問題。",
          "sc": "可能会对村子造成问题。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6240,
      "rec_id": "TALK_ID_70_0040_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368483,
          "spk": "四郎治 (シロージ)",
          "ja": "山の仕事ができる奴は少ないからな",
          "tc": "很少有人能勝任山裡的工作，",
          "sc": "很少有人能胜任山里的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368490,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコのこと、手伝ってやってくれ",
          "tc": "所以你有空也去幫幫駒子吧。",
          "sc": "所以你有空也去帮帮驹子吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6241,
      "rec_id": "TALK_ID_70_0040_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368521,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃ、箱罠と獲物を回収するか……",
          "tc": "那現在把捕獸籠和獵物收回來吧……",
          "sc": "那现在把捕兽笼和猎物收回来吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368528,
          "spk": "四郎治 (シロージ)",
          "ja": "ほら、お前がやってみろ",
          "tc": "來，你試試看。",
          "sc": "来，你试试看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6242,
      "rec_id": "TALK_ID_70_0040_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368552,
          "spk": "四郎治 (シロージ)",
          "ja": "その箱罠はお前にやるよ",
          "tc": "那個捕獸籠就送給你了，",
          "sc": "那个捕兽笼就送给你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368559,
          "spk": "四郎治 (シロージ)",
          "ja": "使い方はもうわかるだろ？",
          "tc": "你已經搞懂使用方式了吧？",
          "sc": "你已经搞懂使用方式了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368566,
          "spk": "四郎治 (シロージ)",
          "ja": "置いて放置するだけだ",
          "tc": "設置好之後只要放著就行。",
          "sc": "设置好之后只要放着就行。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368577,
          "spk": "四郎治 (シロージ)",
          "ja": "……んで、獣を獲った時は、",
          "tc": "……話說，抓到野獸的時候，",
          "sc": "……话说，抓到野兽的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 368584,
          "spk": "四郎治 (シロージ)",
          "ja": "狩猟証明を書かなきゃなんねぇ",
          "tc": "還得填寫「狩獵證明」才行。",
          "sc": "还得填写“狩猎证明”才行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 368591,
          "spk": "四郎治 (シロージ)",
          "ja": "ほら、これのことだ",
          "tc": "你看，就是這個。",
          "sc": "你看，就是这个。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6243,
      "rec_id": "TALK_ID_70_0040_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368615,
          "spk": "四郎治 (シロージ)",
          "ja": "……あぁ、狩猟証明のことや",
          "tc": "……對了，",
          "sc": "……对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368622,
          "spk": "四郎治 (シロージ)",
          "ja": "報酬のことも教えてやらねえとな",
          "tc": "我還得教你「狩獵證明」和「報酬」的事。",
          "sc": "我还得教你“狩猎证明”和“报酬”的事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368633,
          "spk": "四郎治 (シロージ)",
          "ja": "一緒に、狩人詰所に帰るぞ",
          "tc": "一起回獵人哨站吧，",
          "sc": "一起回猎人哨站吧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368640,
          "spk": "四郎治 (シロージ)",
          "ja": "ついてきてくれ",
          "tc": "跟我來。",
          "sc": "跟我来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6244,
      "rec_id": "TALK_ID_70_0040_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368664,
          "spk": "四郎治 (シロージ)",
          "ja": "ここは狩人詰所という、",
          "tc": "這裡就是獵人哨站，",
          "sc": "这里就是猎人哨站，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368671,
          "spk": "四郎治 (シロージ)",
          "ja": "俺やコマコの詰め所なんだが……",
          "tc": "是我和駒子待命的地方……",
          "sc": "是我和驹子待命的地方……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368678,
          "spk": "四郎治 (シロージ)",
          "ja": "ここに狩猟証明を持ってきたら、報酬をやる",
          "tc": "帶著「狩獵證明」來這裡可以兌換「報酬」。",
          "sc": "带着“狩猎证明”来这里可以兑换“报酬”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6245,
      "rec_id": "TALK_ID_70_0040_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368694,
          "spk": "四郎治 (シロージ)",
          "ja": "手に入れた狩猟証明は、",
          "tc": "只要把手上的「狩獵證明」",
          "sc": "只要把手上的“狩猎证明”"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368701,
          "spk": "四郎治 (シロージ)",
          "ja": "この小さい箱に入れておいてくれ",
          "tc": "放進這個小箱子裡就行了。",
          "sc": "放进这个小箱子里就行了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368712,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかくだから、",
          "tc": "既然都來了，",
          "sc": "既然都来了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368719,
          "spk": "四郎治 (シロージ)",
          "ja": "さっき手に入れた証明書、入れておけよ",
          "tc": "你就把剛剛那張證明放進去吧。",
          "sc": "你就把刚刚那张证明放进去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6246,
      "rec_id": "TALK_ID_70_0040_003_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368743,
          "spk": "四郎治 (シロージ)",
          "ja": "よし、それでいい",
          "tc": "好，這樣就可以了。",
          "sc": "好，这样就可以了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368754,
          "spk": "四郎治 (シロージ)",
          "ja": "証明書を箱にいれたら……",
          "tc": "把證明放進箱子之後……",
          "sc": "把证明放进箱子之后……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6247,
      "rec_id": "TALK_ID_70_0040_003_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368779,
          "spk": "四郎治 (シロージ)",
          "ja": "獣を駆除してくれた報酬として、",
          "tc": "你幫忙驅除野獸的報酬，",
          "sc": "你帮忙驱除野兽的报酬，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368786,
          "spk": "四郎治 (シロージ)",
          "ja": "あっちに置いてある箱に",
          "tc": "會放在那邊的箱子裡。",
          "sc": "会放在那边的箱子里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368793,
          "spk": "四郎治 (シロージ)",
          "ja": "獣の素材や肉を入れておいてやる",
          "tc": "裡面有野獸的材料或肉。",
          "sc": "里面有野兽的材料或肉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368804,
          "spk": "四郎治 (シロージ)",
          "ja": "狩猟証明を箱に入れたら、",
          "tc": "把狩獵證明放進箱子裡之後，",
          "sc": "把狩猎证明放进箱子里之后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 368811,
          "spk": "四郎治 (シロージ)",
          "ja": "忘れずに報酬を持って帰るんだぞ",
          "tc": "別忘了帶走報酬喔！",
          "sc": "别忘了带走报酬啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6248,
      "rec_id": "TALK_ID_70_0040_003_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368829,
          "spk": "四郎治 (シロージ)",
          "ja": "獣を狩るには、",
          "tc": "其實要狩獵野獸，",
          "sc": "其实要狩猎野兽，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368836,
          "spk": "四郎治 (シロージ)",
          "ja": "狩猟免許が必要なんだが……",
          "tc": "必須持有「狩獵執照」……",
          "sc": "必须持有“狩猎执照”……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368843,
          "spk": "四郎治 (シロージ)",
          "ja": "……まぁ、今回のは俺達だけの秘密だ",
          "tc": "……不過，這次就當作是我們的祕密吧。",
          "sc": "……不过，这次就当作是我们的秘密吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368854,
          "spk": "四郎治 (シロージ)",
          "ja": "もっと狩りをしたければ、",
          "tc": "如果還想繼續狩獵的話，",
          "sc": "如果还想继续狩猎的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 368861,
          "spk": "四郎治 (シロージ)",
          "ja": "弓を持って狩人詰所に来るといい",
          "tc": "就帶著弓來獵人哨站吧。",
          "sc": "就带着弓来猎人哨站吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 368868,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコが免許について教えてくれるだろうよ",
          "tc": "駒子應該會負責告訴你關於「狩獵執照」的事。",
          "sc": "驹子应该会负责告诉你关于“狩猎执照”的事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6249,
      "rec_id": "TALK_ID_70_0040_003_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368886,
          "spk": "四郎治 (シロージ)",
          "ja": "……んじゃあ、",
          "tc": "……那就這樣，",
          "sc": "……那就这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368893,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は付き合わせて悪かったな",
          "tc": "今天不好意思啊，麻煩你幫忙了。",
          "sc": "今天不好意思啊，麻烦你帮忙了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368904,
          "spk": "四郎治 (シロージ)",
          "ja": "礼のこと、忘れるなよ？",
          "tc": "別忘記謝禮的事喔？",
          "sc": "别忘记谢礼的事啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368911,
          "spk": "四郎治 (シロージ)",
          "ja": "またよろしく頼むぜ",
          "tc": "下次也拜託啦。",
          "sc": "下次也拜托啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6250,
      "rec_id": "TALK_ID_70_0040_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368931,
          "spk": "四郎治 (シロージ)",
          "ja": "よし、早くいけ……",
          "tc": "好，快走吧……",
          "sc": "好，快走吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6251,
      "rec_id": "TALK_ID_70_0040_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368951,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 368962,
          "spk": "四郎治 (シロージ)",
          "ja": "これは……あれだ",
          "tc": "這是……有原因的。",
          "sc": "这是……有原因的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 368973,
          "spk": "四郎治 (シロージ)",
          "ja": "狩りすぎはよくないからな",
          "tc": "畢竟過度狩獵並不是好事，",
          "sc": "毕竟过度狩猎并不是好事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 368980,
          "spk": "四郎治 (シロージ)",
          "ja": "バランスをとってんだ",
          "tc": "所以我在維持自然界的平衡。",
          "sc": "所以我在维持自然界的平衡。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6252,
      "rec_id": "TALK_ID_70_0040_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 368998,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が獲物を逃がしたことは",
          "tc": "我把獵物放走的事，",
          "sc": "我把猎物放走的事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 369005,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコには黙っていてくれねぇか？",
          "tc": "可以幫我向駒子保密嗎？",
          "sc": "可以帮我向驹子保密吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 369016,
          "spk": "四郎治 (シロージ)",
          "ja": "ほら、これやるから",
          "tc": "來，這個給你。",
          "sc": "来，这个给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6253,
      "rec_id": "TALK_ID_70_0040_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 369040,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあな",
          "tc": "再見啦。",
          "sc": "再见啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6254,
      "rec_id": "TALK_ID_70_0040_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 369064,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、<player>",
          "tc": "咦？<player>，",
          "sc": "咦？<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 369071,
          "spk": "驹子 (コマコ)",
          "ja": "ここで何してるの？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6255,
      "rec_id": "TALK_ID_70_0040_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 369089,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、また何もかかってない",
          "tc": "咦，又是空空如也……",
          "sc": "咦，又是空空如也……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6256,
      "rec_id": "TALK_ID_70_0040_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 369107,
          "spk": "驹子 (コマコ)",
          "ja": "でも、キツネの毛が残ってる……",
          "tc": "可是上面有狐狸的毛……",
          "sc": "可是上面有狐狸的毛……"
        },
        {
          "f_idx": 1,
