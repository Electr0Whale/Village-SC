    },
    {
      "file": "talk.dat",
      "rec_idx": 6220,
      "rec_id": "TALK_ID_70_0040_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367575,
          "spk": "四郎治 (シロージ)",
          "ja": "これは……",
          "tc": "這是……",
          "sc": "这是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367582,
          "spk": "四郎治 (シロージ)",
          "ja": "お手伝い券か……",
          "tc": "「幫忙券」啊……",
          "sc": "“帮忙券”啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 367593,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、リンにお仕置きされてんのか",
          "tc": "你是被林處罰嗎？",
          "sc": "你是被林处罚吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 367600,
          "spk": "四郎治 (シロージ)",
          "ja": "一体何やらかしたんだよ",
          "tc": "你到底幹了什麼好事？",
          "sc": "你到底干了什么好事？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 367611,
          "spk": "四郎治 (シロージ)",
          "ja": "そうだな……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 367618,
          "spk": "四郎治 (シロージ)",
          "ja": "俺から頼めそうなことといえば……",
          "tc": "要說有什麼想拜託你的事……",
          "sc": "要说有什么想拜托你的事……"
        }
      ]
    },
    {
