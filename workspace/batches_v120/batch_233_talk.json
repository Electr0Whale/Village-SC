      "rec_idx": 6221,
      "rec_id": "TALK_ID_70_0040_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367636,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、狩りに興味はあるか？",
          "tc": "你對狩獵有興趣嗎？",
          "sc": "你对狩猎有兴趣吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367645,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 2,
          "pidx_tc": 367652,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6222,
      "rec_id": "TALK_ID_70_0040_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367745,
          "spk": "四郎治 (シロージ)",
          "ja": "よし、ついてきな",
          "tc": "好，跟我來吧。",
          "sc": "好，跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6223,
      "rec_id": "TALK_ID_70_0040_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367769,
          "spk": "四郎治 (シロージ)",
          "ja": "残念ながら、俺の木こりの仕事では",
          "tc": "很可惜，我這邊伐木的工作，",
          "sc": "很可惜，我这边伐木的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367776,
          "spk": "四郎治 (シロージ)",
          "ja": "お前に頼めることはないんだが……",
          "tc": "沒什麼好拜託你的……",
          "sc": "没什么好拜托你的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 367792,
          "spk": "四郎治 (シロージ)",
          "ja": "代わりにコマコの狩りを",
          "tc": "不過相對的，",
          "sc": "不过相对的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 367799,
          "spk": "四郎治 (シロージ)",
          "ja": "手伝ってやってほしいんだ",
          "tc": "我想請你幫忙駒子狩獵。",
          "sc": "我想请你帮忙驹子狩猎。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6224,
      "rec_id": "TALK_ID_70_0040_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367817,
          "spk": "四郎治 (シロージ)",
          "ja": "心配すんな、罠を使った簡単な狩りだ",
          "tc": "放心，只是利用陷阱的簡單狩獵工作，",
          "sc": "放心，只是利用陷阱的简单狩猎工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367824,
          "spk": "四郎治 (シロージ)",
          "ja": "必要なものは俺が準備するから",
          "tc": "我會把所需的東西準備好。",
          "sc": "我会把所需的东西准备好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6225,
      "rec_id": "TALK_ID_70_0040_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367842,
          "spk": "四郎治 (シロージ)",
          "ja": "あー、簡単とは言ったが……",
          "tc": "啊～雖然我說很簡單……",
          "sc": "啊～虽然我说很简单……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367853,
          "spk": "四郎治 (シロージ)",
          "ja": "狩りってのは、命の取り合いだ",
          "tc": "但狩獵畢竟是攸關生死的事，",
          "sc": "但狩猎毕竟是攸关生死的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 367860,
          "spk": "四郎治 (シロージ)",
          "ja": "小さな動物相手でも油断すんなよ",
          "tc": "就算是小動物也別大意喔！",
          "sc": "就算是小动物也别大意啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6226,
      "rec_id": "TALK_ID_70_0040_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367885,
          "spk": "四郎治 (シロージ)",
          "ja": "よし、それじゃあ",
          "tc": "好，",
          "sc": "好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367892,
          "spk": "四郎治 (シロージ)",
          "ja": "これを持ってけ",
          "tc": "這個你拿著。",
          "sc": "这个你拿着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6227,
      "rec_id": "TALK_ID_70_0040_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367916,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が昔使ってた罠だ",
          "tc": "這是我以前用過的陷阱，",
          "sc": "这是我以前用过的陷阱，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367923,
          "spk": "四郎治 (シロージ)",
          "ja": "ボロいけど、ちゃんと動くから",
          "tc": "雖然很破舊，但還可以用。",
          "sc": "虽然很破旧，但还可以用。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 367932,
          "spk": "四郎治 (シロージ)",
          "ja": "動物が通りそうな道に置くといいぜ",
          "tc": "你把它放在動物會經過的通道就好了，",
          "sc": "你把它放在动物会经过的通道就好了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 367939,
          "spk": "四郎治 (シロージ)",
          "ja": "山に入ったら、周りをよく観察するんだ",
          "tc": "進到山裡後，好好觀察四周吧。",
          "sc": "进到山里后，好好观察四周吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6228,
      "rec_id": "TALK_ID_70_0040_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367964,
          "spk": "四郎治 (シロージ)",
          "ja": "そうだな……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367971,
          "spk": "四郎治 (シロージ)",
          "ja": "試しにあの辺りに仕掛けてみろ",
          "tc": "先在那附近設置看看吧。",
