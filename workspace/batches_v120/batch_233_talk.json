    {
      "file": "talk.dat",
      "rec_idx": 6213,
      "rec_id": "TALK_ID_70_0030_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363976,
          "spk": "莲实 (ハスミ)",
          "ja": "いえ、実はキスケさんが",
          "tc": "沒什麼，其實就是木助先生喝太多，",
          "sc": "没什么，其实就是木助先生喝太多，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363983,
          "spk": "莲实 (ハスミ)",
          "ja": "酔っ払ったまま眠ってて……",
          "tc": "直接睡著了……",
          "sc": "直接睡着了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363999,
          "spk": "莲实 (ハスミ)",
          "ja": "こんなにお酒臭くなるまで呑んで……",
          "tc": "喝到這樣渾身酒氣……",
          "sc": "喝到这样浑身酒气……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364006,
          "spk": "莲实 (ハスミ)",
          "ja": "これじゃ私も――",
          "tc": "這樣的話連我也──",
          "sc": "这样的话连我也——"
        },
        {
          "f_idx": 5,
          "pidx_tc": 364017,
          "spk": "莲实 (ハスミ)",
          "ja": "って、なんでもないです",
          "tc": "不，沒什麼。",
          "sc": "不，没什么。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 364028,
          "spk": "莲实 (ハスミ)",
          "ja": "そんなことより、キスケさんのこと",
          "tc": "比起這個，",
          "sc": "比起这个，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 364035,
          "spk": "莲实 (ハスミ)",
          "ja": "起こしてあげてくれませんか？",
          "tc": "可以請你幫忙叫醒木助先生嗎？",
          "sc": "可以请你帮忙叫醒木助先生吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 364046,
          "spk": "莲实 (ハスミ)",
          "ja": "私はちょっと、その……",
          "tc": "因為我……那個……",
          "sc": "因为我……那个……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 364053,
          "spk": "莲实 (ハスミ)",
          "ja": "やることがあるので……",
          "tc": "還有其他事要做……",
          "sc": "还有其他事要做……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6214,
      "rec_id": "TALK_ID_70_0030_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364071,
          "spk": "莲实 (ハスミ)",
          "ja": "本当ですか？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364078,
          "spk": "莲实 (ハスミ)",
          "ja": "ありがとうございます",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364089,
          "spk": "莲实 (ハスミ)",
          "ja": "では、よろしくお願いしますね",
          "tc": "那就拜託你了。",
          "sc": "那就拜托你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6215,
      "rec_id": "TALK_ID_70_0030_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364113,
          "spk": "木助 (キスケ)",
          "ja": "んごっ……！",
          "tc": "齁……！",
          "sc": "呼噜……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6216,
      "rec_id": "TALK_ID_70_0030_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364131,
          "spk": "木助 (キスケ)",
          "ja": "ふわァ～～……だれらァ～～？",
          "tc": "呼啊……是隨啦～～？",
          "sc": "呼啊……是随啦～～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364138,
          "spk": "木助 (キスケ)",
          "ja": "せっかく気持ちよ～く寝てたろによ～……",
          "tc": "明明我睡得正～香的縮……",
          "sc": "明明我睡得正～香的缩……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364149,
          "spk": "木助 (キスケ)",
          "ja": "って、<player>か……",
          "tc": "呃，是<player>啊……",
          "sc": "呃，是<player>啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364156,
          "spk": "木助 (キスケ)",
          "ja": "もしかしれ、心配しれ起こしれくれたのかァ？",
          "tc": "難道泥是擔心我才把我叫醒的嗎～？",
          "sc": "难道泥是担心我才把我叫醒的吗～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6217,
      "rec_id": "TALK_ID_70_0030_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364181,
          "spk": "木助 (キスケ)",
          "ja": "へへ、あんがとなァ！",
          "tc": "嘿嘿，謝啦！",
          "sc": "嘿嘿，谢啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364192,
          "spk": "木助 (キスケ)",
          "ja": "おっとォ、そういやそうだ……",
          "tc": "對了，說起來……",
          "sc": "对了，说起来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364201,
          "spk": "木助 (キスケ)",
          "ja": "この前のよォ、落石をぶっ壊してくれら",
          "tc": "之前泥幫忙除掉了落石，",
          "sc": "之前泥帮忙除掉了落石，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364208,
          "spk": "木助 (キスケ)",
          "ja": "礼がまだだったなァ",
          "tc": "我還沒好好謝謝你來著。",
          "sc": "我还没好好谢谢你来着。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364219,
          "spk": "木助 (キスケ)",
          "ja": "まあ、俺ァ大工だから、",
          "tc": "好歹我是個木匠，",
          "sc": "好歹我是个木匠，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 364226,
          "spk": "木助 (キスケ)",
          "ja": "大工らしいやり方で礼をするぜ～～",
          "tc": "我就用木匠的方式來謝謝你吧～～",
          "sc": "我就用木匠的方式来谢谢你吧～～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 364235,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの家をもっと広くしてェとか、",
          "tc": "要是你想擴建房子，",
          "sc": "要是你想扩建房子，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 364242,
          "spk": "木助 (キスケ)",
          "ja": "家畜小屋とか、そういうのが必要なら",
          "tc": "或是想要打造畜舍之類的，",
          "sc": "或是想要打造畜舍之类的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 364249,
          "spk": "木助 (キスケ)",
          "ja": "この俺がなんろかしてやるよォ",
          "tc": "我費幫你想辦法的。",
          "sc": "我费帮你想办法的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 364258,
          "spk": "木助 (キスケ)",
          "ja": "だから、そん時ァ遠慮せずに言えよォ？",
          "tc": "所以到時候你就儘管開口吧～！",
          "sc": "所以到时候你就尽管开口吧～！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 364274,
          "spk": "主角心声/旁白/选项",
          "ja": "わかった",
          "tc": "知道了",
          "sc": "知道了"
        },
        {
          "f_idx": 12,
          "pidx_tc": 364281,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6218,
      "rec_id": "TALK_ID_70_0030_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364372,
          "spk": "木助 (キスケ)",
          "ja": "ただし、報酬は前払いらぜ",
          "tc": "不過費用要先付清啊，",
          "sc": "不过费用要先付清啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364379,
          "spk": "木助 (キスケ)",
          "ja": "しっかり覚えれおけやァ……",
          "tc": "給我記好了……",
          "sc": "给我记好了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364390,
          "spk": "木助 (キスケ)",
          "ja": "俺にシノギを頼みたいときはァ～～",
          "tc": "找我辦事的時候～～",
          "sc": "找我办事的时候～～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364397,
          "spk": "木助 (キスケ)",
          "ja": "報酬をもって俺の作業場に来るんだぞォ",
          "tc": "要準備好報酬再到我的作業場所來喔～",
          "sc": "要准备好报酬再到我的作业场所来啊～"
        }
