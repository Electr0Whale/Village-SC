      "rec_id": "TALK_ID_70_0030_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363605,
          "spk": "木助 (キスケ)",
          "ja": "ったくよぉ……",
          "tc": "真是的……",
          "sc": "真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363614,
          "spk": "木助 (キスケ)",
          "ja": "本当はだれかにああしろこうしろって",
          "tc": "我真的很不喜歡",
          "sc": "我真的很不喜欢"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363621,
          "spk": "木助 (キスケ)",
          "ja": "言うのが好きじゃねぇんだ",
          "tc": "對別人指手畫腳的。",
          "sc": "对别人指手画脚的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363632,
          "spk": "木助 (キスケ)",
          "ja": "だからこれは、頼み事じゃねえぞ",
          "tc": "所以，我這可不是委託。",
          "sc": "所以，我这可不是委托。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363639,
          "spk": "木助 (キスケ)",
          "ja": "落石は<player>が",
          "tc": "落石就等<player>",
          "sc": "落石就等<player>"
        },
        {
          "f_idx": 5,
          "pidx_tc": 363646,
          "spk": "木助 (キスケ)",
          "ja": "やりたい時に壊してくれ",
          "tc": "想清的時候再去清吧。",
          "sc": "想清的时候再去清吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6207,
      "rec_id": "TALK_ID_70_0030_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363666,
          "spk": "主角心声/旁白/选项",
          "ja": "キスケが言っていた",
          "tc": "破壞了木助說的",
          "sc": "破坏了木助说的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363673,
          "spk": "主角心声/旁白/选项",
          "ja": "大岩を破壊した！",
          "tc": "巨大岩石了！",
          "sc": "巨大岩石了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363682,
          "spk": "主角心声/旁白/选项",
          "ja": "キスケに報告しに行こう",
          "tc": "去向木助報告吧。",
          "sc": "去向木助报告吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6208,
      "rec_id": "TALK_ID_70_0030_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363702,
          "spk": "木助 (キスケ)",
          "ja": "……ん！？",
          "tc": "……啊！？",
          "sc": "……啊！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363709,
          "spk": "木助 (キスケ)",
          "ja": "もう片付いたってのか！？",
          "tc": "你已經處理好了嗎！？",
          "sc": "你已经处理好了吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363718,
          "spk": "木助 (キスケ)",
          "ja": "こいつは、驚いたな……",
          "tc": "這還真是讓人驚訝……",
          "sc": "这还真是让人惊讶……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363725,
          "spk": "木助 (キスケ)",
          "ja": "思ってたよりもずっと早いじゃねえか！",
          "tc": "你手腳比我想像中的快很多嘛！",
          "sc": "你手脚比我想像中的快很多嘛！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363732,
          "spk": "木助 (キスケ)",
          "ja": "素人の手際とは思えねえぜ！",
          "tc": "簡直不像是外行人！",
          "sc": "简直不像是外行人！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 363743,
          "spk": "木助 (キスケ)",
          "ja": "俺でももうちょっと時間がかかるってのに、",
          "tc": "就連我都還需要花更多時間，",
          "sc": "就连我都还需要花更多时间，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 363750,
          "spk": "木助 (キスケ)",
          "ja": "やっぱり、てめぇは――",
          "tc": "你這傢伙果然是──",
          "sc": "你这家伙果然是——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6209,
      "rec_id": "TALK_ID_70_0030_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363781,
          "spk": "木助 (キスケ)",
          "ja": "いや、なんでもねえよ",
          "tc": "算了，當我沒說。",
          "sc": "算了，当我没说。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363788,
          "spk": "木助 (キスケ)",
          "ja": "それより……",
          "tc": "先不說這個了……",
          "sc": "先不说这个了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363799,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは最近、野菜とか道具とか",
          "tc": "你最近不是都一直在種菜",
          "sc": "你最近不是都一直在种菜"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363806,
          "spk": "木助 (キスケ)",
          "ja": "作ってばかりだったろ？",
          "tc": "或是做道具什麼的嗎？",
          "sc": "或是做道具什么的吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363813,
          "spk": "木助 (キスケ)",
          "ja": "たまには、壊すのも気持ちいいだろ",
          "tc": "偶爾搞點破壞也挺舒服的對吧？",
          "sc": "偶尔搞点破坏也挺舒服的对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6210,
      "rec_id": "TALK_ID_70_0030_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363831,
          "spk": "木助 (キスケ)",
          "ja": "だったらなによりだ",
          "tc": "那就好。",
          "sc": "那就好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 363840,
          "spk": "木助 (キスケ)",
          "ja": "本当は俺がやらなきゃなんねえ仕事を",
          "tc": "既然你都幫我完成了",
          "sc": "既然你都帮我完成了"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363847,
          "spk": "木助 (キスケ)",
          "ja": "やってくれたんだ",
          "tc": "原本是我該做的工作，",
          "sc": "原本是我该做的工作，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363854,
          "spk": "木助 (キスケ)",
          "ja": "このお礼は必ずするぜ",
          "tc": "那我保證會給你謝禮的。",
          "sc": "那我保证会给你谢礼的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363865,
          "spk": "木助 (キスケ)",
          "ja": "ただ……あいにく、",
          "tc": "只是……很不巧，",
          "sc": "只是……很不巧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 363872,
          "spk": "木助 (キスケ)",
          "ja": "今は返せる礼が思いつかねえんだ",
          "tc": "我現在還想不到該給你什麼。",
          "sc": "我现在还想不到该给你什么。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 363883,
          "spk": "木助 (キスケ)",
          "ja": "<strong>また明日にでも、俺の作業場に来てくれ</strong>",
          "tc": "所以你<strong>明天再到我的作業場所</strong>來吧，",
          "sc": "所以你<strong>明天再到我的作业场所</strong>来吧，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 363890,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが喜ぶようなモンを",
          "tc": "我會準備好",
          "sc": "我会准备好"
        },
        {
          "f_idx": 8,
          "pidx_tc": 363897,
          "spk": "木助 (キスケ)",
          "ja": "考えておいてやるぜ",
          "tc": "能讓你高興的東西的。",
          "sc": "能让你高兴的东西的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 363906,
          "spk": "木助 (キスケ)",
          "ja": "じゃ、今回はありがとよ",
          "tc": "這次謝啦。",
          "sc": "这次谢啦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 363913,
          "spk": "木助 (キスケ)",
          "ja": "助かったぜ",
          "tc": "真是幫了大忙。",
          "sc": "真是帮了大忙。"
        }
      ]
    },
    {
