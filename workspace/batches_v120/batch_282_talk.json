        {
          "f_idx": 1,
          "pidx_tc": 217280,
          "spk": "洋 (ヨウ)",
          "ja": "あいたいよ……",
          "tc": "我好想你……",
          "sc": "我好想你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217287,
          "spk": "洋 (ヨウ)",
          "ja": "さみしいよ……ピロちゃん……",
          "tc": "我好寂寞……嗶羅……",
          "sc": "我好寂寞……哔罗……"
        }
      ]
    },
