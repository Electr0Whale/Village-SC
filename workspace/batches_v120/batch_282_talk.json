      "rec_id": "TALK_ID_10_0102_050_23_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217344,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃんのことを",
          "tc": "我一直在想",
          "sc": "我一直在想"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217351,
          "spk": "洋 (ヨウ)",
          "ja": "考えていたの……",
          "tc": "嗶羅的事……",
          "sc": "哔罗的事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217362,
          "spk": "洋 (ヨウ)",
          "ja": "まだ立ち直れていないけど……",
          "tc": "雖然我還沒有完全振作起來……",
          "sc": "虽然我还没有完全振作起来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217369,
          "spk": "洋 (ヨウ)",
          "ja": "それでも、いつもの暮らしに",
          "tc": "但得要趕快",
          "sc": "但得要赶快"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217376,
          "spk": "洋 (ヨウ)",
          "ja": "もどらなきゃね……",
          "tc": "恢復原本的生活才行……",
          "sc": "恢复原本的生活才行……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217387,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんを心配させちゃうから……",
          "tc": "不然會讓叔叔操心的……",
          "sc": "不然会让叔叔操心的……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 217394,
          "spk": "洋 (ヨウ)",
          "ja": "だから……ちゃんとしなきゃいけないよね……",
          "tc": "所以……我必須振作起來……",
          "sc": "所以……我必须振作起来……"
        }
      ]
    },
    {
