    {
      "file": "talk.dat",
      "rec_idx": 8128,
      "rec_id": "TALK_ID_10_0201_008_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225542,
          "spk": "今野 (コンノ)",
          "ja": "ウンウン！",
          "tc": "嗯，很好！",
          "sc": "嗯，很好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225549,
          "spk": "今野 (コンノ)",
          "ja": "話が早くていいですねェ！",
          "tc": "您能理解真是太好了！",
          "sc": "您能理解真是太好呐～！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 225558,
          "spk": "今野 (コンノ)",
          "ja": "しきたりを守ることが、",
          "tc": "遵守這些規矩，",
          "sc": "遵守这些规矩，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 225565,
          "spk": "今野 (コンノ)",
          "ja": "身を守ることに繋がると、",
          "tc": "就能保護自己，",
          "sc": "就能保护自己，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 225572,
          "spk": "今野 (コンノ)",
          "ja": "よくわかっていらっしゃる！",
          "tc": "您很清楚這件事啊！",
          "sc": "您很清楚这件事啊！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 225583,
          "spk": "今野 (コンノ)",
          "ja": "それでは早速……",
          "tc": "那麼事不宜遲……",
          "sc": "那么事不宜迟……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8129,
      "rec_id": "TALK_ID_10_0201_008_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225605,
          "spk": "今野 (コンノ)",
          "ja": "おやァ……？",
          "tc": "哦……？",
          "sc": "哦……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225614,
          "spk": "今野 (コンノ)",
          "ja": "アナタも、真の意味で村の一員に",
          "tc": "我本來以為您想要成為",
          "sc": "我本来以为您想要成为"
        },
        {
          "f_idx": 2,
          "pidx_tc": 225621,
          "spk": "今野 (コンノ)",
          "ja": "なってくれるかと思ったのですが……",
          "tc": "真正意義上村子的一員呢……",
          "sc": "真正意义上村子的一员呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 225632,
          "spk": "今野 (コンノ)",
          "ja": "そう反抗的だと、",
          "tc": "如果您這麼反抗，",
          "sc": "如果您这么反抗，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 225639,
          "spk": "今野 (コンノ)",
          "ja": "ワタシがリンさんにドヤされてしまう",
          "tc": "我可是會挨林小姐責罵的。",
          "sc": "我可是会挨林小姐责骂的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 225650,
          "spk": "今野 (コンノ)",
          "ja": "もう一度聞きますが……",
          "tc": "那麼重新問您一次……",
          "sc": "那么重新问您一次……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 225657,
          "spk": "今野 (コンノ)",
          "ja": "お根付け料、支払ってもらえませんか？",
          "tc": "能請您支付「生根費」嗎？",
          "sc": "能请您支付“生根费”吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 225664,
          "spk": "今野 (コンノ)",
          "ja": "ワタシのためにも払ってもらいたい所ですが",
          "tc": "就算是看在我的面子上也希望您能支付。",
          "sc": "就算是看在我的面子上也希望您能支付。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 225673,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 225680,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8130,
      "rec_id": "TALK_ID_10_0201_008_07_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225700,
          "spk": "今野 (コンノ)",
          "ja": "はい、確かに",
          "tc": "好，我確實",
          "sc": "好，我确实"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225707,
          "spk": "今野 (コンノ)",
          "ja": "お心受け取りました",
          "tc": "收下您的誠意了。",
          "sc": "收下您的诚意了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 225718,
          "spk": "今野 (コンノ)",
          "ja": "よかったですねェ！",
          "tc": "真是太好了！",
          "sc": "真是太好呐～！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 225725,
          "spk": "今野 (コンノ)",
          "ja": "これで、アナタも今夜もよく眠れて、",
          "tc": "這麼一來，您今晚也能睡得安穩，",
          "sc": "这么一来，您今晚也能睡得安稳，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 225732,
          "spk": "今野 (コンノ)",
          "ja": "朝ちゃんと目覚めることができますよォ！",
          "tc": "早上也能神清氣爽地醒來了！",
          "sc": "早上也能神清气爽地醒来哟～！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 225743,
          "spk": "今野 (コンノ)",
          "ja": "あ、話は変わりますが……",
          "tc": "那麼另外一件事……",
          "sc": "那么另外一件事……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 225750,
          "spk": "今野 (コンノ)",
          "ja": "今度、診療所で健康診断があるんですヨ",
          "tc": "之後，會在診所進行健康檢查喔。",
          "sc": "之后，会在诊所进行健康检查哟～。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 225768,
          "spk": "今野 (コンノ)",
          "ja": "アナタは対象年齢ではありませんが、",
          "tc": "雖然您的年齡並不在檢查對象中範圍內，",
          "sc": "虽然您的年龄并不在检查对象中范围内，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 225775,
          "spk": "今野 (コンノ)",
          "ja": "どうせ暇でしょう？",
          "tc": "但反正您應該很閒吧？",
          "sc": "但反正您应该很闲吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 225782,
          "spk": "今野 (コンノ)",
          "ja": "是非とも見学にいらしてくださァい",
          "tc": "還請務必來觀摩。",
          "sc": "还请务必来观摩。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8131,
      "rec_id": "TALK_ID_10_0201_008_07_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225802,
          "spk": "今野 (コンノ)",
          "ja": "……てアナタ！",
          "tc": "……等等，我說您啊！",
          "sc": "……等等，我说您啊！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225809,
          "spk": "今野 (コンノ)",
          "ja": "1000円すら持ってないのですかァ！",
          "tc": "身上連1000元也沒有啊！",
          "sc": "身上连1000元也没有啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8132,
      "rec_id": "TALK_ID_10_0201_008_08_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225827,
          "spk": "今野 (コンノ)",
          "ja": "……チッ、役立たずめ",
          "tc": "……嘖，真沒用。",
          "sc": "……啧，真没用。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8133,
      "rec_id": "TALK_ID_10_0201_008_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225845,
          "spk": "今野 (コンノ)",
          "ja": "わかりました、わかりました",
          "tc": "好好好，我明白了。",
          "sc": "好好好，我明白了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225852,
          "spk": "今野 (コンノ)",
          "ja": "じゃあアナタから",
          "tc": "那這次就放棄",
          "sc": "那这次就放弃"
        },
        {
          "f_idx": 2,
          "pidx_tc": 225859,
          "spk": "今野 (コンノ)",
          "ja": "お根付け料を取るのは諦めましょう",
          "tc": "向您收取生根費總行了吧。",
          "sc": "向您收取生根费总行了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8134,
      "rec_id": "TALK_ID_10_0201_008_08_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225875,
          "spk": "今野 (コンノ)",
          "ja": "……ところで話は変わりますが",
          "tc": "……話說回來，",
          "sc": "……话说回来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225882,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、毎日働いて体調はいかがですか？",
          "tc": "您每天工作，身體狀況還好嗎？",
          "sc": "您每天工作，身体状况还好吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 225900,
          "spk": "今野 (コンノ)",
          "ja": "生活の質を保つには、健康が第一！",
          "tc": "要維持生活品質，健康是最重要的！",
          "sc": "要维持生活品质，健康是最重要的！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 225918,
          "spk": "今野 (コンノ)",
          "ja": "体と土地の相性、巡りの具合、血の質……",
          "tc": "身體與土地的契合度、循環狀態、血液品質等……",
          "sc": "身体与土地的契合度、循环状态、血液品质等……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 225925,
          "spk": "今野 (コンノ)",
          "ja": "さまざまな要因が、",
          "tc": "各式各樣的因素",
          "sc": "各式各样的因素"
        },
        {
          "f_idx": 7,
          "pidx_tc": 225932,
          "spk": "今野 (コンノ)",
          "ja": "体に影響をもたらす可能性があるのです",
          "tc": "都可能對身體產生影響。",
          "sc": "都可能对身体产生影响。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 225943,
          "spk": "今野 (コンノ)",
          "ja": "そこでアナタには、",
          "tc": "所以我要通知您，",
          "sc": "所以我要通知您，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 225950,
          "spk": "今野 (コンノ)",
          "ja": "明日の健康診断のご案内がありまァす！",
          "tc": "明天有健康檢查！",
          "sc": "明天有健康检查！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8135,
      "rec_id": "TALK_ID_10_0201_008_08_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 225968,
          "spk": "今野 (コンノ)",
          "ja": "なに、そんな心配しなくてもいいです",
          "tc": "別怕，您不用那麼擔心，",
          "sc": "别怕，您不用那么担心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 225975,
          "spk": "今野 (コンノ)",
          "ja": "簡単な問診と、採血を行うだけですから",
          "tc": "只是簡單的問診與抽血而已。",
          "sc": "只是简单的问诊与抽血而已。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 225993,
          "spk": "今野 (コンノ)",
          "ja": "明日の朝、こちらまで呼びに参りますので",
          "tc": "明天早上我會來這裡叫您的，",
          "sc": "明天早上我会来这里叫您的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 226000,
          "spk": "今野 (コンノ)",
          "ja": "準備して待っていてくださいねェ",
          "tc": "請做好準備等我喔。",
          "sc": "请做好准备等我呐～。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 226011,
          "spk": "今野 (コンノ)",
          "ja": "ご自身の病を防ぐのも、村に住む者の義務……",
          "tc": "預防生病，也是村民的義務之一……",
          "sc": "预防生病，也是村民的义务之一……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 226018,
          "spk": "今野 (コンノ)",
          "ja": "しっかり果たしてくださァい",
          "tc": "請您務必好好履行。",
          "sc": "请您务必好好履行。"
        }
      ]
    },
