      "rec_id": "TALK_ID_10_0201_011_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227092,
          "spk": "名护 (ナゴ)",
          "ja": "ほ、本当ですか！？",
          "tc": "真、真的嗎！？",
          "sc": "真、真的吗！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227099,
          "spk": "名护 (ナゴ)",
          "ja": "ご快諾、誠にありがとうございます！",
          "tc": "十分感謝您如此欣然答應！",
          "sc": "十分感谢您如此欣然答应！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227106,
          "spk": "名护 (ナゴ)",
          "ja": "それでは早速、契約書をお持ちしますね！",
          "tc": "那麼事不宜遲，我馬上把契約書拿來！",
          "sc": "那么事不宜迟，我马上把契约书拿来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8141,
      "rec_id": "TALK_ID_10_0201_011_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227128,
          "spk": "名护 (ナゴ)",
          "ja": "即断するほど、",
          "tc": "這應該不是",
          "sc": "这应该不是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227135,
          "spk": "名护 (ナゴ)",
          "ja": "悪い話ではありませんよ？",
          "tc": "需要馬上拒絕的壞事吧？",
          "sc": "需要马上拒绝的坏事吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227142,
          "spk": "名护 (ナゴ)",
          "ja": "どうかご一考、いただけませんか？",
          "tc": "能不能請您再考慮一下？",
          "sc": "能不能请您再考虑一下？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8142,
      "rec_id": "TALK_ID_10_0202_051_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231391,
          "spk": "林 (リン)",
          "ja": "遅いわ！",
          "tc": "太慢了！",
          "sc": "太慢了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231398,
          "spk": "林 (リン)",
          "ja": "やっと起きたのね！",
          "tc": "你終於醒啦！",
          "sc": "你终于醒啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231409,
          "spk": "林 (リン)",
          "ja": "今日は、頼みがあって来たのだけれど……",
          "tc": "我今天過來是有事情想拜託你……",
          "sc": "我今天过来是有事情想拜托你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231416,
          "spk": "林 (リン)",
          "ja": "あなたには、今日がなんの日か",
          "tc": "……你應該不曉得",
          "sc": "……你应该不晓得"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231423,
          "spk": "林 (リン)",
          "ja": "わからないわよね？",
          "tc": "今天是什麼日子吧？",
          "sc": "今天是什么日子吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8143,
      "rec_id": "TALK_ID_10_0202_051_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231441,
          "spk": "林 (リン)",
          "ja": "ほら、山の方から",
          "tc": "你看看山那邊，",
          "sc": "你看看山那边，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231448,
          "spk": "林 (リン)",
          "ja": "狼煙が上がってるのが見えるでしょ",
          "tc": "有道狼煙昇起，對吧？",
          "sc": "有道狼烟升起，对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8144,
      "rec_id": "TALK_ID_10_0202_051_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231466,
          "spk": "林 (リン)",
          "ja": "狼煙が上がったら、",
          "tc": "看到狼煙，",
          "sc": "看到狼烟，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231473,
          "spk": "林 (リン)",
          "ja": "お墓へ行って、お掃除してお参りする",
          "tc": "就代表這一天是要去墓地",
          "sc": "就代表这一天是要去墓地"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231480,
          "spk": "林 (リン)",
          "ja": "墓参りの日という合図なのよ！",
          "tc": "掃墓、參拜的掃墓日！",
          "sc": "扫墓、参拜的扫墓日！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8145,
      "rec_id": "TALK_ID_10_0202_051_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231498,
          "spk": "林 (リン)",
          "ja": "昨日、寝る前に思いついたの",
          "tc": "昨天睡前我正好想到，",
          "sc": "昨天睡前我正好想到，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231514,
          "spk": "林 (リン)",
          "ja": "私たちが、お墓にお参りしている間に",
          "tc": "要是在掃墓的時候，",
          "sc": "要是在扫墓的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231521,
          "spk": "林 (リン)",
          "ja": "あなたが雑草を掃除してくれたら……",
          "tc": "你能來幫忙清除雜草的話，",
          "sc": "你能来帮忙清除杂草的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231528,
          "spk": "林 (リン)",
          "ja": "無駄な時間を、過ごさずにすむってね",
          "tc": "就能不用白白浪費時間了。",
          "sc": "就能不用白白浪费时间了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 231539,
          "spk": "林 (リン)",
          "ja": "あなたには、この地に眠る先祖はいないわ",
          "tc": "畢竟你的祖先並沒有在這裡永眠。",
          "sc": "毕竟你的祖先并没有在这里永眠。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 231546,
          "spk": "林 (リン)",
          "ja": "……でも、だからこそできることがある",
          "tc": "……但也因此，你也有你才有能做的事。",
          "sc": "……但也因此，你也有你才有能做的事。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 231564,
          "spk": "林 (リン)",
          "ja": "ということで、",
          "tc": "也就是說，",
          "sc": "也就是说，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 231571,
          "spk": "林 (リン)",
          "ja": "あなたの今日の仕事は、草むしりよ！！",
          "tc": "你今天的工作，就是除草！！",
          "sc": "你今天的工作，就是除草！！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 231582,
          "spk": "林 (リン)",
          "ja": "私たちのお墓参り、",
          "tc": "你應該願意來幫忙",
          "sc": "你应该愿意来帮忙"
        },
        {
          "f_idx": 11,
          "pidx_tc": 231589,
          "spk": "林 (リン)",
          "ja": "手伝ってくれるわよね",
          "tc": "我們的掃墓活動吧？",
          "sc": "我们的扫墓活动吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 231598,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 13,
          "pidx_tc": 231605,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8146,
      "rec_id": "TALK_ID_10_0202_051_01_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231623,
          "spk": "林 (リン)",
          "ja": "まあ、もちろん拒否権はないけどね！",
          "tc": "當然了，你並沒有拒絕的權利！",
          "sc": "当然了，你并没有拒绝的权利！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231630,
          "spk": "林 (リン)",
          "ja": "なにせ、あなたは村のために働くという契約を、",
          "tc": "畢竟你可是跟我簽訂了",
          "sc": "毕竟你可是跟我签订了"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231637,
          "spk": "林 (リン)",
          "ja": "この私と交わしたのだから！",
          "tc": "為了村子工作的契約呢！",
          "sc": "为了村子工作的契约呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231648,
          "spk": "林 (リン)",
          "ja": "さあ、来なさい！",
          "tc": "來，跟我來！",
          "sc": "来，跟我来！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231655,
          "spk": "林 (リン)",
          "ja": "やりがいに満ちた、",
          "tc": "完成這項充滿成就感的",
          "sc": "完成这项充满成就感的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 231662,
          "spk": "林 (リン)",
          "ja": "楽しい仕事に行きましょう！",
          "tc": "快樂的工作吧！",
          "sc": "快乐的工作吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8147,
      "rec_id": "TALK_ID_10_0202_051_01_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231688,
          "spk": "林 (リン)",
          "ja": "さあ！　着いたわ！",
          "tc": "好！我們到了！",
          "sc": "好！我们到了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231695,
          "spk": "林 (リン)",
          "ja": "ここが、この村を築いてきた、",
          "tc": "這裡就是沉睡著建立這村子的、",
          "sc": "这里就是沉睡着建立这村子的、"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231702,
          "spk": "林 (リン)",
          "ja": "偉大なご先祖様たちが眠る墓地よ！",
          "tc": "我們偉大祖先們的墓地！",
          "sc": "我们伟大祖先们的墓地！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231715,
          "spk": "驹子 (コマコ)",
          "ja": "でも、<player>にはここで眠る",
          "tc": "可是，<player>的祖先",
          "sc": "可是，<player>的祖先"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231722,
          "spk": "驹子 (コマコ)",
          "ja": "ご先祖様なんて、いないはずだけど……",
          "tc": "應該不在這裡才對……",
          "sc": "应该不在这里才对……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 231729,
          "spk": "驹子 (コマコ)",
          "ja": "どうして一緒に来てもらったの？",
          "tc": "為什麼也一起來了呢？",
          "sc": "为什么也一起来了呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8148,
      "rec_id": "TALK_ID_10_0202_051_01_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231747,
          "spk": "林 (リン)",
          "ja": "私たちがお参りに集中できるように、",
          "tc": "為了讓我們能專心掃墓，",
          "sc": "为了让我们能专心扫墓，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231754,
          "spk": "林 (リン)",
          "ja": "草むしりを手伝ってもらうことにしたの",
          "tc": "我拜託他來幫我們除草。",
          "sc": "我拜托他来帮我们除草。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231767,
          "spk": "驹子 (コマコ)",
          "ja": "あ……ああ……",
          "tc": "啊……這樣啊……",
          "sc": "啊……这样啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231774,
          "spk": "驹子 (コマコ)",
          "ja": "雑用を引き受けてもらうために……",
          "tc": "為了讓他做這些雜務……",
          "sc": "为了让他做这些杂务……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231787,
          "spk": "林 (リン)",
          "ja": "違うわ、大事な仕事よ！",
          "tc": "不對，這是重要的工作！",
          "sc": "不对，这是重要的工作！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 231794,
          "spk": "林 (リン)",
          "ja": "全く、人聞きが悪いったら！",
          "tc": "真是的，說得那麼難聽！",
          "sc": "真是的，说得那么难听！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8149,
      "rec_id": "TALK_ID_10_0202_051_01_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231819,
          "spk": "林 (リン)",
          "ja": "何をぼーっとしてるのかしら！",
          "tc": "你怎麼還在發呆！",
          "sc": "你怎么还在发呆！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231826,
          "spk": "林 (リン)",
          "ja": "今日という日は、限られてるのよ！",
          "tc": "今天這一天可是很有限的！",
          "sc": "今天这一天可是很有限的！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231833,
          "spk": "林 (リン)",
          "ja": "のんびりしてる場合じゃないでしょ！",
          "tc": "沒有時間拖拖拉拉的！",
          "sc": "没有时间拖拖拉拉的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8150,
      "rec_id": "TALK_ID_10_0202_051_01_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231851,
          "spk": "林 (リン)",
          "ja": "コマコも、<player>がサボらないように、",
          "tc": "駒子也要好好盯著<player>，",
          "sc": "驹子也要好好盯着<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231858,
          "spk": "林 (リン)",
          "ja": "ちゃんと目を光らせておきなさいね！",
          "tc": "別讓他偷懶喔！",
          "sc": "别让他偷懒哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231878,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん、わかった……",
          "tc": "呃、嗯，我知道了……",
          "sc": "呃、嗯，我知道了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8151,
      "rec_id": "TALK_ID_10_0202_051_01_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231896,
          "spk": "林 (リン)",
          "ja": "さあ、<player>！",
          "tc": "好了，<player>！",
          "sc": "好了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231903,
          "spk": "林 (リン)",
          "ja": "さっそく草むしりを始めてちょうだい！",
          "tc": "快點開始除草吧！",
          "sc": "快点开始除草吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8152,
      "rec_id": "TALK_ID_10_0202_051_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 231929,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 231936,
          "spk": "驹子 (コマコ)",
          "ja": "今日も朝から大変だね……",
          "tc": "今天也從一大早開始就很辛苦呢……",
          "sc": "今天也从一大早开始就很辛苦呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 231947,
          "spk": "驹子 (コマコ)",
          "ja": "私も今日は、リンに叩き起こされて",
          "tc": "我今天也是被林吵醒，",
          "sc": "我今天也是被林吵醒，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 231954,
          "spk": "驹子 (コマコ)",
          "ja": "連れてこられたんだよ",
          "tc": "硬是被一起帶過來的。",
          "sc": "硬是被一起带过来的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 231965,
          "spk": "驹子 (コマコ)",
          "ja": "このあたりは危ない獣もよく出るから、",
          "tc": "這附近常有危險的野獸出沒，",
          "sc": "这附近常有危险的野兽出没，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 231972,
          "spk": "驹子 (コマコ)",
          "ja": "いざという時は、",
          "tc": "所以萬一發生狀況，",
          "sc": "所以万一发生状况，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 231979,
          "spk": "驹子 (コマコ)",
          "ja": "私が追い払わないといけないんだ",
          "tc": "我就必須趕走牠們才行。",
          "sc": "我就必须赶走它们才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8153,
      "rec_id": "TALK_ID_10_0202_051_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232005,
          "spk": "驹子 (コマコ)",
          "ja": "私も後で、お母さんとお父さんに",
          "tc": "我等一下也得去祭拜",
          "sc": "我等一下也得去祭拜"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232012,
          "spk": "驹子 (コマコ)",
          "ja": "お参りしなきゃいけないんだけど……",
          "tc": "爸爸媽媽，可是……",
          "sc": "爸爸妈妈，可是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232021,
          "spk": "驹子 (コマコ)",
          "ja": "私、両親のことは全然覚えていなくて、",
          "tc": "我幾乎不記得他們的事情了，",
          "sc": "我几乎不记得他们的事情了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232028,
          "spk": "驹子 (コマコ)",
          "ja": "なんて祈ればいいのか、わからないの……",
          "tc": "不知道該對他們祈禱什麼才好……",
          "sc": "不知道该对他们祈祷什么才好……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232039,
          "spk": "驹子 (コマコ)",
          "ja": "だから実を言うと、",
          "tc": "所以老實說，",
          "sc": "所以老实说，"
        },
        {
          "f_idx": 5,
