        {
          "f_idx": 0,
          "pidx_tc": 216327,
          "spk": "林 (リン)",
          "ja": "そう……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216334,
          "spk": "林 (リン)",
          "ja": "気に病まないで",
          "tc": "你別太放在心上了。",
          "sc": "你别太放在心上了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216341,
          "spk": "林 (リン)",
          "ja": "わからなくて当然よ",
          "tc": "沒印象也是理所當然的。",
          "sc": "没印象也是理所当然的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8109,
      "rec_id": "TALK_ID_10_0102_050_20_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 216955,
          "spk": "裕太 (ユータ)",
          "ja": "噂は聞いたよ、",
          "tc": "我都聽說了，",
          "sc": "我都听说了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216962,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんのニワトリが",
          "tc": "小洋的雞",
          "sc": "小洋的鸡"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216969,
          "spk": "裕太 (ユータ)",
          "ja": "殺されていたんだって？",
          "tc": "遭到殺害了，對吧？",
          "sc": "遭到杀害了，对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 216980,
          "spk": "裕太 (ユータ)",
          "ja": "村の誰がそんなことを……",
          "tc": "到底是村子裡的誰做出了……",
          "sc": "到底是村子里的谁做出了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 216987,
          "spk": "裕太 (ユータ)",
          "ja": "いや……ありえないよね、",
          "tc": "不對……這不可能。",
          "sc": "不对……这不可能。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 216994,
          "spk": "裕太 (ユータ)",
          "ja": "村の人たちはみんないい人だから……",
          "tc": "因為村子裡的大家都是好人……",
          "sc": "因为村子里的大家都是好人……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8110,
      "rec_id": "TALK_ID_10_0102_050_20_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217020,
          "spk": "裕太 (ユータ)",
          "ja": "きっと、村の外の人がやったんだろう……",
          "tc": "一定是村外的人幹的吧……",
          "sc": "一定是村外的人干的吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217027,
          "spk": "裕太 (ユータ)",
          "ja": "どうしてあんなことが、",
          "tc": "到底為什麼",
          "sc": "到底为什么"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217034,
          "spk": "裕太 (ユータ)",
          "ja": "できるんだろうね……",
          "tc": "能做出那種事……？",
          "sc": "能做出那种事……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8111,
      "rec_id": "TALK_ID_10_0102_050_21_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217060,
          "spk": "四郎治 (シロージ)",
          "ja": "お前じゃないよな、",
          "tc": "應該不是你",
          "sc": "应该不是你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217067,
          "spk": "四郎治 (シロージ)",
          "ja": "掟をやぶったのは",
          "tc": "打破了規矩吧？",
          "sc": "打破了规矩吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217078,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217085,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウ自身の身に、",
          "tc": "幸好洋本人",
          "sc": "幸好洋本人"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217092,
          "spk": "四郎治 (シロージ)",
          "ja": "何も起きなくてよかったよ",
          "tc": "沒發生什麼事。",
          "sc": "没发生什么事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8112,
      "rec_id": "TALK_ID_10_0102_050_22_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217118,
          "spk": "木助 (キスケ)",
          "ja": "聞いたぜ、",
          "tc": "我都聽說了，",
          "sc": "我都听说了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217125,
          "spk": "木助 (キスケ)",
          "ja": "ヨウのニワトリの件",
          "tc": "洋的雞那件事。",
          "sc": "洋的鸡那件事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217136,
          "spk": "木助 (キスケ)",
          "ja": "まさか……てめぇがニワトリを",
          "tc": "該不會……是你這傢伙",
          "sc": "该不会……是你这家伙"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217143,
          "spk": "木助 (キスケ)",
          "ja": "やったワケじゃねえよな",
          "tc": "把雞給殺了吧？",
          "sc": "把鸡给杀了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217154,
          "spk": "木助 (キスケ)",
          "ja": "なんて、冗談だよ、冗談！",
          "tc": "沒事，我只是開個玩笑！",
          "sc": "没事，我只是开个玩笑！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217161,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも気に病むんじゃねえぞ！",
          "tc": "你也別太消沉了！",
          "sc": "你也别太消沉了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8113,
      "rec_id": "TALK_ID_10_0102_050_22_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217187,
          "spk": "木助 (キスケ)",
          "ja": "きっと、山の獣が悪さしたんだろ",
          "tc": "一定是山裡的野獸搞的鬼。",
          "sc": "一定是山里的野兽搞的鬼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217194,
          "spk": "木助 (キスケ)",
          "ja": "ああいう弱い生き物から、",
          "tc": "牠們就是會從那種弱小動物",
          "sc": "它们就是会从那种弱小动物"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217201,
          "spk": "木助 (キスケ)",
          "ja": "取って食われちまうんだ",
          "tc": "開始吃起嘛。",
          "sc": "开始吃起嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8114,
      "rec_id": "TALK_ID_10_0102_050_23_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217227,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん……",
          "tc": "嗶羅……",
          "sc": "哔罗……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217234,
          "spk": "洋 (ヨウ)",
          "ja": "やっとニワトリになれたのに……",
          "tc": "牠好不容易才長大成雞的……",
          "sc": "它好不容易才长大成鸡的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217245,
          "spk": "洋 (ヨウ)",
          "ja": "わたしのせい……なの……？",
          "tc": "都是……我的錯……嗎？",
          "sc": "都是……我的错……吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
