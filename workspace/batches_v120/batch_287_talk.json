          "f_idx": 3,
          "pidx_tc": 382377,
          "spk": "洋 (ヨウ)",
          "ja": "でもね？",
          "tc": "但是啊，",
          "sc": "但是啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382384,
          "spk": "洋 (ヨウ)",
          "ja": "お箸が上手く使えるようになって、",
          "tc": "開始變得比較會用筷子，",
