    {
      "file": "talk.dat",
      "rec_idx": 8427,
      "rec_id": "TALK_ID_70_2120_009_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438295,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱり、カカシには名前は付けたくなるよね！",
          "tc": "果然就是會想幫稻草人取名字對吧！",
          "sc": "果然就是会想帮稻草人取名字对吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438302,
          "spk": "裕太 (ユータ)",
          "ja": "キミがわかってくれて嬉しいな",
          "tc": "我好開心你也懂。",
          "sc": "我好开心你也懂。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438313,
          "spk": "裕太 (ユータ)",
          "ja": "彼はいつも俺の畑を監督してくれているから",
          "tc": "他總是在幫我看管農田，",
          "sc": "他总是在帮我看管农田，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438320,
          "spk": "裕太 (ユータ)",
          "ja": "そう呼んでいるんだよ",
          "tc": "所以我就這麼稱呼他。",
          "sc": "所以我就这么称呼他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8428,
      "rec_id": "TALK_ID_70_2120_009_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438338,
          "spk": "裕太 (ユータ)",
          "ja": "えっ……！",
          "tc": "咦……！？",
          "sc": "咦……！？"
