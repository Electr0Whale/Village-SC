          "f_idx": 4,
          "pidx_tc": 438370,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだからキミも、名前つけてみなよ",
          "tc": "既然都有稻草人了，也幫他們取個名字吧。",
          "sc": "既然都有稻草人了，也帮他们取个名字吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8429,
      "rec_id": "TALK_ID_70_2120_010_09_01",
      "lines": [
        {
