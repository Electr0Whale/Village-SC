        },
        {
          "f_idx": 5,
          "pidx_tc": 382391,
          "spk": "洋 (ヨウ)",
          "ja": "きれいにお魚を食べられるようになったら……",
          "tc": "能把魚吃得很乾淨之後……",
          "sc": "能把鱼吃得很干净之后……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 382402,
          "spk": "洋 (ヨウ)",
          "ja": "急にお魚のこと、",
          "tc": "就突然覺得",
          "sc": "就突然觉得"
        },
        {
          "f_idx": 7,
          "pidx_tc": 382409,
          "spk": "洋 (ヨウ)",
          "ja": "美味しく感じられるようになったんだ",
          "tc": "魚變得比以前好吃了。",
          "sc": "鱼变得比以前好吃了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 382420,
          "spk": "洋 (ヨウ)",
          "ja": "なんでなんだろうね？",
          "tc": "為什麼會這樣呢？",
          "sc": "为什么会这样呢？"
        }
      ]
    },
