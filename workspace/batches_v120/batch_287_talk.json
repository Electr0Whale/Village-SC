      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413085,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、<player>もそうだって",
          "tc": "看吧，<player>也這麼說。",
          "sc": "看吧，<player>也这么说。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413092,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱりナゴさんしかいないですよ",
          "tc": "果然非名護哥莫屬了。",
          "sc": "果然非名护哥莫属了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8402,
      "rec_id": "TALK_ID_70_2100_003_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413110,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんの意見は",
          "tc": "<player>好像",
          "sc": "<player>好像"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413117,
          "spk": "名护 (ナゴ)",
          "ja": "違うみたいだけど？",
          "tc": "不這麼認為喔！",
          "sc": "不这么认为哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8403,
      "rec_id": "TALK_ID_70_2100_003_08_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 413135,
          "spk": "堇怜 (スミレ)",
          "ja": "ええー？",
          "tc": "怎麼這樣～？",
          "sc": "怎么这样～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 413142,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の言うことを酔ったキスケさんが",
          "tc": "我說的話，醉醺醺的木助哥",
          "sc": "我说的话，醉醺醺的木助哥"
        },
        {
          "f_idx": 2,
          "pidx_tc": 413149,
          "spk": "堇怜 (スミレ)",
          "ja": "聞いてくれるわけないじゃん",
          "tc": "是不可能聽得進去的吧。",
          "sc": "是不可能听得进去的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8404,
      "rec_id": "TALK_ID_70_2100_007_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415395,
          "spk": "名护 (ナゴ)",
          "ja": "よかった……",
          "tc": "太好了……",
          "sc": "太好了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415402,
          "spk": "名护 (ナゴ)",
          "ja": "人に出せる完成度になってたか",
          "tc": "我本來很擔心成品",
          "sc": "我本来很担心成品"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415409,
          "spk": "名护 (ナゴ)",
          "ja": "心配だったんだ",
          "tc": "不足以端上桌呢。",
          "sc": "不足以端上桌呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415418,
          "spk": "名护 (ナゴ)",
          "ja": "せっかくの客人に",
          "tc": "畢竟難得有客人，",
          "sc": "毕竟难得有客人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 415425,
          "spk": "名护 (ナゴ)",
          "ja": "失礼を働くワケにもいかないからな",
          "tc": "總不能做出失禮的舉動吧。",
          "sc": "总不能做出失礼的举动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8405,
      "rec_id": "TALK_ID_70_2100_007_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415447,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……よかった",
          "tc": "是嗎……太好了。",
          "sc": "是吗……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415454,
          "spk": "名护 (ナゴ)",
          "ja": "苦労して作ったかいがあった",
          "tc": "努力做料理也算值得了。",
          "sc": "努力做料理也算值得了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415463,
          "spk": "名护 (ナゴ)",
          "ja": "……人に料理を作る喜びが",
          "tc": "為別人做料理的喜悅……",
          "sc": "为别人做料理的喜悦……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415470,
          "spk": "名护 (ナゴ)",
          "ja": "少しわかった気がするよ",
          "tc": "我好像稍微能理解了。",
          "sc": "我好像稍微能理解了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8406,
      "rec_id": "TALK_ID_70_2100_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415823,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……！",
          "tc": "真的嗎……！",
          "sc": "真的吗……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 415830,
          "spk": "名护 (ナゴ)",
          "ja": "うんうん、そうだよな",
          "tc": "嗯嗯，我想也是！",
          "sc": "嗯嗯，我想也是！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415839,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんにも",
          "tc": "既然<player>也很喜歡，",
          "sc": "既然<player>也很喜欢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415846,
          "spk": "名护 (ナゴ)",
          "ja": "気に入ってもらえたみたいで、何よりだ",
          "tc": "那真是太好了。",
          "sc": "那真是太好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8407,
      "rec_id": "TALK_ID_70_2100_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 415864,
          "spk": "名护 (ナゴ)",
          "ja": "何だ？　微妙な反応だな……",
          "tc": "怎麼了？好微妙的反應……",
          "sc": "怎么了？好微妙的反应……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 415882,
          "spk": "名护 (ナゴ)",
          "ja": "もしかして、梅が嫌いだったか？",
          "tc": "你該不會……不喜歡梅子？",
          "sc": "你该不会……不喜欢梅子？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 415889,
          "spk": "名护 (ナゴ)",
          "ja": "なら、鮭茶漬けを作ろうか？",
          "tc": "那要換成鮭魚茶泡飯嗎？",
          "sc": "那要换成三文鱼茶泡饭吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8408,
      "rec_id": "TALK_ID_70_2100_009_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 416244,
          "spk": "名护 (ナゴ)",
          "ja": "おっ？",
          "tc": "哦？",
          "sc": "哦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 416251,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんの好みに、あってたみたいだな",
          "tc": "看來有合<player>的口味呢。",
          "sc": "看来有合<player>的口味呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 416262,
          "spk": "名护 (ナゴ)",
          "ja": "たくさんあるから、どんどん食べてくれ",
          "tc": "還有很多，儘管吃吧。",
          "sc": "还有很多，尽管吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8409,
      "rec_id": "TALK_ID_70_2100_009_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 416287,
          "spk": "名护 (ナゴ)",
          "ja": "パクパク食べてくれるけど",
          "tc": "看你一口接一口的，",
          "sc": "看你一口接一口的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 416294,
          "spk": "名护 (ナゴ)",
          "ja": "そんなに気に入ったか？",
          "tc": "有這麼好吃啊？",
          "sc": "有这么好吃啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 416305,
          "spk": "名护 (ナゴ)",
          "ja": "この味がわかるとは、「通」だな",
          "tc": "竟然懂得欣賞這個味道，你很內行呢。",
          "sc": "竟然懂得欣赏这个味道，你很内行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8410,
      "rec_id": "TALK_ID_70_2100_010_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417083,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417090,
          "spk": "名护 (ナゴ)",
          "ja": "当面その気はないってことか",
          "tc": "至少目前沒有這個打算啊。",
          "sc": "至少目前没有这个打算啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417099,
          "spk": "名护 (ナゴ)",
          "ja": "じゃあ、これからもよろしくな",
          "tc": "那今後也請多多指教了，",
          "sc": "那今后也请多多指教了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417106,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん",
          "tc": "<player>。",
          "sc": "<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8411,
      "rec_id": "TALK_ID_70_2100_010_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417122,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417129,
          "spk": "名护 (ナゴ)",
          "ja": "少し寂しいけど、キミ自身が",
          "tc": "雖然有點寂寞，",
          "sc": "虽然有点寂寞，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417136,
          "spk": "名护 (ナゴ)",
          "ja": "決断したことだ",
          "tc": "但這是你自己做出的決定。",
          "sc": "但这是你自己做出的决定。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417145,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、その意思を尊重するよ",
          "tc": "我會尊重你的想法的。",
          "sc": "我会尊重你的想法的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8412,
      "rec_id": "TALK_ID_70_2110_007_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381369,
          "spk": "洋 (ヨウ)",
          "ja": "あ……",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381376,
          "spk": "洋 (ヨウ)",
          "ja": "もしかして<player>は辛いほうが好き？",
          "tc": "難道說<player>比較喜歡吃辣？",
          "sc": "难道说<player>比较喜欢吃辣？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381387,
          "spk": "洋 (ヨウ)",
          "ja": "ごめんね",
          "tc": "對不起喔！",
          "sc": "对不起哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381394,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが甘口のカレーしか食べれないから",
          "tc": "因為我只能吃偏甜的咖哩，",
          "sc": "因为我只能吃偏甜的咖喱，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381405,
          "spk": "洋 (ヨウ)",
          "ja": "だからおじちゃんも、",
          "tc": "所以叔叔也總是",
          "sc": "所以叔叔也总是"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381412,
          "spk": "洋 (ヨウ)",
          "ja": "いつもカレーは甘口で作ってくれるの",
          "tc": "做甜甜的咖哩給我吃。",
          "sc": "做甜甜的咖喱给我吃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8413,
      "rec_id": "TALK_ID_70_2110_007_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381430,
          "spk": "洋 (ヨウ)",
          "ja": "でも美味しい？",
          "tc": "但還是好吃？",
          "sc": "但还是好吃？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381441,
          "spk": "洋 (ヨウ)",
          "ja": "よかった",
          "tc": "太好了。",
          "sc": "太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381448,
          "spk": "洋 (ヨウ)",
          "ja": "自分が好きな物を友達も好きって言ってくれると",
          "tc": "自己喜歡的東西連朋友也說喜歡，",
          "sc": "自己喜欢的东西连朋友也说喜欢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381455,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、とっても嬉しいね",
          "tc": "總覺得讓人很高興呢。",
          "sc": "总觉得让人很高兴呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8414,
      "rec_id": "TALK_ID_70_2110_007_03_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381473,
          "spk": "洋 (ヨウ)",
          "ja": "えへへ、お口に合ってよかったです",
          "tc": "嘿嘿，還好合你的口味。",
          "sc": "嘿嘿，还好合你的口味。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381480,
          "spk": "洋 (ヨウ)",
          "ja": "作ったのは、おじちゃんなんだけど……",
          "tc": "雖然咖哩是叔叔做的……",
          "sc": "虽然咖喱是叔叔做的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381491,
          "spk": "洋 (ヨウ)",
          "ja": "わたしもお野菜とか切るの",
          "tc": "但我也有稍微幫忙",
          "sc": "但我也有稍微帮忙"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381498,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ手伝ったから",
          "tc": "切蔬菜之類的。",
          "sc": "切蔬菜之类的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381509,
          "spk": "洋 (ヨウ)",
          "ja": "だから、このおこさまカレーは",
          "tc": "所以這個兒童咖哩",
          "sc": "所以这个儿童咖喱"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381516,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんとわたしの合作なの",
          "tc": "是叔叔和我一起做的。",
          "sc": "是叔叔和我一起做的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8415,
      "rec_id": "TALK_ID_70_2110_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381862,
          "spk": "洋 (ヨウ)",
          "ja": "うん、優しいよ",
          "tc": "嗯，很溫柔喔。",
          "sc": "嗯，很温柔哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381869,
          "spk": "洋 (ヨウ)",
          "ja": "優しい思い出を思い出すから……",
          "tc": "會讓人想起溫柔的回憶……",
          "sc": "会让人想起温柔的回忆……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381880,
          "spk": "洋 (ヨウ)",
          "ja": "はじめて食べたのは、",
          "tc": "我第一次吃到，",
          "sc": "我第一次吃到，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 381887,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがもっと小さい時なんだけど……",
          "tc": "是在我更小的時候……",
          "sc": "是在我更小的时候……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 381898,
          "spk": "洋 (ヨウ)",
          "ja": "その時わたし、風邪を引いちゃってたの",
          "tc": "當時我得了感冒……",
          "sc": "当时我得了感冒……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 381909,
          "spk": "洋 (ヨウ)",
          "ja": "喉が痛くて、苦しくて",
          "tc": "還記得那時喉嚨很痛、很難受，",
          "sc": "还记得那时喉咙很痛、很难受，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 381916,
          "spk": "洋 (ヨウ)",
          "ja": "なんにも食べられないのが辛くて",
          "tc": "因為什麼都吃不下",
          "sc": "因为什么都吃不下"
        },
        {
          "f_idx": 7,
          "pidx_tc": 381923,
          "spk": "洋 (ヨウ)",
          "ja": "泣きそうになってたのを憶えてる",
          "tc": "難過得快要哭出來了。",
          "sc": "难过得快要哭出来了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 381934,
          "spk": "洋 (ヨウ)",
          "ja": "そんな時にね",
          "tc": "就在那個時候啊，",
          "sc": "就在那个时候啊，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 381941,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが作ってくれたのが、",
          "tc": "叔叔做給我吃的，",
          "sc": "叔叔做给我吃的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 381948,
          "spk": "洋 (ヨウ)",
          "ja": "この牛乳寒天なの",
          "tc": "就是這個牛奶寒天凍。",
          "sc": "就是这个牛奶寒天冻。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 381959,
          "spk": "洋 (ヨウ)",
          "ja": "冷たくて、甘くて、するって食べられて",
          "tc": "又冰涼又甜，口感很滑溜，",
          "sc": "又冰凉又甜，口感很滑溜，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 381966,
          "spk": "洋 (ヨウ)",
          "ja": "風邪だって、すぐに治っちゃった",
          "tc": "連感冒都馬上就治好了。",
          "sc": "连感冒都马上就治好了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 381984,
          "spk": "洋 (ヨウ)",
          "ja": "それから、わたし",
          "tc": "從那之後，",
          "sc": "从那之后，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 381991,
          "spk": "洋 (ヨウ)",
          "ja": "牛乳寒天のこと大好きになっちゃったの",
          "tc": "我就變得最喜歡吃牛奶寒天凍了。",
          "sc": "我就变得最喜欢吃牛奶寒天冻了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8416,
      "rec_id": "TALK_ID_70_2110_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382013,
          "spk": "洋 (ヨウ)",
          "ja": "わたしは、甘い味が好きだから……",
          "tc": "因為我很喜歡甜甜的味道……",
          "sc": "因为我很喜欢甜甜的味道……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382024,
          "spk": "洋 (ヨウ)",
          "ja": "甘口のカレーも好きだし、",
          "tc": "所以我喜歡吃甜甜的咖哩，",
          "sc": "所以我喜欢吃甜甜的咖喱，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 382031,
          "spk": "洋 (ヨウ)",
          "ja": "牛乳寒天も好きだし、",
          "tc": "也喜歡吃牛奶寒天凍，",
          "sc": "也喜欢吃牛奶寒天冻，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 382038,
          "spk": "洋 (ヨウ)",
          "ja": "あとは苺のショートケーキも大好きなの",
          "tc": "最喜歡的還有草莓奶油蛋糕。",
          "sc": "最喜欢的还有草莓奶油蛋糕。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 382049,
          "spk": "洋 (ヨウ)",
          "ja": "でも、ケーキは誕生日の時の",
          "tc": "但是蛋糕要等到",
          "sc": "但是蛋糕要等到"
        },
        {
          "f_idx": 5,
          "pidx_tc": 382056,
          "spk": "洋 (ヨウ)",
          "ja": "年に一度のとっておきだから……",
          "tc": "一年一次的生日才能吃……",
          "sc": "一年一次的生日才能吃……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 382067,
          "spk": "洋 (ヨウ)",
          "ja": "その時は、<player>も一緒に食べようね",
          "tc": "到時候<player>也一起吃吧。",
          "sc": "到时候<player>也一起吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8417,
      "rec_id": "TALK_ID_70_2110_009_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 382291,
          "spk": "洋 (ヨウ)",
          "ja": "わたしもお魚、好きなんだ",
          "tc": "我也很喜歡吃魚。",
          "sc": "我也很喜欢吃鱼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 382298,
          "spk": "洋 (ヨウ)",
          "ja": "塩焼きもだけど、煮つけとかも好き",
          "tc": "除了鹽烤，也喜歡用燉的。",
          "sc": "除了盐烤，也喜欢用炖的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 382309,
          "spk": "洋 (ヨウ)",
          "ja": "……これを言うと、大人のひとは",
