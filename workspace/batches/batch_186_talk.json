  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4187,
      "rec_id": "TALK_ID_10_0301_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 242366,
          "spk": "名护 (ナゴ)",
          "ja": "う……",
          "tc": "嗚……",
          "sc": "呜……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 242379,
          "spk": "茶梅 (サザンカ)",
          "ja": "お、起きた",
          "tc": "哦，醒來了。",
          "sc": "哦，醒来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 242386,
          "spk": "茶梅 (サザンカ)",
          "ja": "今日はジョウロ、いらなかったね",
          "tc": "看來今天不需要澆水壺呢。",
          "sc": "看来今天不需要浇水壶呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 242397,
          "spk": "名护 (ナゴ)",
          "ja": "こ、ここはどこだ……",
          "tc": "這、這裡是哪裡……？",
          "sc": "这、这里是哪里……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 242406,
          "spk": "名护 (ナゴ)",
          "ja": "なにも見えん……",
          "tc": "什麼都看不到……",
          "sc": "什么都看不到……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 242413,
          "spk": "名护 (ナゴ)",
          "ja": "め、メガネ……メガネは……",
          "tc": "眼、眼鏡……我的眼鏡呢……",
          "sc": "眼、眼镜……我的眼镜呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 242424,
          "spk": "林 (リン)",
          "ja": "ここは彼ヶ津村の辻よ",
          "tc": "這裡是彼津村的岔路。",
          "sc": "这里是彼津村的岔路。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 242437,
          "spk": "名护 (ナゴ)",
          "ja": "彼ヶ津……",
          "tc": "彼津……",
          "sc": "彼津……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 242450,
          "spk": "茶梅 (サザンカ)",
          "ja": "メガネ、ない方がイケメンじゃん",
          "tc": "你不戴眼鏡反而比較帥啊。",
          "sc": "你不戴眼镜反而比较帅啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 242457,
          "spk": "茶梅 (サザンカ)",
          "ja": "そのままでいれば？",
          "tc": "乾脆就不要戴眼鏡了吧？",
          "sc": "干脆就不要戴眼镜了吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 242470,
          "spk": "名护 (ナゴ)",
          "ja": "な、なにも見えないんだよ……",
          "tc": "我會什麼都看不見啊……",
          "sc": "我会什么都看不见啊……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 242481,
          "spk": "名护 (ナゴ)",
          "ja": "それより俺は、",
          "tc": "更重要的是，",
          "sc": "更重要的是，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 242488,
          "spk": "名护 (ナゴ)",
          "ja": "また村に戻って来てしまったのか……",
          "tc": "我又回到村子了嗎……",
          "sc": "我又回到村子了吗……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 242497,
          "spk": "名护 (ナゴ)",
          "ja": "……クソッ",
          "tc": "……可惡！",
          "sc": "……可恶！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 242510,
          "spk": "茶梅 (サザンカ)",
          "ja": "なにがあったのさ",
          "tc": "發生了什麼事？",
          "sc": "发生了什么事？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 242523,
          "spk": "名护 (ナゴ)",
          "ja": "土地買い付けの成功を報告しに、",
          "tc": "我原本是想下山去報告",
          "sc": "我原本是想下山去报告"
        },
        {
          "f_idx": 16,
          "pidx_tc": 242530,
          "spk": "名护 (ナゴ)",
          "ja": "山を降りようとしたのだが……",
          "tc": "成功收購土地的消息，但是……",
          "sc": "成功收购土地的消息，但是……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 242546,
          "spk": "名护 (ナゴ)",
          "ja": "なんど挑戦しても、",
          "tc": "無論我嘗試多少次，",
          "sc": "无论我尝试多少次，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 242553,
          "spk": "名护 (ナゴ)",
          "ja": "また村へ戻って来てしまうんだよ……",
          "tc": "最終都會回到這個村子……",
          "sc": "最终都会回到这个村子……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 242564,
          "spk": "名护 (ナゴ)",
          "ja": "うう……あのトバリって子の",
          "tc": "唔……我明明照著那個叫帷的",
          "sc": "唔……我明明照着那个叫帷的"
        },
        {
          "f_idx": 21,
          "pidx_tc": 242571,
          "spk": "名护 (ナゴ)",
          "ja": "言う通りにしているのに、どうして……",
          "tc": "說法去做了，為什麼還是……",
          "sc": "说法去做了，为什么还是……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 242582,
          "spk": "名护 (ナゴ)",
          "ja": "そういえば……！",
          "tc": "對了……！",
          "sc": "对了……！"
        },
        {
          "f_idx": 23,
          "pidx_tc": 242589,
          "spk": "名护 (ナゴ)",
          "ja": "あの子はどこへ……大丈夫なのか！？",
          "tc": "那個女孩在哪裡……她沒事吧！？",
          "sc": "那个女孩在哪里……她没事吧！？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 242602,
          "spk": "林 (リン)",
          "ja": "……はぁ？",
          "tc": "……啊？",
          "sc": "……啊？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 242609,
          "spk": "林 (リン)",
          "ja": "トバリだったら、",
          "tc": "你是指帷的話，",
          "sc": "你是指帷的话，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 242616,
          "spk": "林 (リン)",
          "ja": "とっくに家に帰っているわよ？",
          "tc": "她早就回到家裡囉？",
          "sc": "她早就回到家里了吧？"
        },
        {
          "f_idx": 27,
          "pidx_tc": 242627,
          "spk": "林 (リン)",
          "ja": "それよりもしかして……",
          "tc": "難道說……",
          "sc": "难道说……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 242634,
          "spk": "林 (リン)",
          "ja": "あなた、麓の街へ帰る時に、",
          "tc": "你回山腳的城市時，",
          "sc": "你回山脚的城市时，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 242641,
          "spk": "林 (リン)",
          "ja": "なにか失くしたりしてないかしら？",
          "tc": "弄丟了什麼東西吧？",
          "sc": "弄丢了什么东西吧？"
        },
        {
          "f_idx": 30,
          "pidx_tc": 242654,
          "spk": "名护 (ナゴ)",
          "ja": "ああ……そういえば",
          "tc": "啊……妳這麼一說，",
          "sc": "啊……你这么一说，"
        },
        {
          "f_idx": 31,
          "pidx_tc": 242661,
          "spk": "名护 (ナゴ)",
          "ja": "財布を……",
          "tc": "我的錢包……",
          "sc": "我的钱包……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 242674,
          "spk": "林 (リン)",
          "ja": "……全く",
          "tc": "……真是的，",
          "sc": "……真是的，"
        },
        {
          "f_idx": 33,
          "pidx_tc": 242681,
          "spk": "林 (リン)",
          "ja": "やってくれたわね",
          "tc": "這下可好了。",
          "sc": "这下可好了。"
        },
        {
          "f_idx": 34,
          "pidx_tc": 242690,
          "spk": "林 (リン)",
          "ja": "あなたが村から出られないのは多分、",
          "tc": "你之所以無法離開村子，",
          "sc": "你之所以无法离开村子，"
        },
        {
          "f_idx": 35,
          "pidx_tc": 242697,
          "spk": "林 (リン)",
          "ja": "その大切な財布を無くしたからよ",
          "tc": "大概就是因為弄丟了那個重要的錢包吧。",
          "sc": "大概就是因为弄丢了那个重要的钱包吧。"
        },
        {
          "f_idx": 37,
          "pidx_tc": 242717,
          "spk": "名护 (ナゴ)",
          "ja": "それは、なんの関係があるんだ……",
          "tc": "這有什麼關聯嗎……",
          "sc": "这有什么关联吗……"
        },
        {
          "f_idx": 38,
          "pidx_tc": 242730,
          "spk": "林 (リン)",
          "ja": "……よかったわね",
          "tc": "……高興吧，",
          "sc": "……高兴吧，"
        },
        {
          "f_idx": 39,
          "pidx_tc": 242737,
          "spk": "林 (リン)",
          "ja": "これであなたも村の一員よ",
          "tc": "這下你也是這村子的一員了。",
          "sc": "这下你也是这村子的一员了。"
        },
        {
          "f_idx": 40,
          "pidx_tc": 242750,
          "spk": "名护 (ナゴ)",
          "ja": "は……",
          "tc": "啊……？",
          "sc": "啊……？"
        },
        {
          "f_idx": 41,
          "pidx_tc": 242757,
          "spk": "名护 (ナゴ)",
          "ja": "一体どういう……",
          "tc": "那到底是什麼意思……？",
          "sc": "那到底是什么意思……？"
        },
        {
          "f_idx": 42,
          "pidx_tc": 242768,
          "spk": "名护 (ナゴ)",
          "ja": "う……",
          "tc": "嗚……",
          "sc": "呜……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4188,
      "rec_id": "TALK_ID_10_0301_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 242798,
          "spk": "茶梅 (サザンカ)",
          "ja": "あらら……",
          "tc": "哎呀……",
          "sc": "哎呀……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 242805,
          "spk": "茶梅 (サザンカ)",
          "ja": "また寝ちゃったよ",
          "tc": "又昏過去了。",
          "sc": "又昏过去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4189,
      "rec_id": "TALK_ID_10_0301_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 242823,
          "spk": "茶梅 (サザンカ)",
          "ja": "リン、どうすんの？",
          "tc": "林，怎麼辦？",
          "sc": "林，怎么办？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 242830,
          "spk": "茶梅 (サザンカ)",
          "ja": "また水かける？",
          "tc": "還要再潑一次水嗎？",
          "sc": "还要再泼一次水吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4190,
      "rec_id": "TALK_ID_10_0301_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 242848,
          "spk": "林 (リン)",
          "ja": "起こさなくていいわ",
          "tc": "不必弄醒他了。",
          "sc": "不必弄醒他了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 242855,
          "spk": "林 (リン)",
          "ja": "診療所に連れて行って寝かせましょう",
          "tc": "把他帶到診所去躺著吧。",
          "sc": "把他带到诊所去躺着吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 242873,
          "spk": "林 (リン)",
          "ja": "サザンカ、手を貸して",
          "tc": "茶梅，幫我一下。",
          "sc": "茶梅，帮我一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4191,
      "rec_id": "TALK_ID_10_0301_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 242891,
          "spk": "茶梅 (サザンカ)",
          "ja": "うええ！？",
          "tc": "咦！？",
          "sc": "咦！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 242898,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシこれからやることが",
          "tc": "我接下來還有",
          "sc": "我接下来还有"
        },
        {
          "f_idx": 2,
          "pidx_tc": 242905,
          "spk": "茶梅 (サザンカ)",
          "ja": "あったんだけどーー！",
          "tc": "別的事情要做呀～～！",
          "sc": "别的事情要做呀～～！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 242918,
          "spk": "林 (リン)",
          "ja": "あら、掟を忘れたの？",
          "tc": "哎呀，妳忘了規矩嗎？",
          "sc": "哎呀，你忘了规矩吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 242925,
          "spk": "林 (リン)",
          "ja": "<strong>「掟の三、見知らぬ者に近づくな」</strong>、よ",
          "tc": "<strong>「規矩之三，別靠近陌生人」</strong>。",
          "sc": "<strong>“规矩之三，别靠近陌生人”</strong>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 242943,
          "spk": "林 (リン)",
          "ja": "サザンカ、あなた……",
          "tc": "茶梅，妳……",
          "sc": "茶梅，你……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 242950,
          "spk": "林 (リン)",
          "ja": "掟を破ってこの人に接触したわね？",
          "tc": "打破了規矩，和這個人接觸了對吧？",
          "sc": "打破了规矩，和这个人接触了对吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 242957,
          "spk": "林 (リン)",
          "ja": "罰として私の命令を聞きなさい",
          "tc": "作為處罰，過來聽我的命令。",
          "sc": "作为处罚，过来听我的命令。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 242970,
          "spk": "茶梅 (サザンカ)",
          "ja": "うへぇ……",
          "tc": "呃啊……",
          "sc": "呃啊……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 242977,
          "spk": "茶梅 (サザンカ)",
          "ja": "都合がいいときだけそれ持ち出すんだから……",
          "tc": "妳只在方便的時候才把那個搬出來……",
          "sc": "你只在方便的时候才把那个搬出来……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 242986,
          "spk": "茶梅 (サザンカ)",
          "ja": "わかったよ……",
          "tc": "知道了啦……",
          "sc": "知道了啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4192,
      "rec_id": "TALK_ID_10_0301_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243012,
          "spk": "林 (リン)",
          "ja": "はぁ、全く……",
          "tc": "唉，真受不了……",
          "sc": "唉，真受不了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243019,
          "spk": "林 (リン)",
          "ja": "不本意なことになってしまったわ……",
          "tc": "這事態發展可不在預料之中……",
          "sc": "这事态发展可不在预料之中……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243026,
          "spk": "林 (リン)",
          "ja": "これ以上、村に人を増やしたくなかったのに",
          "tc": "我不想再讓村子裡的人變得更多了，",
          "sc": "我不想再让村子里的人变得更多了，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4193,
      "rec_id": "TALK_ID_10_0301_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243044,
          "spk": "林 (リン)",
          "ja": "<player>も、また掟を破って",
          "tc": "<player>也是，又打破了規矩，",
          "sc": "<player>也是，又打破了规矩，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243051,
          "spk": "林 (リン)",
          "ja": "村の外の人間と関わったわね？",
          "tc": "跟村外的人打交道了吧？",
          "sc": "跟村外的人打交道了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 243069,
          "spk": "林 (リン)",
          "ja": "呆れたわ……",
          "tc": "真是令人傻眼……",
          "sc": "真是令人傻眼……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 243076,
          "spk": "林 (リン)",
          "ja": "あなたは本当に、掟を破るのが好きね……",
          "tc": "你真的很喜歡打破規矩呢……",
          "sc": "你真的很喜欢打破规矩呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 243087,
          "spk": "林 (リン)",
          "ja": "それとも、罰を受けるのが好きなのかしら？",
          "tc": "還是說，你喜歡的是受到處罰？",
          "sc": "还是说，你喜欢的是受到处罚？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 243094,
          "spk": "林 (リン)",
          "ja": "だったら良い罰があるのだけれど……",
          "tc": "那我正好有個很棒的處罰……",
          "sc": "那我正好有个很棒的处罚……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 243101,
          "spk": "林 (リン)",
          "ja": "もちろん、引き受けてくれるわよね？",
          "tc": "你當然願意接受吧？",
          "sc": "你当然愿意接受吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4194,
      "rec_id": "TALK_ID_10_0301_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243119,
          "spk": "林 (リン)",
          "ja": "残念だけど、あなたに拒否権はないわ",
          "tc": "遺憾的是你沒有拒絕的權利。",
          "sc": "遗憾的是你没有拒绝的权利。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243137,
          "spk": "林 (リン)",
          "ja": "さっきの気絶した男、",
          "tc": "剛才那個暈倒的男人，",
