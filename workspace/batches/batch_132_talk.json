  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1881,
      "rec_id": "TALK_ID_SECRETARY_BIRTHDAY_20_108_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142224,
          "spk": "今野 (コンノ)",
          "ja": "どうですかァ？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142231,
          "spk": "今野 (コンノ)",
          "ja": "見事な招き猫の置き物でしょう",
          "tc": "這尊招財貓的擺飾很氣派吧。",
          "sc": "这尊招财猫的摆设很气派吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142238,
          "spk": "今野 (コンノ)",
          "ja": "気に入ってもらえましたか？",
          "tc": "您喜歡嗎？",
          "sc": "您喜欢吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142249,
          "spk": "今野 (コンノ)",
          "ja": "右手を挙げている招き猫は",
          "tc": "舉著右手的招財貓",
          "sc": "举着右手的招财猫"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142256,
          "spk": "今野 (コンノ)",
          "ja": "金運を招くんですヨ",
          "tc": "能招來財運喔。",
          "sc": "能招来财运哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142267,
          "spk": "今野 (コンノ)",
          "ja": "アナタが大儲けすれば",
          "tc": "如果您能大賺一筆，",
          "sc": "如果您能大赚一笔，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142274,
          "spk": "今野 (コンノ)",
          "ja": "この村の財政も潤って、",
          "tc": "村裡的財政就會變得寬裕，",
          "sc": "村里的财政就会变得宽裕，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 142281,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの懐も暖まるというものです",
          "tc": "那我的荷包也能跟著沾光。",
          "sc": "那我的荷包也能跟着沾光。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142292,
          "spk": "今野 (コンノ)",
          "ja": "ワタシが特別に念を込めておいたので、",
          "tc": "我可是特別為它灌注意念加持過了，",
          "sc": "我可是特别为它灌注意念加持过了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 142299,
          "spk": "今野 (コンノ)",
          "ja": "きっとバリバリ稼げるようになりますヨ",
          "tc": "保證您一定會賺得盆滿缽滿的。",
          "sc": "保证您一定会赚得盆满钵满的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 142306,
          "spk": "今野 (コンノ)",
          "ja": "楽しみですねェ",
          "tc": "真讓人期待呢。",
          "sc": "真让人期待呢。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 142324,
          "spk": "今野 (コンノ)",
          "ja": "それにしても、アナタは愛想が足りませんネ",
          "tc": "話說回來，您還真是不太會討人歡心呢。",
          "sc": "话说回来，您还真是不太会讨人欢心呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 142331,
          "spk": "今野 (コンノ)",
          "ja": "招き猫を見習って、",
          "tc": "要不要學學招財貓，",
          "sc": "要不要学学招财猫，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 142338,
          "spk": "今野 (コンノ)",
          "ja": "少しは笑ってみたらどうですか？",
          "tc": "稍微笑一個試試看如何？",
          "sc": "稍微笑一个试试看如何？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 142349,
          "spk": "今野 (コンノ)",
          "ja": "まァ、そういうところこそが",
          "tc": "不過，或許這個樣子",
          "sc": "不过，或许这个样子"
        },
        {
          "f_idx": 16,
          "pidx_tc": 142356,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんらしさなのかもしれませんねェ",
          "tc": "正是<player>獨特的個性吧",
          "sc": "正是<player>独特的个性吧。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 142363,
          "spk": "今野 (コンノ)",
          "ja": "……お誕生日、おめでとうございます",
          "tc": "……祝您生日快樂。",
          "sc": "……祝您生日快乐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1882,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142387,
          "spk": "名护 (ナゴ)",
          "ja": "この村は、古いしきたりを守って、",
          "tc": "這座村子遵守著舊習俗，",
          "sc": "这座村子遵守着旧习俗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142394,
          "spk": "名护 (ナゴ)",
          "ja": "昔ながらの風習を続けているんだね……",
          "tc": "延續著自古流傳下來的習慣……",
          "sc": "延续着自古流传下来的习惯……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142405,
          "spk": "名护 (ナゴ)",
          "ja": "村の一員と認められるまで",
          "tc": "據說在被認同為村子的一員之前，",
          "sc": "据说在被认同为村子的一员之前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142412,
          "spk": "名护 (ナゴ)",
          "ja": "いないものとして扱われるらしい……",
          "tc": "都會遭到無視……",
          "sc": "都会遭到无视……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142430,
          "spk": "名护 (ナゴ)",
          "ja": "まだお互い村に馴染めているかは疑問だけど、",
          "tc": "雖然還不確定我們是否已經融入了村子，",
          "sc": "虽然还不确定我们是否已经融入了村子，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142437,
          "spk": "名护 (ナゴ)",
          "ja": "励まし合いながら、がんばっていこうか",
          "tc": "但就互相打氣，一起努力下去吧。",
          "sc": "但就互相打气，一起努力下去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1883,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142470,
          "spk": "名护 (ナゴ)",
          "ja": "おや、もうこんな時間だ……",
          "tc": "哎呀，已經這麼晚了……",
          "sc": "哎呀，已经这么晚了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142477,
          "spk": "名护 (ナゴ)",
          "ja": "今日はそろそろ閉めるよ",
          "tc": "今天差不多要關門了，",
          "sc": "今天差不多要关门了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142484,
          "spk": "名护 (ナゴ)",
          "ja": "また明日きておくれ",
          "tc": "你明天再來吧。",
          "sc": "你明天再来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1884,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0040",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142508,
          "spk": "名护 (ナゴ)",
          "ja": "おや、どうされたのですか？",
          "tc": "哦，有什麼事嗎？",
          "sc": "哦，有什么事吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142515,
          "spk": "名护 (ナゴ)",
          "ja": "ソーラーパネルの契約書に",
          "tc": "你願意簽署",
          "sc": "你愿意签署"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142522,
          "spk": "名护 (ナゴ)",
          "ja": "サインしていただけるのですか？",
          "tc": "太陽能板的契約書了嗎？",
          "sc": "太阳能板的契约书了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142533,
          "spk": "名护 (ナゴ)",
          "ja": "……そうではないようですね",
          "tc": "……看來不是這樣呢。",
          "sc": "……看来不是这样呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142540,
          "spk": "名护 (ナゴ)",
          "ja": "気が変わりましたら、お声がけください",
          "tc": "如果改變主意了，再跟我說一聲吧。",
          "sc": "如果改变主意了，再跟我说一声吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1885,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0041",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142564,
          "spk": "名护 (ナゴ)",
          "ja": "……キミも、困っているみたいだね",
          "tc": "……看來你也很困擾呢。",
          "sc": "……看来你也很困扰呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142575,
          "spk": "名护 (ナゴ)",
          "ja": "俺も村人たちの対応に",
          "tc": "我也開始覺得",
          "sc": "我也开始觉得"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142582,
          "spk": "名护 (ナゴ)",
          "ja": "ほとほと疲れてきたところだよ……",
          "tc": "跟村民們溝通真的很累……",
          "sc": "跟村民们沟通真的很累……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1886,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142606,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんか……",
          "tc": "是<player>啊……",
          "sc": "是<player>啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142613,
          "spk": "名护 (ナゴ)",
          "ja": "キミなら助けてくれるかもしれないな",
          "tc": "你說不定幫得上我的忙呢。",
          "sc": "你说不定帮得上我的忙呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142624,
          "spk": "名护 (ナゴ)",
          "ja": "ああいや、そんな大ごとじゃないんだが",
          "tc": "啊～沒什麼，不是什麼大事啦。",
          "sc": "啊～没什么，不是什么大事啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142631,
          "spk": "名护 (ナゴ)",
          "ja": "<tmpstr>がほしくて探してるんだ",
          "tc": "我正在找<tmpstr>。",
          "sc": "我正在找<tmpstr>。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142649,
          "spk": "名护 (ナゴ)",
          "ja": "もしどこかで手に入れたら",
          "tc": "如果你在哪邊拿到了，",
          "sc": "如果你在哪边拿到了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142656,
          "spk": "名护 (ナゴ)",
          "ja": "俺に譲ってくれるとすごく助かるよ",
          "tc": "要是願意讓給我，那就太好了。",
          "sc": "要是愿意让给我，那就太好了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 142665,
          "spk": "名护 (ナゴ)",
          "ja": "ちゃんとお礼はさせてもらうから",
          "tc": "我會好好答謝你的。",
          "sc": "我会好好答谢你的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142672,
          "spk": "名护 (ナゴ)",
          "ja": "<gamevalue GAME_VALUE_TALK_NUM>日くらいを目途に頼めるかな？",
          "tc": "能麻煩你在<gamevalue GAME_VALUE_TALK_NUM>天內拿來給我嗎？",
          "sc": "能麻烦你在<gamevalue GAME_VALUE_TALK_NUM>天内拿来给我吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1887,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0051",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142703,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142710,
          "spk": "名护 (ナゴ)",
          "ja": "まさか<tmpstr>を",
          "tc": "沒想到你真的把<tmpstr>",
          "sc": "没想到你真的把<tmpstr>"
