      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1888,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142751,
          "spk": "名护 (ナゴ)",
          "ja": "そうか、ありがとう",
          "tc": "這樣啊，謝謝你。",
          "sc": "这样啊，谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142758,
          "spk": "名护 (ナゴ)",
          "ja": "助かったよ",
          "tc": "幫了我大忙。",
          "sc": "帮了我大忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142769,
          "spk": "名护 (ナゴ)",
          "ja": "じゃあお礼だ",
          "tc": "那麼為了答謝你，",
          "sc": "那么为了答谢你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142776,
          "spk": "名护 (ナゴ)",
          "ja": "これをあげるよ",
          "tc": "請收下這個。",
          "sc": "请收下这个。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142787,
          "spk": "名护 (ナゴ)",
          "ja": "またなにかあったらよろしく頼むよ",
          "tc": "下次如果還有什麼需求，就再麻煩你了。",
          "sc": "下次如果还有什么需求，就再麻烦你了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142794,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃあ",
          "tc": "那就先這樣。",
          "sc": "那就先这样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1889,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142816,
          "spk": "名护 (ナゴ)",
          "ja": "おっと違っていたか",
          "tc": "哎呀，是我搞錯了啊。",
          "sc": "哎呀，是我搞错了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142823,
          "spk": "名护 (ナゴ)",
          "ja": "ごめんね",
          "tc": "抱歉。",
          "sc": "抱歉。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142834,
          "spk": "名护 (ナゴ)",
          "ja": "キミの気が向いたらでいいからね",
          "tc": "等你有空再幫我就好，",
          "sc": "等你有空再帮我就好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142841,
          "spk": "名护 (ナゴ)",
          "ja": "頼んだよ",
          "tc": "麻煩你了。",
          "sc": "麻烦你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1890,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_SPECIAL_20_109_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 142865,
          "spk": "名护 (ナゴ)",
          "ja": "お、いいところで会えた",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 142872,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんに、",
          "tc": "<player>，你來得正好，",
          "sc": "<player>，你来得正好，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 142879,
          "spk": "名护 (ナゴ)",
          "ja": "渡したいものがあったんだよ",
          "tc": "我有東西想給你。",
          "sc": "我有东西想给你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 142890,
          "spk": "名护 (ナゴ)",
          "ja": "何かというと、これ",
          "tc": "我要給你的東西，就是這個──",
          "sc": "我要给你的东西，就是这个——"
        },
        {
          "f_idx": 4,
          "pidx_tc": 142897,
          "spk": "名护 (ナゴ)",
          "ja": "「クロワッサン」のレシピだよ",
          "tc": "這是「可頌」的食譜喔！",
          "sc": "这是“可颂”的食谱哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 142908,
          "spk": "名护 (ナゴ)",
          "ja": "図書館の整理をしてたら、出てきたんだけど",
          "tc": "我在整理圖書館的時候發現的，",
          "sc": "我在整理图书馆的时候发现的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 142915,
          "spk": "名护 (ナゴ)",
          "ja": "俺だと宝の持ち腐れになりそうだからね",
          "tc": "但放在我這裡也只會埋沒了它。",
          "sc": "但放在我这里也只会埋没了它。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 142922,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんの方が上手く活用してくれる",
          "tc": "<player>應該更能好好活用這本食譜。",
          "sc": "<player>应该更能好好活用这本食谱。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 142933,
          "spk": "名护 (ナゴ)",
          "ja": "バターを多めに使うって書いてあるから",
          "tc": "上面寫說要用很多奶油，",
          "sc": "上面写说要用很多奶油，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 142940,
