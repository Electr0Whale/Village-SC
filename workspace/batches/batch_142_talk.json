{
  "batch_id": "batch_142_talk",
  "group": "talk",
  "files": [
    "talk.dat"
  ],
  "record_count": 34,
  "line_count": 198,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2395,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57620,
          "spk": "裕太 (ユータ)",
          "ja": "今日は品評会の日だったっけ",
          "tc": "今天似乎是評鑑會的舉辦日，",
          "sc": "今天似乎是评鉴会的举办日，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57627,
          "spk": "裕太 (ユータ)",
          "ja": "自分で作ったものをみんなに",
          "tc": "聽說可以把自己做的東西",
          "sc": "听说可以把自己做的东西"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57634,
          "spk": "裕太 (ユータ)",
          "ja": "見てもらえるらしいよ",
          "tc": "展示給大家看。",
          "sc": "展示给大家看。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57645,
          "spk": "裕太 (ユータ)",
          "ja": "少し緊張もするだろうけど、",
          "tc": "雖然可能會讓人有點緊張，",
          "sc": "虽然可能会让人有点紧张，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57652,
          "spk": "裕太 (ユータ)",
          "ja": "こういう行事があると、",
          "tc": "但有這種展示成果的機會，",
          "sc": "但有这种展示成果的机会，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57659,
          "spk": "裕太 (ユータ)",
          "ja": "やりがいがあるだろうね",
          "tc": "也會讓人更有成就感吧。",
          "sc": "也会让人更有成就感吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2396,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57683,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も品評会を見に来てたんだね",
          "tc": "<player>也來看評鑑會了啊。",
          "sc": "<player>也来看评鉴会了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57690,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、もしかしてその顔は出品を迷ってる？",
          "tc": "啊，那個表情難道是在猶豫要不要參加嗎？",
          "sc": "啊，那个表情难道是在犹豫要不要参加吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57708,
          "spk": "裕太 (ユータ)",
          "ja": "迷うぐらいならエントリーしていいと思うよ",
          "tc": "我覺得與其猶豫不如直接報名比較好喔。",
          "sc": "我觉得与其犹豫不如直接报名比较好哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57715,
          "spk": "裕太 (ユータ)",
          "ja": "<player>なら絶対にいい結果が出るさ",
          "tc": "是<player>的話一定會有好結果的。",
          "sc": "是<player>的话一定会有好结果的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2397,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57739,
          "spk": "裕太 (ユータ)",
          "ja": "やぁ！<player>！",
          "tc": "嗨，<player>！",
          "sc": "嗨，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57746,
          "spk": "裕太 (ユータ)",
          "ja": "毎年この日が楽しみなんだよ～",
          "tc": "我每年都很期待這一天到來喔。",
          "sc": "我每年都很期待这一天到来哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57757,
          "spk": "裕太 (ユータ)",
          "ja": "村のみんなでお花見なんて、",
          "tc": "整個村子齊聚一處來賞花，",
          "sc": "整个村子齐聚一处来赏花，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57764,
          "spk": "裕太 (ユータ)",
          "ja": "今の時代どこでもやってるもんじゃないでしょ？",
          "tc": "現在這個時代，這樣的活動可不是到處都有的。",
          "sc": "现在这个时代，这样的活动可不是到处都有的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57782,
          "spk": "裕太 (ユータ)",
          "ja": "この特別感が最高だよね",
          "tc": "這種獨特感真的很棒。",
          "sc": "这种独特感真的很棒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2398,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57813,
          "spk": "裕太 (ユータ)",
          "ja": "風に乗って、桜の花びらが",
          "tc": "櫻花隨風飄落……",
          "sc": "樱花随风飘落……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57820,
          "spk": "裕太 (ユータ)",
          "ja": "舞い散っていくのは",
          "tc": "雖然是很美的景象，",
          "sc": "虽然是很美的景象，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57827,
          "spk": "裕太 (ユータ)",
          "ja": "綺麗だけど、どこか切ないよね",
          "tc": "但也覺得有點感傷呢。",
          "sc": "但也觉得有点感伤呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57838,
          "spk": "裕太 (ユータ)",
          "ja": "でも、これは終わりじゃないんだよ",
          "tc": "不過這可不是終結喔。",
          "sc": "不过这可不是终结哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57845,
          "spk": "裕太 (ユータ)",
          "ja": "次の春に新しい芽を出すための",
          "tc": "我覺得這是為了在明年春天長出新芽，",
          "sc": "我觉得这是为了在明年春天长出新芽，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57852,
          "spk": "裕太 (ユータ)",
          "ja": "旅立ちなんだと思う",
          "tc": "而開啟的旅程。",
          "sc": "而开启的旅程。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 57863,
          "spk": "裕太 (ユータ)",
          "ja": "だから俺は、感傷に浸るよりも",
          "tc": "所以比起沉浸在傷感中，",
          "sc": "所以比起沉浸在伤感中，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57870,
          "spk": "裕太 (ユータ)",
          "ja": "楽しく食べて楽しく騒いで、",
          "tc": "我更想要開心吃、開心玩，",
          "sc": "我更想要开心吃、开心玩，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 57877,
          "spk": "裕太 (ユータ)",
          "ja": "めいっぱいお花見を楽しむつもりだよ",
          "tc": "盡情享受賞花的樂趣。",
          "sc": "尽情享受赏花的乐趣。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2399,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57901,
          "spk": "裕太 (ユータ)",
          "ja": "んー、ナゴさんに言われて",
          "tc": "被名護先生提醒之後，",
          "sc": "被名护先生提醒之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57908,
          "spk": "裕太 (ユータ)",
          "ja": "整理はしたけど……",
          "tc": "我是整理了一下……",
          "sc": "我是整理了一下……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57915,
          "spk": "裕太 (ユータ)",
          "ja": "お店の準備って大変なんだな……",
          "tc": "要準備開店真是太累人了……",
          "sc": "要准备开店真是太累人了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57926,
          "spk": "裕太 (ユータ)",
          "ja": "いつか自分でも出してみたいけど、",
          "tc": "我希望自己有一天也能嘗試擺攤，",
          "sc": "我希望自己有一天也能尝试摆摊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57933,
          "spk": "裕太 (ユータ)",
          "ja": "覚えることが多そうだ",
          "tc": "但感覺有好多事情要學啊。",
          "sc": "但感觉有好多事情要学啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2400,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57964,
          "spk": "裕太 (ユータ)",
          "ja": "<player>はソーダフロートって知ってる？",
          "tc": "<player>知道冰淇淋蘇打嗎？",
          "sc": "<player>知道冰淇淋苏打吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57971,
          "spk": "裕太 (ユータ)",
          "ja": "ソーダとアイスクリームを一緒に飲むなんて、",
          "tc": "能同時享用汽水和冰淇淋，",
          "sc": "能同时享用汽水和冰淇淋，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57978,
          "spk": "裕太 (ユータ)",
          "ja": "なんて贅沢なデザートなんだろうね！",
          "tc": "真的是超級豪華的甜點呢！",
          "sc": "真的是超级豪华的甜点呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57989,
          "spk": "裕太 (ユータ)",
          "ja": "一口飲んでみれば",
          "tc": "只要試喝一口，",
          "sc": "只要试喝一口，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57996,
          "spk": "裕太 (ユータ)",
          "ja": "これがただの飲み物じゃないって",
          "tc": "應該就能發現，",
          "sc": "应该就能发现，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 58003,
          "spk": "裕太 (ユータ)",
          "ja": "わかるはずだよ",
          "tc": "這可不是普通的飲料喔！",
          "sc": "这可不是普通的饮料哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 58014,
          "spk": "裕太 (ユータ)",
          "ja": "お祭りの熱気の中で、",
          "tc": "能讓你在祭典的暑氣中，",
          "sc": "能让你在祭典的暑气中，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 58021,
          "spk": "裕太 (ユータ)",
          "ja": "涼しさを感じられるドリンク――",
          "tc": "感受到清涼的飲料──",
          "sc": "感受到清凉的饮料——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 58028,
          "spk": "裕太 (ユータ)",
          "ja": "飲む宝石と言ってもいいくらいさ",
          "tc": "說是能喝的寶石也不為過啊。",
          "sc": "说是能喝的宝石也不为过啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2401,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58052,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58059,
          "spk": "裕太 (ユータ)",
          "ja": "みて、実は今年のサツマイモ、",
          "tc": "其實今年要烤的地瓜，",
          "sc": "其实今年要烤的红薯，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58066,
          "spk": "裕太 (ユータ)",
          "ja": "俺の畑で取れたものもあるんだ！",
          "tc": "有些是從我的田地裡採來的！",
          "sc": "有些是从我的田地里采来的！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 58077,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も始まったら",
          "tc": "等開始之後，",
          "sc": "等开始之后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 58084,
          "spk": "裕太 (ユータ)",
          "ja": "是非焼きに来てよ",
          "tc": "<player>也來烤烤看吧！",
          "sc": "<player>也来烤烤看吧！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 58095,
          "spk": "裕太 (ユータ)",
          "ja": "美味しく食べてくれたら嬉しいな",
          "tc": "你能來享用的話，我會很開心的。",
          "sc": "你能来享用的话，我会很开心的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2402,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58119,
          "spk": "裕太 (ユータ)",
          "ja": "大地の恵みであるサツマイモを",
          "tc": "用搖曳的火焰之力，",
          "sc": "用摇曳的火焰之力，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58126,
          "spk": "裕太 (ユータ)",
          "ja": "揺らめく炎の力で、ほっくほくの",
          "tc": "將大自然賜予我們的地瓜，",
          "sc": "将大自然赐予我们的红薯，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58133,
          "spk": "裕太 (ユータ)",
          "ja": "甘い焼き芋に変える……",
          "tc": "變成熱騰騰的香甜烤地瓜……",
          "sc": "变成热腾腾的香甜烤红薯……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 58144,
          "spk": "裕太 (ユータ)",
          "ja": "俺はこの、サツマイモがじわじわと",
          "tc": "我超級喜歡",
          "sc": "我超级喜欢"
        },
        {
          "f_idx": 4,
          "pidx_tc": 58151,
          "spk": "裕太 (ユータ)",
          "ja": "焼けていくのを見守る時間が",
          "tc": "看著地瓜一點一點",
          "sc": "看着红薯一点一点"
        },
        {
          "f_idx": 5,
          "pidx_tc": 58158,
          "spk": "裕太 (ユータ)",
          "ja": "すごく好きなんだよね",
          "tc": "慢慢烤好的這段時間。",
          "sc": "慢慢烤好的这段时间。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 58169,
          "spk": "裕太 (ユータ)",
          "ja": "もうちょっと待っててね、<player>",
          "tc": "<player>，再等一下下喔！",
          "sc": "<player>，再等一下下哦！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 58176,
          "spk": "裕太 (ユータ)",
          "ja": "もっともっと、じっくり火を通して",
          "tc": "我會用細火慢烤，",
          "sc": "我会用细火慢烤，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 58183,
          "spk": "裕太 (ユータ)",
          "ja": "最高の状態の焼き芋をあげるから",
          "tc": "烤出最棒的烤地瓜給你的。",
          "sc": "烤出最棒的烤红薯给你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2403,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58207,
          "spk": "裕太 (ユータ)",
          "ja": "やぁ<player>！",
          "tc": "嗨，<player>！",
          "sc": "嗨，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58214,
          "spk": "裕太 (ユータ)",
          "ja": "今年ももう終わりだね",
          "tc": "今年也即將結束啦。",
          "sc": "今年也即将结束啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58225,
          "spk": "裕太 (ユータ)",
          "ja": "知ってた？",
          "tc": "你知道嗎？",
          "sc": "你知道吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 58232,
          "spk": "裕太 (ユータ)",
          "ja": "街の方だと大きな神社に",
          "tc": "在這個時期，",
          "sc": "在这个时期，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 58239,
          "spk": "裕太 (ユータ)",
          "ja": "お参りに行ったりするんだ",
          "tc": "市區的人們通常會到大一點的神社去參拜。",
          "sc": "市区的人们通常会到大一点的神社去参拜。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 58250,
          "spk": "裕太 (ユータ)",
          "ja": "でもこの村みたいに",
          "tc": "不過像這個村子一樣，",
          "sc": "不过像这个村子一样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 58257,
          "spk": "裕太 (ユータ)",
          "ja": "自分たちで催しの準備をするのも",
          "tc": "大家親手一起籌備活動，",
          "sc": "大家亲手一起筹备活动，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 58264,
          "spk": "裕太 (ユータ)",
          "ja": "すごく貴重な体験だよね！",
          "tc": "也是一種很珍貴的體驗呢！",
          "sc": "也是一种很珍贵的体验呢！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2404,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 58288,
          "spk": "裕太 (ユータ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 58295,
          "spk": "裕太 (ユータ)",
          "ja": "おみくじ引いていく？",
          "tc": "想抽個籤嗎？",
          "sc": "想抽个签吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 58306,
          "spk": "裕太 (ユータ)",
          "ja": "一年の計は、この一本にあるかもよ",
          "tc": "未來一年的運勢，說不定就在這支籤裡囉。",
          "sc": "未来一年的运势，说不定就在这支签里呢。"
        },
        {
