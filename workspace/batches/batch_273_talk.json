  ],
  "record_count": 24,
  "line_count": 191,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7673,
      "rec_id": "TALK_ID_70_2120_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441218,
          "spk": "裕太 (ユータ)",
          "ja": "手打ちうどんは",
          "tc": "距離我上次",
          "sc": "距离我上次"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441225,
          "spk": "裕太 (ユータ)",
          "ja": "最近あまりやってなくて",
          "tc": "做手工烏龍麵，",
          "sc": "做手工乌冬面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441232,
          "spk": "裕太 (ユータ)",
          "ja": "久しぶりなんだ",
          "tc": "其實已經有一段時間了。",
          "sc": "其实已经有一段时间了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441243,
          "spk": "裕太 (ユータ)",
          "ja": "村に来てすぐの頃は",
          "tc": "在剛來村子的那段期間，",
          "sc": "在刚来村子的那段期间，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441250,
          "spk": "裕太 (ユータ)",
          "ja": "よく作ってたんだけど……",
          "tc": "我常常會做來吃……",
          "sc": "我常常会做来吃……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 441261,
          "spk": "裕太 (ユータ)",
          "ja": "うどんって、コシを出すために",
          "tc": "在做烏龍麵的時候啊，為了要讓麵有嚼勁，",
          "sc": "在做乌冬面的时候啊，为了要让面有嚼劲，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 441268,
          "spk": "裕太 (ユータ)",
          "ja": "足で踏む作業があってね",
          "tc": "有一道要用腳踩的步驟。",
          "sc": "有一道要用脚踩的步骤。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 441275,
          "spk": "裕太 (ユータ)",
          "ja": "これがすごく楽しいんだ",
          "tc": "那個真的很好玩呢。",
          "sc": "那个真的很好玩呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 441286,
          "spk": "裕太 (ユータ)",
          "ja": "俺はいつもテンションが上がって",
          "tc": "每次做到那裡，我都會很興奮，",
          "sc": "每次做到那里，我都会很兴奋，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 441293,
          "spk": "裕太 (ユータ)",
          "ja": "うどんの上で歌ったり踊ったりしてるよ",
          "tc": "會踩在麵團上又唱又跳的。",
          "sc": "会踩在面团上又唱又跳的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 441311,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、ある日そこを",
          "tc": "結果有一天，",
          "sc": "结果有一天，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 441318,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんに見られちゃってね",
          "tc": "就被小洋撞見了我又唱又跳的樣子，",
          "sc": "就被小洋撞见了我又唱又跳的样子，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 441325,
          "spk": "裕太 (ユータ)",
          "ja": "あれは恥ずかしかったなあ……",
          "tc": "真的是丟臉到不行……",
          "sc": "真的是丢脸到不行……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 441336,
          "spk": "裕太 (ユータ)",
          "ja": "それ以来、作る",
          "tc": "從那之後，",
          "sc": "从那之后，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 441343,
          "spk": "裕太 (ユータ)",
          "ja": "回数を減らしてるんだ",
          "tc": "我做烏龍麵的次數就慢慢減少了。",
          "sc": "我做乌冬面的次数就慢慢减少了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 441354,
          "spk": "裕太 (ユータ)",
          "ja": "でもやっぱり",
          "tc": "但果然",
          "sc": "但果然"
        },
        {
          "f_idx": 17,
          "pidx_tc": 441361,
          "spk": "裕太 (ユータ)",
          "ja": "手打ちすると",
          "tc": "還是手工製作的",
          "sc": "还是手工制作的"
        },
        {
          "f_idx": 18,
          "pidx_tc": 441368,
          "spk": "裕太 (ユータ)",
          "ja": "美味しいよね",
          "tc": "比較好吃呢。",
          "sc": "比较好吃呢。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 441379,
          "spk": "裕太 (ユータ)",
          "ja": "均一に切るのが難しくて",
          "tc": "雖然麵條很難切得一模一樣，",
          "sc": "虽然面条很难切得一模一样，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 441386,
          "spk": "裕太 (ユータ)",
          "ja": "麺の太さがバラバラなのが",
          "tc": "所以粗細不一",
          "sc": "所以粗细不一"
        },
        {
          "f_idx": 21,
          "pidx_tc": 441393,
          "spk": "裕太 (ユータ)",
          "ja": "欠点なんだけど",
          "tc": "是個缺點。",
          "sc": "是个缺点。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 441402,
          "spk": "裕太 (ユータ)",
          "ja": "うどんの太さが揃ってないの、気になるかな？",
          "tc": "你會在意烏龍麵的粗細有沒有一致嗎？",
          "sc": "你会在意乌冬面的粗细有没有一致吗？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 441418,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 441425,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7674,
      "rec_id": "TALK_ID_70_2120_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441500,
          "spk": "裕太 (ユータ)",
          "ja": "うどん作り、もっと極めたくなってきたな",
          "tc": "我想要更精進自己做烏龍麵的手藝。",
          "sc": "我想要更精进自己做乌冬面的手艺。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441525,
          "spk": "裕太 (ユータ)",
          "ja": "いつか、出汁に使うかつお節から自作して",
          "tc": "希望有一天，我能從熬湯的柴魚片開始，",
          "sc": "希望有一天，我能从熬汤的柴鱼片开始，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441532,
          "spk": "裕太 (ユータ)",
          "ja": "全部が手作りのうどんを作ってみたい",
          "tc": "做出一碗全手工的烏龍麵。",
          "sc": "做出一碗全手工的乌冬面。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 441550,
          "spk": "裕太 (ユータ)",
          "ja": "完成したらキミに",
          "tc": "等完成之後，",
          "sc": "等完成之后，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 441557,
          "spk": "裕太 (ユータ)",
          "ja": "一番に食べてもらうからね",
          "tc": "會讓你第一個品嘗的。",
          "sc": "会让你第一个品尝的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7675,
      "rec_id": "TALK_ID_70_2120_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441581,
          "spk": "裕太 (ユータ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>。",
          "sc": "欢迎光临，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441588,
          "spk": "裕太 (ユータ)",
          "ja": "待ってたよ",
          "tc": "我就等你了呢。",
          "sc": "我就等你了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7676,
      "rec_id": "TALK_ID_70_2120_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441612,
          "spk": "裕太 (ユータ)",
          "ja": "今日のメニューは",
          "tc": "今天的料理是",
          "sc": "今天的料理是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441619,
          "spk": "裕太 (ユータ)",
          "ja": "「ビーフシチュー」だよ",
          "tc": "「燉牛肉」喔。",
          "sc": "“炖牛肉”哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441626,
          "spk": "裕太 (ユータ)",
          "ja": "ロッカクさんに作ってもらったんだ",
          "tc": "這是六角叔幫我們做的，",
          "sc": "这是六角叔帮我们做的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441637,
          "spk": "裕太 (ユータ)",
          "ja": "熱々のうちに食べよう",
          "tc": "趕快趁熱吃吧。",
          "sc": "赶快趁热吃吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441644,
          "spk": "裕太 (ユータ)",
          "ja": "いただきます！",
          "tc": "我要開動了！",
          "sc": "我要开动了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7677,
      "rec_id": "TALK_ID_70_2120_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441668,
          "spk": "裕太 (ユータ)",
          "ja": "ビーフシチューって",
          "tc": "說到燉牛肉啊，",
          "sc": "说到炖牛肉啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441675,
          "spk": "裕太 (ユータ)",
          "ja": "俺が村に来た時には",
          "tc": "我剛到村子裡的時候，",
          "sc": "我刚到村子里的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441682,
          "spk": "裕太 (ユータ)",
          "ja": "食堂にない料理だったんだ",
          "tc": "餐廳還沒有這道料理。",
          "sc": "餐厅还没有这道料理。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441693,
          "spk": "裕太 (ユータ)",
          "ja": "だからレシピを教えて",
          "tc": "所以我就把食譜告訴餐廳，",
          "sc": "所以我就把食谱告诉餐厅，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441700,
          "spk": "裕太 (ユータ)",
          "ja": "メニューに追加して",
          "tc": "請他把這道料理",
          "sc": "请他把这道料理"
        },
        {
          "f_idx": 5,
          "pidx_tc": 441707,
          "spk": "裕太 (ユータ)",
          "ja": "もらったんだよ",
          "tc": "加到菜單上。",
          "sc": "加到菜单上。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 441718,
          "spk": "裕太 (ユータ)",
          "ja": "ビーフシチューは",
          "tc": "我從以前",
          "sc": "我从以前"
        },
        {
          "f_idx": 7,
          "pidx_tc": 441725,
          "spk": "裕太 (ユータ)",
          "ja": "昔から大好きな料理でね",
          "tc": "就很喜歡燉牛肉這道菜。",
          "sc": "就很喜欢炖牛肉这道菜。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 441736,
          "spk": "裕太 (ユータ)",
          "ja": "初めて食べたのは",
          "tc": "我第一次吃到燉牛肉，",
          "sc": "我第一次吃到炖牛肉，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 441743,
          "spk": "裕太 (ユータ)",
          "ja": "親の仕事にくっついて",
          "tc": "是我跟著父母的工作",
          "sc": "是我跟着父母的工作"
        },
        {
          "f_idx": 10,
          "pidx_tc": 441750,
          "spk": "裕太 (ユータ)",
          "ja": "海外に行った時なんだけど",
          "tc": "去國外的時候。",
          "sc": "去国外的时候。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 441761,
          "spk": "裕太 (ユータ)",
          "ja": "一口食べて惚れ込んじゃった",
          "tc": "我才吃了一口就愛上了。",
          "sc": "我才吃了一口就爱上了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 441768,
          "spk": "裕太 (ユータ)",
          "ja": "こんなに完璧で美味しい料理が",
          "tc": "沒想到世界上竟然有這麼完美又好吃的料理，",
          "sc": "没想到世界上竟然有这么完美又好吃的料理，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 441775,
          "spk": "裕太 (ユータ)",
          "ja": "あるんだって、衝撃だったな",
          "tc": "當時真的是大受震撼呢。",
          "sc": "当时真的是大受震撼呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 441786,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、ビーフシチューには",
          "tc": "但是只要一說到燉牛肉，",
          "sc": "但是只要一说到炖牛肉，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 441793,
          "spk": "裕太 (ユータ)",
          "ja": "一つ難しい問題があってね",
          "tc": "就會出現一個難題。",
          "sc": "就会出现一个难题。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 441804,
          "spk": "裕太 (ユータ)",
          "ja": "ライスとパン、どちらと",
          "tc": "就是燉牛肉究竟該配白飯吃好，",
          "sc": "就是炖牛肉究竟该配白饭吃好，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 441811,
          "spk": "裕太 (ユータ)",
          "ja": "一緒に食べるべきか？",
          "tc": "還是配麵包吃才好？",
          "sc": "还是配面包吃才好？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 441820,
          "spk": "裕太 (ユータ)",
          "ja": "これは大きな論争を巻き起こす",
          "tc": "這是個可能會掀起大爭論的",
          "sc": "这是个可能会掀起大争论的"
        },
        {
          "f_idx": 19,
          "pidx_tc": 441827,
          "spk": "裕太 (ユータ)",
          "ja": "可能性がある、重大な問題だよ",
          "tc": "重大問題。",
          "sc": "重大问题。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 441838,
          "spk": "裕太 (ユータ)",
          "ja": "ちなみに……",
          "tc": "順便問一下……",
          "sc": "顺便问一下……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 441845,
          "spk": "裕太 (ユータ)",
          "ja": "キミはライスとパン",
          "tc": "白飯跟麵包，",
          "sc": "白饭跟面包，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 441852,
          "spk": "裕太 (ユータ)",
          "ja": "どっちが好きかな？",
          "tc": "你比較喜歡配哪個吃啊？",
          "sc": "你比较喜欢配哪个吃啊？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 441861,
          "spk": "主角心声/旁白/选项",
          "ja": "ライス",
          "tc": "白飯",
          "sc": "白饭"
        },
        {
          "f_idx": 24,
          "pidx_tc": 441868,
          "spk": "主角心声/旁白/选项",
          "ja": "パン",
          "tc": "麵包",
          "sc": "面包"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7678,
      "rec_id": "TALK_ID_70_2120_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441972,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、俺？",
          "tc": "咦，你問我嗎？",
          "sc": "咦，你问我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441983,
          "spk": "裕太 (ユータ)",
          "ja": "ええっと……そうだな……",
          "tc": "呃……我想想……",
          "sc": "呃……我想想……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441990,
          "spk": "裕太 (ユータ)",
          "ja": "うーん……甲乙つけがたい……",
          "tc": "嗯……好難決定啊……",
          "sc": "嗯……好难决定啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442001,
          "spk": "裕太 (ユータ)",
          "ja": "……実を言うとね",
          "tc": "……老實說，",
          "sc": "……老实说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442012,
          "spk": "裕太 (ユータ)",
          "ja": "余ったビーフシチューを",
          "tc": "把剩下來的燉牛肉",
          "sc": "把剩下来的炖牛肉"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442019,
          "spk": "裕太 (ユータ)",
          "ja": "コロッケに入れたやつが",
          "tc": "包進可樂餅裡面，",
          "sc": "包进可乐饼里面，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442026,
          "spk": "裕太 (ユータ)",
          "ja": "一番好きなんだ",
          "tc": "是我最喜歡的吃法。",
          "sc": "是我最喜欢的吃法。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442037,
          "spk": "裕太 (ユータ)",
          "ja": "今度、ロッカクさんに頼んで",
          "tc": "乾脆下次拜託六角叔",
          "sc": "干脆下次拜托六角叔"
        },
        {
          "f_idx": 8,
          "pidx_tc": 442044,
          "spk": "裕太 (ユータ)",
          "ja": "作ってもらおうかな",
          "tc": "幫我做好了。",
          "sc": "帮我做好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7679,
      "rec_id": "TALK_ID_70_2120_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442068,
          "spk": "裕太 (ユータ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>。",
          "sc": "欢迎光临，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442075,
          "spk": "裕太 (ユータ)",
          "ja": "いいタイミングで来てくれたね",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442084,
          "spk": "裕太 (ユータ)",
          "ja": "ちょうど今日のメニュー「いももち」が",
          "tc": "今日的料理「馬鈴薯麻糬」",
          "sc": "今日的料理“土豆年糕”"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442091,
          "spk": "裕太 (ユータ)",
          "ja": "できたてほやほやなんだ",
          "tc": "才剛出爐，熱呼呼的喔。",
          "sc": "才刚出炉，热呼呼的哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442102,
          "spk": "裕太 (ユータ)",
          "ja": "裏の畑で採れたジャガイモを",
          "tc": "這是我用",
          "sc": "这是我用"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442109,
          "spk": "裕太 (ユータ)",
          "ja": "使って作ったんだよ",
          "tc": "自家種的馬鈴薯做的。",
          "sc": "自家种的土豆做的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442127,
          "spk": "裕太 (ユータ)",
          "ja": "さっそく食べよう",
          "tc": "我們趕快開動吧。",
          "sc": "我们赶快开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7680,
      "rec_id": "TALK_ID_70_2120_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442151,
          "spk": "裕太 (ユータ)",
          "ja": "熱いから火傷に注意してね",
          "tc": "小心別燙到了，",
          "sc": "小心别烫到了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442158,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんとフーフーするんだよ",
          "tc": "要好好吹涼喔。",
          "sc": "要好好吹凉哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442169,
          "spk": "裕太 (ユータ)",
          "ja": "タレはみたらし風にしてみたんだ",
          "tc": "醬汁是甜醬油，",
          "sc": "酱汁是甜酱油，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442176,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんとスミレくんにも",
          "tc": "堇怜和小洋",
          "sc": "堇怜和小洋"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442183,
          "spk": "裕太 (ユータ)",
          "ja": "好評だったから",
          "tc": "也都很喜歡喔。",
          "sc": "也都很喜欢哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442194,
          "spk": "裕太 (ユータ)",
          "ja": "……どう？",
          "tc": "……如何？",
          "sc": "……如何？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442201,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんと美味しく出来てる？",
          "tc": "我做的好吃嗎？",
          "sc": "我做的好吃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7681,
      "rec_id": "TALK_ID_70_2120_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442219,
          "spk": "裕太 (ユータ)",
          "ja": "よかったぁー",
          "tc": "太好了～！",
          "sc": "太好了～！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442226,
          "spk": "裕太 (ユータ)",
          "ja": "できたては、柔らかくて",
          "tc": "剛出爐的馬鈴薯麻糬既柔軟又Q彈，",
          "sc": "刚出炉的土豆年糕既柔软又Q弹，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442233,
          "spk": "裕太 (ユータ)",
          "ja": "もちもちでいいよねえ……",
          "tc": "很好吃對吧……",
          "sc": "很好吃对吧……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442244,
          "spk": "裕太 (ユータ)",
          "ja": "……あっ、そうだ！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442251,
          "spk": "裕太 (ユータ)",
          "ja": "裏の畑といえば……",
          "tc": "說到我家的田地……",
          "sc": "说到我家的田地……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7682,
      "rec_id": "TALK_ID_70_2120_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442269,
          "spk": "裕太 (ユータ)",
          "ja": "やらなきゃいけないことが",
          "tc": "我忘記有件",
          "sc": "我忘记有件"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442276,
          "spk": "裕太 (ユータ)",
          "ja": "あるのを忘れていたよ……",
          "tc": "不得不做的事情……",
          "sc": "不得不做的事情……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442287,
          "spk": "裕太 (ユータ)",
          "ja": "「監督」の服が古くなってるから",
          "tc": "「總管」的衣服越來越舊了，",
          "sc": "“总管”的衣服越来越旧了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442294,
          "spk": "裕太 (ユータ)",
          "ja": "新調してあげようと思っていたんだ",
          "tc": "我想找件新的給他。",
          "sc": "我想找件新的给他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7683,
      "rec_id": "TALK_ID_70_2120_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442319,
          "spk": "裕太 (ユータ)",
          "ja": "あ、監督がわからないかい？",
          "tc": "你不知道總管是誰嗎？",
          "sc": "你不知道总管是谁吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442326,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も会ったことあるはずだけど……",
          "tc": "<player>應該也有見過他才對……",
          "sc": "<player>应该也有见过他才对……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442337,
          "spk": "裕太 (ユータ)",
          "ja": "実は、俺の畑のカカシの名前なんだ",
          "tc": "其實就是我田地裡稻草人的名字。",
          "sc": "其实就是我田地里稻草人的名字。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442344,
          "spk": "裕太 (ユータ)",
          "ja": "キミもカカシを置いたら、",
          "tc": "你應該也懂架設了稻草人，",
          "sc": "你应该也懂架设了稻草人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442351,
          "spk": "裕太 (ユータ)",
          "ja": "名前をつけたくなる気持ち、わかるだろう？",
          "tc": "就會想幫他取名的心情對吧？",
          "sc": "就会想帮他取名的心情对吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442360,
          "spk": "主角心声/旁白/选项",
          "ja": "わかる",
          "tc": "我懂",
          "sc": "我懂"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442367,
          "spk": "主角心声/旁白/选项",
          "ja": "わからない",
          "tc": "我不懂",
          "sc": "我不懂"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7684,
      "rec_id": "TALK_ID_70_2120_009_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442478,
          "spk": "裕太 (ユータ)",
          "ja": "俺は昔から、大事にしたいものには",
          "tc": "我從以前就有幫重要的東西",
          "sc": "我从以前就有帮重要的东西"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442485,
          "spk": "裕太 (ユータ)",
          "ja": "名前をつけるようにしているんだ",
          "tc": "取名字的習慣。",
          "sc": "取名字的习惯。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442496,
          "spk": "裕太 (ユータ)",
          "ja": "名前があったほうが愛着も湧いて",
          "tc": "有名字就會更有感情，",
          "sc": "有名字就会更有感情，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442503,
          "spk": "裕太 (ユータ)",
          "ja": "友達みたいに思えるでしょ",
          "tc": "變得像朋友一樣。",
          "sc": "变得像朋友一样。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442521,
          "spk": "裕太 (ユータ)",
          "ja": "本当は、養蜂箱のミツバチたちにも",
          "tc": "其實我也很想幫",
          "sc": "其实我也很想帮"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442528,
          "spk": "裕太 (ユータ)",
          "ja": "名前をつけてあげたいんだけども……",
          "tc": "養蜂箱的蜜蜂取名字……",
          "sc": "养蜂箱的蜜蜂取名字……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442539,
          "spk": "裕太 (ユータ)",
          "ja": "まったく見分けがつかなくて",
          "tc": "但我實在是分不出誰是誰，",
          "sc": "但我实在是分不出谁是谁，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 442546,
          "spk": "裕太 (ユータ)",
          "ja": "諦めちゃったんだよね",
          "tc": "所以就只好放棄了。",
          "sc": "所以就只好放弃了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7685,
      "rec_id": "TALK_ID_70_2120_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442570,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>、よく来たね！",
          "tc": "啊，<player>你來啦！",
          "sc": "啊，<player>你来啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442577,
          "spk": "裕太 (ユータ)",
          "ja": "待ってたんだよ！",
          "tc": "等你很久了！",
          "sc": "等你很久了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442588,
          "spk": "裕太 (ユータ)",
          "ja": "こんな時間に、",
          "tc": "有人在這個時間來拜訪，",
          "sc": "有人在这个时间来拜访，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442595,
          "spk": "裕太 (ユータ)",
          "ja": "誰かが訪ねてくるなんて",
          "tc": "真是新鮮的感覺呢，",
          "sc": "真是新鲜的感觉呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442602,
          "spk": "裕太 (ユータ)",
          "ja": "新鮮で嬉しいよ",
          "tc": "我很開心喔。",
          "sc": "我很开心哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7686,
      "rec_id": "TALK_ID_70_2120_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442620,
          "spk": "裕太 (ユータ)",
          "ja": "ああ……これかい？",
          "tc": "哦……這個嗎？",
          "sc": "哦……这个吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442627,
          "spk": "裕太 (ユータ)",
          "ja": "キミが来るまで、少しだけ触ってたんだ",
          "tc": "在你來之前，我只是稍微碰一下。",
          "sc": "在你来之前，我只是稍微碰一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7687,
      "rec_id": "TALK_ID_70_2120_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442645,
          "spk": "裕太 (ユータ)",
          "ja": "これから、どう向き合えばいいのか……",
          "tc": "今後要怎麼面對大提琴……",
          "sc": "今后要怎么面对大提琴……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442652,
          "spk": "裕太 (ユータ)",
          "ja": "……ずっと考えててね",
          "tc": "……我一直都在思考這件事。",
          "sc": "……我一直都在思考这件事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442663,
          "spk": "裕太 (ユータ)",
          "ja": "チェロを弾くことが俺の価値だと信じてた……",
          "tc": "我曾經相信演奏大提琴就是我的價值……",
          "sc": "我曾经相信演奏大提琴就是我的价值……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442670,
          "spk": "裕太 (ユータ)",
          "ja": "だから、弾けなくなった俺には、",
          "tc": "所以，無法演奏大提琴的我",
          "sc": "所以，无法演奏大提琴的我"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442677,
          "spk": "裕太 (ユータ)",
          "ja": "存在価値がないと思ってた……",
          "tc": "就沒有存在價值了……",
          "sc": "就没有存在价值了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442688,
          "spk": "裕太 (ユータ)",
          "ja": "でも、彼ヶ津村に来て、暮して……",
          "tc": "但是，我來到彼津村、在這裡生活……",
          "sc": "但是，我来到彼津村、在这里生活……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442695,
          "spk": "裕太 (ユータ)",
          "ja": "色々な体験をして、知ったんだ",
          "tc": "經歷了各種事情之後，我了解到，",
          "sc": "经历了各种事情之后，我了解到，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 442713,
          "spk": "裕太 (ユータ)",
          "ja": "音楽を、辞めても辞めなくても、",
          "tc": "無論我會不會繼續碰音樂，",
          "sc": "无论我会不会继续碰音乐，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 442720,
          "spk": "裕太 (ユータ)",
          "ja": "俺の価値なんて、変わらないんだってことを",
          "tc": "都不會改變我的價值。",
          "sc": "都不会改变我的价值。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 442727,
          "spk": "裕太 (ユータ)",
          "ja": "何かを諦めても、人生は続いていくんだ……",
          "tc": "無論放棄了什麼，人生都會繼續下去……",
          "sc": "无论放弃了什么，人生都会继续下去……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 442738,
          "spk": "裕太 (ユータ)",
          "ja": "……うん、やっぱりしばらくは、",
          "tc": "……嗯，我想暫時",
          "sc": "……嗯，我想暂时"
        },
        {
          "f_idx": 12,
          "pidx_tc": 442745,
          "spk": "裕太 (ユータ)",
          "ja": "俺の大好きな彼ヶ津村の人たちに",
          "tc": "只要能讓我最喜歡的彼津村的人們",
          "sc": "只要能让我最喜欢的彼津村的人们"
        },
        {
          "f_idx": 13,
          "pidx_tc": 442752,
          "spk": "裕太 (ユータ)",
          "ja": "聞いてもらうだけで十分だね",
          "tc": "聽聽我的演奏就足夠了。",
          "sc": "听听我的演奏就足够了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 442763,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだから、一曲弾いてあげようか",
          "tc": "機會難得，演奏一首曲子給你聽吧。",
          "sc": "机会难得，演奏一首曲子给你听吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 442770,
          "spk": "裕太 (ユータ)",
          "ja": "もう夜だから、少しだけ静かに弾くけど",
          "tc": "夜晚降臨了，我會放低音量演奏，",
          "sc": "夜晚降临了，我会放低音量演奏，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 442777,
          "spk": "裕太 (ユータ)",
          "ja": "どんな曲がいい？",
          "tc": "你想聽什麼樣的曲子？",
          "sc": "你想听什么样的曲子？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7688,
      "rec_id": "TALK_ID_70_2120_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442801,
          "spk": "裕太 (ユータ)",
          "ja": "ふう……久しぶりに弾いて、ちょっと疲れたよ",
          "tc": "呼……好久沒演奏了，感覺有點累。",
          "sc": "呼……好久没演奏了，感觉有点累。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442808,
          "spk": "裕太 (ユータ)",
          "ja": "そろそろ寝る準備をしようか",
          "tc": "差不多該準備睡了。",
          "sc": "差不多该准备睡了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442826,
          "spk": "裕太 (ユータ)",
          "ja": "そうだ、アロマを炊いてるんだけど",
          "tc": "對了，我有點精油，",
          "sc": "对了，我有点精油，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442833,
          "spk": "裕太 (ユータ)",
          "ja": "苦手な匂いじゃないかな？",
          "tc": "你會討厭這個味道嗎？",
          "sc": "你会讨厌这个味道吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442844,
          "spk": "裕太 (ユータ)",
          "ja": "俺、いつも寝る前は",
          "tc": "我每天睡前",
          "sc": "我每天睡前"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442851,
          "spk": "裕太 (ユータ)",
          "ja": "アロマを炊くんだ",
          "tc": "都會點些精油來放鬆。",
          "sc": "都会点些精油来放松。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442862,
          "spk": "裕太 (ユータ)",
          "ja": "俺、彼ヶ津村が大好きだけど……",
          "tc": "雖然我很喜歡彼津村……",
          "sc": "虽然我很喜欢彼津村……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 442869,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱりどうしても",
          "tc": "但我果然還是",
          "sc": "但我果然还是"
        },
        {
          "f_idx": 9,
          "pidx_tc": 442876,
          "spk": "裕太 (ユータ)",
          "ja": "怪奇現象には慣れなくてさ……",
          "tc": "沒辦法習慣那些異常現象……",
          "sc": "没办法习惯那些异常现象……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 442887,
          "spk": "裕太 (ユータ)",
          "ja": "夜になると、どうしても",
          "tc": "每次一到晚上，",
          "sc": "每次一到晚上，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 442894,
          "spk": "裕太 (ユータ)",
          "ja": "怖いことを想像して",
          "tc": "就會忍不住想像一些恐怖的事，",
          "sc": "就会忍不住想像一些恐怖的事，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 442901,
          "spk": "裕太 (ユータ)",
          "ja": "眠れなくなることがあるんだ",
          "tc": "有時候根本就睡不著。",
          "sc": "有时候根本就睡不着。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 442912,
          "spk": "裕太 (ユータ)",
          "ja": "でも今夜は、アロマに加えて",
          "tc": "但是今晚不僅有精油的香氣，",
          "sc": "但是今晚不仅有精油的香气，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 442919,
          "spk": "裕太 (ユータ)",
          "ja": "キミもいてくれるからね",
          "tc": "還有你在身邊，",
          "sc": "还有你在身边，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 442926,
          "spk": "裕太 (ユータ)",
          "ja": "よく眠れそうで安心だよ",
          "tc": "感覺可以睡得很安穩呢。",
          "sc": "感觉可以睡得很安稳呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7689,
      "rec_id": "TALK_ID_70_2120_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442946,
          "spk": "裕太 (ユータ)",
          "ja": "ぐー……すぴすぴ……",
          "tc": "呼……呼……",
          "sc": "呼……呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442955,
          "spk": "裕太 (ユータ)",
          "ja": "うう……どうして……",
          "tc": "唔……為什麼……",
          "sc": "唔……为什么……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442962,
          "spk": "裕太 (ユータ)",
          "ja": "曲がったキュウリばっかり",
          "tc": "種出來的小黃瓜都長得",
          "sc": "种出来的黄瓜都长得"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442969,
          "spk": "裕太 (ユータ)",
          "ja": "生えてくる……むにゃむにゃ……",
          "tc": "歪七扭八的啊……嗯……",
          "sc": "歪七扭八的啊……嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7690,
      "rec_id": "TALK_ID_70_2120_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442985,
          "spk": "裕太 (ユータ)",
          "ja": "うわっ！？",
          "tc": "哇啊！？",
          "sc": "哇啊！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7691,
      "rec_id": "TALK_ID_70_2120_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443001,
          "spk": "裕太 (ユータ)",
          "ja": "ごめん、大声出して",
          "tc": "抱歉，我叫太大聲了，",
          "sc": "抱歉，我叫太大声了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443008,
          "spk": "裕太 (ユータ)",
          "ja": "起こしちゃった？",
          "tc": "吵醒你了嗎？",
          "sc": "吵醒你了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7692,
      "rec_id": "TALK_ID_70_2120_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443024,
          "spk": "裕太 (ユータ)",
          "ja": "そっか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443031,
          "spk": "裕太 (ユータ)",
          "ja": "すごい風だったね",
          "tc": "風好大啊，",
          "sc": "风好大啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443038,
          "spk": "裕太 (ユータ)",
          "ja": "ビックリしたよ",
          "tc": "害嚇了我一跳。",
          "sc": "害吓了我一跳。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7693,
      "rec_id": "TALK_ID_70_2120_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443054,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、落ち着いてるね",
          "tc": "<player>你很冷靜呢，",
          "sc": "<player>你很冷静呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443061,
          "spk": "裕太 (ユータ)",
          "ja": "俺のほうが全然年上なのに",
          "tc": "明明是我的年紀比較大，",
          "sc": "明明是我的年纪比较大，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443068,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと恥ずかしいな",
          "tc": "讓我感覺有點丟臉呢。",
          "sc": "让我感觉有点丢脸呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443077,
          "spk": "裕太 (ユータ)",
          "ja": "キミはいろんなことに動じないし自立してるし、",
          "tc": "你遇到事情都很冷靜，又很自立，",
          "sc": "你遇到事情都很冷静，又很自立，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443084,
          "spk": "裕太 (ユータ)",
          "ja": "俺よりよっぽど大人に見えるよ",
          "tc": "根本比我還要像大人。",
          "sc": "根本比我还要像大人。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443100,
          "spk": "裕太 (ユータ)",
          "ja": "キミならきっと何にでもなれるんだろうな",
          "tc": "我想你一定可以成為任何你想成為的人，",
          "sc": "我想你一定可以成为任何你想成为的人，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443107,
          "spk": "裕太 (ユータ)",
          "ja": "どんな夢でも叶えられると思う",
          "tc": "實現任何夢想的。",
          "sc": "实现任何梦想的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 443123,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、<player>には",
          "tc": "對了，<player>，",
          "sc": "对了，<player>，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 443130,
          "spk": "裕太 (ユータ)",
          "ja": "叶えたい夢があるの？",
          "tc": "你有想要實現的夢想嗎？",
          "sc": "你有想要实现的梦想吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 443139,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 443146,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7694,
      "rec_id": "TALK_ID_70_2120_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443254,
          "spk": "裕太 (ユータ)",
          "ja": "夢とか目標とか",
          "tc": "夢想也好，目標也罷，",
          "sc": "梦想也好，目标也罢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443261,
          "spk": "裕太 (ユータ)",
          "ja": "自分で決めるゴールはさ",
          "tc": "所謂的終點，",
          "sc": "所谓的终点，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443270,
          "spk": "裕太 (ユータ)",
          "ja": "一つだけじゃなくてもいいって",
          "tc": "有很多個也沒有關係。",
          "sc": "有很多个也没有关系。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443277,
          "spk": "裕太 (ユータ)",
          "ja": "この村に来てから気がついたんだ",
          "tc": "這是我來到了這個村子之後才明白的。",
          "sc": "这是我来到了这个村子之后才明白的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443286,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が来てからは",
          "tc": "自從<player>你來了之後，",
          "sc": "自从<player>你来了之后，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443293,
          "spk": "裕太 (ユータ)",
          "ja": "目の前の暮らしをただ楽しむっていうのも",
          "tc": "我就開始覺得享受當下的生活",
          "sc": "我就开始觉得享受当下的生活"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443300,
          "spk": "裕太 (ユータ)",
          "ja": "大事な夢の一つだって思えるようになったよ",
          "tc": "也是很重要的夢想呢。",
          "sc": "也是很重要的梦想呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443309,
          "spk": "裕太 (ユータ)",
          "ja": "一時期は、死ぬまでにやりたいことリストの",
          "tc": "曾經有段時間，",
          "sc": "曾经有段时间，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443316,
          "spk": "裕太 (ユータ)",
          "ja": "消化に追われるばっかりの時もあったけど",
          "tc": "我一心都只想著要完成死前願望清單。",
          "sc": "我一心都只想着要完成死前愿望清单。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 443332,
          "spk": "裕太 (ユータ)",
          "ja": "今は、もっとのんびり過ごすのも",
          "tc": "但現在覺得",
          "sc": "但现在觉得"
        },
        {
          "f_idx": 11,
          "pidx_tc": 443339,
          "spk": "裕太 (ユータ)",
          "ja": "いいかもしれないって思ってる",
          "tc": "悠悠哉哉地過日子或許也沒什麼不好的。",
          "sc": "悠悠哉哉地过日子或许也没什么不好的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 443355,
          "spk": "裕太 (ユータ)",
          "ja": "キミが釣りとか、虫取りとか、",
          "tc": "如果你想要釣魚、抓昆蟲，",
          "sc": "如果你想要钓鱼、抓昆虫，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 443362,
          "spk": "裕太 (ユータ)",
          "ja": "ただただお喋りをしたくなったら",
          "tc": "或者只是想找人說說話，",
          "sc": "或者只是想找人说说话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 443369,
          "spk": "裕太 (ユータ)",
          "ja": "俺、いつでも相手になるからね",
          "tc": "你都可以過來找我喔。",
          "sc": "你都可以过来找我哦。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 443378,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が楽しいことをしたいって",
          "tc": "如果在<player>想要享受生活的時候，",
          "sc": "如果在<player>想要享受生活的时候，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 443385,
          "spk": "裕太 (ユータ)",
          "ja": "思った時に、一緒に遊ぶ候補の",
          "tc": "我可以成為與你同樂的其中一個人選，",
          "sc": "我可以成为与你同乐的其中一个人选，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 443392,
          "spk": "裕太 (ユータ)",
          "ja": "一人に入れてくれたら嬉しいよ",
          "tc": "那我會很開心的。",
          "sc": "那我会很开心的。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 443401,
          "spk": "裕太 (ユータ)",
          "ja": "俺にとって、キミとの時間が",
          "tc": "我覺得跟你在一起的時候",
          "sc": "我觉得跟你在一起的时候"
        },
        {
          "f_idx": 20,
          "pidx_tc": 443408,
          "spk": "裕太 (ユータ)",
          "ja": "居心地のいいものであるみたいに",
          "tc": "真的很令人安心。",
          "sc": "真的很令人安心。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 443417,
          "spk": "裕太 (ユータ)",
          "ja": "キミにとっても、俺との時間が",
          "tc": "所以如果你也能覺得和我在一起的時候",
          "sc": "所以如果你也能觉得和我在一起的时候"
        },
        {
          "f_idx": 22,
          "pidx_tc": 443424,
          "spk": "裕太 (ユータ)",
          "ja": "居心地のいいものだったらいいな",
          "tc": "很放鬆的話，那就太好了。",
          "sc": "很放松的话，那就太好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7695,
      "rec_id": "TALK_ID_70_2120_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443451,
          "spk": "裕太 (ユータ)",
          "ja": "なんだか、眠れそうにないね",
          "tc": "總覺得好像一點都不睏呢。",
          "sc": "总觉得好像一点都不困呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443458,
          "spk": "裕太 (ユータ)",
          "ja": "キミも目が冴えてるんじゃない？",
          "tc": "你是不是精神也很好？",
          "sc": "你是不是精神也很好？"
        }
      ]
    },
    {
      "file": "talk.dat",
