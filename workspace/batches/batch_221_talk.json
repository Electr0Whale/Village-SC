  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5542,
      "rec_id": "TALK_ID_10_0503_302_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 324826,
          "spk": "四郎治 (シロージ)",
          "ja": "見てる側からしたら、",
          "tc": "但從旁觀者的角度來看，",
          "sc": "但从旁观者的角度来看，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 324833,
          "spk": "四郎治 (シロージ)",
          "ja": "いい加減諦めたらどうだって",
          "tc": "真的會忍不住想叫妳",
          "sc": "真的会忍不住想叫你"
        },
        {
          "f_idx": 2,
          "pidx_tc": 324840,
          "spk": "四郎治 (シロージ)",
          "ja": "言いたくもなるだろ",
          "tc": "差不多該放棄了。",
          "sc": "差不多该放弃了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 324853,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんでアンタまで",
          "tc": "怎麼連你也",
          "sc": "怎么连你也"
        },
        {
          "f_idx": 4,
          "pidx_tc": 324860,
          "spk": "茶梅 (サザンカ)",
          "ja": "他のみんなと同じこと言うかな～",
          "tc": "跟其他人說一樣的話～",
          "sc": "跟其他人说一样的话～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 324871,
          "spk": "茶梅 (サザンカ)",
          "ja": "どーせなら、応援してよ",
          "tc": "既然要講，",
          "sc": "既然要讲，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 324878,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんの埋蔵金は",
          "tc": "就應該聲援我才對啊。",
          "sc": "就应该声援我才对啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 324885,
          "spk": "茶梅 (サザンカ)",
          "ja": "必ずあるぞ～って",
          "tc": "比方說「爺爺的地下寶藏一定存在～」這樣。",
          "sc": "比方说“爷爷的地下宝藏一定存在～”这样。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 324898,
          "spk": "四郎治 (シロージ)",
          "ja": "いや、ないだろ",
          "tc": "不，應該不存在吧。",
          "sc": "不，应该不存在吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 324911,
          "spk": "茶梅 (サザンカ)",
          "ja": "はは、即答かよ～",
          "tc": "哈哈，居然馬上否定～",
          "sc": "哈哈，居然马上否定～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 324924,
          "spk": "四郎治 (シロージ)",
          "ja": "こんだけ何年も探して",
          "tc": "畢竟找了這麼多年",
          "sc": "毕竟找了这么多年"
        },
        {
          "f_idx": 11,
          "pidx_tc": 324931,
          "spk": "四郎治 (シロージ)",
          "ja": "見つからねぇんだぞ",
          "tc": "都沒找到啊。",
          "sc": "都没找到啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 324944,
          "spk": "茶梅 (サザンカ)",
          "ja": "何？　じいちゃんが",
          "tc": "所以你是怎麼了？",
          "sc": "所以你是怎么了？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 324951,
          "spk": "茶梅 (サザンカ)",
          "ja": "ホラ吹きヤローだって",
          "tc": "你想說我爺爺",
          "sc": "你想说我爷爷"
        },
        {
          "f_idx": 14,
          "pidx_tc": 324958,
          "spk": "茶梅 (サザンカ)",
          "ja": "言いたいの？",
          "tc": "是個愛吹牛的傢伙嗎？",
          "sc": "是个爱吹牛的家伙吗？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 324971,
          "spk": "四郎治 (シロージ)",
          "ja": "……そういうわけじゃねぇって",
          "tc": "……我又不是那個意思。",
          "sc": "……我又不是那个意思。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 324984,
          "spk": "茶梅 (サザンカ)",
          "ja": "だよね～",
          "tc": "我想也是～",
          "sc": "我想也是～"
        },
        {
          "f_idx": 17,
          "pidx_tc": 324991,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタ、うちのじいちゃんと",
          "tc": "畢竟你跟我爺爺",
          "sc": "毕竟你跟我爷爷"
        },
        {
          "f_idx": 18,
          "pidx_tc": 324998,
          "spk": "茶梅 (サザンカ)",
          "ja": "仲良かったもんね",
          "tc": "感情很好嘛。",
          "sc": "感情很好嘛。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 325009,
          "spk": "茶梅 (サザンカ)",
          "ja": "つーか、埋蔵金の話って",
          "tc": "話說四郎治～",
          "sc": "话说四郎治～"
        },
        {
          "f_idx": 20,
          "pidx_tc": 325016,
          "spk": "茶梅 (サザンカ)",
          "ja": "シロージ何か聞いてないの？",
          "tc": "爺爺有跟你提過關於地下寶藏的事嗎？",
          "sc": "爷爷有跟你提过关于地下宝藏的事吗？"
        },
        {
          "f_idx": 21,
          "pidx_tc": 325023,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんでもいいんだけど",
          "tc": "任何事都可以。",
          "sc": "任何事都可以。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 325036,
          "spk": "四郎治 (シロージ)",
          "ja": "聞いてねぇよ",
          "tc": "沒聽過。",
          "sc": "没听过。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 325043,
          "spk": "四郎治 (シロージ)",
          "ja": "……じゃーな",
          "tc": "……那我走了。",
          "sc": "……那我走了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5543,
      "rec_id": "TALK_ID_10_0503_302_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325061,
          "spk": "茶梅 (サザンカ)",
          "ja": "いやいや、ちょい待ち",
          "tc": "不不不，等一下。",
          "sc": "不不不，等一下。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325068,
          "spk": "茶梅 (サザンカ)",
          "ja": "何勝手に帰ろうとしてんの",
          "tc": "你怎麼說走就走啊？",
          "sc": "你怎么说走就走啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 325077,
          "spk": "茶梅 (サザンカ)",
          "ja": "こっちもアンタに",
          "tc": "我也有話",
          "sc": "我也有话"
        },
        {
          "f_idx": 3,
          "pidx_tc": 325084,
          "spk": "茶梅 (サザンカ)",
          "ja": "話したいことあるっつーの",
          "tc": "要跟你說耶～",
          "sc": "要跟你说呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5544,
      "rec_id": "TALK_ID_10_0503_302_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325102,
          "spk": "四郎治 (シロージ)",
          "ja": "なんだよ",
          "tc": "什麼話？",
          "sc": "什么话？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325115,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタ、なんでコマコを",
          "tc": "你為什麼不讓駒子",
          "sc": "你为什么不让驹子"
        },
        {
          "f_idx": 2,
          "pidx_tc": 325122,
          "spk": "茶梅 (サザンカ)",
          "ja": "藪に近づけさせないの？",
          "tc": "靠近那片草叢？",
          "sc": "靠近那片草丛？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 325133,
          "spk": "茶梅 (サザンカ)",
          "ja": "禁足地とか言ってんの",
          "tc": "把那裡當禁地的",
          "sc": "把那里当禁地的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 325140,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタとコマコくらいじゃん",
          "tc": "根本只有你跟駒子吧？",
          "sc": "根本只有你跟驹子吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 325153,
          "spk": "四郎治 (シロージ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 325166,
          "spk": "茶梅 (サザンカ)",
          "ja": "コマコも埋蔵金探しに",
          "tc": "我原本也想叫駒子",
          "sc": "我原本也想叫驹子"
        },
        {
          "f_idx": 7,
          "pidx_tc": 325173,
          "spk": "茶梅 (サザンカ)",
          "ja": "付き合ってもらおうと思ったのに",
          "tc": "陪我去尋找地下寶藏的。",
          "sc": "陪我去寻找地下宝藏的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 325184,
          "spk": "茶梅 (サザンカ)",
          "ja": "お兄ちゃんが行くなって言うからって",
          "tc": "結果她拒絕了我，",
          "sc": "结果她拒绝了我，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 325191,
          "spk": "茶梅 (サザンカ)",
          "ja": "フラれちゃったんだけど",
          "tc": "說哥哥叫她不能去。",
          "sc": "说哥哥叫她不能去。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 325198,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタ、過保護すぎない？",
          "tc": "你這樣是不是太過度保護了？",
          "sc": "你这样是不是太过度保护了？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 325207,
          "spk": "茶梅 (サザンカ)",
          "ja": "山を歩き慣れてるアンタたちにとって",
          "tc": "對你們這種習慣在山裡走動的人來說，",
          "sc": "对你们这种习惯在山里走动的人来说，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 325214,
          "spk": "茶梅 (サザンカ)",
          "ja": "危ない場所じゃないっしょ？",
          "tc": "那裡一點也不危險吧？",
          "sc": "那里一点也不危险吧？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 325234,
          "spk": "四郎治 (シロージ)",
          "ja": "本人が断ったんなら、",
          "tc": "既然她本人都拒絕妳了，",
          "sc": "既然她本人都拒绝你了，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 325241,
          "spk": "四郎治 (シロージ)",
          "ja": "それでいいだろ",
          "tc": "也沒什麼好說了吧。",
          "sc": "也没什么好说了吧。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 325248,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃ、俺は行くから",
          "tc": "那我先走了。",
          "sc": "那我先走了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 325261,
          "spk": "茶梅 (サザンカ)",
          "ja": "あっ、ちょっと",
          "tc": "啊，等一下啦。",
          "sc": "啊，等一下啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5545,
      "rec_id": "TALK_ID_10_0503_302_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325283,
          "spk": "茶梅 (サザンカ)",
          "ja": "ん～……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325290,
          "spk": "茶梅 (サザンカ)",
          "ja": "何かありそうなカンジ",
          "tc": "看來……",
          "sc": "看来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 325297,
          "spk": "茶梅 (サザンカ)",
          "ja": "するんだけどな～……",
          "tc": "似乎有什麼隱情呢……",
          "sc": "似乎有什么隐情呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5546,
      "rec_id": "TALK_ID_10_0503_303_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325317,
          "spk": "茶梅 (サザンカ)",
          "ja": "おっはよ～",
          "tc": "早安～",
          "sc": "早安～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5547,
      "rec_id": "TALK_ID_10_0503_303_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325337,
          "spk": "茶梅 (サザンカ)",
          "ja": "ダウジングマシンの調整、",
          "tc": "探測器已經",
          "sc": "探测器已经"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325344,
          "spk": "茶梅 (サザンカ)",
          "ja": "無事に終わったよ",
          "tc": "順利調整完畢了喔。",
          "sc": "顺利调整完毕了哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 325355,
          "spk": "茶梅 (サザンカ)",
          "ja": "ってことで、山の藪で",
          "tc": "所以，你會陪我到山上的草叢",
          "sc": "所以，你会陪我到山上的草丛"
        },
        {
          "f_idx": 3,
          "pidx_tc": 325362,
          "spk": "茶梅 (サザンカ)",
          "ja": "埋蔵金探しに付き合ってくれるんよね？",
          "tc": "尋找地下寶藏對吧？",
          "sc": "寻找地下宝藏对吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 325373,
          "spk": "茶梅 (サザンカ)",
          "ja": "どれくらい時間かかるか",
          "tc": "因為不曉得會",
          "sc": "因为不晓得会"
        },
        {
          "f_idx": 5,
          "pidx_tc": 325380,
          "spk": "茶梅 (サザンカ)",
          "ja": "わかんないからさ、",
          "tc": "花多少時間，",
          "sc": "花多少时间，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 325387,
          "spk": "茶梅 (サザンカ)",
          "ja": "お弁当作って行こうと思うんだ",
          "tc": "我打算做好便當帶去。",
          "sc": "我打算做好便当带去。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 325398,
          "spk": "茶梅 (サザンカ)",
          "ja": "もちろん、<player>の分もあるよ",
          "tc": "當然，也有<player>的份喔！",
          "sc": "当然，也有<player>的份哦！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 325405,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの手作り弁当とか、かなりレアだからね",
          "tc": "我親手做的便當可是很稀有的呢。",
          "sc": "我亲手做的便当可是很稀有的呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 325412,
          "spk": "茶梅 (サザンカ)",
          "ja": "楽しみにしといてよ",
          "tc": "敬請期待吧～",
          "sc": "敬请期待吧～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 325423,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、支度したら憑き藪まで来てくれる？",
          "tc": "那你準備好後，可以到附身草叢來找我嗎？",
          "sc": "那你准备好后，可以到附身草丛来找我吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 325430,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシは、午後5時ぐらいまでなら居るからさ",
          "tc": "我會在那裡待到下午五點左右。",
          "sc": "我会在那里待到下午五点左右。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5548,
      "rec_id": "TALK_ID_10_0503_303_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325461,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、よろしくね～",
          "tc": "那就麻煩你囉～",
          "sc": "那就麻烦你啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5549,
      "rec_id": "TALK_ID_10_0503_304_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325485,
          "spk": "茶梅 (サザンカ)",
          "ja": "お、来たね",
          "tc": "哦，你來啦。",
          "sc": "哦，你来啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325492,
          "spk": "茶梅 (サザンカ)",
          "ja": "手伝ってくれるんよね？",
          "tc": "你會幫忙的對吧？",
          "sc": "你会帮忙的对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5550,
      "rec_id": "TALK_ID_10_0503_304_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 325510,
          "spk": "茶梅 (サザンカ)",
          "ja": "見てよここ、",
          "tc": "你看這裡，",
          "sc": "你看这里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 325517,
          "spk": "茶梅 (サザンカ)",
          "ja": "すっごい荒れてるじゃない？",
          "tc": "亂得超誇張對不對？",
          "sc": "乱得超夸张对不对？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 325528,
          "spk": "茶梅 (サザンカ)",
          "ja": "この辺はシロージのヤツも",
          "tc": "因為四郎治那傢伙，",
          "sc": "因为四郎治那家伙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 325535,
          "spk": "茶梅 (サザンカ)",
          "ja": "あまり手を入れないみたいだからね",
          "tc": "好像也沒什麼在整理這一帶。",
          "sc": "好像也没什么在整理这一带。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5551,
