          "pidx_tc": 353481,
          "spk": "六角 (ロッカク)",
          "ja": "見守ってください",
          "tc": "讓她能夠健康平安長大。",
          "sc": "让她能够健康平安长大。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 353494,
          "spk": "名护 (ナゴ)",
          "ja": "村のみんなが平穏に、",
          "tc": "希望村子裡的大家，",
          "sc": "希望村子里的大家，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 353501,
          "spk": "名护 (ナゴ)",
          "ja": "幸せに暮らせますように",
          "tc": "都可以過得幸福安康。",
          "sc": "都可以过得幸福安康。"
        }
      ]
    },
