  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6026,
      "rec_id": "TALK_ID_10_0601_030_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352407,
          "spk": "堇怜 (スミレ)",
          "ja": "リン……元気そうだね",
          "tc": "林……妳看起來很有精神呢。",
          "sc": "林……你看起来很有精神呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352414,
          "spk": "堇怜 (スミレ)",
          "ja": "村を捨てるとかいう話をしている、",
          "tc": "在現在這種",
          "sc": "在现在这种"
        },
        {
          "f_idx": 2,
          "pidx_tc": 352421,
          "spk": "堇怜 (スミレ)",
          "ja": "こんな時に……",
          "tc": "正在討論要捨棄村子的話題時……",
          "sc": "正在讨论要舍弃村子的话题时……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 352434,
          "spk": "林 (リン)",
          "ja": "冗談じゃない",
          "tc": "開什麼玩笑。",
          "sc": "开什么玩笑。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 352441,
          "spk": "林 (リン)",
          "ja": "捨てたりなんかしないわよ",
          "tc": "我不會捨棄村子的。",
          "sc": "我不会舍弃村子的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 352456,
          "spk": "茶梅 (サザンカ)",
          "ja": "えっ……アンタこの前、",
          "tc": "咦……妳之前",
          "sc": "咦……你之前"
        },
        {
          "f_idx": 6,
          "pidx_tc": 352463,
          "spk": "茶梅 (サザンカ)",
          "ja": "村を出る覚悟をしろって言ってたじゃん",
          "tc": "不是要我們做好離開村子的心理準備嗎？",
          "sc": "不是要我们做好离开村子的心理准备吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 352474,
          "spk": "茶梅 (サザンカ)",
          "ja": "「土地神」ってヤツの祟りから逃れるために、",
          "tc": "說是為了逃離「土地神」那傢伙的作祟，",
          "sc": "说是为了逃离“土地神”那家伙的作祟，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 352481,
          "spk": "茶梅 (サザンカ)",
          "ja": "彼ヶ津村を終わらせるって……",
          "tc": "要終結彼津村……",
          "sc": "要终结彼津村……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 352501,
          "spk": "林 (リン)",
          "ja": "ここは私の村よ",
          "tc": "這裡是我的村子，",
          "sc": "这里是我的村子，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 352508,
          "spk": "林 (リン)",
          "ja": "終わらせるなんて、",
          "tc": "我是不可能",
          "sc": "我是不可能"
        },
        {
          "f_idx": 12,
          "pidx_tc": 352515,
          "spk": "林 (リン)",
          "ja": "この私が許すわけないじゃない",
          "tc": "終結這座村子的。",
          "sc": "终结这座村子的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 352528,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、またこの前みたいな原因不明の奇病に、",
          "tc": "可是，或許還會發生像之前那樣",
          "sc": "可是，或许还会发生像之前那样"
        },
        {
          "f_idx": 14,
          "pidx_tc": 352535,
          "spk": "堇怜 (スミレ)",
          "ja": "村の全員が侵されるかもしれないんだろ？",
          "tc": "全村都染上原因不明的怪病吧？",
          "sc": "全村都染上原因不明的怪病吧？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 352542,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、命を奪われる前に逃げないとって……",
          "tc": "所以說是得在喪命之前逃走啊……",
          "sc": "所以说是得在丧命之前逃走啊……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 352555,
          "spk": "林 (リン)",
          "ja": "……奇病？",
          "tc": "……怪病？",
          "sc": "……怪病？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 352562,
          "spk": "林 (リン)",
          "ja": "……祟り？",
          "tc": "……作祟？",
          "sc": "……作祟？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 352573,
          "spk": "林 (リン)",
          "ja": "上等じゃない",
          "tc": "那不是正好。",
          "sc": "那不是正好。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 352580,
          "spk": "林 (リン)",
          "ja": "奪われるくらいなら、奪い返すわ",
          "tc": "要是被奪走，就奪回來。",
          "sc": "要是被夺走，就夺回来。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 352600,
          "spk": "茶梅 (サザンカ)",
          "ja": "……リン、アンタ本気で言ってんの？",
          "tc": "……林，妳說這些話是認真的嗎？",
          "sc": "……林，你说这些话是认真的吗？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 352607,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシたちを何に巻き込もうとしてるってワケ？",
          "tc": "妳是打算把我們捲入什麼事裡啊？",
          "sc": "你是打算把我们卷入什么事里啊？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 352620,
          "spk": "林 (リン)",
          "ja": "ふん、あなたたちの不安も、恐れも、",
          "tc": "嗯～你們的不安也好，恐懼也罷，",
          "sc": "嗯～你们的不安也好，恐惧也罢，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 352627,
          "spk": "林 (リン)",
          "ja": "全部私が引き受けるわよ",
          "tc": "全都由我來承擔。",
          "sc": "全都由我来承担。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 352645,
          "spk": "林 (リン)",
          "ja": "言いたいことがあれば、言えばいいわ",
          "tc": "有想說的話就說出來，",
          "sc": "有想说的话就说出来，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 352652,
          "spk": "林 (リン)",
          "ja": "村から出て行ったっていい",
          "tc": "想要離開村子也可以。",
          "sc": "想要离开村子也可以。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 352670,
          "spk": "林 (リン)",
          "ja": "でも、大丈夫",
          "tc": "不過，放心。",
          "sc": "不过，放心。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 352677,
          "spk": "林 (リン)",
          "ja": "私が絶対に終わらせないから",
          "tc": "我絕對不會讓村子終結的。",
          "sc": "我绝对不会让村子终结的。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 352690,
          "spk": "堇怜 (スミレ)",
          "ja": "……リン",
          "tc": "……林。",
          "sc": "……林。"
        },
        {
          "f_idx": 32,
          "pidx_tc": 352703,
          "spk": "林 (リン)",
          "ja": "私を信じてここにいるなら、",
          "tc": "如果相信我而留在這裡，",
          "sc": "如果相信我而留在这里，"
        },
        {
          "f_idx": 33,
          "pidx_tc": 352710,
          "spk": "林 (リン)",
          "ja": "最後まで付き合ってもらうわよ",
          "tc": "就陪我到最後吧。",
          "sc": "就陪我到最后吧。"
        },
        {
          "f_idx": 34,
          "pidx_tc": 352723,
          "spk": "茶梅 (サザンカ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 35,
          "pidx_tc": 352736,
          "spk": "林 (リン)",
          "ja": "じゃ、私は忙しいから",
          "tc": "我很忙，",
          "sc": "我很忙，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 352743,
          "spk": "林 (リン)",
          "ja": "またね",
          "tc": "下次再見。",
          "sc": "下次再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6027,
      "rec_id": "TALK_ID_10_0601_030_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352765,
          "spk": "堇怜 (スミレ)",
          "ja": "……ふ、振り回されるなぁ、ホント",
          "tc": "……又、又被她擺了一道欸，真的是。",
          "sc": "……又、又被她摆了一道诶，真的是。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352778,
          "spk": "茶梅 (サザンカ)",
          "ja": "リンはやっぱりこうじゃなくっちゃね",
          "tc": "果然林就是這樣的人。",
          "sc": "果然林就是这样的人。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6028,
      "rec_id": "TALK_ID_10_0601_031_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352817,
          "spk": "堇怜 (スミレ)",
          "ja": "それ、もうちょっと右にあったんじゃないか？",
          "tc": "那個原本是不是要再靠右邊一點啊？",
          "sc": "那个原本是不是要再靠右边一点啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352830,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……こ、こうかな？",
          "tc": "欸……這、這樣嗎？",
          "sc": "诶……这、这样吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 352843,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、前よりも綺麗に見えるっス",
          "tc": "哇，看起來比之前更漂亮了。",
          "sc": "哇，看起来比之前更漂亮呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 352850,
          "spk": "六角 (ロッカク)",
          "ja": "神さまも許してくれるでしょ",
          "tc": "神明大人應該也會原諒我們了吧。",
          "sc": "神明大人应该也会原谅我们了吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 352863,
          "spk": "名护 (ナゴ)",
          "ja": "そんな適当でいいのかな……",
          "tc": "這樣隨便弄真的沒關係嗎……",
          "sc": "这样随便弄真的没关系吗……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 352870,
          "spk": "名护 (ナゴ)",
          "ja": "なにか、作法とかあるんじゃ……",
          "tc": "應該還是有什麼儀式規範的吧……",
          "sc": "应该还是有什么仪式规范的吧……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 352890,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が直してたんだよ",
          "tc": "這可是<player>修建的耶！",
          "sc": "这可是<player>修建的呢！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 352897,
          "spk": "堇怜 (スミレ)",
          "ja": "ある程度適当でも、神さまは許してくれるさ",
          "tc": "就算稍微隨便了點，神明大人也會原諒我們啦。",
          "sc": "就算稍微随便了点，神明大人也会原谅我们啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6029,
      "rec_id": "TALK_ID_10_0601_031_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352922,
          "spk": "名护 (ナゴ)",
          "ja": "……あ、噂をすれば",
          "tc": "……啊，才剛提到人就來了，",
          "sc": "……啊，才刚提到人就来了，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6030,
      "rec_id": "TALK_ID_10_0601_031_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352946,
          "spk": "驹子 (コマコ)",
          "ja": "<player>！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352953,
          "spk": "驹子 (コマコ)",
          "ja": "おはよう！",
          "tc": "早安！",
          "sc": "早安！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6031,
      "rec_id": "TALK_ID_10_0601_031_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352973,
          "spk": "堇怜 (スミレ)",
          "ja": "今僕たちで、",
          "tc": "我們正在修",
          "sc": "我们正在修"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352980,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>の祠を直してたんだよ",
          "tc": "<player>的祠堂喔！",
          "sc": "<player>的祠堂哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6032,
      "rec_id": "TALK_ID_10_0601_031_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352998,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、見てみて",
          "tc": "來，你看看。",
          "sc": "来，你看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6033,
      "rec_id": "TALK_ID_10_0601_031_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353034,
          "spk": "名护 (ナゴ)",
          "ja": "どうだろう？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6034,
      "rec_id": "TALK_ID_10_0601_031_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353052,
          "spk": "名护 (ナゴ)",
          "ja": "キスケさんほどじゃないけど、",
          "tc": "雖然比不上木助先生，",
          "sc": "虽然比不上木助先生，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 353059,
          "spk": "名护 (ナゴ)",
          "ja": "なかなかの出来栄えじゃないかい？",
          "tc": "但還是修復得很不錯吧？",
          "sc": "但还是修复得很不错吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353077,
          "spk": "名护 (ナゴ)",
          "ja": "あ、この少し傾いた柱はユータさん作だよ",
          "tc": "啊，那個有點歪的柱子是裕太先生做的喔！",
          "sc": "啊，那个有点歪的柱子是裕太先生做的哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 353095,
          "spk": "名护 (ナゴ)",
          "ja": "立ててみたら傾いちゃったんだが……",
          "tc": "立起來之後才發現是歪的……",
          "sc": "立起来之后才发现是歪的……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 353102,
          "spk": "名护 (ナゴ)",
          "ja": "これはこれで、味があっていいかなと思ってね",
          "tc": "但我想說這樣也別有一番風情，",
          "sc": "但我想说这样也别有一番风情，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 353109,
          "spk": "名护 (ナゴ)",
          "ja": "そのまま建てておくことにしたんだ",
          "tc": "就決定繼續留著了。",
          "sc": "就决定继续留着了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6035,
      "rec_id": "TALK_ID_10_0601_031_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 353127,
          "spk": "六角 (ロッカク)",
          "ja": "……<player>さん",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 353134,
          "spk": "六角 (ロッカク)",
          "ja": "ワシら、この村から離れることは、",
          "tc": "我們決定，",
          "sc": "我们决定，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 353141,
          "spk": "六角 (ロッカク)",
          "ja": "考えないようにしたんスよ",
          "tc": "不再考慮離開這座村子了。",
          "sc": "不再考虑离开这座村子了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 353154,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱり僕たち、この彼ヶ津村が好きなんだ",
          "tc": "我們果然還是喜歡這座彼津村。",
          "sc": "我们果然还是喜欢这座彼津村。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 353161,
          "spk": "堇怜 (スミレ)",
          "ja": "だからリンの言うように、",
          "tc": "所以就像林說的，",
          "sc": "所以就像林说的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 353168,
          "spk": "堇怜 (スミレ)",
          "ja": "簡単に諦めるべきじゃないって思ってね",
          "tc": "我覺得我們不應該輕易放棄。",
          "sc": "我觉得我们不应该轻易放弃。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 353181,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんのためを思うなら、",
          "tc": "我想說，如果真是為了洋妹妹著想，",
          "sc": "我想说，如果真是为了洋妹妹着想，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 353188,
          "spk": "六角 (ロッカク)",
          "ja": "ワシもこの場所で、できる限りやれることを",
          "tc": "我也該在這個地方，",
          "sc": "我也该在这个地方，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 353195,
          "spk": "六角 (ロッカク)",
          "ja": "やってみようと思いまして",
          "tc": "盡力嘗試自己所能做的。",
          "sc": "尽力尝试自己所能做的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 353208,
          "spk": "驹子 (コマコ)",
          "ja": "それで、元の暮らしを取り戻すために、",
          "tc": "然後，名護先生就提議說……",
          "sc": "然后，名护先生就提议说……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 353215,
          "spk": "驹子 (コマコ)",
          "ja": "まずは壊れた物を直すところから始めようって",
          "tc": "為了找回我們原本的生活，",
          "sc": "为了找回我们原本的生活，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 353222,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんが言い出して……",
          "tc": "就從修好壞掉的東西開始吧。",
          "sc": "就从修好坏掉的东西开始吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 353237,
          "spk": "名护 (ナゴ)",
          "ja": "この村のことだ",
          "tc": "畢竟是這座村子。",
          "sc": "毕竟是这座村子。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 353244,
          "spk": "名护 (ナゴ)",
          "ja": "また説明できない理不尽なことが、",
          "tc": "以後說不定還會再發生",
          "sc": "以后说不定还会再发生"
        },
        {
          "f_idx": 14,
          "pidx_tc": 353251,
          "spk": "名护 (ナゴ)",
          "ja": "起こるかもしれない",
          "tc": "無從解釋的荒謬事情。",
          "sc": "无从解释的荒谬事情。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 353260,
          "spk": "名护 (ナゴ)",
          "ja": "安全な暮らしは、",
          "tc": "想到得到安全的生活，",
          "sc": "想到得到安全的生活，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 353267,
          "spk": "名护 (ナゴ)",
          "ja": "簡単には手に入らないかもしれない",
          "tc": "或許並不容易。",
          "sc": "或许并不容易。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 353278,
          "spk": "名护 (ナゴ)",
          "ja": "それでも彼ヶ津村は、",
          "tc": "即使如此，彼津村這個地方，",
          "sc": "即使如此，彼津村这个地方，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 353285,
          "spk": "名护 (ナゴ)",
          "ja": "理不尽に抵抗するだけの価値がある場所だ",
          "tc": "仍然值得我們為了它與不合理對抗。",
          "sc": "仍然值得我们为了它与不合理对抗。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 353296,
          "spk": "名护 (ナゴ)",
          "ja": "だから、みんなで協力して、",
          "tc": "所以我才想說，大家可以同心協力，",
          "sc": "所以我才想说，大家可以同心协力，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 353303,
          "spk": "名护 (ナゴ)",
          "ja": "今できることから始めようと思ってね",
          "tc": "從現在能做的事開始行動。",
          "sc": "从现在能做的事开始行动。"
        }
      ]
    },
    {
      "file": "talk.dat",
