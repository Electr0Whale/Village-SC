          "f_idx": 4,
          "pidx_tc": 353474,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが健やかに成長できるよう、",
          "tc": "請守護洋妹妹，",
          "sc": "请守护洋妹妹，"
        },
        {
