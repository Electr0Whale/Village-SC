      "file": "talk.dat",
      "rec_idx": 6056,
      "rec_id": "TALK_ID_10_0602_053_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354101,
          "spk": "木助 (キスケ)",
          "ja": "<player>！　危ねぇ！！",
          "tc": "<player>！危險！！",
          "sc": "<player>！危险！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354108,
          "spk": "木助 (キスケ)",
          "ja": "早く渡れ！",
          "tc": "快點過橋！",
          "sc": "快点过桥！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6057,
      "rec_id": "TALK_ID_10_0602_053_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354132,
          "spk": "木助 (キスケ)",
          "ja": "……ちくしょう、何だ今のは",
          "tc": "……可惡，剛才那是什麼？",
          "sc": "……可恶，刚才那是什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354139,
          "spk": "木助 (キスケ)",
          "ja": "ただの地震……じゃねえだろうな",
          "tc": "感覺不是一般的地震……",
          "sc": "感觉不是一般的地震……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354150,
          "spk": "木助 (キスケ)",
          "ja": "コダマか土地神の仕業か知らねえが、",
          "tc": "雖然不曉得是木珠還是土地神搞的鬼，",
          "sc": "虽然不晓得是木珠还是土地神搞的鬼，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354157,
          "spk": "木助 (キスケ)",
          "ja": "早いところ黙らせねぇと",
          "tc": "得早點讓祂們安靜下來才行。",
          "sc": "得早点让他们安静下来才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6058,
      "rec_id": "TALK_ID_10_0602_053_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354182,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ……行くか",
          "tc": "那麼……走吧。",
          "sc": "那么……走吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6059,
      "rec_id": "TALK_ID_10_0602_053_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354206,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもよく知ってるだろ",
          "tc": "你也很清楚吧，",
          "sc": "你也很清楚吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354213,
          "spk": "木助 (キスケ)",
          "ja": "大穴はすぐそこだぜ",
          "tc": "大洞就在前面。",
          "sc": "大洞就在前面。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354224,
          "spk": "木助 (キスケ)",
          "ja": "ここまで来たんだ",
          "tc": "都來到這裡了，",
          "sc": "都来到这里了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354231,
          "spk": "木助 (キスケ)",
          "ja": "やっぱり帰るとか言うなよ？",
          "tc": "你可別說算了要回去喔？",
          "sc": "你可别说算了要回去啊？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354249,
          "spk": "木助 (キスケ)",
          "ja": "悪いが最後まで付き合ってもらう",
          "tc": "抱歉，就陪我到最後吧。",
          "sc": "抱歉，就陪我到最后吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 354256,
          "spk": "木助 (キスケ)",
          "ja": "頼むぜ、<player>",
          "tc": "拜託囉，<player>。",
          "sc": "拜托啦，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6060,
      "rec_id": "TALK_ID_10_0602_053_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354282,
          "spk": "木助 (キスケ)",
          "ja": "二十年前……",
          "tc": "二十年前……",
          "sc": "二十年前……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354289,
          "spk": "木助 (キスケ)",
          "ja": "この道を歩いた日のことを、よく覚えてるぜ",
          "tc": "走在這條路上的記憶，還歷歷在目。",
          "sc": "走在这条路上的记忆，还历历在目。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354307,
          "spk": "木助 (キスケ)",
          "ja": "あの時、俺はまだ死を受け入れられなかった……",
          "tc": "那時，我還沒有做好接受死亡的心理準備……",
          "sc": "那时，我还没有做好接受死亡的心理准备……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 354314,
          "spk": "木助 (キスケ)",
          "ja": "そして腹を括れないうちに、",
          "tc": "然後在我下定決心前，",
          "sc": "然后在我下定决心前，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354321,
          "spk": "木助 (キスケ)",
          "ja": "取り返しのつかねぇことになっちまった……",
          "tc": "就發生了無可挽回的事情……",
          "sc": "就发生了无可挽回的事情……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 354332,
          "spk": "木助 (キスケ)",
          "ja": "……ああ、そうだな",
          "tc": "……對，沒錯。",
          "sc": "……对，没错。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 354339,
          "spk": "木助 (キスケ)",
          "ja": "これから取り返しに行くんだったな",
          "tc": "現在就是要去挽回過錯。",
          "sc": "现在就是要去挽回过错。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6061,
      "rec_id": "TALK_ID_10_0602_053_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354365,
          "spk": "木助 (キスケ)",
          "ja": "……どうした、不安か？",
          "tc": "……怎麼了？覺得不安嗎？",
          "sc": "……怎么了？觉得不安吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354376,
          "spk": "木助 (キスケ)",
          "ja": "はは、てめぇでもビビることがあるんだな",
          "tc": "哈哈，你也會有害怕的事情啊。",
          "sc": "哈哈，你也会有害怕的事情啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354383,
          "spk": "木助 (キスケ)",
          "ja": "実は俺も、さっきから心臓が痛てぇんだ",
          "tc": "其實我從剛才就緊張到心臟痛。",
          "sc": "其实我从刚才就紧张到心脏痛。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 354401,
          "spk": "木助 (キスケ)",
          "ja": "でも、大丈夫だ",
          "tc": "不過，放心。",
          "sc": "不过，放心。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354408,
          "spk": "木助 (キスケ)",
          "ja": "きっとうまくいくさ",
          "tc": "一定會順利的。",
          "sc": "一定会顺利的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6062,
      "rec_id": "TALK_ID_10_0602_053_50",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354432,
          "spk": "木助 (キスケ)",
          "ja": "おいコラ",
          "tc": "喂，搞什麼！",
          "sc": "喂，搞什么！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354439,
          "spk": "木助 (キスケ)",
          "ja": "覚悟、決めたんじゃねえのかよ",
          "tc": "你沒有做好覺悟嗎！？",
          "sc": "你没有做好觉悟吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354450,
          "spk": "木助 (キスケ)",
          "ja": "ここまで来たんだ",
          "tc": "都來到這裡了，",
          "sc": "都来到这里了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354457,
          "spk": "木助 (キスケ)",
          "ja": "悪いがもう少し付き合ってもらうぜ",
          "tc": "抱歉，就陪我到最後吧。",
          "sc": "抱歉，就陪我到最后吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354475,
          "spk": "木助 (キスケ)",
          "ja": "……行くぞ、あの大穴へ",
          "tc": "……走吧，前往大洞。",
          "sc": "……走吧，前往大洞。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6063,
      "rec_id": "TALK_ID_10_0602_054_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354499,
          "spk": "木助 (キスケ)",
          "ja": "またここに",
          "tc": "又再次……",
          "sc": "又再次……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354506,
          "spk": "木助 (キスケ)",
          "ja": "戻ってきちまったな",
          "tc": "回到這個地方了呢。",
          "sc": "回到这个地方了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354515,
          "spk": "木助 (キスケ)",
          "ja": "ここにはいい思い出がないんだが……",
          "tc": "我對這裡可沒有什麼好印象……",
          "sc": "我对这里可没有什么好印象……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6064,
      "rec_id": "TALK_ID_10_0602_054_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354540,
          "spk": "木助 (キスケ)",
          "ja": "覚えているだろ、",
          "tc": "你應該還記得吧？",
          "sc": "你应该还记得吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354547,
          "spk": "木助 (キスケ)",
          "ja": "この前の祟りが暴走した時のことを",
          "tc": "之前作祟失控時的事。",
          "sc": "之前作祟失控时的事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354554,
          "spk": "木助 (キスケ)",
          "ja": "土地神を封じるために、一緒に岩を押したよな",
          "tc": "為了封印土地神，我們一起推過岩石呢。",
          "sc": "为了封印土地神，我们一起推过岩石呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6065,
      "rec_id": "TALK_ID_10_0602_054_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354572,
          "spk": "木助 (キスケ)",
          "ja": "岩が動いたのは、ヅ主の力じゃない",
          "tc": "當時岩石之所以動了，應該不是津主的力量，",
          "sc": "当时岩石之所以动了，应该不是津主的力量，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354579,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの力だったんだろ？",
          "tc": "而是你的力量對吧？",
          "sc": "而是你的力量对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354586,
          "spk": "木助 (キスケ)",
          "ja": "だから、てめぇなら簡単に退かせるはず……",
          "tc": "所以，你應該能輕易把它移開……",
          "sc": "所以，你应该能轻易把它移开……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354597,
          "spk": "木助 (キスケ)",
          "ja": "俺の願いは必要か？",
          "tc": "需要我向你許願嗎？",
          "sc": "需要我向你许愿吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 354606,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354613,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6066,
      "rec_id": "TALK_ID_10_0602_054_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354732,
          "spk": "木助 (キスケ)",
          "ja": "ハァ、ハァ……",
          "tc": "呼、呼……",
          "sc": "呼、呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354739,
          "spk": "木助 (キスケ)",
          "ja": "よし……ありがとうな、<player>",
          "tc": "好……謝啦，<player>。",
          "sc": "好……谢啦，<player>。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354750,
          "spk": "木助 (キスケ)",
          "ja": "……さて",
          "tc": "……好了，",
          "sc": "……好了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354757,
          "spk": "木助 (キスケ)",
          "ja": "二十年も経っちまった……",
          "tc": "事情都已經過了二十年……",
          "sc": "事情都已经过了二十年……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 354764,
          "spk": "木助 (キスケ)",
          "ja": "いい加減、しがらみを解かないとな",
          "tc": "也差不多該解開糾葛才行了。",
          "sc": "也差不多该解开纠葛才行了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6067,
      "rec_id": "TALK_ID_10_0602_054_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354782,
          "spk": "木助 (キスケ)",
          "ja": "ロープを持って来たんだ",
          "tc": "我帶了繩子過來。",
          "sc": "我带了绳子过来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6068,
      "rec_id": "TALK_ID_10_0602_054_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354806,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ、ロープは降りれるか？",
          "tc": "你有辦法抓著繩子下去嗎？",
          "sc": "你有办法抓着绳子下去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6069,
      "rec_id": "TALK_ID_10_0602_054_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354824,
          "spk": "木助 (キスケ)",
          "ja": "よし、じゃあついてきてくれ",
          "tc": "好，那就跟我來吧。",
          "sc": "好，那就跟我来吧。"
        }
      ]
    }
  ]
