          "pidx_tc": 191890,
          "spk": "？？？ (未知角色)",
          "ja": "しばかれるかもしれへんし",
          "tc": "搞不好會被修理一頓。",
          "sc": "说不定会被修理一顿。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 191899,
