      "rec_id": "TALK_ID_60_0015_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 191752,
          "spk": "？？？ (未知角色)",
          "ja": "おんやぁ……",
          "tc": "哦……",
          "sc": "哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 191759,
          "spk": "？？？ (未知角色)",
          "ja": "ニンゲンのガキやん",
          "tc": "是人類小孩呢。",
          "sc": "是人类小孩呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 191766,
          "spk": "？？？ (未知角色)",
          "ja": "なにしてはんの？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 191775,
          "spk": "？？？ (未知角色)",
          "ja": "こんな時間に出歩いて",
          "tc": "在這種時間跑到外面來，",
          "sc": "在这种时间跑到外面来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 191782,
          "spk": "？？？ (未知角色)",
          "ja": "妖怪が怖くないんかいな？",
          "tc": "你不怕碰到妖怪嗎？",
          "sc": "你不怕碰到妖怪吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 191791,
          "spk": "？？？ (未知角色)",
          "ja": "……変わっとんなぁ、まあええわ",
          "tc": "……真是個怪孩子，不過算了。",
          "sc": "……真是个怪孩子，不过算了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 191798,
          "spk": "？？？ (未知角色)",
          "ja": "せっかくやし、ウチの頼みを聞いてくれへん？",
          "tc": "難得遇見人類，你能幫我個忙嗎？",
          "sc": "难得遇见人类，你能帮我个忙吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 191814,
          "spk": "？？？ (未知角色)",
          "ja": "ウチな、魚が好きやねん",
          "tc": "我很愛吃魚呢。",
          "sc": "我很爱吃鱼呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 191821,
          "spk": "？？？ (未知角色)",
          "ja": "せやからあんさんにたくさん獲ってきて",
          "tc": "所以想請你幫忙",
          "sc": "所以想请你帮忙"
        },
        {
          "f_idx": 10,
          "pidx_tc": 191828,
          "spk": "？？？ (未知角色)",
          "ja": "ほしいんや",
          "tc": "多抓一點魚給我。",
          "sc": "多抓一点鱼给我。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 191837,
          "spk": "？？？ (未知角色)",
          "ja": "どんな魚でもええから、",
          "tc": "什麼魚都可以，",
          "sc": "什么鱼都可以，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 191844,
          "spk": "？？？ (未知角色)",
          "ja": "なるたけ活きのええヤツを頼むわ",
          "tc": "盡量抓新鮮一點的就好。",
          "sc": "尽量抓新鲜一点的就好。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 191853,
          "spk": "？？？ (未知角色)",
          "ja": "自分で獲れって？",
          "tc": "叫我自己去抓？",
          "sc": "叫我自己去抓？"
