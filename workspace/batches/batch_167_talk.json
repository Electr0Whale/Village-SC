        {
          "f_idx": 14,
          "pidx_tc": 191860,
          "spk": "？？？ (未知角色)",
          "ja": "そんなんできひんわぁ",
          "tc": "那可不成～",
          "sc": "那可不成～"
        },
        {
          "f_idx": 15,
          "pidx_tc": 191867,
          "spk": "？？？ (未知角色)",
          "ja": "ウチのきれいな毛並みが台無しになるやろ？",
          "tc": "豈不是毀了我這身漂亮的毛嗎？",
          "sc": "岂不是毁了我这身漂亮的毛吗？"
        },
