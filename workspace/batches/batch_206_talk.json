        },
        {
          "f_idx": 4,
          "pidx_tc": 292674,
          "spk": "木助 (キスケ)",
          "ja": "それでどうして俺が犯人だと……",
          "tc": "再說為什麼我會是犯人……",
          "sc": "再说为什么我会是犯人……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 292687,
          "spk": "帷 (トバリ)",
          "ja": "アンタは、コダマを知ってる様子だったし",
          "tc": "當時我看你好像認識木珠，",
          "sc": "当时我看你好像认识木珠，"
        }
      ]
    },
    {
