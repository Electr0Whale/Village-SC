  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5014,
      "rec_id": "TALK_ID_10_0500_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290370,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、それが見つかれば、",
          "tc": "意思是，只要找到神器，",
          "sc": "意思是，只要找到神器，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290377,
          "spk": "驹子 (コマコ)",
          "ja": "もうあんなことは……",
          "tc": "就不會再發生那種事……",
          "sc": "就不会再发生那种事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5015,
      "rec_id": "TALK_ID_10_0500_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290397,
          "spk": "驹子 (コマコ)",
          "ja": "……<player>",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290404,
          "spk": "驹子 (コマコ)",
          "ja": "キミもコダマから聞いたの？",
          "tc": "你也聽木珠說過了嗎？",
          "sc": "你也听木珠说过了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 290411,
          "spk": "驹子 (コマコ)",
          "ja": "神器の話を……",
          "tc": "關於神器的事……",
          "sc": "关于神器的事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 290424,
          "spk": "帷 (トバリ)",
          "ja": "コダマは三つの神器が揃えば、",
          "tc": "木珠說，只要湊齊三件神器，",
          "sc": "木珠说，只要凑齐三件神器，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 290431,
          "spk": "帷 (トバリ)",
          "ja": "神を殺せるかもしれないって言ってた",
          "tc": "說不定就能殺死神明了。",
          "sc": "说不定就能杀死神明了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 290442,
          "spk": "帷 (トバリ)",
          "ja": "ただ……コダマの生きてた頃の話よね",
          "tc": "只不過……那是木珠還活著的時候說的。",
          "sc": "只不过……那是木珠还活着的时候说的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 290449,
          "spk": "帷 (トバリ)",
          "ja": "今もまだ、村の何処かにあるものなのか……",
          "tc": "不知道現在是不是還藏在村裡的某個地方……",
          "sc": "不知道现在是不是还藏在村里的某个地方……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 290469,
          "spk": "驹子 (コマコ)",
          "ja": "私も、神器なんてものが村にあるなんて、",
          "tc": "但是，我從沒聽過村子裡",
          "sc": "但是，我从没听过村子里"
        },
        {
          "f_idx": 9,
          "pidx_tc": 290476,
          "spk": "驹子 (コマコ)",
          "ja": "聞いたことがないよ……",
          "tc": "有什麼神器……",
          "sc": "有什么神器……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5016,
      "rec_id": "TALK_ID_10_0500_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290494,
          "spk": "驹子 (コマコ)",
          "ja": "トバリは……神器を探すの？",
          "tc": "帷……妳要尋找神器嗎？",
          "sc": "帷……你要寻找神器吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5017,
      "rec_id": "TALK_ID_10_0500_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290512,
          "spk": "帷 (トバリ)",
          "ja": "……私は",
          "tc": "我……",
          "sc": "我……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290519,
          "spk": "帷 (トバリ)",
          "ja": "……悩んでる",
          "tc": "……正在煩惱。",
          "sc": "……正在烦恼。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 290530,
          "spk": "帷 (トバリ)",
          "ja": "そりゃ、村の秘密だなんて、",
          "tc": "我當然很想揭露",
          "sc": "我当然很想揭露"
        },
        {
          "f_idx": 3,
          "pidx_tc": 290537,
          "spk": "帷 (トバリ)",
          "ja": "暴いてやりたいとは思うけど",
          "tc": "村子的祕密。",
          "sc": "村子的秘密。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 290555,
          "spk": "帷 (トバリ)",
          "ja": "こないだのこともあって、",
          "tc": "但上次發生了那件事後，",
          "sc": "但上次发生了那件事后，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 290562,
          "spk": "帷 (トバリ)",
          "ja": "ちょっと怖いと言うか……",
          "tc": "我總覺得有點害怕……",
          "sc": "我总觉得有点害怕……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5018,
      "rec_id": "TALK_ID_10_0500_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290580,
          "spk": "帷 (トバリ)",
          "ja": "でも、アンタが食いついてくるなんて",
          "tc": "不過妳居然會感興趣，",
          "sc": "不过你居然会感兴趣，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290587,
          "spk": "帷 (トバリ)",
          "ja": "正直意外だった",
          "tc": "老實說我滿意外的。",
          "sc": "老实说我满意外的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 290607,
          "spk": "驹子 (コマコ)",
          "ja": "……そうかな",
          "tc": "……是這樣嗎？",
          "sc": "……是这样吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 290620,
          "spk": "帷 (トバリ)",
          "ja": "案外見つかるかもね",
          "tc": "說不定還真的能找到呢。",
          "sc": "说不定还真的能找到呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 290627,
          "spk": "帷 (トバリ)",
          "ja": "アンタ、探し物は得意じゃない",
          "tc": "妳不是很擅長找東西嗎？",
          "sc": "你不是很擅长找东西吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 290647,
          "spk": "驹子 (コマコ)",
          "ja": "……えっ",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 290658,
          "spk": "帷 (トバリ)",
          "ja": "この前、ナゴの財布を",
          "tc": "之前名護的錢包，",
          "sc": "之前名护的钱包，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 290665,
          "spk": "帷 (トバリ)",
          "ja": "見つけたのはアンタでしょ",
          "tc": "就是妳找到的吧？",
          "sc": "就是你找到的吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 290678,
          "spk": "驹子 (コマコ)",
          "ja": "あれはコダマが手伝ってくれて……",
          "tc": "那次是木珠幫忙的……",
          "sc": "那次是木珠帮忙的……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 290689,
          "spk": "驹子 (コマコ)",
          "ja": "それに、仮に神器が見つかったとしても",
          "tc": "況且，就算真的找到了神器，",
          "sc": "况且，就算真的找到了神器，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 290696,
          "spk": "驹子 (コマコ)",
          "ja": "一体誰が神さまなんか倒せるの？",
          "tc": "到底誰有辦法打倒神明大人呢？",
          "sc": "到底谁有办法打倒神明大人呢？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 290709,
          "spk": "帷 (トバリ)",
          "ja": "そうなったら、私がやってあげる",
          "tc": "到時候，就由我來動手。",
          "sc": "到时候，就由我来动手。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 290729,
          "spk": "驹子 (コマコ)",
          "ja": "え、ええ……",
          "tc": "什、什麼……",
          "sc": "什、什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5019,
      "rec_id": "TALK_ID_10_0500_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290747,
          "spk": "帷 (トバリ)",
          "ja": "<player>も、なにかわかったら教えて",
          "tc": "<player>，你要是有什麼發現就告訴我。",
          "sc": "<player>，你要是有什么发现就告诉我。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290754,
          "spk": "帷 (トバリ)",
          "ja": "……コマコもね",
          "tc": "……駒子也是。",
          "sc": "……驹子也是。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 290767,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん……",
          "tc": "嗯、嗯……",
          "sc": "嗯、嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5020,
      "rec_id": "TALK_ID_10_0500_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290789,
          "spk": "驹子 (コマコ)",
          "ja": "ねぇ、リン！",
          "tc": "欸，林！",
          "sc": "诶，林！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290796,
          "spk": "驹子 (コマコ)",
          "ja": "教えてよ、キミは知っているの？",
          "tc": "告訴我嘛，妳應該知道吧？",
          "sc": "告诉我嘛，你应该知道吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5021,
      "rec_id": "TALK_ID_10_0500_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290818,
          "spk": "林 (リン)",
          "ja": "まだ懲りてないの？",
          "tc": "妳還沒學乖嗎？",
          "sc": "你还没学乖吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290825,
          "spk": "林 (リン)",
          "ja": "寝てたからかしら",
          "tc": "還是睡昏頭了？",
          "sc": "还是睡昏头了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5022,
      "rec_id": "TALK_ID_10_0500_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290850,
          "spk": "驹子 (コマコ)",
          "ja": "だって……私……",
          "tc": "因為……我……",
          "sc": "因为……我……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290863,
          "spk": "林 (リン)",
          "ja": "なるほど、あなたが知りたいのは、",
          "tc": "原來如此，妳想知道的，",
          "sc": "原来如此，你想知道的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 290870,
          "spk": "林 (リン)",
          "ja": "自分の欠けた記憶のことなんでしょ",
          "tc": "是自己欠缺的記憶吧。",
          "sc": "是自己欠缺的记忆吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5023,
      "rec_id": "TALK_ID_10_0500_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290888,
          "spk": "驹子 (コマコ)",
          "ja": "……！",
          "tc": "……！",
          "sc": "……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5024,
      "rec_id": "TALK_ID_10_0500_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 290906,
          "spk": "林 (リン)",
          "ja": "まあ確かに、村の神器や",
          "tc": "的確，只要去調查村子的神器，",
          "sc": "的确，只要去调查村子的神器，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 290913,
          "spk": "林 (リン)",
          "ja": "村の人たちが抱える秘密を探れば、",
          "tc": "或是村民們身上的祕密，",
          "sc": "或是村民们身上的秘密，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 290920,
          "spk": "林 (リン)",
          "ja": "欠けた記憶のヒントが得られるかもしれないわ",
          "tc": "說不定就能找到關於那些記憶的線索。",
          "sc": "说不定就能找到关于那些记忆的线索。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 290931,
          "spk": "林 (リン)",
          "ja": "……でもね、あなたももうわかってるでしょ",
          "tc": "……但是，妳不也很清楚嗎？",
          "sc": "……但是，你不也很清楚吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 290938,
          "spk": "林 (リン)",
          "ja": "秘密を暴くことの危険性が",
          "tc": "關於揭露祕密的危險性。",
          "sc": "关于揭露秘密的危险性。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 290949,
          "spk": "林 (リン)",
          "ja": "今回は、どうにか",
          "tc": "這次是因為勉強設法",
          "sc": "这次是因为勉强设法"
        },
        {
          "f_idx": 6,
          "pidx_tc": 290956,
          "spk": "林 (リン)",
          "ja": "封印を再び施すことができたから",
          "tc": "重新施加了封印，",
          "sc": "重新施加了封印，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 290963,
          "spk": "林 (リン)",
          "ja": "元の暮らしが戻ってきたわ",
          "tc": "才能恢復原本的生活。",
          "sc": "才能恢复原本的生活。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 290974,
          "spk": "林 (リン)",
          "ja": "けれど、神器の秘密は……",
          "tc": "不過，神器的祕密……",
          "sc": "不过，神器的秘密……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 290981,
          "spk": "林 (リン)",
          "ja": "人が隠したがっているものよ",
          "tc": "是人們想要隱藏的事情。",
          "sc": "是人们想要隐藏的事情。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 290990,
          "spk": "林 (リン)",
          "ja": "この村の歴史は長く、その分だけ",
          "tc": "這座村子的歷史悠久，",
          "sc": "这座村子的历史悠久，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 290997,
          "spk": "林 (リン)",
          "ja": "人々はしがらみにがんじがらめにされている",
          "tc": "相對地，人們也被各種糾葛緊緊束縛著。",
          "sc": "相对地，人们也被各种纠葛紧紧束缚着。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 291015,
          "spk": "林 (リン)",
          "ja": "人の心は、一度暴かれてしまえば、",
          "tc": "人心一旦遭到揭露，",
          "sc": "人心一旦遭到揭露，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 291022,
          "spk": "林 (リン)",
          "ja": "もう元には戻らない……",
          "tc": "就再也無法恢復原樣了……",
          "sc": "就再也无法恢复原样了……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 291040,
          "spk": "林 (リン)",
          "ja": "あなたがこの村に住めなくなる日が、",
          "tc": "說不定有一天，",
          "sc": "说不定有一天，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 291047,
          "spk": "林 (リン)",
          "ja": "来るかもしれないのよ",
          "tc": "妳會再也沒辦法住在這座村子裡喔！",
          "sc": "你会再也没办法住在这座村子里！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 291054,
          "spk": "林 (リン)",
          "ja": "だから……諦めなさい",
          "tc": "所以……勸妳放棄吧。",
          "sc": "所以……劝你放弃吧。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 291067,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 291080,
          "spk": "林 (リン)",
          "ja": "返事は？",
          "tc": "有聽到嗎？",
          "sc": "听见了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5025,
      "rec_id": "TALK_ID_10_0500_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291098,
          "spk": "驹子 (コマコ)",
          "ja": "……わ、わかった",
          "tc": "……我、我知道了。",
          "sc": "……我、我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5026,
      "rec_id": "TALK_ID_10_0500_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291116,
          "spk": "林 (リン)",
          "ja": "じゃ、この話はおしまい",
          "tc": "那麼，這件事到此為止。",
          "sc": "那么，这件事到此为止。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291123,
          "spk": "林 (リン)",
          "ja": "自由で普通の暮らしができる幸せを",
          "tc": "妳就好好享受",
          "sc": "你就好好享受"
        },
        {
          "f_idx": 2,
          "pidx_tc": 291130,
          "spk": "林 (リン)",
          "ja": "享受しなさい",
          "tc": "能夠生活得自由平凡的幸福吧。",
          "sc": "能够生活得自由平凡的幸福吧。"
        }
      ]
    },
