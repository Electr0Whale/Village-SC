          "pidx_tc": 292450,
          "spk": "木助 (キスケ)",
          "ja": "無駄な時間を過ごさないためにも、",
          "tc": "為了不浪費時間，",
          "sc": "为了不浪费时间，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 292457,
          "spk": "木助 (キスケ)",
          "ja": "くだらない迷信を信じて",
          "tc": "你應該也沒空隨著那種無聊的迷信起舞，",
          "sc": "你应该也没空随着那种无聊的迷信起舞，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 292464,
          "spk": "木助 (キスケ)",
          "ja": "走り回ってる暇はないはずだ",
          "tc": "為了這種事東奔西跑吧。",
          "sc": "为了这种事东奔西跑吧。"
        }
      ]
    },
    {
