        {
          "f_idx": 5,
          "pidx_tc": 292752,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ……",
          "tc": "妳這傢伙……",
          "sc": "你这家伙……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5048,
      "rec_id": "TALK_ID_10_0500_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292770,
          "spk": "木助 (キスケ)",
          "ja": "リンが見ていないところで",
          "tc": "居然趁林不注意",
