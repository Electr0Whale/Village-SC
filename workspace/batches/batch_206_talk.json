          "tc": "真是個認真的傢伙。",
          "sc": "真是个认真的家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5038,
      "rec_id": "TALK_ID_10_0500_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292016,
          "spk": "木助 (キスケ)",
          "ja": "まさかこの土地を、",
          "tc": "沒想到你會把這塊地",
          "sc": "没想到你会把这块地"
        },
        {
          "f_idx": 1,
          "pidx_tc": 292023,
          "spk": "木助 (キスケ)",
          "ja": "こんなに活用してくれるとは思わなかった",
          "tc": "活用得這麼好。",
          "sc": "活用得这么好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292030,
          "spk": "木助 (キスケ)",
          "ja": "あの荒れ果てた庭が、見違えるようだぜ……",
