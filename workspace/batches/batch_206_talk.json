          "tc": "我聽說你正在到處收集神器，",
          "sc": "我听说你正在到处收集神器，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292073,
          "spk": "木助 (キスケ)",
          "ja": "本当か？",
          "tc": "這是真的嗎？",
          "sc": "这是真的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 292082,
          "spk": "木助 (キスケ)",
          "ja": "三つの神器が揃ったら",
          "tc": "說什麼只要湊齊三件神器，",
          "sc": "说什么只要凑齐三件神器，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 292089,
          "spk": "木助 (キスケ)",
          "ja": "土地神を殺せるかもしれねぇって話だろ？",
          "tc": "就有可能殺死土地神對吧？",
          "sc": "就有可能杀死土地神对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5040,
      "rec_id": "TALK_ID_10_0500_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292114,
          "spk": "木助 (キスケ)",
          "ja": "誰に聞いたか知らんが……",
          "tc": "雖然不曉得你是聽誰說的……",
          "sc": "虽然不晓得你是听谁说的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 292121,
          "spk": "木助 (キスケ)",
          "ja": "……やめておけ",
          "tc": "……勸你放棄吧。",
          "sc": "……劝你放弃吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292132,
          "spk": "木助 (キスケ)",
          "ja": "神器っていうのはな、",
          "tc": "所謂的神器啊，",
          "sc": "所谓的神器啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 292139,
          "spk": "木助 (キスケ)",
          "ja": "村の古い家々に伝わる、",
          "tc": "是指村裡各個老家族",
          "sc": "是指村里各个老家族"
        },
        {
          "f_idx": 4,
          "pidx_tc": 292146,
          "spk": "木助 (キスケ)",
          "ja": "家宝になってるモンなんだ",
          "tc": "代代相傳的傳家寶。",
          "sc": "代代相传的传家宝。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 292155,
          "spk": "木助 (キスケ)",
          "ja": "いくら村の連中と仲良くなったとしても、",
          "tc": "就算你已經跟村民們成了好朋友，",
          "sc": "就算你已经跟村民们成了好朋友，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 292162,
          "spk": "木助 (キスケ)",
          "ja": "易々と貸してくれたりする代物じゃねえ",
          "tc": "神器也不是那種能夠隨便借你的東西。",
          "sc": "神器也不是那种能够随便借你的东西。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 292180,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの力じゃ",
          "tc": "這座村子，",
          "sc": "这座村子，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 292187,
          "spk": "木助 (キスケ)",
          "ja": "どうにもできねぇしがらみが、",
          "tc": "被糾葛深深束縛著，",
          "sc": "被纠葛深深束缚着，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 292194,
          "spk": "木助 (キスケ)",
          "ja": "この村に、深く根付いているんだよ",
          "tc": "憑你的力量根本無法撼動。",
          "sc": "凭你的力量根本无法撼动。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 292205,
          "spk": "木助 (キスケ)",
          "ja": "いくら頭を下げたって、無駄だ",
          "tc": "就算你低頭去求也沒有用。",
          "sc": "就算你低头去求也没有用。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 292212,
          "spk": "木助 (キスケ)",
          "ja": "だから……早いこと諦めちまえ",
          "tc": "所以……你還是趁早放棄吧。",
          "sc": "所以……你还是趁早放弃吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 292223,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは今まで通り、",
          "tc": "你只要跟往常一樣，",
          "sc": "你只要跟往常一样，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 292230,
          "spk": "木助 (キスケ)",
          "ja": "村でただ自由に暮らしていればいいんだ",
          "tc": "在村裡過著自由的生活就好了。",
          "sc": "在村里过着自由的生活就好了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 292248,
          "spk": "木助 (キスケ)",
          "ja": "わかったな",
          "tc": "懂了嗎？",
          "sc": "懂了吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 292255,
          "spk": "木助 (キスケ)",
          "ja": "神器を集めるなんて……やめておけ",
          "tc": "收集神器這種事……就算了吧。",
          "sc": "收集神器这种事……就算了吧。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 292264,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 19,
          "pidx_tc": 292271,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
