      "rec_id": "TALK_ID_10_0500_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292391,
          "spk": "木助 (キスケ)",
          "ja": "この村に住んでりゃ、",
          "tc": "我也明白，住在這座村子裡的人，",
