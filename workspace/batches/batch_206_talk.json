    {
      "file": "talk.dat",
      "rec_idx": 5035,
      "rec_id": "TALK_ID_10_0500_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291702,
          "spk": "驹子 (コマコ)",
          "ja": "神器を探すの……",
          "tc": "希望你可以……",
          "sc": "希望你可以……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291709,
          "spk": "驹子 (コマコ)",
          "ja": "手伝って欲しいの……",
          "tc": "幫我找神器……",
          "sc": "帮我找神器……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 291720,
          "spk": "驹子 (コマコ)",
          "ja": "も、もちろん、私も探すよ！",
          "tc": "我、我當然也會找的！",
          "sc": "我、我当然也会找的！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291731,
          "spk": "驹子 (コマコ)",
          "ja": "私、ちょっと心当たりがあって……",
          "tc": "我對這件事有點頭緒……",
          "sc": "我对这件事有点头绪……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291738,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんが昔ね、サザンカさんの……",
          "tc": "哥哥以前，把茶梅姐的……",
          "sc": "哥哥以前，把茶梅姐的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5036,
      "rec_id": "TALK_ID_10_0500_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291763,
          "spk": "驹子 (コマコ)",
          "ja": "ええっ……！",
          "tc": "咦咦……！",
          "sc": "咦咦……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291770,
          "spk": "驹子 (コマコ)",
          "ja": "コンノさんから神器のこと、頼まれたの！？",
          "tc": "你說今野先生拜託你找神器嗎！？",
          "sc": "你说今野先生拜托你找神器吗！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291786,
          "spk": "驹子 (コマコ)",
          "ja": "め、めずらしいね",
          "tc": "真、真難得呢。",
          "sc": "真、真难得呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291793,
          "spk": "驹子 (コマコ)",
          "ja": "コンノさんがそんなこと言うなんて……",
          "tc": "沒想到今野先生會說那種話……",
          "sc": "没想到今野先生会说那种话……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 291800,
          "spk": "驹子 (コマコ)",
          "ja": "でも、応援してくれてるってコトだよね",
          "tc": "不過，這就代表他也支持對吧。",
          "sc": "不过，这就代表他也支持对吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 291811,
          "spk": "驹子 (コマコ)",
          "ja": "私ね、スミレくんと、ヨウちゃんにも",
          "tc": "我也已經拜託堇怜和小洋",
          "sc": "我也已经拜托堇怜和小洋"
        },
        {
          "f_idx": 7,
          "pidx_tc": 291818,
          "spk": "驹子 (コマコ)",
          "ja": "手伝ってもらうよう頼んでおいたの",
          "tc": "一起幫忙了。",
          "sc": "一起帮忙了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 291829,
          "spk": "驹子 (コマコ)",
          "ja": "でも……ハスミさんやチナナさん……",
          "tc": "不過……像蓮實姐和琪娜娜姐……",
          "sc": "不过……像莲实姐和琪娜娜姐……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 291836,
          "spk": "驹子 (コマコ)",
          "ja": "あとは……お兄ちゃんとかは、",
          "tc": "還有……哥哥他們，",
          "sc": "还有……哥哥他们，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 291843,
          "spk": "驹子 (コマコ)",
          "ja": "全然話を聞いてくれなくて……",
          "tc": "完全不願意聽我講……",
          "sc": "完全不愿意听我讲……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 291852,
          "spk": "驹子 (コマコ)",
          "ja": "村に昔から住んでいる大人の人なら、",
          "tc": "我原本想說，以前就住在村裡的大人，",
          "sc": "我原本想说，以前就住在村里的大人，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 291859,
          "spk": "驹子 (コマコ)",
          "ja": "なにか知ってると思ったんだけど……",
          "tc": "應該會知道些什麼的……",
          "sc": "应该会知道些什么的……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 291866,
          "spk": "驹子 (コマコ)",
          "ja": "全く相手にしてくれないんだよね……",
          "tc": "但他們完全不理我……",
          "sc": "但他们完全不理我……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 291877,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 291888,
          "spk": "驹子 (コマコ)",
          "ja": "……でもでも、",
          "tc": "……可是可是，",
          "sc": "……可是可是，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 291895,
          "spk": "驹子 (コマコ)",
          "ja": "私たちだけでも力を合わせたら、",
          "tc": "就算只有我們幾個，只要同心協力，",
          "sc": "就算只有我们几个，只要同心协力，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 291902,
          "spk": "驹子 (コマコ)",
          "ja": "きっと神器も見つかるよ！",
          "tc": "一定也能找到神器的！",
          "sc": "一定也能找到神器的！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 291913,
          "spk": "驹子 (コマコ)",
          "ja": "だって、この小さい彼ヶ津村の",
          "tc": "畢竟神器，",
          "sc": "毕竟神器，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 291920,
          "spk": "驹子 (コマコ)",
          "ja": "どこかにはあるんだから……！",
          "tc": "就在這座小小的彼津村裡嘛……！",
          "sc": "就在这座小小的彼津村里嘛……！"
        },
        {
          "f_idx": 20,
          "pidx_tc": 291931,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も、なにかわかったら",
          "tc": "<player>，如果你有什麼發現，",
          "sc": "<player>，如果你有什么发现，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 291938,
          "spk": "驹子 (コマコ)",
          "ja": "教えてくれると嬉しいな",
          "tc": "希望也可以告訴我。",
          "sc": "希望也可以告诉我。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 291949,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、よろしくね",
          "tc": "那就麻煩你囉！",
          "sc": "那就麻烦你啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5037,
      "rec_id": "TALK_ID_10_0500_005_01",
      "lines": [
        {
          "f_idx": 0,
