        {
          "f_idx": 3,
          "pidx_tc": 292041,
          "spk": "木助 (キスケ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5039,
      "rec_id": "TALK_ID_10_0500_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292059,
          "spk": "木助 (キスケ)",
          "ja": "ところで……",
          "tc": "話說回來……",
          "sc": "话说回来……"
        },
        {
