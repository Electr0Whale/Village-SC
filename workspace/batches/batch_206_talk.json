        {
          "f_idx": 0,
          "pidx_tc": 291170,
          "spk": "今野 (コンノ)",
          "ja": "盗み聞きがお得意なんですねェ",
          "tc": "您很擅長偷聽呢～",
          "sc": "您很擅长偷听呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5029,
      "rec_id": "TALK_ID_10_0500_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291197,
          "spk": "今野 (コンノ)",
          "ja": "アナタはどう思うのです？",
          "tc": "您覺得呢？",
          "sc": "您觉得呢？"
