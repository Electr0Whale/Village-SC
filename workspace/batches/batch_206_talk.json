        {
          "f_idx": 1,
          "pidx_tc": 291208,
          "spk": "今野 (コンノ)",
          "ja": "村の人々が抱えた秘密を暴くべきか……",
          "tc": "應該揭露村民們身上的祕密……",
          "sc": "应该揭露村民们身上的秘密……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 291215,
          "spk": "今野 (コンノ)",
          "ja": "それとも、触らぬべきか……",
          "tc": "還是不該去碰呢……",
          "sc": "还是不该去碰呢……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291231,
          "spk": "主角心声/旁白/选项",
          "ja": "暴くべき",
          "tc": "應該揭露",
          "sc": "应该揭露"
        },
        {
          "f_idx": 5,
          "pidx_tc": 291238,
          "spk": "主角心声/旁白/选项",
          "ja": "触らぬべき",
          "tc": "不該去碰",
          "sc": "不该去碰"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5030,
      "rec_id": "TALK_ID_10_0500_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291342,
          "spk": "今野 (コンノ)",
          "ja": "マァ、なんにせよ、",
          "tc": "總之，不管怎麼說，",
          "sc": "总之，不管怎么说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291349,
          "spk": "今野 (コンノ)",
          "ja": "爆弾の上で暮らす今の状況は",
          "tc": "我們現在就像住在未爆彈上，",
          "sc": "我们现在就像住在未爆弹上，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 291356,
          "spk": "今野 (コンノ)",
          "ja": "危険極まりない",
          "tc": "實在太危險了。",
          "sc": "实在太危险了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291367,
          "spk": "今野 (コンノ)",
          "ja": "今こそ、村が変わる",
          "tc": "或許現在，",
          "sc": "或许现在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291374,
          "spk": "今野 (コンノ)",
          "ja": "機会なのかもしれません",
          "tc": "正是讓村子有所改變的機會。",
          "sc": "正是让村子有所改变的机会。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5031,
      "rec_id": "TALK_ID_10_0500_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291392,
          "spk": "今野 (コンノ)",
          "ja": "ただ、問題なのは……",
          "tc": "只不過，問題在於……",
          "sc": "只不过，问题在于……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291399,
          "spk": "今野 (コンノ)",
          "ja": "変わるべきなのは人だということ",
          "tc": "需要改變的是人。",
          "sc": "需要改变的是人。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291417,
          "spk": "今野 (コンノ)",
          "ja": "なんとかしなくてはと思いつつも、",
          "tc": "即使我認為必須設法處理，",
          "sc": "即使我认为必须设法处理，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291424,
          "spk": "今野 (コンノ)",
          "ja": "やはり相手は人間ですから、話は複雑なのですヨ",
          "tc": "但畢竟對象是人，事情就會很複雜。",
          "sc": "但毕竟对象是人，事情就会很复杂哟～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 291442,
          "spk": "今野 (コンノ)",
          "ja": "触りがたい部分なだけに、",
          "tc": "正因為是難以觸碰的部分，",
          "sc": "正因为是难以触碰的部分，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 291449,
          "spk": "今野 (コンノ)",
          "ja": "今まで誰も触ろうとしなかったのです",
          "tc": "一直以來才會沒有任何人試圖去挑戰。",
          "sc": "一直以来才会没有任何人试图去挑战。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5032,
      "rec_id": "TALK_ID_10_0500_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291467,
          "spk": "今野 (コンノ)",
          "ja": "でも、アナタだったらできるかもしれませんネ",
          "tc": "不過，您說不定做得到呢。",
          "sc": "不过，您说不定做得到呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291474,
          "spk": "今野 (コンノ)",
          "ja": "……空気、読めないですからァ",
          "tc": "……因為您不會看氣氛嘛～",
          "sc": "……因为您不会看气氛嘛～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291492,
          "spk": "今野 (コンノ)",
          "ja": "あるかどうかもわからない上に、",
          "tc": "要尋找收集那些不曉得是否存在，",
          "sc": "要寻找收集那些不晓得是否存在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 291499,
          "spk": "今野 (コンノ)",
          "ja": "誰かさんが隠している神器を探し集める……",
          "tc": "還被人藏起來的神器……",
          "sc": "还被人藏起来的神器……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 291517,
          "spk": "今野 (コンノ)",
          "ja": "気の遠くなるような作業ですが、",
          "tc": "雖然聽起來前途渺茫，",
          "sc": "虽然听起来前途渺茫，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 291524,
          "spk": "今野 (コンノ)",
          "ja": "全てはこの村のどこかにあるのです",
          "tc": "但所有神器都在這座村子的某處。",
          "sc": "但所有神器都在这座村子的某处。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 291542,
          "spk": "今野 (コンノ)",
          "ja": "叶うなら……お願いです",
          "tc": "可以的話……拜託您了。",
          "sc": "可以的话……拜托您了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 291549,
          "spk": "今野 (コンノ)",
          "ja": "三つの神器を探し求めて……",
          "tc": "您能去找尋三件神器……",
          "sc": "您能去找寻三件神器……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 291556,
          "spk": "今野 (コンノ)",
          "ja": "この土地の爆弾を処理してもらえませんか？",
          "tc": "幫忙處理掉這片土地上的未爆彈嗎？",
          "sc": "帮忙处理掉这片土地上的未爆弹吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 291567,
          "spk": "今野 (コンノ)",
          "ja": "村の掟には、",
          "tc": "雖然村子的規矩之中",
          "sc": "虽然村子的规矩之中"
        },
        {
          "f_idx": 13,
          "pidx_tc": 291574,
          "spk": "今野 (コンノ)",
          "ja": "「他人の秘密を暴くな」と",
          "tc": "有一條是",
          "sc": "有一条是"
        },
        {
          "f_idx": 14,
          "pidx_tc": 291581,
          "spk": "今野 (コンノ)",
          "ja": "ありますが……",
          "tc": "「不可揭露他人祕密」。",
          "sc": "“不可揭露他人秘密”。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 291592,
          "spk": "今野 (コンノ)",
          "ja": "幸いアナタは、",
          "tc": "但值得慶幸的是，",
          "sc": "但值得庆幸的是，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 291599,
          "spk": "今野 (コンノ)",
          "ja": "掟破りも得意のようですしィ？",
          "tc": "您也很擅長違反規矩～",
          "sc": "您也很擅长违反规矩～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5033,
      "rec_id": "TALK_ID_10_0500_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291617,
          "spk": "今野 (コンノ)",
          "ja": "……マァ、あとはアナタ次第です",
          "tc": "……總之，就看您的決定了。",
          "sc": "……总之，就看您的决定了。"
