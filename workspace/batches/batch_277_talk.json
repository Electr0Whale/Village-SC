  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7814,
      "rec_id": "TALK_ID_70_2140_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423425,
          "spk": "莲实 (ハスミ)",
          "ja": "……正直、こんな日が来るとは",
          "tc": "……老實說，",
          "sc": "……老实说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423432,
          "spk": "莲实 (ハスミ)",
          "ja": "思いませんでした",
          "tc": "我從沒想過會有這麼一天。",
          "sc": "我从没想过会有这么一天。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423443,
          "spk": "莲实 (ハスミ)",
          "ja": "どこか、諦めてたんです",
          "tc": "心裡早就不抱任何期望，",
          "sc": "心里早就不抱任何期望，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423450,
          "spk": "莲实 (ハスミ)",
          "ja": "たぶんこの先も、ズルズルと",
          "tc": "覺得未來多半也只會繼續",
          "sc": "觉得未来多半也只会继续"
        },
        {
          "f_idx": 4,
          "pidx_tc": 423457,
          "spk": "莲实 (ハスミ)",
          "ja": "変わらない毎日を送り続けるだけだろうと",
          "tc": "過上一成不變的日子。",
          "sc": "过上一成不变的日子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 423468,
          "spk": "莲实 (ハスミ)",
          "ja": "……けど、変わったんです",
          "tc": "……然而，變化發生了。",
          "sc": "……然而，变化发生了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 423475,
          "spk": "莲实 (ハスミ)",
          "ja": "たぶんあなたが来た日を境に",
          "tc": "也許是從你到來的那天開始，",
          "sc": "也许是从你到来的那天开始，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 423486,
          "spk": "莲实 (ハスミ)",
          "ja": "これまでは、嫌なことがあると",
          "tc": "在這之前一旦遇到討厭的事，",
          "sc": "在这之前一旦遇到讨厌的事，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 423493,
          "spk": "莲实 (ハスミ)",
          "ja": "お酒を呑んで考えないようにしていましたが……",
          "tc": "我總是藉著喝酒盡可能不去思考……",
          "sc": "我总是藉着喝酒尽可能不去思考……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 423504,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、お酒に逃げなくても",
          "tc": "但似乎已經不需要",
          "sc": "但似乎已经不需要"
        },
        {
          "f_idx": 10,
          "pidx_tc": 423511,
          "spk": "莲实 (ハスミ)",
          "ja": "よさそうです",
          "tc": "再靠喝酒逃避了。",
          "sc": "再靠喝酒逃避了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 423520,
          "spk": "莲实 (ハスミ)",
          "ja": "これからは、楽しむために",
          "tc": "從今以後，",
          "sc": "从今以后，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 423527,
          "spk": "莲实 (ハスミ)",
          "ja": "お酒を呑むようにしたいですね",
          "tc": "希望能把喝酒當作一種享受呢。",
          "sc": "希望能把喝酒当作一种享受呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 423538,
          "spk": "莲实 (ハスミ)",
          "ja": "……私は嫌なことから目を背け",
          "tc": "……一直以來每當遇到討厭的事，",
          "sc": "……一直以来每当遇到讨厌的事，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 423545,
          "spk": "莲实 (ハスミ)",
          "ja": "逃げ続けてきました",
          "tc": "我都會選擇逃避。",
          "sc": "我都会选择逃避。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 423556,
          "spk": "莲实 (ハスミ)",
          "ja": "辛いことから、すぐに逃避してしまう……",
          "tc": "遇到痛苦的事情就立刻逃走……",
          "sc": "遇到痛苦的事情就立刻逃走……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 423563,
          "spk": "莲实 (ハスミ)",
          "ja": "そんな、弱い自分が嫌になります……",
          "tc": "我很討厭那麼軟弱的自己……",
          "sc": "我很讨厌那么软弱的自己……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 423570,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんは、逃げたりしないんでしょう？",
          "tc": "<player>你不會逃避對吧？",
          "sc": "<player>你不会逃避对吧？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 423579,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 19,
          "pidx_tc": 423586,
          "spk": "主角心声/旁白/选项",
          "ja": "にげる",
          "tc": "我會逃",
          "sc": "我会逃"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7815,
      "rec_id": "TALK_ID_70_2140_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423672,
          "spk": "莲实 (ハスミ)",
          "ja": "……長い間、過去にとらわれ",
          "tc": "……長久以來，我都無法擺脫過去，",
          "sc": "……长久以来，我都无法摆脱过去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423679,
          "spk": "莲实 (ハスミ)",
          "ja": "後悔するだけの日々を過ごしてきました",
          "tc": "過著只有後悔的日子。",
          "sc": "过着只有后悔的日子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423690,
          "spk": "莲实 (ハスミ)",
          "ja": "けど、ようやく",
          "tc": "然而，如今似乎終於",
          "sc": "然而，如今似乎终于"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423697,
          "spk": "莲实 (ハスミ)",
          "ja": "前を向いて歩きだせそうです",
          "tc": "可以向前邁進了。",
          "sc": "可以向前迈进了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 423708,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレや<player>さんが",
          "tc": "不曉得堇怜和<player>",
          "sc": "不晓得堇怜和<player>"
        },
        {
          "f_idx": 5,
          "pidx_tc": 423715,
          "spk": "莲实 (ハスミ)",
          "ja": "どんな素晴らしい大人へと",
          "tc": "長大成人之後",
          "sc": "长大成人之后"
        },
        {
          "f_idx": 6,
          "pidx_tc": 423722,
          "spk": "莲实 (ハスミ)",
          "ja": "成長していくのか……",
          "tc": "會有多麼出色呢……",
          "sc": "会有多么出色呢……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 423733,
          "spk": "莲实 (ハスミ)",
          "ja": "明るい未来を夢見て",
          "tc": "抱持著對美好未來的想望──",
          "sc": "抱持着对美好未来的想望——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 423740,
          "spk": "莲实 (ハスミ)",
          "ja": "私もしっかりした大人に",
          "tc": "我也必須成為一個",
          "sc": "我也必须成为一个"
        },
        {
          "f_idx": 9,
          "pidx_tc": 423747,
          "spk": "莲实 (ハスミ)",
          "ja": "ならないといけませんよね",
          "tc": "像樣的大人才行呢。",
          "sc": "像样的大人才行呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7816,
      "rec_id": "TALK_ID_70_2140_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423773,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423780,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいところに来たね",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423795,
          "spk": "莲实 (ハスミ)",
          "ja": "これから飲み会をするんですけど",
          "tc": "我們準備一起小酌一下，",
          "sc": "我们准备一起小酌一下，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423802,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも、ご一緒しませんか？",
          "tc": "<player>要不要也加入呢？",
          "sc": "<player>要不要也加入呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7817,
      "rec_id": "TALK_ID_70_2140_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423822,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうそう、そうこなくっちゃ",
          "tc": "很好，這樣才對嘛。",
          "sc": "很好，这样才对嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423833,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミがお酒を控えていたみたいだし",
          "tc": "看到蓮實有在控制酒量，",
          "sc": "看到莲实有在控制酒量，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423840,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご褒美として、お酒を差し入れに来たんだよ",
          "tc": "所以我帶了酒來當作獎勵呢。",
          "sc": "所以我带了酒来当作奖励呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7818,
      "rec_id": "TALK_ID_70_2140_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423867,
          "spk": "堇怜 (スミレ)",
          "ja": "……矛盾してませんか？",
          "tc": "……這不是很矛盾嗎？",
          "sc": "……这不是很矛盾吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7819,
      "rec_id": "TALK_ID_70_2140_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423885,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいのいいの",
          "tc": "沒關係沒關係～",
          "sc": "没关系没关系～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423892,
          "spk": "琪娜娜 (チナナ)",
          "ja": "楽しいお酒なら、少しくらいはさ",
          "tc": "只要開心，喝一點也無妨啦。",
          "sc": "只要开心，喝一点也无妨啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7820,
      "rec_id": "TALK_ID_70_2140_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423910,
          "spk": "堇怜 (スミレ)",
          "ja": "……そうですね",
          "tc": "……說得也是。",
          "sc": "……说得也是。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423917,
          "spk": "堇怜 (スミレ)",
          "ja": "少しくらいなら",
          "tc": "只喝一點倒是可以。",
          "sc": "只喝一点倒是可以。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423930,
          "spk": "莲实 (ハスミ)",
          "ja": "そうと決まれば、かんぱーい",
          "tc": "那就這麼決定了，乾杯～！",
          "sc": "那就这么决定了，干杯～！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423937,
          "spk": "莲实 (ハスミ)",
          "ja": "今日はとことん呑みましょう！",
          "tc": "今天就來喝個夠！",
          "sc": "今天就来喝个够！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7821,
      "rec_id": "TALK_ID_70_2140_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423969,
          "spk": "莲实 (ハスミ)",
          "ja": "まえから、ずうっと……",
          "tc": "從很早以前，我就一直……",
          "sc": "从很早以前，我就一直……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423976,
          "spk": "莲实 (ハスミ)",
          "ja": "いおういおうと、思ってたんですよ……",
          "tc": "想著要講出來……",
          "sc": "想着要讲出来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 423987,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレにも、<player>しゃんにも……",
          "tc": "不論是堇怜，還是小<player>……",
          "sc": "不论是堇怜，还是小<player>……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423994,
          "spk": "莲实 (ハスミ)",
          "ja": "お世話になりっぱなしで",
          "tc": "都很照顧我，",
          "sc": "都很照顾我，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424001,
          "spk": "莲实 (ハスミ)",
          "ja": "もうしわけない……です……",
          "tc": "真的非常……不好意思……",
          "sc": "真的非常……不好意思……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7822,
      "rec_id": "TALK_ID_70_2140_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424019,
          "spk": "堇怜 (スミレ)",
          "ja": "い、いえ……",
          "tc": "沒、沒這回事……",
          "sc": "没、没这回事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424026,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は全然大丈夫です",
          "tc": "我完全不在意。",
          "sc": "我完全不在意。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424035,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんこそ、僕のために",
          "tc": "姊姊才是為我做了很多，",
          "sc": "姐姐才是为我做了很多，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424042,
          "spk": "堇怜 (スミレ)",
          "ja": "いつもありがとうございます",
          "tc": "真的非常感謝妳。",
          "sc": "真的非常感谢你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7823,
      "rec_id": "TALK_ID_70_2140_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424060,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なに、敬語になってるのさ",
          "tc": "你幹嘛這麼畢恭畢敬的。",
          "sc": "你干嘛这么毕恭毕敬的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424067,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……引いてる？",
          "tc": "……嚇到了嗎？",
          "sc": "……吓到了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7824,
      "rec_id": "TALK_ID_70_2140_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424085,
          "spk": "堇怜 (スミレ)",
          "ja": "……そりゃあ、戸惑いもしますよ",
          "tc": "……會覺得不知所措也很正常吧。",
          "sc": "……会觉得不知所措也很正常吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424092,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんに、こんな顔があったなんて",
          "tc": "我從來不知道",
          "sc": "我从来不知道"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424099,
          "spk": "堇怜 (スミレ)",
          "ja": "全然知らなかったから",
          "tc": "原來姊姊還有這樣的一面。",
          "sc": "原来姐姐还有这样的一面。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424112,
          "spk": "莲实 (ハスミ)",
          "ja": "ううう……",
          "tc": "嗚嗚嗚……",
          "sc": "呜呜呜……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424119,
          "spk": "莲实 (ハスミ)",
          "ja": "なんて、りっぱな弟なんでしょ……",
          "tc": "怎麼會有這麼優秀的弟弟啦……",
          "sc": "怎么会有这么优秀的弟弟啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7825,
      "rec_id": "TALK_ID_70_2140_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424137,
          "spk": "堇怜 (スミレ)",
          "ja": "……お酒が好きなのは知ってたけど",
          "tc": "……雖然早就知道她愛喝酒，",
          "sc": "……虽然早就知道她爱喝酒，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424144,
          "spk": "堇怜 (スミレ)",
          "ja": "酔っぱらうと、こんな風になるんだ",
          "tc": "但原來喝醉之後會變成這樣。",
          "sc": "但原来喝醉之后会变成这样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7826,
      "rec_id": "TALK_ID_70_2140_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424162,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……だね、まさかハスミが",
          "tc": "……也是，沒想到蓮實",
          "sc": "……也是，没想到莲实"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424169,
          "spk": "琪娜娜 (チナナ)",
          "ja": "人前で酔っぱらってる姿を見せるなんて",
          "tc": "竟然會讓別人看到她喝醉的樣子。",
          "sc": "竟然会让别人看到她喝醉的样子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424180,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これまでは、現実逃避のために",
          "tc": "畢竟在此之前，",
          "sc": "毕竟在此之前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424187,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酒を呑んでるだけだったからさ",
          "tc": "她喝酒都只是為了逃避現實罷了。",
          "sc": "她喝酒都只是为了逃避现实罢了。"
        },
