      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42917,
          "spk": "驹子 (コマコ)",
          "ja": "今日はお仕事がたくさんあって",
          "tc": "今天工作很多，",
          "sc": "今天工作很多，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42924,
          "spk": "驹子 (コマコ)",
          "ja": "大変なんだよね……",
          "tc": "會滿辛苦的……",
          "sc": "会满辛苦的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42935,
          "spk": "驹子 (コマコ)",
          "ja": "朝ごはんはしっかり食べていかなくちゃ",
          "tc": "所以早餐一定要吃飽才行。",
          "sc": "所以早餐一定要吃饱才行。"
