      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43308,
          "spk": "驹子 (コマコ)",
          "ja": "今日は思ったより寒かったなぁ",
          "tc": "今天比我想的還要更冷呢，",
          "sc": "今天比我想的还要更冷呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43315,
          "spk": "驹子 (コマコ)",
          "ja": "明日に備えて防寒具とか準備しておかないと",
          "tc": "我得為先為明天準備防寒用具才行。",
          "sc": "我得为先为明天准备防寒用具才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1154,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43346,
          "spk": "驹子 (コマコ)",
          "ja": "雪かきをたくさんしてるおかげかな",
          "tc": "不知道是不是因為剷了很多雪，",
          "sc": "不知道是不是因为铲了很多雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43353,
          "spk": "驹子 (コマコ)",
          "ja": "体力がついてきた気がするの",
          "tc": "總感覺體力變好了。",
          "sc": "总感觉体力变好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 43364,
          "spk": "驹子 (コマコ)",
          "ja": "私一人で村中雪かきできるかも……！",
          "tc": "我搞不好能自己剷光整個村子的雪呢……！",
          "sc": "我说不定能自己铲光整个村子的雪呢……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1155,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43395,
          "spk": "驹子 (コマコ)",
          "ja": "雪が積もって真っ白になった森って、",
          "tc": "因為積雪而變成了一片雪白的森林，",
          "sc": "因为积雪而变成了一片雪白的森林，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43402,
          "spk": "驹子 (コマコ)",
          "ja": "ぜんぜん違う場所みたいに見えて",
          "tc": "看起來像是完全不同的地方，",
          "sc": "看起来像是完全不同的地方，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 43409,
          "spk": "驹子 (コマコ)",
          "ja": "不思議なんだよね……",
          "tc": "真是神奇啊……",
          "sc": "真是神奇啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1156,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43433,
          "spk": "驹子 (コマコ)",
          "ja": "思い返してみたら、",
          "tc": "仔細回想起來，",
          "sc": "仔细回想起来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43440,
          "spk": "驹子 (コマコ)",
          "ja": "今年もたくさん獲物が獲れたなぁ……",
          "tc": "我今年也獵到很多獵物呢……",
          "sc": "我今年也猎到很多猎物呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 43451,
          "spk": "驹子 (コマコ)",
          "ja": "これだけの恵みをもらえたこと、",
          "tc": "能從珍貴的生命身上獲得這麼多的餽贈，",
          "sc": "能从珍贵的生命身上获得这么多的馈赠，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 43458,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんと感謝しないとね",
          "tc": "我一定要心存感激才行。",
          "sc": "我一定要心存感激才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1157,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43482,
          "spk": "驹子 (コマコ)",
          "ja": "ロッカクさんのお店のごはん",
          "tc": "我想去吃",
          "sc": "我想去吃"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43489,
          "spk": "驹子 (コマコ)",
          "ja": "食べたくなってきちゃった……",
          "tc": "六角叔店裡的餐點了……",
          "sc": "六角叔店里的餐点了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 43500,
          "spk": "驹子 (コマコ)",
          "ja": "たまにはお兄ちゃんも誘って行こうかな",
          "tc": "偶爾也約哥哥一起去吧。",
          "sc": "偶尔也约哥哥一起去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1158,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43531,
          "spk": "驹子 (コマコ)",
          "ja": "私、密かな自慢があって……",
          "tc": "我有一個不為人知的能力……",
          "sc": "我有一个不为人知的能力……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43538,
          "spk": "驹子 (コマコ)",
          "ja": "実は今まで風邪をひいたことがないんだ",
          "tc": "那就是我從來沒有感冒過。",
          "sc": "那就是我从来没有感冒过。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 43545,
          "spk": "驹子 (コマコ)",
          "ja": "たぶん、体がすっごく丈夫なんだと思う",
          "tc": "我想，我的身體應該是非常健康吧。",
          "sc": "我想，我的身体应该是非常健康吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 43556,
          "spk": "驹子 (コマコ)",
          "ja": "逆にお兄ちゃんは意外と風邪を引きやすいんだよ",
          "tc": "反而是哥哥意外地很容易感冒。",
          "sc": "反而是哥哥意外地很容易感冒。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 43563,
          "spk": "驹子 (コマコ)",
          "ja": "あんなに強そうなのに、おもしろいよね",
          "tc": "他明明看起來很強壯，真有趣。",
          "sc": "他明明看起来很强壮，真有趣。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1159,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43594,
          "spk": "驹子 (コマコ)",
          "ja": "あったかいご飯が食べられるって",
          "tc": "有熱呼呼的飯可以吃，",
          "sc": "有热呼呼的饭可以吃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43601,
