  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 960,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34414,
          "spk": "驹子 (コマコ)",
          "ja": "あ、ご、ごめんね",
          "tc": "啊，對、對不起。",
          "sc": "啊，对、对不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34421,
          "spk": "驹子 (コマコ)",
          "ja": "勘違いしてたみたい……",
          "tc": "我好像誤會了……",
          "sc": "我好像误会了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34432,
          "spk": "驹子 (コマコ)",
          "ja": "い、いいよ、大丈夫だから",
          "tc": "沒、沒關係的，",
          "sc": "没、没关系的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34439,
          "spk": "驹子 (コマコ)",
          "ja": "無理しないで",
          "tc": "你不用勉強喔。",
          "sc": "你不用勉强哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 961,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34463,
          "spk": "驹子 (コマコ)",
          "ja": "ねえねえ、<player>は",
          "tc": "那個，<player>，",
          "sc": "那个，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34470,
          "spk": "驹子 (コマコ)",
          "ja": "「ミートパイ」って好き？",
          "tc": "你喜歡「肉餅」嗎？",
          "sc": "你喜欢“肉饼”吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34481,
          "spk": "驹子 (コマコ)",
          "ja": "私はけっこう好きなんだ",
          "tc": "我還挺喜歡的呢，",
          "sc": "我还挺喜欢的呢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34488,
          "spk": "驹子 (コマコ)",
          "ja": "家では、お兄ちゃんがいない時に作っててね",
          "tc": "我哥哥不在家的時候，我就會做來吃。",
          "sc": "我哥哥不在家的时候，我就会做来吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34506,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんはお肉好きじゃないから、",
          "tc": "哥哥他不愛吃肉，",
          "sc": "哥哥他不爱吃肉，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34513,
          "spk": "驹子 (コマコ)",
          "ja": "だいたいいつも一人で",
          "tc": "所以我通常都是自己一個人享用",
          "sc": "所以我通常都是自己一个人享用"
        },
        {
          "f_idx": 7,
          "pidx_tc": 34520,
          "spk": "驹子 (コマコ)",
          "ja": "できたてのミートパイを食べてるの",
          "tc": "剛出爐的肉餅。",
          "sc": "刚出炉的肉饼。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 34531,
          "spk": "驹子 (コマコ)",
          "ja": "パイ生地のサクサクした食感と",
          "tc": "餅皮口感酥酥脆脆，",
          "sc": "饼皮口感酥酥脆脆，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 34538,
          "spk": "驹子 (コマコ)",
          "ja": "お肉の弾力が合わさって……",
          "tc": "再搭配上肉的嚼勁……",
          "sc": "再搭配上肉的嚼劲……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 34545,
          "spk": "驹子 (コマコ)",
          "ja": "すごく元気の出る料理なんだ",
          "tc": "是一道能讓人活力充沛的料理呢。",
          "sc": "是一道能让人活力充沛的料理呢。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 34556,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も作ってみてよ",
          "tc": "<player>，你也試著做做看吧。",
          "sc": "<player>，你也试着做做看吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 34563,
          "spk": "驹子 (コマコ)",
          "ja": "私のレシピでよければ、教えてあげるね",
          "tc": "不嫌棄的話，我把食譜告訴你。",
          "sc": "不嫌弃的话，我把食谱告诉你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 962,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34587,
          "spk": "驹子 (コマコ)",
          "ja": "<player>って甘いもの好きだっけ？",
          "tc": "<player>，你喜歡甜食嗎？",
          "sc": "<player>，你喜欢甜食吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34594,
          "spk": "驹子 (コマコ)",
          "ja": "ケーキとかクッキーとか",
          "tc": "像是餅乾或蛋糕之類的。",
          "sc": "像是饼干或蛋糕之类的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34605,
          "spk": "驹子 (コマコ)",
          "ja": "私のおすすめなんだけど",
          "tc": "我想跟你推薦一款叫做",
          "sc": "我想跟你推荐一款叫做"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34612,
          "spk": "驹子 (コマコ)",
          "ja": "「ベリーパンナコッタ」っていう",
          "tc": "「莓果奶酪」的甜點，",
          "sc": "“莓果意式奶冻”的甜点，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34619,
          "spk": "驹子 (コマコ)",
          "ja": "スイーツもおいしいよ",
          "tc": "很好吃喔。",
          "sc": "很好吃哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34630,
          "spk": "驹子 (コマコ)",
          "ja": "プリンにちょっと似てる感じでね",
          "tc": "感覺有一點像布丁，",
          "sc": "感觉有一点像布丁，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34637,
          "spk": "驹子 (コマコ)",
          "ja": "牛乳とか生クリームをゼラチンで固めるの",
          "tc": "是用明膠將牛奶或鮮奶油凝固而成的甜點，",
          "sc": "是用明胶将牛奶或鲜奶油凝固而成的甜点，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 34644,
          "spk": "驹子 (コマコ)",
          "ja": "食べたことあるかな？",
          "tc": "你有吃過嗎？",
          "sc": "你吃过吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 34655,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっと前にレシピを調べて作ったんだけど",
          "tc": "我之前查了食譜，自己做過一遍，",
          "sc": "我之前查了食谱，自己做过一遍，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 34662,
          "spk": "驹子 (コマコ)",
          "ja": "上手く固まらなくて、失敗したんだよね……",
          "tc": "但是凝固得不太順利，做失敗了……",
          "sc": "但是凝固得不太顺利，做失败了……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 34678,
          "spk": "驹子 (コマコ)",
          "ja": "味はおいしかったんだけどなぁ",
          "tc": "雖然吃起來還是很好吃，",
          "sc": "虽然吃起来还是很好吃，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 34687,
          "spk": "驹子 (コマコ)",
          "ja": "<player>なら上手に作れそうな気がするよ",
          "tc": "不過我覺得<player>可以做得更好。",
          "sc": "不过我觉得<player>可以做得更好。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 34694,
          "spk": "驹子 (コマコ)",
          "ja": "レシピ教えるから、作ってみて",
          "tc": "我把食譜教給你，你也做做看吧。",
          "sc": "我把食谱教给你，你也做做看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 963,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34718,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34725,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっと相談があるんだけど",
          "tc": "我有事情想找你商量一下。",
          "sc": "我有事情想找你商量一下。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34736,
          "spk": "驹子 (コマコ)",
          "ja": "大したことじゃないの",
          "tc": "不是什麼大不了的事，",
          "sc": "不是什么大不了的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34743,
          "spk": "驹子 (コマコ)",
          "ja": "今度、私が作った「モンブラン」を",
          "tc": "就是下次我想請你試吃",
          "sc": "就是下次我想请你试吃"
        },
        {
          "f_idx": 4,
          "pidx_tc": 34750,
          "spk": "驹子 (コマコ)",
          "ja": "食べてみてほしくって",
          "tc": "我自己做的「蒙布朗」。",
          "sc": "我自己做的“蒙布朗”。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34761,
          "spk": "驹子 (コマコ)",
          "ja": "前にサザンカさんと話した時に",
          "tc": "之前我跟茶梅姐聊天時，",
          "sc": "之前我跟茶梅姐聊天时，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34768,
          "spk": "驹子 (コマコ)",
          "ja": "好きなデザートの話題になってね",
          "tc": "聊到了喜歡的甜點。",
          "sc": "聊到了喜欢的甜点。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 34784,
          "spk": "驹子 (コマコ)",
          "ja": "その時に見せてもらった",
          "tc": "當時她給我看了",
          "sc": "当时她给我看了"
        },
        {
          "f_idx": 9,
          "pidx_tc": 34791,
          "spk": "驹子 (コマコ)",
          "ja": "手作りのモンブランの写真が、",
          "tc": "她自己做的蒙布朗的照片，",
          "sc": "她自己做的蒙布朗的照片，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 34798,
          "spk": "驹子 (コマコ)",
          "ja": "すごくかわいかったんだ……",
          "tc": "真的超級可愛的……",
          "sc": "真的超级可爱的……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 34809,
          "spk": "驹子 (コマコ)",
          "ja": "私もあれくらいかわいいモンブランを",
          "tc": "我也想做出那麼可愛的蒙布朗，",
          "sc": "我也想做出那么可爱的蒙布朗，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 34816,
          "spk": "驹子 (コマコ)",
          "ja": "作ってみたいなぁって練習しててさ",
          "tc": "正在練習呢。",
          "sc": "正在练习呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 34823,
          "spk": "驹子 (コマコ)",
          "ja": "その成果を見てもらいたいの",
          "tc": "所以我想請你看一下我練習的成果。",
          "sc": "所以我想请你看一下我练习的成果。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 34834,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も作ってみたかったりする？",
          "tc": "<player>，你也會想做做看嗎？",
          "sc": "<player>，你也会想做做看吗？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 34841,
          "spk": "驹子 (コマコ)",
          "ja": "レシピ教えるから、暇な時に作ってみてよ",
          "tc": "那我告訴你食譜，有空就試著做做看吧。",
          "sc": "那我告诉你食谱，有空就试着做做看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 964,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34872,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34879,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうど良かった、少しいい？",
          "tc": "來得正好，能說句話嗎？",
          "sc": "来得正好，能说句话吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34890,
          "spk": "驹子 (コマコ)",
          "ja": "今日の午後６時から時間あるかな……？",
          "tc": "你今天晚上6點以後有空嗎？",
          "sc": "你今天晚上6点以后有空吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34897,
          "spk": "驹子 (コマコ)",
          "ja": "うちで一緒にご飯とかどうかなって思って……",
          "tc": "想說看你要不要來我家一起吃個飯……",
          "sc": "想说看你要不要来我家一起吃个饭……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 34915,
          "spk": "驹子 (コマコ)",
          "ja": "<player>と二人で話したいことも",
          "tc": "我有很多話想和<player>你",
          "sc": "我有很多话想和<player>你"
        },
        {
          "f_idx": 6,
          "pidx_tc": 34922,
          "spk": "驹子 (コマコ)",
          "ja": "たくさんあるんだ",
          "tc": "單獨聊聊。",
          "sc": "单独聊聊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 34933,
          "spk": "驹子 (コマコ)",
          "ja": "無理ならぜんぜんいいんだけど……",
          "tc": "如果不行也完全沒關係的……",
          "sc": "如果不行也完全没关系的……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 34940,
          "spk": "驹子 (コマコ)",
          "ja": "どうかな？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 34949,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 34956,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 965,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 34974,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……良かったぁ",
          "tc": "啊……太好了，",
          "sc": "啊……太好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 34981,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ家で準備しておくよ",
          "tc": "那我先回家準備。",
          "sc": "那我先回家准备。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 34992,
          "spk": "驹子 (コマコ)",
          "ja": "午後６時になったら来てくれると嬉しいな",
          "tc": "就跟你約晚上6點囉。",
          "sc": "那就跟你约晚上6点啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 34999,
          "spk": "驹子 (コマコ)",
          "ja": "待ってるね！",
          "tc": "我等你喔！",
          "sc": "我等你哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 966,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 35021,
          "spk": "驹子 (コマコ)",
          "ja": "あ、そっか……",
          "tc": "啊，這樣啊……",
          "sc": "啊，这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 35028,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんね、忙しい時に",
          "tc": "抱歉在你忙碌的時候問你。",
          "sc": "抱歉在你忙碌的时候问你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 35039,
          "spk": "驹子 (コマコ)",
          "ja": "また時間がある日に誘わせてもらうよ",
          "tc": "以後你哪天有空，我會再約你的。",
          "sc": "以后你哪天有空，我会再约你的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 35046,
          "spk": "驹子 (コマコ)",
          "ja": "予定が合いそうならよろしくね",
          "tc": "你時間可以的話，我們再一起吃飯吧。",
          "sc": "你时间可以的话，我们再一起吃饭吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 967,
      "rec_id": "TALK_ID_HUNTER_SPECIAL_20_105_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 35070,
          "spk": "驹子 (コマコ)",
          "ja": "わ、<player>！",
          "tc": "哇，<player>！",
          "sc": "哇，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 35077,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうど良かった",
          "tc": "你來得正好，",
          "sc": "你来得正好，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 35084,
          "spk": "驹子 (コマコ)",
          "ja": "お誘いさせてもらってもいい？",
          "tc": "我正想邀請你呢。",
          "sc": "我正想邀请你呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 35095,
          "spk": "驹子 (コマコ)",
          "ja": "もし時間があるなら、",
          "tc": "如果你有空的話，",
          "sc": "如果你有空的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 35102,
          "spk": "驹子 (コマコ)",
          "ja": "うちでお泊り会をしようよ",
          "tc": "就來我家過夜吧。",
          "sc": "就来我家过夜吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 35113,
          "spk": "驹子 (コマコ)",
          "ja": "<player>といっぱい遊びたいんだ",
          "tc": "我想跟<player>一起玩個過癮，",
          "sc": "我想跟<player>一起玩个过瘾，"
        },
        {
