      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43137,
          "spk": "驹子 (コマコ)",
          "ja": "おみくじとか、こういうランダムな景品って、",
          "tc": "像是抽籤或是這種隨機的獎品，",
          "sc": "像是抽签或是这种随机的奖品，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 43144,
          "spk": "驹子 (コマコ)",
          "ja": "欲しいものほどなかなか出ないんだよね……",
          "tc": "永遠都不會抽到自己想要的呢……",
          "sc": "永远都不会抽到自己想要的呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 43162,
          "spk": "驹子 (コマコ)",
          "ja": "……でも、あと１回だけ回そうかな",
          "tc": "……不過我再轉一次好了。",
          "sc": "……不过我再转一次好了。"
        }
      ]
    },
