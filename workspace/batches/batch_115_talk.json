      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42959,
          "spk": "驹子 (コマコ)",
          "ja": "ヨウちゃんと、",
          "tc": "我和小洋約好了，",
          "sc": "我和小洋约好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42966,
          "spk": "驹子 (コマコ)",
          "ja": "今度河原で遊ぶ約束をしたんだ",
          "tc": "下次要一起去河邊玩。",
          "sc": "下次要一起去河边玩。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42977,
          "spk": "驹子 (コマコ)",
          "ja": "せっかくだしお弁当も作っていこうかな？",
          "tc": "機會難得，我就做個便當帶過去好了。",
          "sc": "机会难得，我就做个便当带过去好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
