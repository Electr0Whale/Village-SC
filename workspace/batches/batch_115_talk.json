      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42868,
          "spk": "驹子 (コマコ)",
          "ja": "今日はショウガたっぷりの",
          "tc": "今天的早餐，",
          "sc": "今天的早餐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42875,
          "spk": "驹子 (コマコ)",
          "ja": "朝ごはんにするんだ",
          "tc": "我要吃一大堆薑。",
          "sc": "我要吃一大堆姜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42886,
          "spk": "驹子 (コマコ)",
          "ja": "ショウガを入れると体が内側から",
          "tc": "薑可以讓身體從體內暖和起來，",
          "sc": "姜可以让身体从体内暖和起来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42893,
          "spk": "驹子 (コマコ)",
          "ja": "温まるからおすすめだよ",
          "tc": "所以我很推薦喔。",
          "sc": "所以我很推荐哦。"
        }
      ]
    },
    {
