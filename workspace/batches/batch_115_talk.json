      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43001,
          "spk": "驹子 (コマコ)",
          "ja": "この前、すごく大きな獲物が穫れたの",
          "tc": "我之前了抓到非常大的獵物喔。",
          "sc": "我之前了抓到非常大的猎物哦。"
