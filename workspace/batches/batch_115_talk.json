          "pidx_tc": 42837,
          "spk": "驹子 (コマコ)",
          "ja": "今日はお仕事で忙しかったし",
          "tc": "今天工作還滿忙的，",
          "sc": "今天工作还满忙的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42844,
          "spk": "驹子 (コマコ)",
          "ja": "たまにはゆっくり休もうかな……",
          "tc": "偶爾就來休息一下吧……",
          "sc": "偶尔就来休息一下吧……"
        }
      ]
    },
    {
