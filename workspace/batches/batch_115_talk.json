      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_4130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 43259,
          "spk": "驹子 (コマコ)",
          "ja": "隙間風が入ってきてるような……",
          "tc": "感覺好像有漏風……",
          "sc": "感觉好像有漏风……"
