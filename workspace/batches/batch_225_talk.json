      "rec_id": "TALK_ID_10_0601_015_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339963,
          "spk": "津主 (ヅ主/神明)",
          "ja": "され　ド、　もはヤ　遅シ",
          "tc": "然　而，　已經　太遲了。",
          "sc": "然　而，　已经　太迟了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339970,
          "spk": "津主 (ヅ主/神明)",
          "ja": "汝も　スデに　理ノ　外　へと　堕チヌ",
          "tc": "汝也　早已　墮入　法則　之外。",
          "sc": "汝也　早已　堕入　法则　之外。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5868,
      "rec_id": "TALK_ID_10_0601_015_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339993,
          "spk": "津主 (ヅ主/神明)",
          "ja": "吾ラ、　かたチ　無キ　モノ",
          "tc": "吾等，　無形　之　存在，",
          "sc": "吾等，　无形　之　存在，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 340000,
          "spk": "津主 (ヅ主/神明)",
          "ja": "理ニ　縛ラレ、　理ニ　生かサ　ルル",
          "tc": "為　法則　所縛，　亦為　法則　所存。",
          "sc": "为　法则　所缚，　亦为　法则　所存。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 340018,
          "spk": "津主 (ヅ主/神明)",
          "ja": "ユエ、　願はれ　シ願ヒ　ヲ　果たす　コソ",
          "tc": "是故，　凡　受託　之願，　必當　成之。",
          "sc": "是故，　凡　受托　之愿，　必当　成之。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 340025,
          "spk": "津主 (ヅ主/神明)",
          "ja": "吾ラが　スクな　キ　定め　ナリ",
          "tc": "此乃　吾等　僅存　之　宿命。",
          "sc": "此乃　吾等　仅存　之　宿命。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 340043,
          "spk": "津主 (ヅ主/神明)",
          "ja": "され　ド、　死セル　神、",
          "tc": "然而，　已死　之　神，",
          "sc": "然而，　已死　之　神，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 340050,
          "spk": "津主 (ヅ主/神明)",
          "ja": "もはヤ　願ヒ　届カズ",
          "tc": "其願　已　無法　傳達。",
          "sc": "其愿　已　无法　传达。"
        }
      ]
    },
    {
      "file": "talk.dat",
