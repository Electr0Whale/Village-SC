      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339704,
          "spk": "木珠 (コダマ)",
          "ja": "お願いです……",
          "tc": "求求祢……",
          "sc": "求求你……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339711,
          "spk": "木珠 (コダマ)",
          "ja": "<strong>「ジンギ」を三つあつめて、",
          "tc": "<strong>請收集……三件「神器」，",
          "sc": "<strong>请收集……三件“神器”，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 339718,
          "spk": "木珠 (コダマ)",
          "ja": "この大穴に戻ってきて……</strong>",
          "tc": "回到這個大洞來……</strong>",
          "sc": "回到这个大洞来……</strong>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339727,
          "spk": "木珠 (コダマ)",
          "ja": "「ジンギ」は……",
          "tc": "「神器」是……",
          "sc": "“神器”是……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 339734,
          "spk": "木珠 (コダマ)",
          "ja": "村の人たちの、宝物なの……",
          "tc": "村民們的……寶物……",
          "sc": "村民们的……宝物……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339743,
          "spk": "木珠 (コダマ)",
          "ja": "それを、どうにか、借りて……",
          "tc": "希望祢……想辦法跟他們借……",
          "sc": "希望你……想办法跟他们借……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 339750,
          "spk": "木珠 (コダマ)",
          "ja": "持ってきて欲しいの……",
          "tc": "然後帶過來……",
          "sc": "然后带过来……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 339759,
          "spk": "木珠 (コダマ)",
          "ja": "それがあれば、",
          "tc": "有了那個，",
          "sc": "有了那个，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 339766,
          "spk": "木珠 (コダマ)",
          "ja": "悪い神さまを倒して、",
          "tc": "就能打倒壞神明大人，",
          "sc": "就能打倒坏神明大人，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 339773,
          "spk": "木珠 (コダマ)",
          "ja": "彼ヶ津村を……",
          "tc": "拯救彼津村……",
          "sc": "拯救彼津村……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 339782,
          "spk": "木珠 (コダマ)",
          "ja": "コダマの家族を助けることができるから……",
          "tc": "拯救木珠的家人了……",
          "sc": "拯救木珠的家人了……"
        }
      ]
    },
