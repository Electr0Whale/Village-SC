          "ja": "我ラ　定　メ　なリ",
          "tc": "乃　吾等　之　宿命。",
          "sc": "乃　吾等　之　宿命。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 340175,
          "spk": "津主 (ヅ主/神明)",
          "ja": "よっテ、　往け",
          "tc": "因此，　去吧。",
