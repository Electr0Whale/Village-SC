      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339540,
          "spk": "木珠 (コダマ)",
          "ja": "でも、お願いは……",
          "tc": "但是，願望……",
          "sc": "但是，愿望……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339547,
          "spk": "木珠 (コダマ)",
          "ja": "ささげものに対して一つなんだよね……",
          "tc": "一個供品只能許一個願望對吧……",
          "sc": "一个供品只能许一个愿望对吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 339556,
          "spk": "木珠 (コダマ)",
          "ja": "お願いは……お願いは……",
          "tc": "我的願望……我的願望是……",
          "sc": "我的愿望……我的愿望是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339565,
          "spk": "木珠 (コダマ)",
          "ja": "コダマのそばにいて……",
          "tc": "請待在木珠身邊……",
          "sc": "请待在木珠身边……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 339574,
          "spk": "木珠 (コダマ)",
          "ja": "じゃ、だめだよね……",
          "tc": "但這是不行的吧……",
          "sc": "但这是不行的吧……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339583,
          "spk": "木珠 (コダマ)",
          "ja": "みんな助けるには……",
          "tc": "要拯救大家……",
          "sc": "要拯救大家……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 339590,
          "spk": "木珠 (コダマ)",
          "ja": "三つの「ジンギ」を持ってこないと……",
          "tc": "必須帶三件「神器」過來……",
          "sc": "必须带三件“神器”过来……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 339599,
          "spk": "木珠 (コダマ)",
          "ja": "だけど……",
          "tc": "可是……",
          "sc": "可是……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 339608,
          "spk": "木珠 (コダマ)",
          "ja": "そばにいてほしいの……",
          "tc": "好希望祢能待在我身邊……",
          "sc": "好希望你能待在我身边……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 339617,
          "spk": "木珠 (コダマ)",
          "ja": "一人ぼっちは、",
          "tc": "因為自己一個人，",
          "sc": "因为自己一个人，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 339624,
          "spk": "木珠 (コダマ)",
          "ja": "さ、さみしいから……",
          "tc": "很、很寂寞……",
          "sc": "很、很寂寞……"
        }
      ]
    },
