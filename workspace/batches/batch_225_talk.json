        {
          "f_idx": 2,
          "pidx_tc": 340080,
          "spk": "津主 (ヅ主/神明)",
          "ja": "足を　踏み入レ ざらま　しかバ",
          "tc": "那片　蒼色　之地，",
          "sc": "那片　苍色　之地，"
