      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375184,
          "spk": "堇怜 (スミレ)",
          "ja": "おおー！",
          "tc": "哦哦！",
          "sc": "哦哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375191,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと採ってこれたんだな",
          "tc": "真的好好地摘回來了，",
          "sc": "真的好好地摘回来了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375198,
          "spk": "堇怜 (スミレ)",
          "ja": "すごいよ！",
          "tc": "你好厲害喔！",
          "sc": "你好厉害哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375209,
          "spk": "堇怜 (スミレ)",
          "ja": "……なんて、実はもう",
          "tc": "……不過其實我早就知道",
          "sc": "……不过其实我早就知道"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375216,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>がお手伝いできたこと、",
          "tc": "<player>有好好",
          "sc": "<player>有好好"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375223,
          "spk": "堇怜 (スミレ)",
          "ja": "知ってたんだけどね",
          "tc": "幫忙了喔。",
          "sc": "帮忙了哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6502,
      "rec_id": "TALK_ID_70_0130_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375241,
          "spk": "堇怜 (スミレ)",
          "ja": "お手伝い券があるから",
          "tc": "雖然因為拿到了幫忙券，",
          "sc": "虽然因为拿到了帮忙券，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375248,
          "spk": "堇怜 (スミレ)",
          "ja": "採取を任せてみたけど……",
          "tc": "所以拜託你幫忙採花……",
          "sc": "所以拜托你帮忙采花……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375266,
          "spk": "堇怜 (スミレ)",
          "ja": "もしも、本当に獣とか",
          "tc": "但是萬一真的遇到了野獸，",
          "sc": "但是万一真的遇到了野兽，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375273,
          "spk": "堇怜 (スミレ)",
          "ja": "口裂け山女に襲われたら、大変だからさ",
          "tc": "或是被裂嘴山女襲擊的話，那就糟了。",
          "sc": "或是被裂嘴山女袭击的话，那就糟了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375291,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が山で花を探してるところ、",
          "tc": "所以<player>在山上找花的時候，",
          "sc": "所以<player>在山上找花的时候，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 375298,
          "spk": "堇怜 (スミレ)",
          "ja": "こっそり見てたんだ",
          "tc": "我都偷偷在一旁看著。",
          "sc": "我都偷偷在一旁看着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6503,
      "rec_id": "TALK_ID_70_0130_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375316,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、感心したよ",
          "tc": "不過我真的很佩服你。",
          "sc": "不过我真的很佩服你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375323,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、物怖じしないで",
          "tc": "<player>一點都不害怕的樣子，",
          "sc": "<player>一点都不害怕的样子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375330,
          "spk": "堇怜 (スミレ)",
          "ja": "花を採ってきたからね",
          "tc": "就順利把花採回來了。",
          "sc": "就顺利把花采回来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375341,
          "spk": "堇怜 (スミレ)",
          "ja": "小さいナリして、",
          "tc": "你雖然個頭不大，",
          "sc": "你虽然个头不大，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375348,
          "spk": "堇怜 (スミレ)",
          "ja": "度胸のあるヤツだ",
          "tc": "卻很有膽量呢。",
          "sc": "却很有胆量呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375359,
          "spk": "堇怜 (スミレ)",
          "ja": "だから……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375366,
          "spk": "堇怜 (スミレ)",
          "ja": "思ったんだけどさ",
          "tc": "我想，",
          "sc": "我想，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 375373,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>なら、もしかして……",
          "tc": "如果是<player>的話，也許……",
          "sc": "如果是<player>的话，也许……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6504,
      "rec_id": "TALK_ID_70_0130_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375391,
          "spk": "堇怜 (スミレ)",
          "ja": "……今日はありがとう",
          "tc": "……今天真是謝謝你了，",
          "sc": "……今天真是谢谢你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375398,
          "spk": "堇怜 (スミレ)",
          "ja": "花を採ってきてくれたお礼は、ちゃんとするよ",
          "tc": "我會好好準備你幫忙採花回來的謝禮。",
          "sc": "我会好好准备你帮忙采花回来的谢礼。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375416,
          "spk": "堇怜 (スミレ)",
          "ja": "それから……",
          "tc": "還有……",
          "sc": "还有……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375423,
          "spk": "堇怜 (スミレ)",
          "ja": "その時に、ちょっと話したいことがあるんだ",
          "tc": "我有事想跟你聊聊。",
          "sc": "我有事想跟你聊聊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6505,
      "rec_id": "TALK_ID_70_0130_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375448,
          "spk": "堇怜 (スミレ)",
          "ja": "<strong>また明日にでも僕の家に来てよ</strong>",
          "tc": "所以你<strong>明天來我家一趟</strong>吧。",
          "sc": "所以你<strong>明天来我家一趟</strong>吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375455,
          "spk": "堇怜 (スミレ)",
          "ja": "この「話」は、誰にも聞かれたくないからさ",
          "tc": "我不希望其他人聽到我想跟你「聊的事」。",
          "sc": "我不希望其他人听到我想跟你“聊的事”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6506,
      "rec_id": "TALK_ID_70_0130_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375488,
          "spk": "堇怜 (スミレ)",
          "ja": "待ってるからね",
          "tc": "我會等你的。",
          "sc": "我会等你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6507,
      "rec_id": "TALK_ID_70_0130_004_01",
      "lines": [
        {
          "f_idx": 0,
