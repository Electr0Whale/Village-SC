          "tc": "沒想到能做得這麼好……",
          "sc": "没想到能做得这么好……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463848,
          "spk": "木助 (キスケ)",
          "ja": "畑仕事の賜物だな！",
          "tc": "這是平日下田勞動的成果吧！",
          "sc": "这是平日下田劳动的成果吧！"
