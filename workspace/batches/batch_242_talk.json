    {
      "file": "talk.dat",
      "rec_idx": 6701,
      "rec_id": "TALK_ID_70_1004_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463717,
          "spk": "木助 (キスケ)",
          "ja": "なんだ、違うのか",
          "tc": "什麼嘛，不是啊？",
          "sc": "什么嘛，不是啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463724,
          "spk": "木助 (キスケ)",
          "ja": "まあ、やりたくなったらまた来な",
          "tc": "算了，你想試的時候再跟我說吧。",
          "sc": "算了，你想试的时候再跟我说吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463731,
          "spk": "木助 (キスケ)",
          "ja": "俺が責任持ってぶっ叩いておくからよ",
          "tc": "我會負起責任先搗好麻糬的。",
          "sc": "我会负起责任先捣好年糕的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6702,
      "rec_id": "TALK_ID_70_1004_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463753,
          "spk": "木助 (キスケ)",
          "ja": "よし！",
          "tc": "好！",
          "sc": "好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463760,
          "spk": "木助 (キスケ)",
          "ja": "なら、やってみろ！",
          "tc": "那你試試看吧！",
          "sc": "那你试试看吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463771,
          "spk": "木助 (キスケ)",
          "ja": "俺がモチをこねるから、",
          "tc": "我負責揉麻糬，",
          "sc": "我负责揉年糕，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463778,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはタイミングよく叩いてくれ",
          "tc": "你就看準時機敲下去吧！",
          "sc": "你就看准时机敲下去吧！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463785,
          "spk": "木助 (キスケ)",
          "ja": "……俺の手を叩くんじゃねえぞ？",
          "tc": "……可別敲到我的手啊！",
          "sc": "……可别敲到我的手啊！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 463796,
          "spk": "木助 (キスケ)",
          "ja": "じゃ、さっさと始めるか！",
          "tc": "那我們快點開始吧！",
          "sc": "那我们快点开始吧！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 463803,
          "spk": "木助 (キスケ)",
          "ja": "モチは時間をかけると硬くなっちまう",
          "tc": "再等下去麻糬會越來越硬，",
          "sc": "再等下去年糕会越来越硬，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 463810,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもマズいモチは、食いたくねぇだろ？",
          "tc": "你也不想吃到難吃的麻糬吧？",
          "sc": "你也不想吃到难吃的年糕吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6703,
      "rec_id": "TALK_ID_70_1004_001_04",
      "lines": [
        {
