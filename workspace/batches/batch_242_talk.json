      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462521,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ええ～～、それは残念だな",
          "tc": "咦咦～～那還真是可惜耶。",
          "sc": "咦咦～～那还真是可惜呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462528,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日しか買えない特別なヒヨコなんだけどなぁ",
          "tc": "這是只有今天才買得到的特別小雞喔～",
          "sc": "这是只有今天才买得到的特别小鸡哦～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462535,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、気が向いたらまたおいでよ",
          "tc": "算了，你想買的時候再過來吧。",
          "sc": "算了，你想买的时候再过来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6679,
      "rec_id": "TALK_ID_70_1002_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462559,
          "spk": "琪娜娜 (チナナ)",
          "ja": "良い買い物をしたね、<player>",
          "tc": "<player>，你真的是賺到了耶！",
          "sc": "<player>，你真的是赚到了呢！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462566,
          "spk": "琪娜娜 (チナナ)",
          "ja": "是非とも可愛がってあげておくれよ",
          "tc": "一定要好好疼愛牠喔。",
          "sc": "一定要好好疼爱它哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6680,
      "rec_id": "TALK_ID_70_1002_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462590,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、キミ、お金が足りないじゃないか",
          "tc": "我說你啊，身上錢根本就不夠嘛。",
          "sc": "我说你啊，身上钱根本就不够嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462597,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだ、冷やかしは困るよ～～",
          "tc": "搞什麼，只看不買我很困擾耶～～",
          "sc": "搞什么，只看不买我很困扰呢～～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462604,
          "spk": "琪娜娜 (チナナ)",
          "ja": "全く……ほら、帰った帰った",
          "tc": "真是的……好了，回去回去。",
          "sc": "真是的……好了，回去回去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6681,
      "rec_id": "TALK_ID_70_1002_006_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462628,
          "spk": "莲实 (ハスミ)",
          "ja": "あ……<player>さん",
          "tc": "啊……<player>，",
          "sc": "啊……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462635,
          "spk": "莲实 (ハスミ)",
          "ja": "リンゴ飴はいかがですか？",
          "tc": "要不要來個蘋果糖啊？",
          "sc": "要不要来个苹果糖啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462642,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレと一緒に作ったんですよ",
          "tc": "這是我跟堇怜一起做的喔。",
          "sc": "这是我跟堇怜一起做的哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 462653,
          "spk": "莲实 (ハスミ)",
          "ja": "一つ、500円ですが……",
          "tc": "一個500元……",
          "sc": "一个500元……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 462660,
          "spk": "莲实 (ハスミ)",
          "ja": "買って行かれますか？",
          "tc": "要不要買一個嘗嘗啊？",
          "sc": "要不要买一个尝尝啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6682,
      "rec_id": "TALK_ID_70_1002_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462684,
          "spk": "莲实 (ハスミ)",
          "ja": "ちゃんと味見したので、味は保証しますよ",
          "tc": "我有仔細試吃過，保證好吃喔！",
          "sc": "我有仔细试吃过，保证好吃哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462691,
          "spk": "莲实 (ハスミ)",
          "ja": "はい、どうぞ",
          "tc": "來，請用。",
          "sc": "来，请用。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462698,
          "spk": "莲实 (ハスミ)",
          "ja": "召し上がってください",
          "tc": "請嘗嘗看吧。",
          "sc": "请尝尝看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6683,
      "rec_id": "TALK_ID_70_1002_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462722,
          "spk": "莲实 (ハスミ)",
          "ja": "残念……ですが、お気になさらず",
          "tc": "雖然很可惜……但是你不用在意，",
          "sc": "虽然很可惜……但是你不用在意，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462729,
          "spk": "莲实 (ハスミ)",
          "ja": "私はチナナのように押し売りしませんからね",
          "tc": "我不會像琪娜娜那樣強迫推銷的。",
          "sc": "我不会像琪娜娜那样强迫推销的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462736,
          "spk": "莲实 (ハスミ)",
          "ja": "気が変わったら、またいらしてください",
          "tc": "要是改變心意了，歡迎你再過來。",
          "sc": "要是改变心意了，欢迎你再过来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6684,
      "rec_id": "TALK_ID_70_1002_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462760,
          "spk": "莲实 (ハスミ)",
          "ja": "もっと欲しかったら言ってくださいね",
          "tc": "還想吃的話記得跟我說喔！",
          "sc": "还想吃的话记得跟我说哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462767,
          "spk": "莲实 (ハスミ)",
          "ja": "調子に乗って作りすぎちゃったので、",
          "tc": "因為不小心得意忘形做了太多，",
          "sc": "因为不小心得意忘形做了太多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462774,
          "spk": "莲实 (ハスミ)",
          "ja": "まだまだ在庫がありますから……",
          "tc": "現在還有很多庫存……",
          "sc": "现在还有很多库存……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6685,
      "rec_id": "TALK_ID_70_1002_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462798,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、<player>さん、お金が足りませんよ",
          "tc": "哎呀，<player>，你的錢不夠了呢。",
          "sc": "哎呀，<player>，你的钱不够了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462805,
          "spk": "莲实 (ハスミ)",
          "ja": "お祭り、楽しみすぎちゃったようですね",
          "tc": "看來你好像在祭典上玩得太興奮了。",
          "sc": "看来你好像在祭典上玩得太兴奋了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462812,
          "spk": "莲实 (ハスミ)",
          "ja": "また来年も作るので、楽しみにしていてください",
          "tc": "我明年還會再做的，敬請期待吧。",
          "sc": "我明年还会再做的，敬请期待吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6686,
      "rec_id": "TALK_ID_70_1003_000_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462836,
          "spk": "林 (リン)",
          "ja": "今年も収穫祭の時期になったわね",
          "tc": "今年也來到收穫祭典的時節了呢。",
          "sc": "今年也来到收获祭典的时节了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462843,
          "spk": "林 (リン)",
          "ja": "この日を迎えられて何よりだわ",
          "tc": "能迎接這一天真是再好不過了。",
          "sc": "能迎接这一天真是再好不过了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 462861,
          "spk": "林 (リン)",
          "ja": "今日は、おイモを焼くけれど……",
          "tc": "今天會烤地瓜……",
          "sc": "今天会烤红薯……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 462868,
          "spk": "林 (リン)",
          "ja": "食べる時は、ちゃんとこの彼ヶ津の土地と、",
          "tc": "享用的時候，要好好感謝彼津這塊土地，",
          "sc": "享用的时候，要好好感谢彼津这块土地，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 462875,
          "spk": "林 (リン)",
          "ja": "土地に住む神さまたちに感謝するのよ",
          "tc": "還有居住在土地上的神明大人們喔。",
          "sc": "还有居住在土地上的神明大人们。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 462886,
          "spk": "林 (リン)",
          "ja": "……話していたら私もお腹が空いてきたわ",
          "tc": "……講一講我都開始覺得肚子餓了呢。",
          "sc": "……讲一讲我都开始觉得肚子饿了呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 462893,
          "spk": "林 (リン)",
          "ja": "じゃあ、早速お祭りを始めましょう！",
          "tc": "那就馬上進入祭典時間吧！",
          "sc": "那就马上进入祭典时间吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6687,
      "rec_id": "TALK_ID_70_1003_000_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462918,
          "spk": "林 (リン)",
          "ja": "ええ、私もそれがいいと思うわ！",
          "tc": "嗯，我也覺得可以開始了！",
          "sc": "嗯，我也觉得可以开始了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462929,
          "spk": "林 (リン)",
          "ja": "みんな！　収穫祭を始めるわよ",
          "tc": "各位！收穫祭典要開始囉！",
          "sc": "各位！收获祭典要开始啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 462936,
          "spk": "林 (リン)",
          "ja": "それぞれの位置についてちょうだい！",
          "tc": "大家各就各位！",
          "sc": "大家各就各位！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6688,
      "rec_id": "TALK_ID_70_1003_000_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 462965,
          "spk": "林 (リン)",
          "ja": "そう、なら早く準備しなさい",
          "tc": "那就趕快準備吧，",
          "sc": "那就赶快准备吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 462972,
          "spk": "林 (リン)",
          "ja": "みんな焼き芋を待ってるのよ？",
          "tc": "大家都在等著吃烤地瓜呢。",
          "sc": "大家都在等着吃烤红薯呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 462990,
          "spk": "林 (リン)",
          "ja": "もう少し待ってるわね",
          "tc": "還能再等一下吧，",
          "sc": "还能再等一下吧，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 462997,
          "spk": "林 (リン)",
          "ja": "始めてよければ、また声をかけて",
          "tc": "如果可以開始了，再跟我說一聲。",
          "sc": "如果可以开始了，再跟我说一声。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6689,
      "rec_id": "TALK_ID_70_1003_001_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463028,
          "spk": "裕太 (ユータ)",
          "ja": "大地の恵みであるサツマイモを",
          "tc": "用搖曳的火焰之力，",
          "sc": "用摇曳的火焰之力，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463035,
          "spk": "裕太 (ユータ)",
          "ja": "揺らめく炎の力で、ほっくほくの",
          "tc": "將大自然賜予我們的地瓜，",
          "sc": "将大自然赐予我们的红薯，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463042,
          "spk": "裕太 (ユータ)",
          "ja": "甘い焼き芋に変える……",
          "tc": "變成熱騰騰的香甜烤地瓜……",
          "sc": "变成热腾腾的香甜烤红薯……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463053,
          "spk": "裕太 (ユータ)",
          "ja": "俺はこの、サツマイモがじわじわと",
          "tc": "我超級喜歡",
          "sc": "我超级喜欢"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463060,
          "spk": "裕太 (ユータ)",
          "ja": "焼けていくのを見守る時間が",
          "tc": "看著地瓜一點一點",
          "sc": "看着红薯一点一点"
        },
        {
          "f_idx": 5,
          "pidx_tc": 463067,
          "spk": "裕太 (ユータ)",
          "ja": "すごく好きなんだよね",
          "tc": "慢慢烤好的這段時間。",
          "sc": "慢慢烤好的这段时间。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 463078,
          "spk": "裕太 (ユータ)",
          "ja": "もうちょっと待っててね、<player>",
          "tc": "<player>，再等一下喔！",
          "sc": "<player>，再等一下哦！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 463085,
          "spk": "裕太 (ユータ)",
          "ja": "もっともっと、じっくり火を通して",
          "tc": "我會用細火慢烤，",
          "sc": "我会用细火慢烤，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 463092,
          "spk": "裕太 (ユータ)",
          "ja": "最高の状態の焼き芋をあげるから",
          "tc": "烤出最棒的烤地瓜給你的。",
          "sc": "烤出最棒的烤红薯给你的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 463103,
          "spk": "裕太 (ユータ)",
          "ja": "あ、それとも……",
          "tc": "啊，還是說……",
          "sc": "啊，还是说……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 463110,
          "spk": "裕太 (ユータ)",
          "ja": "<player>もサツマイモ、焼いてみる？",
          "tc": "<player>也想試著烤看看？",
          "sc": "<player>也想试着烤看看？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 463117,
          "spk": "裕太 (ユータ)",
          "ja": "自分で焼いてみるのも面白いよ？",
          "tc": "自己烤也很有趣喔！",
          "sc": "自己烤也很有趣哦！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 463126,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 13,
          "pidx_tc": 463133,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6690,
      "rec_id": "TALK_ID_70_1003_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463151,
          "spk": "裕太 (ユータ)",
          "ja": "……あれ？　もしかしてサツマイモ持ってない？",
          "tc": "……咦？該不會你身上沒有地瓜？",
          "sc": "……咦？该不会你身上没有红薯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463158,
          "spk": "裕太 (ユータ)",
          "ja": "絶対楽しいから、ぜひやってみてほしいな",
          "tc": "真的很有趣啦，希望你一定要試試看。",
          "sc": "真的很有趣啦，希望你一定要试试看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6691,
      "rec_id": "TALK_ID_70_1003_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463187,
          "spk": "裕太 (ユータ)",
          "ja": "よし！",
          "tc": "好！",
          "sc": "好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463194,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、やってみよう！",
          "tc": "那就來試試看吧！",
          "sc": "那就来试试看吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463205,
          "spk": "裕太 (ユータ)",
          "ja": "サツマイモは持ってるよね？",
          "tc": "你有帶地瓜吧？",
          "sc": "你有带红薯吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463212,
          "spk": "裕太 (ユータ)",
          "ja": "準備するから、待っててね",
          "tc": "我來準備一下，你先等等。",
          "sc": "我来准备一下，你先等等。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6692,
      "rec_id": "TALK_ID_70_1003_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463236,
          "spk": "裕太 (ユータ)",
          "ja": "おお……！",
          "tc": "哦哦……！",
          "sc": "哦哦……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463243,
          "spk": "裕太 (ユータ)",
          "ja": "上手だね、<player>！",
          "tc": "真厲害耶，<player>！",
          "sc": "真厉害呢，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463250,
          "spk": "裕太 (ユータ)",
          "ja": "いい焼き加減だよ！",
          "tc": "熟度剛剛好！",
          "sc": "熟度刚刚好！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463261,
          "spk": "裕太 (ユータ)",
          "ja": "うん、香ばしくていい匂いだね！",
          "tc": "嗯，聞起來很香！",
          "sc": "嗯，闻起来很香！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463268,
          "spk": "裕太 (ユータ)",
          "ja": "じっくり焼いたんだ",
          "tc": "烤得很均勻。",
          "sc": "烤得很均匀。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 463275,
          "spk": "裕太 (ユータ)",
          "ja": "きっとすごく甘いんじゃない？",
          "tc": "吃起來一定很甜。",
          "sc": "吃起来一定很甜。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 463286,
          "spk": "裕太 (ユータ)",
          "ja": "まだ収穫祭は続いてるから、",
          "tc": "收穫祭典還在舉行，",
          "sc": "收获祭典还在举行，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 463293,
          "spk": "裕太 (ユータ)",
          "ja": "また焼きたかったらサツマイモを持ってきてね",
          "tc": "如果還想烤的話，就帶著地瓜過來吧。",
          "sc": "如果还想烤的话，就带着红薯过来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6693,
      "rec_id": "TALK_ID_70_1003_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463324,
          "spk": "裕太 (ユータ)",
          "ja": "んー、失敗しちゃったね",
          "tc": "嗯～失敗了呢。",
          "sc": "嗯～失败了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463331,
          "spk": "裕太 (ユータ)",
          "ja": "サツマイモを焼くのはちょっとコツがあるんだ",
          "tc": "烤地瓜是需要一點技巧的，",
          "sc": "烤红薯是需要一点技巧的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463338,
          "spk": "裕太 (ユータ)",
          "ja": "早すぎても遅すぎてもダメだよ",
          "tc": "太快太慢都不行喔。",
          "sc": "太快太慢都不行哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463349,
          "spk": "裕太 (ユータ)",
          "ja": "こういうのは慣れだから",
          "tc": "這種事需要經驗，",
          "sc": "这种事需要经验，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463356,
          "spk": "裕太 (ユータ)",
          "ja": "何回か試すとできるようになるよ",
          "tc": "再多試幾次就能成功囉！",
          "sc": "多试几次就能成功啦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 463363,
          "spk": "裕太 (ユータ)",
          "ja": "またやりたくなったら話しかけてね？",
          "tc": "想再試試的話就跟我說吧。",
          "sc": "想再试试的话就跟我说吧。"
        }
      ]
    },
