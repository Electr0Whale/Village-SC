        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6508,
      "rec_id": "TALK_ID_70_0130_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375543,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375550,
          "spk": "堇怜 (スミレ)",
          "ja": "来てくれたんだ",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6509,
      "rec_id": "TALK_ID_70_0130_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375568,
          "spk": "堇怜 (スミレ)",
          "ja": "花のお礼、ちゃんと用意しておいたよ",
          "tc": "我準備了你幫我採花的謝禮喔。",
          "sc": "我准备了你帮我采花的谢礼哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375575,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、これ",
          "tc": "來，拿著。",
          "sc": "来，拿着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6510,
      "rec_id": "TALK_ID_70_0130_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375599,
          "spk": "堇怜 (スミレ)",
          "ja": "カッコいいだろ？",
          "tc": "很酷對吧？",
          "sc": "很酷对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375606,
          "spk": "堇怜 (スミレ)",
          "ja": "これさえあれば、",
          "tc": "只要有了這個，",
          "sc": "只要有了这个，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375613,
          "spk": "堇怜 (スミレ)",
          "ja": "山の獣だって怖くないよ",
          "tc": "山裡的野獸也沒什麼好怕的了。",
          "sc": "山里的野兽也没什么好怕的了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375624,
          "spk": "堇怜 (スミレ)",
          "ja": "さっそく今日からでも",
          "tc": "希望你能從今天開始",
          "sc": "希望你能从今天开始"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375631,
          "spk": "堇怜 (スミレ)",
          "ja": "どんどん使って、",
          "tc": "就多多使用，",
          "sc": "就多多使用，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375638,
          "spk": "堇怜 (スミレ)",
          "ja": "弓に慣れてほしいな",
          "tc": "適應一下怎麼拿弓吧。",
          "sc": "适应一下怎么拿弓吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375649,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が弓を扱えるようになったら、",
          "tc": "等<player>你學會使用弓箭了，",
          "sc": "等<player>你学会使用弓箭了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 375656,
          "spk": "堇怜 (スミレ)",
          "ja": "「こいつ」の出番だ",
          "tc": "就輪到「這傢伙」出場啦。",
          "sc": "就轮到“这家伙”出场啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6511,
      "rec_id": "TALK_ID_70_0130_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375674,
          "spk": "堇怜 (スミレ)",
          "ja": "「こいつ」っていうのは",
          "tc": "「這傢伙」其實就是指",
          "sc": "“这家伙”其实就是指"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375681,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が採ってきてくれた花だよ",
          "tc": "<player>你幫忙採回來的花喔。",
          "sc": "<player>你帮忙采回来的花哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375688,
          "spk": "堇怜 (スミレ)",
          "ja": "今、すり潰して汁を出してたところなんだ！",
          "tc": "我剛好在搗它的汁液呢！",
          "sc": "我刚好在捣它的汁液呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375699,
          "spk": "堇怜 (スミレ)",
          "ja": "トリカブトっていうんだけど",
          "tc": "這種花叫做烏頭，",
          "sc": "这种花叫做乌头，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375706,
          "spk": "堇怜 (スミレ)",
          "ja": "どういう花か、知ってる？",
          "tc": "你知道這是什麼花嗎？",
          "sc": "你知道这是什么花吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375715,
          "spk": "主角心声/旁白/选项",
          "ja": "しってる",
          "tc": "知道",
          "sc": "知道"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375722,
          "spk": "主角心声/旁白/选项",
          "ja": "しらない",
          "tc": "不知道",
          "sc": "不知道"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6512,
      "rec_id": "TALK_ID_70_0130_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375804,
          "spk": "堇怜 (スミレ)",
          "ja": "トリカブトは毒草だからね",
          "tc": "畢竟烏頭可是有毒植物。",
          "sc": "毕竟乌头可是有毒植物。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375811,
          "spk": "堇怜 (スミレ)",
          "ja": "花にも葉っぱにも茎にも根にも、",
          "tc": "不論是花、葉子、莖還是根部，",
          "sc": "不论是花、叶子、茎还是根部，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375818,
          "spk": "堇怜 (スミレ)",
          "ja": "人を殺すくらい強い毒がある",
          "tc": "都含有足以殺死人的劇毒。",
          "sc": "都含有足以杀死人的剧毒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6513,
      "rec_id": "TALK_ID_70_0130_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375836,
          "spk": "堇怜 (スミレ)",
          "ja": "そこでキミにもう一つ",
          "tc": "因此我還有一件事",
          "sc": "因此我还有一件事"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375843,
          "spk": "堇怜 (スミレ)",
          "ja": "頼みたいことがあるんだけど",
          "tc": "想拜託你幫忙。",
          "sc": "想拜托你帮忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375852,
          "spk": "堇怜 (スミレ)",
          "ja": "……協力してくれるかなぁ？",
          "tc": "……你願意幫我嗎？",
          "sc": "……你愿意帮我吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6514,
      "rec_id": "TALK_ID_70_0130_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375870,
          "spk": "堇怜 (スミレ)",
          "ja": "キミの力が必要なんだ",
          "tc": "我需要你的力量，",
          "sc": "我需要你的力量，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375877,
          "spk": "堇怜 (スミレ)",
          "ja": "おねが――",
          "tc": "拜託──",
          "sc": "拜托——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6515,
      "rec_id": "TALK_ID_70_0130_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375903,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お邪魔するよ～",
          "tc": "打擾啦～",
          "sc": "打扰啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6516,
      "rec_id": "TALK_ID_70_0130_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375923,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おお？",
          "tc": "哦？",
          "sc": "哦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375930,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうしたんだい、二人とも",
          "tc": "你們兩個怎麼了？",
          "sc": "你们两个怎么了？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375937,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなにビックリした顔して",
          "tc": "幹嘛露出那麼驚訝的表情？",
          "sc": "干嘛露出那么惊讶的表情？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375950,
          "spk": "堇怜 (スミレ)",
          "ja": "……なんだ、チナナさんか",
          "tc": "……什麼嘛，是琪娜娜姐啊。",
          "sc": "……什么嘛，是琪娜娜姐啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375957,
          "spk": "堇怜 (スミレ)",
          "ja": "何か用ですか？",
          "tc": "有什麼事嗎？",
          "sc": "有什么事吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375970,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミに頼まれてた荷物、",
          "tc": "我把蓮實拜託我的東西",
          "sc": "我把莲实拜托我的东西"
        },
        {
          "f_idx": 6,
          "pidx_tc": 375977,
          "spk": "琪娜娜 (チナナ)",
          "ja": "届けに来たんだ",
          "tc": "送過來了。",
          "sc": "送过来了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 375984,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここに置いとくよ",
          "tc": "就先放在這裡囉。",
          "sc": "就先放在这里啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6517,
      "rec_id": "TALK_ID_70_0130_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 376002,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あれ？",
          "tc": "……嗯？",
          "sc": "……嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 376009,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それ、弓？",
          "tc": "那是弓嗎？",
          "sc": "那是弓吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 376016,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>にあげたのかい？",
          "tc": "你把它送給<player>了？",
