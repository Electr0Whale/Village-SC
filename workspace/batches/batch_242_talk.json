      "rec_id": "TALK_ID_70_0120_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371479,
          "spk": "裕太 (ユータ)",
          "ja": "俺たちは、この村の新入り同士なんだ",
          "tc": "我們都是搬進這村子的新人，",
          "sc": "我们都是搬进这村子的新人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371486,
          "spk": "裕太 (ユータ)",
          "ja": "お互い困ったことがあれば、助け合っていこうね",
          "tc": "彼此如果遇到困難，就互相幫忙吧。",
          "sc": "彼此如果遇到困难，就互相帮忙吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6487,
      "rec_id": "TALK_ID_70_0120_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371511,
          "spk": "裕太 (ユータ)",
          "ja": "<speed 0.5>でも……約束して",
          "tc": "<speed 0.5>但是……你要答應我，",
          "sc": "<speed 0.5>但是……你要答应我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371518,
          "spk": "裕太 (ユータ)",
          "ja": "……あの家には絶対に",
          "tc": "……絕對不可以",
          "sc": "……绝对不可以"
        },
        {
          "f_idx": 2,
          "pidx_tc": 371525,
          "spk": "裕太 (ユータ)",
          "ja": "近づいちゃダメだからね</speed>",
          "tc": "靠近那間房子喔。</speed>",
          "sc": "靠近那间房子哦。</speed>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6488,
      "rec_id": "TALK_ID_70_0120_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371543,
          "spk": "裕太 (ユータ)",
          "ja": "それじゃ、今回はお手伝いありがとう",
          "tc": "那就這樣，這次真的很感謝你的幫忙。",
          "sc": "那就这样，这次真的很感谢你的帮忙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371550,
          "spk": "裕太 (ユータ)",
          "ja": "またいつでも遊びに来てよ",
          "tc": "下次有空再來玩喔！",
          "sc": "下次有空再来玩哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 371557,
          "spk": "裕太 (ユータ)",
          "ja": "<player>なら、いつだって歓迎するからね",
          "tc": "我隨時都很歡迎<player>。",
          "sc": "我随时都很欢迎<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6489,
      "rec_id": "TALK_ID_70_0130_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374538,
          "spk": "堇怜 (スミレ)",
          "ja": "……ん、「お手伝い券」？",
          "tc": "……嗯？「幫忙券」？",
          "sc": "……嗯？“帮忙券”？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374549,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ……掟を破ったから、",
          "tc": "對喔……你因為打破了規矩，",
          "sc": "对哦……你因为打破了规矩，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374556,
          "spk": "堇怜 (スミレ)",
          "ja": "リンに命令されてるんだっけ……",
          "tc": "所以得聽從林的命令啊……",
          "sc": "所以得听从林的命令啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374563,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も大変だな",
          "tc": "<player>也真是辛苦。",
          "sc": "<player>也真是辛苦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374574,
          "spk": "堇怜 (スミレ)",
          "ja": "頼みごとかぁ",
          "tc": "需要幫忙的事嗎，",
          "sc": "需要帮忙的事吗，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 374581,
          "spk": "堇怜 (スミレ)",
          "ja": "何かあったかなぁ……",
          "tc": "我想想……",
          "sc": "我想想……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6490,
      "rec_id": "TALK_ID_70_0130_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374599,
          "spk": "堇怜 (スミレ)",
          "ja": "……あ、ごめん",
          "tc": "……啊，抱歉。",
          "sc": "……啊，抱歉。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374606,
          "spk": "堇怜 (スミレ)",
          "ja": "僕、これからコマコと",
          "tc": "我和駒子約好了，",
          "sc": "我和驹子约好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374613,
          "spk": "堇怜 (スミレ)",
          "ja": "弓の練習をする約束があるんだ",
          "tc": "等等要一起練習射箭呢。",
          "sc": "等等要一起练习射箭呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374624,
          "spk": "堇怜 (スミレ)",
          "ja": "頼みごと考えるから、",
          "tc": "我會想想有什麼需要幫忙的，",
          "sc": "我会想想有什么需要帮忙的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374631,
          "spk": "堇怜 (スミレ)",
          "ja": "一緒に来てもらってもいい？",
          "tc": "所以你可以跟我一起來嗎？",
          "sc": "所以你可以跟我一起来吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6491,
      "rec_id": "TALK_ID_70_0130_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374649,
          "spk": "堇怜 (スミレ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374656,
          "spk": "堇怜 (スミレ)",
          "ja": "遅れそうだ、急ぐぞ！",
          "tc": "快要遲到了，我們趕快走吧！",
          "sc": "快要迟到了，我们赶快走吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6492,
      "rec_id": "TALK_ID_70_0130_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374682,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、スミレくん",
          "tc": "啊，堇怜。",
          "sc": "啊，堇怜。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374689,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も一緒だったんだ？",
          "tc": "<player>也跟你一起啊？",
          "sc": "<player>也跟你一起啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374702,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコんとこ行こうとしてたら",
          "tc": "我正要來找駒子的時候，",
          "sc": "我正要来找驹子的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374709,
          "spk": "堇怜 (スミレ)",
          "ja": "お手伝い券出されたからさ",
          "tc": "就收到了幫忙券，",
          "sc": "就收到了帮忙券，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374716,
          "spk": "堇怜 (スミレ)",
          "ja": "頼みごと考えながら連れてきた",
          "tc": "所以我就邊想著要拜託什麼，邊把人帶來了。",
          "sc": "所以我就边想着要拜托什么，边把人带来了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 374729,
          "spk": "驹子 (コマコ)",
          "ja": "<player>への頼みごとかぁ……",
          "tc": "要請<player>幫忙的事啊……",
          "sc": "要请<player>帮忙的事啊……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 374736,
          "spk": "驹子 (コマコ)",
          "ja": "何か思いついた？",
          "tc": "你有想到了嗎？",
          "sc": "你有想到了吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 374749,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、決めた",
          "tc": "嗯，我想好了。",
          "sc": "嗯，我想好了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 374760,
          "spk": "堇怜 (スミレ)",
          "ja": "山の渓流の崖に",
          "tc": "在山上河流的懸崖邊，",
          "sc": "在山上河流的悬崖边，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 374767,
          "spk": "堇怜 (スミレ)",
          "ja": "花が咲いてる場所があるんだ",
          "tc": "不是有個地方開了很多花嗎？",
          "sc": "不是有个地方开了很多花吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 374778,
          "spk": "堇怜 (スミレ)",
          "ja": "あそこで紫色の花を",
          "tc": "我想要幾朵",
          "sc": "我想要几朵"
        },
        {
          "f_idx": 11,
          "pidx_tc": 374785,
          "spk": "堇怜 (スミレ)",
          "ja": "採ってきてもらおうかなって",
          "tc": "在那裡的紫色的花。",
          "sc": "在那里的紫色的花。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 374798,
          "spk": "驹子 (コマコ)",
          "ja": "花を……？",
          "tc": "採花嗎……？",
          "sc": "采花吗……？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 374809,
          "spk": "驹子 (コマコ)",
          "ja": "でも……",
          "tc": "可是……",
          "sc": "可是……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 374816,
          "spk": "驹子 (コマコ)",
          "ja": "あの辺りはよくない噂が……",
          "tc": "那附近有不太好的傳聞……",
          "sc": "那附近有不太好的传闻……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 374829,
          "spk": "堇怜 (スミレ)",
          "ja": "口の裂けた山女が",
          "tc": "妳是指那裡有嘴巴裂開的山女，",
          "sc": "你是指那里有嘴巴裂开的山女，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 374836,
          "spk": "堇怜 (スミレ)",
          "ja": "口を切り裂こうとしてくるって話でしょ？",
          "tc": "會把人的嘴巴切開的傳聞吧？",
          "sc": "会把人的嘴巴切开的传闻吧？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 374847,
          "spk": "堇怜 (スミレ)",
          "ja": "実際に見た人はいないし",
          "tc": "但實際上又沒有人見過，",
          "sc": "但实际上又没有人见过，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 374854,
          "spk": "堇怜 (スミレ)",
          "ja": "どうせただの噂だよ",
          "tc": "所以肯定只是謠言而已啦。",
          "sc": "所以肯定只是谣言而已啦。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 374867,
          "spk": "驹子 (コマコ)",
          "ja": "け、けど山には獣もいるから",
          "tc": "但、但是山裡還有野獸，",
          "sc": "但、但是山里还有野兽，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 374874,
          "spk": "驹子 (コマコ)",
          "ja": "危険なことに変わりはないよ",
          "tc": "還是一樣很危險的。",
          "sc": "还是一样很危险的。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 374894,
          "spk": "堇怜 (スミレ)",
          "ja": "それも含めて、<player>に",
          "tc": "正是因為這樣，",
          "sc": "正是因为这样，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 374901,
          "spk": "堇怜 (スミレ)",
          "ja": "任せてみようと思ってさ",
          "tc": "我才想交給<player>去試試看啊。",
          "sc": "我才想交给<player>去试试看啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6493,
      "rec_id": "TALK_ID_70_0130_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374921,
          "spk": "堇怜 (スミレ)",
          "ja": "もし難しそうなら自分で採ってくるから",
          "tc": "如果覺得有困難的話，我就自己去採，",
          "sc": "如果觉得有困难的话，我就自己去采，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374928,
          "spk": "堇怜 (スミレ)",
          "ja": "無理しなくていいけど",
          "tc": "不用勉強的。",
          "sc": "不用勉强的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374935,
          "spk": "堇怜 (スミレ)",
          "ja": "……どうかな？",
          "tc": "……怎麼樣？",
          "sc": "……怎么样？"
        }
      ]
    },
    {
      "file": "talk.dat",
