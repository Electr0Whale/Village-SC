        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6699,
      "rec_id": "TALK_ID_70_1004_000_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463620,
          "spk": "林 (リン)",
          "ja": "うん？　まぁいいけど……",
          "tc": "嗯？是可以啦……",
          "sc": "嗯？是可以啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463627,
          "spk": "林 (リン)",
          "ja": "時間は待ってはくれないわよ？",
          "tc": "但時間可是不等人的喔！",
          "sc": "但时间可是不等人的哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463638,
          "spk": "林 (リン)",
          "ja": "いろいろ準備してるうちに、",
          "tc": "要是在忙東忙西的時候，",
          "sc": "要是在忙东忙西的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463645,
          "spk": "林 (リン)",
          "ja": "気がついたら年越しだなんて",
          "tc": "突然發現年已經過了，",
          "sc": "突然发现年已经过了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463652,
          "spk": "林 (リン)",
          "ja": "笑えないんだから",
          "tc": "那可就笑不出來囉～",
          "sc": "那可就笑不出来啦～"
        }
      ]
    },
    {
