      "rec_id": "TALK_ID_70_1004_000_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463498,
          "spk": "林 (リン)",
          "ja": "時が経つのって早いわよね……",
          "tc": "時間過得真快啊……",
          "sc": "时间过得真快啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463505,
          "spk": "林 (リン)",
          "ja": "もう年末だなんて、信じられないわ",
          "tc": "真不敢相信都已經年底了。",
          "sc": "真不敢相信都已经年底了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463523,
          "spk": "林 (リン)",
          "ja": "それだけ毎日を一生懸命",
          "tc": "這一定是因為，",
          "sc": "这一定是因为，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463530,
          "spk": "林 (リン)",
          "ja": "過ごしてこれたってことよね……きっと",
          "tc": "我們總是努力度過每一天吧……",
          "sc": "我们总是努力度过每一天吧……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 463541,
          "spk": "林 (リン)",
          "ja": "一年間お疲れ様",
          "tc": "這一年來辛苦啦，",
          "sc": "这一年来辛苦啦，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 463548,
          "spk": "林 (リン)",
          "ja": "あなたもみんなとゆっくり過ごしなさい",
          "tc": "你也去跟大家一起放鬆一下吧。",
          "sc": "你也去跟大家一起放松一下吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 463555,
          "spk": "林 (リン)",
          "ja": "きっと、<player>と話したがってるはずよ",
          "tc": "他們一定也想跟<player>好好說說話。",
          "sc": "他们一定也想跟<player>好好说说话。"
        }
      ]
    },
