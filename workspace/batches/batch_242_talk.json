      "rec_id": "TALK_ID_70_0130_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 375031,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、そうだ……花を採ったあとは",
          "tc": "啊，對了……你摘了花之後，",
          "sc": "啊，对了……你摘了花之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 375038,
          "spk": "堇怜 (スミレ)",
          "ja": "必ず手を洗うんだよ",
          "tc": "記得一定要洗手喔。",
          "sc": "记得一定要洗手哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 375049,
          "spk": "堇怜 (スミレ)",
          "ja": "絶対にそのままご飯を",
          "tc": "千萬不能就那樣",
          "sc": "千万不能就那样"
        },
        {
          "f_idx": 3,
          "pidx_tc": 375056,
          "spk": "堇怜 (スミレ)",
          "ja": "食べたりしないでね……",
          "tc": "直接吃東西喔……",
          "sc": "直接吃东西哦……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 375067,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、待ってるから",
          "tc": "那我等你，",
          "sc": "那我等你，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 375074,
          "spk": "堇怜 (スミレ)",
          "ja": "気をつけて行ってきてよ",
          "tc": "路上小心喔。",
          "sc": "路上小心哦。"
        }
      ]
    },
