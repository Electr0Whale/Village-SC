        {
          "f_idx": 4,
          "pidx_tc": 463866,
          "spk": "木助 (キスケ)",
          "ja": "なかなかの出来栄えだぜ",
          "tc": "成品很不錯喔！",
          "sc": "成品很不错啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6704,
      "rec_id": "TALK_ID_70_1004_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 463890,
          "spk": "木助 (キスケ)",
          "ja": "あぁ、そうだ",
          "tc": "啊，對了！",
          "sc": "啊，对了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 463897,
          "spk": "木助 (キスケ)",
          "ja": "チナナが鏡餅を作ってるぜ",
          "tc": "琪娜娜正在做鏡餅，",
          "sc": "琪娜娜正在做镜饼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 463904,
          "spk": "木助 (キスケ)",
          "ja": "モチを２つ持って行ってみたらどうだ？",
          "tc": "你何不帶2個麻糬過去找她？",
          "sc": "你何不带2个年糕过去找她？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 463915,
          "spk": "木助 (キスケ)",
          "ja": "普通に食っても美味いだろうけどな",
          "tc": "雖然直接吃應該也很好吃啦，",
          "sc": "虽然直接吃应该也很好吃啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 463922,
          "spk": "木助 (キスケ)",
          "ja": "まぁ、てめぇの好きにしな",
          "tc": "怎樣都好，你自己看著辦吧。",
          "sc": "怎样都好，你自己看着办吧。"
        }
      ]
    },
    {
