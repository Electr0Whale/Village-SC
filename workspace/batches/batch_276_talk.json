      "rec_id": "TALK_ID_70_2150_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392878,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっはっはっは",
          "tc": "啊哈哈哈，",
          "sc": "啊哈哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392885,
          "spk": "琪娜娜 (チナナ)",
          "ja": "辛かったかい？",
          "tc": "很辣嗎？",
          "sc": "很辣吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392896,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この辛さをビールで",
          "tc": "這種辣度",
          "sc": "这种辣度"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392903,
          "spk": "琪娜娜 (チナナ)",
          "ja": "流し込むのが",
          "tc": "最適合",
          "sc": "最适合"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392910,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいんだけどねえ",
          "tc": "配上一杯啤酒了。",
          "sc": "配上一杯啤酒了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392921,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうだい、<player>？",
          "tc": "怎麼樣啊，<player>？",
          "sc": "怎么样啊，<player>？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392928,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミもウチと一緒に",
          "tc": "你要不要跟我一起喝",
          "sc": "你要不要跟我一起喝"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "シュワシュワを飲むかい？",
          "tc": "會冒泡泡的飲料啊？",
          "sc": "会冒泡泡的饮料啊？"
        },
        {
