        {
          "f_idx": 1,
          "pidx_tc": 392756,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご馳走を用意して",
          "tc": "我已經準備好了大餐，",
          "sc": "我已经准备好了大餐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392763,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392774,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はウチのお手製",
          "tc": "今天是我自製的",
          "sc": "今天是我自制的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392781,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「バーニャカウダ」だよ",
          "tc": "「熱沾醬沙拉」。",
          "sc": "“热沾酱沙拉”。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392790,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ニンニクやオリーブオイルを混ぜたソースを",
          "tc": "把加入了大蒜與橄欖油的醬汁",
          "sc": "把加入了大蒜与橄榄油的酱汁"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392797,
          "spk": "琪娜娜 (チナナ)",
          "ja": "温めてから、野菜につけて食べるんだよ",
          "tc": "加熱過後，就可以用蔬菜沾著吃了。",
          "sc": "加热过后，就可以用蔬菜沾着吃了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392804,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチのは唐辛子もいっぱい入れてあるんだ",
          "tc": "我獨創的秘訣是加入很多辣椒。",
          "sc": "我独创的秘诀是加入很多辣椒。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392815,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、冷めないうちに",
          "tc": "來吧，",
          "sc": "来吧，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392822,
          "spk": "琪娜娜 (チナナ)",
          "ja": "召し上がれ",
          "tc": "我們趕快趁熱吃。",
          "sc": "我们赶快趁热吃。"
        }
      ]
    },
    {
