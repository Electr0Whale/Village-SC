  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7782,
      "rec_id": "TALK_ID_70_2130_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448378,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>とゆっくり話せる時が",
          "tc": "有件事我一直想趁能和<player>",
          "sc": "有件事我一直想趁能和<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 448385,
          "spk": "堇怜 (スミレ)",
          "ja": "来たら話そうと思ってたことがあってさ",
          "tc": "好好聊一聊的時候對你說。",
          "sc": "好好聊一聊的时候对你说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 448394,
          "spk": "堇怜 (スミレ)",
          "ja": "僕と姉さん……それと、チナナさんを",
          "tc": "不論是我和姊姊……還是琪娜娜姐，",
          "sc": "不论是我和姐姐……还是琪娜娜姐，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 448401,
          "spk": "堇怜 (スミレ)",
          "ja": "助けてくれてありがとう",
          "tc": "謝謝你幫了我們。",
          "sc": "谢谢你帮了我们。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 448410,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>がいなかったら",
          "tc": "要是沒有<player>，",
          "sc": "要是没有<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 448417,
          "spk": "堇怜 (スミレ)",
          "ja": "僕たち、すれ違い続けてたと思う",
          "tc": "我們之間大概會一直錯過彼此。",
          "sc": "我们之间大概会一直错过彼此。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 448426,
          "spk": "堇怜 (スミレ)",
          "ja": "……姉さんとチナナさんは",
          "tc": "……姊姊和琪娜娜姐的身心，",
          "sc": "……姐姐和琪娜娜姐的身心，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 448433,
          "spk": "堇怜 (スミレ)",
          "ja": "心も身体も傷つけ続けてたはずだ",
          "tc": "恐怕都會一直受傷下去。",
          "sc": "恐怕都会一直受伤下去。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 448449,
          "spk": "堇怜 (スミレ)",
          "ja": "自分がどれだけ浅いところしか",
          "tc": "對於自己看事情的眼光",
          "sc": "对于自己看事情的眼光"
        },
        {
          "f_idx": 10,
          "pidx_tc": 448456,
          "spk": "堇怜 (スミレ)",
          "ja": "見られてなかったか",
          "tc": "究竟有多麼膚淺，",
          "sc": "究竟有多么肤浅，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 448463,
          "spk": "堇怜 (スミレ)",
          "ja": "身に染みてわかったんだ……",
          "tc": "我算是深刻體會到了……",
          "sc": "我算是深刻体会到了……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 448472,
          "spk": "堇怜 (スミレ)",
          "ja": "だからこれからは……",
          "tc": "所以從今以後……",
          "sc": "所以从今以后……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 448479,
          "spk": "堇怜 (スミレ)",
          "ja": "物事をもっと深いところまで",
          "tc": "我想變得能夠",
          "sc": "我想变得能够"
        },
        {
          "f_idx": 14,
          "pidx_tc": 448486,
          "spk": "堇怜 (スミレ)",
          "ja": "見られるようになりたいんだ",
          "tc": "更加看清事物的本質。",
          "sc": "更加看清事物的本质。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7783,
      "rec_id": "TALK_ID_70_2130_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448502,
          "spk": "堇怜 (スミレ)",
          "ja": "この先、大学進学のために",
          "tc": "以後我為了念大學，",
          "sc": "以后我为了念大学，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 448509,
          "spk": "堇怜 (スミレ)",
          "ja": "村を出ることになるかもしれない……",
          "tc": "也許必須離開村子……",
          "sc": "也许必须离开村子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 448518,
          "spk": "堇怜 (スミレ)",
          "ja": "でも必ず戻ってくるよ",
          "tc": "但我一定會回來的。",
          "sc": "但我一定会回来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 448527,
          "spk": "堇怜 (スミレ)",
          "ja": "少しの間、<player>と",
          "tc": "雖然會和<player>",
          "sc": "虽然会和<player>"
        },
        {
          "f_idx": 4,
          "pidx_tc": 448534,
          "spk": "堇怜 (スミレ)",
          "ja": "離れ離れになるけど",
          "tc": "分開一段時間……",
          "sc": "分开一段时间……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 448541,
          "spk": "堇怜 (スミレ)",
          "ja": "待っててくれる？",
          "tc": "你願意等我嗎？",
          "sc": "你愿意等我吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 448550,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 7,
          "pidx_tc": 448557,
          "spk": "主角心声/旁白/选项",
          "ja": "わからない",
          "tc": "不知道",
          "sc": "不知道"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7784,
      "rec_id": "TALK_ID_70_2130_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448651,
          "spk": "堇怜 (スミレ)",
          "ja": "これからもよろしく、<player>",
          "tc": "今後也請多多指教，<player>。",
          "sc": "今后也请多多指教，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7785,
      "rec_id": "TALK_ID_70_2130_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448667,
          "spk": "堇怜 (スミレ)",
          "ja": "ふわぁ～……",
          "tc": "呼啊……",
          "sc": "呼啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 448676,
          "spk": "堇怜 (スミレ)",
          "ja": "話に付き合ってくれてありがとう",
          "tc": "謝謝你陪我聊天。",
          "sc": "谢谢你陪我聊天。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 448683,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、おやすみ",
          "tc": "那麼，晚安。",
          "sc": "那么，晚安。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7786,
      "rec_id": "TALK_ID_70_2130_010_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448703,
          "spk": "堇怜 (スミレ)",
          "ja": "昨日は伝えたいことを",
          "tc": "昨天能把想說的話告訴給你，",
          "sc": "昨天能把想说的话告诉给你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 448710,
          "spk": "堇怜 (スミレ)",
          "ja": "伝えられてよかった",
          "tc": "真的太好了。",
          "sc": "真的太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 448721,
          "spk": "堇怜 (スミレ)",
          "ja": "これからも<player>とは",
          "tc": "從今以後我也想和<player>",
          "sc": "从今以后我也想和<player>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 448728,
          "spk": "堇怜 (スミレ)",
          "ja": "いい友達でいたいな",
          "tc": "繼續當好朋友。",
          "sc": "继续当好朋友。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 448739,
          "spk": "堇怜 (スミレ)",
          "ja": "また、うちに泊まりにきてよ",
          "tc": "改天再來我家過夜吧。",
          "sc": "改天再来我家过夜吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 448746,
          "spk": "堇怜 (スミレ)",
          "ja": "約束だぜ！",
          "tc": "約好囉！",
          "sc": "约好啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7787,
      "rec_id": "TALK_ID_70_2140_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421446,
          "spk": "莲实 (ハスミ)",
          "ja": "あら？",
          "tc": "哎呀？",
          "sc": "哎呀？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421453,
          "spk": "莲实 (ハスミ)",
          "ja": "二人とも、今日は一緒なんですね",
          "tc": "兩位今天一起出現呢。",
          "sc": "两位今天一起出现呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421468,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……そうだな",
          "tc": "嗯……這個嘛。",
          "sc": "嗯……这个嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421481,
          "spk": "驹子 (コマコ)",
          "ja": "私が使っていた机が壊れちゃって……",
          "tc": "我一直使用的桌子壞了……",
          "sc": "我一直使用的桌子坏了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421488,
          "spk": "驹子 (コマコ)",
          "ja": "新しい机を買うために、",
          "tc": "為了去買新的桌子，",
          "sc": "为了去买新的桌子，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421495,
          "spk": "驹子 (コマコ)",
          "ja": "一緒についてきてくれたの",
          "tc": "他就陪我一起來了。",
          "sc": "他就陪我一起来了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421506,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコ一人だと、",
          "tc": "因為駒子一個人去買的話，",
          "sc": "因为驹子一个人去买的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421513,
          "spk": "四郎治 (シロージ)",
          "ja": "持って帰る時に大変かと思ってな",
          "tc": "拿回家時肯定很辛苦。",
          "sc": "拿回家时肯定很辛苦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 421526,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふふ……",
          "tc": "呵呵呵……",
          "sc": "呵呵呵……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 421533,
          "spk": "莲实 (ハスミ)",
          "ja": "相変わらずの、仲よし兄妹ですね",
          "tc": "還是老樣子，兄妹感情很好呢。",
          "sc": "还是老样子，兄妹感情很好呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 421544,
          "spk": "莲实 (ハスミ)",
          "ja": "お互い困った時は、",
          "tc": "感覺你們有困難的時候，",
          "sc": "感觉你们有困难的时候，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 421551,
          "spk": "莲实 (ハスミ)",
          "ja": "二人で相談してるのかしら……",
          "tc": "都會跟對方商量……",
          "sc": "都会跟对方商量……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 421558,
          "spk": "莲实 (ハスミ)",
          "ja": "……少し羨ましいわね",
          "tc": "……我有點羨慕呢。",
          "sc": "……我有点羡慕呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7788,
      "rec_id": "TALK_ID_70_2140_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421586,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、<player>さん",
          "tc": "哎呀，<player>。",
          "sc": "哎呀，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421593,
          "spk": "莲实 (ハスミ)",
          "ja": "こんにちは、お散歩ですか？",
          "tc": "你好，出來散步嗎？",
          "sc": "你好，出来散步吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421604,
          "spk": "莲实 (ハスミ)",
          "ja": "私はもう少し仕事をしてから",
          "tc": "我打算再工作一下",
          "sc": "我打算再工作一下"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421611,
          "spk": "莲实 (ハスミ)",
          "ja": "診療所に戻る予定です",
          "tc": "就回去診所。",
          "sc": "就回去诊所。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7789,
      "rec_id": "TALK_ID_70_2140_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421629,
          "spk": "莲实 (ハスミ)",
          "ja": "……このようにうろつき回っていては、",
          "tc": "……我這樣到處遊蕩，",
          "sc": "……我这样到处游荡，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421636,
          "spk": "莲实 (ハスミ)",
          "ja": "仕事しているようには見えませんよね？",
          "tc": "看起來不像是在工作吧？",
          "sc": "看起来不像是在工作吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421654,
          "spk": "莲实 (ハスミ)",
          "ja": "ですが、これも",
          "tc": "但這也是",
          "sc": "但这也是"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421661,
          "spk": "莲实 (ハスミ)",
          "ja": "私の欠かせない仕事の一つなんですよ",
          "tc": "我無可或缺的工作之一喔。",
          "sc": "我无可或缺的工作之一哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421672,
          "spk": "莲实 (ハスミ)",
          "ja": "医者というのは、",
          "tc": "我聽人說，所謂的醫生，",
          "sc": "我听人说，所谓的医生，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421679,
          "spk": "莲实 (ハスミ)",
          "ja": "体調の悪い患者さんを出迎えるだけでは、",
          "tc": "光只是等待身體不適的患者前來，",
          "sc": "光只是等待身体不适的患者前来，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421686,
          "spk": "莲实 (ハスミ)",
          "ja": "仕事をしているとは言えないと聞きます",
          "tc": "是不能說有在工作的。",
          "sc": "是不能说有在工作的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 421697,
          "spk": "莲实 (ハスミ)",
          "ja": "……とはいえ、私は医者ではありませんから、",
          "tc": "……話雖這麼說，但我並非醫生，",
          "sc": "……话虽这么说，但我并非医生，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 421704,
          "spk": "莲实 (ハスミ)",
          "ja": "みなさんが健康でいられるようにと、",
          "tc": "只是個因為希望大家都能身體健康，",
          "sc": "只是个因为希望大家都能身体健康，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 421711,
          "spk": "莲实 (ハスミ)",
          "ja": "素人なりに真似をしているだけなんですが……",
          "tc": "學著做些醫生會做的事情的普通人罷了……",
          "sc": "学着做些医生会做的事情的普通人罢了……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 421722,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方を調合するかたわら、",
          "tc": "除了調配些漢方藥，",
          "sc": "除了调配些汉方药，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 421729,
          "spk": "莲实 (ハスミ)",
          "ja": "診療所の外に出ることも多いんです",
          "tc": "我也經常離開診所外出。",
          "sc": "我也经常离开诊所外出。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 421747,
          "spk": "莲实 (ハスミ)",
          "ja": "この村は住人の数も少ないですし……",
          "tc": "畢竟這個村子裡的居民不多，",
          "sc": "毕竟这个村子里的居民不多，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 421765,
          "spk": "莲实 (ハスミ)",
          "ja": "さっきみたいに他愛ない雑談をしながら",
          "tc": "所以會像剛才一樣一邊閒聊，",
          "sc": "所以会像刚才一样一边闲聊，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 421772,
          "spk": "莲实 (ハスミ)",
          "ja": "身体に変化が起きていないかなど",
          "tc": "一邊問問大家",
          "sc": "一边问问大家"
        },
        {
          "f_idx": 18,
          "pidx_tc": 421779,
          "spk": "莲实 (ハスミ)",
          "ja": "聞くようにしているんです",
          "tc": "身體有沒有任何變化。",
          "sc": "身体有没有任何变化。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 421790,
          "spk": "莲实 (ハスミ)",
          "ja": "それが、この村における、",
          "tc": "這就是我",
          "sc": "这就是我"
        },
        {
          "f_idx": 20,
          "pidx_tc": 421797,
          "spk": "莲实 (ハスミ)",
          "ja": "私の役割ですから……",
          "tc": "在這個村子裡的職責……",
          "sc": "在这个村子里的职责……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 421808,
          "spk": "莲实 (ハスミ)",
          "ja": "いいですか、<player>さん？",
          "tc": "聽好囉，<player>。",
          "sc": "听好啦，<player>。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 421815,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬は、一般薬とは違います",
          "tc": "漢方藥跟一般藥劑不同。",
          "sc": "汉方药跟一般药剂不同。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 421822,
          "spk": "莲实 (ハスミ)",
          "ja": "過信しすぎないようしてくださいね",
          "tc": "千萬不能太過迷信喔！",
          "sc": "千万不能太过迷信哦！"
        },
        {
          "f_idx": 24,
          "pidx_tc": 421831,
          "spk": "莲实 (ハスミ)",
          "ja": "何よりも大事なのは",
          "tc": "最重要的，",
          "sc": "最重要的，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 421838,
          "spk": "莲实 (ハスミ)",
          "ja": "自分で健康管理をすることです",
          "tc": "是要自己做好健康管理。",
          "sc": "是要自己做好健康管理。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 421854,
          "spk": "莲实 (ハスミ)",
          "ja": "身体や心に発生した異変は",
          "tc": "當身體或心靈出現異狀時，",
          "sc": "当身体或心灵出现异状时，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 421861,
          "spk": "莲实 (ハスミ)",
          "ja": "本人が一番わかるんですから",
          "tc": "當事人是最清楚的。",
          "sc": "当事人是最清楚的。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 421879,
          "spk": "莲实 (ハスミ)",
          "ja": "少しでも気になった時は遠慮せず、",
          "tc": "如果有任何在意的事，",
          "sc": "如果有任何在意的事，"
        },
        {
          "f_idx": 31,
          "pidx_tc": 421886,
          "spk": "莲实 (ハスミ)",
          "ja": "すぐ相談に来てくださいね",
          "tc": "你隨時都可以來找我商量喔！",
          "sc": "你随时都可以来找我商量哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7790,
      "rec_id": "TALK_ID_70_2140_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421910,
          "spk": "莲实 (ハスミ)",
          "ja": "これでよし、と……",
          "tc": "這樣就行了……",
          "sc": "这样就行了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7791,
      "rec_id": "TALK_ID_70_2140_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421934,
          "spk": "莲实 (ハスミ)",
          "ja": "ああ、<player>さんですか",
          "tc": "啊，是<player>啊。",
          "sc": "啊，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421945,
          "spk": "莲实 (ハスミ)",
          "ja": "来てくれたのは嬉しいのですが、",
          "tc": "雖然很高興看到你來，",
          "sc": "虽然很高兴看到你来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421952,
          "spk": "莲实 (ハスミ)",
          "ja": "これから出かける用事がありまして……",
          "tc": "但我接下來有事要出去一趟……",
          "sc": "但我接下来有事要出去一趟……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421963,
          "spk": "莲实 (ハスミ)",
          "ja": "リンから頼まれた漢方薬の調合が",
          "tc": "林拜託我調配的漢方藥",
          "sc": "林拜托我调配的汉方药"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421970,
          "spk": "莲实 (ハスミ)",
          "ja": "今さっき終わったところなんです",
          "tc": "剛好完成了。",
          "sc": "刚好完成了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421988,
          "spk": "莲实 (ハスミ)",
          "ja": "その薬を今度は、村の人たちに",
          "tc": "再來得把藥拿給",
          "sc": "再来得把药拿给"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421995,
          "spk": "莲实 (ハスミ)",
          "ja": "届けに行かなくては……",
          "tc": "村子裡的大家才行……",
          "sc": "村子里的大家才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7792,
      "rec_id": "TALK_ID_70_2140_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422013,
          "spk": "莲实 (ハスミ)",
          "ja": "心配してくれるのですか？",
          "tc": "你在擔心我嗎？",
          "sc": "你在担心我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422020,
          "spk": "莲实 (ハスミ)",
          "ja": "……ありがとうございます",
          "tc": "……謝謝你。",
          "sc": "……谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422031,
          "spk": "莲实 (ハスミ)",
          "ja": "けど、このくらい平気です",
          "tc": "不過，這點事沒問題的。",
          "sc": "不过，这点事没问题的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422042,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん、体調管理は気をつけています",
          "tc": "當然，我有在注意自己的身體狀況。",
          "sc": "当然，我有在注意自己的身体状况。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422049,
          "spk": "莲实 (ハスミ)",
          "ja": "私が倒れたら、みんな困りますからね",
          "tc": "畢竟我倒下了會給大家添麻煩嘛。",
          "sc": "毕竟我倒下了会给大家添麻烦嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7793,
      "rec_id": "TALK_ID_70_2140_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422080,
          "spk": "堇怜 (スミレ)",
          "ja": "そういうことじゃないよ",
          "tc": "重點不是那個吧。",
          "sc": "重点不是那个吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7794,
      "rec_id": "TALK_ID_70_2140_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422102,
          "spk": "堇怜 (スミレ)",
          "ja": "まず何よりも、自分の身体を",
          "tc": "無論如何都應該先照顧好",
          "sc": "无论如何都应该先照顾好"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422109,
          "spk": "堇怜 (スミレ)",
          "ja": "もっと労わってくれないと",
          "tc": "自己的身體才對啊。",
          "sc": "自己的身体才对啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422122,
          "spk": "莲实 (ハスミ)",
          "ja": "……スミレも、ありがとう",
          "tc": "……謝謝你，堇怜。",
          "sc": "……谢谢你，堇怜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422129,
          "spk": "莲实 (ハスミ)",
          "ja": "でもこれは、私自身がやりたいことだから",
          "tc": "但這是我自己想做的事。",
          "sc": "但这是我自己想做的事。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422142,
          "spk": "堇怜 (スミレ)",
          "ja": "だとしても、優先順位が",
          "tc": "就算這樣，",
          "sc": "就算这样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 422149,
          "spk": "堇怜 (スミレ)",
          "ja": "間違ってるんじゃないの？",
          "tc": "妳是不是搞錯優先順序了？",
          "sc": "你是不是搞错优先顺序了？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 422160,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は、村のみんなの健康よりも",
          "tc": "對我來說，比起村民的健康，",
          "sc": "对我来说，比起村民的健康，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 422167,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんの方が心配だよ",
          "tc": "姊姊還比較重要。",
          "sc": "姐姐还比较重要。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7795,
      "rec_id": "TALK_ID_70_2140_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422185,
          "spk": "莲实 (ハスミ)",
          "ja": "それでも、誰かが気を配らないといけないわ",
          "tc": "就算如此，總要有人留意大家的健康才行啊。",
          "sc": "就算如此，总要有人留意大家的健康才行啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422192,
          "spk": "莲实 (ハスミ)",
          "ja": "……この村には医者がいないし、",
          "tc": "……這座村子裡沒有醫生，",
          "sc": "……这座村子里没有医生，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422199,
          "spk": "莲实 (ハスミ)",
          "ja": "簡単に大きな病院がある街にも出られない",
          "tc": "也沒辦法隨意地前往有大醫院的城市。",
          "sc": "也没办法随意地前往有大医院的城市。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422210,
          "spk": "莲实 (ハスミ)",
          "ja": "小さな病気や怪我でも、",
          "tc": "就算是小病或受傷，",
          "sc": "就算是小病或受伤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422217,
          "spk": "莲实 (ハスミ)",
          "ja": "放っておけば大事になる……",
          "tc": "放著不管也會變嚴重的……",
          "sc": "放着不管也会变严重的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 422224,
          "spk": "莲实 (ハスミ)",
          "ja": "だから、些細なことでも見逃すわけにはいかないの",
          "tc": "所以說，任何一點小問題都不能放過。",
          "sc": "所以说，任何一点小问题都不能放过。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 422237,
          "spk": "堇怜 (スミレ)",
          "ja": "言ってることはわかるけど、",
          "tc": "你說的我都懂，",
          "sc": "你说的我都懂，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 422244,
          "spk": "堇怜 (スミレ)",
          "ja": "それは姉さんの役割なの？",
          "tc": "但那是姊姊妳的職責嗎？",
          "sc": "但那是姐姐你的职责吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 422251,
          "spk": "堇怜 (スミレ)",
          "ja": "本物の医者でもないのに……？",
          "tc": "妳根本就不是真正的醫生啊……？",
          "sc": "你根本就不是真正的医生啊……？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 422264,
          "spk": "莲实 (ハスミ)",
          "ja": "母さんがいない今、誰かがやらないといけないの",
          "tc": "媽媽不在了，現在必須要有人來做這件事。",
          "sc": "妈妈不在了，现在必须要有人来做这件事。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 422271,
          "spk": "莲实 (ハスミ)",
          "ja": "私は医者にはなれなかったけれど……",
          "tc": "雖然我沒辦法成為醫生……",
          "sc": "虽然我没办法成为医生……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 422278,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、医学を勉強して、私が代わりにならないと",
          "tc": "但我還是得學習醫術，代替媽媽的職責。",
          "sc": "但我还是得学习医术，代替妈妈的职责。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 422289,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレも村で誰かが困っていたら",
          "tc": "如果村子裡有人遇到困難，",
          "sc": "如果村子里有人遇到困难，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 422296,
          "spk": "莲实 (ハスミ)",
          "ja": "手を差し伸べてあげて",
          "tc": "堇怜也要伸出援手喔。",
          "sc": "堇怜也要伸出援手哦。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 422309,
          "spk": "堇怜 (スミレ)",
          "ja": "……わかったよ",
          "tc": "……我知道了。",
          "sc": "……我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7796,
      "rec_id": "TALK_ID_70_2140_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422331,
          "spk": "莲实 (ハスミ)",
          "ja": "さてと……私は少し外に出てきますね",
          "tc": "好了……那我出門一下喔。",
          "sc": "好了……那我出门一下哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7797,
      "rec_id": "TALK_ID_70_2140_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422355,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんがああだから",
          "tc": "還不是因為姊姊那個樣子，",
          "sc": "还不是因为姐姐那个样子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422362,
          "spk": "堇怜 (スミレ)",
          "ja": "みんな、無茶ばかり言ってくるんだよ",
          "tc": "大家才老是提出一些過分的要求。",
          "sc": "大家才老是提出一些过分的要求。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422373,
          "spk": "堇怜 (スミレ)",
          "ja": "みんな姉さんに頼りっぱなしで……",
          "tc": "所有人都太依賴姊姊了……",
          "sc": "所有人都太依赖姐姐了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422380,
          "spk": "堇怜 (スミレ)",
          "ja": "どこかで無理が来ないように",
          "tc": "為了避免她哪天太過勉強自己，",
          "sc": "为了避免她哪天太过勉强自己，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422387,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が支えてあげなくちゃ",
          "tc": "我要成為姊姊的支柱才行。",
          "sc": "我要成为姐姐的支柱才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7798,
      "rec_id": "TALK_ID_70_2140_002_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422411,
          "spk": "堇怜 (スミレ)",
          "ja": "それにしても、姉さんはいつ見ても",
          "tc": "話說回來，姊姊無論何時都好可靠，",
          "sc": "话说回来，姐姐无论何时都好可靠，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422418,
          "spk": "堇怜 (スミレ)",
          "ja": "しっかりしてて、すごいよ",
          "tc": "她真的很厲害。",
          "sc": "她真的很厉害。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422429,
          "spk": "堇怜 (スミレ)",
          "ja": "すぐそばに、立派な大人がいるんだ",
          "tc": "這麼了不起的榜樣就在身邊……",
          "sc": "这么了不起的榜样就在身边……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422436,
          "spk": "堇怜 (スミレ)",
          "ja": "……僕たちも見習わなくちゃね",
          "tc": "我們也要學著點才行呢！",
          "sc": "我们也要学着点才行呢！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7799,
      "rec_id": "TALK_ID_70_2140_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422462,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミ……",
          "tc": "蓮實……",
          "sc": "莲实……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422469,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの話、ちゃんと聞くつもりある？",
          "tc": "我說的話，妳有聽進去的意思嗎？",
          "sc": "我说的话，你有听进去的意思吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422482,
          "spk": "莲实 (ハスミ)",
          "ja": "も、もちろんよ……",
          "tc": "當、當然有……",
          "sc": "当、当然有……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422489,
          "spk": "莲实 (ハスミ)",
          "ja": "改めるべきは、改めるから……",
          "tc": "該改進的地方，我會改的……",
          "sc": "该改进的地方，我会改的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7800,
      "rec_id": "TALK_ID_70_2140_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422515,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何の話かって？",
          "tc": "妳問是什麼事？",
          "sc": "你问是什么事？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422522,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……もっと自分の身体を労われっていう",
          "tc": "……為了讓妳更愛惜自己的身體，",
          "sc": "……为了让你更爱惜自己的身体，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422529,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありがたーい「お説教」さ",
          "tc": "我要來說些感人的「大道理」了。",
          "sc": "我要来说些感人的“大道理”了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422540,
          "spk": "琪娜娜 (チナナ)",
          "ja": "前々から気になってたんだけど",
          "tc": "從之前我就一直很在意，",
          "sc": "从之前我就一直很在意，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "少し度が過ぎるものだから",
          "tc": "妳也太超過了。",
          "sc": "你也太超过了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 422558,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酒を呑む量が、ね",
          "tc": "我是說妳未免也喝太多酒了。",
          "sc": "我是说你未免也喝太多酒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7801,
      "rec_id": "TALK_ID_70_2140_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422591,
          "spk": "莲实 (ハスミ)",
          "ja": "うう……",
          "tc": "唔唔……",
          "sc": "唔唔……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422604,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミは浴びるように酒を呑むんだよ",
          "tc": "蓮實妳喝酒簡直像用灌的。",
          "sc": "莲实你喝酒简直像用灌的。"
