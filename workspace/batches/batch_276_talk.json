  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7870,
      "rec_id": "TALK_ID_70_2150_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390818,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ええっとお",
          "tc": "……呃，",
          "sc": "……呃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390825,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうしよう、困ったな……",
          "tc": "該怎麼辦呢？真傷腦筋……",
          "sc": "该怎么办呢？真伤脑筋……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390836,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ～……そうだ",
          "tc": "啊……對了，",
          "sc": "啊……对了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390843,
          "spk": "琪娜娜 (チナナ)",
          "ja": "簡単に割れちゃったってことは",
          "tc": "既然會輕易裂開，",
          "sc": "既然会轻易裂开，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390850,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それは偽物かもしれないねえ",
          "tc": "那就代表這可能是冒牌貨吧。",
          "sc": "那就代表这可能是冒牌货吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 390859,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外に連絡を取って、",
          "tc": "我之後會再跟外面聯絡，",
          "sc": "我之后会再跟外面联络，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 390866,
          "spk": "琪娜娜 (チナナ)",
          "ja": "確認してみるよ",
          "tc": "確認一下真偽。",
          "sc": "确认一下真伪。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 390877,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いんだけどコンノ、",
          "tc": "所以抱歉了，今野，",
          "sc": "所以抱歉了，今野，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 390884,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はウルトラレア腕時計を",
          "tc": "你今天可以先放棄這隻",
          "sc": "你今天可以先放弃这只"
        },
        {
          "f_idx": 9,
          "pidx_tc": 390891,
          "spk": "琪娜娜 (チナナ)",
          "ja": "諦めてくれるかい？",
          "tc": "超稀有手錶嗎？",
          "sc": "超稀有手表吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 390904,
          "spk": "今野 (コンノ)",
          "ja": "エッ、そんな……！",
          "tc": "咦？怎麼這樣……！",
          "sc": "咦？怎么这样……！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 390915,
          "spk": "今野 (コンノ)",
          "ja": "……ハァ……",
          "tc": "……唉……",
          "sc": "……唉……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 390922,
          "spk": "今野 (コンノ)",
          "ja": "仕方ありませんネ",
          "tc": "真是沒辦法，",
          "sc": "真是没办法，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 390929,
          "spk": "今野 (コンノ)",
          "ja": "わかりました……",
          "tc": "我知道了……",
          "sc": "我知道了……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 390940,
          "spk": "今野 (コンノ)",
          "ja": "また珍しいものが入ったら",
          "tc": "如果之後您又進貨了什麼稀奇珍寶，",
          "sc": "如果之后您又进货了什么稀奇珍宝，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 390947,
          "spk": "今野 (コンノ)",
          "ja": "是非教えてくださいネ……",
          "tc": "還請您一定要通知我……",
          "sc": "还请您一定要通知我……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 390960,
          "spk": "琪娜娜 (チナナ)",
          "ja": "了解だよ",
          "tc": "我知道了。",
          "sc": "我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7871,
      "rec_id": "TALK_ID_70_2150_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390986,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さてと……あらら",
          "tc": "好了，來看看……哎呀呀，",
          "sc": "好了，来看看……哎呀呀，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390993,
          "spk": "琪娜娜 (チナナ)",
          "ja": "がっつり割れているねえ",
          "tc": "整個裂開來了啊，",
          "sc": "整个裂开来了啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391000,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これだから安物は……",
          "tc": "便宜貨就是沒用……",
          "sc": "便宜货就是没用……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7872,
      "rec_id": "TALK_ID_70_2150_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391018,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7873,
      "rec_id": "TALK_ID_70_2150_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391036,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……もしかして今の話、",
          "tc": "……難道你信了",
          "sc": "……难道你信了"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391043,
          "spk": "琪娜娜 (チナナ)",
          "ja": "信じてるのかい？",
          "tc": "剛才的話了嗎？",
          "sc": "刚才的话了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391050,
          "spk": "琪娜娜 (チナナ)",
          "ja": "世界に十本とか、ロイヤルとか",
          "tc": "全世界只有十隻或皇室貴族什麼的。",
          "sc": "全世界只有十只或皇室贵族什么的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7874,
      "rec_id": "TALK_ID_70_2150_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391068,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いやあ、そんなに必死に",
          "tc": "唉呀，你不必這麼拚命道歉啦，",
          "sc": "唉呀，你不必这么拚命道歉啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391075,
          "spk": "琪娜娜 (チナナ)",
          "ja": "謝らなくても、これはパチモン――",
          "tc": "這只是仿冒品──",
          "sc": "这只是仿冒品——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7875,
      "rec_id": "TALK_ID_70_2150_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391099,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……いや、なんでもないよ",
          "tc": "……不，沒什麼。",
          "sc": "……不，没什么。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391110,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだね、これは",
          "tc": "對喔，",
          "sc": "对哦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "とにかく珍しくて高い腕時計だ",
          "tc": "這是超級稀有的昂貴手錶。",
          "sc": "这是超级稀有的昂贵手表。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391128,
          "spk": "琪娜娜 (チナナ)",
          "ja": "傷物にされたら",
          "tc": "如果有什麼損傷，",
          "sc": "如果有什么损伤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391135,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大損害だよ",
          "tc": "可就賠大了，",
          "sc": "可就赔大了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391142,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それはわかっているかい？",
          "tc": "你懂嗎？",
          "sc": "你懂吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7876,
      "rec_id": "TALK_ID_70_2150_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391160,
          "spk": "琪娜娜 (チナナ)",
          "ja": "わかっているなら、まあいいさ",
          "tc": "懂了就好，",
          "sc": "懂了就好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391167,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっちゃったことは",
          "tc": "但過去的事已經過去了，",
          "sc": "但过去的事已经过去了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391174,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうにもならないからね",
          "tc": "無法重來。",
          "sc": "无法重来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391185,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいかい、<player>",
          "tc": "聽好了，<player>，",
          "sc": "听好了，<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391192,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日のことは貸しだよ",
          "tc": "今天你欠我一次，",
          "sc": "今天你欠我一次，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391199,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人になったら返してもらう",
          "tc": "所以等你長大之後要還我喔。",
          "sc": "所以等你长大之后要还我哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7877,
      "rec_id": "TALK_ID_70_2150_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391217,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よし、じゃあ",
          "tc": "很好，",
          "sc": "很好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう気にしなくていいよ",
          "tc": "那你可以不用在意這件事了，",
          "sc": "那你可以不用在意这件事了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは心が広いんだ",
          "tc": "我的心胸可是很寬大的。",
          "sc": "我的心胸可是很宽大的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391242,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これに懲りずに",
          "tc": "你不用覺得不好意思，",
          "sc": "你不用觉得不好意思，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391249,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また遊びにおいで",
          "tc": "下次要再來玩喔。",
          "sc": "下次要再来玩哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7878,
      "rec_id": "TALK_ID_70_2150_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391273,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……くっくっく",
          "tc": "……呵呵呵，",
          "sc": "……呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391280,
          "spk": "琪娜娜 (チナナ)",
          "ja": "将来のカモを",
          "tc": "我找到一隻",
          "sc": "我找到一只"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391287,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見つけたねえ",
          "tc": "未來的肥羊了。",
          "sc": "未来的肥羊了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7879,
      "rec_id": "TALK_ID_70_2150_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391311,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391318,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>じゃないか",
          "tc": "這不是<player>嗎？",
          "sc": "这不是<player>吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391325,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんばんは",
          "tc": "你好啊。",
          "sc": "你好啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391336,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間に",
          "tc": "居然會跟你在這種時間、",
          "sc": "居然会跟你在这种时间、"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391343,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなところで会うなんて",
          "tc": "這種地方相遇，",
          "sc": "这种地方相遇，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391350,
          "spk": "琪娜娜 (チナナ)",
          "ja": "運命じゃないかい？",
          "tc": "難道這是命運的安排嗎？",
          "sc": "难道这是命运的安排吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391361,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはなんで",
          "tc": "你為什麼",
          "sc": "你为什么"
        },
        {
          "f_idx": 7,
          "pidx_tc": 391368,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間に……",
          "tc": "會在這個時間……",
          "sc": "会在这个时间……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 391379,
          "spk": "琪娜娜 (チナナ)",
          "ja": "って、それは",
          "tc": "對喔，",
          "sc": "对哦，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 391386,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも同じか",
          "tc": "這麼說來我也一樣啊。",
          "sc": "这么说来我也一样啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 391397,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチはね",
          "tc": "……我在村外",
          "sc": "……我在村外"
        },
        {
          "f_idx": 11,
          "pidx_tc": 391404,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の外では基本",
          "tc": "基本上都是",
          "sc": "基本上都是"
        },
        {
          "f_idx": 12,
          "pidx_tc": 391411,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人旅だったんだよ",
          "tc": "獨自旅行的。",
          "sc": "独自旅行的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 391420,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、常に警戒心を持って",
          "tc": "所以不管進行任何行動，",
          "sc": "所以不管进行任何行动，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 391427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "行動していたんだけどね",
          "tc": "我都會隨時保持戒心。",
          "sc": "我都会随时保持戒心。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 391438,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村にいるようになってからは、",
          "tc": "但是自從開始留在村裡之後，",
          "sc": "但是自从开始留在村里之后，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 391445,
          "spk": "琪娜娜 (チナナ)",
          "ja": "警戒心を抱く必要がなくなった",
          "tc": "我就不再需要保持什麼戒心了。",
          "sc": "我就不再需要保持什么戒心了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 391456,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなものとは無縁の",
          "tc": "我現在每天都過著",
          "sc": "我现在每天都过着"
        },
        {
          "f_idx": 18,
          "pidx_tc": 391463,
          "spk": "琪娜娜 (チナナ)",
          "ja": "毎日だから、緊張感というものを",
          "tc": "輕鬆悠閒的生活，",
          "sc": "轻松悠闲的生活，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 391470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "忘れてしまいそうでねえ",
          "tc": "都快要忘記什麼叫做緊張了。",
          "sc": "都快要忘记什么叫做紧张了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7880,
      "rec_id": "TALK_ID_70_2150_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391486,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……まあ、忘れたからって",
          "tc": "……不過忘記了",
          "sc": "……不过忘记了"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391493,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困るものでもないんだろうけど",
          "tc": "好像也不會有什麼不便就是了。",
          "sc": "好像也不会有什么不便就是了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391504,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ただ……なんとなくだけどね",
          "tc": "只是……我有時候會覺得，",
          "sc": "只是……我有时候会觉得，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自分が自分じゃなくなるような",
          "tc": "自己似乎變得不像是我自己似的，",
          "sc": "自己似乎变得不像是我自己似的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391518,
          "spk": "琪娜娜 (チナナ)",
          "ja": "変な気持ちになるんだよ",
          "tc": "心情很複雜。",
          "sc": "心情很复杂。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391529,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、そういう時はこうやって",
          "tc": "所以這種時候我就會像現在這樣，",
          "sc": "所以这种时候我就会像现在这样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391536,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人の時間を持つようにしているんだ",
          "tc": "為自己保留獨處的時間。",
          "sc": "为自己保留独处的时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7881,
      "rec_id": "TALK_ID_70_2150_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391561,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391568,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、邪魔をしたかって？",
          "tc": "哈哈哈，你怕打擾到我嗎？",
          "sc": "哈哈哈，你怕打扰到我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391575,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなことはないよ",
          "tc": "不至於啦。",
          "sc": "不至于啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391586,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと深刻ぶって",
          "tc": "我剛剛是刻意",
          "sc": "我刚刚是刻意"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391593,
          "spk": "琪娜娜 (チナナ)",
          "ja": "話したけどね",
          "tc": "講得好像很嚴重一樣。",
          "sc": "讲得好像很严重一样。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391600,
          "spk": "琪娜娜 (チナナ)",
          "ja": "要は、あれだよ",
          "tc": "總而言之呢……",
          "sc": "总而言之呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391611,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人はたまに、",
          "tc": "就是大人",
          "sc": "就是大人"
        },
        {
          "f_idx": 7,
          "pidx_tc": 391618,
          "spk": "琪娜娜 (チナナ)",
          "ja": "センチメンタルに",
          "tc": "偶爾都會比較",
          "sc": "偶尔都会比较"
        },
        {
          "f_idx": 8,
          "pidx_tc": 391625,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なるって話なんだよ",
          "tc": "感性一點啦。",
          "sc": "感性一点啦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 391636,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにねえ、見なよ",
          "tc": "而且你看，",
          "sc": "而且你看，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 391643,
          "spk": "琪娜娜 (チナナ)",
          "ja": "綺麗な空だろう？",
          "tc": "天空是不是很美？",
          "sc": "天空是不是很美？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7882,
      "rec_id": "TALK_ID_70_2150_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391667,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなに綺麗な星空は",
          "tc": "這麼漂亮的星空，",
          "sc": "这么漂亮的星空，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391674,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人で見るより誰かと見たほうが",
          "tc": "與其自己一個人獨享，",
          "sc": "与其自己一个人独享，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391681,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいに決まっているよ",
          "tc": "還不如找人一起欣賞呢。",
          "sc": "还不如找人一起欣赏呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391692,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミといる",
          "tc": "……與你相處的時間",
          "sc": "……与你相处的时间"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391699,
          "spk": "琪娜娜 (チナナ)",
          "ja": "時間は、悪くないよ",
          "tc": "還不賴喔。",
          "sc": "还不赖哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391710,
          "spk": "琪娜娜 (チナナ)",
          "ja": "できれば、これからも",
          "tc": "如果可以，",
          "sc": "如果可以，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391717,
          "spk": "琪娜娜 (チナナ)",
          "ja": "末長いお付き合いを",
          "tc": "我還想請你",
          "sc": "我还想请你"
        },
        {
          "f_idx": 7,
          "pidx_tc": 391724,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お願いしたいところだねえ",
          "tc": "以後也繼續跟我做朋友呢。",
          "sc": "以后也继续跟我做朋友呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7883,
      "rec_id": "TALK_ID_70_2150_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391742,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、ありがとさん",
          "tc": "哈哈哈，謝啦。",
          "sc": "哈哈哈，谢啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391753,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これからは、もっとちょくちょく",
          "tc": "以後你記得",
          "sc": "以后你记得"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391760,
          "spk": "琪娜娜 (チナナ)",
          "ja": "店に顔を出しにおいで",
          "tc": "要更常來店裡露面喔。",
          "sc": "要更常来店里露面哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391771,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気が向いたら",
          "tc": "我心情好的話",
          "sc": "我心情好的话"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391778,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かサービスするからさ",
          "tc": "就會送你一些優惠的。",
          "sc": "就会送你一些优惠的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7884,
      "rec_id": "TALK_ID_70_2150_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391796,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……じゃあ",
          "tc": "……那麼就先晚安囉，",
          "sc": "……那么就先说晚安啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391803,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやすみ、またね",
          "tc": "下次再見。",
          "sc": "下次再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7885,
      "rec_id": "TALK_ID_70_2150_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391827,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>，",
          "sc": "欢迎光临，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391834,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391845,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日食べてもらうのは",
          "tc": "今天要請你吃的是",
          "sc": "今天要请你吃的是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391852,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「おにぎりと漬物定食」だよ",
          "tc": "「飯糰與醃漬物定食」。",
          "sc": "“饭团与腌渍物定食”。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391863,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もちろん、漬物は",
          "tc": "醃漬物當然是用",
          "sc": "腌渍物当然是用"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391870,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミが前に探してくれた",
          "tc": "你之前幫我找的",
          "sc": "你之前帮我找的"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391877,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物石を使って漬けたからね",
          "tc": "醃菜石醃出來的。",
          "sc": "腌菜石腌出来的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 391886,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おにぎりは",
          "tc": "然後烤飯糰上面抹的",
          "sc": "然后烤饭团上面抹的"
        },
        {
          "f_idx": 8,
          "pidx_tc": 391893,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自家製の味噌を",
          "tc": "是我自製的味噌，",
          "sc": "是我自制的味噌，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 391900,
          "spk": "琪娜娜 (チナナ)",
          "ja": "塗って焼いた自信作さ",
          "tc": "是我的得意之作喔。",
          "sc": "是我的得意之作哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 391911,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、食べようか",
          "tc": "來，我們開動吧。",
          "sc": "来，我们开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7886,
      "rec_id": "TALK_ID_70_2150_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 391935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい食べっぷりだねえ",
          "tc": "你吃得很豪邁呢，",
          "sc": "你吃得很豪迈呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 391942,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見ていて気持ちがいいよ",
          "tc": "令人看了真開心。",
          "sc": "令人看了真开心。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 391953,
          "spk": "琪娜娜 (チナナ)",
          "ja": "シンプルな食事でも",
          "tc": "簡單的餐點",
          "sc": "简单的餐点"
        },
        {
          "f_idx": 3,
          "pidx_tc": 391960,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こだわって作ると",
          "tc": "也只要用心製作，",
          "sc": "也只要用心制作，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 391967,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やたらとおいしくなるんだよ",
          "tc": "就能變得特別好吃。",
          "sc": "就能变得特别好吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 391978,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチのトラックはいっつも",
          "tc": "雖然我的卡車上",
          "sc": "虽然我的卡车上"
        },
        {
          "f_idx": 6,
          "pidx_tc": 391985,
          "spk": "琪娜娜 (チナナ)",
          "ja": "商品をたくさん乗せるけどね",
          "tc": "總是載著一大堆商品，",
          "sc": "总是载着一大堆商品，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392003,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物樽と味噌壺の",
          "tc": "但無論如何",
          "sc": "但无论如何"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392010,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スペースだけは何がなんでも",
          "tc": "我一定都會留空間給",
          "sc": "我一定都会留空间给"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392017,
          "spk": "琪娜娜 (チナナ)",
          "ja": "死守しているんだよ",
          "tc": "醃菜桶與味噌甕喔。",
          "sc": "腌菜桶与味噌瓮哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7887,
      "rec_id": "TALK_ID_70_2150_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392035,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……料理が好きというよりは",
          "tc": "嗯……與其說我喜歡下廚，",
          "sc": "嗯……与其说我喜欢下厨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392042,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かを仕込むのが好きっていうほうが",
          "tc": "不如說",
          "sc": "不如说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392049,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチにはしっくり来るかもしれないね",
          "tc": "我比較喜歡備料吧。",
          "sc": "我比较喜欢备料吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392060,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、漬物が残っているよ",
          "tc": "來，醃漬物還有很多。",
          "sc": "来，腌渍物还有很多。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392067,
          "spk": "琪娜娜 (チナナ)",
          "ja": "きっちり食べておくれ",
          "tc": "多吃點吧。",
          "sc": "多吃点吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392078,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちなみにキミは、",
          "tc": "順便問一下……",
          "sc": "顺便问一下……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392085,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きなものから食べちゃう派かい？",
          "tc": "你是先從喜歡的東西開始吃嗎？",
          "sc": "你是先从喜欢的东西开始吃吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392101,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392108,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7888,
      "rec_id": "TALK_ID_70_2150_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392183,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは絶対に",
          "tc": "我一定是",
          "sc": "我一定是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392190,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きなものから食べるよ",
          "tc": "先從喜歡的開始吃。",
          "sc": "先从喜欢的开始吃。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392201,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だって、もしも今この瞬間に",
          "tc": "因為要是此時此刻",
          "sc": "因为要是此时此刻"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392208,
          "spk": "琪娜娜 (チナナ)",
          "ja": "隕石が落っこちてきて",
          "tc": "有隕石掉了下來，",
          "sc": "有陨石掉了下来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392215,
          "spk": "琪娜娜 (チナナ)",
          "ja": "死んじゃったとするだろ？",
          "tc": "我就此喪命了，",
          "sc": "我就此丧命了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392226,
          "spk": "琪娜娜 (チナナ)",
          "ja": "その時に好きなものを残していたら",
          "tc": "但我卻留下了喜歡的東西還沒吃，",
          "sc": "但我却留下了喜欢的东西还没吃，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392233,
          "spk": "琪娜娜 (チナナ)",
          "ja": "後悔するに決まっているからね",
          "tc": "那我一定會後悔莫及的啊。",
          "sc": "那我一定会后悔莫及的啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392251,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、漬物のキュウリとナスは",
          "tc": "不過醃小黃瓜和茄子",
          "sc": "不过腌黄瓜和茄子"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392258,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どっちも好きなものだから",
          "tc": "都是我愛吃的，",
          "sc": "都是我爱吃的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今の質問には関係ないけどさ",
          "tc": "所以這跟剛剛的問題沒有任何關係就是了。",
          "sc": "所以这跟刚刚的问题没有任何关系就是了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 392276,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また新しい漬物を仕込んでおくから",
          "tc": "我之後會再準備新的醃漬物的，",
          "sc": "我之后会再准备新的腌渍物的，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 392283,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい具合になったら声をかけるよ",
          "tc": "等醃得差不多了我會再告訴你，",
          "sc": "等腌得差不多了我会再告诉你，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 392290,
          "spk": "琪娜娜 (チナナ)",
          "ja": "都合が合ったら食べにおいで",
          "tc": "所以你有空就再過來吃吧。",
          "sc": "所以你有空就再过来吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7889,
      "rec_id": "TALK_ID_70_2150_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392314,
          "spk": "琪娜娜 (チナナ)",
          "ja": "来たね、<player>",
          "tc": "你來啦，<player>，",
          "sc": "你来啦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392321,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392328,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日キミに出すのは",
          "tc": "今天我要招待你吃的是……",
          "sc": "今天我要招待你吃的是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392339,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「オリジナルラーメン」だよ",
          "tc": "我的「自創拉麵」喔。",
          "sc": "我的“自创拉面”哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392346,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの大好物さ",
          "tc": "這是我的最愛。",
          "sc": "这是我的最爱。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、座って座って",
          "tc": "來，快坐快坐，",
          "sc": "来，快坐快坐，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392364,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっそく食べようじゃないか",
          "tc": "我們趕快來開動吧。",
          "sc": "我们赶快来开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7890,
      "rec_id": "TALK_ID_70_2150_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392388,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はあ……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392395,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おいしいねえ……",
          "tc": "真好吃……",
          "sc": "真好吃……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392404,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外で食べる料理の中では",
          "tc": "在村子外面吃的料理之中，",
          "sc": "在村子外面吃的料理之中，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392411,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっぱりラーメンが",
          "tc": "果然還是拉麵",
          "sc": "果然还是拉面"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392418,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ダントツで好きなんだよねえ……",
          "tc": "最得我心呢……",
          "sc": "最得我心呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392429,
          "spk": "琪娜娜 (チナナ)",
          "ja": "袋麺を茹でて、その時ある材料を",
          "tc": "雖然不過就是煮個麵條，",
          "sc": "虽然不过就是煮个面条，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392436,
          "spk": "琪娜娜 (チナナ)",
          "ja": "炒めて、適当に乗っけただけなのに",
          "tc": "然後看手邊有什麼材料就炒一炒放上去，",
          "sc": "然后看手边有什么材料就炒一炒放上去，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392452,
          "spk": "琪娜娜 (チナナ)",
          "ja": "青空を見ながら食べると",
          "tc": "但是邊看著藍天邊吃，",
          "sc": "但是边看着蓝天边吃，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392459,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ものすごくおいしく感じるんだよ",
          "tc": "卻會覺得格外美味。",
          "sc": "却会觉得格外美味。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうそう",
          "tc": "……啊，對了對了，",
          "sc": "……啊，对了对了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 392477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思いだした",
          "tc": "我想起來了。",
          "sc": "我想起来了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 392488,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は<player>を招いたからね",
          "tc": "今天都邀<player>來了，",
          "sc": "今天都邀<player>来了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 392495,
          "spk": "琪娜娜 (チナナ)",
          "ja": "贅沢に卵を乗せようと思っていたんだ",
          "tc": "我想說要奢侈一點，來加顆蛋。",
          "sc": "我想说要奢侈一点，来加颗蛋。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 392513,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕込んである味付き玉子か、",
          "tc": "我這邊有醬油溏心蛋，",
          "sc": "我这边有酱油溏心蛋，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 392520,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっき焼いたばかりの目玉焼きか、",
          "tc": "還有剛剛煎好的荷包蛋，",
          "sc": "还有刚刚煎好的荷包蛋，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 392527,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どっちがいいかな？",
          "tc": "你想要哪一個？",
          "sc": "你想要哪一个？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 392536,
          "spk": "主角心声/旁白/选项",
          "ja": "味付き玉子",
          "tc": "醬油溏心蛋",
          "sc": "酱油溏心蛋"
        },
        {
          "f_idx": 19,
          "pidx_tc": 392543,
          "spk": "主角心声/旁白/选项",
          "ja": "目玉焼き",
          "tc": "荷包蛋",
          "sc": "荷包蛋"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7891,
      "rec_id": "TALK_ID_70_2150_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392661,
          "spk": "琪娜娜 (チナナ)",
          "ja": "最初から卵があってもいいけど",
          "tc": "其實也可以一開始就把蛋加進去，",
          "sc": "其实也可以一开始就把蛋加进去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392668,
          "spk": "琪娜娜 (チナナ)",
          "ja": "途中からだとちょっとした味変に",
          "tc": "不過吃到一半再加可以享受到味道的變化，",
          "sc": "不过吃到一半再加可以享受到味道的变化，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392675,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なって、これはこれでいいよね",
          "tc": "這樣也很不錯。",
          "sc": "这样也很不错。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392686,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……どう？",
          "tc": "……怎麼樣？",
          "sc": "……怎么样？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392693,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹いっぱいに",
          "tc": "你有沒有",
          "sc": "你有没有"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392700,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なりそうかい？",
          "tc": "吃飽啊？",
          "sc": "吃饱啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392711,
          "spk": "琪娜娜 (チナナ)",
          "ja": "替え玉が欲しかったら",
          "tc": "如果還想要加麵的話，",
          "sc": "如果还想要加面的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392718,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遠慮なく言ってくれて",
          "tc": "不用客氣，",
          "sc": "不用客气，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392725,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいからね",
          "tc": "儘管開口喔。",
          "sc": "尽管开口哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7892,
      "rec_id": "TALK_ID_70_2150_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392749,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
