  "record_count": 53,
  "line_count": 196,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7488,
      "rec_id": "TALK_ID_70_2100_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420710,
          "spk": "名护 (ナゴ)",
          "ja": "それから、まだ簡素な部屋だから",
          "tc": "還有就是房間目前還空蕩蕩的，",
          "sc": "还有就是房间目前还空荡荡的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420717,
          "spk": "名护 (ナゴ)",
          "ja": "一人だと時々寂しいんだ",
          "tc": "我自己一個人有時會很寂寞。",
          "sc": "我自己一个人有时会很寂寞。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 420728,
          "spk": "名护 (ナゴ)",
          "ja": "こうして、たまに",
          "tc": "如果你能像這樣偶爾過來玩，",
          "sc": "如果你能像这样偶尔过来玩，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 420735,
          "spk": "名护 (ナゴ)",
          "ja": "遊びに来てくれると嬉しい",
          "tc": "我會很高興的。",
          "sc": "我会很高兴的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 420746,
          "spk": "名护 (ナゴ)",
          "ja": "……でも今日は、遊ぶ前に手伝ってくれ",
          "tc": "……不過今天在開始玩之前要請你幫忙。",
          "sc": "……不过今天在开始玩之前要请你帮忙。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 420753,
          "spk": "名护 (ナゴ)",
          "ja": "置く家具を選ぶためにも、メジャーの端を持って、",
          "tc": "為了挑選要擺放的家具，可以麻煩你",
          "sc": "为了挑选要摆放的家具，可以麻烦你"
        },
        {
          "f_idx": 6,
          "pidx_tc": 420760,
          "spk": "名护 (ナゴ)",
          "ja": "あっちに立ってもらっていいかな？",
          "tc": "拿著捲尺的一端站到那邊去嗎？",
          "sc": "拿着卷尺的一端站到那边去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7489,
      "rec_id": "TALK_ID_70_2100_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420784,
          "spk": "名护 (ナゴ)",
          "ja": "ふう……これで部屋の大きさが",
          "tc": "嗯……這樣就可以得知",
          "sc": "嗯……这样就可以得知"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420791,
          "spk": "名护 (ナゴ)",
          "ja": "正確にわかったぞ……",
          "tc": "房間的正確大小了……",
          "sc": "房间的正确大小了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 420802,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってもらって悪かったね",
          "tc": "抱歉要你幫忙。",
          "sc": "抱歉要你帮忙。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 420809,
          "spk": "名护 (ナゴ)",
          "ja": "キミも疲れただろう？",
          "tc": "你也累了吧？",
          "sc": "你也累了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 420816,
          "spk": "名护 (ナゴ)",
          "ja": "そろそろ寝ようか",
          "tc": "差不多該睡了。",
          "sc": "差不多该睡了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 420825,
          "spk": "名护 (ナゴ)",
          "ja": "布団は買ったばかりだからふかふかだよ",
          "tc": "這床被子是新買的，還很蓬鬆柔軟喔。",
          "sc": "这床被子是新买的，还很蓬松柔软哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 420832,
          "spk": "名护 (ナゴ)",
          "ja": "新品の香りも満喫できるだろう",
          "tc": "可以充分享受新被子的香氣。",
          "sc": "可以充分享受新被子的香气。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7490,
      "rec_id": "TALK_ID_70_2100_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420857,
          "spk": "名护 (ナゴ)",
          "ja": "ただね……",
          "tc": "只不過……",
          "sc": "只不过……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420864,
          "spk": "名护 (ナゴ)",
          "ja": "寝ていると毎日、変な現象が起きるんだ……",
          "tc": "每天睡覺的時候，總會發生奇怪的現象……",
          "sc": "每天睡觉的时候，总会发生奇怪的现象……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 420871,
          "spk": "名护 (ナゴ)",
          "ja": "寝苦しいというか、胸が重いというか……",
          "tc": "像是睡得不舒服，或胸口很沉重之類的……",
          "sc": "像是睡得不舒服，或胸口很沉重之类的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7491,
      "rec_id": "TALK_ID_70_2100_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420889,
          "spk": "名护 (ナゴ)",
          "ja": "すまない、後出し情報で……",
          "tc": "抱歉，現在才跟你說……",
          "sc": "抱歉，现在才跟你说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420896,
          "spk": "名护 (ナゴ)",
          "ja": "キミに影響がないといいんだが……",
          "tc": "希望對你不會有影響……",
          "sc": "希望对你不会有影响……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 420907,
          "spk": "名护 (ナゴ)",
          "ja": "直前に気味悪いことを言ってすまない",
          "tc": "抱歉睡前跟你說這些可怕的事。",
          "sc": "抱歉睡前跟你说这些可怕的事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 420914,
          "spk": "名护 (ナゴ)",
          "ja": "さあ、本当に怖いことが起きる前に、",
          "tc": "好了，在真的發生可怕的事情之前，",
          "sc": "好了，在真的发生可怕的事情之前，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 420921,
          "spk": "名护 (ナゴ)",
          "ja": "早く寝てしまおう",
          "tc": "趕緊睡覺吧。",
          "sc": "赶紧睡觉吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7492,
      "rec_id": "TALK_ID_70_2100_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420941,
          "spk": "名护 (ナゴ)",
          "ja": "俺の人生も……",
          "tc": "我的人生……",
          "sc": "我的人生……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420948,
          "spk": "名护 (ナゴ)",
          "ja": "そう捨てたものじゃないよな",
          "tc": "似乎也不算太糟呢。",
          "sc": "似乎也不算太糟呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7493,
      "rec_id": "TALK_ID_70_2100_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420964,
          "spk": "名护 (ナゴ)",
          "ja": "悪い、<player>さん",
          "tc": "抱歉，<player>，",
          "sc": "抱歉，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 420971,
          "spk": "名护 (ナゴ)",
          "ja": "起こしちゃったか？",
          "tc": "我吵醒你了嗎？",
          "sc": "我吵醒你了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 420980,
          "spk": "名护 (ナゴ)",
          "ja": "キミが来てくれたのが嬉しくて",
          "tc": "可能是我太開心你來找我玩，",
          "sc": "可能是我太开心你来找我玩，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 420987,
          "spk": "名护 (ナゴ)",
          "ja": "目が冴えちゃったみたいなんだ",
          "tc": "總覺得頭腦很清醒。",
          "sc": "总觉得头脑很清醒。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 420996,
          "spk": "名护 (ナゴ)",
          "ja": "何というかキミは……",
          "tc": "總覺得你……",
          "sc": "总觉得你……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421003,
          "spk": "名护 (ナゴ)",
          "ja": "本当に不思議な子だよな",
          "tc": "真的是個很不可思議的人呢。",
          "sc": "真的是个很不可思议的人呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7494,
      "rec_id": "TALK_ID_70_2100_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421019,
          "spk": "名护 (ナゴ)",
          "ja": "キミや村の人々と会えたことで",
          "tc": "因為遇見了你和村裡的人，",
          "sc": "因为遇见了你和村里的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421026,
          "spk": "名护 (ナゴ)",
          "ja": "自分の考え方が変化していくのがわかった",
          "tc": "我發現自己的想法逐漸有了轉變。",
          "sc": "我发现自己的想法逐渐有了转变。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421035,
          "spk": "名护 (ナゴ)",
          "ja": "けどそれは嫌な感じではなく、",
          "tc": "不過那樣並不讓人討厭，",
          "sc": "不过那样并不让人讨厌，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421042,
          "spk": "名护 (ナゴ)",
          "ja": "むしろ心地よかったんだ",
          "tc": "反而帶給我舒心的感覺。",
          "sc": "反而带给我舒心的感觉。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421051,
          "spk": "名护 (ナゴ)",
          "ja": "やっと、自分の居場所を",
          "tc": "我覺得，",
          "sc": "我觉得，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421058,
          "spk": "名护 (ナゴ)",
          "ja": "見つけた気がして……",
          "tc": "自己總算找到了歸宿……",
          "sc": "自己总算找到了归宿……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421067,
          "spk": "名护 (ナゴ)",
          "ja": "それと、キミに会えたおかげで",
          "tc": "而且多虧認識了你，",
          "sc": "而且多亏认识了你，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 421074,
          "spk": "名护 (ナゴ)",
          "ja": "「本当に大切なもの」に",
          "tc": "才讓我察覺到──",
          "sc": "才让我察觉到——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 421081,
          "spk": "名护 (ナゴ)",
          "ja": "再会することができたしな",
          "tc": "「真正重要的東西」。",
          "sc": "“真正重要的东西”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7495,
      "rec_id": "TALK_ID_70_2100_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421097,
          "spk": "名护 (ナゴ)",
          "ja": "……できれば、このまま",
          "tc": "……可以的話，",
          "sc": "……可以的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421104,
          "spk": "名护 (ナゴ)",
          "ja": "ずっと一緒にいられたらと",
          "tc": "我希望能永遠和你在一起，",
          "sc": "我希望能永远和你在一起，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421111,
          "spk": "名护 (ナゴ)",
          "ja": "思ってるけど――",
          "tc": "雖然我是這麼想的──",
          "sc": "虽然我是这么想的——"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421120,
          "spk": "名护 (ナゴ)",
          "ja": "キミもいつか、",
          "tc": "會不會你也有一天，",
          "sc": "会不会你也有一天，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421127,
          "spk": "名护 (ナゴ)",
          "ja": "ここを離れる日が来るのかい？",
          "tc": "要離開這裡呢？",
          "sc": "要离开这里呢？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 421136,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        },
        {
          "f_idx": 6,
          "pidx_tc": 421143,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7496,
      "rec_id": "TALK_ID_70_2100_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421237,
          "spk": "名护 (ナゴ)",
          "ja": "この村であろうと、村の外であろうと",
          "tc": "不論是在這座村子，還是在村外，",
          "sc": "不论是在这座村子，还是在村外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421244,
          "spk": "名护 (ナゴ)",
          "ja": "いつか、<player>さんも",
          "tc": "希望有一天<player>",
          "sc": "希望有一天<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421251,
          "spk": "名护 (ナゴ)",
          "ja": "居場所が見つかるといいな",
          "tc": "也能找到自己的歸宿。",
          "sc": "也能找到自己的归宿。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421260,
          "spk": "名护 (ナゴ)",
          "ja": "……おやすみ、<player>さん",
          "tc": "……晚安，<player>。",
          "sc": "……晚安，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7497,
      "rec_id": "TALK_ID_70_2100_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421280,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……昨晩も寝苦しかったな……",
          "tc": "嗯～……昨晚也睡得很不安穩呢……",
          "sc": "嗯～……昨晚也睡得很不安稳呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421287,
          "spk": "名护 (ナゴ)",
          "ja": "なにかが胸の上に乗ってるような……",
          "tc": "總覺得有什麼壓在胸口上……",
          "sc": "总觉得有什么压在胸口上……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421294,
          "spk": "名护 (ナゴ)",
          "ja": "キミは大丈夫だったかい？",
          "tc": "你沒事吧？",
          "sc": "你没事吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7498,
      "rec_id": "TALK_ID_70_2100_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421312,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……それはよかった",
          "tc": "是嗎……那就好。",
          "sc": "是吗……那就好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7499,
      "rec_id": "TALK_ID_70_2100_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421336,
          "spk": "名护 (ナゴ)",
          "ja": "昨夜のことだけど、",
          "tc": "關於昨天晚上的事，",
          "sc": "关于昨天晚上的事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421343,
          "spk": "名护 (ナゴ)",
          "ja": "思い返してみると",
          "tc": "仔細回想起來……",
          "sc": "仔细回想起来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 421350,
          "spk": "名护 (ナゴ)",
          "ja": "結構なこと言ってたよな……",
          "tc": "我好像講了很不得了的話……",
          "sc": "我好像讲了很不得了的话……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421361,
          "spk": "名护 (ナゴ)",
          "ja": "恥ずかしいから",
          "tc": "因為實在太難為情了，",
          "sc": "因为实在太难为情了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421368,
          "spk": "名护 (ナゴ)",
          "ja": "寝ぼけてたことにしてくれ",
          "tc": "就當作是我睡昏頭了吧。",
          "sc": "就当作是我睡昏头了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7500,
      "rec_id": "TALK_ID_70_2100_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 421386,
          "spk": "名护 (ナゴ)",
          "ja": "まだ家具もそろってない簡素な部屋だけど",
          "tc": "雖然家具還沒擺齊，所以房間還很樸素，",
          "sc": "虽然家具还没摆齐，所以房间还很朴素，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 421393,
          "spk": "名护 (ナゴ)",
          "ja": "満足したなら、また遊びに来てくれ",
          "tc": "你要是滿意的話，下次再來玩吧。",
          "sc": "你要是满意的话，下次再来玩吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 421411,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんなら、",
          "tc": "如果是<player>的話，",
          "sc": "如果是<player>的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 421418,
          "spk": "名护 (ナゴ)",
          "ja": "いつでも歓迎するよ",
          "tc": "我隨時都很歡迎的。",
          "sc": "我随时都很欢迎的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7501,
      "rec_id": "TALK_ID_70_2110_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 381206,
          "spk": "洋 (ヨウ)",
          "ja": "ねえ、<player>",
          "tc": "問你喔，<player>。",
          "sc": "问你哦，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 381213,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のお家にいる",
          "tc": "<player>家裡的狗狗，",
          "sc": "<player>家里的狗狗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 381220,
          "spk": "洋 (ヨウ)",
          "ja": "ワンちゃん、元気かな？",
