      "file": "talk.dat",
      "rec_idx": 1995,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146269,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんはこんな時間でも元気だな",
          "tc": "<player>你在這種時間也很有精神啊。",
          "sc": "<player>你在这种时间也很有精神啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 146276,
          "spk": "名护 (ナゴ)",
          "ja": "もう夜も遅いから、気をつけて帰るんだよ",
          "tc": "夜深了，回家路上要小心喔。",
          "sc": "夜深了，回家路上要小心哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1996,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_2800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146307,
          "spk": "名护 (ナゴ)",
          "ja": "夏場の天気は、",
          "tc": "夏天有時天氣變化很快，",
          "sc": "夏天有时天气变化很快，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 146314,
          "spk": "名护 (ナゴ)",
          "ja": "急変して強く降ることもある……",
          "tc": "會突然下起暴雨……",
          "sc": "会突然下起暴雨……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 146325,
          "spk": "名护 (ナゴ)",
          "ja": "今日の遠出は控えた方がいいんじゃないかな？",
          "tc": "今天是不是別跑太遠比較好？",
          "sc": "今天是不是别跑太远比较好？"
        }
      ]
    },
    {
