        {
          "f_idx": 2,
          "pidx_tc": 145932,
          "spk": "名护 (ナゴ)",
          "ja": "いやいや、一度読んだら止まらなくなりそうだ",
          "tc": "不行不行，我一旦看起書應該就停不下來了。",
          "sc": "不行不行，我一旦看起书应该就停不下来了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1988,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145963,
          "spk": "名护 (ナゴ)",
          "ja": "子どもの頃はコーヒーなんて苦手だったのに",
          "tc": "我小時候明明覺得咖啡很難喝，",
