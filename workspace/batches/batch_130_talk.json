          "sc": "如果价钱没有很贵，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 146026,
          "spk": "名护 (ナゴ)",
          "ja": "買ってあげるよ",
          "tc": "我可以買給你喔。",
          "sc": "我可以买给你哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1990,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146050,
          "spk": "名护 (ナゴ)",
          "ja": "蚊取り線香は置いてないかな？",
          "tc": "有沒有蚊香啊？",
          "sc": "有没有蚊香啊？"
