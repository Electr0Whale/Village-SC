      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146356,
          "spk": "名护 (ナゴ)",
          "ja": "朝なのに、もうこの暑さか……",
          "tc": "明明還是早上就已經熱成這樣……",
          "sc": "明明还是早上就已经热成这样……"
        },
