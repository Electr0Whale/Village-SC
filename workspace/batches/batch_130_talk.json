        {
          "f_idx": 1,
          "pidx_tc": 145970,
          "spk": "名护 (ナゴ)",
          "ja": "いつから好んで飲むようになったんだろう？",
          "tc": "到底是什麼時候開始愛喝的呢？",
          "sc": "到底是什么时候开始爱喝的呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1989,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146001,
          "spk": "名护 (ナゴ)",
          "ja": "……ん？",
          "tc": "……嗯？",
