          "sc": "最基本的用品在这里都买得到，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 146120,
          "spk": "名护 (ナゴ)",
          "ja": "いつも感心してるよ",
          "tc": "每次上門我都覺得很佩服。",
          "sc": "每次上门我都觉得很佩服。"
        }
      ]
    },
    {
      "file": "talk.dat",
