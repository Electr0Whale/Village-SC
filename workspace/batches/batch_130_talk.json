        {
          "f_idx": 4,
          "pidx_tc": 146082,
          "spk": "名护 (ナゴ)",
          "ja": "いつの間にか入ってくるんだよ……",
          "tc": "蚊子似乎在不知不覺間就跑進來了……",
          "sc": "蚊子似乎在不知不觉间就跑进来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1991,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146106,
          "spk": "名护 (ナゴ)",
          "ja": "田上雑貨店は村の生命線だな",
          "tc": "田上雜貨店是村子的生命線，",
