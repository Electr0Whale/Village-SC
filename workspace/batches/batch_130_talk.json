      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146144,
          "spk": "名护 (ナゴ)",
          "ja": "この店は良心的な値段で助かるんだが、",
