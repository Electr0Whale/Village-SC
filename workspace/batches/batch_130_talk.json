      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1993,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146182,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……肝試しは遠慮しておこう……",
          "tc": "呃～試膽大會……我就不參加了……",
          "sc": "呃～试胆大会……我就不参加了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 146200,
          "spk": "名护 (ナゴ)",
          "ja": "村の怪奇現象だけで、",
          "tc": "光是村子裡的異常現象，",
          "sc": "光是村子里的异常现象，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 146207,
          "spk": "名护 (ナゴ)",
          "ja": "もうお腹いっぱいだからね……",
          "tc": "就已經讓我受夠了……",
          "sc": "就已经让我受够了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1994,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 146231,
          "spk": "名护 (ナゴ)",
          "ja": "駄目だ……",
          "tc": "不行……",
          "sc": "不行……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 146238,
          "spk": "名护 (ナゴ)",
          "ja": "こんなところで寝たら悪夢にうなされる……",
          "tc": "在這種地方睡覺的話，會做惡夢的……",
