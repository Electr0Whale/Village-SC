  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1963,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144715,
          "spk": "名护 (ナゴ)",
          "ja": "うう……ずっと目を細めてたせいで、",
          "tc": "唔……一直瞇著眼睛看東西的關係，",
          "sc": "唔……一直眯着眼睛看东西的关系，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144722,
          "spk": "名护 (ナゴ)",
          "ja": "やけに目が疲れるな",
          "tc": "眼睛非常容易疲勞。",
          "sc": "眼睛非常容易疲劳。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144733,
          "spk": "名护 (ナゴ)",
          "ja": "このまま続けてたら",
          "tc": "這樣持續下去，",
          "sc": "这样持续下去，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 144740,
          "spk": "名护 (ナゴ)",
          "ja": "目の周りの筋肉が鍛えられて、",
          "tc": "可以鍛鍊眼睛周圍的肌肉，",
          "sc": "可以锻炼眼睛周围的肌肉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 144747,
          "spk": "名护 (ナゴ)",
          "ja": "視力も良くなったり……",
          "tc": "視力也會變好……",
          "sc": "视力也会变好……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 144758,
          "spk": "名护 (ナゴ)",
          "ja": "……まあ、そんな都合いい話あるわけないか",
          "tc": "……應該是不會發生這種好事吧。",
          "sc": "……应该是不会发生这种好事吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1964,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144789,
          "spk": "名护 (ナゴ)",
          "ja": "よく晴れた夏空だ……",
          "tc": "真是晴朗的夏日天空……",
          "sc": "真是晴朗的夏日天空……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144800,
          "spk": "名护 (ナゴ)",
          "ja": "けど、入道雲が出てきたら注意するんだ",
          "tc": "不過，要是出現積雲就要留意了。",
          "sc": "不过，要是出现积云就要留意了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144807,
          "spk": "名护 (ナゴ)",
          "ja": "積乱雲に発達して、雷雨をもたらすからね",
          "tc": "因為會發展為積雨雲，帶來雷雨。",
          "sc": "因为会发展为积雨云，带来雷雨。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1965,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144838,
          "spk": "名护 (ナゴ)",
          "ja": "せっかくの掲示板なんだ",
          "tc": "難得有個公告欄。",
          "sc": "难得有个公告栏。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144849,
          "spk": "名护 (ナゴ)",
          "ja": "俺が図書館の案内を書くだけじゃなくて",
          "tc": "除了我寫的圖書館介紹，",
          "sc": "除了我写的图书馆介绍，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144856,
          "spk": "名护 (ナゴ)",
          "ja": "みんなの感想も載せられないかな……",
          "tc": "是不是也能把大家的心得貼上來呢……",
          "sc": "是不是也能把大家的心得贴上来呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1966,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144880,
          "spk": "名护 (ナゴ)",
          "ja": "紙を貼り替えるだけでも",
          "tc": "光是重新張貼",
          "sc": "光是重新张贴"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144887,
          "spk": "名护 (ナゴ)",
          "ja": "汗が噴き出てくるな……",
          "tc": "就弄得滿頭大汗……",
          "sc": "就弄得满头大汗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144898,
          "spk": "名护 (ナゴ)",
          "ja": "キミも体を動かすなら、",
          "tc": "你活動身體的時候，",
          "sc": "你活动身体的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 144905,
          "spk": "名护 (ナゴ)",
          "ja": "熱中症には気をつけるんだよ",
          "tc": "也要小心別中暑囉。",
          "sc": "也要小心别中暑哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1967,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144929,
          "spk": "名护 (ナゴ)",
          "ja": "おお、美味いなコレ……",
          "tc": "哦哦，這個真好吃……",
          "sc": "哦哦，这个真好吃……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144940,
          "spk": "名护 (ナゴ)",
          "ja": "このスタミナ料理なら",
          "tc": "有了這份增強體力的料理，",
          "sc": "有了这份增强体力的料理，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144947,
          "spk": "名护 (ナゴ)",
          "ja": "夏バテにも負けないな",
          "tc": "就不怕熱昏頭了。",
          "sc": "就不怕热昏头了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1968,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 144971,
          "spk": "名护 (ナゴ)",
          "ja": "夜になっても",
          "tc": "就算到了晚上，",
          "sc": "就算到了晚上，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 144978,
          "spk": "名护 (ナゴ)",
          "ja": "気温はあまり下がらずか……",
          "tc": "氣溫也沒下降多少啊……",
          "sc": "气温也没下降多少啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 144989,
          "spk": "名护 (ナゴ)",
          "ja": "そのせいか、あまり頭が回らないな……",
          "tc": "可能是因為這樣，腦袋也動不太起來……",
          "sc": "可能是因为这样，脑袋也动不太起来……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1969,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145013,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145020,
          "spk": "名护 (ナゴ)",
          "ja": "メガネがないとやっぱり読みづらいな",
          "tc": "沒有眼鏡果然難以閱讀書上的字，",
          "sc": "没有眼镜果然难以阅读书上的字，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145027,
          "spk": "名护 (ナゴ)",
          "ja": "目を細めるのも限界があるし……",
          "tc": "但瞇著眼睛閱讀也有極限……",
          "sc": "但眯着眼睛阅读也有极限……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145038,
          "spk": "名护 (ナゴ)",
          "ja": "サザンカさんに取り寄せるよう頼んだんだが、",
          "tc": "雖然已經拜託茶梅小姐代為購買眼鏡，",
          "sc": "虽然已经拜托茶梅小姐代为购买眼镜，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145045,
          "spk": "名护 (ナゴ)",
          "ja": "なぜか全然来ないんだ……",
          "tc": "卻不知為何遲遲沒有送來……",
          "sc": "却不知为何迟迟没有送来……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 145052,
          "spk": "名护 (ナゴ)",
          "ja": "なにか理由でもあるのか……？",
          "tc": "難道是有什麼理由嗎……？",
          "sc": "难道是有什么理由吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1970,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145076,
          "spk": "名护 (ナゴ)",
          "ja": "思えば、子どもの頃は",
          "tc": "回想起來，",
          "sc": "回想起来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145083,
          "spk": "名护 (ナゴ)",
          "ja": "本ばかり読んでいた気がするよ……",
          "tc": "我從小就老是在看書……",
          "sc": "我从小就老是在看书……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145094,
          "spk": "名护 (ナゴ)",
          "ja": "まさか大人になって",
          "tc": "沒想到長大成人後",
          "sc": "没想到长大成人后"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145101,
          "spk": "名护 (ナゴ)",
          "ja": "本にまつわる仕事をすることになるとはね……",
          "tc": "會開始做起跟書本有關的工作……",
          "sc": "会开始做起跟书本有关的工作……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1971,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145125,
          "spk": "名护 (ナゴ)",
          "ja": "この前キスケさんに呼ばれて行ったら、",
          "tc": "木助先生找我過去，",
          "sc": "木助先生找我过去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145132,
          "spk": "名护 (ナゴ)",
          "ja": "麻雀の数合わせにされてね……",
          "tc": "居然是去計算麻將的點數……",
          "sc": "居然是去计算麻将的点数……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145139,
          "spk": "名护 (ナゴ)",
          "ja": "気づいたら夜まで付き合わされてたよ",
          "tc": "回過神來居然就陪他們到了晚上，",
          "sc": "回过神来居然就陪他们到了晚上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145150,
          "spk": "名护 (ナゴ)",
          "ja": "あれはさすがにきつかった……",
          "tc": "真是有夠痛苦的……",
          "sc": "真是有够痛苦的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145157,
          "spk": "名护 (ナゴ)",
          "ja": "サザンカさんもシロージくんも、",
          "tc": "真虧茶梅小姐和四郎治",
          "sc": "真亏茶梅小姐和四郎治"
        },
        {
          "f_idx": 5,
          "pidx_tc": 145164,
          "spk": "名护 (ナゴ)",
          "ja": "よくあんなのに毎回付き合ってられるな",
          "tc": "有辦法每次都陪他。",
          "sc": "有办法每次都陪他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1972,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145188,
          "spk": "名护 (ナゴ)",
          "ja": "よく来てくれたね、<player>さん",
          "tc": "你來得正好，<player>。",
          "sc": "你来得正好，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145195,
          "spk": "名护 (ナゴ)",
          "ja": "探しやすいように棚を整理したから、",
          "tc": "我把書架整理好了，方便找書，",
          "sc": "我把书架整理好了，方便找书，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145202,
          "spk": "名护 (ナゴ)",
          "ja": "よかったら読んでいってくれ",
          "tc": "有興趣的話請看看書。",
          "sc": "有兴趣的话请看看书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1973,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145226,
          "spk": "名护 (ナゴ)",
          "ja": "この図書館、ちょっと本の偏りがあるから、",
          "tc": "這座圖書館的書籍比較偏，",
          "sc": "这座图书馆的书籍比较偏，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145233,
          "spk": "名护 (ナゴ)",
          "ja": "ヨウちゃんが読めるものが少ないな……",
          "tc": "小洋能讀的書不多……",
          "sc": "小洋能读的书不多……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145251,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさんに頼んで仕入れてもらおうか",
          "tc": "也許該請琪娜娜小姐幫忙買一些書。",
          "sc": "也许该请琪娜娜小姐帮忙买一些书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1974,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145282,
          "spk": "名护 (ナゴ)",
          "ja": "怪談は江戸時代に庶民の娯楽として",
          "tc": "據說怪談在江戶時代，",
          "sc": "据说怪谈在江户时代，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145289,
          "spk": "名护 (ナゴ)",
          "ja": "流行したと言われていて、",
          "tc": "是相當流行的庶民娛樂，",
          "sc": "是相当流行的庶民娱乐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145296,
          "spk": "名护 (ナゴ)",
          "ja": "当時の風習を知るのにいい資料なんだ",
          "tc": "很適合作為認識當時風俗民情的資料。",
          "sc": "很适合作为认识当时风俗民情的资料。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145307,
          "spk": "名护 (ナゴ)",
          "ja": "この村の伝承にも怪談が",
          "tc": "這個村子的傳說中有很多怪談，",
          "sc": "这个村子的传说中有很多怪谈，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145314,
          "spk": "名护 (ナゴ)",
          "ja": "多くて興味深いよ",
          "tc": "很有意思。",
          "sc": "很有意思。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1975,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145345,
          "spk": "名护 (ナゴ)",
          "ja": "暑さに参っているのは",
          "tc": "看來被酷熱折磨的",
          "sc": "看来被酷热折磨的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145352,
          "spk": "名护 (ナゴ)",
          "ja": "人間だけじゃないみたいだね",
          "tc": "不只有人類而已。",
          "sc": "不只有人类而已。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145359,
          "spk": "名护 (ナゴ)",
          "ja": "さっきまで小鳥たちも、木の枝で休んでたよ",
          "tc": "剛才小鳥們也在樹枝上休息喔。",
          "sc": "刚才小鸟们也在树枝上休息哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1976,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145383,
          "spk": "名护 (ナゴ)",
          "ja": "いくら楽しくても、休息は大事だ",
          "tc": "不管玩得再開心，休息還是很重要。",
          "sc": "不管玩得再开心，休息还是很重要。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145390,
          "spk": "名护 (ナゴ)",
          "ja": "暑さで倒れてしまったら働けないからね",
          "tc": "畢竟要是熱昏頭，就沒辦法工作了。",
          "sc": "毕竟要是热昏头，就没办法工作了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145408,
          "spk": "名护 (ナゴ)",
          "ja": "ジュースをおごるから、",
          "tc": "我請你喝果汁，",
          "sc": "我请你喝果汁，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145415,
          "spk": "名护 (ナゴ)",
          "ja": "少し休んでいくかい？",
          "tc": "要不要休息一下？",
          "sc": "要不要休息一下？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1977,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145439,
          "spk": "名护 (ナゴ)",
          "ja": "こんなにたくさんの量の本を読むのは、",
          "tc": "上次像現在這樣大量閱讀書籍，",
          "sc": "上次像现在这样大量阅读书籍，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145446,
          "spk": "名护 (ナゴ)",
          "ja": "大学の頃以来だな……",
          "tc": "已經是大學時代了……",
          "sc": "已经是大学时代了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1978,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145470,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくんに誘われて川に入ったんだが、",
          "tc": "堇怜找我一起進河裡泡水，",
          "sc": "堇怜找我一起进河里泡水，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145477,
          "spk": "名护 (ナゴ)",
          "ja": "水が冷たすぎて一気に暑さが引いたよ……",
          "tc": "河水太冷，身體的熱氣一口氣消退了……",
          "sc": "河水太冷，身体的热气一口气消退了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145484,
          "spk": "名护 (ナゴ)",
          "ja": "山の水って、本当に冷たいんだな",
          "tc": "山裡的水真的很冰涼，",
          "sc": "山里的水真的很冰凉，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145495,
          "spk": "名护 (ナゴ)",
          "ja": "キミも入るなら気をつけたほうがいい",
          "tc": "如果你也要進河裡，最好還是小心一點。",
          "sc": "如果你也要进河里，最好还是小心一点。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145502,
          "spk": "名护 (ナゴ)",
          "ja": "急に入ると体がびっくりするからね",
          "tc": "突然泡進河裡，身體會受到衝擊的。",
          "sc": "突然泡进河里，身体会受到冲击的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1979,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145533,
          "spk": "名护 (ナゴ)",
          "ja": "雨はしばらく、やみそうもない",
          "tc": "看來雨暫時不會停，",
          "sc": "看来雨暂时不会停，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145540,
          "spk": "名护 (ナゴ)",
          "ja": "今日は調べ物に専念するか",
          "tc": "今天就專心查資料吧。",
          "sc": "今天就专心查资料吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1980,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2123",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145571,
          "spk": "名护 (ナゴ)",
          "ja": "公衆電話が村の外と通じる",
          "tc": "公共電話是與村外聯絡",
          "sc": "公共电话是与村外联络"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145578,
          "spk": "名护 (ナゴ)",
          "ja": "唯一の連絡手段か……",
          "tc": "唯一的方式嗎……",
          "sc": "唯一的方式吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145589,
          "spk": "名护 (ナゴ)",
          "ja": "ここにいると、いろんな考えが巡るよ",
          "tc": "待在這裡，心裡就會冒出各種想法。",
          "sc": "待在这里，心里就会冒出各种想法。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1981,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2124",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145620,
          "spk": "名护 (ナゴ)",
          "ja": "どうでもいいような悩みだって",
          "tc": "就算只是微不足道的煩惱，",
          "sc": "就算只是微不足道的烦恼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145627,
          "spk": "名护 (ナゴ)",
          "ja": "人に話したらスッキリするものだよ",
          "tc": "跟別人說了之後，也會輕鬆不少喔。",
          "sc": "跟别人说了之后，也会轻松不少哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145638,
          "spk": "名护 (ナゴ)",
          "ja": "何かあったら、聞かせてくれ",
          "tc": "你要是碰到什麼問題，就跟我說吧。",
          "sc": "你要是碰到什么问题，就跟我说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1982,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2125",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145669,
          "spk": "名护 (ナゴ)",
          "ja": "ヒグラシが鳴いている……",
          "tc": "有暮蟬在叫……",
          "sc": "有暮蝉在叫……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145680,
          "spk": "名护 (ナゴ)",
          "ja": "夏の夕暮れと言えば、これだよな",
          "tc": "說起夏天的黃昏，就屬這個呢。",
          "sc": "说起夏天的黄昏，就属这个呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1983,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145711,
          "spk": "名护 (ナゴ)",
          "ja": "そうめんなら、俺でも作れそうだが……",
          "tc": "如果是素麵，我應該也做得出來……",
          "sc": "如果是素面，我应该也做得出来……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145729,
          "spk": "名护 (ナゴ)",
          "ja": "いや……",
          "tc": "不……",
          "sc": "不……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145736,
          "spk": "名护 (ナゴ)",
          "ja": "でも、この暑さでの料理も重労働か……",
          "tc": "不過在這種大熱天做菜，也算高強度勞動吧……",
          "sc": "不过在这种大热天做菜，也算高强度劳动吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1984,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145760,
          "spk": "名护 (ナゴ)",
          "ja": "気が付けば、軽い物ばかり",
          "tc": "回過神來才發現，",
          "sc": "回过神来才发现，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145767,
          "spk": "名护 (ナゴ)",
          "ja": "食べてる気がするな……",
          "tc": "我好像都只吃些簡單的東西……",
          "sc": "我好像都只吃些简单的东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145778,
          "spk": "名护 (ナゴ)",
          "ja": "これが夏バテってことなのかもしれないね",
          "tc": "這或許就是熱昏頭的症狀吧。",
          "sc": "这或许就是热昏头的症状吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1985,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145802,
          "spk": "名护 (ナゴ)",
          "ja": "この暑さを乗り切るには、",
          "tc": "要撐過這種酷熱的天氣，",
          "sc": "要撑过这种酷热的天气，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145809,
          "spk": "名护 (ナゴ)",
          "ja": "軽くでもいいから、",
          "tc": "吃些簡單的東西也可以，",
          "sc": "吃些简单的东西也可以，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145816,
          "spk": "名护 (ナゴ)",
          "ja": "ちゃんと食べておくのが重要だね",
          "tc": "最重要的是要確實吃東西。",
          "sc": "最重要的是要确实吃东西。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145827,
          "spk": "名护 (ナゴ)",
          "ja": "時間あるときにでも、",
          "tc": "在有空閒的時候，",
          "sc": "在有空闲的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 145834,
          "spk": "名护 (ナゴ)",
          "ja": "おにぎりでも作り置きしておくか",
          "tc": "先做一些飯糰起來好了。",
          "sc": "先做一些饭团起来好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1986,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145858,
          "spk": "名护 (ナゴ)",
          "ja": "子どもの頃にはすっきり目が覚めたのに、",
          "tc": "孩提時代一起床就精神奕奕，",
          "sc": "孩提时代一起床就精神奕奕，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 145865,
          "spk": "名护 (ナゴ)",
          "ja": "今じゃコーヒーを飲まないと、",
          "tc": "如今要是不喝咖啡，",
          "sc": "如今要是不喝咖啡，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 145872,
          "spk": "名护 (ナゴ)",
          "ja": "頭が働かなくなってしまったよ",
          "tc": "腦袋就沒辦法運作了。",
          "sc": "脑袋就没办法运作了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 145883,
          "spk": "名护 (ナゴ)",
          "ja": "大人になるとこれだからダメだね……",
          "tc": "長大以後反而這樣真是不行啊……",
          "sc": "长大以后反而这样真是不行啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1987,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 145914,
          "spk": "名护 (ナゴ)",
          "ja": "まだ時間あるし、本を読んでから出ても……",
          "tc": "時間還沒到，先看點書再出門也……",
