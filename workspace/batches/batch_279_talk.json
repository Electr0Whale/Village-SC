      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 196807,
          "spk": "驹子 (コマコ)",
          "ja": "……うう",
          "tc": "……唔唔。",
          "sc": "……唔唔。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 196814,
          "spk": "驹子 (コマコ)",
          "ja": "また怒らせちゃったな……",
          "tc": "又惹她生氣了……",
          "sc": "又惹她生气了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7968,
      "rec_id": "TALK_ID_10_0101_008_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 196838,
          "spk": "驹子 (コマコ)",
          "ja": "まだ会えていない人は、",
          "tc": "目前沒碰到面的，",
          "sc": "目前没碰到面的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 196845,
          "spk": "驹子 (コマコ)",
          "ja": "あと<gamevalue GAME_VALUE_STORY_01_NPC_TALK_COUNT>人かな？",
          "tc": "應該還有<gamevalue GAME_VALUE_STORY_01_NPC_TALK_COUNT>人吧？",
          "sc": "应该还有<gamevalue GAME_VALUE_STORY_01_NPC_TALK_COUNT>人吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 196856,
          "spk": "驹子 (コマコ)",
          "ja": "さっき渡した村の地図に",
          "tc": "我把大家這個時間點會在的地方，",
          "sc": "我把大家这个时间点会在的地方，"
        },
        {
