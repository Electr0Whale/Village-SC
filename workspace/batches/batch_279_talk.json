      "rec_id": "TALK_ID_10_0101_008_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 196023,
          "spk": "？？？ (未知角色)",
          "ja": "あ、コマコ",
          "tc": "啊，是駒子。",
          "sc": "啊，是驹子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 196030,
          "spk": "？？？ (未知角色)",
          "ja": "こんな時間に珍しい",
          "tc": "這時間看到妳還真稀奇。",
          "sc": "这时间看到你还真稀奇。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 196037,
          "spk": "？？？ (未知角色)",
          "ja": "なにしてるんだ？",
          "tc": "妳在做什麼啊？",
          "sc": "你在做什么啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 196050,
          "spk": "驹子 (コマコ)",
          "ja": "スミレくん、ヨウちゃん、こんにちは",
          "tc": "堇怜，小洋，你們好啊。",
          "sc": "堇怜，小洋，你们好啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 196057,
          "spk": "驹子 (コマコ)",
          "ja": "この子……<player>は山で迷ってて……",
          "tc": "這孩子……<player>他在山裡迷路了……",
          "sc": "这孩子……<player>他在山里迷路了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 196064,
          "spk": "驹子 (コマコ)",
          "ja": "村まで連れてきたんだ",
          "tc": "所以我就把他帶來了村裡。",
          "sc": "所以我就把他带来了村里。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 196077,
          "spk": "堇怜 (スミレ)",
          "ja": "ふーん、なるほど、だから",
          "tc": "哦，原來如此。",
          "sc": "哦，原来如此。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 196084,
          "spk": "堇怜 (スミレ)",
          "ja": "仕事切り上げて戻ってきたんだ",
          "tc": "所以妳才提早結束工作先回來了啊。",
          "sc": "所以你才提早结束工作先回来了啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 196097,
          "spk": "驹子 (コマコ)",
          "ja": "二人はヤギさんのお世話かな？",
          "tc": "你們是在照顧山羊嗎？",
          "sc": "你们是在照顾山羊吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 196110,
          "spk": "洋 (ヨウ)",
          "ja": "うん、お耳のリボン、",
          "tc": "嗯，牠耳朵上的蝴蝶結",
          "sc": "嗯，它耳朵上的蝴蝶结"
        },
        {
          "f_idx": 10,
          "pidx_tc": 196117,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがつけてあげたんだよ",
          "tc": "就是我幫牠綁上去的。",
          "sc": "就是我帮它绑上去的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 196130,
          "spk": "堇怜 (スミレ)",
          "ja": "やめとけって言ったんだけどさ",
          "tc": "我說過別那麼做了，",
          "sc": "我说过别那么做了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 196137,
          "spk": "堇怜 (スミレ)",
          "ja": "ヨウが、言うこと聞かなくて……",
          "tc": "但洋她就是不聽……",
          "sc": "但洋她就是不听……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 196150,
          "spk": "堇怜 (スミレ)",
          "ja": "それよりコマコは",
          "tc": "是說駒子，",
          "sc": "是说驹子，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 196157,
          "spk": "堇怜 (スミレ)",
          "ja": "そいつと話していいの？",
          "tc": "妳跟那邊那個講話沒問題嗎？",
          "sc": "你跟那边那个讲话没问题吗？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 196173,
          "spk": "堇怜 (スミレ)",
          "ja": "リンに怒られなかったか？",
          "tc": "沒被林罵嗎？",
          "sc": "没被林骂吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 196186,
          "spk": "驹子 (コマコ)",
          "ja": "え……うん",
          "tc": "呃……嗯。",
          "sc": "呃……嗯。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 196193,
          "spk": "驹子 (コマコ)",
          "ja": "緊急事態だし、子どもだから……",
          "tc": "畢竟事態緊急，而且他只是個孩子……",
          "sc": "毕竟事态紧急，而且他只是个孩子……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 196206,
          "spk": "堇怜 (スミレ)",
          "ja": "ふーん、なるほど",
          "tc": "哦，這樣啊。",
          "sc": "哦，这样啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7958,
      "rec_id": "TALK_ID_10_0101_008_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 196236,
          "spk": "驹子 (コマコ)",
          "ja": "もう、お祭りの片付けは",
          "tc": "祭典的善後工作",
          "sc": "祭典的善后工作"
        },
        {
          "f_idx": 1,
          "pidx_tc": 196243,
          "spk": "驹子 (コマコ)",
          "ja": "ほとんど終わってるんだね",
          "tc": "已經幾乎差不多結束了吧。",
          "sc": "已经几乎差不多结束了吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 196256,
          "spk": "堇怜 (スミレ)",
          "ja": "さっきまで、みんなと一緒に片付けてたんだ",
          "tc": "和大家一起整理到剛才。",
          "sc": "和大家一起整理到刚才。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 196263,
          "spk": "堇怜 (スミレ)",
          "ja": "リンは、どっか行っちゃうし……",
          "tc": "也不知道林跑到哪裡去了……",
          "sc": "也不知道林跑到哪里去了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 196270,
          "spk": "堇怜 (スミレ)",
          "ja": "毎年毎年、ホントめんどくさいよ……",
          "tc": "每一年都這樣，真麻煩……",
          "sc": "每一年都这样，真麻烦……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 196283,
          "spk": "驹子 (コマコ)",
          "ja": "あ、あはは……",
          "tc": "啊、啊哈哈……",
          "sc": "啊、啊哈哈……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 196290,
          "spk": "驹子 (コマコ)",
          "ja": "リンも忙しいんだと思うよ……",
          "tc": "我想林她一定也很忙的……",
          "sc": "我想林她一定也很忙的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 196303,
          "spk": "堇怜 (スミレ)",
          "ja": "今日だけじゃなくて、昨日から僕が",
          "tc": "不只今天，從昨天起",
          "sc": "不只今天，从昨天起"
        },
        {
          "f_idx": 8,
          "pidx_tc": 196310,
          "spk": "堇怜 (スミレ)",
          "ja": "そのヤギにエサをやってるんだぜ？",
          "tc": "就是我在負責餵那隻山羊耶！",
          "sc": "就是我在负责喂那只山羊呢！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 196317,
          "spk": "堇怜 (スミレ)",
          "ja": "リンがやればいいのに……",
          "tc": "明明讓林去做就好了……",
          "sc": "明明让林去做就好了……"
        }
      ]
    },
