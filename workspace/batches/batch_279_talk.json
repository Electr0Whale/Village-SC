      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393102,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、よろしい",
          "tc": "哈哈哈，很好。",
          "sc": "哈哈哈，很好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393109,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあ、おやすみ～",
          "tc": "那就晚安了～",
          "sc": "那就晚安了～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7877,
      "rec_id": "TALK_ID_70_2150_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393135,
          "spk": "木助 (キスケ)",
          "ja": "……あんま言いたくねぇけどよ",
          "tc": "……我不是很想說這種事，",
          "sc": "……我不是很想说这种事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393142,
          "spk": "木助 (キスケ)",
          "ja": "もっと人を頼ってもいいんじゃねえか？",
          "tc": "多依靠他人一點也可以吧？",
          "sc": "多依靠他人一点也可以吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393155,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあねえ",
          "tc": "或許吧。",
          "sc": "或许吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393168,
          "spk": "木助 (キスケ)",
          "ja": "古傷、たまに痛むんだろ？",
          "tc": "舊傷還會痛吧？",
          "sc": "旧伤还会痛吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393188,
          "spk": "琪娜娜 (チナナ)",
          "ja": "多少はね",
          "tc": "多少會，",
          "sc": "多少会，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393195,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けどまあ、普段は",
          "tc": "不過平常",
          "sc": "不过平常"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393202,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうでもないさ",
          "tc": "也都還好。",
          "sc": "也都还好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 393215,
          "spk": "木助 (キスケ)",
          "ja": "真剣に考えたらどうだ？",
          "tc": "妳要不要認真考慮一下？",
          "sc": "你要不要认真考虑一下？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 393222,
          "spk": "木助 (キスケ)",
          "ja": "それが結局はハスミの心配性につながって、",
          "tc": "那最後還不是會讓蓮實窮擔心，",
          "sc": "那最后还不是会让莲实穷担心，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 393229,
          "spk": "木助 (キスケ)",
          "ja": "あいつの酒の量も……",
          "tc": "她喝酒的量也是……",
          "sc": "她喝酒的量也是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7878,
      "rec_id": "TALK_ID_70_2150_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393255,
          "spk": "木助 (キスケ)",
          "ja": "……てめぇなぁ",
          "tc": "……我說你啊，",
          "sc": "……我说你啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393262,
          "spk": "木助 (キスケ)",
          "ja": "黙って立ってないで",
          "tc": "不要默默站在那裡，",
          "sc": "不要默默站在那里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393269,
          "spk": "木助 (キスケ)",
          "ja": "声ぐらいかけろっての",
          "tc": "好歹也出個聲吧？",
          "sc": "好歹也出个声吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7879,
      "rec_id": "TALK_ID_70_2150_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393295,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな、チナナ",
          "tc": "那我先走啦，琪娜娜。",
          "sc": "那我先走啦，琪娜娜。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393308,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はいはい、またね～",
          "tc": "好好好，再見～",
          "sc": "好好好，再见～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7880,
      "rec_id": "TALK_ID_70_2150_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393334,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>，",
          "sc": "欢迎光临，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393341,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、休憩中だったんだよ",
          "tc": "我剛剛在休息。",
          "sc": "我刚刚在休息。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393348,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か欲しいものでも？",
          "tc": "你有什麼想要的東西嗎？",
          "sc": "你有什么想要的东西吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7881,
      "rec_id": "TALK_ID_70_2150_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393366,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだ、通りすがりかい？",
          "tc": "什麼？你只是剛好經過？",
          "sc": "什么？你只是刚好经过？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393373,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあもうちょっと",
          "tc": "那我就",
          "sc": "那我就"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393380,
          "spk": "琪娜娜 (チナナ)",
          "ja": "休憩させてもらおうかね",
          "tc": "再多休息一下囉。",
          "sc": "再多歇会儿吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393391,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393398,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393405,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと聞いててよ",
          "tc": "你聽我說。",
          "sc": "你听我说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7882,
      "rec_id": "TALK_ID_70_2150_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393423,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ンモォ～～～～～～ッ！",
          "tc": "哞～～～～～～！",
          "sc": "哞～～～～～～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7883,
      "rec_id": "TALK_ID_70_2150_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393441,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっはっは",
          "tc": "啊哈哈，",
          "sc": "啊哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393448,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい反応だねえ",
          "tc": "你的反應真不錯。",
          "sc": "你的反应真不错。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393457,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昔、キスケにこれを聞かされて",
          "tc": "以前木助學給我聽的時候，",
          "sc": "以前木助学给我听的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393464,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そっくりすぎるって感動してね",
          "tc": "因為實在是太像了，我整個很感動，",
          "sc": "因为实在是太像了，我整个很感动，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393471,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも特訓してできるようになったんだよ",
          "tc": "於是我也特訓了一番，然後就學起來了。",
          "sc": "于是我也特训了一番，然后就学起来了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393482,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の人には何度も聞かせているから",
          "tc": "村民都已經聽過無數次了，",
          "sc": "村民都已经听过无数次了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393489,
          "spk": "琪娜娜 (チナナ)",
          "ja": "久しぶりの新鮮な反応で嬉しいね",
          "tc": "所以我好久沒看到這麼新鮮的反應了，真開心。",
          "sc": "所以我好久没看到这么新鲜的反应了，真开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7884,
      "rec_id": "TALK_ID_70_2150_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393514,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あー……他にも聞きたいかい？",
          "tc": "啊……你還想聽聽別的嗎？",
          "sc": "啊……你还想听听别的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393521,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど、ウチはウシしか",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393528,
          "spk": "琪娜娜 (チナナ)",
          "ja": "真似できないんだよ",
          "tc": "我只會模仿牛。",
          "sc": "我只会模仿牛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7885,
      "rec_id": "TALK_ID_70_2150_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393546,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……そんな期待した目で",
          "tc": "……你用這樣期待的眼神",
          "sc": "……你用这样期待的眼神"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393553,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見られてもね",
          "tc": "看著我也沒用啊，",
          "sc": "看着我也没用啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393560,
          "spk": "琪娜娜 (チナナ)",
          "ja": "声真似はこれで終わりだよ",
          "tc": "聲音模仿秀就到這邊結束了。",
          "sc": "声音模仿秀就到这边结束了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393571,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、どっか行って遊んどいで",
          "tc": "好了，快去別的地方玩吧。",
          "sc": "好了，快去别的地方玩吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393578,
          "spk": "琪娜娜 (チナナ)",
          "ja": "他にも面白いことは",
          "tc": "還有其他一大堆好玩的事",
          "sc": "还有其他一大堆好玩的事"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393585,
          "spk": "琪娜娜 (チナナ)",
          "ja": "たくさんあるだろ",
          "tc": "在等著你吧？",
          "sc": "在等着你吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 393596,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……いいよねえ、この村は",
          "tc": "……這村子真是不錯，",
          "sc": "……这村子真是不错，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 393603,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遊ぶ場所に困らなくてさ",
          "tc": "不愁沒地方玩，",
          "sc": "不愁没地方玩，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 393610,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも子どもの頃は楽しかったよ",
          "tc": "我的童年也跟你一樣，過得很開心。",
          "sc": "我的童年也跟你一样，过得很开心。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 393621,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……そういう、なんでもない",
          "tc": "……真希望這樣平凡無奇的日子",
          "sc": "……真希望这样平凡无奇的日子"
        },
        {
          "f_idx": 10,
          "pidx_tc": 393628,
          "spk": "琪娜娜 (チナナ)",
          "ja": "時間がずっと続けばいいのにね",
          "tc": "可以一直持續下去。",
          "sc": "可以一直持续下去。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 393639,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>がこの村に",
          "tc": "就好比<player>來到了這個村裡，",
          "sc": "就好比<player>来到了这个村里，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 393646,
          "spk": "琪娜娜 (チナナ)",
          "ja": "来たみたいに、住人の多少の",
          "tc": "這裡的居民也多少會",
          "sc": "这里的居民也多少会"
        },
        {
          "f_idx": 13,
          "pidx_tc": 393653,
          "spk": "琪娜娜 (チナナ)",
          "ja": "入れ替わりはあるけどさ",
          "tc": "來來去去的。",
          "sc": "来来去去的。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 393664,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それでも、村の中は",
          "tc": "不過村子並沒有什麼",
          "sc": "不过村子并没有什么"
        },
        {
          "f_idx": 15,
          "pidx_tc": 393671,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大した変わりがないまま",
          "tc": "太大的變化，",
          "sc": "太大的变化，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 393678,
          "spk": "琪娜娜 (チナナ)",
          "ja": "毎日が過ぎて行って……",
          "tc": "日子就這樣一天天過去……",
          "sc": "日子就这样一天天过去……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 393689,
          "spk": "琪娜娜 (チナナ)",
          "ja": "平和ってのはいいもんだと、",
          "tc": "我真的是深深覺得",
          "sc": "我真的是深深觉得"
        },
        {
          "f_idx": 18,
          "pidx_tc": 393696,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはしみじみ思うんだよ",
          "tc": "所謂的和平真是不錯啊。",
          "sc": "所谓的和平真是不错啊。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 393707,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……まあ、多少変わったところの",
          "tc": "……雖然這份和平",
          "sc": "……虽然这份和平"
        },
        {
          "f_idx": 20,
          "pidx_tc": 393714,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ある平和ではあるけどね",
          "tc": "是有些奇怪的地方在啦。",
          "sc": "是有些奇怪的地方在啦。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 393725,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……って、こんな話",
          "tc": "……是說聽我講這些，",
          "sc": "……是说听我讲这些，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 393732,
          "spk": "琪娜娜 (チナナ)",
          "ja": "退屈じゃないかい？",
          "tc": "你不會覺得無聊嗎？",
          "sc": "你不会觉得无聊吗？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 393739,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミは聞き上手だねえ",
          "tc": "看來你很擅長聆聽啊。",
          "sc": "看来你很擅长聆听啊。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 393750,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……そうだ",
          "tc": "……對了，",
          "sc": "……对了，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 393757,
          "spk": "琪娜娜 (チナナ)",
          "ja": "与太話に付き合ってもらったお礼に",
          "tc": "為了謝謝你陪我閒聊，",
          "sc": "为了谢谢你陪我闲聊，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 393764,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遊び場所、増やしてやろうか",
          "tc": "我就讓你多一個地方玩耍吧。",
          "sc": "我就让你多一个地方玩耍吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7886,
      "rec_id": "TALK_ID_70_2150_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393782,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トラックの中、興味ないかい？",
          "tc": "你對卡車裡面有沒有興趣？",
          "sc": "你对卡车里面有没有兴趣？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393789,
          "spk": "琪娜娜 (チナナ)",
          "ja": "特別に乗せてやってもいいよ",
          "tc": "我可以破例讓你上車喔。",
          "sc": "我可以破例让你上车哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7887,
      "rec_id": "TALK_ID_70_2150_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393814,
          "spk": "琪娜娜 (チナナ)",
