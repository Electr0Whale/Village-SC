    },
    {
      "file": "talk.dat",
      "rec_idx": 7892,
      "rec_id": "TALK_ID_70_2150_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 394047,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 394054,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何してるんだい？",
          "tc": "你在做什麼啊？",
          "sc": "你在做什么啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 394061,
          "spk": "琪娜娜 (チナナ)",
          "ja": "散歩かな？",
          "tc": "是在散步嗎？",
          "sc": "是在散步吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 394072,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはついさっき、",
          "tc": "我剛剛在收貨，",
          "sc": "我刚刚在收货，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 394079,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外からの物資を",
          "tc": "是一些來自",
          "sc": "是一些来自"
        },
        {
          "f_idx": 5,
          "pidx_tc": 394086,
          "spk": "琪娜娜 (チナナ)",
          "ja": "受け取ったところだよ",
          "tc": "村子外面的物資。",
          "sc": "村子外面的物资。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 394097,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トラックいっぱい、",
          "tc": "這些量，",
          "sc": "这些量，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 394104,
          "spk": "琪娜娜 (チナナ)",
          "ja": "充分すぎるくらいの量でね",
          "tc": "足夠我塞滿整台車了。",
          "sc": "足够我塞满整台车了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 394115,
          "spk": "琪娜娜 (チナナ)",
          "ja": "荷台に乗らなかった分を",
          "tc": "載貨台塞不下的，",
          "sc": "载货台塞不下的，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 394122,
          "spk": "琪娜娜 (チナナ)",
          "ja": "往復して運んでるくらいさ",
          "tc": "我還要分批來回搬呢。",
          "sc": "我还要分批来回搬呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 394133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まさか、こんなにあっさりと",
          "tc": "真沒想到村裡的",
          "sc": "真没想到村里的"
        },
        {
          "f_idx": 11,
          "pidx_tc": 394140,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の商売問題が解決するとは",
          "tc": "生意問題會這麼",
          "sc": "生意问题会这么"
        },
        {
          "f_idx": 12,
          "pidx_tc": 394147,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思わなかったねえ",
          "tc": "快就解決了。",
          "sc": "快就解决了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 394158,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ただ、困ったことにさ",
          "tc": "……但其實我有點傷腦筋，",
          "sc": "……但其实我有点伤脑筋，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 394165,
          "spk": "琪娜娜 (チナナ)",
          "ja": "実を言うと、新たに",
          "tc": "因為現在又冒出了",
          "sc": "因为现在又冒出了"
        },
        {
          "f_idx": 15,
          "pidx_tc": 394172,
          "spk": "琪娜娜 (チナナ)",
          "ja": "別の問題が浮上したんだよ",
          "tc": "新的問題。",
          "sc": "新的问题。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7893,
      "rec_id": "TALK_ID_70_2150_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 394190,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それがねえ……",
