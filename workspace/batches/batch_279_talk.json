          "f_idx": 0,
          "pidx_tc": 199879,
          "spk": "木助 (キスケ)",
          "ja": "頼んだぞ",
          "tc": "就交給你了。",
          "sc": "就交给你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7987,
      "rec_id": "TALK_ID_10_0101_014_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199903,
          "spk": "木助 (キスケ)",
          "ja": "あれ……おかしいな……",
          "tc": "咦……怎麼回事……",
          "sc": "咦……怎么回事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199910,
          "spk": "木助 (キスケ)",
          "ja": "聞こえてなかったのか？",
          "tc": "你沒聽清楚嗎？",
          "sc": "你没听清楚吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199921,
          "spk": "木助 (キスケ)",
          "ja": "お願いなんだが、",
          "tc": "我想拜託你，",
          "sc": "我想拜托你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199928,
          "spk": "木助 (キスケ)",
          "ja": "あそこにある木を切り倒してくれ",
          "tc": "把那邊那棵樹給砍了。",
          "sc": "把那边那棵树给砍了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7988,
      "rec_id": "TALK_ID_10_0101_015_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199952,
          "spk": "木助 (キスケ)",
          "ja": "ほーう……従順なもんだな",
          "tc": "哦……還真聽話啊。",
          "sc": "哦……还真听话啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199959,
          "spk": "木助 (キスケ)",
          "ja": "助かったぜ",
          "tc": "真是幫了大忙。",
          "sc": "真是帮了大忙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7989,
      "rec_id": "TALK_ID_10_0101_015_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199977,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ、次の仕事も",
          "tc": "那麼，下一份工作",
          "sc": "那么，下一份工作"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199984,
          "spk": "木助 (キスケ)",
          "ja": "してもらおうじゃねぇか",
          "tc": "也交給你吧。",
          "sc": "也交给你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7990,
      "rec_id": "TALK_ID_10_0101_015_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200008,
          "spk": "木助 (キスケ)",
          "ja": "ほら、先払いの対価だ",
          "tc": "來，這是預付的報酬。",
          "sc": "来，这是预付的报酬。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200015,
          "spk": "木助 (キスケ)",
          "ja": "働かないと、対価は得られない",
          "tc": "不工作，就無法得到報酬，",
          "sc": "不工作，就无法得到报酬，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200022,
          "spk": "木助 (キスケ)",
          "ja": "対価を得たいのならば、働かないとな",
          "tc": "想獲得報酬，就要好好工作啊。",
          "sc": "想获得报酬，就要好好工作啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7991,
      "rec_id": "TALK_ID_10_0101_015_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200040,
          "spk": "木助 (キスケ)",
          "ja": "<strong>次の頼みは、",
          "tc": "<strong>下個委託是",
          "sc": "<strong>下个委托是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200047,
          "spk": "木助 (キスケ)",
          "ja": "そこにある全ての石をツルハシで割って",
          "tc": "用十字鎬把那邊全部的石頭",
          "sc": "用十字镐把那边全部的石头"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200054,
          "spk": "木助 (キスケ)",
          "ja": "片づけてほしいんだ</strong>",
          "tc": "都敲碎並清理乾淨。</strong>",
          "sc": "都敲碎并清理干净。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7992,
      "rec_id": "TALK_ID_10_0101_015_01_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200072,
          "spk": "木助 (キスケ)",
          "ja": "さあ、対価はもう得ただろ？",
          "tc": "好了，既然你已經拿到報酬了，",
          "sc": "好了，既然你已经拿到报酬了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200079,
          "spk": "木助 (キスケ)",
          "ja": "働けよ",
          "tc": "就快去工作吧。",
          "sc": "就快去工作吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7993,
      "rec_id": "TALK_ID_10_0101_015_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200103,
          "spk": "木助 (キスケ)",
          "ja": "どうした？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200110,
          "spk": "木助 (キスケ)",
          "ja": "対価は払っただろ？",
          "tc": "我已經付給你報酬了吧？",
          "sc": "我已经付给你报酬了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200121,
          "spk": "木助 (キスケ)",
          "ja": "そこにある石を、",
          "tc": "把那邊的石頭，",
          "sc": "把那边的石头，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200128,
          "spk": "木助 (キスケ)",
          "ja": "全部ツルハシで壊してくれ",
          "tc": "全都用十字鎬敲碎。",
          "sc": "全都用十字镐敲碎。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200137,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには簡単な仕事だろ？",
          "tc": "對你來說應該是個簡單的工作吧？",
          "sc": "对你来说应该是个简单的工作吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7994,
      "rec_id": "TALK_ID_10_0101_016_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200161,
          "spk": "木助 (キスケ)",
          "ja": "しっかり働くやつは",
          "tc": "我可不討厭",
          "sc": "我可不讨厌"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200168,
          "spk": "木助 (キスケ)",
          "ja": "嫌いじゃないぜ",
          "tc": "認真工作的傢伙。",
          "sc": "认真工作的家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7995,
      "rec_id": "TALK_ID_10_0101_016_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200192,
          "spk": "木助 (キスケ)",
          "ja": "<strong>次はそこの畑を耕して、",
          "tc": "<strong>接著是翻整那邊的田地，",
          "sc": "<strong>接着是翻整那边的田地，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200199,
          "spk": "木助 (キスケ)",
          "ja": "種を撒け</strong>",
          "tc": "並且撒下種子。</strong>",
          "sc": "并且撒下种子。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7996,
      "rec_id": "TALK_ID_10_0101_016_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200217,
          "spk": "木助 (キスケ)",
          "ja": "もうわかっているだろ？",
          "tc": "你都明白了吧？",
          "sc": "你都明白了吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200224,
          "spk": "木助 (キスケ)",
          "ja": "俺の言うことはきけるよな？",
          "tc": "可以照我說的去做吧？",
          "sc": "可以照我说的去做吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7997,
      "rec_id": "TALK_ID_10_0101_016_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200248,
          "spk": "木助 (キスケ)",
          "ja": "よしよし、その調子だぜ",
          "tc": "很好很好，就是這樣子。",
          "sc": "很好很好，就是这样子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200255,
          "spk": "木助 (キスケ)",
          "ja": "そうだな……",
          "tc": "我想想……",
          "sc": "我想想……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200262,
          "spk": "木助 (キスケ)",
          "ja": "あと<strong>５箇所</strong>ほど土を耕して貰おうか",
          "tc": "再多翻整<strong>五塊</strong>土吧。",
          "sc": "再多翻整<strong>五块</strong>土吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200271,
          "spk": "木助 (キスケ)",
          "ja": "その後に、",
          "tc": "在那之後，",
          "sc": "在那之后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200278,
          "spk": "木助 (キスケ)",
          "ja": "<strong>耕した土に種を撒いてくれ</strong>",
          "tc": "<strong>把種子播在翻整好的土上。</strong>",
          "sc": "<strong>把种子播在翻整好的土上。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7998,
      "rec_id": "TALK_ID_10_0101_016_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200302,
          "spk": "木助 (キスケ)",
          "ja": "まずは渡したクワで、",
          "tc": "你先用我給你的鋤頭",
          "sc": "你先用我给你的锄头"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200309,
          "spk": "木助 (キスケ)",
          "ja": "土を耕して畑にするんだ",
          "tc": "翻整土壤並開墾為田地。",
          "sc": "翻整土壤并开垦为田地。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200318,
          "spk": "木助 (キスケ)",
          "ja": "畑を作れたら",
          "tc": "田地開墾好之後，",
          "sc": "田地开垦好之后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200325,
          "spk": "木助 (キスケ)",
          "ja": "さっきあげた種を、撒いてみな",
          "tc": "再把剛剛給你的種子播下去。",
          "sc": "再把刚刚给你的种子播下去。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200336,
          "spk": "木助 (キスケ)",
          "ja": "別に難しいことは言ってねえだろ？",
          "tc": "我說的內容並不難吧？",
          "sc": "我说的内容并不难吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 200343,
          "spk": "木助 (キスケ)",
          "ja": "頼んだぜ",
          "tc": "就交給你了。",
          "sc": "就交给你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7999,
      "rec_id": "TALK_ID_10_0101_016_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200367,
          "spk": "木助 (キスケ)",
          "ja": "……なんだよ",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200374,
          "spk": "木助 (キスケ)",
          "ja": "なんか不安なのか？",
          "tc": "有什麼放心不下的事嗎？",
          "sc": "有什么放心不下的事吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200385,
          "spk": "木助 (キスケ)",
          "ja": "さっき渡した種を持って、",
          "tc": "把我剛才給你的種子",
          "sc": "把我刚才给你的种子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200392,
          "spk": "木助 (キスケ)",
          "ja": "畑の前で撒くんだ",
          "tc": "播種到田地裡吧。",
          "sc": "播种到田地里吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200403,
          "spk": "木助 (キスケ)",
          "ja": "簡単な仕事だろ？",
          "tc": "這工作很簡單吧？",
          "sc": "这工作很简单吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 200410,
          "spk": "木助 (キスケ)",
          "ja": "丁寧にやれよ",
          "tc": "好好做喔。",
          "sc": "好好做啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8000,
      "rec_id": "TALK_ID_10_0101_017_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200434,
          "spk": "木助 (キスケ)",
          "ja": "植物が育つために、",
          "tc": "你應該知道",
          "sc": "你应该知道"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200441,
          "spk": "木助 (キスケ)",
          "ja": "何が必要かわかるだろ？",
          "tc": "培育植物需要什麼吧？",
          "sc": "培育植物需要什么吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8001,
      "rec_id": "TALK_ID_10_0101_017_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200465,
          "spk": "木助 (キスケ)",
          "ja": "そのジョウロが対価だ",
          "tc": "那個澆水壺就是報酬。",
          "sc": "那个浇水壶就是报酬。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200472,
          "spk": "木助 (キスケ)",
          "ja": "<strong>次は水を汲んできて、",
          "tc": "<strong>接著是去汲水，",
          "sc": "<strong>接着是去汲水，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200479,
          "spk": "木助 (キスケ)",
          "ja": "さっき植えた種に撒くんだ</strong>",
          "tc": "並澆在剛剛種下的種子上。</strong>",
          "sc": "并浇在刚刚种下的种子上。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8002,
      "rec_id": "TALK_ID_10_0101_017_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200503,
          "spk": "木助 (キスケ)",
          "ja": "その家の裏に、水が湧いてる",
          "tc": "那房子的後面有水池，",
          "sc": "那房子的后面有水池，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200510,
          "spk": "木助 (キスケ)",
          "ja": "まずは、そこでジョウロに水を入れてこい",
          "tc": "首先，你去那邊用澆水壺汲水回來。",
          "sc": "首先，你去那边用浇水壶汲水回来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8003,
      "rec_id": "TALK_ID_10_0101_017_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200534,
          "spk": "木助 (キスケ)",
          "ja": "まずはジョウロに水を汲まねえとな",
          "tc": "首先，得用澆水壺汲水喔。",
          "sc": "首先，得用浇水壶汲水啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200543,
          "spk": "木助 (キスケ)",
          "ja": "その家の裏に、水が湧いてる池があるぜ",
          "tc": "那房子的後面有個會湧出水的水池。",
          "sc": "那房子的后面有个会涌出水的水池。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200550,
          "spk": "木助 (キスケ)",
          "ja": "そこでジョウロを使って、水を汲んでこい",
          "tc": "你要在那邊用澆水壺汲水回來，",
          "sc": "你要在那边用浇水壶汲水回来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200561,
          "spk": "木助 (キスケ)",
          "ja": "種に水を撒くのはその後だ",
          "tc": "才能把水澆稻種子上。",
          "sc": "才能把水浇稻种子上。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200568,
          "spk": "木助 (キスケ)",
          "ja": "よろしく頼んだぜ",
          "tc": "麻煩你啦。",
          "sc": "麻烦你啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8004,
      "rec_id": "TALK_ID_10_0101_017_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200592,
          "spk": "木助 (キスケ)",
          "ja": "……いちいち俺の顔色を",
          "tc": "……你可以不用",
          "sc": "……你可以不用"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200599,
          "spk": "木助 (キスケ)",
          "ja": "うかがわなくていいだろうが",
          "tc": "什麼事情都看我臉色。",
          "sc": "什么事情都看我脸色。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200610,
          "spk": "木助 (キスケ)",
          "ja": "種を撒いた畑に、",
          "tc": "田地裡已經播種了，",
          "sc": "田地里已经播种了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200617,
          "spk": "木助 (キスケ)",
          "ja": "ジョウロの水をかけるんだよ",
          "tc": "再來就是用澆水壺澆水。",
          "sc": "再来就是用浇水壶浇水。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200624,
          "spk": "木助 (キスケ)",
          "ja": "さっさとやってこい",
          "tc": "快點行動。",
          "sc": "快点行动。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8005,
      "rec_id": "TALK_ID_10_0101_018_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 201217,
          "spk": "木助 (キスケ)",
          "ja": "出荷台を作ってんだよ",
          "tc": "我正在做出貨台，",
          "sc": "我正在做出货台，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 201224,
          "spk": "木助 (キスケ)",
          "ja": "今日中には、出来上がるぜ",
          "tc": "今天之內就能做好。",
          "sc": "今天之内就能做好。"
        },
