        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7894,
      "rec_id": "TALK_ID_70_2150_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 394222,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっはっは",
          "tc": "啊哈哈，",
          "sc": "啊哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 394229,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだそんなこと、って",
          "tc": "你是不是在想",
          "sc": "你是不是在想"
        },
        {
          "f_idx": 2,
          "pidx_tc": 394236,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思うかい？",
          "tc": "「這什麼問題啊」？",
          "sc": "“这什么问题啊”？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 394247,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けどね、これがわりと",
          "tc": "可是這其實是個",
          "sc": "可是这其实是个"
        },
        {
          "f_idx": 4,
          "pidx_tc": 394254,
          "spk": "琪娜娜 (チナナ)",
          "ja": "深刻な悩みなんだよ",
          "tc": "很嚴重的問題喔。",
          "sc": "很严重的问题哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 394265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今までは、村で作ったものを",
          "tc": "我之前會把村裡製造的東西",
          "sc": "我之前会把村里制造的东西"
        },
        {
          "f_idx": 6,
          "pidx_tc": 394272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外で売りさばいたり、村に必要な",
          "tc": "拿去外面兜售，",
          "sc": "拿去外面兜售，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 394279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "商品を買い付けたりしていてね",
          "tc": "或是幫村裡採購需要的商品回來。",
          "sc": "或是帮村里采购需要的商品回来。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 394288,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これでも、村の生活のために",
          "tc": "別看我這樣，",
          "sc": "别看我这样，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 394295,
          "spk": "琪娜娜 (チナナ)",
          "ja": "かなり重要な仕事をしているって",
          "tc": "我的工作對村子裡生活是很重要的，",
