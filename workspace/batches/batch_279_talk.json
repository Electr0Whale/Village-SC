          "pidx_tc": 394302,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自負があったんだけど",
          "tc": "所以我很引以為傲。",
          "sc": "所以我很引以为傲。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 394313,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今じゃ、時間が余りに余っててね",
          "tc": "但我現在閒得發慌，",
          "sc": "但我现在闲得发慌，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 394320,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほとんどプータローみたいなもんさ",
          "tc": "簡直就跟米蟲沒兩樣。",
          "sc": "简直就跟米虫没两样。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 394338,
          "spk": "琪娜娜 (チナナ)",
          "ja": "店番してるだけってのも",
          "tc": "單純顧店",
          "sc": "单纯顾店"
        },
        {
          "f_idx": 15,
          "pidx_tc": 394345,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうにも味気ないし……",
          "tc": "也沒什麼意思……",
          "sc": "也没什么意思……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 394356,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミなら、時間が余ったら",
          "tc": "你如果閒得發慌，",
          "sc": "你如果闲得发慌，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 394363,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何をするんだろうね？",
          "tc": "都會做些什麼啊？",
          "sc": "都会做些什么啊？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 394370,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕事以外で何かあるかい？",
          "tc": "你除了工作還有其他事可以做嗎？",
          "sc": "你除了工作还有其他事可以做吗？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 394379,
          "spk": "主角心声/旁白/选项",
          "ja": "たんけん",
          "tc": "探險",
          "sc": "探险"
        },
        {
          "f_idx": 20,
          "pidx_tc": 394386,
          "spk": "主角心声/旁白/选项",
          "ja": "シュミ",
          "tc": "興趣",
          "sc": "兴趣"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7895,
      "rec_id": "TALK_ID_70_2150_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 394497,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これを機に、ウチは",
          "tc": "趁這個機會",
          "sc": "趁这个机会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 394504,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何ができるのか",
          "tc": "來想想自己能做些什麼，",
          "sc": "来想想自己能做些什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 394511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "考えてみるのもいいね",
          "tc": "好像也挺不錯的。",
          "sc": "好像也挺不错的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 394520,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これから何をすべきなのか……",
          "tc": "思考自己往後該做什麼……",
          "sc": "思考自己往后该做什么……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 394527,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いや、何がしたいのかを",
          "tc": "不，或許我該思考的是",
          "sc": "不，或许我该思考的是"
        },
        {
          "f_idx": 5,
          "pidx_tc": 394534,
          "spk": "琪娜娜 (チナナ)",
          "ja": "考えるべきなのかもしれない",
          "tc": "自己想做什麼。",
          "sc": "自己想做什么。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 394545,
          "spk": "琪娜娜 (チナナ)",
          "ja": "話し相手になってくれて",
          "tc": "謝謝你陪我聊天，",
          "sc": "谢谢你陪我聊天，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 394552,
          "spk": "琪娜娜 (チナナ)",
          "ja": "助かったよ、<player>",
          "tc": "這對我很有幫助喔，<player>。",
          "sc": "这对我很有帮助哦，<player>。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 394559,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おかげで考えがまとまってきた",
          "tc": "多虧你，我現在比較有頭緒了。",
          "sc": "多亏你，我现在比较有头绪了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 394570,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、もちろん",
          "tc": "不過我當然不是",
          "sc": "不过我当然不是"
        },
        {
          "f_idx": 10,
          "pidx_tc": 394577,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やることが何もないって",
          "tc": "完全沒有",
          "sc": "完全没有"
        },
        {
          "f_idx": 11,
          "pidx_tc": 394584,
          "spk": "琪娜娜 (チナナ)",
