      "rec_id": "TALK_ID_10_0503_328_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 330550,
          "spk": "莲实 (ハスミ)",
          "ja": "怪我は、倒れた時に",
          "tc": "她只有在倒下時",
          "sc": "她只有在倒下时"
        },
        {
          "f_idx": 1,
          "pidx_tc": 330557,
          "spk": "莲实 (ハスミ)",
          "ja": "擦り傷ができたくらいです",
          "tc": "受到了一點擦傷而已。",
          "sc": "受到了一点擦伤而已。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 330568,
          "spk": "莲实 (ハスミ)",
          "ja": "少し、そっとしておきましょう",
          "tc": "就讓她好好休息一下吧。",
          "sc": "就让她好好休息一下吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330581,
          "spk": "今野 (コンノ)",
          "ja": "いやァ、それにしても",
          "tc": "哎呀～話說回來，",
          "sc": "哎呀～话说回来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330588,
          "spk": "今野 (コンノ)",
          "ja": "驚きましたよォ",
          "tc": "真是嚇了我一跳呢～",
          "sc": "真是吓了我一跳呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330599,
          "spk": "今野 (コンノ)",
          "ja": "大体のことは<player>さんから",
          "tc": "我已經聽<player>說了大致的情況，",
          "sc": "我已经听<player>说了大致的情况，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 330606,
          "spk": "今野 (コンノ)",
          "ja": "聞きましたけど、気を失うほどの",
          "tc": "她居然是頭痛到昏過去，",
          "sc": "她居然是头痛到昏过去，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 330613,
          "spk": "今野 (コンノ)",
          "ja": "頭痛なんて、よっぽどですよ",
          "tc": "還真嚴重耶。",
          "sc": "还真严重呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5655,
      "rec_id": "TALK_ID_10_0503_328_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 330631,
          "spk": "四郎治 (シロージ)",
          "ja": "……白々しい",
          "tc": "……少裝了。",
          "sc": "……少装了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 330638,
          "spk": "四郎治 (シロージ)",
          "ja": "俺に何を喋らせたいんだ",
          "tc": "你想讓我講什麼？",
          "sc": "你想让我讲什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 330651,
          "spk": "今野 (コンノ)",
          "ja": "ご本人のことは、",
          "tc": "關於她本人的事，",
          "sc": "关于她本人的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330658,
          "spk": "今野 (コンノ)",
          "ja": "ご本人に知らせてあげたほうが",
          "tc": "我覺得還是讓她知道",
          "sc": "我觉得还是让她知道"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330665,
          "spk": "今野 (コンノ)",
          "ja": "いいと思いますけどねェ",
          "tc": "比較好就是了～",
          "sc": "比较好就是了～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330678,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコのことは、",
          "tc": "駒子的事，",
          "sc": "驹子的事，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 330685,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が把握してりゃ充分だ",
          "tc": "只要有我了解就夠了。",
          "sc": "只要有我了解就够了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 330698,
          "spk": "今野 (コンノ)",
          "ja": "この先もずっと、",
          "tc": "您今後也打算",
          "sc": "您今后也打算"
        },
        {
          "f_idx": 8,
          "pidx_tc": 330705,
          "spk": "今野 (コンノ)",
          "ja": "このままのおつもりで？",
          "tc": "一直這樣下去嗎？",
          "sc": "一直这样下去吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 330716,
          "spk": "今野 (コンノ)",
          "ja": "十年経っても二十年経っても",
          "tc": "無論再過十年、二十年，",
          "sc": "无论再过十年、二十年，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 330723,
          "spk": "今野 (コンノ)",
          "ja": "コマコさんが老いて死ぬまで、",
          "tc": "您都有辦法持續隱瞞一切，",
          "sc": "您都有办法持续隐瞒一切，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 330730,
          "spk": "今野 (コンノ)",
          "ja": "すべてを隠し続けると？",
          "tc": "直到駒子小姐壽終正寢嗎？",
          "sc": "直到驹子小姐寿终正寝吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 330743,
          "spk": "四郎治 (シロージ)",
          "ja": "……お前",
          "tc": "……你！",
          "sc": "……你！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 330750,
          "spk": "四郎治 (シロージ)",
          "ja": "それ以上喋んなよ",
          "tc": "給我閉嘴！",
          "sc": "给我闭嘴！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 330763,
          "spk": "今野 (コンノ)",
          "ja": "オォ怖い……",
          "tc": "哦～真可怕……",
          "sc": "哦～真可怕……"
        }
      ]
    },
