    {
      "file": "talk.dat",
      "rec_idx": 5657,
      "rec_id": "TALK_ID_10_0503_328_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 330871,
          "spk": "四郎治 (シロージ)",
          "ja": "――十年前のことだ",
          "tc": "──那是十年前的事。",
          "sc": "——那是十年前的事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 330880,
          "spk": "四郎治 (シロージ)",
          "ja": "ある日突然、<strong>人がなにかに操られたように、",
          "tc": "某一天，發生了<strong>人像是被什麼操控了一樣，",
          "sc": "某一天，发生了<strong>人像是被什么操控了一样，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 330887,
          "spk": "四郎治 (シロージ)",
          "ja": "無作為に人を殺す</strong>という、不気味な事件……",
          "tc": "開始隨意殺人</strong>的恐怖事件……",
          "sc": "开始随意杀人</strong>的恐怖事件……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 330894,
          "spk": "四郎治 (シロージ)",
          "ja": "お前らも覚えてるだろ？",
          "tc": "你們都還記得吧？",
          "sc": "你们都还记得吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 330907,
          "spk": "莲实 (ハスミ)",
          "ja": "彼ヶ津村に大人が少ないのも、",
          "tc": "彼津村之所以大人這麼少，",
          "sc": "彼津村之所以大人这么少，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 330914,
          "spk": "莲实 (ハスミ)",
          "ja": "その時たくさん殺されたからでしたね",
          "tc": "也是因為當時有很多大人都被殺了。",
          "sc": "也是因为当时有很多大人都被杀了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 330934,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>……コマコは、あの時",
          "tc": "<strong>……駒子當時，",
          "sc": "<strong>……驹子当时，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 330941,
          "spk": "四郎治 (シロージ)",
          "ja": "村のみんなを、殺し回った側だった</strong>",
          "tc": "是到處殺害村民的那一方。</strong>",
          "sc": "是到处杀害村民的那一方。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
