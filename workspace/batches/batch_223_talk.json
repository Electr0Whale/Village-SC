      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 329101,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……！　待って！",
          "tc": "<player>……！等一下！",
          "sc": "<player>……！等一下！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 329112,
          "spk": "驹子 (コマコ)",
          "ja": "ご、ごめん……大きい声出して……",
          "tc": "抱、抱歉……我喊太大聲了……",
          "sc": "抱、抱歉……我喊太大声了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 329119,
          "spk": "驹子 (コマコ)",
          "ja": "でも……今日を逃したら、",
          "tc": "不過……一旦錯過今天，",
          "sc": "不过……一旦错过今天，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 329126,
          "spk": "驹子 (コマコ)",
          "ja": "もう二度とここに来れなさそうだから……",
          "tc": "我應該就沒辦法再到這裡來了……",
          "sc": "我应该就没办法再到这里来了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 329137,
          "spk": "驹子 (コマコ)",
          "ja": "お願い……",
          "tc": "所以，拜託你……",
          "sc": "所以，拜托你……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 329144,
          "spk": "驹子 (コマコ)",
          "ja": "もうちょっとだけ、一緒に来て……",
          "tc": "再多陪我一下下就好……",
          "sc": "再多陪我一下下就好……"
        }
      ]
    },
    {
