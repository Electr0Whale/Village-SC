      "rec_id": "TALK_ID_10_0503_328_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 330959,
          "spk": "四郎治 (シロージ)",
          "ja": "うちで飼っていた猟犬を殺し……",
