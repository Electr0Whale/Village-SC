      "rec_id": "TALK_ID_70_2100_003_08_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417211,
          "spk": "堇怜 (スミレ)",
          "ja": "ええー？",
          "tc": "怎麼這樣～？",
          "sc": "怎么这样～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417218,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の言うことを酔ったキスケさんが",
          "tc": "我說的話，醉醺醺的木助哥",
          "sc": "我说的话，醉醺醺的木助哥"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417225,
          "spk": "堇怜 (スミレ)",
