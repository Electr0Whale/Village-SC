    {
      "file": "talk.dat",
      "rec_idx": 8462,
      "rec_id": "TALK_ID_70_2120_009_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442385,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱり、カカシには名前は付けたくなるよね！",
          "tc": "果然就是會想幫稻草人取名字對吧！",
          "sc": "果然就是会想帮稻草人取名字对吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442392,
          "spk": "裕太 (ユータ)",
          "ja": "キミがわかってくれて嬉しいな",
          "tc": "我好開心你也懂。",
          "sc": "我好开心你也懂。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442403,
          "spk": "裕太 (ユータ)",
          "ja": "彼はいつも俺の畑を監督してくれているから",
          "tc": "他總是在幫我看管農田，",
          "sc": "他总是在帮我看管农田，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442410,
          "spk": "裕太 (ユータ)",
          "ja": "そう呼んでいるんだよ",
          "tc": "所以我就這麼稱呼他。",
          "sc": "所以我就这么称呼他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8463,
      "rec_id": "TALK_ID_70_2120_009_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442428,
          "spk": "裕太 (ユータ)",
          "ja": "えっ……！",
          "tc": "咦……！？",
          "sc": "咦……！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442435,
          "spk": "裕太 (ユータ)",
          "ja": "キミはカカシに名前、付けないのかい？",
          "tc": "你沒幫稻草人取名嗎？",
          "sc": "你没帮稻草人取名吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442446,
          "spk": "裕太 (ユータ)",
          "ja": "<player>の畑は大きいから、",
          "tc": "<player>你的田地這麼遼闊，",
          "sc": "<player>你的田地这么辽阔，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442453,
          "spk": "裕太 (ユータ)",
          "ja": "もっとたくさんカカシがいるんじゃない？",
          "tc": "稻草人應該比我還要多很多吧？",
          "sc": "稻草人应该比我还要多很多吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442460,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだからキミも、名前つけてみなよ",
          "tc": "既然都有稻草人了，也幫他們取個名字吧。",
          "sc": "既然都有稻草人了，也帮他们取个名字吧。"
        }
      ]
    },
    {
