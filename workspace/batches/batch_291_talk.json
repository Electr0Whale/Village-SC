          "f_idx": 3,
          "pidx_tc": 454398,
          "spk": "今野 (コンノ)",
          "ja": "おいしくて満足だと",
          "tc": "也要說聲好好吃、",
          "sc": "也要说声好好吃、"
        },
        {
          "f_idx": 4,
          "pidx_tc": 454405,
          "spk": "今野 (コンノ)",
          "ja": "言えばいいんです",
          "tc": "好滿足嘛。",
          "sc": "好满足嘛。"
        }
      ]
    },
    {
