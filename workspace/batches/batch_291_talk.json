        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8453,
      "rec_id": "TALK_ID_70_2110_009_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386400,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも、前は少し苦手だった",
