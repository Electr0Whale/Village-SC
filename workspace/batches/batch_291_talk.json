      "rec_id": "TALK_ID_70_2100_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419940,
          "spk": "名护 (ナゴ)",
          "ja": "何だ？　微妙な反応だな……",
          "tc": "怎麼了？好微妙的反應……",
          "sc": "怎么了？好微妙的反应……"
