          "sc": "真的吗～？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 454341,
          "spk": "今野 (コンノ)",
          "ja": "いやァ、そうですかァ",
          "tc": "這樣啊，",
          "sc": "这样啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 454348,
          "spk": "今野 (コンノ)",
          "ja": "苦肉の策でしたが",
          "tc": "其實這原本只是個下下策，",
          "sc": "其实这原本只是个下下策，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 454355,
          "spk": "今野 (コンノ)",
          "ja": "まさか気に入ってもらえるとはねェ",
          "tc": "但沒想到您居然會喜歡。",
          "sc": "但没想到您居然会喜欢呐～。"
        }
      ]
    },
    {
