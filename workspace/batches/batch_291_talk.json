        {
          "f_idx": 5,
          "pidx_tc": 385460,
          "spk": "洋 (ヨウ)",
          "ja": "いつもカレーは甘口で作ってくれるの",
          "tc": "做甜甜的咖哩給我吃。",
          "sc": "做甜甜的咖喱给我吃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8448,
      "rec_id": "TALK_ID_70_2110_007_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385478,
          "spk": "洋 (ヨウ)",
          "ja": "でも美味しい？",
