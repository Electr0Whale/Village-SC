          "pidx_tc": 386457,
          "spk": "洋 (ヨウ)",
          "ja": "美味しく感じられるようになったんだ",
          "tc": "魚變得比以前好吃了。",
          "sc": "鱼变得比以前好吃了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 386468,
          "spk": "洋 (ヨウ)",
          "ja": "なんでなんだろうね？",
          "tc": "為什麼會這樣呢？",
          "sc": "为什么会这样呢？"
        }
      ]
    },
