        {
          "f_idx": 3,
          "pidx_tc": 385546,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ手伝ったから",
          "tc": "切蔬菜之類的。",
          "sc": "切蔬菜之类的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385557,
          "spk": "洋 (ヨウ)",
          "ja": "だから、このおこさまカレーは",
          "tc": "所以這個兒童咖哩",
          "sc": "所以这个儿童咖喱"
