    },
    {
      "file": "talk.dat",
      "rec_idx": 8439,
      "rec_id": "TALK_ID_70_2100_007_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419471,
          "spk": "名护 (ナゴ)",
          "ja": "よかった……",
          "tc": "太好了……",
          "sc": "太好了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419478,
          "spk": "名护 (ナゴ)",
          "ja": "人に出せる完成度になってたか",
          "tc": "我本來很擔心成品",
          "sc": "我本来很担心成品"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419485,
          "spk": "名护 (ナゴ)",
          "ja": "心配だったんだ",
          "tc": "不足以端上桌呢。",
          "sc": "不足以端上桌呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419494,
          "spk": "名护 (ナゴ)",
          "ja": "せっかくの客人に",
          "tc": "畢竟難得有客人，",
          "sc": "毕竟难得有客人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 419501,
          "spk": "名护 (ナゴ)",
          "ja": "失礼を働くワケにもいかないからな",
          "tc": "總不能做出失禮的舉動吧。",
          "sc": "总不能做出失礼的举动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8440,
      "rec_id": "TALK_ID_70_2100_007_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 419523,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……よかった",
          "tc": "是嗎……太好了。",
          "sc": "是吗……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 419530,
          "spk": "名护 (ナゴ)",
          "ja": "苦労して作ったかいがあった",
          "tc": "努力做料理也算值得了。",
          "sc": "努力做料理也算值得了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 419539,
          "spk": "名护 (ナゴ)",
          "ja": "……人に料理を作る喜びが",
          "tc": "為別人做料理的喜悅……",
          "sc": "为别人做料理的喜悦……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 419546,
          "spk": "名护 (ナゴ)",
          "ja": "少しわかった気がするよ",
          "tc": "我好像稍微能理解了。",
          "sc": "我好像稍微能理解了。"
        }
      ]
    },
    {
