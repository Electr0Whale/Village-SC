          "pidx_tc": 386115,
          "spk": "洋 (ヨウ)",
          "ja": "その時は、<player>も一緒に食べようね",
          "tc": "到時候<player>也一起吃吧。",
          "sc": "到时候<player>也一起吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8452,
      "rec_id": "TALK_ID_70_2110_009_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386339,
          "spk": "洋 (ヨウ)",
