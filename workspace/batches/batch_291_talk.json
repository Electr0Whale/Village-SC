      "rec_id": "TALK_ID_70_2110_007_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385417,
          "spk": "洋 (ヨウ)",
          "ja": "あ……",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385424,
          "spk": "洋 (ヨウ)",
          "ja": "もしかして<player>は辛いほうが好き？",
          "tc": "難道說<player>比較喜歡吃辣？",
          "sc": "难道说<player>比较喜欢吃辣？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385435,
          "spk": "洋 (ヨウ)",
          "ja": "ごめんね",
          "tc": "對不起喔！",
          "sc": "对不起哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385442,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが甘口のカレーしか食べれないから",
          "tc": "因為我只能吃偏甜的咖哩，",
          "sc": "因为我只能吃偏甜的咖喱，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385453,
          "spk": "洋 (ヨウ)",
          "ja": "だからおじちゃんも、",
          "tc": "所以叔叔也總是",
