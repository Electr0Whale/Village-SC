      "rec_id": "TALK_ID_70_2100_009_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 420363,
          "spk": "名护 (ナゴ)",
          "ja": "パクパク食べてくれるけど",
