          "sc": "太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385496,
          "spk": "洋 (ヨウ)",
          "ja": "自分が好きな物を友達も好きって言ってくれると",
          "tc": "自己喜歡的東西連朋友也說喜歡，",
          "sc": "自己喜欢的东西连朋友也说喜欢，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385503,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、とっても嬉しいね",
          "tc": "總覺得讓人很高興呢。",
          "sc": "总觉得让人很高兴呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8449,
      "rec_id": "TALK_ID_70_2110_007_03_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385521,
          "spk": "洋 (ヨウ)",
          "ja": "えへへ、お口に合ってよかったです",
          "tc": "嘿嘿，還好合你的口味。",
          "sc": "嘿嘿，还好合你的口味。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385528,
          "spk": "洋 (ヨウ)",
          "ja": "作ったのは、おじちゃんなんだけど……",
          "tc": "雖然咖哩是叔叔做的……",
          "sc": "虽然咖喱是叔叔做的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385539,
          "spk": "洋 (ヨウ)",
          "ja": "わたしもお野菜とか切るの",
