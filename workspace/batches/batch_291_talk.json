        {
          "f_idx": 5,
          "pidx_tc": 385564,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんとわたしの合作なの",
          "tc": "是叔叔和我一起做的。",
          "sc": "是叔叔和我一起做的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8450,
      "rec_id": "TALK_ID_70_2110_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385910,
          "spk": "洋 (ヨウ)",
          "ja": "うん、優しいよ",
          "tc": "嗯，很溫柔喔。",
          "sc": "嗯，很温柔哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385917,
          "spk": "洋 (ヨウ)",
          "ja": "優しい思い出を思い出すから……",
          "tc": "會讓人想起溫柔的回憶……",
          "sc": "会让人想起温柔的回忆……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385928,
          "spk": "洋 (ヨウ)",
          "ja": "はじめて食べたのは、",
          "tc": "我第一次吃到，",
          "sc": "我第一次吃到，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385935,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがもっと小さい時なんだけど……",
          "tc": "是在我更小的時候……",
          "sc": "是在我更小的时候……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385946,
          "spk": "洋 (ヨウ)",
          "ja": "その時わたし、風邪を引いちゃってたの",
          "tc": "當時我得了感冒……",
          "sc": "当时我得了感冒……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385957,
          "spk": "洋 (ヨウ)",
          "ja": "喉が痛くて、苦しくて",
          "tc": "還記得那時喉嚨很痛、很難受，",
          "sc": "还记得那时喉咙很痛、很难受，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 385964,
          "spk": "洋 (ヨウ)",
          "ja": "なんにも食べられないのが辛くて",
          "tc": "因為什麼都吃不下",
          "sc": "因为什么都吃不下"
        },
        {
          "f_idx": 7,
          "pidx_tc": 385971,
          "spk": "洋 (ヨウ)",
          "ja": "泣きそうになってたのを憶えてる",
          "tc": "難過得快要哭出來了。",
          "sc": "难过得快要哭出来了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 385982,
          "spk": "洋 (ヨウ)",
          "ja": "そんな時にね",
          "tc": "就在那個時候啊，",
          "sc": "就在那个时候啊，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 385989,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが作ってくれたのが、",
          "tc": "叔叔做給我吃的，",
          "sc": "叔叔做给我吃的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 385996,
          "spk": "洋 (ヨウ)",
          "ja": "この牛乳寒天なの",
          "tc": "就是這個牛奶寒天凍。",
          "sc": "就是这个牛奶寒天冻。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 386007,
          "spk": "洋 (ヨウ)",
          "ja": "冷たくて、甘くて、するって食べられて",
          "tc": "又冰涼又甜，口感很滑溜，",
          "sc": "又冰凉又甜，口感很滑溜，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 386014,
          "spk": "洋 (ヨウ)",
          "ja": "風邪だって、すぐに治っちゃった",
          "tc": "連感冒都馬上就治好了。",
          "sc": "连感冒都马上就治好了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 386032,
          "spk": "洋 (ヨウ)",
          "ja": "それから、わたし",
          "tc": "從那之後，",
          "sc": "从那之后，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 386039,
          "spk": "洋 (ヨウ)",
          "ja": "牛乳寒天のこと大好きになっちゃったの",
          "tc": "我就變得最喜歡吃牛奶寒天凍了。",
          "sc": "我就变得最喜欢吃牛奶寒天冻了。"
        }
      ]
    },
    {
      "file": "talk.dat",
