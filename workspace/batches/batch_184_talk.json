        {
          "f_idx": 4,
          "pidx_tc": 239237,
          "spk": "四郎治 (シロージ)",
          "ja": "準備しておいたほうがいいかもな",
          "tc": "女神大人的祭品喔。",
          "sc": "女神大人的祭品啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
