        },
        {
          "f_idx": 2,
          "pidx_tc": 238802,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、<player>さん……",
          "tc": "哎呀，是<player>……",
          "sc": "哎呀，是<player>……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238809,
          "spk": "莲实 (ハスミ)",
          "ja": "顔色があまりよろしくありませんね",
          "tc": "你的臉色似乎不太好。",
          "sc": "你的脸色似乎不太好。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238820,
          "spk": "莲实 (ハスミ)",
          "ja": "大変なお仕事をされていて、",
          "tc": "是不是因為工作太辛苦，",
          "sc": "是不是因为工作太辛苦，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238827,
          "spk": "莲实 (ハスミ)",
          "ja": "お疲れなのでは……？",
          "tc": "累了呢……？",
          "sc": "累了呢……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238840,
          "spk": "四郎治 (シロージ)",
          "ja": "お前も、リンにこき使われて大変だな",
          "tc": "你也被林壓榨勞力很辛苦呢。",
