        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4114,
      "rec_id": "TALK_ID_10_0202_054_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238872,
          "spk": "莲实 (ハスミ)",
          "ja": "シロージは、一日中山仕事されてますよね？",
          "tc": "反倒是四郎治你整天都在山裡工作吧？",
          "sc": "反倒是四郎治你整天都在山里工作吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238879,
          "spk": "莲实 (ハスミ)",
          "ja": "どのようにして、",
          "tc": "要怎麼做，",
          "sc": "要怎么做，"
