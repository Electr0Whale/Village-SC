  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4098,
      "rec_id": "TALK_ID_10_0202_052_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237892,
          "spk": "洋 (ヨウ)",
          "ja": "うう……ぜんぜん当たらないよ……",
          "tc": "嗚……完全抽不到嘛……",
          "sc": "呜……完全抽不到嘛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237899,
          "spk": "洋 (ヨウ)",
          "ja": "せっかくシロージさんに、",
          "tc": "虧我特地拜託四郎治哥哥",
          "sc": "亏我特地拜托四郎治哥哥"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237906,
          "spk": "洋 (ヨウ)",
          "ja": "コインを地面から掘り出してもらったのに……",
          "tc": "幫忙從土裡挖出硬幣了……",
          "sc": "帮忙从土里挖出硬币了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237919,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあコイン、売ったげようか？",
          "tc": "那我把硬幣賣給妳吧？",
          "sc": "那我把硬币卖给你吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237926,
          "spk": "茶梅 (サザンカ)",
          "ja": "一枚、１００円でどう？",
          "tc": "一枚一百元如何？",
          "sc": "一枚一百元如何？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4099,
      "rec_id": "TALK_ID_10_0202_052_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237944,
          "spk": "洋 (ヨウ)",
          "ja": "ううー……",
          "tc": "嗚嗚……",
          "sc": "呜呜……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4100,
      "rec_id": "TALK_ID_10_0202_052_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237962,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカお前……",
          "tc": "茶梅，我說妳啊……",
          "sc": "茶梅，我说你啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237969,
          "spk": "四郎治 (シロージ)",
          "ja": "子ども相手にやめろよ……",
          "tc": "別對小孩做這種事啊……",
          "sc": "别对小孩做这种事啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237976,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウの教育に悪いだろーが",
          "tc": "要是教壞洋，妳要怎麼辦？",
          "sc": "要是教坏洋，你要怎么办？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237989,
          "spk": "茶梅 (サザンカ)",
          "ja": "うそうそ！",
          "tc": "騙妳的啦騙妳的啦！",
          "sc": "骗你的啦骗你的啦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237996,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、一枚だけあげるから！",
          "tc": "好啦，我送妳一枚吧！",
          "sc": "好啦，我送你一枚吧！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238003,
          "spk": "茶梅 (サザンカ)",
          "ja": "機嫌直してよ！",
          "tc": "不要難過了！",
          "sc": "不要难过了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4101,
      "rec_id": "TALK_ID_10_0202_052_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238021,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>、アンタにもあげるよ",
          "tc": "<player>，我也送你一枚吧，",
          "sc": "<player>，我也送你一枚吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238028,
          "spk": "茶梅 (サザンカ)",
          "ja": "こっちおいで",
          "tc": "過來這裡。",
          "sc": "过来这里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4102,
      "rec_id": "TALK_ID_10_0202_052_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238050,
          "spk": "茶梅 (サザンカ)",
          "ja": "ほら、受け取りな",
          "tc": "來，收下吧。",
          "sc": "来，收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4103,
      "rec_id": "TALK_ID_10_0202_052_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238082,
          "spk": "茶梅 (サザンカ)",
          "ja": "この機械、",
          "tc": "這台機器，",
          "sc": "这台机器，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238089,
          "spk": "茶梅 (サザンカ)",
          "ja": "うちのじいちゃんが生きてた頃に、",
          "tc": "據說是我爺爺還活著的時候，",
          "sc": "据说是我爷爷还活着的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238096,
          "spk": "茶梅 (サザンカ)",
          "ja": "パクってきたものらしくてさ",
          "tc": "從別的地方順手牽羊回來的。",
          "sc": "从别的地方顺手牵羊回来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238107,
          "spk": "茶梅 (サザンカ)",
          "ja": "お金じゃなくて、",
          "tc": "它不能用一般的錢，",
          "sc": "它不能用一般的钱，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238114,
          "spk": "茶梅 (サザンカ)",
          "ja": "専用のコインじゃないと回らないんだよね",
          "tc": "只能用專用硬幣才能抽獎。",
          "sc": "只能用专用硬币才能抽奖。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238125,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、<player>も回したかったら、",
          "tc": "所以如果<player>也想抽的話，",
          "sc": "所以如果<player>也想抽的话，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238132,
          "spk": "茶梅 (サザンカ)",
          "ja": "村中に埋められたコインを掘り当てて、",
          "tc": "就去挖出被埋在村子各個角落裡的硬幣，",
          "sc": "就去挖出被埋在村子各个角落里的硬币，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238139,
          "spk": "茶梅 (サザンカ)",
          "ja": "持ってきなよ",
          "tc": "帶來抽獎吧。",
          "sc": "带来抽奖吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 238152,
          "spk": "四郎治 (シロージ)",
          "ja": "ふーん……それにしても、",
          "tc": "嗯……不過話說回來，",
          "sc": "嗯……不过话说回来，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 238159,
          "spk": "四郎治 (シロージ)",
          "ja": "どうして、その専用コインが",
          "tc": "到底為什麼這些專用硬幣",
          "sc": "到底为什么这些专用硬币"
        },
        {
          "f_idx": 10,
          "pidx_tc": 238166,
          "spk": "四郎治 (シロージ)",
          "ja": "村のいたるところに埋まっているんだ……？",
          "tc": "會被埋在村子各處呢……？",
          "sc": "会被埋在村子各处呢……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4104,
      "rec_id": "TALK_ID_10_0202_052_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238184,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシが埋めてるからね",
          "tc": "因為是我埋起來的啊。",
          "sc": "因为是我埋起来的啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4105,
      "rec_id": "TALK_ID_10_0202_052_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238202,
          "spk": "四郎治 (シロージ)",
          "ja": "は……なんで？",
          "tc": "啊……？為什麼？",
          "sc": "啊……？为什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238215,
          "spk": "茶梅 (サザンカ)",
          "ja": "この村って暇じゃん？",
          "tc": "這村子不是很閒嗎？",
          "sc": "这村子不是很闲吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238222,
          "spk": "茶梅 (サザンカ)",
          "ja": "みんな退屈してるっしょ？",
          "tc": "大家不是都覺得很無聊嗎？",
          "sc": "大家不是都觉得很无聊吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238240,
          "spk": "茶梅 (サザンカ)",
          "ja": "だからアタシが、",
          "tc": "所以我這是在為大家",
          "sc": "所以我这是在为大家"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238247,
          "spk": "茶梅 (サザンカ)",
          "ja": "エンターテイメントを提供してあげてんの",
          "tc": "提供一些娛樂。",
          "sc": "提供一些娱乐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238254,
          "spk": "茶梅 (サザンカ)",
          "ja": "みんなの暇つぶしに、探す楽しみをね",
          "tc": "用尋找東西的樂趣，打發大家的時間。",
          "sc": "用寻找东西的乐趣，打发大家的时间。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238267,
          "spk": "四郎治 (シロージ)",
          "ja": "暇なのは、お前だろ……",
          "tc": "最閒的就是妳吧……",
          "sc": "最闲的就是你吧……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 238287,
          "spk": "茶梅 (サザンカ)",
          "ja": "ヨウや、<player>にとっても",
          "tc": "這對洋和<player>來說，",
          "sc": "这对洋和<player>来说，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 238294,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょうどいい知育遊びになるじゃん？",
          "tc": "也算是恰恰好的益智遊戲吧？",
          "sc": "也算是恰恰好的益智游戏吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4106,
      "rec_id": "TALK_ID_10_0202_052_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238314,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシがコインを埋めた地面は、",
          "tc": "我埋了硬幣的地面，",
          "sc": "我埋了硬币的地面，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238321,
          "spk": "茶梅 (サザンカ)",
          "ja": "土がちょっと盛り上がってるから、",
          "tc": "土會稍微隆起一些，",
          "sc": "土会稍微隆起一些，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238328,
          "spk": "茶梅 (サザンカ)",
          "ja": "クワとかで掘れば、コインが出てくるよ",
          "tc": "用鋤頭之類的挖一挖，就能挖出硬幣。",
          "sc": "用锄头之类的挖一挖，就能挖出硬币。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238339,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシがせっせと用意した遊びなんだから、",
          "tc": "這可是我辛辛苦苦準備的遊戲，",
          "sc": "这可是我辛辛苦苦准备的游戏，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238346,
          "spk": "茶梅 (サザンカ)",
          "ja": "めいっぱい楽しんでよね",
          "tc": "你要玩得盡興喔！",
          "sc": "你要玩得尽兴哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238359,
          "spk": "四郎治 (シロージ)",
          "ja": "そのゲーム……あんまり面白くなさそうだ",
          "tc": "那遊戲……感覺不怎麼有趣啊。",
          "sc": "那游戏……感觉不怎么有趣啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4107,
      "rec_id": "TALK_ID_10_0202_052_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238384,
          "spk": "茶梅 (サザンカ)",
          "ja": "うっさいな～",
          "tc": "吵死了～",
          "sc": "吵死了～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238395,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタの辛気くさい顔を見てるより、",
          "tc": "比起看著你那張愁眉苦臉，",
          "sc": "比起看着你那张愁眉苦脸，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238402,
          "spk": "茶梅 (サザンカ)",
          "ja": "宝探しの方が楽しいっしょ？",
          "tc": "尋寶有趣多了吧？",
          "sc": "寻宝有趣多了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238409,
          "spk": "茶梅 (サザンカ)",
          "ja": "年下には、ちょっとくらい愛想良くできないの？",
          "tc": "你就不能對年紀小的孩子們再親切一點嗎？",
          "sc": "你就不能对年纪小的孩子们再亲切一点吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238422,
          "spk": "四郎治 (シロージ)",
          "ja": "愛想良くしてるだろーが",
          "tc": "我已經很親切了吧。",
          "sc": "我已经很亲切了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238435,
          "spk": "茶梅 (サザンカ)",
          "ja": "その顔で？",
          "tc": "你說你這表情？",
          "sc": "你说你这表情？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238442,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタは、無駄に図体がでかいんだから",
          "tc": "而且你塊頭又莫名奇妙的魁梧，",
          "sc": "而且你块头又莫名奇妙的魁梧，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238449,
          "spk": "茶梅 (サザンカ)",
          "ja": "黙って立ってると怖いんだって",
          "tc": "默默站在那裡就夠可怕的了。",
          "sc": "默默站在那里就够可怕的了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 238462,
          "spk": "四郎治 (シロージ)",
          "ja": "……別に俺は怖くねぇだろ",
          "tc": "……我才不可怕。",
          "sc": "……我才不可怕。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4108,
      "rec_id": "TALK_ID_10_0202_052_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238480,
          "spk": "四郎治 (シロージ)",
          "ja": "……ねぇよな？",
          "tc": "……不可怕，對吧？",
          "sc": "……不可怕，对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4109,
      "rec_id": "TALK_ID_10_0202_052_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238498,
          "spk": "洋 (ヨウ)",
          "ja": "う……うん",
          "tc": "呃……嗯。",
          "sc": "呃……嗯。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238509,
          "spk": "洋 (ヨウ)",
          "ja": "でも、またコインを掘り出してくれたら、",
          "tc": "不過，如果能幫我挖出更多硬幣，",
          "sc": "不过，如果能帮我挖出更多硬币，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238516,
          "spk": "洋 (ヨウ)",
          "ja": "もっとこわくなくなるかも……",
          "tc": "我可能會更不害怕……",
          "sc": "我可能会更不害怕……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4110,
      "rec_id": "TALK_ID_10_0202_052_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238543,
          "spk": "四郎治 (シロージ)",
          "ja": "……おい、サザンカ",
          "tc": "……喂，茶梅，",
          "sc": "……喂，茶梅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238550,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウがこんなこと言いだしたぞ",
          "tc": "妳看洋都講出這種話來了，",
          "sc": "你看洋都讲出这种话来了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238557,
          "spk": "四郎治 (シロージ)",
          "ja": "お前の教育、絶対に間違ってるぜ……",
          "tc": "絕對是被妳教壞了……",
          "sc": "绝对是被你教坏了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4111,
      "rec_id": "TALK_ID_10_0202_053_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238585,
          "spk": "今野 (コンノ)",
          "ja": "アナタ……",
          "tc": "我說您啊……",
          "sc": "我说您啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238592,
          "spk": "今野 (コンノ)",
          "ja": "またしても掟を破りましたね……?",
          "tc": "又打破了規矩，是吧……？",
          "sc": "又打破了规矩，是吧……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238603,
          "spk": "今野 (コンノ)",
          "ja": "お化けは、話が通じず危険ですヨ……",
          "tc": "無法溝通的妖怪是很危險的……",
          "sc": "无法沟通的妖怪是很危险的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238610,
          "spk": "今野 (コンノ)",
          "ja": "怖がらせられるだけでなく、",
          "tc": "祂們不單會讓人害怕，",
          "sc": "他们不单会让人害怕，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238617,
          "spk": "今野 (コンノ)",
          "ja": "災厄に見舞われる可能性もあります",
          "tc": "甚至有可能讓人遇上災難，",
          "sc": "甚至有可能让人遇上灾难，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238626,
          "spk": "今野 (コンノ)",
          "ja": "だからこそ掟で禁じられているのですが……",
          "tc": "所以才會以規矩明令禁止……",
          "sc": "所以才会以规矩明令禁止……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238633,
          "spk": "今野 (コンノ)",
          "ja": "やはりアナタのような方は、",
          "tc": "但您這種人，",
          "sc": "但您这种人，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238640,
          "spk": "今野 (コンノ)",
          "ja": "好奇心旺盛で、退屈が嫌いなんですかねェ",
          "tc": "就是好奇心旺盛又討厭無聊吧。",
          "sc": "就是好奇心旺盛又讨厌无聊呐～。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 238651,
          "spk": "今野 (コンノ)",
          "ja": "まァ、仕方ないか",
          "tc": "唉，這也沒辦法。",
          "sc": "唉，这也没办法。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 238658,
          "spk": "今野 (コンノ)",
          "ja": "探し物は闇の中からしか、",
          "tc": "畢竟想找的東西，",
          "sc": "毕竟想找的东西，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 238665,
          "spk": "今野 (コンノ)",
          "ja": "出てきませんからね",
          "tc": "只會在黑暗之中出現啊。",
          "sc": "只会在黑暗之中出现啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4112,
      "rec_id": "TALK_ID_10_0202_053_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238683,
          "spk": "今野 (コンノ)",
          "ja": "もしアナタがこれからも、",
          "tc": "如果您今後也打算四處尋找",
          "sc": "如果您今后也打算四处寻找"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238690,
          "spk": "今野 (コンノ)",
          "ja": "深夜にしか得られない恩寵を探して廻るなら……",
          "tc": "只有在深夜才能獲得的恩寵……",
          "sc": "只有在深夜才能获得的恩宠……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238697,
          "spk": "今野 (コンノ)",
          "ja": "怪異ごとの対処法を、見つけ出さねばなりません",
          "tc": "那麼就必須找出各種妖怪的不同對應方式。",
          "sc": "那么就必须找出各种妖怪的不同对应方式。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238708,
          "spk": "今野 (コンノ)",
          "ja": "図書館にある昔の言い伝えを読めば、",
          "tc": "在圖書館查閱以前的傳說，",
          "sc": "在图书馆查阅以前的传说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238715,
          "spk": "今野 (コンノ)",
          "ja": "怪異どもを、逆に懲らしめる方法が",
          "tc": "或許還能找到",
          "sc": "或许还能找到"
        },
        {
          "f_idx": 5,
          "pidx_tc": 238722,
          "spk": "今野 (コンノ)",
          "ja": "わかるかもしれませんが……",
          "tc": "反過來懲處妖怪的辦法……",
          "sc": "反过来惩处妖怪的办法……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238733,
          "spk": "今野 (コンノ)",
          "ja": "あいにく図書館は閉まってますしィ？",
          "tc": "但很不巧，圖書館已經關門了。",
          "sc": "但很不巧，图书馆已经关门了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238740,
          "spk": "今野 (コンノ)",
          "ja": "せいぜい、お化けに呪い殺される前に、",
          "tc": "所以在您被妖怪們咒殺前，",
          "sc": "所以在您被妖怪们咒杀前，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 238747,
          "spk": "今野 (コンノ)",
          "ja": "危ない遊びは控えることです",
          "tc": "最好少玩危險的遊戲吧。",
          "sc": "最好少玩危险的游戏吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 238758,
          "spk": "今野 (コンノ)",
          "ja": "では、お気をつけてェ……",
          "tc": "那麼，還請您保重……",
          "sc": "那么，还请您保重……"
        }
      ]
    },
    {
      "file": "talk.dat",
