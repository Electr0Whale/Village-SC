    {
      "file": "talk.dat",
      "rec_idx": 4115,
      "rec_id": "TALK_ID_10_0202_054_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 238904,
          "spk": "四郎治 (シロージ)",
          "ja": "いっぱい食って、毎日働いて、慣れるしかねえよ",
          "tc": "只能吃飽飯每天工作，一點一點習慣下來。",
          "sc": "只能吃饱饭每天工作，一点一点习惯下来。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 238911,
          "spk": "四郎治 (シロージ)",
          "ja": "昔話みてーに不思議な動物が、",
          "tc": "如果像傳說故事那樣，有不可思議的動物",
          "sc": "如果像传说故事那样，有不可思议的动物"
        },
        {
          "f_idx": 2,
          "pidx_tc": 238918,
          "spk": "四郎治 (シロージ)",
          "ja": "力を授けてくれりゃ話は早いんだがなぁ……",
          "tc": "來授予神奇力量，那事情就簡單多了……",
          "sc": "来授予神奇力量，那事情就简单多了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 238931,
          "spk": "莲实 (ハスミ)",
          "ja": "それは……彼ヶ津村の民話のことですね？",
          "tc": "那是指……彼津村的民間故事嗎？",
          "sc": "那是指……彼津村的民间故事吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 238938,
          "spk": "莲实 (ハスミ)",
          "ja": "私も幼い頃、聞いたことがあります",
          "tc": "我小時候也有聽過。",
          "sc": "我小时候也有听过。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 238960,
          "spk": "四郎治 (シロージ)",
          "ja": "俺のじいさんが、よく話してたからな",
          "tc": "因為我爺爺很常講，",
          "sc": "因为我爷爷很常讲，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 238967,
          "spk": "四郎治 (シロージ)",
          "ja": "生きてる頃は、いっぱい聞かされたんだ",
          "tc": "他還在世的時候，我就聽他講過很多遍了。",
          "sc": "他还在世的时候，我就听他讲过很多遍了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 238978,
          "spk": "四郎治 (シロージ)",
          "ja": "力を授かる話といえば……",
          "tc": "說到授予力量……",
          "sc": "说到授予力量……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 238985,
          "spk": "四郎治 (シロージ)",
          "ja": "たしか……キツネの祠の話があったな……",
          "tc": "我記得……有個狐狸祠堂的故事……",
          "sc": "我记得……有个狐狸祠堂的故事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4116,
      "rec_id": "TALK_ID_10_0202_054_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239010,
          "spk": "四郎治 (シロージ)",
          "ja": "昔、とある農民の家に悪いキツネが現れて、",
          "tc": "從前某個農民家裡出現了一隻壞狐狸，",
          "sc": "从前某个农民家里出现了一只坏狐狸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 239017,
          "spk": "四郎治 (シロージ)",
          "ja": "野菜や果物、さらには銭まで盗むものだから、",
          "tc": "很愛偷蔬菜水果，甚至連錢都會偷。",
          "sc": "很爱偷蔬菜水果，甚至连钱都会偷。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 239024,
          "spk": "四郎治 (シロージ)",
          "ja": "農民がこっそり後をつけて行ったら……",
          "tc": "於是農民偷偷跟在牠後面……",
          "sc": "于是农民偷偷跟在它后面……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 239035,
          "spk": "四郎治 (シロージ)",
          "ja": "そこには立派な祠があって、",
          "tc": "結果來到了一座氣派的祠堂，",
          "sc": "结果来到了一座气派的祠堂，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 239042,
          "spk": "四郎治 (シロージ)",
          "ja": "キツネは盗んだものを、祠に供えていたんだと",
          "tc": "狐狸將偷來的東西供奉在了祠堂上。",
          "sc": "狐狸将偷来的东西供奉在了祠堂上。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 239060,
          "spk": "四郎治 (シロージ)",
          "ja": "農民はキツネを懲らしめて、盗みをやめさせて",
          "tc": "農民懲戒了狐狸，要牠不再偷盜，",
          "sc": "农民惩戒了狐狸，要它不再偷盗，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 239067,
          "spk": "四郎治 (シロージ)",
          "ja": "代わりに自ら野菜や果物を、",
          "tc": "日後自己就轉而代替狐狸",
          "sc": "日后自己就转而代替狐狸"
        },
        {
          "f_idx": 8,
          "pidx_tc": 239074,
          "spk": "四郎治 (シロージ)",
          "ja": "祠へ供えるようになったらしい",
          "tc": "到祠堂供奉蔬菜水果。",
          "sc": "到祠堂供奉蔬菜水果。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 239085,
          "spk": "四郎治 (シロージ)",
          "ja": "ある日、また供え物をしに行った農民の前に",
          "tc": "有一天，當農民又前往祠堂供奉時，",
          "sc": "有一天，当农民又前往祠堂供奉时，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 239092,
          "spk": "四郎治 (シロージ)",
          "ja": "女神さまが現れて、働いても疲れない",
          "tc": "女神大人出現在他的面前，",
          "sc": "女神大人出现在他的面前，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 239099,
          "spk": "四郎治 (シロージ)",
          "ja": "並み外れた力を、授けてくれたって話だ",
          "tc": "賜給了他怎麼工作都不會累的超凡力量。",
          "sc": "赐给了他怎么工作都不会累的超凡力量。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 239114,
          "spk": "莲实 (ハスミ)",
          "ja": "懐かしい……",
          "tc": "真令人懷念……",
          "sc": "真令人怀念……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 239121,
          "spk": "莲实 (ハスミ)",
          "ja": "昔話を聞くと、幼い頃のことを思い出して、",
          "tc": "聽著故事，就會回想起小時候，",
          "sc": "听着故事，就会回想起小时候，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 239128,
          "spk": "莲实 (ハスミ)",
          "ja": "心が温かくなりますね……",
          "tc": "心裡都覺得暖和起來了……",
          "sc": "心里都觉得暖和起来了……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 239139,
          "spk": "莲实 (ハスミ)",
          "ja": "とはいえ、彼ヶ津村で",
          "tc": "不過在這個彼津村，",
          "sc": "不过在这个彼津村，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 239146,
          "spk": "莲实 (ハスミ)",
          "ja": "そのような立派な祠なんて、",
          "tc": "我從沒見過傳說中",
          "sc": "我从没见过传说中"
        },
        {
          "f_idx": 17,
          "pidx_tc": 239153,
          "spk": "莲实 (ハスミ)",
          "ja": "見たことがないですけど……",
          "tc": "那種氣派的祠堂就是了……",
          "sc": "那种气派的祠堂就是了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4117,
      "rec_id": "TALK_ID_10_0202_054_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239171,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ昔の話だし、ただの民話だからな……",
          "tc": "畢竟只是古老的民間故事……",
          "sc": "毕竟只是古老的民间故事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 239178,
          "spk": "四郎治 (シロージ)",
          "ja": "今の村には祠どころか、供え物をするような",
          "tc": "現在村子裡別說是祠堂了，",
          "sc": "现在村子里别说是祠堂了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 239185,
          "spk": "四郎治 (シロージ)",
          "ja": "信心深いキツネもいねぇだろうよ",
          "tc": "連會去供奉的虔誠狐狸都找不到啊。",
          "sc": "连会去供奉的虔诚狐狸都找不到啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4118,
      "rec_id": "TALK_ID_10_0202_054_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239205,
          "spk": "四郎治 (シロージ)",
          "ja": "とはいえ、<player>も農民だったな",
          "tc": "但話說回來，<player>也是個農民吧。",
          "sc": "但话说回来，<player>也是个农民吧。"
        },
