        {
          "f_idx": 3,
          "pidx_tc": 239478,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ああ、わかったよ",
          "tc": "……嗯，我知道了。",
          "sc": "……嗯，我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
