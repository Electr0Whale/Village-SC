      "rec_id": "TALK_ID_10_0301_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リン、なんだか最近、",
          "tc": "林，妳不覺得",
          "sc": "林，你不觉得"
        },
        {
          "f_idx": 1,
          "pidx_tc": 239272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "彼ヶ津村の様子が変じゃないかい？",
          "tc": "最近彼津村的氣氛有點奇怪嗎？",
          "sc": "最近彼津村的气氛有点奇怪吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 239279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんというか……イヤに静かすぎるんだ",
          "tc": "該怎麼說……太過安靜到令人發毛啊。",
          "sc": "该怎么说……太过安静到令人发毛啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 239292,
          "spk": "林 (リン)",
          "ja": "そうかしら？",
          "tc": "會嗎……？",
          "sc": "会吗……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 239299,
          "spk": "林 (リン)",
          "ja": "平穏なことは、悪いことじゃないと思うけど",
          "tc": "平平穩穩的，我不覺得是什麼壞事。",
          "sc": "平平稳稳的，我不觉得是什么坏事。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 239312,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それが違和感なんだよ、あり得ない……",
          "tc": "那就是不對勁啊，不該是這樣的……",
          "sc": "那就是不对劲啊，不该是这样的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 239332,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あの事件からちょうど十年目だし、",
          "tc": "距離那起事件剛好滿十年，",
          "sc": "距离那起事件刚好满十年，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 239339,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今年の贄は小ヤギやウサギや、",
          "tc": "今年的祭品光靠小山羊、兔子，",
          "sc": "今年的祭品光靠小山羊、兔子，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 239346,
          "spk": "琪娜娜 (チナナ)",
          "ja": "住人の血だけじゃ、足りないんじゃない？",
          "tc": "以及村民的血，恐怕是不夠了吧？",
          "sc": "以及村民的血，恐怕是不够了吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 239357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだ……ウチが調べてこようか？",
          "tc": "對了……要不要我去調查一下？",
          "sc": "对了……要不要我去调查一下？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 239364,
          "spk": "琪娜娜 (チナナ)",
          "ja": "放置すると、きっとまた<strong>祟り</strong>が――",
          "tc": "要是放著不管，恐怕<strong>作祟</strong>又──",
          "sc": "要是放着不管，恐怕<strong>作祟</strong>又——"
        },
        {
          "f_idx": 13,
          "pidx_tc": 239384,
          "spk": "林 (リン)",
          "ja": "あなたが、その役割を負う必要はないわ",
          "tc": "妳不需要扛起這項任務。",
          "sc": "你不需要扛起这项任务。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 239391,
          "spk": "林 (リン)",
          "ja": "村のみんなには、ちゃんと言い聞かせている",
          "tc": "我已經好好告誡過村子裡的大家了，",
          "sc": "我已经好好告诫过村子里的大家了，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 239409,
          "spk": "林 (リン)",
          "ja": "<strong>「掟の三、見知らぬ者に近づくな」……</strong>",
          "tc": "<strong>「規矩之三，別靠近陌生人」……</strong>",
          "sc": "<strong>“规矩之三，别靠近陌生人”……</strong>"
        },
        {
          "f_idx": 17,
          "pidx_tc": 239416,
          "spk": "林 (リン)",
          "ja": "これを守っていれば、きっと<strong>祟りは起きないわ</strong>",
          "tc": "只要堅守這一點，<strong>就一定不會發生作祟的。</strong>",
          "sc": "只要坚守这一点，<strong>就一定不会发生作祟的。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4120,
      "rec_id": "TALK_ID_10_0301_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239451,
          "spk": "林 (リン)",
          "ja": "それに、贄の儀式の用意も進めている……",
          "tc": "而且，祭品儀式的準備也在進行中……",
          "sc": "而且，祭品仪式的准备也在进行中……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 239458,
          "spk": "林 (リン)",
          "ja": "十年目だからこそ、私がしっかり村を守るわ",
          "tc": "正因為是第十年，我一定會好好守護村子的。",
          "sc": "正因为是第十年，我一定会好好守护村子的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 239465,
          "spk": "林 (リン)",
          "ja": "だから、安心して見ていなさい",
          "tc": "妳就放心地看著吧。",
