      "rec_id": "TALK_ID_10_0301_002_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239999,
          "spk": "裕太 (ユータ)",
          "ja": "ねぇ、<player>からも何か言ってよ！",
