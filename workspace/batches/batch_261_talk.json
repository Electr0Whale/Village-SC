      "rec_id": "TALK_ID_70_2090_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450670,
          "spk": "今野 (コンノ)",
          "ja": "では、無知なアナタに、",
          "tc": "那麼，為了無知的您，",
          "sc": "那么，为了无知的您，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450677,
          "spk": "今野 (コンノ)",
          "ja": "一晩かけて物の価値というものを",
          "tc": "理解何謂物品的價值，",
          "sc": "理解何谓物品的价值，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450684,
          "spk": "今野 (コンノ)",
          "ja": "このワタシが直々にご説明して差し上げましょう",
          "tc": "就由我親自花一個晚上的時間為您解說吧。",
          "sc": "就由我亲自花一个晚上的时间为您解说吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450695,
          "spk": "今野 (コンノ)",
          "ja": "あくびなどしようものなら",
          "tc": "要是您做出打呵欠之類的行為，",
          "sc": "要是您做出打呵欠之类的行为，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450702,
          "spk": "今野 (コンノ)",
          "ja": "ひっぱたきますので",
          "tc": "我會打醒您的，",
          "sc": "我会打醒您的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450709,
          "spk": "今野 (コンノ)",
          "ja": "覚悟してくださァい",
          "tc": "請做好心理準備。",
          "sc": "请做好心理准备。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7390,
      "rec_id": "TALK_ID_70_2090_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450733,
          "spk": "今野 (コンノ)",
          "ja": "さて……夜も深まってきましたネ",
          "tc": "好的……夜也深了。",
          "sc": "好的……夜也深了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450740,
          "spk": "今野 (コンノ)",
          "ja": "名残惜しいですが、",
          "tc": "雖然還意猶未盡，",
          "sc": "虽然还意犹未尽，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450747,
          "spk": "今野 (コンノ)",
          "ja": "もうそろそろ寝るとしましょうかァ",
          "tc": "但差不多該睡了。",
          "sc": "但差不多该睡呀～？。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450758,
          "spk": "今野 (コンノ)",
          "ja": "客用布団、日中に",
          "tc": "我已經在白天",
          "sc": "我已经在白天"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450765,
          "spk": "今野 (コンノ)",
          "ja": "干しておきましたからネ",
          "tc": "曬過訪客用的棉被了。",
          "sc": "晒过访客用的棉被了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450776,
          "spk": "今野 (コンノ)",
          "ja": "フカフカのうちに",
          "tc": "趁棉被還很蓬鬆，",
          "sc": "趁棉被还很蓬松，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 450783,
          "spk": "今野 (コンノ)",
          "ja": "眠るといいですヨ",
          "tc": "趕快來睡吧。",
          "sc": "赶快来睡哟～。"
        }
      ]
    },
    {
