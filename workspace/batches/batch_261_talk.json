    {
      "file": "talk.dat",
      "rec_idx": 7392,
      "rec_id": "TALK_ID_70_2090_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450849,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはワタシなりに",
          "tc": "我也算是",
          "sc": "我也算是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450856,
          "spk": "今野 (コンノ)",
          "ja": "この村の移り変わりを",
          "tc": "以自己的方式",
          "sc": "以自己的方式"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450863,
          "spk": "今野 (コンノ)",
          "ja": "見守ってきたつもりです",
          "tc": "見證了村子的變遷。",
          "sc": "见证了村子的变迁。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450872,
          "spk": "今野 (コンノ)",
          "ja": "ただ、それが村に必要な",
          "tc": "但我並不是",
          "sc": "但我并不是"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450879,
          "spk": "今野 (コンノ)",
          "ja": "役割というわけでは",
          "tc": "這個村子",
          "sc": "这个村子"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450886,
          "spk": "今野 (コンノ)",
          "ja": "ないんですよねェ",
          "tc": "所需要的人。",
          "sc": "所需要的人呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7393,
      "rec_id": "TALK_ID_70_2090_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450902,
          "spk": "今野 (コンノ)",
          "ja": "ワタシは今は、リンさんの",
          "tc": "我目前是以",
          "sc": "我目前是以"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450909,
          "spk": "今野 (コンノ)",
          "ja": "育ての親として村にいますが",
          "tc": "林小姐養父的身分留在這裡的。",
          "sc": "林小姐养父的身分留在这里的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450918,
          "spk": "今野 (コンノ)",
          "ja": "いつかリンさんが",
          "tc": "我想總有一天，",
          "sc": "我想总有一天，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450925,
          "spk": "今野 (コンノ)",
          "ja": "ワタシを完全に必要と",
          "tc": "林小姐",
          "sc": "林小姐"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450932,
          "spk": "今野 (コンノ)",
          "ja": "しなくなる日が来るでしょうネ",
          "tc": "會不再需要我吧。",
          "sc": "会不再需要我吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450941,
          "spk": "今野 (コンノ)",
          "ja": "その時、ワタシは",
          "tc": "到時候",
          "sc": "到时候"
