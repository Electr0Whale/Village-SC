  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7375,
      "rec_id": "TALK_ID_70_2090_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 449294,
          "spk": "今野 (コンノ)",
          "ja": "食事を楽しみたいと",
          "tc": "想要享受一餐，",
          "sc": "想要享受一餐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 449301,
          "spk": "今野 (コンノ)",
          "ja": "思ったら、料理の",
          "tc": "就也得要重視",
          "sc": "就也得要重视"
        },
        {
          "f_idx": 2,
          "pidx_tc": 449308,
          "spk": "今野 (コンノ)",
          "ja": "見た目も大事なんですヨ",
          "tc": "料理的外觀才行。",
          "sc": "料理的外观才行哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 449319,
          "spk": "今野 (コンノ)",
          "ja": "例えば、焦げてしまって",
          "tc": "比方說，",
          "sc": "比方说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 449326,
          "spk": "今野 (コンノ)",
          "ja": "普段なら食べられない",
          "tc": "有一道料理燒焦了，",
          "sc": "有一道料理烧焦了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 449333,
          "spk": "今野 (コンノ)",
          "ja": "料理があったとします",
          "tc": "平常的話我們根本就不會去吃它。",
          "sc": "平常的话我们根本就不会去吃它。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 449344,
          "spk": "今野 (コンノ)",
          "ja": "ですが、金粉をまぶせば",
          "tc": "但是只要撒滿了金粉，",
          "sc": "但是只要撒满了金粉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 449351,
          "spk": "今野 (コンノ)",
          "ja": "高級品に早変わりです",
          "tc": "那麼這道料理就會立刻變身為高級品，",
          "sc": "那么这道料理就会立刻变身为高级品，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 449358,
          "spk": "今野 (コンノ)",
          "ja": "いくらでも食べられちゃいますヨ",
          "tc": "讓人要吃多少都不是問題。",
          "sc": "让人要吃多少都不是问题哟～。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 449369,
          "spk": "今野 (コンノ)",
          "ja": "高いものを食べている",
          "tc": "只要意識到",
          "sc": "只要意识到"
        },
        {
          "f_idx": 10,
          "pidx_tc": 449376,
          "spk": "今野 (コンノ)",
          "ja": "という気持ちが、",
          "tc": "自己正在品嘗著昂貴的料理，",
          "sc": "自己正在品尝着昂贵的料理，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 449383,
          "spk": "今野 (コンノ)",
          "ja": "料理をおいしくするんです",
          "tc": "那麼料理就會顯得更加美味。",
          "sc": "那么料理就会显得更加美味。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 449394,
          "spk": "今野 (コンノ)",
          "ja": "これ、覚えておいて",
          "tc": "請您記得這個道理，",
          "sc": "请您记得这个道理，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 449401,
          "spk": "今野 (コンノ)",
          "ja": "損はないですよォ",
          "tc": "對您沒有損失的。",
          "sc": "对您没有损失哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7376,
      "rec_id": "TALK_ID_70_2090_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 449425,
          "spk": "今野 (コンノ)",
          "ja": "ちょうどいいところに",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 449432,
          "spk": "今野 (コンノ)",
          "ja": "来ましたねェ",
          "tc": "您來得正好。",
          "sc": "您来得正好呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 449443,
          "spk": "今野 (コンノ)",
          "ja": "今日は「きつねうどん」を",
          "tc": "我今天準備了",
          "sc": "我今天准备了"
        },
        {
          "f_idx": 3,
          "pidx_tc": 449450,
          "spk": "今野 (コンノ)",
          "ja": "用意したんですヨ",
          "tc": "「豆皮烏龍麵」喔。",
          "sc": "“豆皮乌冬面”哟～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 449459,
          "spk": "今野 (コンノ)",
          "ja": "早く食べないと伸びて",
          "tc": "不趕快吃的話",
          "sc": "不赶快吃的话"
        },
        {
          "f_idx": 5,
          "pidx_tc": 449466,
          "spk": "今野 (コンノ)",
          "ja": "しまいますからネ",
          "tc": "麵會糊掉的。",
          "sc": "面会糊掉的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 449473,
          "spk": "今野 (コンノ)",
          "ja": "すぐに食べましょう",
          "tc": "我們就趕快開動吧。",
          "sc": "我们就赶快开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7377,
      "rec_id": "TALK_ID_70_2090_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 449497,
          "spk": "今野 (コンノ)",
          "ja": "ん～～～～",
          "tc": "嗯～～～～",
          "sc": "嗯～～～～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 449504,
          "spk": "今野 (コンノ)",
          "ja": "いい出来映えですねェ",
          "tc": "做得真是不錯呢。",
          "sc": "做得真是不错呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 449515,
          "spk": "今野 (コンノ)",
          "ja": "念のために言っておきますが",
          "tc": "以防您誤會，我得說明清楚，",
          "sc": "以防您误会，我得说明清楚，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 449522,
          "spk": "今野 (コンノ)",
          "ja": "普段のワタシはもっと",
          "tc": "平常我吃的東西",
          "sc": "平常我吃的东西"
        },
        {
          "f_idx": 4,
          "pidx_tc": 449529,
          "spk": "今野 (コンノ)",
          "ja": "豪勢な食事をとっていますヨ",
          "tc": "可是很豐盛的。",
          "sc": "可是很丰盛哟～。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 449540,
          "spk": "今野 (コンノ)",
          "ja": "ただ、きつねうどんは",
          "tc": "不過豆皮烏龍麵",
          "sc": "不过豆皮乌冬面"
        },
        {
          "f_idx": 6,
          "pidx_tc": 449547,
          "spk": "今野 (コンノ)",
          "ja": "素朴ながらも昔から",
          "tc": "雖然簡單樸素，",
          "sc": "虽然简单朴素，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 449554,
          "spk": "今野 (コンノ)",
          "ja": "好きな料理でしてネ",
          "tc": "卻是我從以前就很喜歡的料理。",
          "sc": "却是我从以前就很喜欢的料理。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 449563,
          "spk": "今野 (コンノ)",
          "ja": "おあげの味つけや",
          "tc": "像是豆皮的調味、",
          "sc": "像是豆皮的调味、"
        },
        {
          "f_idx": 9,
          "pidx_tc": 449570,
          "spk": "今野 (コンノ)",
          "ja": "うどんの茹で具合",
          "tc": "烏龍麵的硬度，",
          "sc": "乌冬面的硬度，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 449577,
          "spk": "今野 (コンノ)",
          "ja": "お出汁の濃さ……",
          "tc": "以及湯頭的濃度……",
          "sc": "以及汤头的浓度……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 449588,
          "spk": "今野 (コンノ)",
          "ja": "すべてにこだわって",
          "tc": "這些我都有",
          "sc": "这些我都有"
        },
        {
          "f_idx": 12,
          "pidx_tc": 449595,
          "spk": "今野 (コンノ)",
          "ja": "自分で作るのが",
          "tc": "自己的堅持，",
          "sc": "自己的坚持，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 449602,
          "spk": "今野 (コンノ)",
          "ja": "好きなんですヨ",
          "tc": "所以我喜歡自己做。",
          "sc": "所以我喜欢自己做哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7378,
      "rec_id": "TALK_ID_70_2090_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 449620,
          "spk": "今野 (コンノ)",
          "ja": "おやァ？",
          "tc": "哦？",
          "sc": "哎呀～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 449627,
          "spk": "今野 (コンノ)",
          "ja": "ワタシが料理をするとは",
          "tc": "您很意外",
          "sc": "您很意外"
        },
        {
          "f_idx": 2,
          "pidx_tc": 449634,
          "spk": "今野 (コンノ)",
          "ja": "意外でしたかァ？",
          "tc": "我會下廚嗎？",
          "sc": "我会下厨吗～？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 449645,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、リンさんを",
          "tc": "您以為",
          "sc": "您以为"
        },
        {
          "f_idx": 4,
          "pidx_tc": 449652,
          "spk": "今野 (コンノ)",
          "ja": "育てたのは",
          "tc": "是誰把林小姐",
          "sc": "是谁把林小姐"
        },
        {
          "f_idx": 5,
          "pidx_tc": 449659,
          "spk": "今野 (コンノ)",
          "ja": "誰だとお思いで？",
          "tc": "養大的啊？",
          "sc": "养大的啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 449670,
          "spk": "今野 (コンノ)",
          "ja": "一般的な料理なら",
          "tc": "一些常見的家常料理",
          "sc": "一些常见的家常料理"
        },
        {
          "f_idx": 7,
          "pidx_tc": 449677,
          "spk": "今野 (コンノ)",
          "ja": "ワタシ、大体できますヨ",
          "tc": "我大概都會煮的。",
          "sc": "我大概都会煮哟～。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 449695,
          "spk": "今野 (コンノ)",
          "ja": "中でも得意料理と言えるのが",
          "tc": "而其中可以算是拿手菜的，",
          "sc": "而其中可以算是拿手菜的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 449702,
          "spk": "今野 (コンノ)",
          "ja": "きつねうどんというわけです",
          "tc": "就是這道豆皮烏龍麵了。",
          "sc": "就是这道豆皮乌冬面了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 449713,
          "spk": "今野 (コンノ)",
          "ja": "味つけも、ほら",
          "tc": "您說說看，",
          "sc": "您说说看，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 449720,
          "spk": "今野 (コンノ)",
          "ja": "完璧な出来映えでしょう？",
          "tc": "調味的部分是不是也非常完美啊？",
          "sc": "调味的部分是不是也非常完美啊？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 449736,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 15,
          "pidx_tc": 449743,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7379,
      "rec_id": "TALK_ID_70_2090_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 449877,
          "spk": "今野 (コンノ)",
          "ja": "特に自信作の",
          "tc": "這蓬鬆多汁的豆皮",
          "sc": "这蓬松多汁的豆皮"
        },
        {
          "f_idx": 1,
          "pidx_tc": 449884,
          "spk": "今野 (コンノ)",
          "ja": "ふっくらジューシーおあげは",
          "tc": "可是我的得意之作，",
          "sc": "可是我的得意之作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 449891,
          "spk": "今野 (コンノ)",
          "ja": "まだおかわりがありますヨ",
          "tc": "這邊還有很多個喔。",
          "sc": "这边还有很多个哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 449902,
          "spk": "今野 (コンノ)",
          "ja": "今日は奮発して",
          "tc": "今天就奢侈一下，",
          "sc": "今天就奢侈一下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 449909,
          "spk": "今野 (コンノ)",
          "ja": "おあげ二枚のきつねうどんと",
          "tc": "來一碗",
          "sc": "来一碗"
        },
        {
          "f_idx": 5,
          "pidx_tc": 449916,
          "spk": "今野 (コンノ)",
          "ja": "洒落込みましょうかァ",
          "tc": "兩片豆皮的烏龍麵吧？",
          "sc": "两片豆皮的乌冬面吧～？"
        }
      ]
    },
