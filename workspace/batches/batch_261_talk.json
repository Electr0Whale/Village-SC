    {
      "file": "talk.dat",
      "rec_idx": 7383,
      "rec_id": "TALK_ID_70_2090_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450034,
          "spk": "今野 (コンノ)",
          "ja": "いやァ、実はですネ",
          "tc": "其實啊，",
          "sc": "其实啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450041,
          "spk": "今野 (コンノ)",
          "ja": "アナタを食事会に誘った後、",
          "tc": "在約了您聚餐之後，",
          "sc": "在约了您聚餐之后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450048,
          "spk": "今野 (コンノ)",
          "ja": "株で大損してしまいましてェ……",
          "tc": "我的股票就慘賠了一波……",
          "sc": "我的股票就惨赔了一波……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450057,
          "spk": "今野 (コンノ)",
          "ja": "呆然としておりましたァ……",
          "tc": "真是讓我好錯愕啊……",
          "sc": "真是让我好错愕啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450068,
          "spk": "今野 (コンノ)",
          "ja": "ですがもちろん、誘ったからには",
          "tc": "但是畢竟都約了您了，",
          "sc": "但是毕竟都约了您了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450075,
          "spk": "今野 (コンノ)",
          "ja": "食事の用意をさせてもらいましたヨ",
          "tc": "所以我當然還是會準備餐點的。",
          "sc": "所以我当然还是会准备餐点的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 450086,
          "spk": "今野 (コンノ)",
          "ja": "さァ、席にどうぞォ",
          "tc": "來，請入座吧，",
          "sc": "来，请入座吧，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 450093,
          "spk": "今野 (コンノ)",
          "ja": "今日は一風変わった料理を",
          "tc": "我今天會招待您",
          "sc": "我今天会招待您"
        },
        {
          "f_idx": 8,
          "pidx_tc": 450100,
          "spk": "今野 (コンノ)",
          "ja": "振る舞わせてもらいますヨ",
          "tc": "享用風格獨特的料理。",
          "sc": "享用风格独特的料理哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7384,
      "rec_id": "TALK_ID_70_2090_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450124,
          "spk": "今野 (コンノ)",
          "ja": "今日の料理は",
          "tc": "今天的菜色是",
          "sc": "今天的菜色是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450131,
          "spk": "今野 (コンノ)",
          "ja": "「醤油プリン」です",
          "tc": "「醬油布丁」。",
          "sc": "“酱油布丁”。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450142,
          "spk": "今野 (コンノ)",
          "ja": "プリンに醤油をかけて",
          "tc": "是把醬油淋在布丁上，",
          "sc": "是把酱油淋在布丁上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450149,
          "spk": "今野 (コンノ)",
          "ja": "海苔で包んだものですネ",
          "tc": "並且用海苔包起來的一道料理。",
          "sc": "并且用海苔包起来的一道料理。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7385,
      "rec_id": "TALK_ID_70_2090_009_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450174,
          "spk": "今野 (コンノ)",
          "ja": "これ、目を閉じて食べると",
          "tc": "只要您閉著眼睛吃，",
          "sc": "只要您闭着眼睛吃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450181,
          "spk": "今野 (コンノ)",
          "ja": "ウニの軍艦巻き",
          "tc": "這吃起來就會像是",
          "sc": "这吃起来就会像是"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450188,
          "spk": "今野 (コンノ)",
          "ja": "そのものなんですヨ",
          "tc": "海膽軍艦壽司一樣。",
          "sc": "海胆军舰寿司一样哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450199,
          "spk": "今野 (コンノ)",
          "ja": "どうです？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450206,
          "spk": "今野 (コンノ)",
          "ja": "なかなかイケるでしょう？",
          "tc": "還不錯吧？",
          "sc": "还不错吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450215,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 450222,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7386,
      "rec_id": "TALK_ID_70_2090_009_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450340,
          "spk": "今野 (コンノ)",
          "ja": "しかし、これだけでは",
          "tc": "不過只吃這個",
          "sc": "不过只吃这个"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450347,
          "spk": "今野 (コンノ)",
          "ja": "お腹は膨れませんよネ？",
          "tc": "是吃不飽的，對吧？",
          "sc": "是吃不饱的，对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450358,
          "spk": "今野 (コンノ)",
          "ja": "安心してください",
          "tc": "您放心吧，",
          "sc": "您放心吧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450365,
          "spk": "今野 (コンノ)",
          "ja": "今日はデザートも",
          "tc": "我今天",
          "sc": "我今天"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450372,
          "spk": "今野 (コンノ)",
          "ja": "用意してあるんです",
          "tc": "還有準備甜點呢。",
          "sc": "还有准备甜点呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450383,
          "spk": "今野 (コンノ)",
          "ja": "高級メロン――",
          "tc": "就是高級甜瓜──",
          "sc": "就是高级甜瓜——"
        },
        {
          "f_idx": 6,
          "pidx_tc": 450390,
          "spk": "今野 (コンノ)",
          "ja": "もとい「蜂蜜キュウリ」です",
          "tc": "風味的「蜂蜜小黃瓜」。",
          "sc": "风味的“蜂蜜黄瓜”。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 450401,
          "spk": "今野 (コンノ)",
          "ja": "これはですネ、あらかじめ",
          "tc": "這裡教您一個小訣竅，",
          "sc": "这里教您一个小诀窍，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 450408,
          "spk": "今野 (コンノ)",
          "ja": "キュウリの皮を剥いておくのが",
          "tc": "只要先去除小黃瓜的皮，",
          "sc": "只要先去除黄瓜的皮，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 450415,
          "spk": "今野 (コンノ)",
          "ja": "メロン感を味わえるコツなんです",
          "tc": "吃起來就會很有甜瓜感了。",
          "sc": "吃起来就会很有甜瓜感了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 450426,
          "spk": "今野 (コンノ)",
          "ja": "ウニとメロンを食べられるなんて",
          "tc": "能夠吃到海膽與甜瓜，",
          "sc": "能够吃到海胆与甜瓜，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 450433,
          "spk": "今野 (コンノ)",
          "ja": "よかったじゃないですかァ",
          "tc": "是不是很棒啊？",
          "sc": "是不是很棒啊～？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 450444,
          "spk": "今野 (コンノ)",
          "ja": "一時はどうなることかと思いましたが",
          "tc": "我本來還很擔心的呢，",
          "sc": "我本来还很担心的呢，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 450451,
          "spk": "今野 (コンノ)",
          "ja": "無事におもてなしできて",
          "tc": "但幸好還是順利地招待了您一餐，",
          "sc": "但幸好还是顺利地招待了您一餐，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 450458,
          "spk": "今野 (コンノ)",
          "ja": "ワタシ、ホッとしましたよォ",
          "tc": "這樣我就放心了。",
          "sc": "这样我就放心哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7387,
      "rec_id": "TALK_ID_70_2090_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 450482,
          "spk": "今野 (コンノ)",
          "ja": "おやまァ",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 450489,
          "spk": "今野 (コンノ)",
          "ja": "本当に来たんですネ",
          "tc": "您真的來了啊，",
          "sc": "您真的来了啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 450496,
          "spk": "今野 (コンノ)",
          "ja": "こんばんはァ",
          "tc": "您好啊。",
          "sc": "您好啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 450507,
          "spk": "今野 (コンノ)",
          "ja": "この部屋で寝たことがある人は",
          "tc": "在這個房間住過的人",
          "sc": "在这个房间住过的人"
        },
        {
          "f_idx": 4,
          "pidx_tc": 450514,
          "spk": "今野 (コンノ)",
          "ja": "ワタシ以外だと幼い頃の",
          "tc": "除了我之外，",
          "sc": "除了我之外，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 450521,
          "spk": "今野 (コンノ)",
          "ja": "リンさんくらいでしてねェ",
          "tc": "就只有小時候的林小姐了。",
          "sc": "就只有小时候的林小姐呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 450532,
          "spk": "今野 (コンノ)",
          "ja": "そのリンさんも成長してからは",
          "tc": "林小姐在長大之後",
          "sc": "林小姐在长大之后"
        },
        {
          "f_idx": 7,
          "pidx_tc": 450539,
          "spk": "今野 (コンノ)",
          "ja": "ギラギラすぎて落ち着かないと",
          "tc": "就開始抱怨說房間太金光閃閃，",
          "sc": "就开始抱怨说房间太金光闪闪，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 450546,
          "spk": "今野 (コンノ)",
          "ja": "文句を言うようになりましてネ",
          "tc": "讓她坐立難安。",
          "sc": "让她坐立难安。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 450557,
          "spk": "今野 (コンノ)",
          "ja": "以降はずっと一人で",
          "tc": "所以後來我一直都是",
          "sc": "所以后来我一直都是"
        },
        {
          "f_idx": 10,
          "pidx_tc": 450564,
          "spk": "今野 (コンノ)",
          "ja": "寝ているんですヨ",
          "tc": "自己一個人睡。",
          "sc": "自己一个人睡哟～。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 450575,
          "spk": "今野 (コンノ)",
          "ja": "ギラギラだの落ち着かないだの",
          "tc": "什麼金光閃閃、坐立難安，",
          "sc": "什么金光闪闪、坐立难安，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 450582,
          "spk": "今野 (コンノ)",
          "ja": "リンさんもおかしなことを",
          "tc": "林小姐講這話",
          "sc": "林小姐讲这话"
        },
        {
          "f_idx": 13,
          "pidx_tc": 450589,
          "spk": "今野 (コンノ)",
          "ja": "言いますよねェ",
          "tc": "真是奇怪。",
          "sc": "真是奇怪呐～。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 450600,
          "spk": "今野 (コンノ)",
          "ja": "高級品ばかりに囲まれているんですから",
          "tc": "像這樣子被高級品包圍著，",
          "sc": "像这样子被高级品包围着，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 450607,
          "spk": "今野 (コンノ)",
          "ja": "言わば美術館で眠るようなものですヨ？",
          "tc": "換言之就像是在美術館睡覺啊，",
          "sc": "换言之就像是在美术馆睡觉啊，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 450614,
          "spk": "今野 (コンノ)",
          "ja": "格別の体験じゃないですかねェ",
          "tc": "您不覺得這是很特別的體驗嗎？",
          "sc": "您不觉得这是很特别的体验吗？"
        }
      ]
    },
