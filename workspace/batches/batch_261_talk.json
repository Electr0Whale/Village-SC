      "rec_id": "TALK_ID_70_2090_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451258,
          "spk": "今野 (コンノ)",
          "ja": "話したところで",
          "tc": "即便找人訴說，",
          "sc": "即便找人诉说，"
