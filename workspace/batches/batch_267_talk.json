        {
          "f_idx": 6,
          "pidx_tc": 434637,
          "spk": "裕太 (ユータ)",
          "ja": "たまに、探してしまうんだ",
          "tc": "這種時候就會出來找那間房子。",
          "sc": "这种时候就会出来找那间房子。"
        },
