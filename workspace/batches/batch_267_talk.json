  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7596,
      "rec_id": "TALK_ID_70_2120_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 432766,
          "spk": "驹子 (コマコ)",
          "ja": "鳥を見つけると嬉しくなって",
          "tc": "你每次一看到鳥就會太開心，",
          "sc": "你每次一看到鸟就会太开心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 432773,
          "spk": "驹子 (コマコ)",
          "ja": "声を出しちゃうんだよね",
          "tc": "不小心叫出來呢。",
          "sc": "不小心叫出来呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 432786,
          "spk": "裕太 (ユータ)",
          "ja": "どうしたらいいんだろうな……",
          "tc": "到底該怎麼辦才好呢……",
          "sc": "到底该怎么办才好呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 432793,
          "spk": "裕太 (ユータ)",
          "ja": "多分、鳥に慣れちゃえば",
          "tc": "我是在想，只要我習慣了鳥的存在，",
          "sc": "我是在想，只要我习惯了鸟的存在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 432800,
          "spk": "裕太 (ユータ)",
          "ja": "声は出なくなると思うんだけど",
          "tc": "那我應該就不會叫出聲音了吧。",
          "sc": "那我应该就不会叫出声音了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 432813,
          "spk": "驹子 (コマコ)",
          "ja": "うーん……鳥が",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 432820,
          "spk": "驹子 (コマコ)",
          "ja": "もっと身近な存在に",
          "tc": "是不是只要多多接觸鳥類",
          "sc": "是不是只要多多接触鸟类"
        },
        {
          "f_idx": 7,
          "pidx_tc": 432827,
          "spk": "驹子 (コマコ)",
          "ja": "なればいいのかな？",
          "tc": "就行了呢？",
          "sc": "就行了呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 432840,
          "spk": "裕太 (ユータ)",
          "ja": "前に、そう思って家の裏に",
          "tc": "我之前也是這麼想，",
          "sc": "我之前也是这么想，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 432847,
          "spk": "裕太 (ユータ)",
          "ja": "バードフィーダーをＤＩＹして",
          "tc": "所以曾經自製了餵鳥器，",
          "sc": "所以曾经自制了喂鸟器，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 432854,
          "spk": "裕太 (ユータ)",
          "ja": "設置したことがあるんだ",
          "tc": "放在了我家後院。",
          "sc": "放在了我家后院。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 432867,
          "spk": "驹子 (コマコ)",
          "ja": "ばーどふぃー……？",
          "tc": "餵鳥器……？",
          "sc": "喂鸟器……？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 432880,
          "spk": "裕太 (ユータ)",
          "ja": "だけど、畑の野菜の芽を",
          "tc": "但是牠們卻把我田裡的蔬菜嫩芽",
          "sc": "但是它们却把我田里的蔬菜嫩芽"
        },
        {
          "f_idx": 13,
          "pidx_tc": 432887,
          "spk": "裕太 (ユータ)",
          "ja": "鳥に根こそぎ食べられちゃってね",
          "tc": "吃得一乾二淨，",
          "sc": "吃得一干二净，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 432894,
          "spk": "裕太 (ユータ)",
          "ja": "うちの近くで観察するのは諦めたよ",
          "tc": "所以我就放棄在家附近賞鳥了。",
          "sc": "所以我就放弃在家附近赏鸟了。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 432907,
          "spk": "驹子 (コマコ)",
          "ja": "そんなに鳥が見たいなんて",
          "tc": "竟然這麼想要賞鳥，",
          "sc": "竟然这么想要赏鸟，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 432914,
          "spk": "驹子 (コマコ)",
          "ja": "ユータさんは鳥が好きなんだね",
          "tc": "看來裕太哥真的很喜歡鳥呢。",
          "sc": "看来裕太哥真的很喜欢鸟呢。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 432927,
          "spk": "裕太 (ユータ)",
          "ja": "好きだし、ゆくゆくは野鳥をスケッチして",
          "tc": "很喜歡喔，我還計劃以後要來畫一些野鳥素描，",
          "sc": "很喜欢哦，我还计划以后要来画一些野鸟素描，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 432934,
          "spk": "裕太 (ユータ)",
          "ja": "色を塗った絵を完成させたいかな",
          "tc": "然後上色完成整幅畫。",
          "sc": "然后上色完成整幅画。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 432952,
          "spk": "裕太 (ユータ)",
          "ja": "部屋のあちこちに野鳥の絵を貼って、",
          "tc": "只要在房間裡到處貼滿野鳥的畫，",
          "sc": "只要在房间里到处贴满野鸟的画，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 432959,
          "spk": "裕太 (ユータ)",
          "ja": "室内にいながらバードウォッチング気分を",
          "tc": "就能在室內享受賞鳥的樂趣了。",
          "sc": "就能在室内享受赏鸟的乐趣了。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 432966,
          "spk": "裕太 (ユータ)",
          "ja": "味わえるなんていいと思わない？",
          "tc": "你們不覺得這樣很不錯嗎？",
          "sc": "你们不觉得这样很不错吗？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 432979,
          "spk": "驹子 (コマコ)",
          "ja": "わあ、素敵な夢だと思う",
          "tc": "哇，好棒的夢想！",
          "sc": "哇，好棒的梦想！"
        },
        {
          "f_idx": 24,
          "pidx_tc": 432986,
          "spk": "驹子 (コマコ)",
          "ja": "普段はどんな絵を描くの？",
          "tc": "裕太哥平常都會畫些什麼呢？",
          "sc": "裕太哥平常都会画些什么呢？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 432999,
          "spk": "裕太 (ユータ)",
          "ja": "絵を描いたのは、",
          "tc": "我最後一次畫畫，",
          "sc": "我最后一次画画，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 433006,
          "spk": "裕太 (ユータ)",
          "ja": "中学の美術の授業が最後だったかな",
          "tc": "應該是在國中的美術課吧。",
          "sc": "应该是在国中的美术课吧。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 433013,
          "spk": "裕太 (ユータ)",
          "ja": "",
          "tc": "國中的美術課吧。",
          "sc": "国中的美术课吧。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 433024,
          "spk": "裕太 (ユータ)",
          "ja": "美術の評価は１だったけど、",
          "tc": "雖然我美術的分數只有1，",
          "sc": "虽然我美术的分数只有1，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 433031,
          "spk": "裕太 (ユータ)",
          "ja": "僕の色彩センスが先生には",
          "tc": "但我想那應該是因為我配色的品味",
          "sc": "但我想那应该是因为我配色的品味"
        },
        {
          "f_idx": 30,
          "pidx_tc": 433038,
          "spk": "裕太 (ユータ)",
          "ja": "合わなかったんだろうね",
          "tc": "跟老師不太合的緣故吧。",
          "sc": "跟老师不太合的缘故吧。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 433051,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そうなんだ……",
          "tc": "這、這樣啊……",
          "sc": "这、这样啊……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 433064,
          "spk": "裕太 (ユータ)",
          "ja": "もちろん、絵の勉強をする日を",
          "tc": "我當然也覺得",
          "sc": "我当然也觉得"
        },
        {
          "f_idx": 33,
          "pidx_tc": 433071,
          "spk": "裕太 (ユータ)",
          "ja": "作らなくちゃいけないと思ってるよ",
          "tc": "應該要找時間練習畫畫。",
          "sc": "应该要找时间练习画画。"
        },
        {
          "f_idx": 35,
          "pidx_tc": 433089,
          "spk": "裕太 (ユータ)",
          "ja": "でも、虫取りの日も作りたいし",
          "tc": "但我也想找時間去捉昆蟲，",
          "sc": "但我也想找时间去捉昆虫，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 433096,
          "spk": "裕太 (ユータ)",
          "ja": "コーヒー豆の好みの焙煎を",
          "tc": "也想研究一下",
          "sc": "也想研究一下"
        },
        {
          "f_idx": 37,
          "pidx_tc": 433103,
          "spk": "裕太 (ユータ)",
          "ja": "追求する日も作りたいんだよね",
          "tc": "自己喜歡怎樣的咖啡豆烘焙法。",
          "sc": "自己喜欢怎样的咖啡豆烘焙法。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7597,
      "rec_id": "TALK_ID_70_2120_001_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433123,
          "spk": "裕太 (ユータ)",
          "ja": "時間がいくらあっても足りないよ",
          "tc": "時間再多都不夠用啊，",
          "sc": "时间再多都不够用啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433130,
          "spk": "裕太 (ユータ)",
          "ja": "もちろん<player>と",
          "tc": "更不用說我也想找時間",
          "sc": "更不用说我也想找时间"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433137,
          "spk": "裕太 (ユータ)",
          "ja": "遊ぶ時間だって欲しいしね",
          "tc": "跟<player>一起玩了。",
          "sc": "跟<player>一起玩了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 433148,
          "spk": "裕太 (ユータ)",
          "ja": "でも今日はバードウォッチングの",
          "tc": "不過今天是我賞鳥的日子，",
          "sc": "不过今天是我赏鸟的日子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 433155,
          "spk": "裕太 (ユータ)",
          "ja": "日だから、また遊ぼうよ",
          "tc": "所以我們改天再一起玩吧。",
          "sc": "所以我们改天再一起玩吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7598,
      "rec_id": "TALK_ID_70_2120_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433173,
          "spk": "裕太 (ユータ)",
          "ja": "よーし、もっと",
          "tc": "好了，",
          "sc": "好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433180,
          "spk": "裕太 (ユータ)",
          "ja": "鳥を見つけるぞ",
          "tc": "來繼續找更多鳥吧！",
          "sc": "来继续找更多鸟吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7599,
      "rec_id": "TALK_ID_70_2120_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433208,
          "spk": "木助 (キスケ)",
          "ja": "二度と敷居をまたぐなって言っただろ",
          "tc": "我不是跟你說過，不准你再踏入我職場半步了嗎？",
          "sc": "我不是跟你说过，不准你再踏入我职场半步了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433221,
          "spk": "裕太 (ユータ)",
          "ja": "でも前より上達したと思うんだ",
          "tc": "但是我覺得我比以前進步了很多呢。",
          "sc": "但是我觉得我比以前进步了很多呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433232,
          "spk": "裕太 (ユータ)",
          "ja": "見てよ、これ",
          "tc": "你看看這個，",
          "sc": "你看看这个，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 433239,
          "spk": "裕太 (ユータ)",
          "ja": "デスク用のブックシェルフ",
          "tc": "這是桌上型書架。",
          "sc": "这是桌上型书架。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7600,
      "rec_id": "TALK_ID_70_2120_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433257,
          "spk": "裕太 (ユータ)",
          "ja": "どう？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433264,
          "spk": "裕太 (ユータ)",
          "ja": "いい出来でしょ？",
          "tc": "做得很好吧？",
          "sc": "做得很好吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433277,
          "spk": "木助 (キスケ)",
          "ja": "どこがだ",
          "tc": "哪裡好？",
          "sc": "哪里好？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 433288,
          "spk": "木助 (キスケ)",
          "ja": "水平器使わなくても",
          "tc": "就算不用水平儀，",
          "sc": "就算不用水平仪，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 433295,
          "spk": "木助 (キスケ)",
          "ja": "ガタついてんのが",
          "tc": "我也一眼就看得出",
          "sc": "我也一眼就看得出"
        },
        {
          "f_idx": 5,
          "pidx_tc": 433302,
          "spk": "木助 (キスケ)",
          "ja": "丸わかりじゃねぇか",
          "tc": "它根本就不穩！",
          "sc": "它根本就不稳！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 433315,
          "spk": "裕太 (ユータ)",
          "ja": "えっ……そうかな？",
          "tc": "咦……是這樣嗎？",
          "sc": "咦……是这样吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 433328,
          "spk": "木助 (キスケ)",
          "ja": "わかったら帰れ",
          "tc": "知道了就快滾，",
          "sc": "知道了就快滚，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 433335,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "先走啦。",
          "sc": "先走啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7601,
      "rec_id": "TALK_ID_70_2120_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433357,
          "spk": "裕太 (ユータ)",
          "ja": "そんな……",
          "tc": "怎麼這樣……",
          "sc": "怎么这样……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433364,
          "spk": "裕太 (ユータ)",
          "ja": "自信あったのにな……",
          "tc": "我明明很有自信的說……",
          "sc": "我明明很有自信的说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7602,
      "rec_id": "TALK_ID_70_2120_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433388,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433395,
          "spk": "裕太 (ユータ)",
          "ja": "このブックシェルフ",
          "tc": "你覺得這個書架",
          "sc": "你觉得这个书架"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433402,
          "spk": "裕太 (ユータ)",
          "ja": "ガタついて見える？",
          "tc": "看起來很不穩嗎？",
          "sc": "看起来很不稳吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7603,
      "rec_id": "TALK_ID_70_2120_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433420,
          "spk": "裕太 (ユータ)",
          "ja": "はあ……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433427,
          "spk": "裕太 (ユータ)",
          "ja": "そうか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433438,
          "spk": "裕太 (ユータ)",
          "ja": "先輩の役に立ちたいのに",
          "tc": "我很想幫學長的忙，",
          "sc": "我很想帮学长的忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 433445,
          "spk": "裕太 (ユータ)",
          "ja": "上手くいかないな",
          "tc": "卻一直都做不好。",
          "sc": "却一直都做不好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7604,
      "rec_id": "TALK_ID_70_2120_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 433470,
          "spk": "裕太 (ユータ)",
          "ja": "あ、そうか",
          "tc": "啊，對喔，",
          "sc": "啊，对哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 433477,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんと説明したことって",
          "tc": "我好像還沒跟你",
          "sc": "我好像还没跟你"
        },
        {
          "f_idx": 2,
          "pidx_tc": 433484,
          "spk": "裕太 (ユータ)",
          "ja": "なかったかもね",
          "tc": "好好說明過呢。",
          "sc": "好好说明过呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 433495,
          "spk": "裕太 (ユータ)",
          "ja": "キスケさんは",
          "tc": "木助學長",
          "sc": "木助学长"
        },
        {
