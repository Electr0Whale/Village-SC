      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434587,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっとね……",
          "tc": "其實……",
          "sc": "其实……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434594,
          "spk": "裕太 (ユータ)",
          "ja": "あの廃屋を探してたんだ",
          "tc": "我在找那間廢棄屋子。",
