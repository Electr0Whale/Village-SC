          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7615,
      "rec_id": "TALK_ID_70_2120_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434412,
          "spk": "裕太 (ユータ)",
          "ja": "あっ……ごめん",
          "tc": "啊……抱歉，",
          "sc": "啊……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434419,
          "spk": "裕太 (ユータ)",
          "ja": "悩ませちゃったか",
          "tc": "我是不是讓你很困擾？",
          "sc": "我是不是让你很困扰？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 434430,
          "spk": "裕太 (ユータ)",
          "ja": "こういう話って",
          "tc": "這種話題，",
          "sc": "这种话题，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 434437,
          "spk": "裕太 (ユータ)",
          "ja": "ねだるものじゃないよね",
          "tc": "的確不應該去要求別人說出口呢，",
          "sc": "的确不应该去要求别人说出口呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 434444,
          "spk": "裕太 (ユータ)",
          "ja": "ごめんごめん",
          "tc": "抱歉抱歉。",
          "sc": "抱歉抱歉。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 434455,
          "spk": "裕太 (ユータ)",
          "ja": "俺があんまり自然に話せたから",
          "tc": "都是因為我自己輕輕鬆鬆地就說出來了，",
