      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 418319,
          "spk": "名护 (ナゴ)",
          "ja": "そうそう",
          "tc": "沒錯，",
          "sc": "没错，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 418326,
          "spk": "名护 (ナゴ)",
          "ja": "全体的な流れを",
          "tc": "必須掌握整體的脈絡，",
          "sc": "必须掌握整体的脉络，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 418333,
          "spk": "名护 (ナゴ)",
          "ja": "把握することが、大事なんだ",
          "tc": "這點很重要。",
          "sc": "这点很重要。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 418346,
          "spk": "堇怜 (スミレ)",
          "ja": "はい、単に暗記するんじゃなくて",
          "tc": "我知道了，所以不能死背，",
          "sc": "我知道了，所以不能死背，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 418353,
          "spk": "堇怜 (スミレ)",
          "ja": "その成り立ちを理解して……",
          "tc": "而是要理解前因後果……",
          "sc": "而是要理解前因后果……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 418366,
          "spk": "洋 (ヨウ)",
          "ja": "ナゴさん、こっちの字は",
          "tc": "名護叔叔，",
          "sc": "名护叔叔，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 418373,
          "spk": "洋 (ヨウ)",
          "ja": "なんて読むの？",
          "tc": "這個字要怎麼念？",
          "sc": "这个字要怎么念？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7461,
      "rec_id": "TALK_ID_70_2100_006_02",
      "lines": [
        {
