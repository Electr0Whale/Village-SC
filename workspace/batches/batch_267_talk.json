    {
      "file": "talk.dat",
      "rec_idx": 7614,
      "rec_id": "TALK_ID_70_2120_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434229,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、こういう話をすると",
          "tc": "對了，我曾經聽說過，",
          "sc": "对了，我曾经听说过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 434236,
          "spk": "裕太 (ユータ)",
          "ja": "相手に親近感が湧きやすいって",
          "tc": "聊這種話題，",
          "sc": "聊这种话题，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 434243,
          "spk": "裕太 (ユータ)",
          "ja": "聞いたことがあるよ",
          "tc": "很容易就能跟對方拉近距離。",
          "sc": "很容易就能跟对方拉近距离。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 434254,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだからさ",
          "tc": "機會難得，",
          "sc": "机会难得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 434261,
          "spk": "裕太 (ユータ)",
          "ja": "俺、キミの話も",
          "tc": "我也想聽你說說",
          "sc": "我也想听你说说"
        },
        {
          "f_idx": 5,
          "pidx_tc": 434268,
          "spk": "裕太 (ユータ)",
          "ja": "聞いてみたいな",
          "tc": "關於你自己的事。",
          "sc": "关于你自己的事。"
