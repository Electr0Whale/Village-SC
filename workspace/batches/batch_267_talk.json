          "spk": "裕太 (ユータ)",
          "ja": "ちょっとテンション上がっちゃって",
          "tc": "所以才有點興奮。",
          "sc": "所以才有点兴奋。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 434471,
          "spk": "裕太 (ユータ)",
          "ja": "無理にひねり出さなくて",
          "tc": "你不用勉強你自己的，",
          "sc": "你不用勉强你自己的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 434478,
          "spk": "裕太 (ユータ)",
          "ja": "いいからさ、気にしないでよ",
          "tc": "別放在心上喔。",
          "sc": "别放在心上哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 434489,
          "spk": "裕太 (ユータ)",
          "ja": "とにかく、俺が言いたかったのは",
          "tc": "總之，我想表達的是，",
          "sc": "总之，我想表达的是，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 434496,
          "spk": "裕太 (ユータ)",
          "ja": "キミともっと仲良くしたいって",
          "tc": "我希望我可以",
          "sc": "我希望我可以"
        },
        {
          "f_idx": 11,
          "pidx_tc": 434503,
          "spk": "裕太 (ユータ)",
          "ja": "思ったってことなんだ",
          "tc": "跟你變得更要好。",
          "sc": "跟你变得更要好。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 434514,
          "spk": "裕太 (ユータ)",
          "ja": "俺の家なら、いつ来てくれてもいいからさ",
          "tc": "我家的大門隨時都會為你敞開，",
          "sc": "我家的大门随时都会为你敞开，"
