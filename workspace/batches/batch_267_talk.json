        {
          "f_idx": 13,
          "pidx_tc": 434521,
          "spk": "裕太 (ユータ)",
          "ja": "これからは、もっと気軽に遊びにおいでよ",
          "tc": "以後記得要常常來找我玩喔。",
          "sc": "以后记得要常常来找我玩哦。"
        }
      ]
    },
