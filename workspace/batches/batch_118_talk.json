      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42084,
          "spk": "驹子 (コマコ)",
          "ja": "この数字、なんだろ……？",
          "tc": "這個數字是什麼呢……？",
          "sc": "这个数字是什么呢……？"
