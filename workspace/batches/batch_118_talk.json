          "pidx_tc": 42349,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42356,
