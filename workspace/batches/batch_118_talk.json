        },
        {
          "f_idx": 2,
          "pidx_tc": 42503,
          "spk": "驹子 (コマコ)",
          "ja": "バテないためにも、早くお休みしたほうがいいよ",
          "tc": "最好早點休息才不會累壞喔。",
          "sc": "最好早点休息才不会累坏哦。"
        }
