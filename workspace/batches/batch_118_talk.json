      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42433,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>……",
          "tc": "啊，<player>……",
          "sc": "啊，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42440,
          "spk": "驹子 (コマコ)",
          "ja": "こんな時間に来てくれたんだね",
          "tc": "你在這個時間來了呢。",
          "sc": "你在这个时间来了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42451,
          "spk": "驹子 (コマコ)",
          "ja": "嬉しいんだけど……",
          "tc": "雖然我是很開心……",
          "sc": "虽然我是很开心……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42458,
          "spk": "驹子 (コマコ)",
          "ja": "リンにバレたら怒られちゃうよ？",
          "tc": "但被林知道了，會被罵喔。",
          "sc": "但被林知道了，会被骂哦。"
