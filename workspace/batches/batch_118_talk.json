      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 41990,
          "spk": "驹子 (コマコ)",
          "ja": "葉っぱがたくさん落ちてるね",
          "tc": "滿地都是落葉呢，",
          "sc": "满地都是落叶呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 41997,
          "spk": "驹子 (コマコ)",
          "ja": "明日は焼き芋でもしようかな？",
          "tc": "明天來烤地瓜好了。",
          "sc": "明天来烤红薯好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42015,
          "spk": "驹子 (コマコ)",
          "ja": "せっかくだから、みんなも誘って",
          "tc": "機會難得，乾脆約大家",
          "sc": "机会难得，干脆约大家"
        },
        {
          "f_idx": 4,
          "pidx_tc": 42022,
          "spk": "驹子 (コマコ)",
          "ja": "お芋パーティしようかな！",
          "tc": "一起開烤地瓜派對吧！",
          "sc": "一起开烤红薯派对吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1116,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42046,
          "spk": "驹子 (コマコ)",
          "ja": "そうだ、スミレくんから",
          "tc": "對了，堇怜約我",
          "sc": "对了，堇怜约我"
