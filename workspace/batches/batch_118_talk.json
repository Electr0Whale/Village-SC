      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42175,
          "spk": "驹子 (コマコ)",
          "ja": "いつの間にか、保管庫が",
          "tc": "不知不覺間，儲藏室裡面",
          "sc": "不知不觉间，储藏室里面"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42182,
          "spk": "驹子 (コマコ)",
          "ja": "狩った獲物でいっぱいになってたんだ",
          "tc": "已經堆了大量的獵物。",
          "sc": "已经堆了大量的猎物。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 42200,
          "spk": "驹子 (コマコ)",
          "ja": "やっぱり実りの秋ってことかな？",
          "tc": "果然是所謂「豐收之秋」嗎？",
          "sc": "果然是所谓“丰收之秋”吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 42207,
          "spk": "驹子 (コマコ)",
          "ja": "たくさん獲れるからって、",
          "tc": "雖然是大豐收，",
          "sc": "虽然是大丰收，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 42214,
          "spk": "驹子 (コマコ)",
          "ja": "やりすぎには気をつけないと……",
          "tc": "也得注意不要過頭了……",
          "sc": "也得注意不要过头了……"
        }
      ]
    },
    {
      "file": "talk.dat",
