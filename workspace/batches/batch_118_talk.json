      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42565,
          "spk": "驹子 (コマコ)",
          "ja": "今日は涼しくて過ごしやすいね",
          "tc": "今天很涼爽，溫度滿舒適的。",
