      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42391,
          "spk": "驹子 (コマコ)",
          "ja": "そろそろ風が冷たくなってきたね",
          "tc": "風漸漸開始變冷了呢。",
          "sc": "风渐渐开始变冷了呢。"
