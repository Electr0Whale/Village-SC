      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42133,
          "spk": "驹子 (コマコ)",
          "ja": "これは今度キスケさんに",
          "tc": "這是下次要送去",
          "sc": "这是下次要送去"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42140,
          "spk": "驹子 (コマコ)",
          "ja": "届けにいくやつで……",
          "tc": "給木助哥的……",
          "sc": "给木助哥的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42151,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、今日だったかな……？",
          "tc": "奇怪？還是說是今天……？",
          "sc": "奇怪？还是说是今天……？"
        }
      ]
    },
    {
