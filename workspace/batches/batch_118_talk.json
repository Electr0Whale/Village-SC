        {
          "f_idx": 2,
          "pidx_tc": 42318,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんと命に感謝しなくちゃね",
          "tc": "我要好好感謝這些生命才行。",
          "sc": "我要好好感谢这些生命才行。"
        }
      ]
    },
    {
