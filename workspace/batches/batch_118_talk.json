      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_3210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 42238,
          "spk": "驹子 (コマコ)",
          "ja": "道具の手入れなら私もできるけど、",
          "tc": "雖然保養工具我也做得到，",
          "sc": "虽然保养工具我也做得到，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 42245,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんのほうがもっと上手なんだよ",
          "tc": "但還是哥哥比較厲害喔。",
          "sc": "但还是哥哥比较厉害哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
