        {
          "f_idx": 1,
          "pidx_tc": 42053,
          "spk": "驹子 (コマコ)",
          "ja": "今度お月見しようって誘われたんだった",
          "tc": "下次一起去賞月，",
          "sc": "下次一起去赏月，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 42060,
          "spk": "驹子 (コマコ)",
          "ja": "お団子作る準備しておかなくちゃ",
          "tc": "我得開始準備製作糰子了。",
          "sc": "我得开始准备制作团子了。"
        }
      ]
    },
    {
