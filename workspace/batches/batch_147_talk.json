  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2650,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95929,
          "spk": "堇怜 (スミレ)",
          "ja": "今年はどれを最初に食べようかな～！",
          "tc": "今年要從哪個開始吃呢～？",
          "sc": "今年要从哪个开始吃呢～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95940,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95951,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も食べたいもの決めておきなよ",
          "tc": "你也先選好想吃的東西比較好。",
          "sc": "你也先选好想吃的东西比较好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95958,
          "spk": "堇怜 (スミレ)",
          "ja": "人気なものはすぐなくなっちゃうんだから！",
          "tc": "受歡迎的東西可是轉眼間就會被吃光！",
          "sc": "受欢迎的东西可是转眼间就会被吃光！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2651,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95989,
          "spk": "堇怜 (スミレ)",
          "ja": "このおかずも美味いや",
          "tc": "這道菜也好好吃喔。",
          "sc": "这道菜也好好吃哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95996,
          "spk": "堇怜 (スミレ)",
          "ja": "めいっぱいお腹空かせてきてよかった！",
          "tc": "還好我有空著肚子來！",
          "sc": "还好我有空着肚子来！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96007,
          "spk": "堇怜 (スミレ)",
          "ja": "花見は美味いものをたくさん",
          "tc": "我很喜歡賞花，",
          "sc": "我很喜欢赏花，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96014,
          "spk": "堇怜 (スミレ)",
          "ja": "食べられるから好きなんだよね",
          "tc": "因為能吃到很多好吃的東西呢。",
          "sc": "因为能吃到很多好吃的东西呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96021,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>もいい日だって思わない？",
          "tc": "<player>不覺得這是個很棒的日子嗎？",
          "sc": "<player>不觉得这是个很棒的日子吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96032,
          "spk": "堇怜 (スミレ)",
          "ja": "もちろん、桜も見てるよ",
          "tc": "當然了，我也有在看櫻花喔。",
          "sc": "当然了，我也有在看樱花哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96039,
          "spk": "堇怜 (スミレ)",
          "ja": "みんなで賑やかに過ごすのも好きだし……",
          "tc": "而且我也很喜歡大家一起熱鬧地度過……",
          "sc": "而且我也很喜欢大家一起热闹地度过……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 96046,
          "spk": "堇怜 (スミレ)",
          "ja": "いっそのこと、ずっと春だったらいいのにな",
          "tc": "要是能一直都是春天就好了。",
          "sc": "要是能一直都是春天就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2652,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96070,
          "spk": "堇怜 (スミレ)",
          "ja": "日が落ちてもまだちょっと暑いな…",
          "tc": "即使太陽下山了也還是有點熱……",
          "sc": "即使太阳下山了也还是有点热……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96077,
          "spk": "堇怜 (スミレ)",
          "ja": "屋台の灯りって結構強いし、",
          "tc": "路邊攤的燈光也滿亮的，",
          "sc": "路边摊的灯光也满亮的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96084,
          "spk": "堇怜 (スミレ)",
          "ja": "そのせいかな？",
          "tc": "會是這個原因嗎？",
          "sc": "会是这个原因吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96095,
          "spk": "堇怜 (スミレ)",
          "ja": "お、<player>",
          "tc": "哦，<player>，",
          "sc": "哦，<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96102,
          "spk": "堇怜 (スミレ)",
          "ja": "こんばんは",
          "tc": "你好啊。",
          "sc": "你好啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96113,
          "spk": "堇怜 (スミレ)",
          "ja": "きっともうすぐ始まるよ",
          "tc": "我想已經要開始囉。",
          "sc": "我想马上就要开始啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96120,
          "spk": "堇怜 (スミレ)",
          "ja": "リンに聞いてくるといいんじゃない？",
          "tc": "你去問問林吧？",
          "sc": "你去问问林吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2653,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96144,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、お祭り楽しんでる？",
          "tc": "<player>，你在這祭典玩得還開心嗎？",
          "sc": "<player>，你在这祭典玩得还开心吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96151,
          "spk": "堇怜 (スミレ)",
          "ja": "お祭りは楽しいものも美味いものも",
          "tc": "祭典有各種好玩跟好吃的東西，",
          "sc": "祭典有各种好玩跟好吃的东西，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96158,
          "spk": "堇怜 (スミレ)",
          "ja": "たくさん集まってるから最高だよ",
          "tc": "所以真的很棒。",
          "sc": "所以真的很棒。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96169,
          "spk": "堇怜 (スミレ)",
          "ja": "いろいろありすぎてかえって",
          "tc": "選擇太多了，",
          "sc": "选择太多了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96176,
          "spk": "堇怜 (スミレ)",
          "ja": "何をしたらいいのか迷うんだけど……",
          "tc": "會讓人很猶豫該怎麼辦……",
          "sc": "会让人很犹豫该怎么办……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96183,
          "spk": "堇怜 (スミレ)",
          "ja": "お小遣いには限りがあるしね",
          "tc": "畢竟零用錢也是有限的嘛。",
          "sc": "毕竟零用钱也是有限的嘛。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96194,
          "spk": "堇怜 (スミレ)",
          "ja": "射的で一発いい賞品を狙ってみる？",
          "tc": "要去玩射擊遊戲，試試看能不能射中好獎品呢？",
          "sc": "要去玩射击游戏，试试看能不能射中好奖品呢？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 96201,
          "spk": "堇怜 (スミレ)",
          "ja": "焼きそばをお腹いっぱい食べようかな",
          "tc": "還是去吃炒麵吃到撐呢？",
          "sc": "还是去吃炒面吃到撑呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 96208,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん、どれも楽しそうで迷うよ",
          "tc": "嗯～感覺都很不錯，好猶豫啊。",
          "sc": "嗯～感觉都很不错，好犹豫啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2654,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96232,
          "spk": "堇怜 (スミレ)",
          "ja": "んー、カボチャって重いな……",
          "tc": "嗯～南瓜真重欸……",
          "sc": "嗯～南瓜真重诶……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96239,
          "spk": "堇怜 (スミレ)",
          "ja": "というかカボチャって夏の野菜じゃ……？",
          "tc": "說起來，南瓜是夏天的蔬菜吧……？",
          "sc": "说起来，南瓜是夏天的蔬菜吧……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96250,
          "spk": "堇怜 (スミレ)",
          "ja": "まぁクリともサツマイモとも",
          "tc": "和栗子、地瓜",
          "sc": "和栗子、红薯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96257,
          "spk": "堇怜 (スミレ)",
          "ja": "相性は良いし……",
          "tc": "也很搭……",
          "sc": "也很搭……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96268,
          "spk": "堇怜 (スミレ)",
          "ja": "美味しければなんでもいいか！",
          "tc": "只要好吃的話，什麼都可以！",
          "sc": "只要好吃的话，什么都可以！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2655,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96299,
          "spk": "堇怜 (スミレ)",
          "ja": "よいしょっと……",
          "tc": "嘿咻……",
          "sc": "嘿咻……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96306,
          "spk": "堇怜 (スミレ)",
          "ja": "カボチャの中身をくり抜いてるんだ",
          "tc": "我正在挖南瓜的肉，要把裡面挖空。",
          "sc": "我正在挖南瓜的肉，要把里面挖空。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96317,
          "spk": "堇怜 (スミレ)",
          "ja": "立派なカボチャだから",
          "tc": "這顆南瓜很大顆，",
          "sc": "这颗南瓜很大颗，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96324,
          "spk": "堇怜 (スミレ)",
          "ja": "なかなかの重労働なんだよね……",
          "tc": "所以還挺費力的……",
          "sc": "所以还挺费力的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96335,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、このあとに食べる",
          "tc": "但想到等一下能吃到美味的料理，",
          "sc": "但想到等一下能吃到美味的料理，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96342,
          "spk": "堇怜 (スミレ)",
          "ja": "美味い料理のためだと思えば我慢できるよ",
          "tc": "我就能撐過去了。",
          "sc": "我就能撑过去了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96349,
          "spk": "堇怜 (スミレ)",
          "ja": "がんばって全部くり抜くぞ……！",
          "tc": "我要努力挖得一乾二淨……！",
          "sc": "我要努力挖得一干二净……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2656,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96373,
          "spk": "堇怜 (スミレ)",
          "ja": "へぇ～、今年の食材はこれを使うのか",
          "tc": "哦～要用這個當今年的食材啊。",
          "sc": "哦～要用这个当今年的食材啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96380,
          "spk": "堇怜 (スミレ)",
          "ja": "どう使うんだろう……",
          "tc": "會怎麼用呢……",
          "sc": "会怎么用呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96391,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96398,
          "spk": "堇怜 (スミレ)",
          "ja": "年末はいつもロッカクさんを手伝うって",
          "tc": "我年末都會固定",
          "sc": "我年末都会固定"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96405,
          "spk": "堇怜 (スミレ)",
          "ja": "決まってるんだ",
          "tc": "幫忙六角叔。",
          "sc": "帮忙六角叔。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96416,
          "spk": "堇怜 (スミレ)",
          "ja": "すごい勉強になるんだ！",
          "tc": "可以學到很多喔！",
          "sc": "可以学到很多哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96423,
          "spk": "堇怜 (スミレ)",
          "ja": "今日も楽しみだな",
          "tc": "今天也很令人期待呢。",
          "sc": "今天也很令人期待呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2657,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96447,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96454,
          "spk": "堇怜 (スミレ)",
          "ja": "今、そばを茹でてるんだ",
          "tc": "我正在煮蕎麥麵。",
          "sc": "我正在煮荞麦面。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96465,
          "spk": "堇怜 (スミレ)",
          "ja": "ちなみにだけど……",
          "tc": "順便問一下……",
          "sc": "顺便问一下……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96472,
          "spk": "堇怜 (スミレ)",
          "ja": "なんで年末にそばを食べるのか知ってる？",
          "tc": "你知道為什麼年末要吃蕎麥麵嗎？",
          "sc": "你知道为什么年末要吃荞麦面吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96483,
          "spk": "堇怜 (スミレ)",
          "ja": "長寿を願うためだとかいろいろ説はあるらしいよ",
          "tc": "好像有很多種說法呢，像為了是祈求長壽等等。",
          "sc": "好像有很多种说法呢，像为了是祈求长寿等等。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96490,
          "spk": "堇怜 (スミレ)",
          "ja": "みんなで美味いそばを食べて、",
          "tc": "希望大家能一起品嘗美味的蕎麥麵，",
          "sc": "希望大家能一起品尝美味的荞麦面，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 96497,
          "spk": "堇怜 (スミレ)",
          "ja": "いい年を迎えられるといいよね",
          "tc": "迎接美好的新年。",
          "sc": "迎接美好的新年。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2658,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96521,
          "spk": "堇怜 (スミレ)",
          "ja": "品評会って楽しいよね",
          "tc": "評鑑會真好玩。",
          "sc": "评鉴会真好玩。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96528,
          "spk": "堇怜 (スミレ)",
          "ja": "村の広場が普段と違う配置になってるだけで、",
          "tc": "光是村子廣場上的布置和平常不同",
          "sc": "光是村子广场上的布置和平常不同"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96535,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだかワクワクしちゃうんだ",
          "tc": "就讓人覺得很興奮。",
          "sc": "就让人觉得很兴奋。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96546,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>もせっかくなんだから、",
          "tc": "<player>也趁這個機會，",
          "sc": "<player>也趁这个机会，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96553,
          "spk": "堇怜 (スミレ)",
          "ja": "審査員のおじさんたちに作物を見てもらえば？",
          "tc": "讓評審大叔們看看你的作物吧？",
          "sc": "让评审大叔们看看你的作物吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 96560,
          "spk": "堇怜 (スミレ)",
          "ja": "次の品評会を楽しみにしてるよ",
          "tc": "我很期待下次的評鑑會喔。",
          "sc": "我很期待下次的评鉴会哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2659,
      "rec_id": "TALK_ID_BOY_HOLIDAY_20_112_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96584,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、<player>！",
          "tc": "哦，<player>！",
          "sc": "哦，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 96591,
          "spk": "堇怜 (スミレ)",
          "ja": "Sランクを獲るなんてすごいよ！",
          "tc": "你能拿到S級真是太厲害了！",
          "sc": "你能拿到S级真是太厉害了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 96602,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が育てた作物、",
          "tc": "<player>種植的作物，",
          "sc": "<player>种植的作物，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96609,
          "spk": "堇怜 (スミレ)",
          "ja": "素人の僕の目からでも",
          "tc": "即使是由我這個普通人看來",
          "sc": "即使是由我这个普通人看来"
        },
        {
          "f_idx": 4,
          "pidx_tc": 96616,
