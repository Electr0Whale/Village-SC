      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56310,
          "spk": "裕太 (ユータ)",
          "ja": "今日は品評会の日だったっけ",
