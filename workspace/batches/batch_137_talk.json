          "spk": "裕太 (ユータ)",
          "ja": "やりがいがあるだろうね",
          "tc": "也會讓人更有成就感吧。",
          "sc": "也会让人更有成就感吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2376,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56373,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も品評会を見に来てたんだね",
