        {
          "f_idx": 3,
          "pidx_tc": 56454,
          "spk": "裕太 (ユータ)",
          "ja": "今の時代どこでもやってるもんじゃないでしょ？",
          "tc": "現在這個時代，這樣的活動可不是到處都有的。",
          "sc": "现在这个时代，这样的活动可不是到处都有的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 56472,
          "spk": "裕太 (ユータ)",
          "ja": "この特別感が最高だよね",
          "tc": "這種獨特感真的很棒。",
          "sc": "这种独特感真的很棒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2378,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56503,
          "spk": "裕太 (ユータ)",
          "ja": "風に乗って、桜の花びらが",
          "tc": "櫻花隨風飄落……",
          "sc": "樱花随风飘落……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 56510,
          "spk": "裕太 (ユータ)",
          "ja": "舞い散っていくのは",
          "tc": "雖然是很美的景象，",
          "sc": "虽然是很美的景象，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 56517,
          "spk": "裕太 (ユータ)",
          "ja": "綺麗だけど、どこか切ないよね",
          "tc": "但也覺得有點感傷呢。",
          "sc": "但也觉得有点感伤呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 56528,
          "spk": "裕太 (ユータ)",
          "ja": "でも、これは終わりじゃないんだよ",
          "tc": "不過這可不是終結喔。",
          "sc": "不过这可不是终结哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 56535,
          "spk": "裕太 (ユータ)",
          "ja": "次の春に新しい芽を出すための",
          "tc": "我覺得這是為了在明年春天長出新芽，",
          "sc": "我觉得这是为了在明年春天长出新芽，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 56542,
          "spk": "裕太 (ユータ)",
          "ja": "旅立ちなんだと思う",
          "tc": "而開啟的旅程。",
          "sc": "而开启的旅程。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 56553,
          "spk": "裕太 (ユータ)",
          "ja": "だから俺は、感傷に浸るよりも",
          "tc": "所以比起沉浸在傷感中，",
          "sc": "所以比起沉浸在伤感中，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 56560,
          "spk": "裕太 (ユータ)",
          "ja": "楽しく食べて楽しく騒いで、",
          "tc": "我更想要開心吃、開心玩，",
          "sc": "我更想要开心吃、开心玩，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 56567,
          "spk": "裕太 (ユータ)",
          "ja": "めいっぱいお花見を楽しむつもりだよ",
          "tc": "盡情享受賞花的樂趣。",
          "sc": "尽情享受赏花的乐趣。"
        }
      ]
    },
    {
      "file": "talk.dat",
