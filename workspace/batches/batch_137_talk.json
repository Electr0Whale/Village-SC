        {
          "f_idx": 8,
          "pidx_tc": 56145,
          "spk": "裕太 (ユータ)",
          "ja": "大丈夫そうなら",
          "tc": "可以的話，",
          "sc": "可以的话，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 56152,
          "spk": "裕太 (ユータ)",
