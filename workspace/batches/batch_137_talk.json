        },
        {
          "f_idx": 5,
          "pidx_tc": 56120,
          "spk": "裕太 (ユータ)",
          "ja": "せっかく仲良くなったことだし、",
          "tc": "既然我們感情都這麼好了，",
          "sc": "既然我们感情都这么好了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 56127,
          "spk": "裕太 (ユータ)",
