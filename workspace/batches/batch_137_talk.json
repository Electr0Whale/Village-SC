    },
    {
      "file": "talk.dat",
      "rec_idx": 2380,
      "rec_id": "TALK_ID_YOUNG_MAN_HOLIDAY_20_111_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56654,
          "spk": "裕太 (ユータ)",
          "ja": "<player>はソーダフロートって知ってる？",
          "tc": "<player>知道冰淇淋蘇打嗎？",
          "sc": "<player>知道冰淇淋苏打吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 56661,
          "spk": "裕太 (ユータ)",
          "ja": "ソーダとアイスクリームを一緒に飲むなんて、",
          "tc": "能同時享用汽水和冰淇淋，",
          "sc": "能同时享用汽水和冰淇淋，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 56668,
          "spk": "裕太 (ユータ)",
          "ja": "なんて贅沢なデザートなんだろうね！",
          "tc": "真的是超級豪華的甜點呢！",
          "sc": "真的是超级豪华的甜点呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 56679,
          "spk": "裕太 (ユータ)",
          "ja": "一口飲んでみれば",
          "tc": "只要試喝一口，",
          "sc": "只要试喝一口，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 56686,
          "spk": "裕太 (ユータ)",
          "ja": "これがただの飲み物じゃないって",
          "tc": "應該就能發現，",
          "sc": "应该就能发现，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 56693,
          "spk": "裕太 (ユータ)",
          "ja": "わかるはずだよ",
          "tc": "這可不是普通的飲料喔！",
          "sc": "这可不是普通的饮料哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 56704,
          "spk": "裕太 (ユータ)",
          "ja": "お祭りの熱気の中で、",
          "tc": "能讓你在祭典的暑氣中，",
          "sc": "能让你在祭典的暑气中，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 56711,
          "spk": "裕太 (ユータ)",
          "ja": "涼しさを感じられるドリンク――",
          "tc": "感受到清涼的飲料──",
          "sc": "感受到清凉的饮料——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 56718,
          "spk": "裕太 (ユータ)",
          "ja": "飲む宝石と言ってもいいくらいさ",
          "tc": "說是能喝的寶石也不為過啊。",
          "sc": "说是能喝的宝石也不为过啊。"
        }
      ]
    },
