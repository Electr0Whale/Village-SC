  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2131,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82671,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、あのね、",
          "tc": "<player>，我跟你說，",
          "sc": "<player>，我跟你说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82678,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、今日初めて",
          "tc": "我今天第一次使用了",
          "sc": "我今天第一次使用了"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82685,
          "spk": "洋 (ヨウ)",
          "ja": "ミキサーっていう機械を使ったんだよ",
          "tc": "叫做調理機的機器喔。",
          "sc": "叫做调理机的机器哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82696,
          "spk": "洋 (ヨウ)",
          "ja": "中に材料を入れてスイッチを入れるだけで、",
          "tc": "只要把材料放進去，打開開關，",
          "sc": "只要把材料放进去，打开开关，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82703,
          "spk": "洋 (ヨウ)",
          "ja": "すぐにドロドロの粉々になっちゃうんだ",
          "tc": "材料馬上就會被打碎。",
          "sc": "材料马上就会被打碎。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 82721,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんは色んな料理に使うって",
          "tc": "叔叔說很多料理都會用到這台機器，",
          "sc": "叔叔说很多料理都会用到这台机器，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 82728,
          "spk": "洋 (ヨウ)",
          "ja": "言ってたけど、わたしは",
          "tc": "但我想要用來",
          "sc": "但我想要用来"
        },
        {
          "f_idx": 8,
          "pidx_tc": 82735,
          "spk": "洋 (ヨウ)",
          "ja": "ジュースを作るのに使おうと思うの",
          "tc": "做果汁。",
          "sc": "做果汁。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 82744,
          "spk": "洋 (ヨウ)",
          "ja": "フルーツをいっぱい入れて、",
          "tc": "放進滿滿的水果，",
          "sc": "放进满满的水果，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 82751,
          "spk": "洋 (ヨウ)",
          "ja": "甘くて冷たいジュースにするつもり",
          "tc": "想要做成冰冰甜甜的果汁。",
          "sc": "想要做成冰冰甜甜的果汁。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 82758,
          "spk": "洋 (ヨウ)",
          "ja": "どう？　おいしそうでしょ？",
          "tc": "怎麼樣？感覺很好喝對吧？",
          "sc": "怎么样？感觉很好喝对吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 82769,
          "spk": "洋 (ヨウ)",
          "ja": "<player>も試しにやってみる？",
          "tc": "<player>要不要也試試看？",
          "sc": "<player>要不要也试试看？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 82776,
          "spk": "洋 (ヨウ)",
          "ja": "おいしい組み合わせを見つけたら、",
          "tc": "如果你發現了好喝的配方，",
          "sc": "如果你发现了好喝的配方，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 82783,
          "spk": "洋 (ヨウ)",
          "ja": "わたしにも教えてね",
          "tc": "也要告訴我喔。",
          "sc": "也要告诉我哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2132,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82807,
          "spk": "洋 (ヨウ)",
          "ja": "今日って、なにか用事はあるの？",
          "tc": "你今天有其他事情要做嗎？",
          "sc": "你今天有其他事情要做吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82818,
          "spk": "洋 (ヨウ)",
          "ja": "もし、時間があったらでいいんだけど、",
          "tc": "如果你有空的話，",
          "sc": "如果你有空的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82825,
          "spk": "洋 (ヨウ)",
          "ja": "わたしのお家で一緒にご飯、食べたいなって",
          "tc": "我想跟你一起在我家吃飯。",
          "sc": "我想跟你一起在我家吃饭。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82836,
          "spk": "洋 (ヨウ)",
          "ja": "……ダメ、かな？",
          "tc": "……不知道可不可以？",
          "sc": "……不知道可不可以？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82843,
          "spk": "洋 (ヨウ)",
          "ja": "もちろん、無理に誘うつもりはなくて",
          "tc": "當然我不會強迫你一定要來。",
          "sc": "当然我不会强迫你一定要来。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 82854,
          "spk": "洋 (ヨウ)",
          "ja": "本当に、時間があったらでいいの",
          "tc": "真的有空的話再來就可以了。",
          "sc": "真的有空的话再来就可以了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 82861,
          "spk": "洋 (ヨウ)",
          "ja": "どうかな？　来てくれる……？",
          "tc": "怎麼樣？你要來嗎……？",
          "sc": "怎么样？你要来吗……？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 82877,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 82884,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2133,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82902,
          "spk": "洋 (ヨウ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82909,
          "spk": "洋 (ヨウ)",
          "ja": "それじゃあ、お家で待ってるね",
          "tc": "那我在家裡等你喔。",
          "sc": "那我在家里等你哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82920,
          "spk": "洋 (ヨウ)",
          "ja": "午後６時くらいに来てくれれば、",
          "tc": "大概晚上6點左右過來就好，",
          "sc": "大概晚上6点左右过来就好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82927,
          "spk": "洋 (ヨウ)",
          "ja": "準備もできてると思うから",
          "tc": "我想到時我應該也準備好了。",
          "sc": "我想到时我应该也准备好了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82934,
          "spk": "洋 (ヨウ)",
          "ja": "楽しみにしてるね",
          "tc": "我很期待喔。",
          "sc": "我很期待哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2134,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 82956,
          "spk": "洋 (ヨウ)",
          "ja": "あ、そっか……",
          "tc": "啊，這樣啊……",
          "sc": "啊，这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 82963,
          "spk": "洋 (ヨウ)",
          "ja": "忙しいなら、しょうがないよね",
          "tc": "你很忙的話，那就沒辦法了。",
          "sc": "你很忙的话，那就没办法了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 82974,
          "spk": "洋 (ヨウ)",
          "ja": "ごめんね、<player>",
          "tc": "對不起，<player>，",
          "sc": "对不起，<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 82981,
          "spk": "洋 (ヨウ)",
          "ja": "無理なこと言っちゃって",
          "tc": "對你說了無理的要求。",
          "sc": "对你说了无理的要求。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 82988,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、また今度、ね",
          "tc": "那就下次再說吧。",
          "sc": "那就下次再说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2135,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83012,
          "spk": "洋 (ヨウ)",
          "ja": "あ、あのね、<player>",
          "tc": "那、那個，<player>。",
          "sc": "那、那个，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83019,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとお願いがあって……",
          "tc": "我有事情想拜託你……",
          "sc": "我有事情想拜托你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83030,
          "spk": "洋 (ヨウ)",
          "ja": "今日の夜、よかったら",
          "tc": "今天晚上如果可以的話，",
          "sc": "今天晚上如果可以的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83037,
          "spk": "洋 (ヨウ)",
          "ja": "わたしのお家でお泊り会したいなって",
          "tc": "我想邀請你到我家來住一晚。",
          "sc": "我想邀请你到我家来住一晚。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 83048,
          "spk": "洋 (ヨウ)",
          "ja": "<player>と一緒に一晩中遊べたら、",
          "tc": "如果能跟<player>一起玩一整晚的話，",
          "sc": "如果能跟<player>一起玩一整晚的话，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 83055,
          "spk": "洋 (ヨウ)",
          "ja": "きっとすっごく楽しいと思うから……",
          "tc": "一定會很好玩……",
          "sc": "一定会很好玩……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 83066,
          "spk": "洋 (ヨウ)",
          "ja": "あ、もちろん用事があるなら",
          "tc": "啊，當然如果你有事的話，",
          "sc": "啊，当然如果你有事的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 83073,
          "spk": "洋 (ヨウ)",
          "ja": "無理だって言ってくれていいからね？",
          "tc": "就直接說不行也沒關係的喔。",
          "sc": "就直接说不行也没关系的哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 83082,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 83089,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2136,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0081",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83107,
          "spk": "洋 (ヨウ)",
          "ja": "よかった、来てくれるんだ",
          "tc": "太好了，你願意來啊。",
          "sc": "太好了，你愿意来啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83114,
          "spk": "洋 (ヨウ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83125,
          "spk": "洋 (ヨウ)",
          "ja": "それじゃあ、午後６時に",
          "tc": "那就約晚上6點，",
          "sc": "那就约晚上6点，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83132,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、お家で待ってるね！",
          "tc": "我在家裡等你喔！",
          "sc": "我在家里等你哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 83139,
          "spk": "洋 (ヨウ)",
          "ja": "……急いで準備、しなくっちゃ！",
          "tc": "……我要趕快回去做好準備才行！",
          "sc": "……我要赶快回去做好准备才行！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2137,
      "rec_id": "TALK_ID_GIRL_SPECIAL_20_110_0082",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83161,
          "spk": "洋 (ヨウ)",
          "ja": "そっか、残念……",
          "tc": "這樣啊，真可惜……",
          "sc": "这样啊，真可惜……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83168,
          "spk": "洋 (ヨウ)",
          "ja": "でも、用事があるならしょうがないよね……",
          "tc": "但是你有其他事的話，也沒辦法……",
          "sc": "但是你有其他事的话，也没办法……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83177,
          "spk": "洋 (ヨウ)",
          "ja": "急に変なこと言いだして、ごめんね……",
          "tc": "對不起這麼突然約你……",
          "sc": "对不起这么突然约你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83184,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、またこんどね……",
          "tc": "那我下次再約你……",
          "sc": "那我下次再约你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2138,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83208,
          "spk": "洋 (ヨウ)",
          "ja": "今日は品評会なんだよね？",
          "tc": "今天是評鑑會對吧？",
          "sc": "今天是评鉴会对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83215,
          "spk": "洋 (ヨウ)",
          "ja": "彼ヶ津村にとって、",
          "tc": "叔叔說這是對彼津村來說",
          "sc": "叔叔说这是对彼津村来说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83222,
          "spk": "洋 (ヨウ)",
          "ja": "大事な行事だっておじちゃんが言ってたよ",
          "tc": "非常重要的活動。",
          "sc": "非常重要的活动。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83233,
          "spk": "洋 (ヨウ)",
          "ja": "なんか、たのしそうだね",
          "tc": "總覺得很有趣呢。",
          "sc": "总觉得很有趣呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2139,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83257,
          "spk": "洋 (ヨウ)",
          "ja": "品評会って、動物さんも連れて来れるんだ",
          "tc": "原來評鑑會還會帶著動物來啊。",
          "sc": "原来评鉴会还会带着动物来啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83264,
          "spk": "洋 (ヨウ)",
          "ja": "……ちょっとだけ、楽しそうかも",
          "tc": "……感覺好像有點好玩。",
          "sc": "……感觉好像有点好玩。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83275,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はどんな動物さんが見たい？",
          "tc": "<player>你想看什麼動物呢？",
          "sc": "<player>你想看什么动物呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83282,
          "spk": "洋 (ヨウ)",
          "ja": "わたしは、ウシさんかなあ",
          "tc": "我想看牛牛。",
          "sc": "我想看牛牛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2140,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83306,
          "spk": "洋 (ヨウ)",
          "ja": "うーん、",
          "tc": "嗯～",
          "sc": "嗯～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83313,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんに言われたものは",
          "tc": "叔叔跟我說的",
          "sc": "叔叔跟我说的"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83320,
          "spk": "洋 (ヨウ)",
          "ja": "あれと……これと……",
          "tc": "那個……還有這個……",
          "sc": "那个……还有这个……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83331,
          "spk": "洋 (ヨウ)",
          "ja": "よし、全部ある……",
          "tc": "很好，全部都有……",
          "sc": "很好，全部都有……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 83342,
          "spk": "洋 (ヨウ)",
          "ja": "もう少しで始まるよ、楽しみだね",
          "tc": "就快要開始了，好期待喔。",
          "sc": "就快要开始了，好期待哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2141,
      "rec_id": "TALK_ID_GIRL_HOLIDAY_20_110_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 83373,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 83380,
          "spk": "洋 (ヨウ)",
          "ja": "<player>もバドミントン、する？",
          "tc": "<player>，你要不要來打羽毛球？",
          "sc": "<player>，你要不要来打羽毛球？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 83391,
          "spk": "洋 (ヨウ)",
          "ja": "えっとね、バドミントンはね",
          "tc": "我跟你說喔，羽毛球啊，",
          "sc": "我跟你说哦，羽毛球啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 83398,
          "spk": "洋 (ヨウ)",
          "ja": "この羽のついたロケットを打って遊ぶの",
          "tc": "玩的時候要把這個有羽毛的火箭打來打去。",
