  "line_count": 193,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2366,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 55446,
          "spk": "裕太 (ユータ)",
          "ja": "うーん、やっぱり何度考えても、",
          "tc": "嗯……想來想去，",
          "sc": "嗯……想来想去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 55453,
          "spk": "裕太 (ユータ)",
          "ja": "料理というものは、芸術作品によく似ている……",
          "tc": "還是覺得料理這件事跟藝術創作很像呢……",
          "sc": "还是觉得料理这件事跟艺术创作很像呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 55464,
          "spk": "裕太 (ユータ)",
          "ja": "野菜を炒めて、赤ワインや上質なブイヨンで",
          "tc": "先把蔬菜炒香，再用紅酒與上等高湯燉煮，",
          "sc": "先把蔬菜炒香，再用红酒与上等高汤炖煮，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 55471,
          "spk": "裕太 (ユータ)",
          "ja": "何時間もかけてソースを育てる……",
          "tc": "花上好幾個小時慢慢熬出醬汁……",
          "sc": "花上好几个小时慢慢熬出酱汁……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 55478,
          "spk": "裕太 (ユータ)",
          "ja": "大地の恵みを濃縮するイメージ……",
          "tc": "就像是要萃取大地恩惠，濃縮在料理之中……",
          "sc": "就像是要萃取大地恩惠，浓缩在料理之中……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 55489,
          "spk": "裕太 (ユータ)",
          "ja": "……なんてね",
          "tc": "……只是隨口說說的啦。",
          "sc": "……只是随口说说的啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 55496,
          "spk": "裕太 (ユータ)",
          "ja": "実は最近、料理作りにハマってるんだ",
          "tc": "我最近啊，其實迷上做菜了。",
          "sc": "我最近啊，其实迷上做菜了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 55514,
          "spk": "裕太 (ユータ)",
          "ja": "ソース作りにとことんこだわることで、",
          "tc": "只要把醬汁做到極致，",
          "sc": "只要把酱汁做到极致，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 55521,
          "spk": "裕太 (ユータ)",
          "ja": "ただの料理が至高の逸品へと昇華するんだよ",
          "tc": "就能讓平凡的料理昇華為頂級佳餚呢。",
          "sc": "就能让平凡的料理升华为顶级佳肴呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 55528,
          "spk": "裕太 (ユータ)",
          "ja": "すごく面白いだろう？",
          "tc": "不覺得很有趣嗎？",
          "sc": "不觉得很有趣吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 55539,
          "spk": "裕太 (ユータ)",
          "ja": "どうかな、キミも挑戦してみたくなったろう？",
          "tc": "怎麼樣？你也想挑戰看看吧？",
          "sc": "怎么样？你也想挑战看看吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 55546,
          "spk": "裕太 (ユータ)",
          "ja": "レシピをあげるから、ぜひ作ってみてよ",
          "tc": "我給你食譜，你一定要做做看喔！",
          "sc": "我给你食谱，你一定要做做看哦！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 55553,
          "spk": "裕太 (ユータ)",
          "ja": "自分で作る「デミグラスドリア」、格別だよ",
          "tc": "自己做的「多蜜醬焗飯」會特別好吃喔！",
          "sc": "自己做的“多蜜酱焗饭”会特别好吃哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2367,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 55577,
          "spk": "裕太 (ユータ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 55584,
          "spk": "裕太 (ユータ)",
          "ja": "俺は最近、新しいレシピを考えるのが楽しくてね",
          "tc": "我最近很喜歡構思新的食譜，",
          "sc": "我最近很喜欢构思新的食谱，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 55591,
          "spk": "裕太 (ユータ)",
          "ja": "自分で作るのが追いつかないくらいなんだ",
          "tc": "甚至都來不及試做了。",
          "sc": "甚至都来不及试做了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 55602,
          "spk": "裕太 (ユータ)",
          "ja": "そこで相談なんだけど、",
          "tc": "所以我想找你商量一下，",
          "sc": "所以我想找你商量一下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 55609,
          "spk": "裕太 (ユータ)",
          "ja": "キミに新しいレシピを",
          "tc": "我會給你新的食譜，",
          "sc": "我会给你新的食谱，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 55616,
          "spk": "裕太 (ユータ)",
          "ja": "あげるから作ってみてほしいんだよ",
          "tc": "希望你可以試做看看。",
          "sc": "希望你可以试做看看。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 55627,
          "spk": "裕太 (ユータ)",
          "ja": "そうだな……くりぬいたメロンを器にして、",
          "tc": "像是……把挖空的甜瓜當成容器，",
          "sc": "像是……把挖空的甜瓜当成容器，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 55634,
          "spk": "裕太 (ユータ)",
          "ja": "完熟した果肉をたっぷり入れ、",
          "tc": "放入滿滿的熟成果肉，",
          "sc": "放入满满的熟成果肉，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 55641,
          "spk": "裕太 (ユータ)",
          "ja": "生クリームをこれでもかと乗せるんだ",
          "tc": "鮮奶油也像不用錢似的拚命加。",
          "sc": "鲜奶油也像不用钱似的拚命加。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 55650,
          "spk": "裕太 (ユータ)",
          "ja": "美味しいメロンと贅沢に使ったクリームを",
          "tc": "這樣就能打造出眾人心中的夢幻逸品，",
          "sc": "这样就能打造出众人心中的梦幻逸品，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 55657,
          "spk": "裕太 (ユータ)",
          "ja": "同時に楽しむことができるという、",
          "tc": "可以同時享受鮮美甜瓜",
          "sc": "可以同时享受鲜美甜瓜"
        },
        {
          "f_idx": 11,
          "pidx_tc": 55664,
          "spk": "裕太 (ユータ)",
          "ja": "みんなが夢見る至極の一品……",
          "tc": "和滿滿鮮奶油的雙重美味……",
          "sc": "和满满鲜奶油的双重美味……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 55675,
          "spk": "裕太 (ユータ)",
          "ja": "……なんて、作ったことはないから",
          "tc": "……說是這樣說，但我沒有實際做過，",
          "sc": "……说是这样说，但我没有实际做过，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 55682,
          "spk": "裕太 (ユータ)",
          "ja": "まだこのレシピは設計図の段階なんだけどね",
          "tc": "所以這個食譜還停留在設計階段。",
          "sc": "所以这个食谱还停留在设计阶段。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 55700,
          "spk": "裕太 (ユータ)",
          "ja": "でも、キミならきっと、",
          "tc": "不過，如果是你的話，",
          "sc": "不过，如果是你的话，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 55707,
          "spk": "裕太 (ユータ)",
          "ja": "このレシピを現実のものにしてくれるでしょ？",
          "tc": "一定會幫我實現這道料理的，對吧？",
          "sc": "一定会帮我实现这道料理的，对吧？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 55714,
          "spk": "裕太 (ユータ)",
          "ja": "「夢いっぱいメロン」の完成、楽しみにしてるよ",
          "tc": "我很期待「夢幻甜瓜」完成的那天喔！",
          "sc": "我很期待“梦幻甜瓜”完成的那天哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2368,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 55738,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、聞いてよ！",
          "tc": "<player>，你聽我說！",
          "sc": "<player>，你听我说！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 55745,
          "spk": "裕太 (ユータ)",
          "ja": "俺の畑で、ナスがとれたんだ！",
          "tc": "我的田裡種出茄子了！",
          "sc": "我的田里种出茄子了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 55752,
          "spk": "裕太 (ユータ)",
          "ja": "小さくて形も歪だけど、俺が育てたナスだよ！",
          "tc": "雖然長得又小又歪，但這是我種出來的茄子喔！",
          "sc": "虽然长得又小又歪，但这是我种出来的茄子哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 55763,
          "spk": "裕太 (ユータ)",
          "ja": "だから記念に、レシピを考えたんだ",
          "tc": "所以為了紀念，我想了一道食譜。",
          "sc": "所以为了纪念，我想了一道食谱。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 55770,
          "spk": "裕太 (ユータ)",
          "ja": "ナスのおいしさをあますところなく味わえる、",
          "tc": "是能將茄子的美味發揮到淋漓盡致，",
          "sc": "是能将茄子的美味发挥到淋漓尽致，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 55777,
          "spk": "裕太 (ユータ)",
          "ja": "素晴らしいレシピだよ",
          "tc": "超級棒的食譜喔！",
          "sc": "超级棒的食谱哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 55788,
          "spk": "裕太 (ユータ)",
          "ja": "焼きナスで香りを、煮浸しで旨味を、",
          "tc": "用燒烤品嘗香氣，用燉煮品嘗鮮甜，",
          "sc": "用烧烤品尝香气，用炖煮品尝鲜甜，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 55795,
          "spk": "裕太 (ユータ)",
          "ja": "浅漬けでナスの生命力を感じる……",
          "tc": "再用淺漬來感受茄子的生命力……",
          "sc": "再用浅渍来感受茄子的生命力……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 55802,
          "spk": "裕太 (ユータ)",
          "ja": "さあ、受けとって！　「ナスづくし」レシピだ！",
          "tc": "來，收下吧！這是「茄子全餐」的食譜！",
          "sc": "来，收下吧！这是“茄子全餐”的食谱！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 55813,
          "spk": "裕太 (ユータ)",
          "ja": "この喜びを<player>に伝えられてよかったよ",
          "tc": "可以跟<player>分享這份喜悅真是太好了，",
          "sc": "可以跟<player>分享这份喜悦真是太好了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 55820,
          "spk": "裕太 (ユータ)",
          "ja": "ナスづくしの一皿、たくさん楽しんでね",
          "tc": "好好享受滿滿一盤茄子全餐吧！",
          "sc": "好好享受满满一盘茄子全餐吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2369,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 55851,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 55858,
          "spk": "裕太 (ユータ)",
          "ja": "ちょうどいいところに来てくれたね",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 55865,
          "spk": "裕太 (ユータ)",
          "ja": "今、キミを探してたんだ",
          "tc": "我正在找你。",
          "sc": "我正在找你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 55876,
          "spk": "裕太 (ユータ)",
          "ja": "実は、今夜うちで一緒に",
          "tc": "其實我是想問你，",
          "sc": "其实我是想问你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 55883,
          "spk": "裕太 (ユータ)",
          "ja": "食事でもどうかなと思ってて……",
          "tc": "今晚要不要來我家吃飯……",
          "sc": "今晚要不要来我家吃饭……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 55894,
          "spk": "裕太 (ユータ)",
          "ja": "今日はなんとなく",
          "tc": "今天不知道為什麼，",
          "sc": "今天不知道为什么，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 55901,
          "spk": "裕太 (ユータ)",
          "ja": "一人で食べるのはさびしくて……",
          "tc": "總覺得一個人吃飯很孤單……",
          "sc": "总觉得一个人吃饭很孤单……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 55908,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が来てくれたら嬉しいな",
          "tc": "<player>願意過來的話，我會很開心的。",
          "sc": "<player>愿意过来的话，我会很开心的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 55919,
          "spk": "裕太 (ユータ)",
          "ja": "午後６時なら準備ができてると思うから、",
          "tc": "我應該會在晚上6點準備好，",
          "sc": "我应该会在晚上6点准备好，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 55926,
          "spk": "裕太 (ユータ)",
          "ja": "直接うちに来てくれればいいよ",
          "tc": "到時候你直接來我家就可以了。",
          "sc": "到时候你直接来我家就可以了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 55933,
          "spk": "裕太 (ユータ)",
          "ja": "どうかな？　来れそうかい？",
          "tc": "怎麼樣？你能來嗎？",
          "sc": "怎么样？你能来吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 55942,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 12,
          "pidx_tc": 55949,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2370,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 55967,
          "spk": "裕太 (ユータ)",
          "ja": "本当に？　よかった！",
          "tc": "真的嗎？太好了！",
          "sc": "真的吗？太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 55974,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう、楽しみだな",
          "tc": "謝謝你，我好期待喔！",
          "sc": "谢谢你，我好期待哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 55985,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が好きそうな",
          "tc": "我會好好想想<player>",
          "sc": "我会好好想想<player>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 55992,
          "spk": "裕太 (ユータ)",
          "ja": "メニューを考えておくよ",
          "tc": "會喜歡的菜單喔。",
          "sc": "会喜欢的菜单哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 55999,
          "spk": "裕太 (ユータ)",
          "ja": "それじゃ、午後６時にまたね！",
          "tc": "那我們晚上6點見囉！",
          "sc": "那我们晚上6点见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2371,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56021,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、もう先約があった？",
          "tc": "啊，你已經有約了嗎？",
          "sc": "啊，你已经有约了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 56028,
          "spk": "裕太 (ユータ)",
          "ja": "いきなり誘ってごめんね",
          "tc": "抱歉，約得這麼突然。",
          "sc": "抱歉，约得这么突然。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 56039,
          "spk": "裕太 (ユータ)",
          "ja": "それじゃ、今夜は一人で食事にしようかな……",
          "tc": "那今天我要一個人吃晚餐了呢……",
          "sc": "那今天我要一个人吃晚餐了呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 56046,
          "spk": "裕太 (ユータ)",
          "ja": "ロッカクさんの店に行くことにするよ",
          "tc": "我打算去六角的店裡吃。",
          "sc": "我打算去六角的店里吃。"
        },
        {
          "f_idx": 4,
