  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8139,
      "rec_id": "TALK_ID_10_0102_041_07_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217026,
          "spk": "？？？ (未知角色)",
          "ja": "んじゃ、あらためまして",
          "tc": "我來正式自我介紹一下吧。",
          "sc": "我来正式自我介绍一下吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217044,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はじめまして",
          "tc": "你好，",
          "sc": "你好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217051,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの名前は、チナナだよ",
          "tc": "我的名字是琪娜娜。",
          "sc": "我的名字是琪娜娜。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217060,
          "spk": "琪娜娜 (チナナ)",
          "ja": "月、水、金、日曜日に",
          "tc": "每個星期一、三、五、日，",
          "sc": "每个星期一、三、五、日，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217067,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の外から商品を仕入れて来てるんだ",
          "tc": "我會來擺攤賣一些從村外進貨的商品。",
          "sc": "我会来摆摊卖一些从村外进货的商品。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 217085,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次来るのは明後日……水曜だね",
          "tc": "下次來會是後天……星期三的時候。",
          "sc": "下次来会是后天……星期三的时候。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 217092,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは明日街に帰って、キミの小屋で",
          "tc": "我明天會回鎮上，",
          "sc": "我明天会回镇上，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 217099,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ピロちゃんを飼う準備をしてくるよ",
          "tc": "籌備東西讓你的雞舍能養嗶羅。",
          "sc": "筹备东西让你的鸡舍能养哔罗。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 217110,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、小屋にピロちゃんが来るのは水曜日だ",
          "tc": "所以嗶羅會在星期三搬進你的雞舍。",
          "sc": "所以哔罗会在星期三搬进你的鸡舍。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 217117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それまでは、ウチの車に隠して飼っておこう",
          "tc": "在那之前，會先養在我的車裡。",
          "sc": "在那之前，会先养在我的车里。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 217135,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにしても、キミ……",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 217142,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人であの広い庭を管理するんだって？",
          "tc": "聽說你得獨自打理那麼大的庭院啊？",
          "sc": "听说你得独自打理那么大的庭院啊？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 217149,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな小さな子どもに、リンも無茶を言うね",
          "tc": "連對這麼小的孩子，林也這麼強人所難呢。",
          "sc": "连对这么小的孩子，林也这么强人所难呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 217160,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それに加えて次はヒヨコまで……",
          "tc": "不僅如此，接下來連小雞都……",
          "sc": "不仅如此，接下来连小鸡都……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 217167,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだか押し付けてしまって、",
          "tc": "算是硬塞給你了，",
          "sc": "算是硬塞给你了，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 217174,
          "spk": "琪娜娜 (チナナ)",
          "ja": "申し訳ない気持ちになってきたよ……",
          "tc": "我開始感到抱歉……",
          "sc": "我开始感到抱歉……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 217185,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なにかお礼をしたいけれど、",
          "tc": "雖然想做點什麼來表示感謝，但……",
          "sc": "虽然想做点什么来表示感谢，但……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 217192,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、手持ちにいいモノはないし……",
          "tc": "現在手邊沒有什麼好東西……",
          "sc": "现在手边没有什么好东西……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 217210,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 217217,
          "spk": "琪娜娜 (チナナ)",
          "ja": "動物のお世話は力仕事だろうから、",
          "tc": "照顧動物應該是件費力的工作吧，",
          "sc": "照顾动物应该是件费力的工作吧，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 217224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体力を補うモノとかはどうだい？",
          "tc": "給你點補充體力的東西怎麼樣？",
          "sc": "给你点补充体力的东西怎么样？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 217235,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ただ、これはウチじゃなくて、",
          "tc": "……不過，不是我店裡的商品，",
          "sc": "……不过，不是我店里的商品，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 217242,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ある人からもらえるモノなんだ",
          "tc": "是可以從某個人那裡拿到的東西。",
          "sc": "是可以从某个人那里拿到的东西。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 217249,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど一緒に来てくれるかい？",
          "tc": "不好意思，你能跟我一起去嗎？",
          "sc": "不好意思，你能跟我一起去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8140,
      "rec_id": "TALK_ID_10_0102_045_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 219285,
          "spk": "洋 (ヨウ)",
          "ja": "ほんとうに……？",
          "tc": "真的嗎……？",
          "sc": "真的吗……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 219292,
          "spk": "洋 (ヨウ)",
          "ja": "……ありがとう",
          "tc": "……謝謝你。",
          "sc": "……谢谢你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 219301,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ……",
          "tc": "那……",
          "sc": "那……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 219308,
          "spk": "洋 (ヨウ)",
          "ja": "おやすみ、<player>……",
          "tc": "晚安了，<player>……",
          "sc": "晚安了，<player>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8141,
      "rec_id": "TALK_ID_10_0102_045_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 219324,
          "spk": "洋 (ヨウ)",
          "ja": "そう……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 219331,
          "spk": "洋 (ヨウ)",
          "ja": "そうだよね",
          "tc": "也對。",
          "sc": "也对。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 219340,
          "spk": "洋 (ヨウ)",
          "ja": "……ごめんね",
          "tc": "……抱歉。",
          "sc": "……抱歉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 219347,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ……おやすみ",
          "tc": "那……晚安了。",
          "sc": "那……晚安了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8142,
      "rec_id": "TALK_ID_10_0102_050_07_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220091,
          "spk": "林 (リン)",
          "ja": "……なるほど",
          "tc": "……原來如此。",
          "sc": "……原来如此。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8143,
      "rec_id": "TALK_ID_10_0102_050_07_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220109,
          "spk": "林 (リン)",
          "ja": "そう……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220116,
          "spk": "林 (リン)",
          "ja": "気に病まないで",
          "tc": "你別太放在心上了。",
          "sc": "你别太放在心上了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220123,
          "spk": "林 (リン)",
          "ja": "わからなくて当然よ",
          "tc": "沒印象也是理所當然的。",
          "sc": "没印象也是理所当然的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8144,
      "rec_id": "TALK_ID_10_0102_050_20_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220737,
          "spk": "裕太 (ユータ)",
          "ja": "噂は聞いたよ、",
          "tc": "我都聽說了，",
          "sc": "我都听说了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220744,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんのニワトリが",
          "tc": "小洋的雞",
          "sc": "小洋的鸡"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220751,
          "spk": "裕太 (ユータ)",
          "ja": "殺されていたんだって？",
          "tc": "遭到殺害了，對吧？",
          "sc": "遭到杀害了，对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 220762,
          "spk": "裕太 (ユータ)",
          "ja": "村の誰がそんなことを……",
          "tc": "到底是村子裡的誰做出了……",
          "sc": "到底是村子里的谁做出了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 220769,
          "spk": "裕太 (ユータ)",
          "ja": "いや……ありえないよね、",
          "tc": "不對……這不可能。",
          "sc": "不对……这不可能。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 220776,
          "spk": "裕太 (ユータ)",
          "ja": "村の人たちはみんないい人だから……",
          "tc": "因為村子裡的大家都是好人……",
          "sc": "因为村子里的大家都是好人……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8145,
      "rec_id": "TALK_ID_10_0102_050_20_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220802,
          "spk": "裕太 (ユータ)",
          "ja": "きっと、村の外の人がやったんだろう……",
          "tc": "一定是村外的人幹的吧……",
          "sc": "一定是村外的人干的吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220809,
          "spk": "裕太 (ユータ)",
          "ja": "どうしてあんなことが、",
          "tc": "到底為什麼",
          "sc": "到底为什么"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220816,
          "spk": "裕太 (ユータ)",
          "ja": "できるんだろうね……",
          "tc": "能做出那種事……？",
          "sc": "能做出那种事……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8146,
      "rec_id": "TALK_ID_10_0102_050_21_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220842,
          "spk": "四郎治 (シロージ)",
          "ja": "お前じゃないよな、",
          "tc": "應該不是你",
          "sc": "应该不是你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220849,
          "spk": "四郎治 (シロージ)",
          "ja": "掟をやぶったのは",
          "tc": "打破了規矩吧？",
          "sc": "打破了规矩吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220860,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 220867,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウ自身の身に、",
          "tc": "幸好洋本人",
          "sc": "幸好洋本人"
        },
        {
          "f_idx": 4,
          "pidx_tc": 220874,
          "spk": "四郎治 (シロージ)",
          "ja": "何も起きなくてよかったよ",
          "tc": "沒發生什麼事。",
          "sc": "没发生什么事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8147,
      "rec_id": "TALK_ID_10_0102_050_22_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220900,
          "spk": "木助 (キスケ)",
          "ja": "聞いたぜ、",
          "tc": "我都聽說了，",
          "sc": "我都听说了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220907,
          "spk": "木助 (キスケ)",
          "ja": "ヨウのニワトリの件",
          "tc": "洋的雞那件事。",
          "sc": "洋的鸡那件事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220918,
          "spk": "木助 (キスケ)",
          "ja": "まさか……てめぇがニワトリを",
          "tc": "該不會……是你這傢伙",
          "sc": "该不会……是你这家伙"
        },
        {
          "f_idx": 3,
          "pidx_tc": 220925,
          "spk": "木助 (キスケ)",
          "ja": "やったワケじゃねえよな",
          "tc": "把雞給殺了吧？",
          "sc": "把鸡给杀了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 220936,
          "spk": "木助 (キスケ)",
          "ja": "なんて、冗談だよ、冗談！",
          "tc": "沒事，我只是開個玩笑！",
          "sc": "没事，我只是开个玩笑！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 220943,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも気に病むんじゃねえぞ！",
          "tc": "你也別太消沉了！",
          "sc": "你也别太消沉了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8148,
      "rec_id": "TALK_ID_10_0102_050_22_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 220969,
          "spk": "木助 (キスケ)",
          "ja": "きっと、山の獣が悪さしたんだろ",
          "tc": "一定是山裡的野獸搞的鬼。",
          "sc": "一定是山里的野兽搞的鬼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 220976,
          "spk": "木助 (キスケ)",
          "ja": "ああいう弱い生き物から、",
          "tc": "牠們就是會從那種弱小動物",
          "sc": "它们就是会从那种弱小动物"
        },
        {
          "f_idx": 2,
          "pidx_tc": 220983,
          "spk": "木助 (キスケ)",
          "ja": "取って食われちまうんだ",
          "tc": "開始吃起嘛。",
          "sc": "开始吃起嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8149,
      "rec_id": "TALK_ID_10_0102_050_23_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221009,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん……",
          "tc": "嗶羅……",
          "sc": "哔罗……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221016,
          "spk": "洋 (ヨウ)",
          "ja": "やっとニワトリになれたのに……",
          "tc": "牠好不容易才長大成雞的……",
          "sc": "它好不容易才长大成鸡的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221027,
          "spk": "洋 (ヨウ)",
          "ja": "わたしのせい……なの……？",
          "tc": "都是……我的錯……嗎？",
          "sc": "都是……我的错……吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8150,
      "rec_id": "TALK_ID_10_0102_050_23_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 221053,
          "spk": "洋 (ヨウ)",
          "ja": "うう……ピロちゃん……",
          "tc": "嗚嗚……嗶羅……",
          "sc": "呜呜……哔罗……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 221062,
          "spk": "洋 (ヨウ)",
          "ja": "あいたいよ……",
          "tc": "我好想你……",
          "sc": "我好想你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 221069,
          "spk": "洋 (ヨウ)",
          "ja": "さみしいよ……ピロちゃん……",
          "tc": "我好寂寞……嗶羅……",
          "sc": "我好寂寞……哔罗……"
        }
      ]
    },
    {
