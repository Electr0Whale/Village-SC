      "rec_id": "TALK_ID_10_0201_011_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 230874,
          "spk": "名护 (ナゴ)",
          "ja": "ほ、本当ですか！？",
          "tc": "真、真的嗎！？",
          "sc": "真、真的吗！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 230881,
          "spk": "名护 (ナゴ)",
          "ja": "ご快諾、誠にありがとうございます！",
          "tc": "十分感謝您如此欣然答應！",
          "sc": "十分感谢您如此欣然答应！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 230888,
          "spk": "名护 (ナゴ)",
          "ja": "それでは早速、契約書をお持ちしますね！",
          "tc": "那麼事不宜遲，我馬上把契約書拿來！",
          "sc": "那么事不宜迟，我马上把契约书拿来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8176,
      "rec_id": "TALK_ID_10_0201_011_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 230910,
          "spk": "名护 (ナゴ)",
          "ja": "即断するほど、",
          "tc": "這應該不是",
          "sc": "这应该不是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 230917,
          "spk": "名护 (ナゴ)",
          "ja": "悪い話ではありませんよ？",
          "tc": "需要馬上拒絕的壞事吧？",
          "sc": "需要马上拒绝的坏事吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 230924,
          "spk": "名护 (ナゴ)",
          "ja": "どうかご一考、いただけませんか？",
          "tc": "能不能請您再考慮一下？",
          "sc": "能不能请您再考虑一下？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8177,
      "rec_id": "TALK_ID_10_0202_051_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235194,
          "spk": "林 (リン)",
          "ja": "遅いわ！",
          "tc": "太慢了！",
          "sc": "太慢了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235201,
          "spk": "林 (リン)",
          "ja": "やっと起きたのね！",
          "tc": "你終於醒啦！",
          "sc": "你终于醒啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235212,
          "spk": "林 (リン)",
          "ja": "今日は、頼みがあって来たのだけれど……",
          "tc": "我今天過來是有事情想拜託你……",
          "sc": "我今天过来是有事情想拜托你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235219,
          "spk": "林 (リン)",
          "ja": "あなたには、今日がなんの日か",
          "tc": "……你應該不曉得",
          "sc": "……你应该不晓得"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235226,
          "spk": "林 (リン)",
          "ja": "わからないわよね？",
          "tc": "今天是什麼日子吧？",
          "sc": "今天是什么日子吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8178,
      "rec_id": "TALK_ID_10_0202_051_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235244,
          "spk": "林 (リン)",
          "ja": "ほら、山の方から",
          "tc": "你看看山那邊，",
          "sc": "你看看山那边，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235251,
          "spk": "林 (リン)",
          "ja": "狼煙が上がってるのが見えるでしょ",
          "tc": "有道狼煙昇起，對吧？",
          "sc": "有道狼烟升起，对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8179,
      "rec_id": "TALK_ID_10_0202_051_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235269,
          "spk": "林 (リン)",
          "ja": "狼煙が上がったら、",
          "tc": "看到狼煙，",
          "sc": "看到狼烟，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235276,
          "spk": "林 (リン)",
          "ja": "お墓へ行って、お掃除してお参りする",
          "tc": "就代表這一天是要去墓地",
          "sc": "就代表这一天是要去墓地"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235283,
          "spk": "林 (リン)",
          "ja": "墓参りの日という合図なのよ！",
          "tc": "掃墓、參拜的掃墓日！",
          "sc": "扫墓、参拜的扫墓日！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8180,
      "rec_id": "TALK_ID_10_0202_051_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235301,
          "spk": "林 (リン)",
          "ja": "昨日、寝る前に思いついたの",
          "tc": "昨天睡前我正好想到，",
          "sc": "昨天睡前我正好想到，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235317,
          "spk": "林 (リン)",
          "ja": "私たちが、お墓にお参りしている間に",
          "tc": "要是在掃墓的時候，",
          "sc": "要是在扫墓的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235324,
          "spk": "林 (リン)",
          "ja": "あなたが雑草を掃除してくれたら……",
          "tc": "你能來幫忙清除雜草的話，",
          "sc": "你能来帮忙清除杂草的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235331,
          "spk": "林 (リン)",
          "ja": "無駄な時間を、過ごさずにすむってね",
          "tc": "就能不用白白浪費時間了。",
          "sc": "就能不用白白浪费时间了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235342,
          "spk": "林 (リン)",
          "ja": "あなたには、この地に眠る先祖はいないわ",
          "tc": "畢竟你的祖先並沒有在這裡永眠。",
          "sc": "毕竟你的祖先并没有在这里永眠。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 235349,
          "spk": "林 (リン)",
          "ja": "……でも、だからこそできることがある",
          "tc": "……但也因此，你也有你才有能做的事。",
          "sc": "……但也因此，你也有你才有能做的事。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 235367,
          "spk": "林 (リン)",
          "ja": "ということで、",
          "tc": "也就是說，",
          "sc": "也就是说，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 235374,
          "spk": "林 (リン)",
          "ja": "あなたの今日の仕事は、草むしりよ！！",
          "tc": "你今天的工作，就是除草！！",
          "sc": "你今天的工作，就是除草！！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 235385,
          "spk": "林 (リン)",
          "ja": "私たちのお墓参り、",
          "tc": "你應該願意來幫忙",
          "sc": "你应该愿意来帮忙"
        },
        {
          "f_idx": 11,
          "pidx_tc": 235392,
          "spk": "林 (リン)",
          "ja": "手伝ってくれるわよね",
          "tc": "我們的掃墓活動吧？",
          "sc": "我们的扫墓活动吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 235401,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 13,
          "pidx_tc": 235408,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8181,
      "rec_id": "TALK_ID_10_0202_051_01_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235426,
          "spk": "林 (リン)",
          "ja": "まあ、もちろん拒否権はないけどね！",
          "tc": "當然了，你並沒有拒絕的權利！",
          "sc": "当然了，你并没有拒绝的权利！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235433,
          "spk": "林 (リン)",
          "ja": "なにせ、あなたは村のために働くという契約を、",
          "tc": "畢竟你可是跟我簽訂了",
          "sc": "毕竟你可是跟我签订了"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235440,
          "spk": "林 (リン)",
          "ja": "この私と交わしたのだから！",
          "tc": "為了村子工作的契約呢！",
          "sc": "为了村子工作的契约呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235451,
          "spk": "林 (リン)",
          "ja": "さあ、来なさい！",
          "tc": "來，跟我來！",
          "sc": "来，跟我来！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235458,
          "spk": "林 (リン)",
          "ja": "やりがいに満ちた、",
          "tc": "完成這項充滿成就感的",
          "sc": "完成这项充满成就感的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235465,
          "spk": "林 (リン)",
          "ja": "楽しい仕事に行きましょう！",
          "tc": "快樂的工作吧！",
          "sc": "快乐的工作吧！"
        }
      ]
    }
