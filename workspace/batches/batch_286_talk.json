    {
      "file": "talk.dat",
      "rec_idx": 8159,
      "rec_id": "TALK_ID_10_0201_003_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227764,
          "spk": "帷 (トバリ)",
          "ja": "アンタも今のリンの話、",
          "tc": "你也聽到林剛剛",
          "sc": "你也听到林刚刚"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227771,
          "spk": "帷 (トバリ)",
          "ja": "聞いていたんじゃない？",
          "tc": "說的話了吧？",
          "sc": "说的话了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227782,
          "spk": "帷 (トバリ)",
          "ja": "リンはね、深夜にこっそり",
          "tc": "林她啊，都會像剛剛那樣，",
          "sc": "林她啊，都会像刚刚那样，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227789,
          "spk": "帷 (トバリ)",
          "ja": "ああして儀式とやらの準備をしているの",
          "tc": "在深夜偷偷準備那個什麼儀式。",
          "sc": "在深夜偷偷准备那个什么仪式。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 227798,
          "spk": "帷 (トバリ)",
          "ja": "……気色悪いでしょ？",
          "tc": "很噁心對吧？",
          "sc": "很恶心对吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 227805,
          "spk": "帷 (トバリ)",
          "ja": "あの女は村を支配するためなら、手段を選ばない",
          "tc": "那個女的為了支配村子，真是不擇手段。",
          "sc": "那个女的为了支配村子，真是不择手段。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 227812,
          "spk": "帷 (トバリ)",
          "ja": "怪奇現象を利用することもいとわない……",
          "tc": "甚至連利用異常現象都可以利用……",
          "sc": "甚至连利用异常现象都可以利用……"
        }
      ]
    },
