    },
    {
      "file": "talk.dat",
      "rec_idx": 4548,
      "rec_id": "TALK_ID_10_0401_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261176,
          "spk": "帷 (トバリ)",
          "ja": "ねえ、アンタには",
          "tc": "喂，我說妳。",
          "sc": "喂，我说你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261183,
          "spk": "帷 (トバリ)",
          "ja": "怒りって感情はないの？",
          "tc": "妳難道都不會生氣嗎？",
          "sc": "你难道都不会生气吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261192,
          "spk": "帷 (トバリ)",
          "ja": "リンにあんなひどいことをさせられて、",
          "tc": "林逼妳做了那麼過分的事，",
          "sc": "林逼你做了那么过分的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261199,
          "spk": "帷 (トバリ)",
          "ja": "まるで、何も起きなかったかのように",
          "tc": "妳竟然還能像什麼都沒發生過一樣，",
          "sc": "你竟然还能像什么都没发生过一样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261206,
          "spk": "帷 (トバリ)",
          "ja": "平然と暮らしているなんて……",
          "tc": "過得這麼若無其事……",
          "sc": "过得这么若无其事……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261219,
          "spk": "帷 (トバリ)",
          "ja": "私には到底理解できない！",
          "tc": "我簡直完全無法理解耶！",
          "sc": "我简直完全无法理解啊！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 261226,
          "spk": "帷 (トバリ)",
          "ja": "どうして、そんなに簡単に受け入れられるの",
          "tc": "妳怎麼能這麼輕易就接受這種事啊。",
          "sc": "你怎么能这么轻易就接受这种事啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4550,
      "rec_id": "TALK_ID_10_0401_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261256,
          "spk": "驹子 (コマコ)",
          "ja": "あの……トバリ、ごめん",
          "tc": "那個……帷，對不起。",
          "sc": "那个……帷，对不起。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261263,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんなさい……",
          "tc": "真的很對不起……",
          "sc": "真的很对不起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261276,
          "spk": "帷 (トバリ)",
          "ja": "それ、やめてよ",
          "tc": "別再重複那句話了。",
          "sc": "别再重复那句话了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4551,
      "rec_id": "TALK_ID_10_0401_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261302,
          "spk": "帷 (トバリ)",
          "ja": "私が怒ってるのは、",
          "tc": "我現在生氣的，",
          "sc": "我现在生气的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261309,
          "spk": "帷 (トバリ)",
          "ja": "アンタに対してだけじゃない！",
          "tc": "已經不只是妳了！",
          "sc": "已经不只是你了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261318,
          "spk": "帷 (トバリ)",
          "ja": "どうして、どいつもこいつも",
          "tc": "為什麼這裡每個傢伙都這麼盲目……",
          "sc": "为什么这里每个家伙都这么盲目……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261325,
          "spk": "帷 (トバリ)",
          "ja": "リンの言うことを、何も考えずに素直に聞いて、",
          "tc": "只會對林言聽計從，完全沒在動腦，",
          "sc": "只会对林言听计从，完全没在动脑，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261332,
          "spk": "帷 (トバリ)",
          "ja": "疑問も持たずに、ここで暮らせているの！？",
          "tc": "在這裡過得這麼心安理得，都不覺得有問題啊！？",
          "sc": "在这里过得这么心安理得，都不觉得有问题啊！？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261343,
          "spk": "帷 (トバリ)",
          "ja": "私には、どうしても納得できないわ！",
          "tc": "我再怎麼想都無法接受！",
          "sc": "我再怎么想都无法接受！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4552,
      "rec_id": "TALK_ID_10_0401_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261376,
          "spk": "驹子 (コマコ)",
          "ja": "本当に、ごめんなさい……",
          "tc": "我真的，感到很抱歉……",
          "sc": "我真的，感到很抱歉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261383,
          "spk": "驹子 (コマコ)",
          "ja": "だから、落ち着いて……お願い……",
          "tc": "所以，拜託妳……冷靜下來吧……",
          "sc": "所以，拜托你……冷静下来吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4553,
      "rec_id": "TALK_ID_10_0401_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261401,
          "spk": "帷 (トバリ)",
          "ja": "そもそも何なの",
          "tc": "再說那些到底算什麼啊？",
          "sc": "再说那些到底算什么啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261408,
          "spk": "帷 (トバリ)",
          "ja": "「神」だの「掟」だのって……",
          "tc": "又是「神」又是「規矩」的……",
          "sc": "又是“神”又是“规矩”的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261417,
          "spk": "帷 (トバリ)",
          "ja": "これって結局のところ、",
          "tc": "說穿了，不過就是一套方便的說詞，",
          "sc": "说穿了，不过就是一套方便的说词，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261424,
          "spk": "帷 (トバリ)",
          "ja": "村人たちを黙らせて、リンが好き勝手に",
          "tc": "好讓村民們乖乖閉上嘴，",
          "sc": "好让村民们乖乖闭上嘴，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261431,
          "spk": "帷 (トバリ)",
          "ja": "村を支配するための口実に過ぎない",
          "tc": "讓林能隨心所欲支配村子罷了。",
          "sc": "让林能随心所欲支配村子罢了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261442,
          "spk": "帷 (トバリ)",
          "ja": "寄進を集めるのは金目当てだし",
          "tc": "鼓勵捐獻是為了斂財，",
          "sc": "鼓励捐献是为了敛财，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 261449,
          "spk": "帷 (トバリ)",
          "ja": "健康診断だって嘘ばかり",
          "tc": "連健康檢查也都是在騙人。",
          "sc": "连健康检查也都是在骗人。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 261465,
          "spk": "帷 (トバリ)",
          "ja": "ただ村人を利用して、",
          "tc": "根本只是在利用村民，",
          "sc": "根本只是在利用村民，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 261472,
          "spk": "帷 (トバリ)",
          "ja": "変な儀式に使う血を集めているだけじゃない",
          "tc": "收集要用在詭異儀式上的血液不是嗎？",
          "sc": "收集要用在诡异仪式上的血液不是吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 261492,
          "spk": "驹子 (コマコ)",
          "ja": "そんなこと……",
          "tc": "不是這樣的……",
          "sc": "不是这样的……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 261499,
          "spk": "驹子 (コマコ)",
          "ja": "リンは少なくとも村を守ろうとしていて……",
          "tc": "至少林是真心為了守護村子……",
          "sc": "至少林是真心为了守护村子……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 261506,
          "spk": "驹子 (コマコ)",
          "ja": "きっと、樹を切るのもなにか理由が……",
          "tc": "會砍樹肯定也有她的苦衷……",
          "sc": "会砍树肯定也有她的苦衷……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4554,
      "rec_id": "TALK_ID_10_0401_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261524,
          "spk": "帷 (トバリ)",
          "ja": "アンタ、リンが毎週",
          "tc": "我說駒子，",
          "sc": "我说驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261531,
          "spk": "帷 (トバリ)",
          "ja": "何をしているか知っているの……？",
          "tc": "妳知道林每個星期都在做些什麼嗎……？",
          "sc": "你知道林每个星期都在做些什么吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261544,
          "spk": "驹子 (コマコ)",
          "ja": "……し、知らないよ",
          "tc": "……不、不知道。",
          "sc": "……不、不知道。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261551,
          "spk": "驹子 (コマコ)",
          "ja": "そんなこと、わざわざ知ろうとなんて",
          "tc": "那種事情，",
          "sc": "那种事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261558,
          "spk": "驹子 (コマコ)",
          "ja": "考えたこともないし……",
          "tc": "我也從來沒想過要特地去弄清楚……",
          "sc": "我也从来没想过要特地去弄清楚……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261571,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ教えてあげる……",
          "tc": "那我就告訴妳吧……",
          "sc": "那我就告诉你吧……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 261578,
          "spk": "帷 (トバリ)",
          "ja": "リンは真夜中に、不気味な怪異を呼び寄せて、",
          "tc": "林會在半夜把可怕的妖怪召喚過來，",
          "sc": "林会在半夜把可怕的妖怪召唤过来，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 261585,
          "spk": "帷 (トバリ)",
          "ja": "掟を破るような村人がいないか見張っているのよ",
          "tc": "好監視有沒有村民違反了規矩。",
          "sc": "好监视有没有村民违反了规矩。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4555,
      "rec_id": "TALK_ID_10_0401_001_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261603,
          "spk": "驹子 (コマコ)",
          "ja": "リンとはいえそんなことが……",
          "tc": "就算是林……",
          "sc": "就算是林……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261610,
          "spk": "驹子 (コマコ)",
          "ja": "できるわけ……",
          "tc": "也不可能辦得到那種事吧……",
          "sc": "也不可能办得到那种事吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261623,
          "spk": "帷 (トバリ)",
          "ja": "手段はしらないけど、私は見たもの",
          "tc": "雖然我不清楚實際的手段，但我親眼看到了。",
          "sc": "虽然我不清楚实际的手段，但我亲眼看到了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261630,
          "spk": "帷 (トバリ)",
          "ja": "そして次は、不気味な儀式の準備をしている……",
          "tc": "而且她正在準備詭異儀式……",
          "sc": "而且她正在准备诡异仪式……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261648,
          "spk": "帷 (トバリ)",
          "ja": "きっとコダマの樹も、",
          "tc": "我想木珠的樹，",
          "sc": "我想木珠的树，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 261655,
          "spk": "帷 (トバリ)",
          "ja": "あいつが画策していることにとって",
          "tc": "肯定也是因為妨礙到了她的計畫，",
          "sc": "肯定也是因为妨碍到了她的计划，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 261662,
          "spk": "帷 (トバリ)",
          "ja": "都合が悪かったのでしょう",
          "tc": "所以才會被除掉。",
          "sc": "所以才会被除掉。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 261675,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 261688,
          "spk": "帷 (トバリ)",
          "ja": "少なくとも私は、",
          "tc": "至少我",
          "sc": "至少我"
        },
        {
          "f_idx": 10,
          "pidx_tc": 261695,
          "spk": "帷 (トバリ)",
          "ja": "リンが何を起こそうとしているのか",
          "tc": "對於林想要做的事情",
          "sc": "对于林想要做的事情"
        },
        {
          "f_idx": 11,
          "pidx_tc": 261702,
          "spk": "帷 (トバリ)",
          "ja": "知らないまま、見過ごすことはできない",
          "tc": "沒有辦法就這樣事而不見。",
          "sc": "没有办法就这样事而不见。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 261713,
          "spk": "帷 (トバリ)",
          "ja": "コマコ、アンタにも手伝ってもらうからね",
          "tc": "駒子，妳也要幫我的忙喔。",
          "sc": "驹子，你也要帮我的忙。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 261720,
          "spk": "帷 (トバリ)",
          "ja": "リンの秘密を暴くのを",
          "tc": "我們一起揭穿林的祕密。",
          "sc": "我们一起揭穿林的秘密。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4556,
      "rec_id": "TALK_ID_10_0401_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261745,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……",
          "tc": "咦……",
          "sc": "咦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261752,
          "spk": "驹子 (コマコ)",
          "ja": "そんな、できないよ！",
          "tc": "我辦不到啦！",
          "sc": "我办不到啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261761,
          "spk": "驹子 (コマコ)",
          "ja": "掟にも秘密を暴くなって書いてあるし……",
          "tc": "規矩也寫了「別揭露他人祕密」啊……",
          "sc": "规矩也写了“别揭露他人秘密”啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261768,
          "spk": "驹子 (コマコ)",
          "ja": "きっとよくないことが起きるよ！",
          "tc": "這樣一定會發生不好的事啦！",
          "sc": "这样一定会发生不好的事啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4557,
      "rec_id": "TALK_ID_10_0401_001_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261793,
          "spk": "帷 (トバリ)",
          "ja": "さて、計画を立てないと……",
          "tc": "好了，接下來得先擬訂計畫才行……",
          "sc": "好了，接下来得先拟订计划才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4558,
      "rec_id": "TALK_ID_10_0401_001_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261815,
          "spk": "驹子 (コマコ)",
          "ja": "ま、まってよトバリ！",
          "tc": "等、等等啊，帷！",
          "sc": "等、等等啊，帷！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261822,
          "spk": "驹子 (コマコ)",
          "ja": "私、手伝えないからね……！",
          "tc": "我是不會幫忙的喔……！",
          "sc": "我是不会帮忙的哦……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4559,
      "rec_id": "TALK_ID_10_0401_002_00",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261846,
          "spk": "名护 (ナゴ)",
          "ja": "やあ、<player>さん",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261853,
          "spk": "名护 (ナゴ)",
          "ja": "いいところに来てくれたね",
          "tc": "你來得正好呢。",
          "sc": "你来得正好呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261864,
          "spk": "名护 (ナゴ)",
          "ja": "キミにも、見てもらいたいものがあってね……",
          "tc": "有樣東西，我正好想讓你也看看……",
          "sc": "有样东西，我正好想让你也看看……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261871,
          "spk": "名护 (ナゴ)",
          "ja": "今から一緒に、図書館まで来てくれると",
          "tc": "希望你接下來可以跟我去一趟圖書館……",
          "sc": "希望你接下来可以跟我去一趟图书馆……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261878,
          "spk": "名护 (ナゴ)",
          "ja": "嬉しいんだけど……いいかな？",
          "tc": "你方便嗎？",
          "sc": "你方便吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4560,
      "rec_id": "TALK_ID_10_0401_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261902,
          "spk": "名护 (ナゴ)",
          "ja": "外へ出る方法を調べていた時に、",
          "tc": "我在調查從這裡出去的方法時，",
          "sc": "我在调查从这里出去的方法时，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261909,
          "spk": "名护 (ナゴ)",
          "ja": "この本を見つけたんだ",
          "tc": "找到了這本書。",
          "sc": "找到了这本书。"
        }
      ]
    },
    {
