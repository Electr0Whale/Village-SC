{
  "batch_id": "batch_191_talk",
  "group": "talk",
  "files": [
    "talk.dat"
  ],
  "record_count": 39,
  "line_count": 198,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4521,
      "rec_id": "TALK_ID_10_0303_062_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259601,
          "spk": "名护 (ナゴ)",
          "ja": "今住んでいる家に置いてあったんだが、",
          "tc": "這本來是放在我現在住的房子裡面，",
          "sc": "这本来是放在我现在住的房子里面，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259608,
          "spk": "名护 (ナゴ)",
          "ja": "俺よりキミの方が使う機会が多いと思ってね",
          "tc": "但我想你應該比我更有機會用到它，",
          "sc": "但我想你应该比我更有机会用到它，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259619,
          "spk": "名护 (ナゴ)",
          "ja": "キスケさんに直してもらったんだよ",
          "tc": "所以我就請木助先生修好了它。",
          "sc": "所以我就请木助先生修好了它。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259632,
          "spk": "木助 (キスケ)",
          "ja": "まあ、てめぇらの働きを見ていたら、",
          "tc": "好啦，看到你們工作那麼認真，",
          "sc": "好啦，看到你们工作那么认真，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259639,
          "spk": "木助 (キスケ)",
          "ja": "俺も働いて返す気がおきたんでな",
          "tc": "我也想用工作來回報你們，",
          "sc": "我也想用工作来回报你们，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 259655,
          "spk": "木助 (キスケ)",
          "ja": "タダで直してやったんだぜ",
          "tc": "所以就免費幫忙修了。",
          "sc": "所以就免费帮忙修了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 259668,
          "spk": "名护 (ナゴ)",
          "ja": "お金に比べたら大したものではないけれど、",
          "tc": "跟錢比起來，這或許算不了什麼，",
          "sc": "跟钱比起来，这或许算不了什么，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 259675,
          "spk": "名护 (ナゴ)",
          "ja": "受け取ってもらえると嬉しいよ",
          "tc": "但我還是希望你能收下它。",
          "sc": "但我还是希望你能收下它。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 259691,
          "spk": "名护 (ナゴ)",
          "ja": "家に帰ることができたら、",
          "tc": "如果能回家，",
          "sc": "如果能回家，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 259698,
          "spk": "名护 (ナゴ)",
          "ja": "もっと良いものをプレゼントできるだろう",
          "tc": "就能送你更好的東西，",
          "sc": "就能送你更好的东西，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 259705,
          "spk": "名护 (ナゴ)",
          "ja": "本当のお礼は、その時に……",
          "tc": "到時候再給你真正的謝禮吧……",
          "sc": "到时候再给你真正的谢礼吧……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 259718,
          "spk": "木助 (キスケ)",
          "ja": "全く、てめぇは……",
          "tc": "真受不了……你這傢伙……",
          "sc": "真受不了……你这家伙……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 259725,
          "spk": "木助 (キスケ)",
          "ja": "まだ街に帰るとか言ってんのか",
          "tc": "還在嚷嚷著要回城裡啊？",
          "sc": "还在嚷嚷着要回城里啊？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 259736,
          "spk": "木助 (キスケ)",
          "ja": "仕事まで与えてやったのに、",
          "tc": "都讓你有份工作做了，",
          "sc": "都让你有份工作做了，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 259743,
          "spk": "木助 (キスケ)",
          "ja": "何が不満なんだよ",
          "tc": "還有什麼好不滿的？",
          "sc": "还有什么好不满的？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4522,
      "rec_id": "TALK_ID_10_0303_062_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259761,
          "spk": "名护 (ナゴ)",
          "ja": "当たり前だろ、",
          "tc": "這還用說嗎？",
          "sc": "这还用说吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259768,
          "spk": "名护 (ナゴ)",
          "ja": "本当の家が街にあるんだから",
          "tc": "我真正的家就在城市裡啊。",
          "sc": "我真正的家就在城市里啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4523,
      "rec_id": "TALK_ID_10_0303_062_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259786,
          "spk": "名护 (ナゴ)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259793,
          "spk": "名护 (ナゴ)",
          "ja": "でも、帰る前までに鈴も",
          "tc": "但在回家之前，",
          "sc": "但在回家之前，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259800,
          "spk": "名护 (ナゴ)",
          "ja": "見つけ出せたらいいんだけれどな……",
          "tc": "要是能找回鈴鐺就好了……",
          "sc": "要是能找回铃铛就好了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259813,
          "spk": "木助 (キスケ)",
          "ja": "鈴……？",
          "tc": "鈴鐺……？",
          "sc": "铃铛……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259820,
          "spk": "木助 (キスケ)",
          "ja": "財布の次は、鈴なんか探してんのか",
          "tc": "找到了錢包，這次換找鈴鐺是嗎？",
          "sc": "找到了钱包，这次换找铃铛是吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259827,
          "spk": "木助 (キスケ)",
          "ja": "そりゃそんなに大事なモンなのか？",
          "tc": "那東西有那麼重要嗎？",
          "sc": "那东西有那么重要吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4524,
      "rec_id": "TALK_ID_10_0303_062_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259845,
          "spk": "名护 (ナゴ)",
          "ja": "……形見なんだよ",
          "tc": "……那是遺物。",
          "sc": "……那是遗物。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259852,
          "spk": "名护 (ナゴ)",
          "ja": "昔、実家で飼っていた猫の",
          "tc": "是我以前老家養的貓留下來的。",
          "sc": "是我以前老家养的猫留下来的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259861,
          "spk": "名护 (ナゴ)",
          "ja": "仕事していた時に亡くなって……",
          "tc": "牠在我上班的時候去世了……",
          "sc": "它在我上班的时候去世了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259868,
          "spk": "名护 (ナゴ)",
          "ja": "死に目に会えなかったんだ",
          "tc": "我沒能見到牠最後一面。",
          "sc": "我没能见到它最后一面。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259879,
          "spk": "名护 (ナゴ)",
          "ja": "だから、せめて",
          "tc": "所以我想說至少",
          "sc": "所以我想说至少"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259886,
          "spk": "名护 (ナゴ)",
          "ja": "形見はずっと側にって思って……",
          "tc": "想把牠的遺物一直帶在身邊……",
          "sc": "想把它的遗物一直带在身边……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4525,
      "rec_id": "TALK_ID_10_0303_062_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 259904,
          "spk": "木助 (キスケ)",
          "ja": "そんなに大切な鈴が無くなったのか？",
          "tc": "你弄丟了那麼重要的鈴鐺？",
          "sc": "你弄丢了那么重要的铃铛？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 259911,
          "spk": "木助 (キスケ)",
          "ja": "そりゃあ、この土地がてめぇを",
          "tc": "那就是這片土地",
          "sc": "那就是这片土地"
        },
        {
          "f_idx": 2,
          "pidx_tc": 259918,
          "spk": "木助 (キスケ)",
          "ja": "逃がしたくないってことだろうよ",
          "tc": "不想讓你離開了。",
          "sc": "不想让你离开了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 259929,
          "spk": "木助 (キスケ)",
          "ja": "ずっとここに住んでりゃいいじゃねえか",
          "tc": "就一直住在這裡不就好了。",
          "sc": "就一直住在这里不就好了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 259942,
          "spk": "名护 (ナゴ)",
          "ja": "嫌に決まっているだろ",
          "tc": "我當然不要啊。",
          "sc": "我当然不要啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 259953,
          "spk": "名护 (ナゴ)",
          "ja": "我が家では、積読している本やゲーム、",
          "tc": "我家裡有堆著沒讀的書、沒玩的遊戲，",
          "sc": "我家里有堆着没读的书、没玩的游戏，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 259960,
          "spk": "名护 (ナゴ)",
          "ja": "完成させていないプラモと……",
          "tc": "還有沒完成的模型……",
          "sc": "还有没完成的模型……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 259969,
          "spk": "名护 (ナゴ)",
          "ja": "そして喧嘩してから数ヶ月間、",
          "tc": "也有自從吵架之後，",
          "sc": "也有自从吵架之后，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 259976,
          "spk": "名护 (ナゴ)",
          "ja": "顔を合わせていない彼女が",
          "tc": "已經好幾個月沒見到面的女朋友",
          "sc": "已经好几个月没见到面的女朋友"
        },
        {
          "f_idx": 9,
          "pidx_tc": 259983,
          "spk": "名护 (ナゴ)",
          "ja": "俺を待っているんだよ",
          "tc": "還在城裡等著我啊。",
          "sc": "还在城里等着我啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 259996,
          "spk": "木助 (キスケ)",
          "ja": "ふうん……それって",
          "tc": "哦……那些",
          "sc": "哦……那些"
        },
        {
          "f_idx": 11,
          "pidx_tc": 260003,
          "spk": "木助 (キスケ)",
          "ja": "そんなに大事なことなのか？",
          "tc": "真的有那麼重要嗎？",
          "sc": "真的有那么重要吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 260012,
          "spk": "木助 (キスケ)",
          "ja": "どれもこれも、",
          "tc": "那些不都是",
          "sc": "那些不都是"
        },
        {
          "f_idx": 13,
          "pidx_tc": 260019,
          "spk": "木助 (キスケ)",
          "ja": "放置しているだけじゃねえか",
          "tc": "你放著沒去動的東西嗎？",
          "sc": "你放着没去动的东西吗？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 260030,
          "spk": "木助 (キスケ)",
          "ja": "それらのために帰る必要なんて、あるのかよ",
          "tc": "有必要為了那些東西回去嗎？",
          "sc": "有必要为了那些东西回去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4526,
      "rec_id": "TALK_ID_10_0303_062_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260048,
          "spk": "名护 (ナゴ)",
          "ja": "そ、それは……",
          "tc": "這、這個……",
          "sc": "这、这个……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 260059,
          "spk": "名护 (ナゴ)",
          "ja": "いや、帰るべきだろ",
          "tc": "不，我應該要回去。",
          "sc": "不，我应该要回去。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 260066,
          "spk": "名护 (ナゴ)",
          "ja": "あそこが俺の帰る家なんだから",
          "tc": "因為那裡就是我該回去的家。",
          "sc": "因为那里就是我该回去的家。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 260079,
          "spk": "木助 (キスケ)",
          "ja": "間違っちゃいけねえ",
          "tc": "你可別搞錯了，",
          "sc": "你可别搞错了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 260086,
          "spk": "木助 (キスケ)",
          "ja": "その帰るべき家ってのに、",
          "tc": "你所謂應該回去的家裡，",
          "sc": "你所谓应该回去的家里，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 260093,
          "spk": "木助 (キスケ)",
          "ja": "その形見の鈴以上に大切なもんがあるのか",
          "tc": "有比那遺物鈴鐺還重要的東西嗎？",
          "sc": "有比那遗物铃铛还重要的东西吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 260102,
          "spk": "木助 (キスケ)",
          "ja": "本当に必要な物以外、",
          "tc": "除了真的必要的東西之外，",
          "sc": "除了真的必要的东西之外，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 260109,
          "spk": "木助 (キスケ)",
          "ja": "いつ捨ててもいいものだ",
          "tc": "其他都是隨時可以捨棄的。",
          "sc": "其他都是随时可以舍弃的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 260129,
          "spk": "名护 (ナゴ)",
          "ja": "……それは極論だろ",
          "tc": "……那說法也太極端了。",
          "sc": "……那说法也太极端了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4527,
      "rec_id": "TALK_ID_10_0303_062_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260147,
          "spk": "名护 (ナゴ)",
          "ja": "それでも、家があるのであれば、",
          "tc": "無論如何，既然那是我的家，",
          "sc": "无论如何，既然那是我的家，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 260154,
          "spk": "名护 (ナゴ)",
          "ja": "俺はそこへ帰るべきなんだ",
          "tc": "我就該回到那裡去。",
          "sc": "我就该回到那里去。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 260165,
          "spk": "名护 (ナゴ)",
          "ja": "こんな、深夜になると不気味な現象が起きて、",
          "tc": "這種一到深夜就會發生詭異現象，",
          "sc": "这种一到深夜就会发生诡异现象，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 260172,
          "spk": "名护 (ナゴ)",
          "ja": "妙な風習も残っていて、村長の命令に",
          "tc": "還留存著異常習俗，",
          "sc": "还留存着异常习俗，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 260179,
          "spk": "名护 (ナゴ)",
          "ja": "従わなきゃいけないような村には住めないぞ……",
          "tc": "甚至不得不聽從村長命令的村子，我才不住……",
          "sc": "甚至不得不听从村长命令的村子，我才不住……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 260192,
          "spk": "木助 (キスケ)",
          "ja": "風習や命令って……掟のことか？",
          "tc": "你說習俗和命令……是指規矩嗎？",
          "sc": "你说习俗和命令……是指规矩吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4528,
      "rec_id": "TALK_ID_10_0303_062_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260225,
          "spk": "木助 (キスケ)",
          "ja": "<strong>「掟の三、見知らぬ者に近づくな」</strong>",
          "tc": "<strong>「規矩之三，別靠近陌生人」，</strong>",
          "sc": "<strong>“规矩之三，别靠近陌生人”，</strong>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 260236,
          "spk": "木助 (キスケ)",
          "ja": "<strong>これは深夜になると現れる、",
          "tc": "<strong>這是為了保護在彼津生活的人，",
          "sc": "<strong>这是为了保护在彼津生活的人，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 260243,
          "spk": "木助 (キスケ)",
          "ja": "人知の及ばねぇ連中から、",
          "tc": "避免遭受那些在深夜現身、",
          "sc": "避免遭受那些在深夜现身、"
        },
        {
          "f_idx": 3,
          "pidx_tc": 260250,
          "spk": "木助 (キスケ)",
          "ja": "彼ヶ津で暮らす者を守るためのものだ</strong>",
          "tc": "人智無法理解的傢伙傷害。</strong>",
          "sc": "人智无法理解的家伙伤害。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4529,
      "rec_id": "TALK_ID_10_0303_062_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260276,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの言う通り、ここは安全な場所じゃねえ",
          "tc": "如你所說，這裡並不是個安全的地方，",
          "sc": "如你所说，这里并不是个安全的地方，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 260283,
          "spk": "木助 (キスケ)",
          "ja": "だからこそ村を知るヤツの言う事を",
          "tc": "所以更應該乖乖聽",
          "sc": "所以更应该乖乖听"
        },
        {
          "f_idx": 2,
          "pidx_tc": 260290,
          "spk": "木助 (キスケ)",
          "ja": "聞いとけって話だぜ",
          "tc": "知道這村子狀況的人說的話。",
