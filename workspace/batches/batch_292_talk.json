      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448612,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>にも何か夢があるの？",
          "tc": "<player>也有夢想嗎？",
          "sc": "<player>也有梦想吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 448619,
