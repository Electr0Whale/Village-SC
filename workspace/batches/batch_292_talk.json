    {
      "file": "talk.dat",
      "rec_idx": 8513,
      "rec_id": "TALK_ID_10_0101_020_04_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206818,
          "spk": "林 (リン)",
          "ja": "その他には……そうね",
          "tc": "至於其他的事……我想想……",
          "sc": "至于其他的事……我想想……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 206825,
          "spk": "林 (リン)",
          "ja": "釣りをしていいかもしれないわ",
          "tc": "也可以試試看釣魚吧。",
          "sc": "也可以试试看钓鱼吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8514,
      "rec_id": "TALK_ID_10_0101_021_14_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207824,
          "spk": "木助 (キスケ)",
          "ja": "……これで、てめぇもこの土地に",
          "tc": "……這樣一來，你也與這片土地",
          "sc": "……这样一来，你也与这片土地"
        },
        {
          "f_idx": 1,
          "pidx_tc": 207831,
          "spk": "木助 (キスケ)",
          "ja": "しがらみができちまったな",
          "tc": "產生了羈絆。",
          "sc": "产生了羁绊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8515,
      "rec_id": "TALK_ID_10_0101_021_14_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208123,
          "spk": "木助 (キスケ)",
          "ja": "……<player>、てめぇは目を閉じてな",
          "tc": "<player>，你把眼睛閉上吧。",
          "sc": "<player>，你把眼睛闭上吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208130,
          "spk": "木助 (キスケ)",
          "ja": "あ、あと、耳も塞いでおけ",
          "tc": "對了，也把耳朵塞住。",
          "sc": "对了，也把耳朵塞住。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8516,
      "rec_id": "TALK_ID_10_0101_021_14_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207856,
          "spk": "木助 (キスケ)",
          "ja": "だが、てめぇはまだ……",
          "tc": "不過，你還……",
          "sc": "不过，你还……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8517,
      "rec_id": "TALK_ID_10_0101_021_14_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208148,
          "spk": "木助 (キスケ)",
          "ja": "いいんだよ",
          "tc": "沒事的。",
          "sc": "没事的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208155,
          "spk": "木助 (キスケ)",
          "ja": "ほら、<player>、",
          "tc": "好了，<player>，",
          "sc": "好了，<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208162,
          "spk": "木助 (キスケ)",
          "ja": "早く背を向けて目と耳を塞げ",
          "tc": "快轉過身去，閉上眼睛、塞住耳朵。",
          "sc": "快转过身去，闭上眼睛、塞住耳朵。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8518,
      "rec_id": "TALK_ID_10_0102_030_01_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208945,
          "spk": "裕太 (ユータ)",
          "ja": "それはちょうどよかった！",
          "tc": "那真是太剛好了！",
          "sc": "那真是太刚好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208952,
          "spk": "裕太 (ユータ)",
          "ja": "お店が開いてなくて、",
          "tc": "看妳沒開店，",
          "sc": "看你没开店，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208959,
          "spk": "裕太 (ユータ)",
          "ja": "困ってたところだったから",
          "tc": "我正煩惱著。",
          "sc": "我正烦恼着。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208972,
          "spk": "茶梅 (サザンカ)",
          "ja": "ユータ……今日は定休日だよ……",
          "tc": "裕太……今天可是公休日欸……",
          "sc": "裕太……今天可是休息日诶……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208979,
          "spk": "茶梅 (サザンカ)",
          "ja": "いい加減覚えなって",
          "tc": "你好歹也該記住了吧。",
          "sc": "你好歹也该记住了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 208992,
          "spk": "裕太 (ユータ)",
          "ja": "……あ、そうか、今日は金曜日だったね",
          "tc": "……啊，對欸，今天是星期五。",
          "sc": "……啊，对诶，今天是星期五。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 208999,
          "spk": "裕太 (ユータ)",
          "ja": "この村に来てから、毎日休日みたいなものだから",
          "tc": "自從來到這個村子，感覺每天都像假日。",
          "sc": "自从来到这个村子，感觉每天都像假日。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 209006,
          "spk": "裕太 (ユータ)",
          "ja": "曜日感覚が狂っちゃって……",
          "tc": "都分不清是星期幾了……",
          "sc": "都分不清是星期几了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 209019,
          "spk": "茶梅 (サザンカ)",
          "ja": "全く、しゃーないね",
          "tc": "真是拿你沒辦法。",
          "sc": "真是拿你没办法。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 209026,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタもついでに、買い物してっていいよ",
          "tc": "你也可以一起買東西喔。",
          "sc": "你也可以一起买东西哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 209033,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>に感謝してよね",
          "tc": "好好感謝<player>吧。",
          "sc": "好好感谢<player>吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8519,
      "rec_id": "TALK_ID_10_0102_030_01_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209059,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、キミのおかげで助かったよ",
          "tc": "<player>，多虧有你，",
          "sc": "<player>，多亏有你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209066,
          "spk": "裕太 (ユータ)",
          "ja": "俺も買い物させてもらえるんだって",
          "tc": "我也能買東西了。",
          "sc": "我也能买东西了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209073,
          "spk": "裕太 (ユータ)",
          "ja": "お礼にこれ、受け取ってくれるかい？",
          "tc": "你願意收下這個當作我的謝禮嗎？",
          "sc": "你愿意收下这个当作我的谢礼吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8520,
      "rec_id": "TALK_ID_10_0102_030_01_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209204,
          "spk": "茶梅 (サザンカ)",
          "ja": "ところでユータ、アンタは何買うん？",
          "tc": "話說回來，裕太，你要買什麼？",
          "sc": "话说回来，裕太，你要买什么？"
        }
      ]
    }
  ]
