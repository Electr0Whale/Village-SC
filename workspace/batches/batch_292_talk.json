          "spk": "琪娜娜 (チナナ)",
          "ja": "そういえばウチの趣味って",
          "tc": "這麼說起來，",
          "sc": "这么说起来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 394461,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだろうな",
          "tc": "我的興趣是什麼呢？",
          "sc": "我的兴趣是什么呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 394472,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……強いて言うなら……",
          "tc": "嗯……硬要說的話……",
          "sc": "嗯……硬要说的话……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 394479,
          "spk": "琪娜娜 (チナナ)",
          "ja": "料理の仕込みかな？",
          "tc": "就是做料理的備料了吧？",
          "sc": "就是做料理的备料了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8493,
      "rec_id": "TALK_ID_70_2150_007_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396174,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっ、ウチと一緒だね",
          "tc": "哦，跟我一樣耶，",
          "sc": "哦，跟我一样呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396181,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、気が合うじゃないか",
          "tc": "<player>，我們很合得來嘛。",
          "sc": "<player>，我们很合得来嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8494,
      "rec_id": "TALK_ID_70_2150_007_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396199,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、じゃあ残ったコレが好物なんだね",
          "tc": "喔？那還沒吃的就是你喜歡的東西囉。",
          "sc": "喔？那还没吃的就是你喜欢的东西啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396206,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しかし、好きなものを最後に残すだなんて、",
          "tc": "不過你把喜歡的東西留到最後，",
          "sc": "不过你把喜欢的东西留到最后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396213,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチとは真逆だねえ",
          "tc": "跟我完全相反耶。",
          "sc": "跟我完全相反呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8495,
      "rec_id": "TALK_ID_70_2150_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396609,
          "spk": "琪娜娜 (チナナ)",
          "ja": "味付き玉子、おいしいよねえ",
          "tc": "醬油溏心蛋真的很好吃對吧，",
          "sc": "酱油溏心蛋真的很好吃对吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは一晩漬け込んだくらいのが",
          "tc": "我尤其喜歡",
          "sc": "我尤其喜欢"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "特に好きだよ",
          "tc": "泡醬油泡過一整晚的那種。",
          "sc": "泡酱油泡过一整晚的那种。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396634,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃ、<player>は味付き玉子で",
          "tc": "那<player>你吃醬油溏心蛋，",
          "sc": "那<player>你吃酱油溏心蛋，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396641,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは目玉焼きだ",
          "tc": "我就吃荷包蛋囉。",
          "sc": "我就吃煎蛋啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8496,
      "rec_id": "TALK_ID_70_2150_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396659,
          "spk": "琪娜娜 (チナナ)",
          "ja": "目玉焼きは半熟にしてあるよ",
          "tc": "荷包蛋我是做半熟的喔，",
          "sc": "荷包蛋我是做半熟的哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396666,
          "spk": "琪娜娜 (チナナ)",
          "ja": "とろっとした黄身を麺に絡めて",
          "tc": "讓濃郁的蛋黃巴住麵體，",
          "sc": "让浓郁的蛋黄巴住面体，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396673,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べるとおいしいんだよねえ",
          "tc": "吃起來特別好吃呢。",
          "sc": "吃起来特别好吃呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396684,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃ、<player>は目玉焼きで",
          "tc": "那<player>你吃荷包蛋，",
          "sc": "那<player>你吃荷包蛋，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396691,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは味付き玉子だ",
          "tc": "我就吃醬油溏心蛋囉。",
          "sc": "我就吃卤蛋啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8497,
      "rec_id": "TALK_ID_70_2150_009_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397017,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっ",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397024,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一緒にシュワシュワ",
          "tc": "你要跟我",
          "sc": "你要跟我"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397031,
          "spk": "琪娜娜 (チナナ)",
          "ja": "してくれるんだ？",
          "tc": "一起喝嗎？",
          "sc": "一起喝吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397042,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあ、キミには",
          "tc": "那我就拿",
          "sc": "那我就拿"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397049,
          "spk": "琪娜娜 (チナナ)",
          "ja": "サイダーをあげよう",
          "tc": "汽水給你吧。",
          "sc": "汽水给你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8498,
      "rec_id": "TALK_ID_70_2150_009_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397067,
          "spk": "琪娜娜 (チナナ)",
          "ja": "残念",
          "tc": "可惜了，",
          "sc": "可惜了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397074,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一緒にシュワシュワは",
          "tc": "看來會冒泡泡的飲料",
          "sc": "看来会冒泡泡的饮料"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397081,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まだ早いか",
          "tc": "對你來說還太早了。",
          "sc": "对你来说还太早了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397092,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあ、キミには",
          "tc": "那我就拿",
          "sc": "那我就拿"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397099,
          "spk": "琪娜娜 (チナナ)",
          "ja": "オレンジジュースをあげよう",
          "tc": "柳橙汁給你吧。",
          "sc": "柳橙汁给你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8499,
      "rec_id": "TALK_ID_70_2150_010_08_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397709,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ありがとうね",
          "tc": "……謝謝你，",
          "sc": "……谢谢你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397716,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そう言ってもらえると",
          "tc": "你這樣講",
          "sc": "你这样讲"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397723,
          "spk": "琪娜娜 (チナナ)",
          "ja": "救われるよ",
          "tc": "讓我感覺得到了救贖。",
          "sc": "让我感觉得到了救赎。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8500,
      "rec_id": "TALK_ID_70_2150_010_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397739,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手厳しいねえ",
          "tc": "好嚴厲啊。",
          "sc": "好严厉啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397746,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……やっぱり、",
          "tc": "……果然",
          "sc": "……果然"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397753,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだったのかな",
          "tc": "是不太好的吧。",
          "sc": "是不太好的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8501,
      "rec_id": "TALK_ID_90_3001_001_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470408,
          "spk": "林 (リン)",
          "ja": "……は？",
          "tc": "……啊？",
          "sc": "……啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470415,
          "spk": "林 (リン)",
          "ja": "わからないですって……？",
          "tc": "你說你不知道……？",
          "sc": "你说你不知道……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470428,
          "spk": "驹子 (コマコ)",
          "ja": "あっ……",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470435,
          "spk": "驹子 (コマコ)",
          "ja": "そういえば<player>は、",
          "tc": "這麼說來，",
          "sc": "这么说来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470442,
          "spk": "驹子 (コマコ)",
          "ja": "記憶がないんだったね……",
          "tc": "<player>沒有以前的記憶嘛……",
          "sc": "<player>没有以前的记忆嘛……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 470453,
          "spk": "驹子 (コマコ)",
          "ja": "自分がどこから来たのかもわからないのに、",
          "tc": "連自己是從哪裡來的都想不起來，",
          "sc": "连自己是从哪里来的都想不起来，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 470460,
          "spk": "驹子 (コマコ)",
          "ja": "誕生日だけ覚えてるわけないよね……",
          "tc": "怎麼會記得生日是什麼時候呢……",
          "sc": "怎么会记得生日是什么时候呢……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 470480,
          "spk": "林 (リン)",
          "ja": "うーん……困ったわね",
          "tc": "唔……真是傷腦筋呢。",
          "sc": "唔……真是伤脑筋呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 470487,
          "spk": "林 (リン)",
          "ja": "せっかくみんながお祝いしたくても、",
          "tc": "就算大家都想幫你慶祝，",
          "sc": "就算大家都想帮你庆祝，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 470494,
          "spk": "林 (リン)",
          "ja": "日にちが分からないんじゃどうしようも……",
          "tc": "但不知道日期的話也沒辦法……",
          "sc": "但不知道日期的话也没办法……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 470505,
          "spk": "林 (リン)",
          "ja": "……そうだわ！",
          "tc": "……對了！",
          "sc": "……对了！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 470512,
          "spk": "林 (リン)",
          "ja": "分からないなら、",
          "tc": "既然不知道，",
          "sc": "既然不知道，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 470519,
          "spk": "林 (リン)",
          "ja": "自分で決めればいいじゃない",
          "tc": "那自己決定不就好了嗎？",
          "sc": "那自己决定不就好了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8502,
      "rec_id": "TALK_ID_90_3001_001_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470537,
          "spk": "驹子 (コマコ)",
          "ja": "えっ！？",
          "tc": "咦！？",
          "sc": "咦！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470544,
          "spk": "驹子 (コマコ)",
          "ja": "自分で決めちゃっていいの？",
          "tc": "可以自己決定嗎？",
          "sc": "可以自己决定吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8503,
      "rec_id": "TALK_ID_90_3001_001_06_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470562,
          "spk": "林 (リン)",
          "ja": "分からないんだから仕方ないでしょ",
          "tc": "既然不知道，那就沒辦法了呀。",
          "sc": "既然不知道，那就没办法了呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470569,
          "spk": "林 (リン)",
          "ja": "誕生日が無いと困るのは私たちなのよ",
          "tc": "沒有能慶祝的生日，會傷腦筋的可是我們啊。",
          "sc": "没有能庆祝的生日，会伤脑筋的可是我们啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470589,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そっか……そうだね",
          "tc": "對、對喔……說的也是。",
          "sc": "对、对哦……说的也是。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470596,
          "spk": "驹子 (コマコ)",
          "ja": "お誕生日が無いと、寂しいもんね……",
          "tc": "要是沒有生日，總覺得有點寂寞呢……",
          "sc": "要是没有生日，总觉得有点寂寞呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8504,
      "rec_id": "TALK_ID_90_3001_001_06_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470616,
          "spk": "林 (リン)",
          "ja": "ほら、<player>！",
          "tc": "來吧，<player>！",
          "sc": "来吧，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470623,
          "spk": "林 (リン)",
          "ja": "あなたの誕生日、今すぐに決めなさい！",
          "tc": "現在馬上決定你的生日吧！",
          "sc": "现在马上决定你的生日吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470630,
          "spk": "林 (リン)",
          "ja": "今日からその日が、あなたの誕生日よ",
          "tc": "從今天起，那一天就是你的生日了！",
          "sc": "从今天起，那一天就是你的生日了！"
        }
      ]
    },
