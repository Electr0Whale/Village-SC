  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7069,
      "rec_id": "TALK_ID_70_2050_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 401883,
          "spk": "林 (リン)",
          "ja": "みんな、集まってくれてありがとう",
          "tc": "感謝各位抽空前來，",
          "sc": "感谢各位抽空前来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 401890,
          "spk": "林 (リン)",
          "ja": "今日は大事な話があるの",
          "tc": "今天我有重要的事情要告訴大家。",
          "sc": "今天我有重要的事情要告诉大家。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 401908,
          "spk": "林 (リン)",
          "ja": "今まで、お金の問題もあって",
          "tc": "之前我們因為資金的問題，",
          "sc": "之前我们因为资金的问题，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 401915,
          "spk": "林 (リン)",
          "ja": "大掛かりな事業には",
          "tc": "一直都沒有",
          "sc": "一直都没有"
        },
        {
          "f_idx": 5,
          "pidx_tc": 401922,
          "spk": "林 (リン)",
          "ja": "手を出さないでいたけど……",
          "tc": "執行過什麼大型的計畫……",
          "sc": "执行过什么大型的计划……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 401933,
          "spk": "林 (リン)",
          "ja": "みんなのがんばりのおかげで",
          "tc": "但現在多虧了有大家的努力，",
          "sc": "但现在多亏了有大家的努力，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 401940,
          "spk": "林 (リン)",
          "ja": "資金が潤ってきたから、",
          "tc": "村裡的經費變得比以前充沛了，",
          "sc": "村里的经费变得比以前充沛了，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 401947,
          "spk": "林 (リン)",
          "ja": "そろそろ検討しようと思うの",
          "tc": "所以我覺得差不多可以開始考慮一些計畫了。",
          "sc": "所以我觉得差不多可以开始考虑一些计划了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7070,
      "rec_id": "TALK_ID_70_2050_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 401971,
          "spk": "六角 (ロッカク)",
          "ja": "お～、いいっスね～！",
          "tc": "喔～好棒喔～！",
          "sc": "喔～挺不错呐～！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 401984,
          "spk": "驹子 (コマコ)",
          "ja": "ふふ、にぎやかになりそうだね！",
          "tc": "呵呵，感覺會變得很熱鬧呢！",
          "sc": "呵呵，感觉会变得很热闹呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 401997,
          "spk": "裕太 (ユータ)",
          "ja": "もう何か案はあるのかな？",
          "tc": "村長是不是已經有什麼想法了呢？",
          "sc": "村长是不是已经有什么想法了呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402010,
          "spk": "林 (リン)",
          "ja": "まずはみんなから募集するわ！",
          "tc": "我想先徵求大家的意見！",
          "sc": "我想先征求大家的意见！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402017,
          "spk": "林 (リン)",
          "ja": "何か作りたいものや、やりたいことはある？",
          "tc": "各位有什麼想做的東西，或是想做的事嗎？",
          "sc": "各位有什么想做的东西，或是想做的事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7071,
      "rec_id": "TALK_ID_70_2050_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402056,
          "spk": "茶梅 (サザンカ)",
          "ja": "う～ん……",
          "tc": "嗯～",
          "sc": "嗯～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402063,
          "spk": "茶梅 (サザンカ)",
          "ja": "いろいろとなくはないけどさ～？",
          "tc": "雖然也不是沒有啦～",
          "sc": "虽然也不是没有啦～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402076,
          "spk": "四郎治 (シロージ)",
          "ja": "どうせお前、却下するだろ",
          "tc": "但反正你會拒絕吧。",
          "sc": "但反正你会拒绝吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7072,
      "rec_id": "TALK_ID_70_2050_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402102,
          "spk": "林 (リン)",
          "ja": "あら……どうしたの？",
          "tc": "哎呀……大家是怎麼了？",
          "sc": "哎呀……大家是怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402109,
          "spk": "林 (リン)",
          "ja": "どんどんアイデアが出るものだと思ってたのに",
          "tc": "我還以為大家會積極地發表意見呢。",
          "sc": "我还以为大家会积极地发表意见呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402120,
          "spk": "林 (リン)",
          "ja": "あぁ、もしかして、",
          "tc": "啊，難道說，",
          "sc": "啊，难道说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402127,
          "spk": "林 (リン)",
          "ja": "みんなの前で言うのが恥ずかしいのかしら？",
          "tc": "是不敢在大家的面前說出來嗎？",
          "sc": "是不敢在大家的面前说出来吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402134,
          "spk": "林 (リン)",
          "ja": "まったく、照れ屋が多いんだから",
          "tc": "真是的，大家都太害羞了。",
          "sc": "真是的，大家都太害羞了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7073,
      "rec_id": "TALK_ID_70_2050_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402152,
          "spk": "林 (リン)",
          "ja": "仕方ないわね",
          "tc": "真拿你們沒辦法，",
          "sc": "真拿你们没办法，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402159,
          "spk": "林 (リン)",
          "ja": "じゃあ先に、私が考えてきた",
          "tc": "那就由我先來發表",
          "sc": "那就由我先来发表"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402166,
          "spk": "林 (リン)",
          "ja": "アイデアを発表するわ",
          "tc": "我想到的主意吧。",
          "sc": "我想到的主意吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402177,
          "spk": "林 (リン)",
          "ja": "まずは……この村のすぐそばに、",
          "tc": "首先是……我想要在這個村子旁邊",
          "sc": "首先是……我想要在这个村子旁边"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402184,
          "spk": "林 (リン)",
          "ja": "大規模なテーマパークを建てる案よ！",
          "tc": "蓋一座大規模的主題樂園！",
          "sc": "盖一座大规模的主题乐园！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7074,
      "rec_id": "TALK_ID_70_2050_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402204,
          "spk": "六角 (ロッカク)",
          "ja": "テ、テーマパーク……？",
          "tc": "主、主題樂園……？",
          "sc": "主、主题乐园……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402217,
          "spk": "林 (リン)",
          "ja": "ええ、村の外の人たちが",
          "tc": "沒錯，這麼一來外地的遊客",
          "sc": "没错，这么一来外地的游客"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402224,
          "spk": "林 (リン)",
          "ja": "こぞって遊びに来るでしょうね",
          "tc": "就會爭先恐後地跑過來玩了吧。",
          "sc": "就会争先恐后地跑过来玩了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402235,
          "spk": "林 (リン)",
          "ja": "いくらかかるかは試算してないけど、",
          "tc": "雖然我是沒算過這需要多少經費，",
          "sc": "虽然我是没算过这需要多少经费，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402242,
          "spk": "林 (リン)",
          "ja": "まぁ余裕で建てられると思うわ",
          "tc": "但我想應該沒問題吧。",
          "sc": "但我想应该没问题吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 402249,
          "spk": "林 (リン)",
          "ja": "みんなも協力してちょうだいね？",
          "tc": "大家也要一起幫忙喔？",
          "sc": "大家也要一起帮忙哦？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7075,
      "rec_id": "TALK_ID_70_2050_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402271,
          "spk": "林 (リン)",
          "ja": "それから……村の近くで",
          "tc": "然後……如果能在村子附近",
          "sc": "然后……如果能在村子附近"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402278,
          "spk": "林 (リン)",
          "ja": "古代の遺跡でも掘り出して、",
          "tc": "挖出古代遺跡，",
          "sc": "挖出古代遗迹，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402285,
          "spk": "林 (リン)",
          "ja": "観光地にするのもいいわね！",
          "tc": "就這樣變成觀光景點也不錯呢！",
          "sc": "就这样变成观光景点也不错呢！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7076,
      "rec_id": "TALK_ID_70_2050_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402305,
          "spk": "驹子 (コマコ)",
          "ja": "い、遺跡……！？",
          "tc": "遺、遺跡……！？",
          "sc": "遗、遗迹……！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402318,
          "spk": "林 (リン)",
          "ja": "ええ、そうよ",
          "tc": "對啊，",
          "sc": "对啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402325,
          "spk": "林 (リン)",
          "ja": "遺跡の一つや二つ、",
          "tc": "遺跡之類的，",
          "sc": "遗迹之类的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402332,
          "spk": "林 (リン)",
          "ja": "そこらへんを掘ればすぐ出てくるでしょ",
          "tc": "這附近應該可以挖得出一兩個吧。",
          "sc": "这附近应该可以挖得出一两个吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402343,
          "spk": "林 (リン)",
          "ja": "住民のみんなで、",
          "tc": "所有的村民",
          "sc": "所有的村民"
        },
        {
          "f_idx": 5,
          "pidx_tc": 402350,
          "spk": "林 (リン)",
          "ja": "日がな一日地面を掘りつづけるの",
          "tc": "日以繼夜地挖就好了。",
          "sc": "日以继夜地挖就好了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 402357,
          "spk": "林 (リン)",
          "ja": "どうかしら？　やってみない？",
          "tc": "怎麼樣？要不要來試試看？",
          "sc": "怎么样？要不要来试试看？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7077,
      "rec_id": "TALK_ID_70_2050_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402381,
          "spk": "帷 (トバリ)",
          "ja": "待ってよ、リン！",
          "tc": "等一下啦，林！",
          "sc": "等一下啦，林！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402388,
          "spk": "帷 (トバリ)",
          "ja": "そんな計画、無茶すぎるって……",
          "tc": "妳這些計畫也太亂來了……",
          "sc": "你这些计划也太乱来了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402401,
          "spk": "林 (リン)",
          "ja": "あら、そう？",
          "tc": "哎呀，是嗎？",
          "sc": "哎呀，是吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402408,
          "spk": "林 (リン)",
          "ja": "じゃあ何か案はあるの？",
          "tc": "那你們有什麼想法？",
          "sc": "那你们有什么想法？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7078,
      "rec_id": "TALK_ID_70_2050_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402434,
          "spk": "帷 (トバリ)",
          "ja": "そうね……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402441,
          "spk": "帷 (トバリ)",
          "ja": "観光のことを考えるなら、",
          "tc": "要發展觀光的話，",
          "sc": "要发展观光的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402448,
          "spk": "帷 (トバリ)",
          "ja": "村のお土産を考案するとか……？",
          "tc": "想一個我們村子的伴手禮怎麼樣……？",
          "sc": "想一个我们村子的伴手礼怎么样……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7079,
      "rec_id": "TALK_ID_70_2050_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402468,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それいいね！",
          "tc": "好主意！",
          "sc": "好主意！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402475,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この村ならではの特産品なんかも",
          "tc": "像是這座村莊的特產什麼的，",
          "sc": "像是这座村庄的特产什么的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402482,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウケがいいはずだよ",
          "tc": "應該會很受歡迎喔。",
          "sc": "应该会很受欢迎哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7080,
      "rec_id": "TALK_ID_70_2050_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402502,
          "spk": "裕太 (ユータ)",
          "ja": "田舎らしさに憧れる人も",
          "tc": "我想也有不少人",
          "sc": "我想也有不少人"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402509,
          "spk": "裕太 (ユータ)",
          "ja": "少なくないはずだ",
          "tc": "是憧憬著鄉村生活的，",
          "sc": "是憧憬着乡村生活的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402516,
          "spk": "裕太 (ユータ)",
          "ja": "そういう魅力を押し出すのもアリじゃないかな",
          "tc": "以這點作為魅力應該也不錯吧？",
          "sc": "以这点作为魅力应该也不错吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7081,
      "rec_id": "TALK_ID_70_2050_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402536,
          "spk": "木助 (キスケ)",
          "ja": "観光客が来るってなると、",
          "tc": "如果有觀光客要來的話，",
          "sc": "如果有观光客要来的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402543,
          "spk": "木助 (キスケ)",
          "ja": "宿も準備しとかないといけねぇよな？",
          "tc": "那也得做好旅館的規畫才行吧？",
          "sc": "那也得做好旅馆的规画才行吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7082,
      "rec_id": "TALK_ID_70_2050_006_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402580,
          "spk": "林 (リン)",
          "ja": "いいじゃない！",
          "tc": "不錯嘛！",
          "sc": "不错嘛！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402587,
          "spk": "林 (リン)",
          "ja": "みんなの意見、本格的に検討するわ",
          "tc": "我會認真考慮大家的提議的，",
          "sc": "我会认真考虑大家的提议的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402594,
          "spk": "林 (リン)",
          "ja": "他にも案があったら教えてちょうだい！",
          "tc": "如果還有其他點子，也都儘管告訴我吧！",
          "sc": "如果还有其他点子，也都尽管告诉我吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7083,
      "rec_id": "TALK_ID_70_2050_006_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402618,
          "spk": "林 (リン)",
          "ja": "ふふふ……",
          "tc": "呵呵呵……",
          "sc": "呵呵呵……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402625,
          "spk": "林 (リン)",
          "ja": "私の作戦はどうだった、<player>？",
          "tc": "我的作戰計畫怎麼樣啊，<player>？",
          "sc": "我的作战计划怎么样啊，<player>？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402636,
          "spk": "林 (リン)",
          "ja": "あえて無茶な案を出すことで",
          "tc": "故意提出一些很荒謬的主意，",
          "sc": "故意提出一些很荒谬的主意，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402643,
          "spk": "林 (リン)",
          "ja": "みんなから意見を引き出すテクニック……",
          "tc": "藉此引出大家的意見……",
          "sc": "借此引出大家的意见……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402650,
