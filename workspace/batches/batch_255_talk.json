    {
      "file": "talk.dat",
      "rec_idx": 7097,
      "rec_id": "TALK_ID_70_2050_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 403684,
          "spk": "林 (リン)",
          "ja": "実はね、",
          "tc": "其實，",
          "sc": "其实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 403691,
          "spk": "林 (リン)",
          "ja": "今日はあなたにお礼を言いたくて呼んだの",
          "tc": "我今天是為了跟你道謝才找你來的。",
          "sc": "我今天是为了跟你道谢才找你来的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 403702,
          "spk": "林 (リン)",
          "ja": "私に……正直に悩みを打ち明けて、",
          "tc": "你教會我……誠實地說出煩惱，",
          "sc": "你教会我……诚实地说出烦恼，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 403709,
          "spk": "林 (リン)",
          "ja": "人に頼ることを教えてくれたでしょう？",
          "tc": "去依賴他人，對吧？",
          "sc": "去依赖他人，对吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 403727,
          "spk": "林 (リン)",
          "ja": "あれから、仕事の量は変わっていないのに、",
          "tc": "在那之後，工作量雖然還是一樣，",
          "sc": "在那之后，工作量虽然还是一样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 403734,
          "spk": "林 (リン)",
          "ja": "不思議と心の負担が軽くなったの……",
          "tc": "但內心的負擔卻很神奇地減輕了……",
          "sc": "但内心的负担却很神奇地减轻了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 403741,
          "spk": "林 (リン)",
          "ja": "……あなたのおかげね",
          "tc": "……這都是多虧了你。",
          "sc": "……这都是多亏了你。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 403752,
          "spk": "林 (リン)",
          "ja": "そうだ……",
          "tc": "對了……",
          "sc": "对了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 403759,
          "spk": "林 (リン)",
          "ja": "ちょうど今、あなたに相談したい",
          "tc": "我正好有件是想跟你商量，",
          "sc": "我正好有件是想跟你商量，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 403766,
          "spk": "林 (リン)",
          "ja": "深刻な悩み事があって……",
          "tc": "是一個很嚴重的問題……",
          "sc": "是一个很严重的问题……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 403777,
          "spk": "林 (リン)",
          "ja": "この屋敷、広いでしょう",
          "tc": "你看，這間屋子不是很大嗎？",
          "sc": "你看，这间屋子不是很大吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 403784,
          "spk": "林 (リン)",
          "ja": "なかなか掃除が間に合わないのよね……",
          "tc": "所以我每次打掃總是掃不完……",
          "sc": "所以我每次打扫总是扫不完……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 403795,
          "spk": "林 (リン)",
          "ja": "好意で泊めてあげるんだから",
          "tc": "我這麼好心讓你留下來過夜，",
          "sc": "我这么好心让你留下来过夜，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 403802,
          "spk": "林 (リン)",
          "ja": "当然、頼まれてくれるわよね？",
          "tc": "你當然會答應我的請求吧？",
          "sc": "你当然会答应我的请求吧？"
        }
      ]
    },
    {
