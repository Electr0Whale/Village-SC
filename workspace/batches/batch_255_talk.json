    {
      "file": "talk.dat",
      "rec_idx": 7101,
      "rec_id": "TALK_ID_70_2050_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 404027,
          "spk": "林 (リン)",
          "ja": "急なことを聞くんだけど",
          "tc": "雖然這麼問很突然，",
          "sc": "虽然这么问很突然，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 404034,
          "spk": "林 (リン)",
          "ja": "あなたは私のことを、どう思っているのかしら",
          "tc": "但我想問問看你對我有什麼看法。",
          "sc": "但我想问问看你对我有什么看法。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 404043,
          "spk": "林 (リン)",
          "ja": "ほら……私って、村のみんなから",
          "tc": "你看嘛……",
          "sc": "你看嘛……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 404050,
          "spk": "林 (リン)",
          "ja": "煙たがられているでしょう？",
          "tc": "村裡的大家不是都討厭我嗎？",
          "sc": "村里的大家不是都讨厌我吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 404059,
          "spk": "林 (リン)",
          "ja": "今でこそ、私の本心も",
          "tc": "雖然現在大家都已經",
          "sc": "虽然现在大家都已经"
        },
        {
          "f_idx": 5,
          "pidx_tc": 404066,
          "spk": "林 (リン)",
          "ja": "村のみんなには知られて……",
          "tc": "明白了我內心真正的想法……",
          "sc": "明白了我内心真正的想法……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 404075,
          "spk": "林 (リン)",
          "ja": "トバリとも和解できたし、",
          "tc": "而且我不僅跟帷和解了，",
          "sc": "而且我不仅跟帷和解了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 404082,
          "spk": "林 (リン)",
          "ja": "村のみんなとも本心で話せるようになって、",
          "tc": "也開始能對村裡的大家說出真心話，",
          "sc": "也开始能对村里的大家说出真心话，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 404089,
          "spk": "林 (リン)",
          "ja": "私も、少し気が楽になった……",
          "tc": "我的心情上也比較輕鬆了……",
          "sc": "我的心情上也比较轻松了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 404098,
          "spk": "林 (リン)",
          "ja": "でも、私は村を守ることを口実に、",
          "tc": "但是，畢竟我曾經以保護村子為藉口，",
          "sc": "但是，毕竟我曾经以保护村子为借口，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 404105,
          "spk": "林 (リン)",
          "ja": "みんなにずっと不自由な暮らしを強いてきた……",
          "tc": "強迫大家過著處處受限的生活……",
          "sc": "强迫大家过着处处受限的生活……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 404112,
          "spk": "林 (リン)",
          "ja": "この事実がなかったことになるわけじゃない……",
          "tc": "不可能當作沒有這件事情發生……",
          "sc": "不可能当作没有这件事情发生……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 404121,
          "spk": "林 (リン)",
          "ja": "……村長らしく振る舞おうって、",
          "tc": "……我想這就是擺出村長的架子，",
          "sc": "……我想这就是摆出村长的架子，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 404128,
          "spk": "林 (リン)",
          "ja": "ずっと偉そうにしてきたツケよね",
          "tc": "讓自己高高在上的代價吧。",
          "sc": "让自己高高在上的代价吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 404144,
          "spk": "林 (リン)",
          "ja": "これはもう、時間が解決してくれるのを",
          "tc": "所以我想",
          "sc": "所以我想"
