    {
      "file": "talk.dat",
      "rec_idx": 7084,
      "rec_id": "TALK_ID_70_2050_006_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 402668,
          "spk": "林 (リン)",
          "ja": "なに驚いてるのよ？",
          "tc": "幹嘛那麼驚訝？",
          "sc": "干嘛那么惊讶？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 402675,
          "spk": "林 (リン)",
          "ja": "私があんなデタラメな案を出すわけないでしょ",
          "tc": "我怎麼可能會提出那種亂七八糟的主意嘛。",
          "sc": "我怎么可能会提出那种乱七八糟的主意嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 402686,
          "spk": "林 (リン)",
          "ja": "さて……みんなの意見ももらったし、",
          "tc": "好了……既然已經得到了大家的意見，",
          "sc": "好了……既然已经得到了大家的意见，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 402693,
          "spk": "林 (リン)",
          "ja": "これから考えるべきことがたくさんあるわね",
          "tc": "那接下來就有許多事要來考慮了。",
          "sc": "那接下来就有许多事要来考虑了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 402704,
          "spk": "林 (リン)",
          "ja": "あなたの協力も不可欠よ",
          "tc": "你的幫助也是不可或缺的，",
          "sc": "你的帮助也是不可或缺的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 402711,
          "spk": "林 (リン)",
          "ja": "何かあったら頼らせてもらうわ",
          "tc": "所以如果有什麼事，我會再拜託你的。",
          "sc": "所以如果有什么事，我会再拜托你的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 402722,
          "spk": "林 (リン)",
          "ja": "あなたのこと、信頼してるから",
          "tc": "我很信賴你喔。",
          "sc": "我很信赖你哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
