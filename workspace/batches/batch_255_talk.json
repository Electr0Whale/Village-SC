          "spk": "林 (リン)",
          "ja": "まさに大地の恵みよ",
          "tc": "正所謂是大地的恩惠呢。",
          "sc": "正所谓是大地的恩惠呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 403583,
          "spk": "林 (リン)",
          "ja": "何より、この村の山で",
          "tc": "而且更重要的是，",
          "sc": "而且更重要的是，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 403590,
          "spk": "林 (リン)",
          "ja": "育ってきた山菜だもの",
          "tc": "這是在這座村子的山裡培育出的山菜，",
          "sc": "这是在这座村子的山里培育出的山菜，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 403597,
          "spk": "林 (リン)",
          "ja": "美味しくないわけがないわ",
          "tc": "當然很好吃。",
          "sc": "当然很好吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 403608,
          "spk": "林 (リン)",
          "ja": "あなたも彼ヶ津の土に",
          "tc": "你在品嘗的同時，",
          "sc": "你在品尝的同时，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 403615,
          "spk": "林 (リン)",
