        },
        {
          "f_idx": 2,
          "pidx_tc": 403851,
          "spk": "林 (リン)",
          "ja": "ダニと一緒に寝る趣味はないでしょう？",
          "tc": "你不會有和塵蟎一起睡的嗜好吧？",
          "sc": "你不会有和尘螨一起睡的嗜好吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 403858,
          "spk": "林 (リン)",
          "ja": "あなたのために、目一杯干しておいたの",
          "tc": "我可是為了你好好地曬了棉被，",
          "sc": "我可是为了你好好地晒了棉被，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 403865,
          "spk": "林 (リン)",
          "ja": "だから、安心して使ってちょうだい",
          "tc": "你可以安心使用。",
          "sc": "你可以安心使用。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 403876,
          "spk": "林 (リン)",
          "ja": "ほら、遠慮しないで",
          "tc": "來，別客氣，",
          "sc": "来，别客气，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 403883,
          "spk": "林 (リン)",
          "ja": "太陽の匂いに包まれて、しっかり休みなさい",
          "tc": "在太陽氣味的包圍下，好好地休息吧。",
          "sc": "在太阳气味的包围下，好好地休息吧。"
