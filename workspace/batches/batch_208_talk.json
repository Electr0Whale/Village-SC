      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295325,
          "spk": "林 (リン)",
          "ja": "ポストすら切れないのに、",
          "tc": "連個郵筒都劈不開，",
          "sc": "连个邮筒都劈不开，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295332,
          "spk": "林 (リン)",
          "ja": "土地神が切れるのかしら？",
          "tc": "那要怎麼傷到土地神呢？",
          "sc": "那要怎么伤到土地神呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295352,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5086,
      "rec_id": "TALK_ID_10_0500_030_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295370,
          "spk": "林 (リン)",
          "ja": "ほら、<player>",
          "tc": "來，<player>。",
          "sc": "来，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295377,
          "spk": "林 (リン)",
          "ja": "岩切りナタを使って",
          "tc": "快點拿起劈岩柴刀",
          "sc": "快点拿起劈岩柴刀"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295384,
          "spk": "林 (リン)",
          "ja": "ポストを切ってみなさい",
          "tc": "劈劈看這個郵筒吧。",
          "sc": "劈劈看这个邮筒吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5087,
      "rec_id": "TALK_ID_10_0500_030_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295410,
          "spk": "林 (リン)",
          "ja": "こら、言う事を聞きなさい！",
          "tc": "好了，快照我說的做！",
          "sc": "好了，快照我说的做！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295421,
          "spk": "林 (リン)",
          "ja": "簡単でしょ、ポストをナタで叩くだけよ",
          "tc": "又不難，只要拿柴刀敲郵筒就可以了。",
          "sc": "又不难，只要拿柴刀敲邮筒就可以了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295428,
          "spk": "林 (リン)",
          "ja": "いつもあなたがやっている、",
          "tc": "就跟你平常劈開岩石",
          "sc": "就跟你平常劈开岩石"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295435,
          "spk": "林 (リン)",
          "ja": "岩や木屑を割るみたいにね",
          "tc": "或是木材一樣。",
          "sc": "或是木材一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5088,
      "rec_id": "TALK_ID_10_0500_030_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295459,
          "spk": "林 (リン)",
          "ja": "もう忘れたのかしら？",
          "tc": "難道你已經忘記了嗎？",
          "sc": "难道你已经忘记了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295466,
          "spk": "林 (リン)",
          "ja": "岩切りナタを使って、",
          "tc": "快點拿起劈岩柴刀",
          "sc": "快点拿起劈岩柴刀"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295473,
          "spk": "林 (リン)",
          "ja": "ポストを切ってみなさい",
          "tc": "劈劈看這個郵筒吧。",
          "sc": "劈劈看这个邮筒吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295482,
          "spk": "林 (リン)",
          "ja": "それくらいもできないなら、",
          "tc": "如果連這點事都做不到，",
          "sc": "如果连这点事都做不到，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 295489,
          "spk": "林 (リン)",
          "ja": "土地神を切ることなんてできないわよ",
          "tc": "就別妄想去砍土地神了。",
          "sc": "就别妄想去砍土地神了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5089,
      "rec_id": "TALK_ID_10_0500_030_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295520,
          "spk": "帷 (トバリ)",
          "ja": "そんなはず……",
          "tc": "才不會……",
          "sc": "才不会……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295527,
          "spk": "帷 (トバリ)",
          "ja": "これで、土地神を倒せるはずなのに……",
          "tc": "應該可以用這個打倒土地神才對……",
          "sc": "应该可以用这个打倒土地神才对……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5090,
      "rec_id": "TALK_ID_10_0500_030_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295553,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5091,
      "rec_id": "TALK_ID_10_0500_030_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295571,
          "spk": "林 (リン)",
          "ja": "……さすが神器、大したものだわ",
          "tc": "……不愧是神器，真了不起啊。",
          "sc": "……不愧是神器，真了不起啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295578,
          "spk": "林 (リン)",
          "ja": "この調子じゃ「奇跡の呼笛」も期待できるわね",
          "tc": "照這樣看來，「奇蹟的呼笛」也很值得期待呢。",
          "sc": "照这样看来，“奇迹的呼笛”也很值得期待呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5092,
      "rec_id": "TALK_ID_10_0500_030_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295603,
          "spk": "林 (リン)",
          "ja": "じゃあ<player>、次はこのポストに",
          "tc": "接下來，就請<player>你對著這個郵筒，",
          "sc": "接下来，就请<player>你对着这个邮筒，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295610,
          "spk": "林 (リン)",
          "ja": "奇跡の呼笛を試してもらおうかしら",
          "tc": "使用「奇蹟的呼笛」看看吧。",
          "sc": "使用“奇迹的呼笛”看看吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295628,
          "spk": "林 (リン)",
          "ja": "伝承によると「奇跡の呼笛」を聞かせた物は、",
          "tc": "根據傳說，對著物體吹響「奇蹟的呼笛」，",
          "sc": "根据传说，对着物体吹响“奇迹的呼笛”，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 295635,
          "spk": "林 (リン)",
          "ja": "その時間が巻き戻り、",
          "tc": "該物體的時間會倒轉，",
          "sc": "该物体的时间会倒转，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 295642,
          "spk": "林 (リン)",
          "ja": "死すらもなかったことになるそうじゃない",
          "tc": "甚至能起死回生。",
          "sc": "甚至能起死回生。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 295653,
          "spk": "林 (リン)",
          "ja": "その話が本当なら、ポストはただの鉄の板……",
          "tc": "照理來說，郵筒應該會變回鐵板……",
          "sc": "照理来说，邮筒应该会变回铁板……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 295660,
          "spk": "林 (リン)",
          "ja": "いいえ、鉄鉱石に戻るはずだから",
          "tc": "不，會恢復成鐵礦石才對。",
          "sc": "不，会恢复成铁矿石才对。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 295680,
          "spk": "帷 (トバリ)",
          "ja": "<player>、もういいわ",
          "tc": "<player>，已經夠了。",
          "sc": "<player>，已经够了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 295687,
          "spk": "帷 (トバリ)",
          "ja": "これ以上……",
          "tc": "你不用再繼續……",
          "sc": "你不用再继续……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5093,
      "rec_id": "TALK_ID_10_0500_030_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295705,
          "spk": "林 (リン)",
          "ja": "だめよ、トバリ",
          "tc": "這可不行，帷。",
          "sc": "这可不行，帷。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295714,
          "spk": "林 (リン)",
          "ja": "神器に意味がなかったら、",
          "tc": "要是神器沒有意義，",
          "sc": "要是神器没有意义，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295721,
          "spk": "林 (リン)",
          "ja": "神を殺すことはできないもの",
          "tc": "那就沒辦法殺死神明了啊。",
          "sc": "那就没办法杀死神明了啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295728,
          "spk": "林 (リン)",
          "ja": "ここではっきりさせないといけないわ",
          "tc": "必須現在就搞清楚才行。",
          "sc": "必须现在就搞清楚才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5094,
      "rec_id": "TALK_ID_10_0500_030_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295746,
          "spk": "林 (リン)",
          "ja": "人にどうしても働いてもらいたいなら、",
          "tc": "既然無論如何都想請別人做事，",
          "sc": "既然无论如何都想请别人做事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295753,
          "spk": "林 (リン)",
          "ja": "先払い……でしょう？",
          "tc": "那就得先付報酬……不是嗎？",
          "sc": "那就得先付报酬……不是吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295771,
          "spk": "林 (リン)",
          "ja": "はい、これが対価よ",
          "tc": "來，這就是酬勞。",
          "sc": "来，这就是酬劳。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5095,
      "rec_id": "TALK_ID_10_0500_030_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295799,
          "spk": "林 (リン)",
          "ja": "さあ、お願いよ",
          "tc": "好了，拜託你囉，",
          "sc": "好了，拜托你啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295806,
          "spk": "林 (リン)",
          "ja": "私に、奇跡の呼笛の効果を見せてちょうだい",
          "tc": "讓我看看「奇蹟的呼笛」的效果。",
          "sc": "让我看看“奇迹的呼笛”的效果。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5096,
      "rec_id": "TALK_ID_10_0500_030_25",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295834,
          "spk": "帷 (トバリ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295841,
          "spk": "帷 (トバリ)",
          "ja": "一体どうしてアンタは、なにかをもらったら",
          "tc": "到底為什麼你只要收了東西，",
          "sc": "到底为什么你只要收了东西，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295848,
          "spk": "帷 (トバリ)",
          "ja": "断れなくなるの……",
          "tc": "就會無法拒絕別人的要求啊……",
          "sc": "就会无法拒绝别人的要求啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295857,
          "spk": "帷 (トバリ)",
          "ja": "自分の意志を主張できるようになったコマコを、",
          "tc": "駒子現在已經會表達自己的意見了，",
          "sc": "驹子现在已经会表达自己的意见了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 295864,
          "spk": "帷 (トバリ)",
          "ja": "少しは見習いなさいよ……",
          "tc": "你多少學學她吧……",
          "sc": "你多少学学她吧……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 295877,
          "spk": "林 (リン)",
          "ja": "トバリ……よくわかったでしょう",
          "tc": "帷……這下妳已經明白了吧。",
          "sc": "帷……这下你已经明白了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5097,
      "rec_id": "TALK_ID_10_0500_030_26",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295895,
          "spk": "林 (リン)",
          "ja": "わずかな希望、縋りたくなる気持ちはわかるわ",
          "tc": "我能理解那種想抓住一絲希望的心情。",
          "sc": "我能理解那种想抓住一丝希望的心情。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295902,
          "spk": "林 (リン)",
          "ja": "でも昔話は全て本当じゃない",
          "tc": "但是，傳說故事並非全都是真的。",
          "sc": "但是，传说故事并非全都是真的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295922,
          "spk": "帷 (トバリ)",
          "ja": "……せっかく<player>が集めたのに",
          "tc": "……這些是<player>好不容易收集的，",
          "sc": "……这些是<player>好不容易收集的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 295929,
          "spk": "帷 (トバリ)",
          "ja": "一体どうして……",
          "tc": "到底為什麼……",
          "sc": "到底为什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5098,
      "rec_id": "TALK_ID_10_0500_030_27",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295947,
          "spk": "林 (リン)",
          "ja": "……<player>、邪魔したわね",
          "tc": "……打擾你了，<player>。",
          "sc": "……打扰你了，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 295954,
          "spk": "林 (リン)",
          "ja": "私達、もう帰るわ",
          "tc": "我們要回去了。",
          "sc": "我们要回去了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 295965,
          "spk": "林 (リン)",
          "ja": "あなたも、神器のことはもう忘れて、",
          "tc": "你也忘掉神器的事，",
          "sc": "你也忘掉神器的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295972,
          "spk": "林 (リン)",
          "ja": "本来の仕事に戻りなさい",
          "tc": "回去做你原本的工作吧。",
          "sc": "回去做你原本的工作吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5099,
      "rec_id": "TALK_ID_10_0500_030_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295997,
          "spk": "林 (リン)",
          "ja": "さあ、いくわよトバリ",
          "tc": "好了，帷，走吧。",
          "sc": "好了，帷，走吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296004,
          "spk": "林 (リン)",
          "ja": "それじゃあね、<player>",
          "tc": "那就再見了，<player>。",
          "sc": "那就再见了，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
