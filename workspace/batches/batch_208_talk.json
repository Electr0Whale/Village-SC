    {
      "file": "talk.dat",
      "rec_idx": 5101,
      "rec_id": "TALK_ID_10_0500_031_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296050,
          "spk": "帷 (トバリ)",
          "ja": "ごめん、ちょっといい",
          "tc": "抱歉，可以打擾一下嗎？",
          "sc": "抱歉，可以打扰一下吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296057,
          "spk": "帷 (トバリ)",
          "ja": "アンタに頼みがあって来たんだけど……",
          "tc": "我過來是有事情想拜託你……",
          "sc": "我过来是有事情想拜托你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 296068,
          "spk": "帷 (トバリ)",
          "ja": "私ね……",
          "tc": "我打算……",
          "sc": "我打算……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 296075,
          "spk": "帷 (トバリ)",
          "ja": "あの大穴に行こうと思っているの",
          "tc": "到那個大洞去。",
          "sc": "到那个大洞去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5102,
      "rec_id": "TALK_ID_10_0500_031_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296093,
          "spk": "帷 (トバリ)",
          "ja": "今から、変な話をするんだけど……",
          "tc": "我接下來要講的事可能很難以置信……",
          "sc": "我接下来要讲的事可能很难以置信……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296100,
          "spk": "帷 (トバリ)",
          "ja": "……アンタなら信じてくれそうだから",
          "tc": "……但我覺得你應該會相信我。",
          "sc": "……但我觉得你应该会相信我。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 296107,
          "spk": "帷 (トバリ)",
          "ja": "他の人には言わないで",
          "tc": "別跟其他人說喔！",
          "sc": "别跟其他人说！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5103,
      "rec_id": "TALK_ID_10_0500_031_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296125,
          "spk": "帷 (トバリ)",
          "ja": "……夢で、コダマに会ったの",
          "tc": "……我在夢裡見到了木珠。",
          "sc": "……我在梦里见到了木珠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296136,
          "spk": "帷 (トバリ)",
          "ja": "コダマは、大穴の前で泣いてた",
          "tc": "祂在大洞前面一直哭，",
          "sc": "他在大洞前面一直哭，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 296143,
          "spk": "帷 (トバリ)",
          "ja": "泣きながら、私に頼んできたの",
          "tc": "邊哭邊拜託我說，",
          "sc": "边哭边拜托我说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 296150,
          "spk": "帷 (トバリ)",
          "ja": "もう覚悟ができた、村を蝕む神を殺すって……",
          "tc": "祂已經下定決心，要殺死侵蝕村子的神明……",
          "sc": "他已经下定决心，要杀死侵蚀村子的神明……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 296159,
          "spk": "帷 (トバリ)",
          "ja": "なにやら急いでるみたいで……",
          "tc": "感覺祂很著急……",
          "sc": "感觉他很着急……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 296166,
          "spk": "帷 (トバリ)",
          "ja": "もしかしたら、またこの前みたいに、",
          "tc": "說不定是土地神的封印，",
          "sc": "说不定是土地神的封印，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 296173,
          "spk": "帷 (トバリ)",
          "ja": "土地神の封印が解けかけているのかも……",
          "tc": "又像之前那樣快要撐不住……",
          "sc": "又像之前那样快要撑不住……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 296184,
          "spk": "帷 (トバリ)",
          "ja": "私は、コダマと協力して、",
          "tc": "我打算跟木珠合作",
          "sc": "我打算跟木珠合作"
        },
        {
          "f_idx": 8,
          "pidx_tc": 296191,
          "spk": "帷 (トバリ)",
          "ja": "土地神を倒したいと思っている",
          "tc": "一起打倒土地神。",
          "sc": "一起打倒土地神。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5104,
      "rec_id": "TALK_ID_10_0500_031_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296209,
          "spk": "帷 (トバリ)",
          "ja": "アンタも察してるでしょ",
          "tc": "你也注意到了吧？",
          "sc": "你也注意到了吧？"
