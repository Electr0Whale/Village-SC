      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1610,
          "spk": "木助 (キスケ)",
          "ja": "品評前のピリッとした空気、",
          "tc": "我很喜歡進行評鑑前",
          "sc": "我很喜欢进行评鉴前"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1617,
          "spk": "木助 (キスケ)",
          "ja": "俺は好きなんだよ",
          "tc": "那種緊張的氣氛。",
          "sc": "那种紧张的气氛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 1628,
          "spk": "木助 (キスケ)",
          "ja": "やっぱ勝負ってのは",
          "tc": "果然要一較高下",
          "sc": "果然要一较高下"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1635,
          "spk": "木助 (キスケ)",
          "ja": "こうじゃねぇとなぁ",
          "tc": "就是得這樣才行啊。",
          "sc": "就是得这样才行啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 277,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1659,
          "spk": "木助 (キスケ)",
          "ja": "……ったく、",
          "tc": "……真是的，",
          "sc": "……真是的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1666,
          "spk": "木助 (キスケ)",
          "ja": "朝っぱらから設営に駆り出されて……",
          "tc": "一大早就被叫去搭建場地……",
          "sc": "一大早就被叫去搭建场地……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 1677,
          "spk": "木助 (キスケ)",
          "ja": "ん？お、<player>！",
          "tc": "嗯？哦，<player>！",
          "sc": "嗯？哦，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1684,
          "spk": "木助 (キスケ)",
          "ja": "ちょっと頼まれてくれ",
          "tc": "可以拜託你一件事嗎？",
          "sc": "可以拜托你一件事吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 1695,
          "spk": "木助 (キスケ)",
          "ja": "リンのところ行って、",
          "tc": "你去林那邊，",
          "sc": "你去林那边，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 1702,
          "spk": "木助 (キスケ)",
          "ja": "そろそろ始めちゃくれねぇかって",
          "tc": "跟她說",
          "sc": "跟她说"
        },
        {
          "f_idx": 6,
          "pidx_tc": 1709,
          "spk": "木助 (キスケ)",
          "ja": "頼んできてくれよ",
          "tc": "差不多可以開始了。",
          "sc": "差不多可以开始了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 278,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1733,
          "spk": "木助 (キスケ)",
          "ja": "花の良し悪しなんざ",
          "tc": "我是不太懂",
          "sc": "我是不太懂"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1740,
          "spk": "木助 (キスケ)",
          "ja": "俺にはイマイチわからんが……",
          "tc": "花的好壞啦……",
          "sc": "花的好坏啦……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 1751,
          "spk": "木助 (キスケ)",
          "ja": "美味い飯と美味い酒があるなら",
          "tc": "但如果有美味的飯菜跟美酒，",
          "sc": "但如果有美味的饭菜跟美酒，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1758,
          "spk": "木助 (キスケ)",
          "ja": "花見は大歓迎だ",
          "tc": "要賞花我可是很歡迎的。",
          "sc": "要赏花我可是很欢迎的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 1776,
          "spk": "木助 (キスケ)",
          "ja": "ほら、てめぇも遠慮すんな",
          "tc": "來，你也別客氣，",
          "sc": "来，你也别客气，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 1783,
          "spk": "木助 (キスケ)",
          "ja": "好きなだけ食っていいぜ",
          "tc": "盡量多吃點吧。",
          "sc": "尽量多吃点吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 1799,
          "spk": "木助 (キスケ)",
          "ja": "こういう時は楽しまねぇと",
          "tc": "這種時候就應該盡情享樂，",
          "sc": "这种时候就应该尽情享乐，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 1806,
          "spk": "木助 (キスケ)",
          "ja": "人生損だからな",
          "tc": "不然人生可是會吃虧的。",
          "sc": "不然人生可是会吃亏的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 279,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1830,
          "spk": "木助 (キスケ)",
          "ja": "おう、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1837,
          "spk": "木助 (キスケ)",
          "ja": "ヨーヨー釣りやってくか？",
          "tc": "要不要來玩釣水球啊？",
          "sc": "要不要来玩钓水球啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1855,
          "spk": "木助 (キスケ)",
          "ja": "ちょっとコツがあるんだが、",
          "tc": "雖然需要點訣竅，",
          "sc": "虽然需要点诀窍，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 1862,
          "spk": "木助 (キスケ)",
          "ja": "俺が一から教えてやる",
          "tc": "但我會從頭教你的。",
          "sc": "但我会从头教你的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 1873,
          "spk": "木助 (キスケ)",
          "ja": "興味があるなら",
          "tc": "你有興趣的話",
          "sc": "你有兴趣的话"
        },
        {
          "f_idx": 6,
          "pidx_tc": 1880,
          "spk": "木助 (キスケ)",
          "ja": "好きなだけやっていきな",
          "tc": "就盡量玩吧。",
          "sc": "就尽量玩吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 1891,
          "spk": "木助 (キスケ)",
          "ja": "お代？　なーに、気にすんな",
          "tc": "費用？你不用在意這種事啦，",
          "sc": "费用？你不用在意这种事啦，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 1898,
          "spk": "木助 (キスケ)",
          "ja": "今日は全部俺の奢りだぜ",
          "tc": "今天就算我請客。",
          "sc": "今天就算我请客。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 280,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1922,
          "spk": "木助 (キスケ)",
          "ja": "ったく……",
          "tc": "受不了……",
          "sc": "受不了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1929,
          "spk": "木助 (キスケ)",
          "ja": "イベントがあるたびに叩き起こされて……",
          "tc": "每次只要有活動就會被吵醒……",
          "sc": "每次只要有活动就会被吵醒……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 1947,
          "spk": "木助 (キスケ)",
          "ja": "これで美味いもの食えなかったら",
          "tc": "要是還不能吃到美味的東西，",
          "sc": "要是还不能吃到美味的东西，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 1954,
          "spk": "木助 (キスケ)",
          "ja": "割に合わねぇぜ",
          "tc": "那可真不划算啊。",
          "sc": "那可真不划算啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 281,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 1985,
          "spk": "木助 (キスケ)",
          "ja": "はぁ～……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 1992,
          "spk": "木助 (キスケ)",
          "ja": "ダメだってわかってんだがよ……",
          "tc": "雖然知道不行……",
          "sc": "虽然知道不行……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 2003,
          "spk": "木助 (キスケ)",
          "ja": "この祭壇……眺めていたら、",
          "tc": "但看著這個祭壇……",
          "sc": "但看着这个祭坛……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2010,
          "spk": "木助 (キスケ)",
          "ja": "出来が気になってきて、",
          "tc": "就很在意它的完成度，",
          "sc": "就很在意它的完成度，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 2017,
          "spk": "木助 (キスケ)",
          "ja": "ぶっ壊して作り直したくなってくるぜ",
          "tc": "很想全部打掉重做呢。",
          "sc": "很想全部打掉重做呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 2028,
          "spk": "木助 (キスケ)",
          "ja": "……大丈夫だ",
          "tc": "……沒事啦，",
          "sc": "……没事啦，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 2035,
          "spk": "木助 (キスケ)",
          "ja": "さすがに祭の楽しそうな雰囲気に",
          "tc": "祭典上大家都玩得這麼開心，",
          "sc": "祭典上大家都玩得这么开心，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 2042,
          "spk": "木助 (キスケ)",
          "ja": "水差すようなことはしねぇって",
          "tc": "我是不會做出這種潑冷水的舉動的。",
          "sc": "我是不会做出这种泼冷水的举动的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 282,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2066,
          "spk": "木助 (キスケ)",
          "ja": "よーし、これで全部揃ったな！",
          "tc": "好～這樣就全部到齊了！",
          "sc": "好～这样就全部到齐了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 2073,
          "spk": "木助 (キスケ)",
          "ja": "……おう<player>！",
          "tc": "……唷，<player>！",
          "sc": "……哟，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 2084,
          "spk": "木助 (キスケ)",
          "ja": "お前もあとで餅つきに来いよ",
          "tc": "你也來搗麻糬吧。",
          "sc": "你也来捣年糕吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2091,
          "spk": "木助 (キスケ)",
          "ja": "年に１度のイベントだ、逃しちゃ損だぜ",
          "tc": "一年一度的活動，錯失機會就太可惜了。",
          "sc": "一年一度的活动，错失机会就太可惜了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 283,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2122,
          "spk": "木助 (キスケ)",
          "ja": "俺は餅つきが好きなんだ",
          "tc": "我很喜歡搗麻糬，",
          "sc": "我很喜欢捣年糕，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 2129,
          "spk": "木助 (キスケ)",
          "ja": "思いっきり木槌を振れるからな",
          "tc": "因為可以盡情地揮動木槌。",
          "sc": "因为可以尽情地挥动木槌。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2147,
          "spk": "木助 (キスケ)",
          "ja": "それに、臼も頑丈に作ったから、",
          "tc": "而且木臼也做得很堅固，",
          "sc": "而且木臼也做得很坚固，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 2154,
          "spk": "木助 (キスケ)",
          "ja": "中々壊れねぇはずだ",
          "tc": "應該不會輕易壞掉。",
          "sc": "应该不会轻易坏掉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 2172,
          "spk": "木助 (キスケ)",
          "ja": "だから、血が滾っちまってよ……",
          "tc": "所以我整個人是熱血沸騰……",
          "sc": "所以我整个人是热血沸腾……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 2179,
          "spk": "木助 (キスケ)",
          "ja": "あん？　肝心のモチはどうなんだって？",
          "tc": "嗯？你問作為主角的麻糬嗎？",
          "sc": "嗯？你问作为主角的年糕吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 2190,
          "spk": "木助 (キスケ)",
          "ja": "まあ、美味いに越したことはないが……",
          "tc": "當然能好吃是最好啦……",
          "sc": "当然能好吃是最好啦……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 2197,
          "spk": "木助 (キスケ)",
          "ja": "俺にとっちゃおまけだな",
          "tc": "但對我來說那只是順便而已。",
          "sc": "但对我来说那只是顺便而已。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 284,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2221,
          "spk": "木助 (キスケ)",
          "ja": "ん？　てめぇの番は？",
          "tc": "嗯？怎麼沒輪到你？",
          "sc": "嗯？怎么没轮到你？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 2228,
          "spk": "木助 (キスケ)",
          "ja": "……参加してねぇのか？",
          "tc": "……難道你沒有參加嗎？",
          "sc": "……难道你没有参加吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 2239,
          "spk": "木助 (キスケ)",
          "ja": "期待していたんだがなぁ……",
          "tc": "虧我還很期待的……",
          "sc": "亏我还很期待的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2246,
          "spk": "木助 (キスケ)",
          "ja": "ま、次は楽しませてくれよ",
          "tc": "你下次記得要參加喔。",
          "sc": "下次你可得参加啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 285,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2270,
          "spk": "木助 (キスケ)",
          "ja": "すげぇな、<player>！",
          "tc": "你好厲害啊，<player>！",
          "sc": "你好厉害啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 2277,
          "spk": "木助 (キスケ)",
          "ja": "最高評価じゃねぇか！",
          "tc": "竟然得到了最高評價！",
          "sc": "竟然得到了最高评价！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 2288,
          "spk": "木助 (キスケ)",
          "ja": "俺が思ってた以上に",
          "tc": "看來你比我想像中的",
          "sc": "看来你比我想像中的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2295,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは努力してたんだな",
          "tc": "還要努力呢。",
          "sc": "还要努力呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 2306,
          "spk": "木助 (キスケ)",
          "ja": "えらいぜ、<player>",
          "tc": "真是了不起，<player>，",
          "sc": "真是了不起，<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 2313,
          "spk": "木助 (キスケ)",
          "ja": "よく頑張ったな",
          "tc": "辛苦你了。",
          "sc": "辛苦你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 286,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2337,
          "spk": "木助 (キスケ)",
          "ja": "う～ん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 2344,
          "spk": "木助 (キスケ)",
          "ja": "色々と惜しかったなぁ……",
          "tc": "真是太可惜了……",
          "sc": "真是太可惜了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 2362,
          "spk": "木助 (キスケ)",
          "ja": "けど、他のヤツらの作物と比べても",
          "tc": "不過你的作物跟其他人的比，",
          "sc": "不过你的作物跟其他人的比，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 2369,
          "spk": "木助 (キスケ)",
          "ja": "甲乙つけがたいって感じだったぞ",
          "tc": "感覺也是不相上下啊。",
          "sc": "感觉也是不相上下啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 2380,
          "spk": "木助 (キスケ)",
          "ja": "だから、これにめげずに",
          "tc": "所以你別氣餒，",
          "sc": "所以你别气馁，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 2387,
          "spk": "木助 (キスケ)",
          "ja": "次もがんばれよ",
          "tc": "下次再加油吧。",
          "sc": "下次再加油吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 287,
      "rec_id": "TALK_ID_CARPENTER_HOLIDAY_20_102_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 2411,
          "spk": "木助 (キスケ)",
          "ja": "今回の品評会は見応えがあったな",
          "tc": "這次的評鑑會挺精彩的。",
