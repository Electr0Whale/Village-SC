  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3315,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 170966,
          "spk": "木助 (キスケ)",
          "ja": "そういやロッカク、",
          "tc": "說起來，六角啊，",
          "sc": "说起来，六角啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 170973,
          "spk": "木助 (キスケ)",
          "ja": "良い春酒が手に入ったんだって？",
          "tc": "聽說你弄到了不錯的春花酒是吧？",
          "sc": "听说你弄到了不错的春花酒是吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 170980,
          "spk": "木助 (キスケ)",
          "ja": "呑ませやがれ",
          "tc": "拿出來喝啊？",
          "sc": "拿出来喝啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 170993,
          "spk": "六角 (ロッカク)",
          "ja": "ダメっスよ",
          "tc": "不行啦。",
          "sc": "不行哟。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 171000,
          "spk": "六角 (ロッカク)",
          "ja": "前に酔って騒いだの忘れたんスか？",
          "tc": "你忘記你之前喝醉後大鬧了一番嗎？",
          "sc": "你忘记你之前喝醉后大闹了一番吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171020,
          "spk": "木助 (キスケ)",
          "ja": "いいじゃねぇか",
          "tc": "又不會怎樣。",
          "sc": "又不会怎样。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171027,
          "spk": "木助 (キスケ)",
          "ja": "俺とてめぇの仲なんだ",
          "tc": "我們交情這麼好，",
          "sc": "我们交情这么好，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 171034,
          "spk": "木助 (キスケ)",
          "ja": "な？ 一杯くらい",
          "tc": "對吧？一杯就好嘛。",
          "sc": "对吧？一杯就好嘛。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171047,
          "spk": "六角 (ロッカク)",
          "ja": "……全く、しょうがない人っス",
          "tc": "……真拿你沒辦法。",
          "sc": "……真拿你没办法呐。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171054,
          "spk": "六角 (ロッカク)",
          "ja": "っと、これです",
          "tc": "來，就是這個。",
          "sc": "来，就是这个。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 171067,
          "spk": "木助 (キスケ)",
          "ja": "おお～、いいじゃねぇか",
          "tc": "喔～蠻不錯的嘛，",
          "sc": "喔～蛮不错的嘛，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171074,
          "spk": "木助 (キスケ)",
          "ja": "どいつから買ったんだ？",
          "tc": "這是跟誰買的？",
          "sc": "这是跟谁买的？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 171087,
          "spk": "六角 (ロッカク)",
          "ja": "チナナさんからっス",
          "tc": "在琪娜娜那邊買的。",
          "sc": "在琪娜娜那边买呐。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 171094,
          "spk": "六角 (ロッカク)",
          "ja": "なんでも花の香りを移したお酒だとか",
          "tc": "據說是融入了花香的酒。",
          "sc": "据说是融入了花香的酒。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171107,
          "spk": "木助 (キスケ)",
          "ja": "ほぉ……甘い匂いがするから",
          "tc": "哦……聞起來甜甜的，",
          "sc": "哦……闻起来甜甜的，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 171114,
          "spk": "木助 (キスケ)",
          "ja": "果物かと思ったが、花か",
          "tc": "我還以為是水果，原來是花啊。",
          "sc": "我还以为是水果，原来是花啊。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 171121,
          "spk": "木助 (キスケ)",
          "ja": "どれ……",
          "tc": "讓我嘗嘗……",
          "sc": "让我尝尝……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 171132,
          "spk": "木助 (キスケ)",
          "ja": "カァ……！ 美味い！",
          "tc": "呼……！好喝！",
          "sc": "呼……！好喝！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 171139,
          "spk": "木助 (キスケ)",
          "ja": "喉が焼ける感じがたまんねえぜ！",
          "tc": "這種喉嚨辣燙燙的感覺真過癮！",
          "sc": "这种喉咙辣烫烫的感觉真过瘾！"
        },
        {
          "f_idx": 20,
          "pidx_tc": 171146,
          "spk": "木助 (キスケ)",
          "ja": "ロッカク、てめぇも呑め！",
          "tc": "六角，你也來喝！",
          "sc": "六角，你也来喝！"
        },
        {
          "f_idx": 21,
          "pidx_tc": 171159,
          "spk": "六角 (ロッカク)",
          "ja": "うわぁ……そんないっぺんに呑むから……！",
          "tc": "哇……你別那樣一口氣猛灌……！",
          "sc": "哇……你别那样一口气猛灌……！"
        },
        {
          "f_idx": 22,
          "pidx_tc": 171166,
          "spk": "六角 (ロッカク)",
          "ja": "ワシは仕事中なんスけど……",
          "tc": "我還在工作啊……",
          "sc": "我还在工作啊……"
        },
        {
          "f_idx": 23,
          "pidx_tc": 171179,
          "spk": "木助 (キスケ)",
          "ja": "あぁ……？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 171186,
          "spk": "木助 (キスケ)",
          "ja": "俺の酒が呑めねえってのか？",
          "tc": "你的意思是不跟我喝酒嗎？",
          "sc": "你的意思是不跟我喝酒吗？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 171199,
          "spk": "六角 (ロッカク)",
          "ja": "はぁ……やっぱりこうなったっスね",
          "tc": "唉……果然變成這樣了。",
          "sc": "唉……果然变成这样呐。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 171206,
          "spk": "六角 (ロッカク)",
          "ja": "じゃあ少しだけ",
          "tc": "那我就喝一點吧。",
          "sc": "那我就喝一点吧。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 171219,
          "spk": "木助 (キスケ)",
          "ja": "遠慮するな！",
          "tc": "別客氣！",
          "sc": "别客气！"
        },
        {
          "f_idx": 28,
          "pidx_tc": 171226,
          "spk": "木助 (キスケ)",
          "ja": "一升瓶丸ごといけ！",
          "tc": "直接把一整瓶乾了！",
          "sc": "直接把一整瓶干了！"
        },
        {
          "f_idx": 29,
          "pidx_tc": 171239,
          "spk": "六角 (ロッカク)",
          "ja": "無茶言わないでほしいっス……",
          "tc": "你別強人所難好嗎……",
          "sc": "你别强人所难好吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3316,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 171267,
          "spk": "琪娜娜 (チナナ)",
          "ja": "みんな、ウチらがゆっくり話でも",
          "tc": "大家是不是為了讓我們能好好聊聊，",
          "sc": "大家是不是为了让我们能好好聊聊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 171274,
          "spk": "琪娜娜 (チナナ)",
          "ja": "できるようにと、席を設けてくれたのかな？",
          "tc": "特地安排了座位啊？",
          "sc": "特地安排了座位啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 171285,
          "spk": "琪娜娜 (チナナ)",
          "ja": "せっかくのご厚意だ",
          "tc": "既然是大家的一番好意，",
          "sc": "既然是大家的一番好意，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 171292,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜は、大人の時間を楽しむとしようか",
          "tc": "今晚就來好好享受屬於大人的時光吧。",
          "sc": "今晚就来好好享受属于大人的时光吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 171312,
          "spk": "莲实 (ハスミ)",
          "ja": "そのセリフ、まるで恋人でも",
          "tc": "瞧妳這句話，",
          "sc": "瞧你这句话，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171319,
          "spk": "莲实 (ハスミ)",
          "ja": "口説いているかのようね",
          "tc": "簡直就像在跟戀人調情呢。",
          "sc": "简直就像在跟恋人调情呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171330,
          "spk": "莲实 (ハスミ)",
          "ja": "私で事前練習でもするつもりなのかしら？",
          "tc": "妳該不會是想拿我來預演吧？",
          "sc": "你该不会是想拿我来预演吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 171337,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナも隅に置けないわね",
          "tc": "琪娜娜也不是省油的燈呢。",
          "sc": "琪娜娜也不是省油的灯呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171350,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こらこら、そうやって茶化さないの",
          "tc": "喂喂，別這樣開我玩笑啦。",
          "sc": "喂喂，别这样开我玩笑啦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "せっかくの雰囲気が壊れちゃうじゃないか",
          "tc": "難得的好氣氛都要被妳破壞掉了。",
          "sc": "难得的好气氛都要被你破坏掉了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171377,
          "spk": "莲实 (ハスミ)",
          "ja": "……ふふ、ごめんなさい",
          "tc": "……呵呵，抱歉啦。",
          "sc": "……呵呵，抱歉啦。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 171390,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……何だかやけに上機嫌だけど",
          "tc": "……感覺妳似乎心情特別好，",
          "sc": "……感觉你似乎心情特别好，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 171397,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酒でも引っかけてきたんじゃないよね？",
          "tc": "該不會來之前先喝過酒了吧？",
          "sc": "该不会来之前先喝过酒了吧？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171410,
          "spk": "莲实 (ハスミ)",
          "ja": "まさか",
          "tc": "怎麼會呢。",
          "sc": "怎么会呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 171417,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナとの食事が楽しいだけよ",
          "tc": "我只是因為跟琪娜娜妳一起吃飯很開心啊。",
          "sc": "我只是因为跟琪娜娜你一起吃饭很开心啊。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 171430,
          "spk": "琪娜娜 (チナナ)",
          "ja": "言ってくれるね",
          "tc": "妳還真會說話。",
          "sc": "你还真会说话。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 171437,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの方が変に酔ってしまいそうだよ",
          "tc": "反倒是我都聽得快醉了呢。",
          "sc": "反倒是我都听得快醉了呢。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 171448,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は食堂デートにしたけど",
          "tc": "雖然今天是在餐廳約會，",
          "sc": "虽然今天是在餐厅约会，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 171455,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次は夜桜でも見ながら、宴会でも開こうか",
          "tc": "但下次我們就一邊欣賞夜櫻一邊開宴會吧。",
          "sc": "但下次我们就一边欣赏夜樱一边开宴会吧。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 171475,
          "spk": "莲实 (ハスミ)",
          "ja": "いいわね",
          "tc": "好主意。",
          "sc": "好主意。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 171482,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん、お酒も呑みながら",
          "tc": "當然也少不了一邊喝酒。",
          "sc": "当然也少不了一边喝酒。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 171495,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕方ないね",
          "tc": "真拿妳沒辦法呢。",
          "sc": "真拿你没办法呢。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 171502,
          "spk": "琪娜娜 (チナナ)",
          "ja": "許可はしてあげるけど",
          "tc": "酒是准妳喝啦，",
          "sc": "酒是准你喝啦，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 171509,
          "spk": "琪娜娜 (チナナ)",
          "ja": "程ほどにしておきなよ",
          "tc": "但還是要適可而止喔。",
          "sc": "但还是要适可而止哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3317,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0016",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 171537,
          "spk": "林 (リン)",
          "ja": "ううん……悩ましいわね",
          "tc": "唔……好糾結喔……",
          "sc": "唔……好纠结哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 171550,
          "spk": "茶梅 (サザンカ)",
          "ja": "いつまでそうやってるつもり？",
          "tc": "妳到底還要想多久？",
          "sc": "你到底还要想多久？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 171557,
          "spk": "茶梅 (サザンカ)",
          "ja": "冷やかしなら迷惑だから、",
          "tc": "如果只是逛逛不買的話，",
          "sc": "如果只是逛逛不买的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 171564,
          "spk": "茶梅 (サザンカ)",
          "ja": "さっさと帰って欲しいんだけど",
          "tc": "就趕快回去啦。",
          "sc": "就赶快回去啦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 171577,
          "spk": "林 (リン)",
          "ja": "何よ、この店は客が悩むことすら",
          "tc": "什麼嘛！",
          "sc": "什么嘛！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 171584,
          "spk": "林 (リン)",
          "ja": "許さないっていうわけ？",
          "tc": "這間店連讓客人猶豫一下都不行嗎？",
          "sc": "这间店连让客人犹豫一下都不行吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171597,
          "spk": "茶梅 (サザンカ)",
          "ja": "リンって本当ケチ臭いよねー",
          "tc": "林妳真的節省過頭了啦──",
          "sc": "林你真的节省过头了啦——"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171604,
          "spk": "茶梅 (サザンカ)",
          "ja": "欲しいなら買えばいいのに、",
          "tc": "想要的話就直接買啊，",
          "sc": "想要的话就直接买啊，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 171611,
          "spk": "茶梅 (サザンカ)",
          "ja": "悩んでる時間が無駄じゃん",
          "tc": "在那邊猶豫根本是浪費時間嘛。",
          "sc": "在那边犹豫根本是浪费时间嘛。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171624,
          "spk": "林 (リン)",
          "ja": "そういうサザンカはいい加減",
          "tc": "茶梅妳才是，",
          "sc": "茶梅你才是，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171631,
          "spk": "林 (リン)",
          "ja": "無駄遣いをやめたらどうかしら？",
          "tc": "差不多也該改改亂花錢的習慣了吧？",
          "sc": "差不多也该改改乱花钱的习惯了吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171649,
          "spk": "林 (リン)",
          "ja": "自分のことにお金を使う前に、",
          "tc": "希望妳可以先好好繳稅給村裡，",
          "sc": "希望你可以先好好缴税给村里，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 171656,
          "spk": "林 (リン)",
          "ja": "きちんと村に納めてほしいものね",
          "tc": "再把錢花在自己身上。",
          "sc": "再把钱花在自己身上。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171676,
          "spk": "茶梅 (サザンカ)",
          "ja": "リンがケチらずにお店にお金を",
          "tc": "要是林別那麼小氣，",
          "sc": "要是林别那么小气，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 171683,
          "spk": "茶梅 (サザンカ)",
          "ja": "落としてくれたら、",
          "tc": "願意在我的店裡多花點錢，",
          "sc": "愿意在我的店里多花点钱，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 171690,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシも村にお金を納められるかもよ？",
