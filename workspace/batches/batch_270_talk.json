          "spk": "驹子 (コマコ)",
          "ja": "ばーどふぃー……？",
          "tc": "餵鳥器……？",
          "sc": "喂鸟器……？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 436970,
          "spk": "裕太 (ユータ)",
          "ja": "だけど、畑の野菜の芽を",
          "tc": "但是牠們卻把我田裡的蔬菜嫩芽",
          "sc": "但是它们却把我田里的蔬菜嫩芽"
