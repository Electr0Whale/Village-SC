  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7590,
      "rec_id": "TALK_ID_70_2110_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385203,
          "spk": "洋 (ヨウ)",
          "ja": "えへへ……",
          "tc": "嘿嘿……",
          "sc": "嘿嘿……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385210,
          "spk": "洋 (ヨウ)",
          "ja": "いっぱい遊んじゃったね",
          "tc": "玩得好過癮喔。",
          "sc": "玩得好过瘾哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385217,
          "spk": "洋 (ヨウ)",
          "ja": "こんなにはしゃいだの、初めてかも",
          "tc": "我說不定是第一次玩得這麼開心。",
          "sc": "我说不定是第一次玩得这么开心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385228,
          "spk": "洋 (ヨウ)",
          "ja": "でも……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385235,
          "spk": "洋 (ヨウ)",
          "ja": "そろそろおじちゃんが心配するから、帰るね",
          "tc": "再玩下去叔叔會擔心的，我先回去了喔！",
          "sc": "再玩下去叔叔会担心的，我先回去了哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385246,
          "spk": "洋 (ヨウ)",
          "ja": "今日はありがとう、<player>",
          "tc": "今天真的謝謝你，<player>。",
          "sc": "今天真的谢谢你，<player>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 385253,
          "spk": "洋 (ヨウ)",
          "ja": "また、明日ね",
          "tc": "明天見喔！",
          "sc": "明天见哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7591,
      "rec_id": "TALK_ID_70_2110_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385277,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385284,
          "spk": "洋 (ヨウ)",
          "ja": "来てくれたんだね",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385295,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが、ご飯の用意してくれてるよ",
          "tc": "叔叔正在幫我們準備飯菜，",
          "sc": "叔叔正在帮我们准备饭菜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385302,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんとお腹すかせて来てくれたよね",
          "tc": "你有空著肚子來吧。",
          "sc": "你有空着肚子来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7592,
      "rec_id": "TALK_ID_70_2110_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385326,
          "spk": "洋 (ヨウ)",
          "ja": "見てみて、今日はカレーなんだよ",
          "tc": "快看看，今天吃咖哩喔。",
          "sc": "快看看，今天吃咖喱哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385333,
          "spk": "洋 (ヨウ)",
          "ja": "わたしね、この「おこさまカレー」大好きなの",
          "tc": "我很喜歡這個「兒童咖哩」喔！",
          "sc": "我很喜欢这个“儿童咖喱”哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7593,
      "rec_id": "TALK_ID_70_2110_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385351,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、わたしの分は牛乳を入れてくれるの",
          "tc": "叔叔另外幫我加了牛奶。",
          "sc": "叔叔另外帮我加了牛奶。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385358,
          "spk": "洋 (ヨウ)",
          "ja": "熱くなくなるし、辛くなくなるし、",
          "tc": "這樣就不燙，也不辣了，",
          "sc": "这样就不烫，也不辣了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385365,
          "spk": "洋 (ヨウ)",
          "ja": "まろやかになるんだよ",
          "tc": "味道變得很順口喔。",
          "sc": "味道变得很顺口哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385376,
          "spk": "洋 (ヨウ)",
          "ja": "お代わりもあるからね",
          "tc": "因為準備了很多，",
          "sc": "因为准备了很多，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385383,
          "spk": "洋 (ヨウ)",
          "ja": "<player>もいっぱい食べてね",
          "tc": "<player>可以盡量多吃一點喔。",
          "sc": "<player>可以尽量多吃一点哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385392,
          "spk": "主角心声/旁白/选项",
          "ja": "甘い",
          "tc": "好甜",
          "sc": "好甜"
        },
        {
          "f_idx": 6,
          "pidx_tc": 385399,
          "spk": "主角心声/旁白/选项",
          "ja": "美味しい",
          "tc": "好吃",
          "sc": "好吃"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7594,
      "rec_id": "TALK_ID_70_2110_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385582,
          "spk": "洋 (ヨウ)",
          "ja": "このカレーが気に入ったなら、",
          "tc": "如果你喜歡這個咖哩的話，",
          "sc": "如果你喜欢这个咖喱的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385589,
          "spk": "洋 (ヨウ)",
          "ja": "いつでも食べに来ていいからね",
          "tc": "隨時都可以來吃喔。",
          "sc": "随时都可以来吃哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385600,
          "spk": "洋 (ヨウ)",
          "ja": "おこさまカレーはお店のメニューにはない",
          "tc": "雖然兒童咖哩不在店裡的菜單上，",
          "sc": "虽然儿童咖喱不在店里的菜单上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385607,
          "spk": "洋 (ヨウ)",
          "ja": "特別なお料理なんだけど……",
          "tc": "是道特別的料理……",
          "sc": "是道特别的料理……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385618,
          "spk": "洋 (ヨウ)",
          "ja": "<player>がお願いすれば、",
          "tc": "但只要<player>說想吃，",
          "sc": "但只要<player>说想吃，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385625,
          "spk": "洋 (ヨウ)",
          "ja": "きっと作ってくれると思うから",
          "tc": "我想叔叔一定會幫你做的。",
          "sc": "我想叔叔一定会帮你做的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7595,
      "rec_id": "TALK_ID_70_2110_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385645,
          "spk": "六角 (ロッカク)",
          "ja": "これ、一応鍋物っスから",
          "tc": "這姑且算是燉煮料理，",
          "sc": "这姑且算是炖煮料理，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385652,
          "spk": "六角 (ロッカク)",
          "ja": "前日から言っといてくれないと出ませんけどねー",
          "tc": "沒有前一天先講可做不出來喔～",
          "sc": "没有前一天先讲可做不出来呐～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385672,
          "spk": "洋 (ヨウ)",
          "ja": "え、そうなんだ",
          "tc": "咦，是這樣嗎？",
          "sc": "咦，是这样吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385679,
          "spk": "洋 (ヨウ)",
          "ja": "でも、わたしの時は",
          "tc": "但我想吃的時候，",
          "sc": "但我想吃的时候，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385686,
          "spk": "洋 (ヨウ)",
          "ja": "食べたい時に出てくるよ？",
          "tc": "都會立刻端出來啊？",
          "sc": "都会立刻端出来啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 385699,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんの場合、一週間に一度は",
          "tc": "洋妹妹的話，",
          "sc": "洋妹妹的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 385706,
          "spk": "六角 (ロッカク)",
          "ja": "カレーが食べたいって言うじゃないっスか",
          "tc": "通常每週至少會說一次想吃咖哩吧？",
          "sc": "通常每周至少会说一次想吃咖喱吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 385713,
          "spk": "六角 (ロッカク)",
          "ja": "だから、一食分の材料は用意してあるんスよ",
          "tc": "所以我都有準備好一人份的材料。",
          "sc": "所以我都有准备好一人份的材料。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 385726,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、<player>がおこさまカレーを",
          "tc": "那<player>想吃兒童咖哩的時候，",
          "sc": "那<player>想吃儿童咖喱的时候，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 385733,
          "spk": "洋 (ヨウ)",
          "ja": "食べたくなったら、いってね",
          "tc": "就跟我說吧。",
          "sc": "就跟我说吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 385742,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがおじちゃんに、お願いしてあげるから",
          "tc": "我會幫你拜託叔叔的。",
          "sc": "我会帮你拜托叔叔的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 385762,
          "spk": "六角 (ロッカク)",
          "ja": "せめて、週一でお願いするっス……",
          "tc": "拜託一週一次就好……",
          "sc": "拜托一周一次就好……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7596,
      "rec_id": "TALK_ID_70_2110_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385795,
          "spk": "洋 (ヨウ)",
          "ja": "<player>！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385802,
          "spk": "洋 (ヨウ)",
          "ja": "やっと来てくれた！",
          "tc": "你終於來了！",
          "sc": "你终于来了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385813,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが「牛乳寒天」を作ってくれたの",
          "tc": "叔叔做了「牛奶寒天凍」給我，",
          "sc": "叔叔做了“牛奶寒天冻”给我，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385820,
          "spk": "洋 (ヨウ)",
          "ja": "<player>が来るまで待ってたんだよ",
          "tc": "我一直在等<player>你來！",
          "sc": "我一直在等<player>你来！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385827,
          "spk": "洋 (ヨウ)",
          "ja": "一緒に食べようね",
          "tc": "一起吃吧。",
          "sc": "一起吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7597,
      "rec_id": "TALK_ID_70_2110_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 385851,
          "spk": "洋 (ヨウ)",
          "ja": "……甘くて、美味しいね",
          "tc": "……甜甜的，真好吃。",
          "sc": "……甜甜的，真好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 385858,
          "spk": "洋 (ヨウ)",
          "ja": "あ、今日はミカンが入ってるんだ",
          "tc": "啊，今天還放了橘子耶。",
          "sc": "啊，今天还放了橘子呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 385869,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、牛乳寒天、大好きなの",
          "tc": "我很喜歡吃牛奶寒天凍。",
          "sc": "我很喜欢吃牛奶寒天冻。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 385876,
          "spk": "洋 (ヨウ)",
          "ja": "だって、優しい味がするでしょう？",
          "tc": "不覺得味道吃起來很溫柔嗎？",
          "sc": "不觉得味道吃起来很温柔吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 385885,
          "spk": "主角心声/旁白/选项",
          "ja": "優しい？",
          "tc": "溫柔的味道？",
          "sc": "温柔的味道？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 385892,
          "spk": "主角心声/旁白/选项",
          "ja": "どうして？",
          "tc": "為什麼？",
          "sc": "为什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7598,
      "rec_id": "TALK_ID_70_2110_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386146,
          "spk": "洋 (ヨウ)",
          "ja": "ご馳走様でした",
          "tc": "我吃飽了。",
          "sc": "我吃饱了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386157,
          "spk": "洋 (ヨウ)",
          "ja": "それじゃ、わたしはお外に行くけど……",
          "tc": "那我要出去外面玩了……",
          "sc": "那我要出去外面玩了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386164,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はどうするの？",
          "tc": "<player>有要做什麼嗎？",
          "sc": "<player>有要做什么吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386175,
          "spk": "洋 (ヨウ)",
          "ja": "えっと、もし暇だったら……",
          "tc": "那個，如果沒事的話……",
          "sc": "那个，如果没事的话……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386182,
          "spk": "洋 (ヨウ)",
          "ja": "今日も、一緒に遊んでくれると嬉しいな",
          "tc": "要是今天也能一起玩，我會很高興的。",
          "sc": "要是今天也能一起玩，我会很高兴的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7599,
      "rec_id": "TALK_ID_70_2110_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386206,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、いらっしゃい",
          "tc": "<player>，歡迎光臨！",
          "sc": "<player>，欢迎光临！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386213,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんがお魚、",
          "tc": "聽叔叔說，",
          "sc": "听叔叔说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386220,
          "spk": "洋 (ヨウ)",
          "ja": "いっぱい仕入れてきたんだって",
          "tc": "他買到了很多魚喔。",
          "sc": "他买到了很多鱼哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386231,
          "spk": "洋 (ヨウ)",
          "ja": "これから、たくさん焼いてくれるよ",
          "tc": "等等好像要拿很多來烤，",
          "sc": "等等好像要拿很多来烤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386238,
          "spk": "洋 (ヨウ)",
          "ja": "楽しみだね",
          "tc": "真令人期待。",
          "sc": "真令人期待。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7600,
      "rec_id": "TALK_ID_70_2110_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386262,
          "spk": "洋 (ヨウ)",
          "ja": "このお魚はね、ヤマメっていうの",
          "tc": "這種魚啊，叫做山女魚。",
          "sc": "这种鱼啊，叫做山女鱼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386269,
          "spk": "洋 (ヨウ)",
          "ja": "塩焼きにすると、とっても美味しいんだよ",
          "tc": "用鹽烤會非常好吃喔！",
          "sc": "用盐烤会非常好吃哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386287,
          "spk": "洋 (ヨウ)",
          "ja": "……骨を除けるのが、",
          "tc": "……雖然挑魚刺",
          "sc": "……虽然挑鱼刺"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386294,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ大変だけど",
          "tc": "有一點點麻煩。",
          "sc": "有一点点麻烦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 386305,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はお魚、好き？",
          "tc": "<player>喜歡吃魚嗎？",
          "sc": "<player>喜欢吃鱼吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 386314,
          "spk": "主角心声/旁白/选项",
          "ja": "好き",
          "tc": "喜歡",
          "sc": "喜欢"
        },
        {
          "f_idx": 7,
          "pidx_tc": 386321,
          "spk": "主角心声/旁白/选项",
          "ja": "苦手",
          "tc": "不喜歡",
          "sc": "不喜欢"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7601,
      "rec_id": "TALK_ID_70_2110_009_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386486,
          "spk": "洋 (ヨウ)",
          "ja": "どうしたの？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386497,
          "spk": "洋 (ヨウ)",
          "ja": "あ、ハラワタ食べちゃったんだね",
          "tc": "啊，你吃到內臟了啊。",
          "sc": "啊，你吃到内脏了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7602,
      "rec_id": "TALK_ID_70_2110_009_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386515,
          "spk": "洋 (ヨウ)",
          "ja": "お魚はね、",
          "tc": "據說吃魚的時候，",
          "sc": "据说吃鱼的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386522,
          "spk": "洋 (ヨウ)",
          "ja": "そこは食べずに残すのが作法なんだって",
          "tc": "把內臟剩下來不吃才符合禮儀喔。",
          "sc": "把内脏剩下来不吃才符合礼仪哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386533,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも前は知らなくて、",
          "tc": "我以前也不知道這件事，",
          "sc": "我以前也不知道这件事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386540,
          "spk": "洋 (ヨウ)",
          "ja": "大人はこんなの食べるんだって",
          "tc": "還很驚訝大人竟然",
          "sc": "还很惊讶大人竟然"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386547,
          "spk": "洋 (ヨウ)",
          "ja": "驚いていたんだけど",
          "tc": "會吃這種東西。",
          "sc": "会吃这种东西。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 386558,
          "spk": "洋 (ヨウ)",
          "ja": "お魚を食べる時はね",
          "tc": "吃魚的時候呢，",
          "sc": "吃鱼的时候呢，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 386565,
          "spk": "洋 (ヨウ)",
          "ja": "こうやって……背中のほうから",
          "tc": "要像這樣……從背部開始取下魚肉，",
          "sc": "要像这样……从背部开始取下鱼肉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 386572,
          "spk": "洋 (ヨウ)",
          "ja": "身を取っていくときれいに食べられるよ",
          "tc": "就能吃得很乾淨喔。",
          "sc": "就能吃得很干净哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 386583,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも、サザンカさんに教えてもらったの",
          "tc": "我也是茶梅姐姐教我才學會的。",
          "sc": "我也是茶梅姐姐教我才学会的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7603,
      "rec_id": "TALK_ID_70_2110_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386607,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、待ってたよ",
          "tc": "<player>，我等你很久了呢。",
          "sc": "<player>，我等你很久了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386614,
          "spk": "洋 (ヨウ)",
          "ja": "来てくれるの、一日中楽しみにしてたの",
          "tc": "我今天一整天都在等你來呢。",
          "sc": "我今天一整天都在等你来呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386625,
          "spk": "洋 (ヨウ)",
          "ja": "でも……急に誘っちゃって……",
          "tc": "不過……我突然約你……",
          "sc": "不过……我突然约你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386632,
          "spk": "洋 (ヨウ)",
          "ja": "迷惑じゃなかった……？",
          "tc": "你會覺得困擾嗎……？",
          "sc": "你会觉得困扰吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7604,
      "rec_id": "TALK_ID_70_2110_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386657,
          "spk": "洋 (ヨウ)",
          "ja": "……よかった",
          "tc": "……太好了。",
          "sc": "……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386664,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんと、おじちゃんにも伝えてあるよ",
          "tc": "已經有先跟叔叔說一聲了。",
          "sc": "已经有先跟叔叔说一声了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386671,
          "spk": "洋 (ヨウ)",
          "ja": "今日は一緒に、夜までいっぱい遊ぼうね",
          "tc": "今天一起大玩特玩到晚上吧。",
          "sc": "今天一起大玩特玩到晚上吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7605,
      "rec_id": "TALK_ID_70_2110_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386695,
          "spk": "洋 (ヨウ)",
          "ja": "えへへ",
          "tc": "嘿嘿。",
          "sc": "嘿嘿。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386702,
          "spk": "洋 (ヨウ)",
          "ja": "夜、寝る時間まで友達と一緒なんて",
          "tc": "晚上在睡覺之前還跟朋友待在一起，",
          "sc": "晚上在睡觉之前还跟朋友待在一起，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386709,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、すごく不思議な気分",
          "tc": "有種好不可思議的感覺。",
          "sc": "有种好不可思议的感觉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386720,
          "spk": "洋 (ヨウ)",
          "ja": "えっと、お話したいことも",
          "tc": "我啊，有好多話想說，",
          "sc": "我啊，有好多话想说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386727,
          "spk": "洋 (ヨウ)",
          "ja": "やりたいこともいっぱいあるんだけど",
          "tc": "也有好多事想做，",
          "sc": "也有好多事想做，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 386734,
          "spk": "洋 (ヨウ)",
          "ja": "まずは、なにから話そうかな……",
          "tc": "該從什麼開始講起呢……",
          "sc": "该从什么开始讲起呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 386745,
          "spk": "洋 (ヨウ)",
          "ja": "あ、そうだ",
          "tc": "啊，對了。",
          "sc": "啊，对了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 386752,
          "spk": "洋 (ヨウ)",
          "ja": "実はこの間、おじちゃんがね",
          "tc": "其實前陣子叔叔他啊，",
          "sc": "其实前阵子叔叔他啊，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 386759,
          "spk": "洋 (ヨウ)",
          "ja": "珍しくお鍋をひっくり返しちゃって――",
          "tc": "少見地打翻了鍋子──",
          "sc": "少见地打翻了锅子——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7606,
      "rec_id": "TALK_ID_70_2110_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386783,
          "spk": "洋 (ヨウ)",
          "ja": "この本はね、サザンカさんがくれたの",
          "tc": "這本書是茶梅姐姐給我的，",
          "sc": "这本书是茶梅姐姐给我的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386790,
          "spk": "洋 (ヨウ)",
          "ja": "この辺りのお花とかのことが載ってる",
          "tc": "上面有介紹這附近有哪些花，",
          "sc": "上面有介绍这附近有哪些花，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386797,
          "spk": "洋 (ヨウ)",
          "ja": "植物図鑑なんだって",
          "tc": "是植物圖鑑喔。",
          "sc": "是植物图鉴哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386808,
          "spk": "洋 (ヨウ)",
          "ja": "スミレくんやユータさんと山で遊んでるって",
          "tc": "我把跟堇怜哥哥和裕太哥哥到山裡玩的事",
          "sc": "我把跟堇怜哥哥和裕太哥哥到山里玩的事"
        },
        {
          "f_idx": 4,
          "pidx_tc": 386815,
          "spk": "洋 (ヨウ)",
          "ja": "話したら、持ってたほうがいいって言われたの",
          "tc": "告訴她之後，她就建議我看看這本書。",
          "sc": "告诉她之后，她就建议我看看这本书。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 386833,
          "spk": "洋 (ヨウ)",
          "ja": "でね、このページのお花、きれいだよね",
          "tc": "然後啊，這一頁的花，很漂亮吧。",
          "sc": "然后啊，这一页的花，很漂亮吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 386840,
          "spk": "洋 (ヨウ)",
          "ja": "今度、一緒に探してみよっか？",
          "tc": "下次我們一起找找看吧？",
          "sc": "下次我们一起找找看吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7607,
      "rec_id": "TALK_ID_70_2110_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386871,
          "spk": "洋 (ヨウ)",
          "ja": "この石はね、ユータさんがくれたの",
          "tc": "這顆石頭啊，是裕太哥哥給我的，",
          "sc": "这颗石头啊，是裕太哥哥给我的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386878,
          "spk": "洋 (ヨウ)",
          "ja": "もしかしたら、不思議な力があるかもって",
          "tc": "他說搞不好有著不可思議的力量。",
          "sc": "他说说不定有着不可思议的力量。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386889,
          "spk": "洋 (ヨウ)",
          "ja": "パワーストーン？　っていうんだって",
          "tc": "好像是叫做能量石？",
          "sc": "好像是叫做能量石？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386896,
          "spk": "洋 (ヨウ)",
          "ja": "本当かどうかは、わからないけど",
          "tc": "雖然不知道是不是真的。",
          "sc": "虽然不知道是不是真的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7608,
      "rec_id": "TALK_ID_70_2110_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386916,
          "spk": "六角 (ロッカク)",
          "ja": "あー、ヨウさん、ヨウさん",
          "tc": "啊～我說洋妹妹。",
          "sc": "啊～我说洋妹妹。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386923,
          "spk": "六角 (ロッカク)",
          "ja": "ちょいと声デカいんで、抑えてほしいっス",
          "tc": "聲音有點太大了，記得降低音量。",
          "sc": "声音有点太大了，记得降低音量呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386930,
          "spk": "六角 (ロッカク)",
          "ja": "すこぉしだけ、お静かにっス",
          "tc": "要小聲一～點點喔！",
          "sc": "要小声一～点点呐！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7609,
      "rec_id": "TALK_ID_70_2110_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 386950,
          "spk": "洋 (ヨウ)",
          "ja": "怒られちゃったね",
          "tc": "被罵了呢。",
          "sc": "被骂了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 386961,
          "spk": "洋 (ヨウ)",
          "ja": "ふぁ……",
          "tc": "呼啊……",
          "sc": "呼啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 386968,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、ちょっと……眠い、かも",
          "tc": "我好像……有點……睏了。",
          "sc": "我好像……有点……困了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 386979,
          "spk": "洋 (ヨウ)",
          "ja": "そろそろ、寝る準備しよっか",
          "tc": "差不多該睡了。",
          "sc": "差不多该睡了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7610,
      "rec_id": "TALK_ID_70_2110_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387006,
          "spk": "洋 (ヨウ)",
          "ja": "ねえ、<player>……",
          "tc": "那個啊，<player>……",
          "sc": "那个啊，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387013,
          "spk": "洋 (ヨウ)",
          "ja": "もう、寝ちゃった？",
          "tc": "你睡著了嗎？",
          "sc": "你睡着了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387022,
          "spk": "主角心声/旁白/选项",
          "ja": "起きてる",
          "tc": "還醒著",
          "sc": "还醒着"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387029,
          "spk": "主角心声/旁白/选项",
          "ja": "寝てる",
          "tc": "睡著了",
          "sc": "睡着了"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7611,
      "rec_id": "TALK_ID_70_2110_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387045,
          "spk": "洋 (ヨウ)",
          "ja": "あのね、お友達とこうしてお泊りするの",
          "tc": "那個啊，我其實一直很憧憬",
          "sc": "那个啊，我其实一直很憧憬"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387052,
          "spk": "洋 (ヨウ)",
          "ja": "ずっと、憧れてたの",
          "tc": "和朋友像這樣一起過夜。",
          "sc": "和朋友像这样一起过夜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387061,
          "spk": "洋 (ヨウ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387070,
          "spk": "洋 (ヨウ)",
          "ja": "オワンのことを飼えるようになったのも",
          "tc": "不管是能收養歐宛也好，",
          "sc": "不管是能收养欧宛也好，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 387077,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんの本当を知れたのも",
          "tc": "還是明白了叔叔的真心，",
          "sc": "还是明白了叔叔的真心，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 387086,
          "spk": "洋 (ヨウ)",
          "ja": "全部、<player>のおかげだから",
          "tc": "全部，都是多虧有<player>。",
          "sc": "全部，都是多亏有<player>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 387095,
          "spk": "洋 (ヨウ)",
          "ja": "だから、今度は――",
          "tc": "所以，下次──",
          "sc": "所以，下次——"
        },
        {
          "f_idx": 7,
          "pidx_tc": 387102,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが<player>の力になるね",
          "tc": "就換我幫助<player>了。",
          "sc": "就换我帮助<player>了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 387109,
          "spk": "洋 (ヨウ)",
          "ja": "……約束",
          "tc": "……約好了喔。",
          "sc": "……约好了哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7612,
      "rec_id": "TALK_ID_70_2110_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387125,
          "spk": "洋 (ヨウ)",
          "ja": "……ねえ",
          "tc": "……那個，",
          "sc": "……那个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387132,
          "spk": "洋 (ヨウ)",
          "ja": "手、繋いでいい？",
          "tc": "可以牽你的手嗎？",
          "sc": "可以牵你的手吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387141,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387148,
          "spk": "主角心声/旁白/选项",
          "ja": "いいよ",
          "tc": "好啊",
          "sc": "好啊"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7613,
      "rec_id": "TALK_ID_70_2110_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387164,
          "spk": "洋 (ヨウ)",
          "ja": "……ありがとう",
          "tc": "……謝謝。",
          "sc": "……谢谢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387171,
          "spk": "洋 (ヨウ)",
          "ja": "前はね、夜が怖かったの",
          "tc": "以前，我很害怕夜晚。",
          "sc": "以前，我很害怕夜晚。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387178,
          "spk": "洋 (ヨウ)",
          "ja": "寂しくて、悲しくて、でも――",
          "tc": "覺得很寂寞、很難過，但是──",
          "sc": "觉得很寂寞、很难过，但是——"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387187,
          "spk": "洋 (ヨウ)",
          "ja": "今は、<player>が",
          "tc": "現在有<player>在，",
          "sc": "现在有<player>在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 387194,
          "spk": "洋 (ヨウ)",
          "ja": "みんながいてくれるから……",
          "tc": "還有大家在……",
          "sc": "还有大家在……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 387203,
          "spk": "洋 (ヨウ)",
          "ja": "全然、寂しくないよ……",
          "tc": "我一點也不寂寞了……",
          "sc": "我一点也不寂寞了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 387212,
          "spk": "洋 (ヨウ)",
          "ja": "……すぅ、……すぅ",
          "tc": "……呼……呼……",
          "sc": "……呼……呼……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7614,
      "rec_id": "TALK_ID_70_2110_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387232,
          "spk": "洋 (ヨウ)",
          "ja": "きのうはありがと、<player>",
          "tc": "昨天謝謝你，<player>。",
