          "f_idx": 3,
          "pidx_tc": 436883,
          "spk": "裕太 (ユータ)",
          "ja": "多分、鳥に慣れちゃえば",
          "tc": "我是在想，只要我習慣了鳥的存在，",
          "sc": "我是在想，只要我习惯了鸟的存在，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 436890,
          "spk": "裕太 (ユータ)",
          "ja": "声は出なくなると思うんだけど",
          "tc": "那我應該就不會叫出聲音了吧。",
          "sc": "那我应该就不会叫出声音了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 436903,
          "spk": "驹子 (コマコ)",
          "ja": "うーん……鳥が",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 436910,
          "spk": "驹子 (コマコ)",
          "ja": "もっと身近な存在に",
          "tc": "是不是只要多多接觸鳥類",
          "sc": "是不是只要多多接触鸟类"
