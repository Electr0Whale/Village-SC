          "spk": "裕太 (ユータ)",
          "ja": "好きだし、ゆくゆくは野鳥をスケッチして",
          "tc": "很喜歡喔，我還計劃以後要來畫一些野鳥素描，",
          "sc": "很喜欢哦，我还计划以后要来画一些野鸟素描，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 437024,
          "spk": "裕太 (ユータ)",
          "ja": "色を塗った絵を完成させたいかな",
          "tc": "然後上色完成整幅畫。",
          "sc": "然后上色完成整幅画。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 437042,
          "spk": "裕太 (ユータ)",
          "ja": "部屋のあちこちに野鳥の絵を貼って、",
          "tc": "只要在房間裡到處貼滿野鳥的畫，",
          "sc": "只要在房间里到处贴满野鸟的画，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 437049,
          "spk": "裕太 (ユータ)",
          "ja": "室内にいながらバードウォッチング気分を",
          "tc": "就能在室內享受賞鳥的樂趣了。",
