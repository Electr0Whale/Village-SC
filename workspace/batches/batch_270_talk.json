        {
          "f_idx": 13,
          "pidx_tc": 436977,
          "spk": "裕太 (ユータ)",
          "ja": "鳥に根こそぎ食べられちゃってね",
          "tc": "吃得一乾二淨，",
          "sc": "吃得一干二净，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 436984,
          "spk": "裕太 (ユータ)",
          "ja": "うちの近くで観察するのは諦めたよ",
          "tc": "所以我就放棄在家附近賞鳥了。",
          "sc": "所以我就放弃在家附近赏鸟了。"
        },
        {
