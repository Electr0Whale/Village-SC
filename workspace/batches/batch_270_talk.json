          "pidx_tc": 437141,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そうなんだ……",
          "tc": "這、這樣啊……",
          "sc": "这、这样啊……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 437154,
          "spk": "裕太 (ユータ)",
          "ja": "もちろん、絵の勉強をする日を",
          "tc": "我當然也覺得",
          "sc": "我当然也觉得"
        },
        {
          "f_idx": 33,
          "pidx_tc": 437161,
          "spk": "裕太 (ユータ)",
          "ja": "作らなくちゃいけないと思ってるよ",
          "tc": "應該要找時間練習畫畫。",
          "sc": "应该要找时间练习画画。"
        },
        {
          "f_idx": 35,
          "pidx_tc": 437179,
          "spk": "裕太 (ユータ)",
          "ja": "でも、虫取りの日も作りたいし",
          "tc": "但我也想找時間去捉昆蟲，",
          "sc": "但我也想找时间去捉昆虫，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 437186,
          "spk": "裕太 (ユータ)",
          "ja": "コーヒー豆の好みの焙煎を",
          "tc": "也想研究一下",
          "sc": "也想研究一下"
        },
        {
          "f_idx": 37,
          "pidx_tc": 437193,
          "spk": "裕太 (ユータ)",
          "ja": "追求する日も作りたいんだよね",
          "tc": "自己喜歡怎樣的咖啡豆烘焙法。",
          "sc": "自己喜欢怎样的咖啡豆烘焙法。"
