          "spk": "驹子 (コマコ)",
          "ja": "なればいいのかな？",
          "tc": "就行了呢？",
          "sc": "就行了呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 436930,
          "spk": "裕太 (ユータ)",
          "ja": "前に、そう思って家の裏に",
          "tc": "我之前也是這麼想，",
          "sc": "我之前也是这么想，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 436937,
          "spk": "裕太 (ユータ)",
          "ja": "バードフィーダーをＤＩＹして",
          "tc": "所以曾經自製了餵鳥器，",
          "sc": "所以曾经自制了喂鸟器，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 436944,
          "spk": "裕太 (ユータ)",
          "ja": "設置したことがあるんだ",
          "tc": "放在了我家後院。",
          "sc": "放在了我家后院。"
