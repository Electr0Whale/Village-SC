  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7664,
      "rec_id": "TALK_ID_70_2120_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438964,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、落ち着いてるね",
          "tc": "<player>你很冷靜呢，",
          "sc": "<player>你很冷静呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438971,
          "spk": "裕太 (ユータ)",
          "ja": "俺のほうが全然年上なのに",
          "tc": "明明是我的年紀比較大，",
          "sc": "明明是我的年纪比较大，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438978,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと恥ずかしいな",
          "tc": "讓我感覺有點丟臉呢。",
          "sc": "让我感觉有点丢脸呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438987,
          "spk": "裕太 (ユータ)",
          "ja": "キミはいろんなことに動じないし自立してるし、",
          "tc": "你遇到事情都很冷靜，又很自立，",
          "sc": "你遇到事情都很冷静，又很自立，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438994,
          "spk": "裕太 (ユータ)",
          "ja": "俺よりよっぽど大人に見えるよ",
          "tc": "根本比我還要像大人。",
          "sc": "根本比我还要像大人。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439010,
          "spk": "裕太 (ユータ)",
          "ja": "キミならきっと何にでもなれるんだろうな",
          "tc": "我想你一定可以成為任何你想成為的人，",
          "sc": "我想你一定可以成为任何你想成为的人，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439017,
          "spk": "裕太 (ユータ)",
          "ja": "どんな夢でも叶えられると思う",
          "tc": "實現任何夢想的。",
          "sc": "实现任何梦想的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439033,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、<player>には",
          "tc": "對了，<player>，",
          "sc": "对了，<player>，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439040,
          "spk": "裕太 (ユータ)",
          "ja": "叶えたい夢があるの？",
          "tc": "你有想要實現的夢想嗎？",
          "sc": "你有想要实现的梦想吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 439049,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 439056,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7665,
      "rec_id": "TALK_ID_70_2120_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439164,
          "spk": "裕太 (ユータ)",
          "ja": "夢とか目標とか",
          "tc": "夢想也好，目標也罷，",
          "sc": "梦想也好，目标也罢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439171,
          "spk": "裕太 (ユータ)",
          "ja": "自分で決めるゴールはさ",
          "tc": "所謂的終點，",
          "sc": "所谓的终点，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439180,
          "spk": "裕太 (ユータ)",
          "ja": "一つだけじゃなくてもいいって",
          "tc": "有很多個也沒有關係。",
          "sc": "有很多个也没有关系。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439187,
          "spk": "裕太 (ユータ)",
          "ja": "この村に来てから気がついたんだ",
          "tc": "這是我來到了這個村子之後才明白的。",
          "sc": "这是我来到了这个村子之后才明白的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439196,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が来てからは",
          "tc": "自從<player>你來了之後，",
          "sc": "自从<player>你来了之后，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439203,
          "spk": "裕太 (ユータ)",
          "ja": "目の前の暮らしをただ楽しむっていうのも",
          "tc": "我就開始覺得享受當下的生活",
          "sc": "我就开始觉得享受当下的生活"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439210,
          "spk": "裕太 (ユータ)",
          "ja": "大事な夢の一つだって思えるようになったよ",
          "tc": "也是很重要的夢想呢。",
          "sc": "也是很重要的梦想呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439219,
          "spk": "裕太 (ユータ)",
          "ja": "一時期は、死ぬまでにやりたいことリストの",
          "tc": "曾經有段時間，",
          "sc": "曾经有段时间，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439226,
          "spk": "裕太 (ユータ)",
          "ja": "消化に追われるばっかりの時もあったけど",
          "tc": "我一心都只想著要完成死前願望清單。",
          "sc": "我一心都只想着要完成死前愿望清单。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439242,
          "spk": "裕太 (ユータ)",
          "ja": "今は、もっとのんびり過ごすのも",
          "tc": "但現在覺得",
          "sc": "但现在觉得"
        },
        {
          "f_idx": 11,
          "pidx_tc": 439249,
          "spk": "裕太 (ユータ)",
          "ja": "いいかもしれないって思ってる",
          "tc": "悠悠哉哉地過日子或許也沒什麼不好的。",
          "sc": "悠悠哉哉地过日子或许也没什么不好的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 439265,
          "spk": "裕太 (ユータ)",
          "ja": "キミが釣りとか、虫取りとか、",
          "tc": "如果你想要釣魚、抓昆蟲，",
          "sc": "如果你想要钓鱼、抓昆虫，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 439272,
          "spk": "裕太 (ユータ)",
          "ja": "ただただお喋りをしたくなったら",
          "tc": "或者只是想找人說說話，",
          "sc": "或者只是想找人说说话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 439279,
          "spk": "裕太 (ユータ)",
          "ja": "俺、いつでも相手になるからね",
          "tc": "你都可以過來找我喔。",
          "sc": "你都可以过来找我哦。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 439288,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が楽しいことをしたいって",
          "tc": "如果在<player>想要享受生活的時候，",
          "sc": "如果在<player>想要享受生活的时候，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 439295,
          "spk": "裕太 (ユータ)",
          "ja": "思った時に、一緒に遊ぶ候補の",
          "tc": "我可以成為與你同樂的其中一個人選，",
          "sc": "我可以成为与你同乐的其中一个人选，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 439302,
          "spk": "裕太 (ユータ)",
          "ja": "一人に入れてくれたら嬉しいよ",
          "tc": "那我會很開心的。",
          "sc": "那我会很开心的。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 439311,
          "spk": "裕太 (ユータ)",
          "ja": "俺にとって、キミとの時間が",
          "tc": "我覺得跟你在一起的時候",
          "sc": "我觉得跟你在一起的时候"
        },
        {
          "f_idx": 20,
          "pidx_tc": 439318,
          "spk": "裕太 (ユータ)",
          "ja": "居心地のいいものであるみたいに",
          "tc": "真的很令人安心。",
          "sc": "真的很令人安心。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 439327,
          "spk": "裕太 (ユータ)",
          "ja": "キミにとっても、俺との時間が",
          "tc": "所以如果你也能覺得和我在一起的時候",
          "sc": "所以如果你也能觉得和我在一起的时候"
        },
        {
          "f_idx": 22,
          "pidx_tc": 439334,
          "spk": "裕太 (ユータ)",
          "ja": "居心地のいいものだったらいいな",
          "tc": "很放鬆的話，那就太好了。",
          "sc": "很放松的话，那就太好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7666,
      "rec_id": "TALK_ID_70_2120_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439361,
          "spk": "裕太 (ユータ)",
          "ja": "なんだか、眠れそうにないね",
          "tc": "總覺得好像一點都不睏呢。",
          "sc": "总觉得好像一点都不困呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439368,
          "spk": "裕太 (ユータ)",
          "ja": "キミも目が冴えてるんじゃない？",
          "tc": "你是不是精神也很好？",
          "sc": "你是不是精神也很好？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7667,
      "rec_id": "TALK_ID_70_2120_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439392,
          "spk": "裕太 (ユータ)",
          "ja": "よかったら聞いてて",
          "tc": "那你就繼續聽我說吧。",
          "sc": "那你就继续听我说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7668,
      "rec_id": "TALK_ID_70_2120_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439416,
          "spk": "裕太 (ユータ)",
          "ja": "あー、よく眠れたね！",
          "tc": "啊～睡得真好！",
          "sc": "啊～睡得真好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439423,
          "spk": "裕太 (ユータ)",
          "ja": "何か楽しい夢を見たような気が",
          "tc": "我好像夢到了很開心的夢，",
          "sc": "我好像梦到了很开心的梦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439430,
          "spk": "裕太 (ユータ)",
          "ja": "するんだけど、思い出せないや",
          "tc": "但完全想不起來。",
          "sc": "但完全想不起来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439441,
          "spk": "裕太 (ユータ)",
          "ja": "<player>と真っ暗な部屋で",
          "tc": "跟<player>你在全黑的房間裡",
          "sc": "跟<player>你在全黑的房间里"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439448,
          "spk": "裕太 (ユータ)",
          "ja": "小声で喋るのも楽しかったな",
          "tc": "小小聲講話真好玩。",
          "sc": "小小声讲话真好玩。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439466,
          "spk": "裕太 (ユータ)",
          "ja": "修学旅行を思いだして、",
          "tc": "這讓我回想起了校外教學，",
          "sc": "这让我回想起了校外教学，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439473,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと青春気分っていうか",
          "tc": "感覺有種青春的感覺，",
          "sc": "感觉有种青春的感觉，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439480,
          "spk": "裕太 (ユータ)",
          "ja": "懐かしい感じがしたよ",
          "tc": "也令人有點懷念呢。",
          "sc": "也令人有点怀念呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439491,
          "spk": "裕太 (ユータ)",
          "ja": "キミがもう少し大きくなったら",
          "tc": "等你再稍微長大一點，",
          "sc": "等你再稍微长大一点，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439498,
          "spk": "裕太 (ユータ)",
          "ja": "恋バナしながら寝るのもいいよね",
          "tc": "我們就可以邊睡邊聊戀愛話題了。",
          "sc": "我们就可以边睡边聊恋爱话题了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 439516,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>って",
          "tc": "啊，是說<player>，",
          "sc": "啊，是说<player>，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 439523,
          "spk": "裕太 (ユータ)",
          "ja": "気になってる相手はいるの？",
          "tc": "你有沒有在意的人啊？",
          "sc": "你有没有在意的人啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7669,
      "rec_id": "TALK_ID_70_2120_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439541,
          "spk": "裕太 (ユータ)",
          "ja": "あはは！",
          "tc": "啊哈哈！",
          "sc": "啊哈哈！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439548,
          "spk": "裕太 (ユータ)",
          "ja": "そういう話は",
          "tc": "這個話題",
          "sc": "这个话题"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439555,
          "spk": "裕太 (ユータ)",
          "ja": "また今度しようか",
          "tc": "我們就下次再聊吧。",
          "sc": "我们就下次再聊吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439566,
          "spk": "裕太 (ユータ)",
          "ja": "こう見えても俺、",
          "tc": "別看我這樣，",
          "sc": "别看我这样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439573,
          "spk": "裕太 (ユータ)",
          "ja": "秘密は守る主義なんだ",
          "tc": "我可是很會保密的喔。",
          "sc": "我可是很会保密的哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439591,
          "spk": "裕太 (ユータ)",
          "ja": "あとは、修学旅行といえば",
          "tc": "還有，說到校外教學，",
          "sc": "还有，说到校外教学，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439598,
          "spk": "裕太 (ユータ)",
          "ja": "枕投げとかね",
          "tc": "就不得不來場枕頭戰呢。",
          "sc": "就不得不来场枕头战呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439609,
          "spk": "裕太 (ユータ)",
          "ja": "<player>がしたいなら",
          "tc": "如果<player>有興趣，",
          "sc": "如果<player>有兴趣，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439616,
          "spk": "裕太 (ユータ)",
          "ja": "枕をたくさん用意しておくよ",
          "tc": "我可以準備一堆枕頭喔。",
          "sc": "我可以准备一堆枕头哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439627,
          "spk": "裕太 (ユータ)",
          "ja": "あとは……俺はあまり気が進まないけど",
          "tc": "還有……雖然我沒什麼興趣，",
          "sc": "还有……虽然我没什么兴趣，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 439634,
          "spk": "裕太 (ユータ)",
          "ja": "怪談話をするのも修学旅行の定番だね",
          "tc": "但講鬼故事也是校外教學必做的事呢。",
          "sc": "但讲鬼故事也是校外教学必做的事呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 439652,
          "spk": "裕太 (ユータ)",
          "ja": "俺はあまり気が進まないけど！",
          "tc": "雖然我對這個真的沒什麼興趣！",
          "sc": "虽然我对这个真的没什么兴趣！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7670,
      "rec_id": "TALK_ID_70_2120_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439670,
          "spk": "裕太 (ユータ)",
          "ja": "とにかく、泊まりだからこそ",
          "tc": "總之，",
          "sc": "总之，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439677,
          "spk": "裕太 (ユータ)",
          "ja": "できることとか楽しいことって",
          "tc": "還有很多很多好玩的事",
          "sc": "还有很多很多好玩的事"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439684,
          "spk": "裕太 (ユータ)",
          "ja": "いろいろあるからさ",
          "tc": "是一起過夜才能做的。",
          "sc": "是一起过夜才能做的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439695,
          "spk": "裕太 (ユータ)",
          "ja": "また絶対に",
          "tc": "所以你下次",
          "sc": "所以你下次"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439702,
          "spk": "裕太 (ユータ)",
          "ja": "泊まりにおいでね",
          "tc": "一定要再來我家過夜喔。",
          "sc": "一定要再来我家过夜哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439709,
          "spk": "裕太 (ユータ)",
          "ja": "待ってるよ",
          "tc": "我等你！",
          "sc": "我等你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7671,
      "rec_id": "TALK_ID_70_2130_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439733,
          "spk": "堇怜 (スミレ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439740,
          "spk": "堇怜 (スミレ)",
          "ja": "キミも釣りに来たの？",
          "tc": "你也來釣魚嗎？",
          "sc": "你也来钓鱼吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7672,
      "rec_id": "TALK_ID_70_2130_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439758,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、隣おいでよ",
          "tc": "來，到我旁邊來吧。",
          "sc": "来，到我旁边来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7673,
      "rec_id": "TALK_ID_70_2130_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439782,
          "spk": "堇怜 (スミレ)",
          "ja": "釣りって良いよね……",
          "tc": "釣魚很不錯吧……",
          "sc": "钓鱼很不错吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439789,
          "spk": "堇怜 (スミレ)",
          "ja": "静かな自然の中なのに、",
          "tc": "雖然身在寧靜的大自然中，",
          "sc": "虽然身在宁静的大自然中，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439796,
          "spk": "堇怜 (スミレ)",
          "ja": "魚との駆け引きの興奮を味わえて……",
          "tc": "卻能體驗與魚搏鬥的刺激……",
          "sc": "却能体验与鱼搏斗的刺激……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439807,
          "spk": "堇怜 (スミレ)",
          "ja": "まあでも、僕にとっては",
          "tc": "不過，對我來說，",
          "sc": "不过，对我来说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439814,
          "spk": "堇怜 (スミレ)",
          "ja": "仕事に近い感覚だけど……",
          "tc": "更像在工作就是了……",
          "sc": "更像在工作就是了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439825,
          "spk": "堇怜 (スミレ)",
          "ja": "魚はリンに売ったり、",
          "tc": "我釣到的魚會賣給林，",
          "sc": "我钓到的鱼会卖给林，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439832,
          "spk": "堇怜 (スミレ)",
          "ja": "自分で食べるために釣ってるんだ",
          "tc": "或是自己拿來吃。",
          "sc": "或是自己拿来吃。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439843,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、釣りばっかしてると",
          "tc": "只不過老是在釣魚的話，",
          "sc": "只不过老是在钓鱼的话，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439850,
          "spk": "堇怜 (スミレ)",
          "ja": "学生は勉強に集中しなさいって",
          "tc": "姊姊就會一直念我，",
          "sc": "姐姐就会一直念我，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439857,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんがうるさいんだよ",
          "tc": "說學生就該專心讀書。",
          "sc": "说学生就该专心读书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7674,
      "rec_id": "TALK_ID_70_2130_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439881,
          "spk": "堇怜 (スミレ)",
          "ja": "言ってなかったっけ？",
          "tc": "我沒說過嗎？",
          "sc": "我没说过吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439888,
          "spk": "堇怜 (スミレ)",
          "ja": "通信制の学校に通ってるんだ",
          "tc": "我正在念函授學校。",
          "sc": "我正在念函授学校。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439899,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強は嫌いじゃないけどさ……",
          "tc": "雖然我不討厭念書……",
          "sc": "虽然我不讨厌念书……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439906,
          "spk": "堇怜 (スミレ)",
          "ja": "大学に行くってなったら",
          "tc": "可是如果要上大學，",
          "sc": "可是如果要上大学，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439913,
          "spk": "堇怜 (スミレ)",
          "ja": "お金がかかるだろ？",
          "tc": "會很花錢不是嗎？",
          "sc": "会很花钱不是吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439924,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も、村の外に",
          "tc": "雖然我也不是",
          "sc": "虽然我也不是"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439931,
          "spk": "堇怜 (スミレ)",
          "ja": "興味がないわけじゃないんだけど……",
          "tc": "對村子外面的世界沒有興趣……",
          "sc": "对村子外面的世界没有兴趣……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439938,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが、また心配するだろうからなぁ……",
          "tc": "但畢竟又會讓姊姊擔心……",
          "sc": "但毕竟又会让姐姐担心……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7675,
      "rec_id": "TALK_ID_70_2130_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439956,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、あの人って無駄に心配性だろ？",
          "tc": "你也知道，我姊姊就是愛操心嘛。",
          "sc": "你也知道，我姐姐就是爱操心嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439974,
          "spk": "堇怜 (スミレ)",
          "ja": "頭がいいぶん、いろんな最悪のケースまで",
          "tc": "因為很聰明，所以連各種最壞的狀況",
          "sc": "因为很聪明，所以连各种最坏的状况"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439981,
          "spk": "堇怜 (スミレ)",
          "ja": "考えちゃうんだろうけど……",
          "tc": "都先想到了……",
          "sc": "都先想到了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439988,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがに、ちょっと考えすぎなんだよね",
          "tc": "我是覺得她有點想太多了。",
          "sc": "我是觉得她有点想太多了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439999,
          "spk": "堇怜 (スミレ)",
          "ja": "僕なんて、ピアスも",
          "tc": "就連耳環也是，",
          "sc": "就连耳环也是，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 440006,
          "spk": "堇怜 (スミレ)",
          "ja": "成人するまではダメって言われてるんだぜ",
          "tc": "姊姊命令我到成年之前都不可以打耳洞呢。",
          "sc": "姐姐命令我到成年之前都不可以打耳洞呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 440017,
          "spk": "堇怜 (スミレ)",
          "ja": "バイキンが入って腫れるかもしれないって……",
          "tc": "說要是細菌感染會紅腫發炎……",
          "sc": "说要是细菌感染会红肿发炎……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 440024,
          "spk": "堇怜 (スミレ)",
          "ja": "自分は開けてるくせにさ",
          "tc": "但她自己卻有打耳洞。",
          "sc": "但她自己却有打耳洞。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 440035,
          "spk": "堇怜 (スミレ)",
          "ja": "ほんと、過保護なんだ……",
          "tc": "真的是保護過頭了……",
          "sc": "真的是保护过头了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 440042,
          "spk": "堇怜 (スミレ)",
          "ja": "そのくせ、何でも一人で抱え込もうとするし……",
          "tc": "然而她卻總想一個人承擔一切……",
          "sc": "然而她却总想一个人承担一切……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 440049,
          "spk": "堇怜 (スミレ)",
          "ja": "まったく、世話の焼ける人なんだよね……",
          "tc": "真是讓人操心啊……",
          "sc": "真是让人操心啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7676,
      "rec_id": "TALK_ID_70_2130_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440073,
          "spk": "堇怜 (スミレ)",
          "ja": "……あ、<player>！",
          "tc": "……啊，<player>！",
          "sc": "……啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440080,
          "spk": "堇怜 (スミレ)",
          "ja": "引いてる、引いてるよっ！",
          "tc": "上鉤了，有魚上鉤了！",
          "sc": "上钩了，有鱼上钩了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7677,
      "rec_id": "TALK_ID_70_2130_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440104,
          "spk": "堇怜 (スミレ)",
          "ja": "お～なかなかの大物だ……",
          "tc": "哦～還真大隻耶……",
          "sc": "哦～还真大只呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440115,
          "spk": "堇怜 (スミレ)",
          "ja": "これだけ大きければ一日分……",
          "tc": "這麼大隻的話應該可以吃一天……",
          "sc": "这么大只的话应该可以吃一天……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440122,
          "spk": "堇怜 (スミレ)",
          "ja": "いや、二日分は困らなさそう……",
          "tc": "不，吃兩天都沒問題……",
          "sc": "不，吃两天都没问题……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440131,
          "spk": "主角心声/旁白/选项",
          "ja": "いる？",
          "tc": "你要嗎？",
          "sc": "你要吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440138,
          "spk": "主角心声/旁白/选项",
          "ja": "たべる？",
          "tc": "要吃嗎？",
          "sc": "要吃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7678,
      "rec_id": "TALK_ID_70_2130_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440224,
          "spk": "堇怜 (スミレ)",
          "ja": "ありがとな、<player>！",
          "tc": "謝啦，<player>！",
          "sc": "谢啦，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440235,
          "spk": "堇怜 (スミレ)",
          "ja": "今日の夜は久しぶりのごちそうだ！",
          "tc": "今晚可以來頓久違的大餐了！",
          "sc": "今晚可以来顿久违的大餐了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440242,
          "spk": "堇怜 (スミレ)",
          "ja": "いつもはもっと小さい魚か山菜ばっかりだから",
          "tc": "畢竟平常總是吃更小條的魚和山菜，",
          "sc": "毕竟平常总是吃更小条的鱼和山菜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440249,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんもきっと喜ぶぞ～！",
          "tc": "姊姊也一定會很高興～！",
          "sc": "姐姐也一定会很高兴～！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440260,
          "spk": "堇怜 (スミレ)",
          "ja": "お魚って本っ当最高だよ",
          "tc": "魚真的是很棒的東西呢。",
          "sc": "鱼真的是很棒的东西呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 440267,
          "spk": "堇怜 (スミレ)",
          "ja": "文句一つ言わずに",
          "tc": "一句怨言也沒有",
          "sc": "一句怨言也没有"
        },
        {
          "f_idx": 6,
          "pidx_tc": 440274,
          "spk": "堇怜 (スミレ)",
          "ja": "タダで食べさせてくれるんだから！",
          "tc": "就免費讓我們享用！",
          "sc": "就免费让我们享用！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 440285,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃあ、またね！",
          "tc": "那就下次見囉！",
          "sc": "那就下次见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7679,
      "rec_id": "TALK_ID_70_2130_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440311,
          "spk": "裕太 (ユータ)",
          "ja": "スミレくん！　スミレくん！",
          "tc": "堇怜！堇怜！",
          "sc": "堇怜！堇怜！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440320,
          "spk": "裕太 (ユータ)",
          "ja": "田舎ならではの",
          "tc": "快點教教我",
          "sc": "快点教教我"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440327,
          "spk": "裕太 (ユータ)",
          "ja": "遊びを教えてよ！",
          "tc": "鄉下才能玩的遊戲嘛！",
          "sc": "乡下才能玩的游戏嘛！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440340,
          "spk": "堇怜 (スミレ)",
          "ja": "だから嫌ですって",
          "tc": "就說才不要了。",
          "sc": "就说才不要了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440347,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も暇じゃないんです",
          "tc": "我也是很忙的。",
          "sc": "我也是很忙的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7680,
      "rec_id": "TALK_ID_70_2130_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440365,
          "spk": "裕太 (ユータ)",
          "ja": "いやいや、そう言わずに……",
          "tc": "哎唷，別這麼說嘛……",
          "sc": "哎呀，别这么说嘛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440372,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、<player>だ",
          "tc": "啊，是<player>。",
          "sc": "啊，是<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7681,
      "rec_id": "TALK_ID_70_2130_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440390,
          "spk": "裕太 (ユータ)",
          "ja": "ねえねえねえ",
          "tc": "我說啊，",
          "sc": "我说啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440397,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も自然の中で楽しめる",
          "tc": "<player>想不想知道",
          "sc": "<player>想不想知道"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440404,
          "spk": "裕太 (ユータ)",
          "ja": "遊びを知りたくない？",
          "tc": "能在大自然中玩的遊戲？",
          "sc": "能在大自然中玩的游戏？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7682,
      "rec_id": "TALK_ID_70_2130_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440422,
          "spk": "堇怜 (スミレ)",
          "ja": "ユータさん",
          "tc": "裕太哥，",
          "sc": "裕太哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440429,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>を使うのは",
          "tc": "利用<player>",
          "sc": "利用<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440436,
          "spk": "堇怜 (スミレ)",
          "ja": "卑怯ですよ……",
          "tc": "這樣太狡猾了……",
          "sc": "这样太狡猾了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440449,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、いいでしょ？",
          "tc": "拜託啦，好不好？",
          "sc": "拜托啦，好不好？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440456,
          "spk": "裕太 (ユータ)",
          "ja": "減るもんじゃないんだからさ",
          "tc": "反正又不會少一塊肉。",
          "sc": "反正又不会少一块肉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7683,
      "rec_id": "TALK_ID_70_2130_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440474,
          "spk": "堇怜 (スミレ)",
          "ja": "……わかりました",
          "tc": "……我知道了。",
          "sc": "……我知道了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440481,
          "spk": "堇怜 (スミレ)",
          "ja": "教えればいいんですね",
          "tc": "告訴你就可以了吧。",
          "sc": "告诉你就可以了吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440494,
          "spk": "裕太 (ユータ)",
          "ja": "そうこなくっちゃ！",
          "tc": "這樣才對嘛！",
          "sc": "这样才对嘛！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440507,
          "spk": "堇怜 (スミレ)",
          "ja": "今からやってみせますから",
          "tc": "接下來我要示範給你們看，",
          "sc": "接下来我要示范给你们看，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440514,
          "spk": "堇怜 (スミレ)",
          "ja": "見ててください",
          "tc": "請看仔細了。",
          "sc": "请看仔细了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7684,
      "rec_id": "TALK_ID_70_2130_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440542,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、水切りだ！",
          "tc": "啊，是打水漂！",
          "sc": "啊，是打水漂！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440549,
          "spk": "裕太 (ユータ)",
          "ja": "話には聞いたことあるけど",
          "tc": "雖然有聽說過，",
          "sc": "虽然有听说过，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440556,
          "spk": "裕太 (ユータ)",
          "ja": "見るのは初めてだよ！",
          "tc": "但第一次親眼見識到耶！",
          "sc": "但第一次亲眼见识到呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440569,
          "spk": "堇怜 (スミレ)",
          "ja": "石を投げる時の、",
          "tc": "訣竅就在於擲出石頭的時候，",
