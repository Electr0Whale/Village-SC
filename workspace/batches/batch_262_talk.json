          "pidx_tc": 460950,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんのお陰っスね",
          "tc": "都是多虧了<player>你。",
          "sc": "都是多亏了<player>你呐。"
        }
      ]
    },
