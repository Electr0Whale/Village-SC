      "rec_id": "TALK_ID_70_2080_008_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 460843,
          "spk": "六角 (ロッカク)",
          "ja": "それにしても、料理って不思議っスよね",
          "tc": "不過話說回來，料理真是很神奇。",
          "sc": "不过话说回来，料理真是很神奇哟。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 460850,
          "spk": "六角 (ロッカク)",
          "ja": "手間かけりゃ美味いに決まってますが、",
          "tc": "只要用心，就能做出美味的料理，",
          "sc": "只要用心，就能做出美味的料理，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 460857,
          "spk": "六角 (ロッカク)",
          "ja": "手抜きのモンも、そこそこ美味いっていう",
          "tc": "但即使懶惰隨便弄弄，也是不錯吃。",
          "sc": "但即使懒惰随便弄弄，也是不错吃。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 460868,
          "spk": "六角 (ロッカク)",
          "ja": "何がいいんスかね……？",
          "tc": "到底是為什麼呢……？",
          "sc": "到底是为什么呢……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 460875,
          "spk": "六角 (ロッカク)",
          "ja": "村の空気のおかげ……？",
          "tc": "是因為村裡的氛圍……？",
          "sc": "是因为村里的氛围……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 460882,
          "spk": "六角 (ロッカク)",
          "ja": "いや、ワシの腕……？",
          "tc": "不，是因問我的廚藝……？",
          "sc": "不，是因问我的厨艺……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 460893,
          "spk": "六角 (ロッカク)",
          "ja": "いや、きっと村の人達のおかげっスね",
          "tc": "不，一定是多虧了村民們吧。",
          "sc": "不，一定是多亏了村民们呐。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 460900,
          "spk": "六角 (ロッカク)",
          "ja": "みなさんがいたから、続けてこれたんだ",
          "tc": "因為有大家，才能持續到現在。",
          "sc": "因为有大家，才能持续到现在。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 460918,
          "spk": "六角 (ロッカク)",
          "ja": "この村に来てからというもの、",
          "tc": "自從來到這個村子之後，",
          "sc": "自从来到这个村子之后，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 460925,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの作ったメシを誰かが食ってくれる瞬間が、",
          "tc": "有人吃我做的飯的那個瞬間，",
          "sc": "有人吃我做的饭的那个瞬间，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 460932,
          "spk": "六角 (ロッカク)",
          "ja": "人生の楽しみの一つになりました",
          "tc": "成了我人生中的樂趣之一。",
          "sc": "成了我人生中的乐趣之一。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 460943,
          "spk": "六角 (ロッカク)",
          "ja": "だから今、ワシはけっこう充実してます",
          "tc": "所以我現在生活非常充實",
          "sc": "所以我现在生活非常充实"
        },
