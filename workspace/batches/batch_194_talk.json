          "sc": "但在祭品仪式完成之前，都不能掉以轻心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4546,
      "rec_id": "TALK_ID_10_0303_061_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 263108,
          "spk": "名护 (ナゴ)",
          "ja": "おお、俺の財布！！",
          "tc": "哦，是我的錢包！！",
          "sc": "哦，是我的钱包！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 263119,
          "spk": "名护 (ナゴ)",
          "ja": "あんなに探しても見つからなかったのに……",
          "tc": "明明找了那麼久都沒找到……",
          "sc": "明明找了那么久都没找到……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 263126,
          "spk": "名护 (ナゴ)",
          "ja": "一体、どうやって手に入れたんだい？",
          "tc": "你到底是怎麼找到它的？",
          "sc": "你到底是怎么找到它的？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4547,
      "rec_id": "TALK_ID_10_0303_061_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 263144,
          "spk": "名护 (ナゴ)",
          "ja": "……どうした？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 263151,
          "spk": "名护 (ナゴ)",
          "ja": "そんな浮かない顔をして……",
          "tc": "看起來不太開心的樣子……",
          "sc": "看起来不太开心的样子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 263162,
          "spk": "名护 (ナゴ)",
          "ja": "何があったのかは、聞かないでおくよ",
          "tc": "我就不過問發生了什麼事。",
          "sc": "我就不过问发生了什么事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 263169,
          "spk": "名护 (ナゴ)",
          "ja": "とりあえず、見つけ出してくれてありがとう",
          "tc": "總之謝謝你找到它。",
          "sc": "总之谢谢你找到它。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 263187,
          "spk": "名护 (ナゴ)",
          "ja": "約束通り、中身の10万を……",
          "tc": "我就照著約定，裡面的十萬就……",
          "sc": "我就照着约定，里面的十万就……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 263198,
          "spk": "名护 (ナゴ)",
          "ja": "あれ……ないぞ！",
          "tc": "咦……沒有！？",
          "sc": "咦……没有！？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 263205,
          "spk": "名护 (ナゴ)",
          "ja": "どうして空っぽなんだ！！",
          "tc": "為什麼是空的！？",
          "sc": "为什么是空的！？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 263212,
          "spk": "名护 (ナゴ)",
          "ja": "ココの鈴までなくなってるだなんて……！",
          "tc": "連可可的鈴鐺也都不見了……！",
          "sc": "连可可的铃铛也都不见了……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4548,
      "rec_id": "TALK_ID_10_0303_061_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 263230,
          "spk": "名护 (ナゴ)",
          "ja": "嘘だろ……こんなこと……！",
          "tc": "不會吧……怎麼會這樣……！",
          "sc": "不会吧……怎么会这样……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 263241,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、財布に入っていた、",
          "tc": "<player>，你有看到",
          "sc": "<player>，你看见"
        },
        {
          "f_idx": 2,
          "pidx_tc": 263248,
          "spk": "名护 (ナゴ)",
          "ja": "小さな鈴を知らないかい？",
          "tc": "本來放在錢包裡的小鈴鐺嗎？",
          "sc": "本来放在钱包里的小铃铛吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 263255,
          "spk": "名护 (ナゴ)",
          "ja": "大事な大事なものなんだ……",
          "tc": "那是我非常重要、非常重要的東西……",
          "sc": "那是我非常重要、非常重要的东西……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 263266,
          "spk": "名护 (ナゴ)",
          "ja": "俺は財布なんて、お金なんて、",
          "tc": "其實錢包本身或裡面的錢",
          "sc": "其实钱包本身或里面的钱"
        },
        {
          "f_idx": 5,
          "pidx_tc": 263273,
          "spk": "名护 (ナゴ)",
          "ja": "どうでもよかったんだよ……",
          "tc": "對我來說都無所謂……",
          "sc": "对我来说都无所谓……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 263280,
          "spk": "名护 (ナゴ)",
          "ja": "鈴さえ取り戻せたら……",
          "tc": "只要能找回鈴鐺……",
          "sc": "只要能找回铃铛……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 263291,
          "spk": "名护 (ナゴ)",
          "ja": "すまない……",
          "tc": "抱歉……",
          "sc": "抱歉……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 263298,
          "spk": "名护 (ナゴ)",
          "ja": "せっかく取り戻してくれたのに、",
          "tc": "明明你好不容易幫我找回來了，",
          "sc": "明明你好不容易帮我找回来了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 263305,
          "spk": "名护 (ナゴ)",
          "ja": "喜んであげられなくて……",
          "tc": "我卻沒辦法高興……",
          "sc": "我却没办法高兴……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 263314,
          "spk": "名护 (ナゴ)",
          "ja": "もし、鈴を見つけたら……",
          "tc": "如果你能找到鈴鐺……",
          "sc": "如果你能找到铃铛……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 263321,
          "spk": "名护 (ナゴ)",
          "ja": "いや、もうやめよう",
          "tc": "不，還是算了吧。",
          "sc": "不，还是算了吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 263328,
          "spk": "名护 (ナゴ)",
          "ja": "キミに頼りすぎているからね……",
          "tc": "我太依賴你了……",
          "sc": "我太依赖你了……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 263339,
          "spk": "名护 (ナゴ)",
          "ja": "中身のお金も無くなっているから、",
          "tc": "因為裡面的錢也不見了，",
          "sc": "因为里面的钱也不见了，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 263346,
          "spk": "名护 (ナゴ)",
          "ja": "何か別のお礼をできるように準備するよ",
          "tc": "我會準備其他東西當作謝禮的。",
          "sc": "我会准备其他东西当作谢礼的。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 263364,
          "spk": "名护 (ナゴ)",
          "ja": "また、明日以降に、",
          "tc": "你明天之後",
          "sc": "你明天之后"
        },
        {
          "f_idx": 17,
          "pidx_tc": 263371,
          "spk": "名护 (ナゴ)",
          "ja": "図書館に来ておくれ",
          "tc": "再來一趟圖書館吧。",
          "sc": "再来一趟图书馆吧。"
        }
      ]
    },
    {
