  "record_count": 46,
  "line_count": 198,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4652,
      "rec_id": "TALK_ID_10_0401_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266811,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの部屋の前で",
          "tc": "兩位站在我房門前，",
          "sc": "两位站在我房门前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266818,
          "spk": "今野 (コンノ)",
          "ja": "なにをしてるんですかァ",
          "tc": "有什麼事情嗎～？",
          "sc": "有什么事情吗～？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266831,
          "spk": "驹子 (コマコ)",
          "ja": "こ、コンノさん、こ、これは……",
          "tc": "今、今野先生，這、這是……",
          "sc": "今、今野先生，这、这是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266838,
          "spk": "驹子 (コマコ)",
          "ja": "あの、その……",
          "tc": "因為，那個……",
          "sc": "因为，那个……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266851,
          "spk": "今野 (コンノ)",
          "ja": "何か悪巧みですかねェ？",
          "tc": "是在打什麼壞主意嗎～？",
          "sc": "是在打什么坏主意吗～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4653,
      "rec_id": "TALK_ID_10_0401_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266869,
          "spk": "驹子 (コマコ)",
          "ja": "ち、違うよ、ちょっと、",
          "tc": "沒、沒有啦，純粹只是……",
          "sc": "没、没有啦，纯粹只是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266876,
          "spk": "驹子 (コマコ)",
          "ja": "コンノさんに聞きたいことがあって……",
          "tc": "有事情想問今野先生而已……",
          "sc": "有事情想问今野先生而已……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266889,
          "spk": "今野 (コンノ)",
          "ja": "場合によってはリンさんに",
          "tc": "視情況而定，",
          "sc": "视情况而定，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266896,
          "spk": "今野 (コンノ)",
          "ja": "お叱りいただかないと",
          "tc": "我得請林小姐訓斥兩位才行呢。",
          "sc": "我得请林小姐训斥两位才行呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266907,
          "spk": "今野 (コンノ)",
          "ja": "……ですが、ワタシは今機嫌が大変良いのです",
          "tc": "……但是啊，我現在心情正好，",
          "sc": "……但是啊，我现在心情正好，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 266914,
          "spk": "今野 (コンノ)",
          "ja": "アナタたちの悪事を咎めている場合ではない",
          "tc": "沒那個閒功夫追究兩位想幹的壞事。",
          "sc": "没那个闲功夫追究两位想干的坏事。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 266934,
          "spk": "驹子 (コマコ)",
          "ja": "……ヘ？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 266941,
          "spk": "驹子 (コマコ)",
          "ja": "ど、どうかしたんですか？",
          "tc": "發、發生了什麼好事嗎？",
          "sc": "发、发生了什么好事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4654,
      "rec_id": "TALK_ID_10_0401_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267224,
          "spk": "今野 (コンノ)",
          "ja": "アナタたち野蛮人は、お湯を",
          "tc": "我想你們這些野蠻人，",
          "sc": "我想你们这些野蛮人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267231,
          "spk": "今野 (コンノ)",
          "ja": "ただ沸かせばいいって思ってるでしょうが",
          "tc": "大概會覺得熱水只要煮開就好了吧？",
          "sc": "大概会觉得热水只要煮开就好了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267238,
          "spk": "今野 (コンノ)",
          "ja": "違いますよォ",
          "tc": "這可是大錯特錯～！",
          "sc": "这可是大错特错～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4655,
      "rec_id": "TALK_ID_10_0401_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267256,
          "spk": "今野 (コンノ)",
          "ja": "茶葉には“適温”ってものがあるんです",
          "tc": "茶葉有所謂「最佳溫度」，",
          "sc": "茶叶有所谓“最佳温度”，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267263,
          "spk": "今野 (コンノ)",
          "ja": "この温度計でちゃんと測って……",
          "tc": "要用這支溫度計好好測量……",
          "sc": "要用这支温度计好好测量……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267270,
          "spk": "今野 (コンノ)",
          "ja": "あ、コレはイギリスの紅茶協会推奨のやつです",
          "tc": "啊，這支溫度計可是英國紅茶協會推薦的喔！",
          "sc": "啊，这支温度计可是英国红茶协会推荐的哟～！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267283,
          "spk": "驹子 (コマコ)",
          "ja": "へ、へええ……すごい便利なんですね……",
          "tc": "耶、耶嘿嘿……還真是方便呢……",
          "sc": "诶、嘿嘿……还真是方便呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4656,
      "rec_id": "TALK_ID_10_0401_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267301,
          "spk": "今野 (コンノ)",
          "ja": "誤差±0.5度ですよォ",
          "tc": "只容許±0.5度以內的誤差喔～",
          "sc": "只容许±0.5度以内的误差哟～～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267308,
          "spk": "今野 (コンノ)",
          "ja": "沸騰させすぎは、茶葉に失礼なんでネ",
          "tc": "要是水太滾的話，對茶葉就太失禮了。",
          "sc": "要是水太滚的话，对茶叶就太失礼了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4657,
      "rec_id": "TALK_ID_10_0401_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267341,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……私がコンノさんの話を",
          "tc": "<player>……我負責聽今野先生講話，",
          "sc": "<player>……我负责听今野先生讲话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267348,
          "spk": "驹子 (コマコ)",
          "ja": "聞いているから、その隙に……",
          "tc": "你就趁這個空檔……",
          "sc": "你就趁这个空档……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4658,
      "rec_id": "TALK_ID_10_0401_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267364,
          "spk": "驹子 (コマコ)",
          "ja": "多分、あそこに置いてある鍵……",
          "tc": "應該就是放在那裡的那把鑰匙……",
          "sc": "应该就是放在那里的那把钥匙……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267371,
          "spk": "驹子 (コマコ)",
          "ja": "<strong>あの鍵を、ゆっくり歩いて",
          "tc": "<strong>可以麻煩你慢慢地",
          "sc": "<strong>可以麻烦你慢慢地"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267378,
          "spk": "驹子 (コマコ)",
          "ja": "取ってきてくれるかな……？</strong>",
          "tc": "走過去拿那把鑰匙嗎……？</strong>",
          "sc": "走过去拿那把钥匙吗……？</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4659,
      "rec_id": "TALK_ID_10_0401_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267396,
          "spk": "驹子 (コマコ)",
          "ja": "お願い、<player>……",
          "tc": "麻煩你了，<player>……",
          "sc": "麻烦你了，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267403,
          "spk": "驹子 (コマコ)",
          "ja": "コンノさんが背を向けている時を見計らって、",
          "tc": "你可以看準今野先生背對你的時候，",
          "sc": "你可以看准今野先生背对你的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267410,
          "spk": "驹子 (コマコ)",
          "ja": "気づかれないように、慎重にね……",
          "tc": "要小心地，別被發現了……",
          "sc": "要小心地，别被发现了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4660,
      "rec_id": "TALK_ID_10_0401_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267434,
          "spk": "今野 (コンノ)",
          "ja": "焦らないのが重要ですよォ",
          "tc": "重點是急不得～",
          "sc": "重点是急不得～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267441,
          "spk": "今野 (コンノ)",
          "ja": "紅茶は「待てる人の飲み物」なのですから！",
          "tc": "因為紅茶是屬於「懂得等待的人」的啊！",
          "sc": "因为红茶是属于“懂得等待的人”的啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4661,
      "rec_id": "TALK_ID_10_0401_011_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267470,
          "spk": "今野 (コンノ)",
          "ja": "ケトルの音ってたまらないですよねェ",
          "tc": "水壺燒開的聲音真讓人心癢難耐啊～",
          "sc": "水壶烧开的声音真让人心痒难耐啊～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267477,
          "spk": "今野 (コンノ)",
          "ja": "まるで“これから至福の時間が来る”って",
          "tc": "簡直就像在預告──",
          "sc": "简直就像在预告——"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267484,
          "spk": "今野 (コンノ)",
          "ja": "知らせてくれてるみたい",
          "tc": "「即將要迎接至高無上的時光了」呢。",
          "sc": "“即将要迎接至高无上的时光了”呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4662,
      "rec_id": "TALK_ID_10_0401_011_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267504,
          "spk": "今野 (コンノ)",
          "ja": "お湯は、ただ沸けばいいってものじゃないんです",
          "tc": "而且熱水也不是只要煮沸就行了。",
          "sc": "而且热水也不是只要煮沸就行了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267511,
          "spk": "今野 (コンノ)",
          "ja": "90度、ほんの少し手前、それがベスト",
          "tc": "比90度再略低一點點，才是最理想的溫度。",
          "sc": "比90度再略低一点点，才是最理想的温度。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4663,
      "rec_id": "TALK_ID_10_0401_011_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267538,
          "spk": "今野 (コンノ)",
          "ja": "ほら、ほら……ポコポコっていう音",
          "tc": "您聽、您聽……那咕嚕咕嚕的沸騰聲。",
          "sc": "您听、您听……那咕噜咕噜的沸腾声。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4664,
      "rec_id": "TALK_ID_10_0401_011_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267558,
          "spk": "今野 (コンノ)",
          "ja": "これが「あと少しで適温」って合図です",
          "tc": "這就是暗示「已經快到最佳溫度」的訊號。",
          "sc": "这就是暗示“已经快到最佳温度”的信号。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267565,
          "spk": "今野 (コンノ)",
          "ja": "かわいいですねェ",
          "tc": "好可愛對不對～",
          "sc": "好可爱对不对～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4665,
      "rec_id": "TALK_ID_10_0401_011_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267592,
          "spk": "今野 (コンノ)",
          "ja": "電気ポットなどというあれは「温める」機械で、",
          "tc": "熱水壺那種東西不過是「加熱用」的機器，",
          "sc": "热水壶那种东西不过是“加热用”的机器，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267599,
          "spk": "今野 (コンノ)",
          "ja": "「湯を育てる」道具ではないのですよォ",
          "tc": "才不配當「孕育熱水」的道具呢～",
          "sc": "才不配当“孕育热水”的道具呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4666,
      "rec_id": "TALK_ID_10_0401_011_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267626,
          "spk": "今野 (コンノ)",
          "ja": "アア……この瞬間、",
          "tc": "啊啊……這個瞬間，",
          "sc": "啊啊……这个瞬间，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267633,
          "spk": "今野 (コンノ)",
          "ja": "たまりませんねェ",
          "tc": "真是令人陶醉啊……",
          "sc": "真是令人陶醉啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4667,
      "rec_id": "TALK_ID_10_0401_011_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267653,
          "spk": "今野 (コンノ)",
          "ja": "湯が沸くのを待ちながら、",
          "tc": "一邊等著熱水煮沸，",
          "sc": "一边等着热水煮沸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267660,
          "spk": "今野 (コンノ)",
          "ja": "今日の香りを想像する",
          "tc": "一邊想像今天的香氣，",
          "sc": "一边想像今天的香气，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267667,
          "spk": "今野 (コンノ)",
          "ja": "まさに至福の時間……",
          "tc": "簡直就是至高無上的時光……",
          "sc": "简直就是至高无上的时光……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4668,
      "rec_id": "TALK_ID_10_0401_011_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267689,
          "spk": "今野 (コンノ)",
          "ja": "ちょっと、ワタシの話を聞いてるんですかァ！",
          "tc": "喂喂，您有沒有在聽我說話啊～！",
          "sc": "喂喂，您有没有在听我说话啊～！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267696,
          "spk": "今野 (コンノ)",
          "ja": "せっかく部屋に入れて、その上",
          "tc": "我可是難得讓您進來我的房間，",
          "sc": "我可是难得让您进来我的房间，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267703,
          "spk": "今野 (コンノ)",
          "ja": "香りまで楽しませてやってるのに",
          "tc": "甚至還允許您享受茶香。",
          "sc": "甚至还允许您享受茶香。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267712,
          "spk": "今野 (コンノ)",
          "ja": "礼儀がなってない人ですねェ！",
          "tc": "怎麼這麼沒禮貌呢～！",
          "sc": "怎么这么没礼貌呢～！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267719,
          "spk": "今野 (コンノ)",
          "ja": "じっとしてなさい！",
          "tc": "還不給我乖乖待著！",
          "sc": "还不给我乖乖待着！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4669,
      "rec_id": "TALK_ID_10_0401_011_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267745,
          "spk": "今野 (コンノ)",
          "ja": "お湯の音を聞いてると、",
          "tc": "聽著煮熱水的聲音，",
          "sc": "听着煮热水的声音，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267752,
          "spk": "今野 (コンノ)",
          "ja": "まるで儀式の準備みたいですねェ",
          "tc": "就好像在準備什麼儀式一樣呢～",
          "sc": "就好像在准备什么仪式一样呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4670,
      "rec_id": "TALK_ID_10_0401_011_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267777,
          "spk": "驹子 (コマコ)",
          "ja": "あの……！",
          "tc": "那個……！",
          "sc": "那个……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267784,
          "spk": "驹子 (コマコ)",
          "ja": "コンノさん！",
          "tc": "今野先生！",
          "sc": "今野先生！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267799,
          "spk": "今野 (コンノ)",
          "ja": "チッ……帰らせるべきだったな",
          "tc": "嘖……真該讓您回去的才對。",
          "sc": "啧……真该让您回去的才对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4671,
      "rec_id": "TALK_ID_10_0401_011_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267824,
          "spk": "今野 (コンノ)",
          "ja": "……なんです？",
