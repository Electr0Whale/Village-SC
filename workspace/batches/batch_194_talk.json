  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4495,
      "rec_id": "TALK_ID_10_0303_058_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261077,
          "spk": "林 (リン)",
          "ja": "あら、聞いていないの？",
          "tc": "哎呀，你沒聽說嗎？",
          "sc": "哎呀，你没听说吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261084,
          "spk": "林 (リン)",
          "ja": "コマコは今朝、山で倒れているところを",
          "tc": "今天早上發現",
          "sc": "今天早上发现"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261091,
          "spk": "林 (リン)",
          "ja": "見つかったのよ",
          "tc": "駒子暈倒在山裡。",
          "sc": "驹子晕倒在山里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4496,
      "rec_id": "TALK_ID_10_0303_058_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261109,
          "spk": "驹子 (コマコ)",
          "ja": "倒れているなんて、そんな大したものじゃないよ",
          "tc": "說什麼暈倒，沒有那麼誇張啦。",
          "sc": "说什么晕倒，没有那么夸张啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261116,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんのお財布を探してたら、",
          "tc": "我只是在找名護先生的錢包，",
          "sc": "我只是在找名护先生的钱包，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261123,
          "spk": "驹子 (コマコ)",
          "ja": "いつの間にかに眠っちゃっていただけだから……",
          "tc": "找著找著就睡著了而已……",
          "sc": "找着找着就睡着了而已……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4497,
      "rec_id": "TALK_ID_10_0303_058_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261141,
          "spk": "林 (リン)",
          "ja": "全く……本当に肝が冷えるわ",
          "tc": "受不了……真是嚇死我了。",
          "sc": "受不了……真是吓死我了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261148,
          "spk": "林 (リン)",
          "ja": "勘弁してちょうだい……",
          "tc": "拜託妳別再這樣了……",
          "sc": "拜托你别再这样了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4498,
      "rec_id": "TALK_ID_10_0303_058_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261166,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんね、心配かけて",
          "tc": "抱歉讓妳擔心了。",
          "sc": "抱歉让你担心了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261179,
          "spk": "林 (リン)",
          "ja": "まあ、いいわ……それより",
          "tc": "算了，沒關係……不過更重要的是，",
          "sc": "算了，没关系……不过更重要的是，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4499,
      "rec_id": "TALK_ID_10_0303_058_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261197,
          "spk": "林 (リン)",
          "ja": "残念よ、あなたまで",
          "tc": "我太失望了，",
          "sc": "我太失望了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261204,
          "spk": "林 (リン)",
          "ja": "掟を破っているだなんて……",
          "tc": "居然連妳都打破了規矩……",
          "sc": "居然连你都打破了规矩……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261217,
          "spk": "驹子 (コマコ)",
          "ja": "ご、ごめんなさい……",
          "tc": "對、對不起……",
          "sc": "对、对不起……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261224,
          "spk": "驹子 (コマコ)",
          "ja": "もう、二度と掟を破らないから……",
          "tc": "我不會再打破規矩了……",
          "sc": "我不会再打破规矩了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261237,
          "spk": "林 (リン)",
          "ja": "それにさっき、",
          "tc": "還有，妳剛剛有提到桃樹，",
          "sc": "还有，你刚刚有提到桃树，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261244,
          "spk": "林 (リン)",
          "ja": "あなたは桃の樹って言ったわね……？",
          "tc": "對吧……？",
          "sc": "对吧……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 261255,
          "spk": "林 (リン)",
          "ja": "その樹は、どこに生えているの？",
          "tc": "那棵樹長在哪裡？",
          "sc": "那棵树长在哪里？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 261262,
          "spk": "林 (リン)",
          "ja": "そこで一体、何をしていたの？",
          "tc": "妳在那裡做了什麼？",
          "sc": "你在那里做了什么？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 261275,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……樹ってあ、あの……",
          "tc": "咦……樹是，那、那個……",
          "sc": "咦……树是，那、那个……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4500,
      "rec_id": "TALK_ID_10_0303_058_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261293,
          "spk": "驹子 (コマコ)",
          "ja": "その、それは……",
          "tc": "那個、就是……",
          "sc": "那个、就是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261300,
          "spk": "驹子 (コマコ)",
          "ja": "樹のことは秘密だって、",
          "tc": "我和帷約好了，",
          "sc": "我和帷约好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261307,
          "spk": "驹子 (コマコ)",
          "ja": "トバリと約束してて……",
          "tc": "樹的事情要保密……",
          "sc": "树的事情要保密……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4501,
      "rec_id": "TALK_ID_10_0303_058_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261325,
          "spk": "林 (リン)",
          "ja": "言い訳するの？　偉くなったわね！",
          "tc": "還找藉口？膽子大了起來呀！",
          "sc": "还找借口？胆子大了起来呀！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261332,
          "spk": "林 (リン)",
          "ja": "それともまた掟を破るつもり！？",
          "tc": "還是說，妳打算再次打破規矩！？",
          "sc": "还是说，你打算再次打破规矩！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261339,
          "spk": "林 (リン)",
          "ja": "言いなさい！",
          "tc": "快說！",
          "sc": "快说！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261350,
          "spk": "驹子 (コマコ)",
          "ja": "う……桃の樹が生えている所で、",
          "tc": "嗚……我在桃樹生長的地方，",
          "sc": "呜……我在桃树生长的地方，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261357,
          "spk": "驹子 (コマコ)",
          "ja": "ナゴさんのお財布を探していて……",
          "tc": "找名護先生的錢包……",
          "sc": "找名护先生的钱包……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4502,
      "rec_id": "TALK_ID_10_0303_058_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261375,
          "spk": "林 (リン)",
          "ja": "……やっぱり、また生えていたのね",
          "tc": "……果然又長出來了。",
          "sc": "……果然又长出来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261386,
          "spk": "林 (リン)",
          "ja": "コマコ、掟を破ったらどうなるか……",
          "tc": "駒子，我以為妳很清楚",
          "sc": "驹子，我以为你很清楚"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261393,
          "spk": "林 (リン)",
          "ja": "あなたは、わかっていると思っていたのだけれど",
          "tc": "打破規矩會有什麼後果。",
          "sc": "打破规矩会有什么后果。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4503,
      "rec_id": "TALK_ID_10_0303_058_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261411,
          "spk": "林 (リン)",
          "ja": "それより今は、その樹のありかを知りたい",
          "tc": "先不說這個，我想知道那棵樹在哪裡。",
          "sc": "先不说这个，我想知道那棵树在哪里。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261418,
          "spk": "林 (リン)",
          "ja": "病み上がりのところ悪いけど、",
          "tc": "雖然妳才剛恢復，",
          "sc": "虽然你才刚恢复，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261425,
          "spk": "林 (リン)",
          "ja": "私の家で、詳しく聞かせてくれるかしら",
          "tc": "不過可以來我家，把詳情告訴我嗎？",
          "sc": "不过可以来我家，把详情告诉我吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4504,
      "rec_id": "TALK_ID_10_0303_058_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261443,
          "spk": "驹子 (コマコ)",
          "ja": "あ、あの！",
          "tc": "那、那個！",
          "sc": "那、那个！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261450,
          "spk": "驹子 (コマコ)",
          "ja": "この、探していた財布を<player>に……",
          "tc": "我要把找到的這個錢包交給<player>……",
          "sc": "我要把找到的这个钱包交给<player>……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261463,
          "spk": "林 (リン)",
          "ja": "なるほど、じゃあそれは私が預かるわ",
          "tc": "原來如此，那就先由我保管吧。",
          "sc": "原来如此，那就先由我保管吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4505,
      "rec_id": "TALK_ID_10_0303_058_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261483,
          "spk": "林 (リン)",
          "ja": "安心しなさい",
          "tc": "放心吧，",
          "sc": "放心吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261490,
          "spk": "林 (リン)",
          "ja": "取ったりはしない、返すわよ",
          "tc": "我不會據為己有，之後會還給你的。",
          "sc": "我不会据为己有，之后会还给你的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261508,
          "spk": "林 (リン)",
          "ja": "でも、その前に",
          "tc": "但在那之前，",
          "sc": "但在那之前，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261515,
          "spk": "林 (リン)",
          "ja": "あなたには罰を受けてもらわないとね",
          "tc": "你得先接受處罰才行。",
          "sc": "你得先接受处罚才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4506,
      "rec_id": "TALK_ID_10_0303_059_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261541,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261548,
          "spk": "林 (リン)",
          "ja": "あなたへの良い罰を思いついたの",
          "tc": "我想到很適合你的處罰了。",
          "sc": "我想到很适合你的处罚了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4507,
      "rec_id": "TALK_ID_10_0303_059_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261566,
          "spk": "林 (リン)",
          "ja": "いや……",
          "tc": "不……",
          "sc": "不……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261573,
          "spk": "林 (リン)",
          "ja": "これは罰って言うよりお願いね",
          "tc": "與其說是處罰，更該說是請託吧。",
          "sc": "与其说是处罚，更该说是请托吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4508,
      "rec_id": "TALK_ID_10_0303_059_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261591,
          "spk": "林 (リン)",
          "ja": "掟を破るのが得意なあなたに、",
          "tc": "我有一件事想拜託",
          "sc": "我有一件事想拜托"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261598,
          "spk": "林 (リン)",
          "ja": "頼みたいことがあるのよ",
          "tc": "擅長打破規矩的你。",
          "sc": "擅长打破规矩的你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261609,
          "spk": "林 (リン)",
          "ja": "深夜になったら、",
          "tc": "等到深夜，",
          "sc": "等到深夜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261616,
          "spk": "林 (リン)",
          "ja": "例の桃の樹まで来て欲しいの",
          "tc": "你到那棵桃樹那裡來找我吧。",
          "sc": "你到那棵桃树那里来找我吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261627,
          "spk": "林 (リン)",
          "ja": "その時に、あなたが探していた",
          "tc": "到時候我會把你正在找的",
          "sc": "到时候我会把你正在找的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 261634,
          "spk": "林 (リン)",
          "ja": "ナゴの財布を返してあげるわ",
          "tc": "名護的錢包還給你。",
          "sc": "名护的钱包还给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4509,
      "rec_id": "TALK_ID_10_0303_059_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261658,
          "spk": "林 (リン)",
          "ja": "いいわね？　ちゃんと来るのよ",
          "tc": "知道了嗎？一定要過來。",
          "sc": "知道了吗？一定要过来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4510,
      "rec_id": "TALK_ID_10_0303_060_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261684,
          "spk": "林 (リン)",
          "ja": "<player>、よく来てくれたわね",
          "tc": "<player>，你來了啊。",
          "sc": "<player>，你来了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4511,
      "rec_id": "TALK_ID_10_0303_060_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261702,
          "spk": "林 (リン)",
          "ja": "こんな隠れた場所に、",
          "tc": "真沒想到這棵樹",
          "sc": "真没想到这棵树"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261709,
          "spk": "林 (リン)",
          "ja": "この樹が生えていたなんてね",
          "tc": "竟然長在這麼隱密的地方。",
          "sc": "竟然长在这么隐密的地方。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4512,
      "rec_id": "TALK_ID_10_0303_060_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261725,
          "spk": "驹子 (コマコ)",
          "ja": "……<player>まで呼んで",
          "tc": "……連<player>都叫來，",
          "sc": "……连<player>都叫来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261732,
          "spk": "驹子 (コマコ)",
          "ja": "一体、何をするの……",
          "tc": "到底要做什麼……",
          "sc": "到底要做什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4513,
      "rec_id": "TALK_ID_10_0303_060_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261750,
          "spk": "林 (リン)",
          "ja": "<player>、ここに呼んだのはね、",
          "tc": "<player>，我把你叫來這裡，",
          "sc": "<player>，我把你叫来这里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261757,
          "spk": "林 (リン)",
          "ja": "あなたにこの樹を切り倒してもらいたいの",
          "tc": "是要拜託你把這棵樹砍掉。",
          "sc": "是要拜托你把这棵树砍掉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4514,
      "rec_id": "TALK_ID_10_0303_060_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261775,
          "spk": "驹子 (コマコ)",
          "ja": "……だ、だめだよ",
          "tc": "……不、不可以啦，",
          "sc": "……不、不可以啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261782,
          "spk": "驹子 (コマコ)",
          "ja": "やめてあげてよ",
          "tc": "別這樣……",
          "sc": "别这样……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261791,
          "spk": "驹子 (コマコ)",
          "ja": "コダマ、お墓が側にあるって",
          "tc": "木珠因為墳墓在旁邊，",
          "sc": "木珠因为坟墓在旁边，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261798,
          "spk": "驹子 (コマコ)",
          "ja": "喜んでいたんだから……",
          "tc": "很開心的說……",
          "sc": "很开心的说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4515,
      "rec_id": "TALK_ID_10_0303_060_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261816,
          "spk": "林 (リン)",
