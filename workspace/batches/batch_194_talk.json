    {
      "file": "talk.dat",
      "rec_idx": 4672,
      "rec_id": "TALK_ID_10_0401_011_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267913,
          "spk": "今野 (コンノ)",
