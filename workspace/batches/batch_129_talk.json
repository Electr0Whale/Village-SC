      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133367,
          "spk": "今野 (コンノ)",
          "ja": "板張りが冷えてきましたネ",
          "tc": "地板變冷了呢。",
          "sc": "地板变冷了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133378,
          "spk": "今野 (コンノ)",
          "ja": "夜は足元から来るんですヨ",
          "tc": "晚上會從腳底開始冷啊。",
          "sc": "晚上会从脚底开始冷哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1702,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133409,
          "spk": "今野 (コンノ)",
          "ja": "……何かの気配がすると",
          "tc": "……我想說好像有什麼東西在，",
          "sc": "……我想说好像有什么东西在，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133416,
          "spk": "今野 (コンノ)",
          "ja": "思ったらアナタでしたかァ",
          "tc": "結果原來是您啊。",
          "sc": "结果原来是您呀～？。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133427,
          "spk": "今野 (コンノ)",
          "ja": "警戒し損でしたネ",
          "tc": "害我白警惕了。",
          "sc": "害我白警惕了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1703,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133451,
          "spk": "今野 (コンノ)",
          "ja": "この、ふくよかな香り……",
          "tc": "這馥郁的香氣……",
          "sc": "这馥郁的香气……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133462,
          "spk": "今野 (コンノ)",
          "ja": "ン～……たまりませんねェ……",
          "tc": "嗯……真是令人陶醉啊……",
          "sc": "嗯……真是令人陶醉啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
