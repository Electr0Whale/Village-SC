      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133535,
          "spk": "今野 (コンノ)",
          "ja": "オォ……これが５万円の煎茶",
          "tc": "哦……這就是要價5萬元的煎茶，",
          "sc": "哦……这就是要价5万元的煎茶，"
