  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1690,
      "rec_id": "TALK_ID_SECRETARY_THUNDERSTORM_20_108_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 132828,
          "spk": "今野 (コンノ)",
          "ja": "……おや、<player>さん",
          "tc": "哎呀，是<player>啊。",
          "sc": "哎呀，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 132839,
          "spk": "今野 (コンノ)",
          "ja": "遊びに来てくださるのは結構ですが",
          "tc": "您要來玩是無妨，",
          "sc": "您要来玩是无妨，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 132846,
          "spk": "今野 (コンノ)",
          "ja": "少しは天気を考えたらどうですかァ？",
          "tc": "但您也稍微考量一下天氣吧？",
          "sc": "但您也稍微考量一下天气吧～？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 132864,
          "spk": "今野 (コンノ)",
          "ja": "どうせここに来るまでの廊下に",
          "tc": "您這一路經過的走廊，",
          "sc": "您这一路经过的走廊，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 132871,
          "spk": "今野 (コンノ)",
          "ja": "濡れた足跡を残してきたんでしょう？",
          "tc": "一定都留下您濕答答的腳印了吧？",
          "sc": "一定都留下您湿答答的脚印了吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 132878,
          "spk": "今野 (コンノ)",
          "ja": "ちゃんと拭いておいてくださいネ",
          "tc": "請您要把腳印擦乾淨喔。",
          "sc": "请您把脚印擦干净呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1691,
      "rec_id": "TALK_ID_SECRETARY_THUNDERSTORM_20_108_0301",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 132902,
          "spk": "今野 (コンノ)",
          "ja": "この雷雨の中を",
          "tc": "在這種雷雨之中，",
          "sc": "在这种雷雨之中，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 132909,
          "spk": "今野 (コンノ)",
          "ja": "よくいらっしゃいましたねェ",
          "tc": "還真是辛苦您來這一趟了，",
          "sc": "还真是辛苦您来这一趟了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 132916,
          "spk": "今野 (コンノ)",
          "ja": "歓迎しますヨ",
          "tc": "歡迎您。",
          "sc": "欢迎您哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 132927,
          "spk": "今野 (コンノ)",
          "ja": "あ、でも部屋の中では座らないでくださいネ",
          "tc": "啊，但請您不要在房間裡坐下喔。",
          "sc": "啊，不过请您不要在房间里坐下呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 132945,
          "spk": "今野 (コンノ)",
          "ja": "衣類や布類にも触れないでください",
          "tc": "也請您不要碰到衣服或布製品，",
          "sc": "也请您不要碰到衣服或布制品，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 132952,
          "spk": "今野 (コンノ)",
          "ja": "湿ってしまうのは困りますからねェ",
          "tc": "要是被您沾濕的話我會很困擾的。",
          "sc": "要是被您沾湿的话我会很困扰呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1692,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 132976,
          "spk": "今野 (コンノ)",
          "ja": "ンフフ、やっぱり上がりましたかァ",
          "tc": "哼哼哼，果然漲了吧。",
          "sc": "哼哼哼，果然涨呀～？。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 132987,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの予想って当たるんですよネ",
          "tc": "我的預測總是會中啊。",
          "sc": "我的预测总是会中啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1693,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133011,
          "spk": "今野 (コンノ)",
          "ja": "これは買いですヨ",
          "tc": "我要買這股。",
          "sc": "我要买这股哟～。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133022,
          "spk": "今野 (コンノ)",
          "ja": "絶対に伸びると",
          "tc": "我敢斷定",
          "sc": "我敢断定"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133029,
          "spk": "今野 (コンノ)",
          "ja": "断言できますからネ",
          "tc": "它一定會成長。",
          "sc": "它一定会成长。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1694,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133053,
          "spk": "今野 (コンノ)",
          "ja": "ンッフフフ……",
          "tc": "呵呵呵呵……",
          "sc": "呵呵呵呵……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133064,
          "spk": "今野 (コンノ)",
          "ja": "ここまで跳ねるとはネ",
          "tc": "沒想到竟然會漲到這個地步。",
          "sc": "没想到竟然会涨到这个地步。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133071,
          "spk": "今野 (コンノ)",
          "ja": "ンフフ、ボロ儲けです",
          "tc": "呵呵呵，賺翻了。",
          "sc": "呵呵呵，赚翻了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1695,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133102,
          "spk": "今野 (コンノ)",
          "ja": "花も葉も、芽吹いた時は美しいのに",
          "tc": "花草樹木在開花發芽時很美麗，",
          "sc": "花草树木在开花发芽时很美丽，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133109,
          "spk": "今野 (コンノ)",
          "ja": "散った途端に掃き清められるんですから",
          "tc": "但是一凋零就會被掃到一旁，",
          "sc": "但是一凋零就会被扫到一旁，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133116,
          "spk": "今野 (コンノ)",
          "ja": "物悲しいですよねェ",
          "tc": "真是令人不勝唏噓。",
          "sc": "真是令人不胜唏嘘呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1696,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133140,
          "spk": "今野 (コンノ)",
          "ja": "くっ……濡れてへばりついた花弁が",
          "tc": "唔……濕掉黏在一起的花瓣",
          "sc": "唔……湿掉黏在一起的花瓣"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133147,
          "spk": "今野 (コンノ)",
          "ja": "なかなか取れませんネ……",
          "tc": "好難掃啊……",
          "sc": "好难扫啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133158,
          "spk": "今野 (コンノ)",
          "ja": "これだから雨は嫌なんですよォ",
          "tc": "就是這樣我才討厭下雨天。",
          "sc": "就是这样我才讨厌下雨天哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1697,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133189,
          "spk": "今野 (コンノ)",
          "ja": "村長宅の敷地内ですからネ",
          "tc": "這裡可是村長家，",
          "sc": "这里可是村长家，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133196,
          "spk": "今野 (コンノ)",
          "ja": "彼ヶ津村のどこよりも",
          "tc": "一定要打掃得比彼津村",
          "sc": "一定要打扫得比彼津村"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133203,
          "spk": "今野 (コンノ)",
          "ja": "ピカピカにしませんとォ",
          "tc": "任何地方都亮晶晶的才行。",
          "sc": "任何地方都亮晶晶的才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1698,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133227,
          "spk": "今野 (コンノ)",
          "ja": "心に余裕がある者というのは",
          "tc": "心胸寬大的人，",
          "sc": "心胸宽大的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133234,
          "spk": "今野 (コンノ)",
          "ja": "面倒な掃除すらも楽しめるんです",
          "tc": "在做麻煩的掃除時也都能樂在其中。",
          "sc": "在做麻烦的扫除时也都能乐在其中。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 133252,
          "spk": "今野 (コンノ)",
          "ja": "覚えておいてくださいネ",
          "tc": "您要好好記得這點喔。",
          "sc": "您可要好好记牢呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1699,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133276,
          "spk": "今野 (コンノ)",
          "ja": "フフン、今日も我ながらいい出来ですネ",
          "tc": "呵呵，我今天做得也很不錯嘛。",
          "sc": "呵呵，我今天做得也很不错嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133294,
          "spk": "今野 (コンノ)",
          "ja": "季節ならではの食材をふんだんに",
          "tc": "不枉我毫不手軟使用了大量的當季食材，",
          "sc": "不枉我毫不手软使用了大量的当季食材，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 133301,
          "spk": "今野 (コンノ)",
          "ja": "使った甲斐あって、贅沢な味です",
          "tc": "真是奢侈的滋味。",
          "sc": "真是奢侈的滋味。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1700,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133325,
          "spk": "今野 (コンノ)",
          "ja": "今夜は静かですねェ",
          "tc": "今晚真是安靜啊，",
          "sc": "今晚真是安静啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133336,
          "spk": "今野 (コンノ)",
          "ja": "……誰もが安心して眠れる夜は",
          "tc": "……人人都能一夜好眠的夜晚，",
          "sc": "……人人都能一夜好眠的夜晚，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133343,
          "spk": "今野 (コンノ)",
          "ja": "案外、貴重なものなんですヨ",
          "tc": "其實是很珍貴的喔。",
          "sc": "其实是很珍贵哟～。"
        }
      ]
    },
    {
