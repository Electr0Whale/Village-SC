      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133486,
          "spk": "今野 (コンノ)",
          "ja": "チナナさん、いい輸入ルートを",
          "tc": "不知道琪娜娜小姐是不是找到了",
          "sc": "不知道琪娜娜小姐是不是找到了"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133493,
          "spk": "今野 (コンノ)",
          "ja": "見つけたんですかねェ",
          "tc": "不錯的進貨管道。",
          "sc": "不错的进货管道呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133504,
          "spk": "今野 (コンノ)",
          "ja": "これ、今までとはひと味違いますヨ",
          "tc": "這和以前的味道大不相同啊。",
          "sc": "这和以前的味道大不相同哟～。"
        }
      ]
    },
    {
