        {
          "f_idx": 1,
          "pidx_tc": 133542,
          "spk": "今野 (コンノ)",
          "ja": "なんとも贅沢な一口ですねェ",
          "tc": "真是奢侈的一口茶啊。",
          "sc": "真是奢侈的一口茶呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133553,
          "spk": "今野 (コンノ)",
          "ja": "ンフフ……",
          "tc": "呵呵呵……",
          "sc": "呵呵呵……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1706,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133577,
          "spk": "今野 (コンノ)",
          "ja": "どうにもやる気が出ませんネ",
          "tc": "總覺得整個人懶懶散散的。",
          "sc": "总觉得整个人懒懒散散的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133595,
          "spk": "今野 (コンノ)",
          "ja": "それもこれも雨だからですヨ",
          "tc": "這一切都得怪下雨天。",
          "sc": "这一切都得怪下雨天哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1707,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133619,
          "spk": "今野 (コンノ)",
          "ja": "誰かワタシに代わって掃除してほしいんですが",
          "tc": "雖然很希望能有個人代替我去打掃，",
          "sc": "虽然很希望能有个人代替我去打扫，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133626,
          "spk": "今野 (コンノ)",
          "ja": "どうせアナタじゃ雑にやって終わりでしょう？",
          "tc": "但是您打掃一定很隨便的吧？",
          "sc": "但是您打扫一定很随便的吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 133644,
          "spk": "今野 (コンノ)",
          "ja": "先に言っておきますが結構ですヨ",
          "tc": "我先聲明，不用麻煩了。",
          "sc": "我先声明，不用麻烦哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1708,
      "rec_id": "TALK_ID_SECRETARY_ROUTINE_20_108_1112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 133675,
          "spk": "今野 (コンノ)",
          "ja": "これだけ降ってると、どこかで誰かが",
          "tc": "下雨下成這樣，",
          "sc": "下雨下成这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 133682,
          "spk": "今野 (コンノ)",
          "ja": "雨ごいの儀式でもしたんじゃないかって",
          "tc": "我都懷疑是不是有人在哪裡",
          "sc": "我都怀疑是不是有人在哪里"
        },
        {
          "f_idx": 2,
          "pidx_tc": 133689,
          "spk": "今野 (コンノ)",
