      "rec_id": "TALK_ID_HUNTER_BIRTHDAY_20_105_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45223,
          "spk": "驹子 (コマコ)",
          "ja": "木彫りの魚だよ",
          "tc": "是用木頭雕的魚喔。",
          "sc": "是用木头雕的鱼哦。"
        },
        {
          "f_idx": 1,
