          "spk": "驹子 (コマコ)",
          "ja": "だから、キミには誰よりも",
          "tc": "所以，",
          "sc": "所以，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 45298,
          "spk": "驹子 (コマコ)",
          "ja": "安全でいてほしいし、",
          "tc": "我比誰都希望你能平平安安，",
          "sc": "我比谁都希望你能平平安安，"
