      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45124,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45131,
          "spk": "驹子 (コマコ)",
          "ja": "あの……今日はキミの誕生日、だよね？",
          "tc": "那個……今天是你的生日對吧？",
          "sc": "那个……今天是你的生日对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45142,
          "spk": "驹子 (コマコ)",
          "ja": "誕生日、おめでとう……！",
          "tc": "祝你生日快樂……！",
          "sc": "祝你生日快乐……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45149,
          "spk": "驹子 (コマコ)",
          "ja": "いつも助けてもらってばかりだから、",
          "tc": "因為平常總是受你照顧，",
          "sc": "因为平常总是受你照顾，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45156,
          "spk": "驹子 (コマコ)",
          "ja": "今日はお祝いしたくて……",
          "tc": "所以今天想幫你慶祝一下……",
          "sc": "所以今天想帮你庆祝一下……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45167,
          "spk": "驹子 (コマコ)",
          "ja": "たいしたものは用意できなかったんだけど",
          "tc": "雖然沒能準備什麼了不起的東西，",
          "sc": "虽然没能准备什么了不起的东西，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 45174,
          "spk": "驹子 (コマコ)",
          "ja": "でも、心をこめて作ったの",
          "tc": "但這是我用心製作的。",
          "sc": "但我用心制作的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 45185,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっと変な見た目かも",
          "tc": "雖然外觀看起來",
          "sc": "虽然外观看起来"
        },
        {
          "f_idx": 8,
          "pidx_tc": 45192,
          "spk": "驹子 (コマコ)",
          "ja": "しれないんだけど……",
          "tc": "可能有點奇怪……",
          "sc": "可能有点奇怪……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 45199,
          "spk": "驹子 (コマコ)",
          "ja": "受けとってくれる……？",
          "tc": "你願意收下嗎……？",
          "sc": "你愿意收下吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
