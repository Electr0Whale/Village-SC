          "spk": "莲实 (ハスミ)",
          "ja": "擦り傷ができたくらいです",
          "tc": "受到了一點擦傷而已。",
          "sc": "受到了一点擦伤而已。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 326660,
          "spk": "莲实 (ハスミ)",
          "ja": "少し、そっとしておきましょう",
          "tc": "就讓她好好休息一下吧。",
          "sc": "就让她好好休息一下吧。"
        },
