  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5499,
      "rec_id": "TALK_ID_10_0502_216_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 320749,
          "spk": "堇怜 (スミレ)",
          "ja": "どうしてチナナさんが",
          "tc": "琪娜娜姐……",
          "sc": "琪娜娜姐……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 320756,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮から……？",
          "tc": "怎麼會從鵺皮下出現……？",
          "sc": "怎么会从鵺皮下出现……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 320765,
          "spk": "堇怜 (スミレ)",
          "ja": "いや、それよりどうして",
          "tc": "不對，比起這個，",
          "sc": "不对，比起这个，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 320772,
          "spk": "堇怜 (スミレ)",
          "ja": "正体を隠してたんだよ？",
          "tc": "為什麼妳要隱藏真實身分？",
          "sc": "为什么你要隐藏真实身分？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 320779,
          "spk": "堇怜 (スミレ)",
          "ja": "なんで……？",
          "tc": "為什麼……？",
          "sc": "为什么……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 320792,
          "spk": "名护 (ナゴ)",
          "ja": "そこは、俺もぜひとも",
          "tc": "關於這點，",
          "sc": "关于这点，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 320799,
          "spk": "名护 (ナゴ)",
          "ja": "知りたいところだな",
          "tc": "我也很想知道呢。",
          "sc": "我也很想知道呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 320812,
          "spk": "莲实 (ハスミ)",
          "ja": "それは……",
          "tc": "那是因為……",
          "sc": "那是因为……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 320825,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいよ、ハスミ",
          "tc": "沒關係，蓮實。",
          "sc": "没关系，莲实。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 320832,
          "spk": "琪娜娜 (チナナ)",
          "ja": "答えなくて",
          "tc": "不用回答。",
          "sc": "不用回答。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 320843,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ナゴさん、悪いけど",
          "tc": "名護先生，",
          "sc": "名护先生，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 320850,
          "spk": "琪娜娜 (チナナ)",
          "ja": "部外者は黙ってて",
          "tc": "不好意思，",
          "sc": "不好意思，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 320857,
          "spk": "琪娜娜 (チナナ)",
          "ja": "くれないかい？",
          "tc": "外人可以不要插嘴嗎？",
          "sc": "外人可以不要插嘴吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 320870,
          "spk": "名护 (ナゴ)",
          "ja": "確かに俺は",
          "tc": "沒錯，",
          "sc": "没错，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 320877,
          "spk": "名护 (ナゴ)",
          "ja": "部外者なんだろう",
          "tc": "我的確是外人。",
          "sc": "我的确是外人。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 320888,
          "spk": "名护 (ナゴ)",
          "ja": "だが、部外者の働きかけでもなければ、",
          "tc": "但如果沒有外人插手，",
          "sc": "但如果没有外人插手，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 320895,
          "spk": "名护 (ナゴ)",
          "ja": "キミたちは意地でも",
          "tc": "妳們應該再怎樣",
          "sc": "你们应该再怎样"
        },
        {
          "f_idx": 17,
          "pidx_tc": 320902,
          "spk": "名护 (ナゴ)",
          "ja": "何も話さないんじゃないのか",
          "tc": "也一個字都不會說吧？",
          "sc": "也一个字都不会说吧？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 320915,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うるさいな……",
          "tc": "真煩耶……",
          "sc": "真烦呢……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 320922,
          "spk": "琪娜娜 (チナナ)",
          "ja": "知った風な口を利かないでほしいね",
          "tc": "別說得一副好像什麼都懂的樣子。",
          "sc": "别说得一副好像什么都懂的样子。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 320935,
          "spk": "堇怜 (スミレ)",
          "ja": "チナナさん、姉さん",
          "tc": "琪娜娜姐、姊姊，",
          "sc": "琪娜娜姐、姐姐，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 320942,
          "spk": "堇怜 (スミレ)",
          "ja": "少なくとも僕は部外者じゃないよ",
          "tc": "至少我不是外人啊！",
          "sc": "至少我不是外人啊！"
        },
        {
          "f_idx": 22,
          "pidx_tc": 320955,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……！",
          "tc": "……！",
          "sc": "……！"
        },
        {
          "f_idx": 23,
          "pidx_tc": 320968,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が追い詰めたんだ",
          "tc": "是我把妳們逼到這一步的。",
          "sc": "是我把你们逼到这一步的。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 320975,
          "spk": "堇怜 (スミレ)",
          "ja": "いい加減負けを認めて、",
          "tc": "妳們差不多也該認輸，",
          "sc": "你们差不多也该认输，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 320982,
          "spk": "堇怜 (スミレ)",
          "ja": "全部教えてくれよ",
          "tc": "把一切都告訴我了吧？",
          "sc": "把一切都告诉我了吧？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 320995,
          "spk": "琪娜娜 (チナナ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 27,
          "pidx_tc": 321008,
          "spk": "莲实 (ハスミ)",
          "ja": "……チナナ",
          "tc": "……琪娜娜。",
          "sc": "……琪娜娜。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 321015,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、いいの",
          "tc": "沒關係，算了。",
          "sc": "没关系，算了。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 321028,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミ……？",
          "tc": "蓮實……？",
          "sc": "莲实……？"
        },
        {
          "f_idx": 30,
          "pidx_tc": 321041,
          "spk": "莲实 (ハスミ)",
          "ja": "きっと、もっと早く",
          "tc": "我想肯定……",
          "sc": "我想肯定……"
        },
        {
          "f_idx": 31,
          "pidx_tc": 321048,
          "spk": "莲实 (ハスミ)",
          "ja": "こうするべきだった",
          "tc": "更早就該這麼做了。",
          "sc": "更早就该这么做了。"
        },
        {
          "f_idx": 32,
          "pidx_tc": 321059,
          "spk": "莲实 (ハスミ)",
          "ja": "私たちの負けよ……",
          "tc": "是我們輸了……",
          "sc": "是我们输了……"
        },
        {
          "f_idx": 33,
          "pidx_tc": 321066,
          "spk": "莲实 (ハスミ)",
          "ja": "全て、私のワガママのせいで……",
          "tc": "一切都是我的任性害的……",
          "sc": "一切都是我的任性害的……"
        },
        {
          "f_idx": 34,
          "pidx_tc": 321077,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ハスミ",
          "tc": "……蓮實。",
          "sc": "……莲实。"
        },
        {
          "f_idx": 35,
          "pidx_tc": 321090,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナが辛いなら、",
          "tc": "琪娜娜，如果妳很難受，",
          "sc": "琪娜娜，如果你很难受，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 321097,
          "spk": "莲实 (ハスミ)",
          "ja": "私が全部……",
          "tc": "就由我來解釋一切……",
          "sc": "就由我来解释一切……"
        },
        {
          "f_idx": 37,
          "pidx_tc": 321110,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いや……いいよ、ハスミ",
          "tc": "不……沒關係，蓮實。",
          "sc": "不……没关系，莲实。"
        },
        {
          "f_idx": 38,
          "pidx_tc": 321117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチが説明する",
          "tc": "我來說明吧。",
          "sc": "我来说明吧。"
        },
        {
          "f_idx": 39,
          "pidx_tc": 321128,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どのみち、ここまでバレたら",
          "tc": "反正事情都已經敗露了，",
          "sc": "反正事情都已经败露了，"
        },
        {
          "f_idx": 40,
          "pidx_tc": 321135,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう全部話すしかなさそうだ",
          "tc": "看來也只能全盤托出了。",
          "sc": "看来也只能全盘托出了。"
        },
        {
          "f_idx": 42,
          "pidx_tc": 321151,
          "spk": "琪娜娜 (チナナ)",
          "ja": "少し長くなるんだけど……",
          "tc": "只是講起來需要花點時間就是了……",
          "sc": "只是讲起来需要花点时间就是了……"
        },
        {
          "f_idx": 43,
          "pidx_tc": 321158,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しょうがない……教えてあげようか……",
          "tc": "沒辦法……就告訴你們吧……",
          "sc": "没办法……就告诉你们吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5500,
      "rec_id": "TALK_ID_10_0502_216_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 321194,
          "spk": "琪娜娜 (チナナ)",
          "ja": "――というのが大体のあらましだね",
          "tc": "──事情大致就是這樣。",
          "sc": "——事情大致就是这样。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 321205,
          "spk": "堇怜 (スミレ)",
          "ja": "……なんだ、それ",
          "tc": "……這是怎樣。",
          "sc": "……这是怎样。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 321218,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレ……？",
          "tc": "堇怜……？",
          "sc": "堇怜……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 321231,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだよ、それ！",
          "tc": "這算什麼啊！",
          "sc": "这算什么啊！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 321238,
          "spk": "堇怜 (スミレ)",
          "ja": "どうして今まで隠してたんだ！",
          "tc": "為什麼一直以來都瞞著我！",
          "sc": "为什么一直以来都瞒着我！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 321245,
          "spk": "堇怜 (スミレ)",
          "ja": "みんな、馬鹿じゃないの！？",
          "tc": "大家都是笨蛋嗎！？",
          "sc": "大家都是笨蛋吗！？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 321258,
          "spk": "莲实 (ハスミ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 321275,
          "spk": "堇怜 (スミレ)",
          "ja": "だって、そうだろ！",
          "tc": "我有說錯嗎！",
          "sc": "我有说错吗！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 321282,
          "spk": "堇怜 (スミレ)",
          "ja": "そんな役割を、自分を犠牲にして",
          "tc": "犧牲自己一直去履行那種職責的",
          "sc": "牺牲自己一直去履行那种职责的"
        },
        {
          "f_idx": 9,
          "pidx_tc": 321289,
          "spk": "堇怜 (スミレ)",
          "ja": "続けてるチナナさんは馬鹿だ！！",
          "tc": "琪娜娜姐是笨蛋！！",
          "sc": "琪娜娜姐是笨蛋！！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 321300,
          "spk": "堇怜 (スミレ)",
          "ja": "役割のせいで僕たちを置いて",
          "tc": "為了職責早早拋下我們",
          "sc": "为了职责早早抛下我们"
        },
        {
          "f_idx": 11,
          "pidx_tc": 321307,
          "spk": "堇怜 (スミレ)",
          "ja": "さっさと死んじゃった父さんと母さんは、",
          "tc": "就這樣死去的爸爸媽媽",
          "sc": "就这样死去的爸爸妈妈"
        },
        {
          "f_idx": 12,
          "pidx_tc": 321314,
          "spk": "堇怜 (スミレ)",
          "ja": "大馬鹿だ！！",
          "tc": "是大笨蛋！！",
          "sc": "是大笨蛋！！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 321323,
          "spk": "堇怜 (スミレ)",
          "ja": "みんなみんな、勝手だよ！",
          "tc": "大家都太自作主張了！",
          "sc": "大家都太自作主张了！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 321330,
          "spk": "堇怜 (スミレ)",
          "ja": "僕はそんなの嫌だ！！",
          "tc": "我討厭這個樣子！",
          "sc": "我讨厌这个样子！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 321350,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……だけどね、スミレ",
          "tc": "……可是啊，堇怜。",
          "sc": "……可是啊，堇怜。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 321357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "役割を放棄したら",
          "tc": "要是丟下職責，",
          "sc": "要是丢下职责，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 321364,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村は成り立たなくなるんだよ",
          "tc": "村子就沒辦法運作了喔。",
          "sc": "村子就没办法运作了哦。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 321373,
          "spk": "琪娜娜 (チナナ)",
          "ja": "誰かが鵺の皮を被らなければ、",
          "tc": "如果沒有人披上鵺皮，",
          "sc": "如果没有人披上鵺皮，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 321380,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べ物や生活用品が足りなくなるんだ",
          "tc": "村子裡的食物和生活用品都會不足。",
          "sc": "村子里的食物和生活用品都会不足。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 321387,
          "spk": "琪娜娜 (チナナ)",
          "ja": "彼ヶ津村は滅ぶしかない",
          "tc": "彼津村就只有滅亡一途。",
          "sc": "彼津村就只有灭亡一途。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 321400,
          "spk": "堇怜 (スミレ)",
          "ja": "それでも、僕は嫌だ",
          "tc": "就算這樣，我也不要。",
          "sc": "就算这样，我也不要。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 321407,
          "spk": "堇怜 (スミレ)",
          "ja": "本当のことを知った以上、",
          "tc": "而且既然都知道真相了，",
          "sc": "而且既然都知道真相了，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 321414,
          "spk": "堇怜 (スミレ)",
          "ja": "チナナさんの犠牲も許せない",
          "tc": "也不能讓琪娜娜姐繼續犧牲。",
          "sc": "也不能让琪娜娜姐继续牺牲。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 321427,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレ……",
          "tc": "堇怜……",
          "sc": "堇怜……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 321434,
          "spk": "莲实 (ハスミ)",
          "ja": "それじゃ、どうするつもり？",
          "tc": "那你打算怎麼做？",
          "sc": "那你打算怎么做？"
        },
        {
          "f_idx": 27,
          "pidx_tc": 321447,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮はうちのものだ",
          "tc": "鵺皮是我們家的東西。",
          "sc": "鵺皮是我们家的东西。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 321454,
          "spk": "堇怜 (スミレ)",
          "ja": "チナナさんに長く貸してたけど、",
          "tc": "雖然借琪娜娜姐用了很久，",
          "sc": "虽然借琪娜娜姐用了很久，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 321461,
          "spk": "堇怜 (スミレ)",
          "ja": "もう返してもらう",
          "tc": "現在就還回來吧。",
          "sc": "现在就还回来吧。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 321474,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……わかった",
          "tc": "……好吧，",
          "sc": "……好吧，"
        },
        {
          "f_idx": 31,
          "pidx_tc": 321481,
          "spk": "琪娜娜 (チナナ)",
          "ja": "負けを認めるよ",
          "tc": "我認輸。",
          "sc": "我认输。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5501,
      "rec_id": "TALK_ID_10_0502_216_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 321511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "借りっぱなしで悪かったね",
