          "pidx_tc": 322261,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありがたいよね～",
          "tc": "真是太感激了～",
          "sc": "真是太感激了～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 322268,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これで、村の暮らしは当面、なんの心配もない",
          "tc": "這樣一來，就暫時不用為村中的生活擔憂了。",
          "sc": "这样一来，就暂时不用为村中的生活担忧了。"
        }
      ]
    },
