        {
          "f_idx": 22,
          "pidx_tc": 327233,
          "spk": "四郎治 (シロージ)",
          "ja": "俺は仕事を変えるしか――",
          "tc": "我只能換掉工作──",
          "sc": "我只能换掉工作——"
        }
      ]
    },
