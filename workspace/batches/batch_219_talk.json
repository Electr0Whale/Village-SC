          "f_idx": 3,
          "pidx_tc": 322151,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうしたら村は干上がるし、",
          "tc": "村子也會跟著撐不下去，",
          "sc": "村子也会跟着撑不下去，"
        },
