          "ja": "関係があるのでしょう？",
          "tc": "應該跟十年前的事有關吧？",
          "sc": "应该跟十年前的事有关吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 326900,
          "spk": "莲实 (ハスミ)",
          "ja": "いつまでも、",
          "tc": "我覺得，",
          "sc": "我觉得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 326907,
          "spk": "莲实 (ハスミ)",
          "ja": "隠し通せることじゃ",
          "tc": "應該沒有辦法",
          "sc": "应该没有办法"
        },
        {
          "f_idx": 5,
          "pidx_tc": 326914,
          "spk": "莲实 (ハスミ)",
          "ja": "ないと思います……",
          "tc": "一直瞞下去……",
          "sc": "一直瞒下去……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 326927,
          "spk": "四郎治 (シロージ)",
          "ja": "………………",
          "tc": "………………",
          "sc": "……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 326938,
          "spk": "四郎治 (シロージ)",
          "ja": "聞けば誰だって、俺の判断が",
          "tc": "任何人只要聽過實情，",
          "sc": "任何人只要听过实情，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 326945,
          "spk": "四郎治 (シロージ)",
          "ja": "正しいって思うだろ",
          "tc": "都會認為我的判斷是正確的吧。",
          "sc": "都会认为我的判断是正确的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5628,
      "rec_id": "TALK_ID_10_0503_328_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 326963,
          "spk": "四郎治 (シロージ)",
          "ja": "――十年前のことだ",
          "tc": "──那是十年前的事。",
          "sc": "——那是十年前的事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 326972,
          "spk": "四郎治 (シロージ)",
          "ja": "ある日突然、<strong>人がなにかに操られたように、",
          "tc": "某一天，發生了<strong>人像是被什麼操控了一樣，",
          "sc": "某一天，发生了<strong>人像是被什么操控了一样，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 326979,
          "spk": "四郎治 (シロージ)",
          "ja": "無作為に人を殺す</strong>という、不気味な事件……",
          "tc": "開始隨意殺人</strong>的恐怖事件……",
          "sc": "开始随意杀人</strong>的恐怖事件……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 326986,
          "spk": "四郎治 (シロージ)",
          "ja": "お前らも覚えてるだろ？",
          "tc": "你們都還記得吧？",
          "sc": "你们都还记得吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 326999,
          "spk": "莲实 (ハスミ)",
          "ja": "彼ヶ津村に大人が少ないのも、",
          "tc": "彼津村之所以大人這麼少，",
          "sc": "彼津村之所以大人这么少，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 327006,
          "spk": "莲实 (ハスミ)",
          "ja": "その時たくさん殺されたからでしたね",
          "tc": "也是因為當時有很多大人都被殺了。",
          "sc": "也是因为当时有很多大人都被杀了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 327026,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>……コマコは、あの時",
          "tc": "<strong>……駒子當時，",
          "sc": "<strong>……驹子当时，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 327033,
          "spk": "四郎治 (シロージ)",
          "ja": "村のみんなを、殺し回った側だった</strong>",
          "tc": "是到處殺害村民的那一方。</strong>",
          "sc": "是到处杀害村民的那一方。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5629,
      "rec_id": "TALK_ID_10_0503_328_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 327051,
          "spk": "四郎治 (シロージ)",
          "ja": "うちで飼っていた猟犬を殺し……",
          "tc": "她殺了我們家養的獵犬……",
          "sc": "她杀了我们家养的猎犬……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 327058,
          "spk": "四郎治 (シロージ)",
          "ja": "父さんと母さんを殺し……",
          "tc": "殺了爸媽……",
          "sc": "杀了爸妈……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 327065,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカの両親も……",
          "tc": "還有茶梅的父母也……",
          "sc": "还有茶梅的父母也……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 327076,
          "spk": "四郎治 (シロージ)",
          "ja": "でも、あの時のコマコは、",
          "tc": "可是那時候的駒子",
          "sc": "可是那时候的驹子"
        },
        {
          "f_idx": 4,
          "pidx_tc": 327083,
          "spk": "四郎治 (シロージ)",
          "ja": "なにかに操られていただけなんだ……！",
          "tc": "就只是被什麼操控了……！",
          "sc": "就只是被什么操控了……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 327094,
          "spk": "四郎治 (シロージ)",
          "ja": "だから俺は、あいつの罪を消してやりたくて……",
          "tc": "所以我為了消除她的罪行……",
          "sc": "所以我为了消除她的罪行……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 327101,
          "spk": "四郎治 (シロージ)",
          "ja": "必死に手段を探していた……",
          "tc": "拚命地尋找方法……",
          "sc": "拚命地寻找方法……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 327119,
          "spk": "四郎治 (シロージ)",
          "ja": "……そのときだ",
          "tc": "……就是那個時候。",
          "sc": "……就是那个时候。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 327126,
          "spk": "四郎治 (シロージ)",
          "ja": "俺の前に、一匹の獣が現れて……",
          "tc": "我的面前，出現了一隻野獸……",
          "sc": "我的面前，出现了一只野兽……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 327133,
          "spk": "四郎治 (シロージ)",
          "ja": "まるで人間みたいに、語りかけてきたんだ",
          "tc": "牠就像人類一樣，對我說──",
          "sc": "它就像人类一样，对我说——"
        },
        {
          "f_idx": 11,
          "pidx_tc": 327144,
          "spk": "四郎治 (シロージ)",
          "ja": "あれが現実だったのかどうか、今でも分からない",
          "tc": "我直到現在也不確定那到底是不是現實。",
          "sc": "我直到现在也不确定那到底是不是现实。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 327151,
          "spk": "四郎治 (シロージ)",
          "ja": "信じてもらえなくても、仕方ない話だが……",
          "tc": "就算你們不相信也無可厚非……",
          "sc": "就算你们不相信也无可厚非……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 327169,
          "spk": "四郎治 (シロージ)",
          "ja": "獣は俺に言った",
          "tc": "那野獸對我說，",
          "sc": "那野兽对我说，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 327176,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>「コマコの罪の記憶を消してやろう」</strong>と……",
          "tc": "<strong>「我來把駒子犯罪的記憶消除吧」</strong>……",
          "sc": "<strong>“我来把驹子犯罪的记忆消除吧”</strong>……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 327183,
          "spk": "四郎治 (シロージ)",
          "ja": "だが、対価に<strong>二つの条件</strong>を突きつけてきたんだ",
