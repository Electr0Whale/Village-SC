          "spk": "名护 (ナゴ)",
          "ja": "あんなに欲しがっていたのに",
          "tc": "你明明一直那麼想要拿回它。",
          "sc": "你明明一直那么想要拿回它。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 321693,
          "spk": "堇怜 (スミレ)",
          "ja": "そもそも、これがないと",
          "tc": "說到底，",
          "sc": "说到底，"
