        {
          "f_idx": 18,
          "pidx_tc": 327201,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>「家宝」を獣に捧げる</strong>こと……",
          "tc": "<strong>「傳家寶」獻給野獸</strong>……",
          "sc": "<strong>“传家宝”献给野兽</strong>……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 327208,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>もう一つは……俺がある契約を結ぶこと</strong>だった",
          "tc": "<strong>另一個……是我要締結某個契約</strong>。",
