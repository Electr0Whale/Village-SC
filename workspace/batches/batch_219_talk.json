          "pidx_tc": 321758,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレ……",
          "tc": "堇怜……",
          "sc": "堇怜……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 321777,
          "spk": "堇怜 (スミレ)",
          "ja": "土地神の祟りを鎮めて、",
          "tc": "希望你可以平息土地神作祟，",
