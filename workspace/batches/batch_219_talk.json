          "f_idx": 3,
          "pidx_tc": 326673,
          "spk": "今野 (コンノ)",
          "ja": "いやァ、それにしても",
          "tc": "哎呀～話說回來，",
          "sc": "哎呀～话说回来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 326680,
          "spk": "今野 (コンノ)",
          "ja": "驚きましたよォ",
