          "tc": "還真嚴重耶。",
          "sc": "还真严重呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5626,
      "rec_id": "TALK_ID_10_0503_328_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 326723,
          "spk": "四郎治 (シロージ)",
          "ja": "……白々しい",
          "tc": "……少裝了。",
          "sc": "……少装了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 326730,
          "spk": "四郎治 (シロージ)",
          "ja": "俺に何を喋らせたいんだ",
          "tc": "你想讓我講什麼？",
          "sc": "你想让我讲什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 326743,
          "spk": "今野 (コンノ)",
          "ja": "ご本人のことは、",
          "tc": "關於她本人的事，",
          "sc": "关于她本人的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 326750,
          "spk": "今野 (コンノ)",
          "ja": "ご本人に知らせてあげたほうが",
          "tc": "我覺得還是讓她知道",
          "sc": "我觉得还是让她知道"
        },
        {
          "f_idx": 4,
          "pidx_tc": 326757,
          "spk": "今野 (コンノ)",
          "ja": "いいと思いますけどねェ",
          "tc": "比較好就是了～",
          "sc": "比较好就是了～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 326770,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコのことは、",
          "tc": "駒子的事，",
          "sc": "驹子的事，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 326777,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が把握してりゃ充分だ",
          "tc": "只要有我了解就夠了。",
          "sc": "只要有我了解就够了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 326790,
          "spk": "今野 (コンノ)",
          "ja": "この先もずっと、",
          "tc": "您今後也打算",
          "sc": "您今后也打算"
        },
        {
          "f_idx": 8,
          "pidx_tc": 326797,
          "spk": "今野 (コンノ)",
          "ja": "このままのおつもりで？",
          "tc": "一直這樣下去嗎？",
          "sc": "一直这样下去吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 326808,
          "spk": "今野 (コンノ)",
          "ja": "十年経っても二十年経っても",
          "tc": "無論再過十年、二十年，",
          "sc": "无论再过十年、二十年，"
