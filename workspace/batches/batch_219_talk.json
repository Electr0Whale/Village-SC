          "pidx_tc": 322205,
          "spk": "琪娜娜 (チナナ)",
          "ja": "売買を頼めばいいってね",
          "tc": "委託外面的商人代為買賣就好了。",
          "sc": "委托外面的商人代为买卖就好了。"
        },
