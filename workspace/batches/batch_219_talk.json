        },
        {
          "f_idx": 3,
          "pidx_tc": 325218,
          "spk": "驹子 (コマコ)",
          "ja": "もう二度とここに来れなさそうだから……",
          "tc": "我應該就沒辦法再到這裡來了……",
          "sc": "我应该就没办法再到这里来了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 325229,
          "spk": "驹子 (コマコ)",
          "ja": "お願い……",
          "tc": "所以，拜託你……",
          "sc": "所以，拜托你……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 325236,
          "spk": "驹子 (コマコ)",
          "ja": "もうちょっとだけ、一緒に来て……",
          "tc": "再多陪我一下下就好……",
          "sc": "再多陪我一下下就好……"
        }
      ]
    },
    {
