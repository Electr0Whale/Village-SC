          "sc": "我自从没了鵺皮后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 322133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "わりと途方に暮れちゃったわけ",
          "tc": "其實一度不曉得該怎麼辦。",
          "sc": "其实一度不晓得该怎么办。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 322144,
          "spk": "琪娜娜 (チナナ)",
