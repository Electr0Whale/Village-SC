    {
      "file": "talk.dat",
      "rec_idx": 5514,
      "rec_id": "TALK_ID_10_0502_217_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322345,
          "spk": "莲实 (ハスミ)",
          "ja": "……<player>さん",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 322352,
          "spk": "莲实 (ハスミ)",
          "ja": "今回のこと、",
          "tc": "這次的事情，",
          "sc": "这次的事情，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 322359,
          "spk": "莲实 (ハスミ)",
          "ja": "ありがとうございました",
          "tc": "真的很謝謝你。",
          "sc": "真的很谢谢你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 322370,
          "spk": "莲实 (ハスミ)",
          "ja": "思い切って、この村の秘密について",
          "tc": "幸好我有下定決心，",
          "sc": "幸好我有下定决心，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 322377,
          "spk": "莲实 (ハスミ)",
          "ja": "お話ししてよかったです",
          "tc": "把這座村子的祕密告訴你。",
          "sc": "把这座村子的秘密告诉你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 322388,
          "spk": "莲实 (ハスミ)",
          "ja": "あなたとナゴさんを、",
          "tc": "雖然把你跟名護先生",
          "sc": "虽然把你跟名护先生"
        },
        {
          "f_idx": 6,
          "pidx_tc": 322395,
          "spk": "莲实 (ハスミ)",
          "ja": "村の事情に巻き込んでしまうのは",
          "tc": "捲進村子的私事裡，",
          "sc": "卷进村子的私事里，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 322402,
          "spk": "莲实 (ハスミ)",
          "ja": "気が引けていたんですけど……",
          "tc": "讓我很過意不去就是了……",
          "sc": "让我很过意不去就是了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 322413,
          "spk": "莲实 (ハスミ)",
          "ja": "私は、鵺の皮やチナナのこと……",
          "tc": "無論是鵺皮還是琪娜娜……",
          "sc": "无论是鵺皮还是琪娜娜……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 322420,
          "spk": "莲实 (ハスミ)",
          "ja": "そして、スミレに隠していたことを",
          "tc": "還有一直隱瞞著堇怜的事，",
          "sc": "还有一直隐瞒着堇怜的事，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 322427,
          "spk": "莲实 (ハスミ)",
          "ja": "ずっとなんとかしたかった……",
          "tc": "我一直都想要好好處理……",
          "sc": "我一直都想要好好处理……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 322438,
          "spk": "莲实 (ハスミ)",
          "ja": "見ているだけで何もできないことが、",
          "tc": "只能眼睜睜看著卻什麼都做不到，",
          "sc": "只能眼睁睁看着却什么都做不到，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 322445,
          "spk": "莲实 (ハスミ)",
          "ja": "ただただ、歯痒くて……",
          "tc": "真的讓我很不甘心……",
          "sc": "真的让我很不甘心……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 322456,
          "spk": "莲实 (ハスミ)",
          "ja": "だから、あなたが村の呪いを",
          "tc": "所以，",
          "sc": "所以，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 322463,
          "spk": "莲实 (ハスミ)",
          "ja": "断ち切ってくれることを、",
          "tc": "我也希望你可以",
          "sc": "我也希望你可以"
        },
        {
          "f_idx": 15,
          "pidx_tc": 322470,
          "spk": "莲实 (ハスミ)",
          "ja": "私も願っています",
          "tc": "幫忙斬斷村子的詛咒。",
          "sc": "帮忙斩断村子的诅咒。"
        }
      ]
    },
