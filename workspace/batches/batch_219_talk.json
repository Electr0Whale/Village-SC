          "f_idx": 11,
          "pidx_tc": 322225,
          "spk": "莲实 (ハスミ)",
          "ja": "連絡を取ってくださって",
          "tc": "名護先生還幫我們聯絡了市公所。",
          "sc": "名护先生还帮我们联络了市政厅。"
        },
