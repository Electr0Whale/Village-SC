          "spk": "琪娜娜 (チナナ)",
          "ja": "あんなに強く",
          "tc": "他居然會態度那麼強硬",
          "sc": "他居然会态度那么强硬"
        },
        {
          "f_idx": 8,
          "pidx_tc": 322558,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鵺の皮を返せなんて",
