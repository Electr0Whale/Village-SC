      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322488,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふ……頼もしいですね",
          "tc": "呵呵……真可靠呢。",
          "sc": "呵呵……真可靠呢。"
        },
        {
