      "rec_id": "TALK_ID_10_0502_217_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチ、鵺の皮がなくなって",
