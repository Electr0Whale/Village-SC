    {
      "file": "talk.dat",
      "rec_idx": 7980,
      "rec_id": "TALK_ID_10_0101_008_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 198817,
          "spk": "驹子 (コマコ)",
          "ja": "こんにちは、ハスミさん",
          "tc": "妳好，蓮實姐。",
          "sc": "你好，莲实姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 198830,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、こんにちは",
          "tc": "哎呀，你們好啊，",
          "sc": "哎呀，你们好啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 198837,
          "spk": "莲实 (ハスミ)",
          "ja": "コマコと……",
          "tc": "駒子跟……",
          "sc": "驹子跟……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 198850,
          "spk": "驹子 (コマコ)",
          "ja": "この子は、<player>っていうの",
          "tc": "這孩子叫做<player>。",
          "sc": "这孩子叫做<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 198863,
          "spk": "莲实 (ハスミ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 198876,
          "spk": "驹子 (コマコ)",
          "ja": "……ハスミさん？",
          "tc": "……蓮實姐？",
          "sc": "……莲实姐？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 198889,
          "spk": "莲实 (ハスミ)",
          "ja": "え、ええ、ごめんなさい",
          "tc": "啊，哎呀，不好意思。",
          "sc": "啊，哎呀，不好意思。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 198896,
          "spk": "莲实 (ハスミ)",
          "ja": "どこかで、会ったことがあるような",
          "tc": "因為我總覺得好像",
          "sc": "因为我总觉得好像"
        },
        {
          "f_idx": 8,
          "pidx_tc": 198903,
          "spk": "莲实 (ハスミ)",
          "ja": "気がしたので……",
          "tc": "在哪裡見過他……",
          "sc": "在哪里见过他……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 198916,
          "spk": "驹子 (コマコ)",
          "ja": "もしかしたら、キスケさんが言ってた",
          "tc": "那說不定就是木助哥說過的，",
          "sc": "那说不定就是木助哥说过的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 198923,
          "spk": "驹子 (コマコ)",
          "ja": "昔の尋ね人のチラシかも",
          "tc": "以前尋人啟事的傳單。",
          "sc": "以前寻人启事的传单。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 198943,
          "spk": "莲实 (ハスミ)",
          "ja": "そうかしら……",
          "tc": "是嗎……",
          "sc": "是吗……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 198950,
          "spk": "莲实 (ハスミ)",
          "ja": "そうかもしれないですね……",
          "tc": "可能是這樣吧……",
          "sc": "可能是这样吧……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 198963,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、この人はハスミさんだよ",
          "tc": "<player>，這位是蓮實姐。",
          "sc": "<player>，这位是莲实姐。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 198970,
          "spk": "驹子 (コマコ)",
          "ja": "村のお医者さんなの",
          "tc": "她是村子裡的醫生。",
          "sc": "她是村子里的医生。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 198983,
          "spk": "莲实 (ハスミ)",
          "ja": "え……あ……",
          "tc": "咦……啊……",
          "sc": "咦……啊……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 198990,
          "spk": "莲实 (ハスミ)",
          "ja": "い、いえ……それは……",
          "tc": "不、不是啦……",
          "sc": "不、不是啦……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 199001,
          "spk": "莲实 (ハスミ)",
          "ja": "私は医者などではありませんよ……",
          "tc": "我並不是什麼醫生……",
          "sc": "我并不是什么医生……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 199008,
          "spk": "莲实 (ハスミ)",
          "ja": "ただ、医学を少し学んだことがあり、",
          "tc": "只是稍微學過一點醫，",
          "sc": "只是稍微学过一点医，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 199015,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬を調合できる程度で……",
          "tc": "懂得調合漢方藥的程度而已……",
          "sc": "懂得调合汉方药的程度而已……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 199026,
          "spk": "莲实 (ハスミ)",
          "ja": "医師や薬剤師の免許を持っていないので、",
          "tc": "並沒有醫生或藥劑師的執照，",
          "sc": "并没有医生或药剂师的执照，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 199033,
          "spk": "莲实 (ハスミ)",
          "ja": "正式な治療はできないんですが……",
          "tc": "所以不能進行正式的治療……",
          "sc": "所以不能进行正式的治疗……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 199053,
          "spk": "驹子 (コマコ)",
          "ja": "でもハスミさんが塗ってくれるお薬は、",
          "tc": "不過，蓮實姐幫我們擦的藥",
          "sc": "不过，莲实姐帮我们擦的药"
        },
        {
          "f_idx": 25,
          "pidx_tc": 199060,
          "spk": "驹子 (コマコ)",
          "ja": "すごくよく効くんだよ",
          "tc": "都非常有效喔。",
          "sc": "都非常有效哦。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 199071,
          "spk": "驹子 (コマコ)",
          "ja": "私はよく怪我するから、",
          "tc": "我常常受傷，",
          "sc": "我常常受伤，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 199078,
          "spk": "驹子 (コマコ)",
          "ja": "いつもハスミさんにお世話になってるんだ……",
          "tc": "所以總是受到蓮實姐的照顧……",
          "sc": "所以总是受到莲实姐的照顾……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 199091,
          "spk": "莲实 (ハスミ)",
          "ja": "素人の手当てで構わないのであれば、",
          "tc": "只要你們不嫌棄我這個外行人的技術，",
          "sc": "只要你们不嫌弃我这个外行人的技术，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 199098,
          "spk": "莲实 (ハスミ)",
          "ja": "遠慮しないで来てください",
          "tc": "隨時都可以過來，不要客氣。",
          "sc": "随时都可以过来，不要客气。"
        },
        {
          "f_idx": 30,
          "pidx_tc": 199105,
          "spk": "莲实 (ハスミ)",
          "ja": "怪我を放置するほうが、危険ですから",
          "tc": "畢竟放任傷口不管更危險。",
          "sc": "毕竟放任伤口不管更危险。"
        }
      ]
    },
