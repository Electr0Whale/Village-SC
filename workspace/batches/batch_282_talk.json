  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7952,
      "rec_id": "TALK_ID_90_3001_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470058,
          "spk": "驹子 (コマコ)",
          "ja": "えっ、急ぎって……",
          "tc": "咦，急事……",
          "sc": "咦，急事……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470065,
          "spk": "驹子 (コマコ)",
          "ja": "一体何の用事だったの？",
          "tc": "到底是什麼事呢？",
          "sc": "到底是什么事呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470074,
          "spk": "驹子 (コマコ)",
          "ja": "私、いても大丈夫かな？",
          "tc": "我待在這裡沒關係嗎？",
          "sc": "我待在这里没关系吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470081,
          "spk": "驹子 (コマコ)",
          "ja": "帰ったほうがいい？",
          "tc": "還是先回去比較好？",
          "sc": "还是先回去比较好？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470094,
          "spk": "林 (リン)",
          "ja": "聞いていても構わないわよ",
          "tc": "妳可以留下來聽沒關係喔。",
          "sc": "你留下来听也没关系哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 470101,
          "spk": "林 (リン)",
          "ja": "あなたにも関係がある話だもの",
          "tc": "因為這件事也跟妳有關。",
          "sc": "因为这件事也跟你有关。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 470114,
          "spk": "驹子 (コマコ)",
          "ja": "え……う、うん……",
          "tc": "咦……嗯、好……",
          "sc": "咦……嗯、好……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 470121,
          "spk": "驹子 (コマコ)",
          "ja": "なんのことだろ……",
          "tc": "會是什麼事呢……",
          "sc": "会是什么事呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7953,
      "rec_id": "TALK_ID_90_3001_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470141,
          "spk": "林 (リン)",
          "ja": "ねぇ、<player>",
          "tc": "那個，<player>。",
          "sc": "那个，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470148,
          "spk": "林 (リン)",
          "ja": "あなたがここに来てから、",
          "tc": "自從你來到這裡之後，",
          "sc": "自从你来到这里之后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470155,
          "spk": "林 (リン)",
          "ja": "もう一年以上になるわよね",
          "tc": "已經過了一年多了吧。",
          "sc": "已经过去一年多了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470166,
          "spk": "林 (リン)",
          "ja": "村のみんなのプライベートなことも、",
          "tc": "對村裡大家私底下的一些事情，",
          "sc": "对村里大家私底下的一些事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470173,
          "spk": "林 (リン)",
          "ja": "ずいぶんわかってきたんじゃないかしら？",
          "tc": "你應該也相當了解了吧？",
          "sc": "你应该也相当了解了吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 470184,
          "spk": "林 (リン)",
          "ja": "でも最近、ふと思ったの……",
          "tc": "可是最近，我突然想到……",
          "sc": "可是最近，我突然想到……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 470191,
          "spk": "林 (リン)",
          "ja": "あなたは私たちのことを知ってくれたのに、",
          "tc": "你對我們已經這麼了解了，",
          "sc": "你对我们已经这么了解了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 470198,
          "spk": "林 (リン)",
          "ja": "私たちは、あなたのことをほとんど知らないのよ",
          "tc": "但我們對你的事卻幾乎一無所知呢。",
          "sc": "但我们对你的事却几乎一无所知呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 470211,
          "spk": "驹子 (コマコ)",
          "ja": "あ……確かに……",
          "tc": "啊……的確……",
          "sc": "啊……确实……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 470218,
          "spk": "驹子 (コマコ)",
          "ja": "<player>のことって意外と知らないかも……",
          "tc": "我們其實意外地對<player>不太了解呢……",
          "sc": "我们其实意外地对<player>不太了解呢……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 470231,
          "spk": "林 (リン)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 470238,
          "spk": "林 (リン)",
          "ja": "あなたは、もっと自己主張を覚えた方がいいわ",
          "tc": "你應該要學著多表達一些自己的事。",
          "sc": "你应该学着多表达一些自己的事。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 470249,
          "spk": "林 (リン)",
          "ja": "だから今日は、その第一歩として",
          "tc": "所以今天，就先踏出第一步，",
          "sc": "所以今天，就先迈出第一步，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 470256,
          "spk": "林 (リン)",
          "ja": "誕生日を教えてもらいたいのよ！",
          "tc": "告訴我你的生日吧！",
          "sc": "把你的生日告诉我吧！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 470269,
          "spk": "驹子 (コマコ)",
          "ja": "それは確かに、すごく大事なことだね",
          "tc": "這的確是一件很重要的事呢。",
          "sc": "这确实是一件非常重要的事呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7954,
      "rec_id": "TALK_ID_90_3001_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470287,
          "spk": "驹子 (コマコ)",
          "ja": "去年まではお祝いできなかったし、",
          "tc": "去年之前都沒能幫你慶祝，",
          "sc": "去年都没能帮你庆祝，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470294,
          "spk": "驹子 (コマコ)",
          "ja": "村のみんなも知りたかったと思うな",
          "tc": "我覺得村裡的大家應該也很想知道。",
          "sc": "我觉得村里的大家应该也很想知道。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470314,
          "spk": "林 (リン)",
          "ja": "別に、隠さなきゃいけない事情もないでしょ？",
          "tc": "反正也沒有什麼需要隱瞞的理由吧？",
          "sc": "反正也没有什么需要隐瞒的理由吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470321,
          "spk": "林 (リン)",
          "ja": "ほら、あなたの誕生日を教えなさい",
          "tc": "來吧，告訴我你的生日。",
          "sc": "快，把你的生日告诉我。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 470330,
          "spk": "主角心声/旁白/选项",
          "ja": "わかった",
          "tc": "我知道了",
          "sc": "我知道了"
        },
        {
          "f_idx": 6,
          "pidx_tc": 470337,
          "spk": "主角心声/旁白/选项",
          "ja": "わからない",
          "tc": "我不知道",
          "sc": "我不知道"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7955,
      "rec_id": "TALK_ID_90_3001_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470357,
          "spk": "林 (リン)",
          "ja": "そう、よかった",
          "tc": "這樣啊，太好了。",
          "sc": "这样啊，太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470364,
          "spk": "林 (リン)",
          "ja": "隠していたわけじゃなくて安心したわ",
          "tc": "不是刻意隱瞞，我就放心了。",
          "sc": "不是刻意隐瞒，我就放心了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470375,
          "spk": "林 (リン)",
          "ja": "で、あなたの誕生日は、",
          "tc": "所以，你的生日",
          "sc": "那么，你的生日"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470382,
          "spk": "林 (リン)",
          "ja": "いつなのかしら？",
          "tc": "是什麼時候呢？",
          "sc": "是什么时候呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7956,
      "rec_id": "TALK_ID_90_3001_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 470658,
          "spk": "驹子 (コマコ)",
          "ja": "<tmpstr>が、<player>の誕生日なんだね！",
          "tc": "<tmpstr>就是<player>的生日了！",
          "sc": "<tmpstr>就是<player>的生日了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 470669,
          "spk": "驹子 (コマコ)",
          "ja": "去年まではお祝いできなかったけど、",
          "tc": "雖然之前都沒能幫你慶祝，",
          "sc": "虽然之前都没能帮你庆祝，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 470676,
          "spk": "驹子 (コマコ)",
          "ja": "これで今年からはちゃんと祝えるよ！",
          "tc": "但從今年開始，就能好好幫你慶生了！",
          "sc": "但从今年开始，就能好好帮你庆生了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 470689,
          "spk": "林 (リン)",
          "ja": "村のみんなにも伝えておくから、",
          "tc": "我會轉告村裡的大家的，",
          "sc": "我会转告村里的大家的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 470696,
          "spk": "林 (リン)",
          "ja": "もしかすると、誕生日になったら",
          "tc": "搞不好到了生日那天，",
          "sc": "搞不好到了生日那天，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 470703,
          "spk": "林 (リン)",
          "ja": "プレゼントをもらえるかもしれないわよ",
          "tc": "你就會收到禮物也不一定喔。",
          "sc": "你就会收到礼物也不一定哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 470714,
          "spk": "林 (リン)",
          "ja": "ただ……仲良くもない人の誕生日って、",
          "tc": "不過……交情不深的人的生日，",
          "sc": "不过……交情不深的人的生日，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 470721,
          "spk": "林 (リン)",
          "ja": "なかなか覚えていられないでしょう……？",
          "tc": "通常很難記得住吧……？",
          "sc": "通常很难记得住吧……？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 470739,
          "spk": "林 (リン)",
          "ja": "だから今のうちに、",
          "tc": "所以要趁現在，",
          "sc": "所以要趁现在，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 470746,
          "spk": "林 (リン)",
          "ja": "誕生日を覚えておいてくれるくらい",
          "tc": "多交幾個朋友、建立深厚的交情，",
          "sc": "多交几个朋友、建立深厚的交情，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 470753,
          "spk": "林 (リン)",
          "ja": "仲のいい友達を作っておくことね",
          "tc": "讓他們記得你的生日才行呢。",
          "sc": "让他们牢牢记住你的生日才行呢。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 470766,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そんな理由で友達を作るのは",
          "tc": "為、為了這種理由交朋友，",
          "sc": "为、为了这种理由交朋友，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 470773,
          "spk": "驹子 (コマコ)",
          "ja": "どうかと思うけど……",
          "tc": "感覺不太對吧……",
          "sc": "感觉不太对吧……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 470784,
          "spk": "驹子 (コマコ)",
          "ja": "でも、村のみんななら、",
          "tc": "不過，如果是村裡的大家，",
          "sc": "不过，如果是村里的大家，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 470791,
          "spk": "驹子 (コマコ)",
          "ja": "きっと喜んでお祝いしてくれると思うよ",
          "tc": "一定會很樂意幫你慶祝的。",
          "sc": "一定都会很乐意帮你庆祝的。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 470804,
          "spk": "林 (リン)",
          "ja": "じゃあ、誕生日を楽しみにしていなさい",
          "tc": "那麼，就好好期待生日的到來吧。",
          "sc": "那么，就好好期待生日的到来吧。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 470822,
          "spk": "林 (リン)",
          "ja": "その日になったら、遠慮しなくていいわよ！",
          "tc": "到了那天，你可不用客氣喔！",
          "sc": "到了那天，你可不用客气哦！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 470829,
          "spk": "林 (リン)",
          "ja": "村のみんなのところへ行って、",
          "tc": "去找村裡的大家，",
          "sc": "去找村里的大家，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 470836,
          "spk": "林 (リン)",
          "ja": "「プレゼントは？」って催促して回りなさいね！",
          "tc": "一個一個地向他們討禮物吧！",
          "sc": "一个一个地向他们讨礼物吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7957,
      "rec_id": "TALK_ID_TUTORIAL_GRASS_HARVEST",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 471336,
          "spk": "主角心声/旁白/选项",
          "ja": "この草は手では",
          "tc": "這些草好像",
          "sc": "这些草好像"
        },
        {
          "f_idx": 1,
          "pidx_tc": 471343,
          "spk": "主角心声/旁白/选项",
          "ja": "抜けないみたい……",
          "tc": "沒辦法用手拔……",
          "sc": "没办法用手拔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 471354,
          "spk": "主角心声/旁白/选项",
          "ja": "道具があれば刈れるかも",
          "tc": "或許可以用工具割掉。",
          "sc": "或许可以用工具割掉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7958,
      "rec_id": "TALK_ID_GAMEOVER_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 471374,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん……",
          "tc": "<player>……",
          "sc": "<player>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7959,
      "rec_id": "TALK_ID_GAMEOVER_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 471398,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 471405,
          "spk": "莲实 (ハスミ)",
          "ja": "大丈夫ですか！？",
          "tc": "你還好嗎！？",
          "sc": "你还好吗！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7960,
      "rec_id": "TALK_ID_GAMEOVER_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 471429,
          "spk": "莲实 (ハスミ)",
          "ja": "はぁ……よかった",
          "tc": "呼……太好了。",
          "sc": "呼……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 471436,
          "spk": "莲实 (ハスミ)",
          "ja": "ご無事のようですね……",
          "tc": "看來你沒事……",
          "sc": "看来你没事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 471445,
          "spk": "莲实 (ハスミ)",
          "ja": "シロージが倒れているところを見つけて、",
          "tc": "四郎治看到你倒在地上，",
          "sc": "四郎治看到你倒在地上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 471452,
          "spk": "莲实 (ハスミ)",
          "ja": "ここまで運んでくれたんですよ",
          "tc": "就把你送到這裡來了。",
          "sc": "就把你送到这里来了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 471463,
          "spk": "莲实 (ハスミ)",
          "ja": "見た時には、",
          "tc": "看到你這樣，",
          "sc": "看到你这样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 471470,
          "spk": "莲实 (ハスミ)",
          "ja": "心臓が止まるかと思いました……",
          "tc": "我心臟差點就要停了……",
          "sc": "我心脏差点就要停了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 471481,
          "spk": "莲实 (ハスミ)",
          "ja": "ご自身の体力を見誤って、",
          "tc": "像這樣高估自己的體力，",
          "sc": "像这样高估自己的体力，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 471488,
          "spk": "莲实 (ハスミ)",
          "ja": "無理をしてはいけませんよ",
          "tc": "勉強自己苦撐是不行的喔！",
          "sc": "勉强自己苦撑是不行的哦！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 471499,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れてきたら、何か食べて",
          "tc": "累了就吃點東西，",
          "sc": "累了就吃点东西，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 471506,
          "spk": "莲实 (ハスミ)",
          "ja": "体力を回復してから行動してくださいね",
          "tc": "等恢復體力之後再行動吧！",
          "sc": "等恢复体力之后再行动吧！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 471522,
          "spk": "莲实 (ハスミ)",
          "ja": "もう、無理はされないように",
          "tc": "要好好保重，",
          "sc": "要好好保重，"
        },
        {
          "f_idx": 12,
