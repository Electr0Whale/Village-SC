        {
          "f_idx": 4,
          "pidx_tc": 199388,
          "spk": "驹子 (コマコ)",
          "ja": "サボろうとしてるんじゃなくて……？",
          "tc": "偷懶吧……？",
          "sc": "偷懒吧……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199401,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの手伝いがなくても",
          "tc": "說不定就算沒有我幫忙，",
          "sc": "说不定就算没有我帮忙，"
        },
