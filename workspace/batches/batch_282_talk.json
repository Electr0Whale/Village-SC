      "rec_id": "TALK_ID_10_0101_008_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 198483,
          "spk": "驹子 (コマコ)",
          "ja": "こんにちは、サザンカさん",
          "tc": "妳好，茶梅姐。",
          "sc": "你好，茶梅姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 198496,
          "spk": "茶梅 (サザンカ)",
          "ja": "あ、コマコじゃん",
          "tc": "啊，這不是駒子嗎？",
          "sc": "啊，这不是驹子吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 198503,
          "spk": "茶梅 (サザンカ)",
          "ja": "これから、スマホの電波を探しに行くから",
          "tc": "我正要去尋找手機訊號，",
          "sc": "我正要去寻找手机信号，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 198510,
          "spk": "茶梅 (サザンカ)",
          "ja": "さっき、店閉めちゃったよ",
          "tc": "剛剛已經把店關了喔。",
          "sc": "刚刚已经把店关了哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 198523,
          "spk": "驹子 (コマコ)",
          "ja": "大丈夫だよ、",
          "tc": "沒關係，",
          "sc": "没关系，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 198530,
          "spk": "驹子 (コマコ)",
          "ja": "今日はお買い物じゃないから",
          "tc": "我今天不是來買東西的。",
          "sc": "我今天不是来买东西的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 198543,
          "spk": "茶梅 (サザンカ)",
          "ja": "ところでそれ……誰？",
          "tc": "話說回來……他是誰啊？",
          "sc": "话说回来……他是谁啊？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 198556,
          "spk": "驹子 (コマコ)",
          "ja": "この子は、<player>",
          "tc": "這孩子叫<player>，",
          "sc": "这孩子叫<player>，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 198563,
          "spk": "驹子 (コマコ)",
          "ja": "山で迷子になっちゃったみたいで……",
          "tc": "他似乎在山裡迷路了……",
          "sc": "他似乎在山里迷路了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 198576,
          "spk": "茶梅 (サザンカ)",
          "ja": "迷子……？",
          "tc": "迷路了……？",
          "sc": "迷路了……？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 198583,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんな山奥の辺鄙な場所に？",
          "tc": "在這種深山偏僻的地方？",
          "sc": "在这种深山偏僻的地方？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 198596,
          "spk": "驹子 (コマコ)",
          "ja": "だから私たちで、",
          "tc": "所以說，我們能不能想辦法",
          "sc": "所以说，我们能不能想办法"
        },
        {
          "f_idx": 12,
          "pidx_tc": 198603,
          "spk": "驹子 (コマコ)",
          "ja": "帰るお家を探してあげるんだよ",
