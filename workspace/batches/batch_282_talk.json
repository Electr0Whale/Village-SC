    {
      "file": "talk.dat",
      "rec_idx": 7978,
      "rec_id": "TALK_ID_10_0101_008_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 198664,
          "spk": "驹子 (コマコ)",
          "ja": "あれ……？",
          "tc": "咦……？",
          "sc": "咦……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 198671,
          "spk": "驹子 (コマコ)",
          "ja": "よく考えたら、まだ営業時間だよね？",
          "tc": "仔細想想，現在應該還是營業時間吧？",
          "sc": "仔细想想，现在应该还是营业时间吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 198678,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさん、お店閉めちゃってよかったの？",
          "tc": "茶梅姐，妳把店關了沒問題嗎？",
          "sc": "茶梅姐，你把店关了没问题吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 198691,
          "spk": "茶梅 (サザンカ)",
          "ja": "今日は誰も来ないじゃん？",
          "tc": "反正今天也不會有人來嘛。",
          "sc": "反正今天也不会有人来嘛。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 198698,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシは、そろそろSNSの更新入れたいし",
          "tc": "我也想更新一下自己的社群媒體了。",
          "sc": "我也想更新一下自己的社群媒体了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 198718,
          "spk": "驹子 (コマコ)",
          "ja": "またサボってるの？",
          "tc": "妳又要偷懶了嗎？",
          "sc": "你又要偷懒了吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 198731,
          "spk": "茶梅 (サザンカ)",
          "ja": "サボりじゃないよ、",
          "tc": "這才不是偷懶，",
          "sc": "这才不是偷懒，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 198738,
          "spk": "茶梅 (サザンカ)",
          "ja": "客が来ないのが悪いんだ",
          "tc": "都是沒客人來的錯。",
          "sc": "都是没客人来的错。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 198745,
          "spk": "茶梅 (サザンカ)",
          "ja": "正当な理由っしょ",
          "tc": "這理由很正當吧？",
          "sc": "这理由很正当吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
