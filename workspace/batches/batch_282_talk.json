      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 471608,
          "spk": "莲实 (ハスミ)",
          "ja": "ご自身の体調を軽く見て、",
          "tc": "不可以輕忽自己的身體狀況，",
          "sc": "不可以轻忽自己的身体状况，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 471615,
          "spk": "莲实 (ハスミ)",
          "ja": "無茶をするのは禁物ですよ",
          "tc": "勉強自己可是大忌喔！",
          "sc": "勉强自己可是大忌哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 471631,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れを感じたら、少し休んだり、",
