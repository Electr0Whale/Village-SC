        },
        {
          "f_idx": 6,
          "pidx_tc": 471768,
          "spk": "莲实 (ハスミ)",
          "ja": "そろそろ直してください",
          "tc": "差不多該改掉了吧！",
          "sc": "差不多该改掉了吧！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 471777,
          "spk": "莲实 (ハスミ)",
          "ja": "休むべきときは休む……",
          "tc": "該休息的時候就要休息……",
          "sc": "该休息的时候就要休息……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 471784,
          "spk": "莲实 (ハスミ)",
          "ja": "そんなに難しいことじゃないでしょう？",
          "tc": "這件事應該沒有那麼困難吧？",
          "sc": "这件事应该没有那么困难吧？"
        },
