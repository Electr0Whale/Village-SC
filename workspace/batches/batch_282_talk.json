      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199280,
          "spk": "驹子 (コマコ)",
          "ja": "あれ、ロッカクさん",
          "tc": "奇怪，六角叔，",
          "sc": "奇怪，六角叔，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199287,
          "spk": "驹子 (コマコ)",
          "ja": "今日はもう店じまい？",
          "tc": "今天已經打烊了嗎？",
          "sc": "今天已经打烊了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199300,
          "spk": "六角 (ロッカク)",
          "ja": "この後、祭りの片付けがあるんスよ",
          "tc": "因為晚一點還要去幫祭典收拾善後。",
          "sc": "因为晚一点还要去帮祭典收拾善后。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199307,
          "spk": "六角 (ロッカク)",
          "ja": "なんか食べたかったっスか？",
          "tc": "你們本來是想吃點什麼嗎？",
          "sc": "你们本来是想吃点什么不？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199320,
          "spk": "驹子 (コマコ)",
          "ja": "ううん、大丈夫",
          "tc": "沒關係啦，不要緊。",
          "sc": "没关系啦，不要紧。"
        }
      ]
    },
    {
      "file": "talk.dat",
