      "rec_id": "TALK_ID_10_0101_008_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199348,
          "spk": "驹子 (コマコ)",
          "ja": "ロッカクさん、お祭りの後片付け、",
          "tc": "六角叔，你不是",
          "sc": "六角叔，你不是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199355,
          "spk": "驹子 (コマコ)",
          "ja": "行かなくてもいいの？",
          "tc": "要去幫祭典收拾善後嗎？",
          "sc": "要去帮祭典收拾善后吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199368,
          "spk": "六角 (ロッカク)",
          "ja": "呼ばれるまで待ってるっス",
          "tc": "等那邊叫我過去。",
