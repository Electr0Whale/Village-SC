      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_2803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112624,
          "spk": "林 (リン)",
          "ja": "夏場は、そうめんを重宝するわね",
          "tc": "夏天時，素麵真的很方便呢。",
          "sc": "夏天时，素面真的很方便呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112631,
          "spk": "林 (リン)",
          "ja": "食欲が落ちても食べられるし、安上がりだし",
          "tc": "即使食慾不振也吃得下，又很便宜。",
          "sc": "即使食欲不振也吃得下，又很便宜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112649,
          "spk": "林 (リン)",
          "ja": "もちろん、具材なんて一切入れないわよ",
          "tc": "當然，我什麼料都不會放喔。",
          "sc": "当然，我什么料都不会放哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 841,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_2810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112680,
          "spk": "林 (リン)",
          "ja": "どんなに強く雨が降っても",
          "tc": "無論雨下得多大，",
          "sc": "无论雨下得多大，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112687,
          "spk": "林 (リン)",
          "ja": "雨上がりには、綺麗な虹がかかる……",
          "tc": "雨停之後，都會出現美麗的彩虹……",
          "sc": "雨停之后，都会出现美丽的彩虹……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112698,
          "spk": "林 (リン)",
          "ja": "人生と一緒よ、あとでいいことが待ってるの",
          "tc": "人生也一樣，總會有美好的事物在後頭等著你。",
          "sc": "人生也一样，总会有美好的事物在后头等着你。"
        }
      ]
