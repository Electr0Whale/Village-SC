        {
          "f_idx": 2,
          "pidx_tc": 112796,
          "spk": "林 (リン)",
          "ja": "ほら、シャキッとしなさい！",
          "tc": "好了，給我振作起來！",
          "sc": "好了，给我振作起来！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112803,
          "spk": "林 (リン)",
          "ja": "炎天下でボーっとしてたら、倒れるわよ",
          "tc": "在大太陽底下發呆的話，會暈倒的喔。",
          "sc": "在大太阳底下发呆的话，会晕倒的哦。"
