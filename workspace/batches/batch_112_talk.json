      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111706,
          "spk": "林 (リン)",
          "ja": "情報の記録、管理、活用は",
          "tc": "資訊的記錄、管理和運用，",
          "sc": "信息的记录、管理和运用，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 111713,
          "spk": "林 (リン)",
          "ja": "仕事をする上で絶対的に必要よ",
          "tc": "在工作上是不可或缺的。",
          "sc": "在工作上是不可或缺的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 111731,
          "spk": "林 (リン)",
          "ja": "情報というのは、大事な力になるの",
          "tc": "所謂的資訊，會成為重要的力量。",
          "sc": "所谓的信息，会成为重要的力量。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 822,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111755,
          "spk": "林 (リン)",
          "ja": "なにも、朝から私の家に",
          "tc": "你沒必要一大早",
          "sc": "你没必要一大早"
        },
        {
          "f_idx": 1,
          "pidx_tc": 111762,
          "spk": "林 (リン)",
          "ja": "来なくたっていいじゃない……",
          "tc": "就跑來我家吧……",
          "sc": "就跑来我家吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 111769,
          "spk": "林 (リン)",
          "ja": "ヨウやスミレなら、一緒に遊んでくれるわよ",
          "tc": "如果是洋或堇怜，應該會陪你玩的。",
          "sc": "如果是洋或堇怜，应该会陪你玩的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 823,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111793,
          "spk": "林 (リン)",
          "ja": "必要なもの以外には触らないでね",
          "tc": "不要去碰必要之外的東西喔。",
          "sc": "不要去碰必要之外的东西哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 111800,
          "spk": "林 (リン)",
          "ja": "ここには、みんなの個人情報や",
          "tc": "這裡保管了許多重要的個人資訊",
          "sc": "这里保管了许多重要的个人信息"
        },
        {
          "f_idx": 2,
          "pidx_tc": 111807,
          "spk": "林 (リン)",
          "ja": "村の会計資料も保管してるから",
          "tc": "和村子的會計資料。",
          "sc": "和村子的会计资料。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 824,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111831,
          "spk": "林 (リン)",
          "ja": "この土地ではね、",
          "tc": "在這裡，",
          "sc": "在这里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 111838,
          "spk": "林 (リン)",
          "ja": "生まれてきた子の名前を、",
          "tc": "剛出生的孩子",
          "sc": "刚出生的孩子"
        },
        {
          "f_idx": 2,
          "pidx_tc": 111845,
          "spk": "林 (リン)",
          "ja": "村長がつける習わしがあるの",
          "tc": "有讓村長取名的習俗。",
          "sc": "有让村长取名的习俗。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 111856,
          "spk": "林 (リン)",
          "ja": "村のみんなの名前は、",
          "tc": "村裡所有人的名字",
          "sc": "村里所有人的名字"
        },
        {
          "f_idx": 4,
          "pidx_tc": 111863,
          "spk": "林 (リン)",
          "ja": "先代の村長だった私の父がつけたのよ",
          "tc": "都是上一任村長，也就是我父親取名的。",
          "sc": "都是上一任村长，也就是我父亲取名的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 111881,
          "spk": "林 (リン)",
          "ja": "私もいつか、誰かの名付け親になるはずだから、",
          "tc": "將來我也會幫村裡的某個人取名，",
          "sc": "将来我也会帮村里的某个人取名，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 111888,
          "spk": "林 (リン)",
          "ja": "今のうちから候補を考えてるの",
          "tc": "所以想趁現在先想幾個起來。",
          "sc": "所以想趁现在先想几个起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 825,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111919,
          "spk": "林 (リン)",
          "ja": "今度、スイカ割り大会でも開こうかしら？",
          "tc": "下次來辦個打西瓜大會吧？",
          "sc": "下次来办个打西瓜大会吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 111937,
          "spk": "林 (リン)",
          "ja": "仕入れた分が余ったとかで",
          "tc": "因為進貨進太多，",
          "sc": "因为进货进太多，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 111944,
          "spk": "林 (リン)",
          "ja": "チナナからタダで譲ってもらったのよ",
          "tc": "所以琪娜娜免費送給我了。",
          "sc": "所以琪娜娜免费送给我了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 826,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2205",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 111968,
          "spk": "林 (リン)",
          "ja": "ちょっと、誰よ、特売セールのチラシを",
          "tc": "等等，是誰在公告欄貼了",
          "sc": "等等，是谁在公告栏贴了"
        },
        {
          "f_idx": 1,
          "pidx_tc": 111975,
          "spk": "林 (リン)",
          "ja": "掲示板に貼り付けたりしてるのは",
          "tc": "特價活動的傳單啊？",
          "sc": "特价活动的传单啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 111982,
          "spk": "林 (リン)",
          "ja": "お買い得情報なら、よそでやってほしいわ",
          "tc": "要宣傳優惠資訊的話，去其他地方貼啦。",
          "sc": "要宣传优惠信息的话，去其他地方贴啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 827,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112006,
          "spk": "林 (リン)",
          "ja": "もう一年の半分が過ぎたのね……",
          "tc": "一年也過了一半啊……",
          "sc": "一年也过了一半啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112013,
          "spk": "林 (リン)",
          "ja": "この分だと、あっという間に年末を迎えそう",
          "tc": "照這樣下去，轉眼就要到年底了。",
          "sc": "照这样下去，转眼就要到年底了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 828,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112037,
          "spk": "林 (リン)",
          "ja": "<player>の今日の予定を聞いておこうかしら",
          "tc": "來問一下<player>今天的行程好了。",
          "sc": "来问一下<player>今天的行程好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112055,
          "spk": "林 (リン)",
          "ja": "……グータラ過ごすつもりなら",
          "tc": "……如果你打算懶散度日，",
          "sc": "……如果你打算懒散度日，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112062,
          "spk": "林 (リン)",
          "ja": "お説教タイムに突入するけど、準備はいい？",
          "tc": "我就要開始說教囉，做好心理準備了嗎？",
          "sc": "我可要开始说教了哦，做好心理准备了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 829,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112086,
          "spk": "林 (リン)",
          "ja": "外は雨降りだし、今日は",
          "tc": "外面在下雨，",
          "sc": "外面在下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112093,
          "spk": "林 (リン)",
          "ja": "書類の整理に専念しようかしら",
          "tc": "今天就專心整理文件好了。",
          "sc": "今天就专心整理文件好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112104,
          "spk": "林 (リン)",
          "ja": "外での仕事は、",
          "tc": "外勤的工作",
          "sc": "外勤的工作"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112111,
          "spk": "林 (リン)",
          "ja": "コンノにでも頼むことにして……",
          "tc": "就拜託今野……",
          "sc": "就拜托今野……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 830,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2213",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112135,
          "spk": "林 (リン)",
          "ja": "あら、こんな雨なのに散歩？",
          "tc": "哎？你在這種大雨之中散步？",
          "sc": "哎？你在这种大雨之中散步？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112153,
          "spk": "林 (リン)",
          "ja": "こんな場所に用は無いでしょ",
          "tc": "你來這種地方也沒有事可做吧？",
          "sc": "你来这种地方也没有事可做吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112160,
          "spk": "林 (リン)",
          "ja": "やるべきことをしてきなさい",
          "tc": "去做你該做的事。",
          "sc": "去做你该做的事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 831,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2214",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112184,
          "spk": "林 (リン)",
          "ja": "この井戸に近づかないようにね",
          "tc": "別靠近這口井，",
          "sc": "别靠近这口井，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112191,
          "spk": "林 (リン)",
          "ja": "間違っても中を覗いたりしてはダメよ",
          "tc": "也絕對不可以往裡頭窺視。",
          "sc": "也绝对不可以往里头窥视。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 832,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2215",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112215,
          "spk": "林 (リン)",
          "ja": "罰当たりな不届き者が来ないか、監視してるの",
          "tc": "我正在監視有沒有遭天譴的壞蛋靠近。",
          "sc": "我正在监视有没有遭天谴的坏蛋靠近。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112222,
          "spk": "林 (リン)",
          "ja": "例えば……トバリとか",
          "tc": "比方說……帷之類的。",
          "sc": "比方说……帷之类的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112240,
          "spk": "林 (リン)",
          "ja": "あの子、墓石だって平気で蹴りそうじゃない？",
          "tc": "那孩子感覺連墓碑都能若無其事地踢一腳對吧？",
          "sc": "那孩子感觉连墓碑都能若无其事地踢一脚对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 833,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112271,
          "spk": "林 (リン)",
          "ja": "ロッカク……家賃を払えないのなら、",
          "tc": "六角……如果付不起房租，",
          "sc": "六角……如果付不起房租，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112278,
          "spk": "林 (リン)",
          "ja": "食堂のメニューを値上げすればいいのに……",
          "tc": "為什麼不調漲餐廳的菜單價格呢……",
          "sc": "为什么不调涨餐厅的菜单价格呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112296,
          "spk": "林 (リン)",
          "ja": "村のみなさんが困るからって、",
          "tc": "他好像說調漲價格村裡的大家會很困擾",
          "sc": "他好像说调涨价格村里的大家会很困扰"
        },
        {
          "f_idx": 4,
          "pidx_tc": 112303,
          "spk": "林 (リン)",
          "ja": "ずっと今の値段で据え置いてるそうよ",
          "tc": "才一直維持著現在的價格。",
          "sc": "才一直维持着现在的价格。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 112310,
          "spk": "林 (リン)",
          "ja": "全く、お人よしなんだから……",
          "tc": "受不了，真是個濫好人……",
          "sc": "受不了，真是个滥好人……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 834,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112334,
          "spk": "林 (リン)",
          "ja": "もうクタクタ……",
          "tc": "我已經筋疲力盡了……",
          "sc": "我已经筋疲力尽了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112341,
          "spk": "林 (リン)",
          "ja": "夏は、滝のような汗と疲れが",
          "tc": "夏天時，汗水跟疲憊感",
          "sc": "夏天时，汗水跟疲惫感"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112348,
          "spk": "林 (リン)",
          "ja": "全身を流れていくようだわ",
          "tc": "就像瀑布一樣從全身流淌而下。",
          "sc": "就像瀑布一样从全身流淌而下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 835,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112372,
          "spk": "林 (リン)",
          "ja": "そんな……まさか……",
          "tc": "這……怎麼可能……",
          "sc": "这……怎么可能……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112379,
          "spk": "林 (リン)",
          "ja": "財布に穴が開いてたなんて……",
          "tc": "錢包竟然破了一個洞……",
          "sc": "钱包竟然破了一个洞……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112390,
          "spk": "林 (リン)",
          "ja": "私のお金が……むにゃむにゃ……",
          "tc": "我的錢……唔唔……",
          "sc": "我的钱……唔唔……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 836,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_20_104_2232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112414,
          "spk": "林 (リン)",
          "ja": "どうして夏場って、こう蒸し暑いのかしら",
          "tc": "為什麼夏天會這麼悶熱呢？",
          "sc": "为什么夏天会这么闷热呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112432,
          "spk": "林 (リン)",
          "ja": "しばらくは寝苦しい夜が続きそうね",
          "tc": "看來難以入眠的夜晚還會持續一陣子呢。",
          "sc": "看来难以入眠的夜晚还会持续一阵子呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 837,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_2800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112463,
          "spk": "林 (リン)",
          "ja": "泥汚れがついたら、落とすの大変なのよ……",
          "tc": "一旦沾上泥巴，就很難弄乾淨了喔……",
          "sc": "一旦沾上泥巴，就很难弄干净了哦……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112481,
          "spk": "林 (リン)",
          "ja": "余計な仕事が増えるかもしれないし",
          "tc": "說不定還會增加一些額外的工作。",
          "sc": "说不定还会增加一些额外的工作。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112488,
          "spk": "林 (リン)",
          "ja": "雨の日って気持ちが憂鬱になるわね",
          "tc": "下雨天總讓人心情鬱悶呢。",
          "sc": "下雨天总让人心情郁闷呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 838,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112512,
          "spk": "林 (リン)",
          "ja": "村長仕事に、休みなんてないわ",
          "tc": "村長的工作，哪有什麼休息日啊。",
          "sc": "村长的工作，哪有什么休息日啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 112530,
          "spk": "林 (リン)",
          "ja": "私は今日も汗水たらして働くから、",
          "tc": "我今天也會流著汗水辛勤工作，",
          "sc": "我今天也会流着汗水辛勤工作，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112537,
          "spk": "林 (リン)",
          "ja": "<player>も自分の仕事に精を出しなさい",
          "tc": "所以<player>也要專注做好自己的工作。",
          "sc": "所以<player>也要专注做好自己的工作。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 839,
      "rec_id": "TALK_ID_VILLAGE_HEAD_ROUTINE_WALK_20_104_2802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112568,
          "spk": "林 (リン)",
          "ja": "「暑い」と思ったり、口に出すから暑いのよ",
          "tc": "正因為你心想「好熱」或是說出口，才會覺得熱。",
          "sc": "正因为你心想“好热”或是说出口，才会觉得热。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112575,
          "spk": "林 (リン)",
          "ja": "暑くても我慢すれば、慣れるはずよ",
          "tc": "就算很熱，只要忍耐，應該就會習慣的。",
          "sc": "就算很热，只要忍耐，应该就会习惯的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 112593,
          "spk": "林 (リン)",
          "ja": "……ほら、あなたのせいで暑くなってきた",
          "tc": "……你看，都是因為你才越來越熱啦。",
          "sc": "……你看，都是因为你才越来越热啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
