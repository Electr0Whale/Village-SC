      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 112729,
          "spk": "林 (リン)",
          "ja": "太陽が働き過ぎるせいで、暑くて敵わないわ",
          "tc": "都怪太陽太認真工作，熱到讓人受不了了。",
          "sc": "都怪太阳太认真工作，热到让人受不了了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 112736,
          "spk": "林 (リン)",
          "ja": "もっと周囲に気を配ってほしいものよね",
          "tc": "真希望它能多考慮一下周遭人的心情。",
          "sc": "真希望它能多考虑一下周遭人的心情。"
