  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8505,
      "rec_id": "TALK_ID_10_0202_051_03_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232081,
          "spk": "四郎治 (シロージ)",
          "ja": "今年も無事に、",
          "tc": "幸好今年也平安無事地",
          "sc": "幸好今年也平安无事地"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232088,
          "spk": "四郎治 (シロージ)",
          "ja": "墓参りの日を迎えられて良かったよ",
          "tc": "迎來了掃墓日。",
          "sc": "迎来了扫墓日。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232108,
          "spk": "茶梅 (サザンカ)",
          "ja": "そうだね",
          "tc": "是啊，",
          "sc": "是啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232115,
          "spk": "茶梅 (サザンカ)",
          "ja": "参られる側になってなくてさ",
          "tc": "幸好沒有成為被祭拜的一方。",
          "sc": "幸好没有成为被祭拜的一方。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8506,
      "rec_id": "TALK_ID_10_0202_051_03_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232133,
          "spk": "四郎治 (シロージ)",
          "ja": "……やめろよ縁起悪い",
          "tc": "……別這樣說些不吉利的話。",
          "sc": "……别这样说些不吉利的话。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232146,
          "spk": "茶梅 (サザンカ)",
          "ja": "それにしても、あの日から……",
          "tc": "不過，從那一天起……",
          "sc": "不过，从那一天起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232153,
          "spk": "茶梅 (サザンカ)",
          "ja": "墓が増えてから、十年も経ったんだね",
          "tc": "從墳墓變多的那一天後，已經過十年了呢。",
          "sc": "从坟墓变多的那一天后，已经过十年了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8507,
      "rec_id": "TALK_ID_10_0202_051_03_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232171,
          "spk": "四郎治 (シロージ)",
          "ja": "……事件の話もやめろ",
          "tc": "……別提那個事件了，",
          "sc": "……别提那个事件了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232178,
          "spk": "四郎治 (シロージ)",
          "ja": "思い出したくない",
          "tc": "我不想回想起來。",
          "sc": "我不想回想起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8508,
      "rec_id": "TALK_ID_10_0202_051_03_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232318,
          "spk": "四郎治 (シロージ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8509,
      "rec_id": "TALK_ID_10_0202_051_03_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232336,
          "spk": "茶梅 (サザンカ)",
          "ja": "シロージの図体がでかいから、",
          "tc": "四郎治的塊頭太魁梧，",
          "sc": "四郎治的块头太魁梧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232343,
          "spk": "茶梅 (サザンカ)",
          "ja": "終わるまでアタシは、",
          "tc": "我只能等到四郎治結束之後",
          "sc": "我只能等到四郎治结束之后"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232350,
          "spk": "茶梅 (サザンカ)",
          "ja": "お参りできないんだよね……",
          "tc": "才能開始掃墓……",
          "sc": "才能开始扫墓……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8510,
      "rec_id": "TALK_ID_10_0202_051_04_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232378,
          "spk": "林 (リン)",
          "ja": "お父様、お父様……",
          "tc": "父親，父親……",
          "sc": "父亲，父亲……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232387,
          "spk": "林 (リン)",
          "ja": "あの日から十年……",
          "tc": "從那一天起已經過了十年……",
          "sc": "从那一天起已经过了十年……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232394,
          "spk": "林 (リン)",
          "ja": "ついにこの時が来ました……",
          "tc": "終於到了這一刻……",
          "sc": "终于到了这一刻……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232401,
          "spk": "林 (リン)",
          "ja": "私は必ず、村長としての役目を果たします……",
          "tc": "我一定會善盡身為村長的職責……",
          "sc": "我一定会善尽身为村长的职责……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232414,
          "spk": "木助 (キスケ)",
          "ja": "……あれから十年も経ったのか",
          "tc": "……從那一天之後已經過了十年了嗎。",
          "sc": "……从那一天之后已经过了十年了吗。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 232421,
          "spk": "木助 (キスケ)",
          "ja": "早いもんだぜ",
          "tc": "時間過得真快。",
          "sc": "时间过得真快。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 232432,
          "spk": "木助 (キスケ)",
          "ja": "こんな区切りの年に、",
          "tc": "而就在這麼特別的年分，",
          "sc": "而就在这么特别的年分，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 232439,
          "spk": "木助 (キスケ)",
          "ja": "<player>が村に現れるなんてな……",
          "tc": "<player>出現在了村子裡……",
          "sc": "<player>出现在了村子里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8511,
      "rec_id": "TALK_ID_10_0202_051_04_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232457,
          "spk": "林 (リン)",
          "ja": "……キスケさん、",
          "tc": "……木助哥，",
          "sc": "……木助哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232464,
          "spk": "林 (リン)",
          "ja": "そんなこと言ってはいけないわ",
          "tc": "你不該這麼說。",
          "sc": "你不该这么说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232473,
          "spk": "林 (リン)",
          "ja": "<player>が現れたことは、",
          "tc": "<player>的出現，",
          "sc": "<player>的出现，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232480,
          "spk": "林 (リン)",
          "ja": "祝うべきことよ",
          "tc": "是一件值得慶祝的事。",
          "sc": "是一件值得庆祝的事。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232493,
          "spk": "木助 (キスケ)",
          "ja": "……どうだか",
          "tc": "……誰知道呢。",
          "sc": "……谁知道呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8512,
      "rec_id": "TALK_ID_10_0202_051_04_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232523,
          "spk": "林 (リン)",
          "ja": "あんな事件は、",
          "tc": "絕不能讓那種事件",
          "sc": "绝不能让那种事件"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232530,
          "spk": "林 (リン)",
          "ja": "もう二度と起こしてはいけないわ……",
          "tc": "再一次發生……",
          "sc": "再一次发生……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232541,
          "spk": "林 (リン)",
          "ja": "だからこそ掟は、誰もが守らなければならない",
          "tc": "也因此，所有人都必須要遵守規矩。",
          "sc": "也因此，所有人都必须要遵守规矩。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232548,
          "spk": "林 (リン)",
          "ja": "今年こそ、贄の儀式も成し遂げなければ……",
          "tc": "今年，一定要順利完成祭品儀式……",
          "sc": "今年，一定要顺利完成祭品仪式……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8513,
      "rec_id": "TALK_ID_10_0202_051_04_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232573,
          "spk": "木助 (キスケ)",
          "ja": "……それだけで防げるのかよ",
          "tc": "……光是那樣就能防範了嗎？",
          "sc": "……光是那样就能防范了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8514,
      "rec_id": "TALK_ID_10_0202_051_04_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232591,
          "spk": "林 (リン)",
          "ja": "十年前、儀式をきちんと行っていれば、",
          "tc": "十年前，如果可以好好完成儀式，",
          "sc": "十年前，如果可以好好完成仪式，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232598,
          "spk": "林 (リン)",
          "ja": "あんなことは起きなかったのよ",
          "tc": "就不會發生那樣的事情了。",
          "sc": "就不会发生那样的事情了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232618,
          "spk": "木助 (キスケ)",
          "ja": "……ふん",
          "tc": "……哼。",
          "sc": "……哼。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232625,
          "spk": "木助 (キスケ)",
          "ja": "それも、てめぇのオヤジからの遺言か?",
          "tc": "這也是妳爸的遺言嗎？",
          "sc": "这也是你爸的遗言吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 232645,
          "spk": "林 (リン)",
          "ja": "そうよ、村を守るために受け継がれた、",
          "tc": "沒錯，這是為了守護村子",
          "sc": "没错，这是为了守护村子"
        },
        {
          "f_idx": 7,
          "pidx_tc": 232652,
          "spk": "林 (リン)",
          "ja": "大切な教えよ",
          "tc": "而代代流傳下來的重要教誨。",
          "sc": "而代代流传下来的重要教诲。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8515,
      "rec_id": "TALK_ID_10_0202_051_04_02_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232675,
          "spk": "林 (リン)",
          "ja": "私に迷いはないわ",
          "tc": "我不會有任何迷惘。",
          "sc": "我不会有任何迷惘。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232688,
          "spk": "木助 (キスケ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8516,
      "rec_id": "TALK_ID_10_0202_051_04_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232718,
          "spk": "林 (リン)",
          "ja": "私も、気を引き締めないといけないわ……",
          "tc": "我也必須要提高警覺才行……",
          "sc": "我也必须要提高警觉才行……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232725,
          "spk": "林 (リン)",
          "ja": "最近よそ者も増えたから、",
          "tc": "最近外來者越來越多，",
          "sc": "最近外来者越来越多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232732,
          "spk": "林 (リン)",
          "ja": "改めて守るべきものを守らないと……",
          "tc": "我必須守護好該守護的東西……",
          "sc": "我必须守护好该守护的东西……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232745,
          "spk": "木助 (キスケ)",
          "ja": "……そんな上手くいくかねぇ",
          "tc": "……事情會那麼順利嗎？",
          "sc": "……事情会那么顺利吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8517,
      "rec_id": "TALK_ID_10_0202_051_04_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232763,
          "spk": "林 (リン)",
          "ja": "ところで……<player>",
          "tc": "話說回來……<player>，",
          "sc": "话说回来……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232770,
          "spk": "林 (リン)",
          "ja": "サボって盗み聞きしてる時間が、",
          "tc": "你還有時間偷懶，",
          "sc": "你还有时间偷懒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232777,
          "spk": "林 (リン)",
          "ja": "あなたにあるのかしら？",
          "tc": "偷聽我們講話嗎？",
          "sc": "偷听我们讲话吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232788,
          "spk": "林 (リン)",
          "ja": "早く、墓地の草を全て刈って",
          "tc": "快去把墓地的草都割完，",
          "sc": "快去把墓地的草都割完，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232795,
          "spk": "林 (リン)",
          "ja": "キレイにしなさい",
          "tc": "把這裡弄乾淨。",
          "sc": "把这里弄干净。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8518,
      "rec_id": "TALK_ID_10_0202_051_05_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232823,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、ここに、",
          "tc": "叔叔，這裡就是",
          "sc": "叔叔，这里就是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232830,
          "spk": "洋 (ヨウ)",
          "ja": "わたしの、おとうさんとおかあさんが",
          "tc": "我的爸爸、媽媽",
          "sc": "我的爸爸、妈妈"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232837,
          "spk": "洋 (ヨウ)",
          "ja": "眠っているの？",
          "tc": "沉睡的地方嗎？",
          "sc": "沉睡的地方吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232850,
          "spk": "六角 (ロッカク)",
          "ja": "そうっスよ……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232857,
          "spk": "六角 (ロッカク)",
          "ja": "お二人にヨウさんが元気だということ、",
          "tc": "告訴他們兩位，",
          "sc": "告诉他们两位，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 232864,
          "spk": "六角 (ロッカク)",
          "ja": "伝えてあげてくださいな",
          "tc": "洋妹妹現在過得很健康吧。",
          "sc": "洋妹妹现在过得很健康吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8519,
      "rec_id": "TALK_ID_10_0202_051_05_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232882,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんの眠る場所に、",
          "tc": "那嗶羅也跟爸爸、媽媽",
          "sc": "那哔罗也跟爸爸、妈妈"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232889,
          "spk": "洋 (ヨウ)",
          "ja": "あの子も眠ってるのかな……？",
          "tc": "一起沉睡著嗎？",
          "sc": "一起沉睡着吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8520,
      "rec_id": "TALK_ID_10_0202_051_05_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232907,
          "spk": "六角 (ロッカク)",
          "ja": "大丈夫、きっと一緒に眠ってるっス",
          "tc": "別擔心，他們一定是一起沉睡。",
          "sc": "别担心，他们一定是一起沉睡呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8521,
      "rec_id": "TALK_ID_10_0202_051_05_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232932,
          "spk": "洋 (ヨウ)",
          "ja": "そうなのかな……",
          "tc": "是嗎……",
          "sc": "是吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8522,
      "rec_id": "TALK_ID_10_0202_051_05_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232962,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、あの子はたぶんまだ、",
          "tc": "叔叔，我覺得嗶羅好像",
          "sc": "叔叔，我觉得哔罗好像"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232969,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんの側には",
          "tc": "沒有到爸爸、媽媽",
          "sc": "没有到爸爸、妈妈"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232976,
          "spk": "洋 (ヨウ)",
          "ja": "行ってないんじゃないかな……",
          "tc": "他們身邊……",
          "sc": "他们身边……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232987,
          "spk": "洋 (ヨウ)",
          "ja": "だって、夜になると",
          "tc": "因為到了晚上……",
          "sc": "因为到了晚上……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 232994,
          "spk": "洋 (ヨウ)",
          "ja": "鳴き声が聞こえるから……",
          "tc": "我可以聽到嗶羅的叫聲……",
          "sc": "我可以听到哔罗的叫声……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233005,
          "spk": "洋 (ヨウ)",
          "ja": "きっとまだ、わたしの側にいると思う……",
          "tc": "牠一定還在我身邊……",
          "sc": "它一定还在我身边……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8523,
      "rec_id": "TALK_ID_10_0202_051_05_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233023,
          "spk": "六角 (ロッカク)",
          "ja": "だ、大丈夫っスよ、ヨウさん……",
          "tc": "沒、沒事的，洋妹妹……",
          "sc": "没、没事的，洋妹妹……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233032,
          "spk": "六角 (ロッカク)",
          "ja": "きっと、大丈夫だから……",
          "tc": "一定會沒事的……",
          "sc": "一定会没事的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233039,
          "spk": "六角 (ロッカク)",
          "ja": "それよりも今日はご両親にご挨拶を……",
          "tc": "現在更重要的，是向妳父母打招呼……",
          "sc": "现在更重要的，是向你父母打招呼……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8524,
      "rec_id": "TALK_ID_10_0202_051_05_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233057,
          "spk": "洋 (ヨウ)",
          "ja": "うん……でも、わたし、",
          "tc": "嗯……可是我根本沒見過",
          "sc": "嗯……可是我根本没见过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233064,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんのこと知らないし……",
          "tc": "爸爸媽媽……",
          "sc": "爸爸妈妈……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233077,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさん、それでもあなたのご両親っス……",
          "tc": "洋妹妹，即使如此，他們還是妳的父母……",
          "sc": "洋妹妹，即使如此，他们还是你的父母……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233084,
          "spk": "六角 (ロッカク)",
          "ja": "きっと、ヨウさんに祈って欲しがってるから、",
          "tc": "他們一定希望洋妹妹能為他們祈禱，",
          "sc": "他们一定希望洋妹妹能为他们祈祷，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233091,
          "spk": "六角 (ロッカク)",
          "ja": "今日はお二人に、お参りしてあげてほしいっス",
          "tc": "今天就好好為他們祭拜一下吧。",
          "sc": "今天就好好为他们祭拜一下呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8525,
      "rec_id": "TALK_ID_10_0202_051_06_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233121,
          "spk": "堇怜 (スミレ)",
          "ja": "今年も来られて良かったね",
          "tc": "今年也能來掃墓，真是太好了。",
          "sc": "今年也能来扫墓，真是太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233128,
          "spk": "堇怜 (スミレ)",
          "ja": "何も変わらず、二人で……",
          "tc": "我們兩個都沒什麼變，平安無事……",
          "sc": "我们两个都没什么变，平安无事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233148,
          "spk": "莲实 (ハスミ)",
          "ja": "本当にね……",
          "tc": "就是說啊……",
          "sc": "就是说啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8526,
      "rec_id": "TALK_ID_10_0202_051_06_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233166,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが忙しいとか言い出して、",
          "tc": "我本來還很擔心",
          "sc": "我本来还很担心"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233173,
          "spk": "堇怜 (スミレ)",
          "ja": "僕一人で来る羽目になるんじゃないかって",
          "tc": "姊姊會不會說自己很忙，",
          "sc": "姐姐会不会说自己很忙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233180,
          "spk": "堇怜 (スミレ)",
          "ja": "心配したよ",
          "tc": "讓我只能一個人過來這裡呢。",
          "sc": "让我只能一个人过来这里呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8527,
      "rec_id": "TALK_ID_10_0202_051_06_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233198,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふ……そんな理由で来なかったら、",
          "tc": "呵呵……如果因為那種理由沒來，",
          "sc": "呵呵……如果因为那种理由没来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233205,
          "spk": "莲实 (ハスミ)",
          "ja": "父さんと母さんに怒られてしまうわ",
          "tc": "我可是會被爸爸、媽媽罵的。",
          "sc": "我可是会被爸爸、妈妈骂的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233216,
          "spk": "莲实 (ハスミ)",
          "ja": "たまには、私たち姉弟が",
          "tc": "偶爾也得過來",
          "sc": "偶尔也得过来"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233223,
          "spk": "莲实 (ハスミ)",
          "ja": "仲良く過ごしている姿を見せて、",
          "tc": "讓他們看看我們姊弟和睦生活的樣子，",
          "sc": "让他们看看我们姐弟和睦生活的样子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233230,
          "spk": "莲实 (ハスミ)",
          "ja": "二人を喜ばせてあげないとね",
          "tc": "開心一下才行。",
          "sc": "开心一下才行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233243,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、もう少しお参りに来る回数を",
          "tc": "那來我們掃墓的次數",
          "sc": "那来我们扫墓的次数"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233250,
          "spk": "堇怜 (スミレ)",
          "ja": "増やしても良いんじゃないかな？",
          "tc": "再多一點也可以吧？",
          "sc": "再多一点也可以吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233257,
          "spk": "堇怜 (スミレ)",
          "ja": "父さんも母さんも、きっと安心すると思うし",
          "tc": "爸爸、媽媽他們也能比較安心。",
          "sc": "爸爸、妈妈他们也能比较安心。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233270,
          "spk": "莲实 (ハスミ)",
          "ja": "それは、私も嬉しいわ",
          "tc": "我也很樂意喔。",
          "sc": "我也很乐意哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233277,
          "spk": "莲实 (ハスミ)",
          "ja": "時間があればできるだけ、",
          "tc": "只要有空，我們就盡可能",
          "sc": "只要有空，我们就尽可能"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233284,
          "spk": "莲实 (ハスミ)",
          "ja": "二人でお参りに来ましょうね",
          "tc": "一起來掃墓吧。",
          "sc": "一起来扫墓吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8528,
      "rec_id": "TALK_ID_10_0202_051_06_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233314,
          "spk": "堇怜 (スミレ)",
          "ja": "そういえば姉さん、父さんが死んだのって",
          "tc": "姊姊，爸爸過世的時候，",
          "sc": "姐姐，爸爸过世的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233321,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が小さいころだよね？",
          "tc": "我還很小對吧？",
          "sc": "我还很小对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233332,
          "spk": "堇怜 (スミレ)",
          "ja": "父さんが死んだから、",
          "tc": "聽說自從爸爸去世之後，",
          "sc": "听说自从爸爸去世之后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233339,
          "spk": "堇怜 (スミレ)",
          "ja": "母さんは医者をやめたんだって聞いたけど……",
          "tc": "媽媽就不當醫生了……",
          "sc": "妈妈就不当医生了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233357,
          "spk": "堇怜 (スミレ)",
          "ja": "二人とも、どうして急に死んじゃったのか",
          "tc": "差不多可以告訴我",
          "sc": "差不多可以告诉我"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233364,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ僕にも、教えてくれない？",
          "tc": "他們兩個突然去世的原因了吧？",
          "sc": "他们两个突然去世的原因了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8529,
      "rec_id": "TALK_ID_10_0202_051_06_02_02",
      "lines": [
        {
