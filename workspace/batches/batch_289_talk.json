        {
          "f_idx": 0,
          "pidx_tc": 358673,
          "spk": "木助 (キスケ)",
          "ja": "これで、よかったのか？",
          "tc": "這樣真的好嗎？",
          "sc": "这样真的好吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 358684,
          "spk": "木助 (キスケ)",
          "ja": "この木はきっと時間が経てば、",
          "tc": "隨著時間過去，以後這棵樹……",
          "sc": "随着时间过去，以后这棵树……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 358691,
          "spk": "木助 (キスケ)",
          "ja": "穴の底で見たようなモノになるだろう",
          "tc": "應該又會變成在大洞底下看到的東西吧。",
          "sc": "应该又会变成在大洞底下看到的东西吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 358709,
          "spk": "木助 (キスケ)",
          "ja": "そのうち、ここに大きな木陰ができて、",
          "tc": "要不了多久，這裡就會形成一大片樹蔭，",
          "sc": "要不了多久，这里就会形成一大片树荫，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 358716,
          "spk": "木助 (キスケ)",
          "ja": "庭が仄かに暗くなっちまうよ",
          "tc": "庭院會變得有點陰暗喔。",
