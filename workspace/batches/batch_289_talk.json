      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233466,
          "spk": "今野 (コンノ)",
          "ja": "アナタも駆り出されたんですか……",
          "tc": "連您都被叫來了呀。",
          "sc": "连您都被叫来了呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233473,
          "spk": "今野 (コンノ)",
          "ja": "我々には関係ないのに……お互い大変ですねェ",
          "tc": "明明跟我們毫無關係……彼此都辛苦了呢。",
          "sc": "明明跟我们毫无关系……彼此都辛苦呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8532,
      "rec_id": "TALK_ID_10_0202_051_07_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233498,
          "spk": "今野 (コンノ)",
          "ja": "それにしても……",
          "tc": "話說回來……",
          "sc": "话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233505,
          "spk": "今野 (コンノ)",
          "ja": "墓参りの合図が狼煙だなんて、",
          "tc": "掃墓的信號竟然是狼煙，",
          "sc": "扫墓的信号竟然是狼烟，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233512,
          "spk": "今野 (コンノ)",
          "ja": "時代錯誤も甚だしいと思いませんかァ？",
          "tc": "不覺得這實在太不符合時代了嗎？",
          "sc": "不觉得这实在太不符合时代了吗～？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233525,
          "spk": "今野 (コンノ)",
          "ja": "はァ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233532,
          "spk": "今野 (コンノ)",
          "ja": "これだから田舎はキライなんですよねェ……",
          "tc": "就是這樣我才討厭鄉下……",
          "sc": "就是这样我才讨厌乡下……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8533,
      "rec_id": "TALK_ID_10_0202_051_07_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233558,
          "spk": "今野 (コンノ)",
          "ja": "この村の墓地は、初めてですか？",
          "tc": "您是第一次來到村子的墓地嗎？",
          "sc": "您是第一次来到村子的墓地吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233578,
          "spk": "今野 (コンノ)",
          "ja": "ふふふ、村の規模に比べて墓が多すぎる……",
          "tc": "呵呵呵，以村子的規模來說，墳墓實在太多了……",
          "sc": "呵呵呵，以村子的规模来说，坟墓实在太多了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233585,
          "spk": "今野 (コンノ)",
          "ja": "気味の悪い場所でしょう？",
          "tc": "讓人感覺氣氛詭異，是吧？",
          "sc": "让人感觉气氛诡异，是吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8534,
      "rec_id": "TALK_ID_10_0202_051_07_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233610,
          "spk": "今野 (コンノ)",
          "ja": "それでもリンさんにとっては、",
          "tc": "即使如此，對林小姐來說，",
          "sc": "即使如此，对林小姐来说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233617,
          "spk": "今野 (コンノ)",
          "ja": "村の歴史を感じる大切な場所なんですって",
          "tc": "這裡是能感受到村子歷史的重要場所。",
          "sc": "这里是能感受到村子历史的重要场所。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233624,
          "spk": "今野 (コンノ)",
          "ja": "本当に、愚かな娘ですよねェ",
          "tc": "實在是個愚蠢的姑娘呢。",
          "sc": "实在是个愚蠢的姑娘呐～。"
        }
      ]
    }
