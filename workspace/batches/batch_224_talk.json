      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337335,
          "spk": "林 (リン)",
          "ja": "あなた、誰？",
          "tc": "你是誰？",
          "sc": "你是谁？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337346,
          "spk": "木珠 (コダマ)",
          "ja": "<player>だよ",
          "tc": "我是<player>啊。",
          "sc": "我是<player>啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 337359,
          "spk": "林 (リン)",
          "ja": "この祠は、<player>が",
          "tc": "這個祠堂是<player>",
          "sc": "这个祠堂是<player>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337366,
          "spk": "林 (リン)",
          "ja": "村の人々のために直したものよ？",
          "tc": "為了村民們修好的耶。",
          "sc": "为了村民们修好的呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 337373,
          "spk": "林 (リン)",
          "ja": "壊すハズがない",
          "tc": "怎麼可能會破壞它。",
          "sc": "怎么可能会破坏它。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 337384,
          "spk": "木珠 (コダマ)",
          "ja": "気に入らなかったの",
          "tc": "我覺得不滿意。",
          "sc": "我觉得不满意。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 337391,
          "spk": "木珠 (コダマ)",
          "ja": "だから、作り直すから……",
          "tc": "所以，要重新打造……",
          "sc": "所以，要重新打造……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5807,
      "rec_id": "TALK_ID_10_0601_007_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337409,
          "spk": "林 (リン)",
          "ja": "気に入らなかった？",
          "tc": "不滿意？",
          "sc": "不满意？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337416,
          "spk": "林 (リン)",
          "ja": "そんなこと初めて聞いたわ",
          "tc": "這我還是第一次聽說呢。",
          "sc": "这我还是第一次听说呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337434,
          "spk": "林 (リン)",
          "ja": "今までずっと、",
          "tc": "你明明一直以來",
          "sc": "你明明一直以来"
        },
        {
          "f_idx": 4,
          "pidx_tc": 337441,
          "spk": "林 (リン)",
          "ja": "黙々と直し続けていたのに？",
          "tc": "都一直默默在修復它耶！",
          "sc": "都一直默默在修复它呢！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 337452,
          "spk": "林 (リン)",
          "ja": "あれだけ手をかけて、立派にしたのに",
          "tc": "你花了那麼多心力，修建得這麼氣派。",
          "sc": "你花了那么多心力，修建得这么气派。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 337459,
          "spk": "林 (リン)",
          "ja": "村の人のためだって、そう言ってたのに",
          "tc": "也說過是為了村民而做的。",
          "sc": "也说过是为了村民而做的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 337466,
          "spk": "林 (リン)",
          "ja": "それを自分の手で壊すなんて……",
          "tc": "結果現在居然親手破壞祠堂……",
          "sc": "结果现在居然亲手破坏祠堂……"
        }
      ]
    },
