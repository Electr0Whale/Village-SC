      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337753,
          "spk": "林 (リン)",
          "ja": "なるほど、",
          "tc": "原來如此，",
          "sc": "原来如此，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337760,
          "spk": "林 (リン)",
          "ja": "人の体を操るのがあなたの能力なのね",
          "tc": "祢的能力是操控別人的身體呢。",
          "sc": "你的能力是操控别人的身体呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337778,
          "spk": "林 (リン)",
          "ja": "ああ、もしかしてトバリを操って、",
          "tc": "啊，難不成之前操控帷，",
          "sc": "啊，难不成之前操控帷，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 337785,
          "spk": "林 (リン)",
          "ja": "私やヅ主を刺したのはあなただったの？",
