    },
    {
      "file": "talk.dat",
      "rec_idx": 8084,
      "rec_id": "TALK_ID_10_0102_030_01_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209172,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、ここは村唯一の雑貨店だよ",
          "tc": "<player>，這裡是村中唯一的雜貨店喔。",
          "sc": "<player>，这里是村中唯一的杂货店哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209179,
          "spk": "裕太 (ユータ)",
          "ja": "何から何まで揃えられるから、",
          "tc": "各種商品應有盡有，",
          "sc": "各种商品应有尽有，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209186,
          "spk": "裕太 (ユータ)",
          "ja": "キミも欲しいものがあればここで探すといいよ",
          "tc": "如果你有想要的東西，都可以來這裡找找。",
          "sc": "如果你有想要的东西，都可以来这里找找。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8085,
      "rec_id": "TALK_ID_10_0102_030_01_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209222,
          "spk": "裕太 (ユータ)",
          "ja": "今日は……種を10種類と、フライパン3種類",
          "tc": "今天要買……十種作物的種子、三種平底鍋，",
          "sc": "今天要买……十种作物的种子、三种平底锅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209229,
          "spk": "裕太 (ユータ)",
          "ja": "それからキャンプのセットと……",
          "tc": "還有露營用具組……",
          "sc": "还有露营用具组……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209236,
          "spk": "裕太 (ユータ)",
          "ja": "あ、あと新しいジョウロも必要だし……",
          "tc": "啊，還需要新的澆水壺……",
          "sc": "啊，还需要新的浇水壶……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 209249,
          "spk": "茶梅 (サザンカ)",
          "ja": "毎度あり……",
          "tc": "謝謝惠顧……",
          "sc": "谢谢惠顾……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 209256,
          "spk": "茶梅 (サザンカ)",
          "ja": "ってか相変わらず忙しないね",
          "tc": "話說你還是一樣很忙的樣子啊。",
          "sc": "话说你还是一样很忙的样子啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 209265,
          "spk": "茶梅 (サザンカ)",
          "ja": "よくそんなに買うモノ、覚えてられるわ",
          "tc": "居然能記得那麼多要買的東西。",
          "sc": "居然能记得那么多要买的东西。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 209285,
          "spk": "裕太 (ユータ)",
          "ja": "覚えてないよ",
          "tc": "我記不住啦。",
          "sc": "我记不住啦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 209292,
          "spk": "裕太 (ユータ)",
          "ja": "でもやりたいことをメモしてたら、",
          "tc": "只是把想做的事記下來，",
          "sc": "只是把想做的事记下来，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 209299,
          "spk": "裕太 (ユータ)",
          "ja": "欲しい物も増えちゃってね……",
          "tc": "想要的東西就變得越來越多了……",
          "sc": "想要的东西就变得越来越多了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8086,
      "rec_id": "TALK_ID_10_0102_030_01_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209319,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>も欲しいものや、",
          "tc": "啊，如果<player>你也有想要的東西",
          "sc": "啊，如果<player>你也有想要的东西"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209326,
          "spk": "裕太 (ユータ)",
          "ja": "やりたいことがあるなら、",
          "tc": "或想要做的事，",
          "sc": "或想要做的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209333,
          "spk": "裕太 (ユータ)",
          "ja": "忘れないようにメモしたら？",
          "tc": "也可以記下來以免忘記喔。",
          "sc": "也可以记下来以免忘记哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 209344,
          "spk": "裕太 (ユータ)",
          "ja": "俺の鉛筆とメモ帳、分けてあげるよ",
          "tc": "我把鉛筆與筆記本分給你吧。",
          "sc": "我把铅笔与笔记本分给你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8087,
      "rec_id": "TALK_ID_10_0102_030_01_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209372,
          "spk": "裕太 (ユータ)",
          "ja": "お店とかで欲しいものがあったら、",
          "tc": "如果在店裡之類的看到想要的東西，",
          "sc": "如果在店里之类的看到想要的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209379,
          "spk": "裕太 (ユータ)",
