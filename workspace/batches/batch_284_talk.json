        {
          "f_idx": 3,
          "pidx_tc": 206658,
          "spk": "林 (リン)",
          "ja": "使ってちょうだい",
          "tc": "你要好好使用。",
          "sc": "你要好好使用。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8062,
      "rec_id": "TALK_ID_10_0101_020_04_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206682,
          "spk": "林 (リン)",
          "ja": "<strong>設計図</strong>があれば、",
          "tc": "只要有<strong>設計圖</strong>，",
          "sc": "只要有<strong>设计图</strong>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 206689,
          "spk": "林 (リン)",
          "ja": "あなたでも作業台で",
          "tc": "即使是你，",
          "sc": "即使是你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 206696,
          "spk": "林 (リン)",
          "ja": "DIYができるでしょう",
          "tc": "也能用工作台自製吧。",
          "sc": "也能用工作台自制吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 206705,
          "spk": "林 (リン)",
          "ja": "素材が足りなければ、",
          "tc": "要是材料不夠，",
          "sc": "要是材料不够，"
        },
        {
