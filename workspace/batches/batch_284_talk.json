          "pidx_tc": 206564,
          "spk": "林 (リン)",
          "ja": "役立つものを作ることができるの",
          "tc": "就可以加工材料，做出有用的東西。",
          "sc": "就可以加工材料，做出有用的东西。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 206575,
          "spk": "林 (リン)",
          "ja": "よかったわね、<player>！",
          "tc": "很棒吧，<player>！",
          "sc": "很棒吧，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 206582,
          "spk": "林 (リン)",
          "ja": "これでますます仕事が捗るわ！",
          "tc": "這樣工作起來就能更順利了！",
          "sc": "这样工作起来就能更顺利了！"
        },
