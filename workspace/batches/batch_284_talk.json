          "f_idx": 2,
          "pidx_tc": 207256,
          "spk": "林 (リン)",
          "ja": "さあ、しっかり収穫してあげて",
          "tc": "好了，快去採收它們吧。",
          "sc": "好了，快去采收它们吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8070,
      "rec_id": "TALK_ID_10_0101_021_05_03",
      "lines": [
        {
