      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206351,
          "spk": "林 (リン)",
          "ja": "ちゃんと働いたらご褒美をあげるわよ、",
          "tc": "只要好好工作，我就會給你獎勵。",
          "sc": "只要好好工作，我就会给你奖励。"
