    },
    {
      "file": "talk.dat",
      "rec_idx": 8081,
      "rec_id": "TALK_ID_10_0102_030_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208893,
          "spk": "裕太 (ユータ)",
          "ja": "おや、<player>も一緒だったんだね",
          "tc": "喔？<player>也跟妳在一起啊？",
          "sc": "喔？<player>也跟你在一起啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208900,
          "spk": "裕太 (ユータ)",
          "ja": "キミも雑貨店で買い物かい？",
          "tc": "你也要在雜貨店買東西嗎？",
          "sc": "你也要在杂货店买东西吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208913,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>に、営業かけに行ってたんだよ",
          "tc": "我剛剛去跟<player>推銷。",
          "sc": "我刚刚去跟<player>推销。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208920,
          "spk": "茶梅 (サザンカ)",
          "ja": "ついでに買い物させてやろうと思って、",
          "tc": "順便就把他帶來我店裡",
          "sc": "顺便就把他带来我店里"
