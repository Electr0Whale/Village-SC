        {
          "f_idx": 0,
          "pidx_tc": 206302,
          "spk": "林 (リン)",
          "ja": "おはよう<player>、",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
