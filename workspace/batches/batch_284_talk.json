    {
      "file": "talk.dat",
      "rec_idx": 8057,
      "rec_id": "TALK_ID_10_0101_020_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206472,
          "spk": "林 (リン)",
