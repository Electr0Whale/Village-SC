        {
          "f_idx": 2,
          "pidx_tc": 207216,
          "spk": "林 (リン)",
          "ja": "あなたが頑張ったからね！",
          "tc": "都是因為你有好好努力！",
          "sc": "都是因为你有好好努力！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8069,
      "rec_id": "TALK_ID_10_0101_021_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207242,
          "spk": "林 (リン)",
          "ja": "抜くのをためらうのもわかるけど、",
          "tc": "我明白你捨不得拔出它們的心情，",
          "sc": "我明白你舍不得拔出它们的心情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 207249,
          "spk": "林 (リン)",
          "ja": "土の中のままじゃ宝の持ち腐れよ？",
          "tc": "但讓它們一直待在土裡也是暴殄天物。",
          "sc": "但让它们一直待在土里也是暴殄天物。"
        },
