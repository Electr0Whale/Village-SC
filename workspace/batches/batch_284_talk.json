          "ja": "ちょっと待ってなさい",
          "tc": "你先等我一下吧。",
          "sc": "你先等我一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8073,
      "rec_id": "TALK_ID_10_0101_021_14_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207880,
          "spk": "林 (リン)",
          "ja": "待たせたわね！",
          "tc": "讓你久等了！",
          "sc": "让你久等了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8074,
      "rec_id": "TALK_ID_10_0101_021_14_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207900,
          "spk": "木助 (キスケ)",
          "ja": "リン……",
          "tc": "林……",
          "sc": "林……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 207907,
          "spk": "木助 (キスケ)",
          "ja": "まさかそのヤギ……",
          "tc": "難道那山羊……",
          "sc": "难道那山羊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 207920,
          "spk": "林 (リン)",
          "ja": "去年の、祭りの後の奉納がまだでしょう？",
          "tc": "去年祭典之後還沒進行奉納儀式吧？",
          "sc": "去年祭典之后还没进行奉纳仪式吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 207927,
          "spk": "林 (リン)",
          "ja": "今年も平穏を、",
          "tc": "今年也一樣",
          "sc": "今年也一样"
        },
        {
          "f_idx": 4,
          "pidx_tc": 207934,
          "spk": "林 (リン)",
          "ja": "祈らなくてはいけないからね",
          "tc": "得祈求平安才行。",
          "sc": "得祈求平安才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8075,
      "rec_id": "TALK_ID_10_0101_021_14_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207952,
          "spk": "木助 (キスケ)",
          "ja": "<player>、てめぇは目を閉じてな",
          "tc": "<player>，你把眼睛閉上吧。",
          "sc": "<player>，你把眼睛闭上吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8076,
      "rec_id": "TALK_ID_10_0101_021_14_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 207970,
          "spk": "林 (リン)",
          "ja": "はぁ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 207977,
          "spk": "林 (リン)",
          "ja": "これから<player>のためにも",
          "tc": "接下來不也是要為<player>",
          "sc": "接下来不也是要为<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 207984,
          "spk": "林 (リン)",
          "ja": "祈ろうとしているのに？",
          "tc": "獻上祈禱嗎？",
          "sc": "献上祈祷吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 207997,
          "spk": "木助 (キスケ)",
          "ja": "いいんだよ",
          "tc": "沒事的。",
          "sc": "没事的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208004,
          "spk": "木助 (キスケ)",
          "ja": "ほら、<player>、",
          "tc": "好了，<player>，",
          "sc": "好了，<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 208011,
          "spk": "木助 (キスケ)",
          "ja": "早く背を向けて目を閉じろ",
          "tc": "快轉過身去，閉上眼睛。",
          "sc": "快转过身去，闭上眼睛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8077,
      "rec_id": "TALK_ID_10_0101_021_14_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208037,
          "spk": "林 (リン)",
          "ja": "畏み、畏み、申します……",
          "tc": "誠惶誠恐，至誠奉告……",
          "sc": "诚惶诚恐，至诚奉告……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208046,
          "spk": "林 (リン)",
          "ja": "此の供物の数々、",
          "tc": "謹此將諸多供品，",
          "sc": "谨此将诸多供品，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208053,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉りまつる",
          "tc": "悉數虔誠供奉予祢。",
          "sc": "悉数虔诚供奉予你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208062,
          "spk": "林 (リン)",
          "ja": "去年も、この地に我らを住まわせ給いしこと、",
          "tc": "無比感謝祢去年也",
          "sc": "无比感谢你去年也"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208069,
          "spk": "林 (リン)",
          "ja": "まことに厚く御礼申し上げ奉りまつる",
          "tc": "賜予我們棲身之地，",
          "sc": "赐予我们栖身之地，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 208085,
          "spk": "林 (リン)",
          "ja": "さらに願わくば、ここに在る一人の子どもを、",
          "tc": "另祈求祢能開恩，",
          "sc": "另祈求你能开恩，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 208092,
          "spk": "林 (リン)",
          "ja": "この村に住まうこと、御許し賜りますよう、",
          "tc": "恩准此孩童安居村裡，",
          "sc": "恩准此孩童安居村里，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 208099,
          "spk": "林 (リン)",
          "ja": "慎み敬いて、祈り奉りまつる",
          "tc": "在此謹以至誠，獻上祈求。",
          "sc": "在此谨以至诚，献上祈求。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8078,
      "rec_id": "TALK_ID_10_0101_021_14_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208186,
          "spk": "林 (リン)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208195,
          "spk": "林 (リン)",
          "ja": "あなたも、もう彼ヶ津村の一員なのだから、",
          "tc": "你以後就是彼津村的一員了，",
          "sc": "你以后就是彼津村的一员了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208202,
          "spk": "林 (リン)",
          "ja": "この村の秘密を教えてあげるわ",
          "tc": "我就把這個村子的祕密告訴你吧。",
          "sc": "我就把这个村子的秘密告诉你吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8079,
      "rec_id": "TALK_ID_10_0101_021_14_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 208227,
          "spk": "林 (リン)",
          "ja": "<strong>「彼ヶ津村の神さまは捧げ物をすると、",
          "tc": "<strong>「將祭品獻給彼津村的神明大人，",
          "sc": "<strong>“将祭品献给彼津村的神明大人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 208234,
          "spk": "林 (リン)",
          "ja": "それに釣り合う願いを叶えてくれる」</strong>",
          "tc": "祂就會幫你實現與之相應的願望。」</strong>",
          "sc": "祂就会帮你实现与之相应的愿望。”</strong>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 208245,
          "spk": "林 (リン)",
          "ja": "覚えておきなさい……",
          "tc": "你要記住……",
          "sc": "你要记住……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 208252,
          "spk": "林 (リン)",
          "ja": "<strong>この彼ヶ津村で願いを叶えようとするなら、",
          "tc": "<strong>在這彼津村中，如果想要實現願望，",
          "sc": "<strong>在这彼津村中，如果想要实现愿望，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 208259,
          "spk": "林 (リン)",
          "ja": "対価を支払わなければならないことを</strong>",
          "tc": "你就必須付出與之相應的代價。</strong>",
          "sc": "你就必须付出与之相应的代价。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8080,
