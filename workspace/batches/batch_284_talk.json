          "tc": "那麼，我就先走了……",
          "sc": "那么，我就先走了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8060,
      "rec_id": "TALK_ID_10_0101_020_04_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206617,
          "spk": "林 (リン)",
          "ja": "ああっ！　忘れてた！",
