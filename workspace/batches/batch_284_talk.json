  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8034,
      "rec_id": "TALK_ID_10_0101_016_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204149,
          "spk": "木助 (キスケ)",
          "ja": "……なんだよ",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204156,
          "spk": "木助 (キスケ)",
          "ja": "なんか不安なのか？",
          "tc": "有什麼放心不下的事嗎？",
          "sc": "有什么放心不下的事吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204167,
          "spk": "木助 (キスケ)",
          "ja": "さっき渡した種を持って、",
          "tc": "把我剛才給你的種子",
          "sc": "把我刚才给你的种子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204174,
          "spk": "木助 (キスケ)",
          "ja": "畑の前で撒くんだ",
          "tc": "播種到田地裡吧。",
          "sc": "播种到田地里吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204185,
          "spk": "木助 (キスケ)",
          "ja": "簡単な仕事だろ？",
          "tc": "這工作很簡單吧？",
          "sc": "这工作很简单吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 204192,
          "spk": "木助 (キスケ)",
          "ja": "丁寧にやれよ",
          "tc": "好好做喔。",
          "sc": "好好做啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8035,
      "rec_id": "TALK_ID_10_0101_017_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204216,
          "spk": "木助 (キスケ)",
          "ja": "植物が育つために、",
          "tc": "你應該知道",
          "sc": "你应该知道"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204223,
          "spk": "木助 (キスケ)",
          "ja": "何が必要かわかるだろ？",
          "tc": "培育植物需要什麼吧？",
          "sc": "培育植物需要什么吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8036,
      "rec_id": "TALK_ID_10_0101_017_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204247,
          "spk": "木助 (キスケ)",
          "ja": "そのジョウロが対価だ",
          "tc": "那個澆水壺就是報酬。",
          "sc": "那个浇水壶就是报酬。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204254,
          "spk": "木助 (キスケ)",
          "ja": "<strong>次は水を汲んできて、",
          "tc": "<strong>接著是去汲水，",
          "sc": "<strong>接着是去汲水，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204261,
          "spk": "木助 (キスケ)",
          "ja": "さっき植えた種に撒くんだ</strong>",
          "tc": "並澆在剛剛種下的種子上。</strong>",
          "sc": "并浇在刚刚种下的种子上。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8037,
      "rec_id": "TALK_ID_10_0101_017_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204285,
          "spk": "木助 (キスケ)",
          "ja": "その家の裏に、水が湧いてる",
          "tc": "那房子的後面有水池，",
          "sc": "那房子的后面有水池，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204292,
          "spk": "木助 (キスケ)",
          "ja": "まずは、そこでジョウロに水を入れてこい",
          "tc": "首先，你去那邊用澆水壺汲水回來。",
          "sc": "首先，你去那边用浇水壶汲水回来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8038,
      "rec_id": "TALK_ID_10_0101_017_10_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204316,
          "spk": "木助 (キスケ)",
          "ja": "まずはジョウロに水を汲まねえとな",
          "tc": "首先，得用澆水壺汲水喔。",
          "sc": "首先，得用浇水壶汲水啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204325,
          "spk": "木助 (キスケ)",
          "ja": "その家の裏に、水が湧いてる池があるぜ",
          "tc": "那房子的後面有個會湧出水的水池。",
          "sc": "那房子的后面有个会涌出水的水池。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204332,
          "spk": "木助 (キスケ)",
          "ja": "そこでジョウロを使って、水を汲んでこい",
          "tc": "你要在那邊用澆水壺汲水回來，",
          "sc": "你要在那边用浇水壶汲水回来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204343,
          "spk": "木助 (キスケ)",
          "ja": "種に水を撒くのはその後だ",
          "tc": "才能把水澆稻種子上。",
          "sc": "才能把水浇稻种子上。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204350,
          "spk": "木助 (キスケ)",
          "ja": "よろしく頼んだぜ",
          "tc": "麻煩你啦。",
          "sc": "麻烦你啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8039,
      "rec_id": "TALK_ID_10_0101_017_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204374,
          "spk": "木助 (キスケ)",
          "ja": "……いちいち俺の顔色を",
          "tc": "……你可以不用",
          "sc": "……你可以不用"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204381,
          "spk": "木助 (キスケ)",
          "ja": "うかがわなくていいだろうが",
          "tc": "什麼事情都看我臉色。",
          "sc": "什么事情都看我脸色。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204392,
          "spk": "木助 (キスケ)",
          "ja": "種を撒いた畑に、",
          "tc": "田地裡已經播種了，",
          "sc": "田地里已经播种了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 204399,
          "spk": "木助 (キスケ)",
          "ja": "ジョウロの水をかけるんだよ",
          "tc": "再來就是用澆水壺澆水。",
          "sc": "再来就是用浇水壶浇水。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 204406,
          "spk": "木助 (キスケ)",
          "ja": "さっさとやってこい",
          "tc": "快點行動。",
          "sc": "快点行动。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8040,
      "rec_id": "TALK_ID_10_0101_018_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204999,
          "spk": "木助 (キスケ)",
          "ja": "出荷台を作ってんだよ",
          "tc": "我正在做出貨台，",
          "sc": "我正在做出货台，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205006,
          "spk": "木助 (キスケ)",
          "ja": "今日中には、出来上がるぜ",
          "tc": "今天之內就能做好。",
          "sc": "今天之内就能做好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205013,
          "spk": "木助 (キスケ)",
          "ja": "完成を楽しみにしとけよな",
          "tc": "你就期待完工吧。",
          "sc": "你就期待完工吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8041,
      "rec_id": "TALK_ID_10_0101_018_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205039,
          "spk": "木助 (キスケ)",
          "ja": "あんまりチョロチョロしてると、",
          "tc": "老是四處閒晃的話，",
          "sc": "老是四处闲晃的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205046,
          "spk": "木助 (キスケ)",
          "ja": "てめぇを釘と間違えて",
          "tc": "我說不定會不小心把你當成釘子，",
          "sc": "我说不定会不小心把你当成钉子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205053,
          "spk": "木助 (キスケ)",
          "ja": "ぶったたいちまうかもしれねえよ",
          "tc": "狠狠敲一頓喔。",
          "sc": "狠狠敲一顿啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8042,
      "rec_id": "TALK_ID_10_0101_018_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205073,
          "spk": "主角心声/旁白/选项",
          "ja": "この野菜を大切にしなくては……",
          "tc": "必須用心照料這些蔬菜……",
          "sc": "必须用心照料这些蔬菜……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8043,
      "rec_id": "TALK_ID_10_0101_019_22_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205873,
          "spk": "林 (リン)",
          "ja": "ありがとう！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205880,
          "spk": "林 (リン)",
          "ja": "協力に感謝するわ！",
          "tc": "謝謝你願意配合！",
          "sc": "谢谢你愿意配合！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8044,
      "rec_id": "TALK_ID_10_0101_019_22_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205902,
          "spk": "林 (リン)",
          "ja": "……あら、なにか不都合でもあるの？",
          "tc": "……哎呀，難道有什麼不方便的嗎？",
          "sc": "……哎呀，难道有什么不方便的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205909,
          "spk": "林 (リン)",
          "ja": "あなたは契約書にサインしたのに、",
          "tc": "你都簽好契約書了，",
          "sc": "你都签好契约书了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205916,
          "spk": "林 (リン)",
          "ja": "守れない理由を聞いてみたいわね",
          "tc": "我倒是想知道你為什麼不能遵守。",
          "sc": "我倒是想知道你为什么不能遵守。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205927,
          "spk": "林 (リン)",
          "ja": "そうね……もし規則を破ったら、",
          "tc": "嗯……要是你沒有守規矩的話，",
          "sc": "嗯……要是你没有守规矩的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205934,
          "spk": "林 (リン)",
          "ja": "その時は……どうしようかしら",
          "tc": "到時候……該怎麼辦才好呢？",
          "sc": "到时候……该怎么办才好呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8046,
      "rec_id": "TALK_ID_10_0101_019_22_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205959,
          "spk": "木助 (キスケ)",
          "ja": "リン、そんなに心配しなくていいだろ",
          "tc": "林，不需要那麼擔心吧。",
          "sc": "林，不需要那么担心吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205966,
          "spk": "木助 (キスケ)",
          "ja": "こいつは必ず、守ってくれるだろうよ",
          "tc": "這傢伙肯定會遵守的啦。",
          "sc": "这家伙肯定会遵守的啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
