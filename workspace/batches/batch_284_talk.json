      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206055,
          "spk": "木助 (キスケ)",
          "ja": "俺は大工だからよ、",
          "tc": "我可是個木匠。",
          "sc": "我可是个木匠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 206062,
          "spk": "木助 (キスケ)",
          "ja": "人にモノを頼むときには先払いするのが",
          "tc": "拜託人家做事時，",
          "sc": "拜托人家做事时，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 206069,
          "spk": "木助 (キスケ)",
          "ja": "仕事柄の習慣なんだよ",
          "tc": "業界慣例就是先付報酬。",
          "sc": "业界惯例就是先付报酬。"
        }
      ]
    },
    {
