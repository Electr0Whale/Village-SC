      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206010,
          "spk": "木助 (キスケ)",
          "ja": "リンが、ここまで願ってるんだ",
          "tc": "林都這樣拜託你了，",
          "sc": "林都这样拜托你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 206017,
          "spk": "木助 (キスケ)",
          "ja": "あの紙の規則を破るなよ",
          "tc": "可別打破那些紙上的規則啊。",
          "sc": "可别打破那些纸上的规则啊。"
        }
      ]
    },
    {
