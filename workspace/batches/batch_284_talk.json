    },
    {
      "file": "talk.dat",
      "rec_idx": 8058,
      "rec_id": "TALK_ID_10_0101_020_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206526,
          "spk": "林 (リン)",
          "ja": "よろしい！",
