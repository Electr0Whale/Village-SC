        {
          "f_idx": 1,
          "pidx_tc": 206358,
          "spk": "林 (リン)",
          "ja": "あなたのために用意しておいた、",
          "tc": "我可是為了你準備好",
          "sc": "我可是为了你准备好"
        },
        {
          "f_idx": 2,
          "pidx_tc": 206365,
          "spk": "林 (リン)",
          "ja": "特別なものをね",
