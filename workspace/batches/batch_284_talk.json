    },
    {
      "file": "talk.dat",
      "rec_idx": 8061,
      "rec_id": "TALK_ID_10_0101_020_04_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206635,
          "spk": "林 (リン)",
          "ja": "作業台を渡しても、",
          "tc": "即使把工作台給你，",
          "sc": "即使把工作台给你，"
        },
        {
