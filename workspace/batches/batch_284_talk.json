          "f_idx": 4,
          "pidx_tc": 207310,
          "spk": "林 (リン)",
          "ja": "さっさと作物を収穫しなさい！",
          "tc": "趕快把作物採收起來！",
          "sc": "赶快把作物采收起来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8071,
      "rec_id": "TALK_ID_10_0101_021_14_01",
      "lines": [
        {
