        {
          "f_idx": 4,
          "pidx_tc": 208927,
          "spk": "茶梅 (サザンカ)",
          "ja": "連れてきたんだ",
          "tc": "買東西。",
          "sc": "买东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8082,
      "rec_id": "TALK_ID_10_0102_030_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209099,
          "spk": "裕太 (ユータ)",
          "ja": "キミもそのお金で、",
          "tc": "你也可以用這些錢",
          "sc": "你也可以用这些钱"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209106,
          "spk": "裕太 (ユータ)",
          "ja": "お買い物してみてごらん",
          "tc": "買些東西看看。",
          "sc": "买些东西看看。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209119,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、二人とも、入って入って",
          "tc": "那麼兩位快請進吧。",
