        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8059,
      "rec_id": "TALK_ID_10_0101_020_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206557,
          "spk": "林 (リン)",
          "ja": "これがあれば、素材を加工して",
