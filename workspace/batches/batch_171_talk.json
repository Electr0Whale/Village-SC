  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3480,
      "rec_id": "TALK_ID_60_0013_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194432,
          "spk": "？？？ (未知角色)",
          "ja": "おう……ん？",
          "tc": "哦……嗯？",
          "sc": "哦……嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194441,
          "spk": "？？？ (未知角色)",
          "ja": "見かけん顔じゃの、小童",
          "tc": "我沒見過你耶，小傢伙。",
          "sc": "我没见过你呢，小家伙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194448,
          "spk": "？？？ (未知角色)",
          "ja": "近ごろ村に住み始めたモンか？",
          "tc": "你是最近才搬來村子裡的嗎？",
          "sc": "你是最近才搬来村子里的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 194457,
          "spk": "？？？ (未知角色)",
          "ja": "……ああ、驚かんでもええ",
          "tc": "……啊，別那麼驚訝。",
          "sc": "……啊，别那么惊讶。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 194464,
          "spk": "？？？ (未知角色)",
          "ja": "オラは見ての通り河童じゃけんど、",
          "tc": "如你所見，我是個河童，",
          "sc": "如你所见，我是个河童，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 194471,
          "spk": "？？？ (未知角色)",
          "ja": "悪さはせんで安心しな",
          "tc": "但我不會幹壞事的，放心吧。",
          "sc": "但我不会干坏事的，放心吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 194480,
          "spk": "？？？ (未知角色)",
          "ja": "名乗るほどのモンでもねぇが、",
          "tc": "我只是個無名小卒，",
          "sc": "我只是个无名小卒，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 194487,
          "spk": "？？？ (未知角色)",
          "ja": "昔っからこの川んとこにすんどるんじゃ",
          "tc": "不過我從很久以前就住在這條河邊了。",
          "sc": "不过我从很久以前就住在这条河边了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 194503,
          "spk": "？？？ (未知角色)",
          "ja": "んでな、せっかくこうして会ったんじゃ",
          "tc": "那麼，既然都難得遇到了，",
          "sc": "那么，既然都难得遇到了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 194510,
          "spk": "？？？ (未知角色)",
          "ja": "いきなりで悪いが、",
          "tc": "雖然有點突然，",
          "sc": "虽然有点突然，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 194517,
          "spk": "？？？ (未知角色)",
          "ja": "ひとつ頼みを聞いてくれんか？",
          "tc": "抱歉，能拜託你一件事嗎？",
          "sc": "抱歉，能拜托你一件事吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 194526,
          "spk": "？？？ (未知角色)",
          "ja": "オラには、遠くの沼で働いとる",
          "tc": "我有五個兒子，",
          "sc": "我有五个儿子，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 194533,
          "spk": "？？？ (未知角色)",
          "ja": "５匹の息子たちがおってな",
          "tc": "他們在遠方的沼澤工作。",
          "sc": "他们在远方的沼泽工作。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 194542,
          "spk": "？？？ (未知角色)",
          "ja": "まだ若くて、飯が足らん、",
          "tc": "都還很年輕，總是吃不飽，",
          "sc": "都还很年轻，总是吃不饱，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 194549,
          "spk": "？？？ (未知角色)",
          "ja": "キュウリが恋しいっちゅうて",
          "tc": "好像還哭著說",
          "sc": "好像还哭着说"
        },
        {
          "f_idx": 16,
          "pidx_tc": 194556,
          "spk": "？？？ (未知角色)",
          "ja": "泣いとるらしいんじゃわ",
          "tc": "很想吃小黃瓜呢。",
          "sc": "很想吃黄瓜呢。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 194565,
          "spk": "？？？ (未知角色)",
          "ja": "ほら、オラたち河童は、",
          "tc": "你也知道，我們河童要是沒有小黃瓜，",
          "sc": "你也知道，我们河童要是没有黄瓜，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 194572,
          "spk": "？？？ (未知角色)",
          "ja": "キュウリがないと元気が出んげな",
          "tc": "就會提不起勁。",
          "sc": "就会提不起劲。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 194581,
          "spk": "？？？ (未知角色)",
          "ja": "それでじゃ、おめぇさん、",
          "tc": "所以啊，",
          "sc": "所以啊，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 194588,
          "spk": "？？？ (未知角色)",
          "ja": "もし畑をいじっとるなら",
          "tc": "如果你有在種田的話，",
          "sc": "如果你有在种田的话，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 194595,
          "spk": "？？？ (未知角色)",
          "ja": "キュウリを３０本くらい、分けてくれんかの？",
          "tc": "能分我30根小黃瓜嗎？",
          "sc": "能分我30根黄瓜吗？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 194604,
          "spk": "？？？ (未知角色)",
          "ja": "なに、３０本もすぐじゃろ",
          "tc": "也沒多少，30根很快啦。",
          "sc": "也没多少，30根很快啦。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 194611,
          "spk": "？？？ (未知角色)",
          "ja": "毎日ちょこちょこ育てときゃ、あっという間じゃ",
          "tc": "只要每天慢慢種，一下子就有了。",
          "sc": "只要每天慢慢种，一下子就有了。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 194627,
          "spk": "？？？ (未知角色)",
          "ja": "もちろん、ただとは言わん",
          "tc": "當然，我不會白拿你的東西。",
          "sc": "当然，我不会白拿你的东西。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 194634,
          "spk": "？？？ (未知角色)",
          "ja": "河童は義理堅いから安心せい",
          "tc": "河童最講道義了，放心吧。",
          "sc": "河童最讲道义了，放心吧。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 194650,
          "spk": "？？？ (未知角色)",
          "ja": "オラも年じゃで、頼れるのは",
          "tc": "我也一把年紀了，",
          "sc": "我也一把年纪了，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 194657,
          "spk": "？？？ (未知角色)",
          "ja": "今どきの若いもんくらいなんじゃ",
          "tc": "只能拜託你這樣的時下年輕人。",
          "sc": "只能拜托你这样的时下年轻人。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 194673,
          "spk": "？？？ (未知角色)",
          "ja": "どうじゃ？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 32,
          "pidx_tc": 194680,
          "spk": "？？？ (未知角色)",
          "ja": "ひとつ手ぇ貸してくれんかの、小童や",
          "tc": "你願意幫我一把嗎？小傢伙。",
          "sc": "你愿意帮我一把吗？小家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3481,
      "rec_id": "TALK_ID_60_0013_002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194696,
          "spk": "？？？ (未知角色)",
          "ja": "おう……小童か",
          "tc": "哦……是小傢伙啊。",
          "sc": "哦……是小家伙啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194703,
          "spk": "？？？ (未知角色)",
          "ja": "どうじゃ？　キュウリは持ってこれそうか？",
          "tc": "怎麼樣？有辦法帶小黃瓜過來嗎？",
          "sc": "怎么样？有办法带黄瓜过来吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194712,
          "spk": "？？？ (未知角色)",
          "ja": "オラのかわいい息子たちが",
          "tc": "我那幾個可愛的兒子",
          "sc": "我那几个可爱的儿子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 194719,
          "spk": "？？？ (未知角色)",
          "ja": "腹をすかせておっての",
          "tc": "還餓著肚子呢。",
          "sc": "还饿着肚子呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 194735,
          "spk": "？？？ (未知角色)",
          "ja": "人助けだと思って、頼まれてはくれんか？",
          "tc": "就當作是積陰德，可以幫我這個忙嗎？",
          "sc": "就当作是积阴德，可以帮我这个忙吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 194742,
          "spk": "？？？ (未知角色)",
          "ja": "もちろん、きちんと礼はするからの",
          "tc": "當然，我一定會好好答謝你的。",
          "sc": "当然，我一定会好好答谢你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3482,
      "rec_id": "TALK_ID_60_0013_003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194765,
          "spk": "？？？ (未知角色)",
          "ja": "おう……小童",
          "tc": "哦……小傢伙。",
          "sc": "哦……小家伙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194772,
          "spk": "？？？ (未知角色)",
          "ja": "また会ったのう",
          "tc": "又見面了啊。",
          "sc": "又见面了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194781,
          "spk": "？？？ (未知角色)",
          "ja": "それで、どうかのう？",
          "tc": "所以，怎麼樣了呢？",
          "sc": "所以，怎么样了呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 194788,
          "spk": "？？？ (未知角色)",
          "ja": "オラとの約束、なんとかなりそうか？",
          "tc": "你有辦法完成答應我的事嗎？",
          "sc": "你有办法完成答应我的事吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 194797,
          "spk": "？？？ (未知角色)",
          "ja": "オラの息子たちのために",
          "tc": "為了我的兒子們，",
          "sc": "为了我的儿子们，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 194804,
          "spk": "？？？ (未知角色)",
          "ja": "キュウリが３０本ほしいんじゃ",
          "tc": "我需要30根小黃瓜。",
          "sc": "我需要30根黄瓜。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 194813,
          "spk": "？？？ (未知角色)",
          "ja": "礼ならきちんと用意しとておるよ",
          "tc": "謝禮我已經準備好了。",
          "sc": "谢礼我已经准备好了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 194820,
          "spk": "？？？ (未知角色)",
          "ja": "前にも言うたが、河童は義理堅いんじゃ",
          "tc": "之前也跟你說過，我們河童最講道義了。",
          "sc": "之前也跟你说过，我们河童最讲道义了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 194829,
          "spk": "？？？ (未知角色)",
          "ja": "それじゃあ、待っておるぞ",
          "tc": "那我會繼續等你的消息。",
          "sc": "那我会继续等你的消息。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 194836,
          "spk": "？？？ (未知角色)",
          "ja": "小童よ……",
          "tc": "小傢伙……",
          "sc": "小家伙……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3483,
      "rec_id": "TALK_ID_60_0013_011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194852,
          "spk": "？？？ (未知角色)",
          "ja": "おお、小童",
          "tc": "哦哦，小傢伙。",
          "sc": "哦哦，小家伙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194859,
          "spk": "？？？ (未知角色)",
          "ja": "キュウリを持ってきてくれたのじゃな",
          "tc": "你幫我帶小黃瓜過來了啊。",
          "sc": "你帮我带黄瓜过来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194868,
          "spk": "？？？ (未知角色)",
          "ja": "これでオラの息子たちに",
          "tc": "這樣我的兒子們",
          "sc": "这样我的儿子们"
        },
        {
          "f_idx": 3,
          "pidx_tc": 194875,
          "spk": "？？？ (未知角色)",
          "ja": "ひもじい思いをさせなくてすむ",
          "tc": "就不用再餓肚子了。",
          "sc": "就不用再饿肚子了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 194882,
          "spk": "？？？ (未知角色)",
          "ja": "ありがとうなぁ……",
          "tc": "謝謝你……",
          "sc": "谢谢你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3484,
      "rec_id": "TALK_ID_60_0013_012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194898,
          "spk": "？？？ (未知角色)",
          "ja": "ほれ、オラからの礼じゃ",
          "tc": "來，這是我給你的謝禮。",
          "sc": "来，这是我给你的谢礼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194905,
          "spk": "？？？ (未知角色)",
          "ja": "それなりにいいモノのはずじゃ",
          "tc": "應該還算是不錯的東西喔！",
          "sc": "应该还算是不错的东西哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194912,
          "spk": "？？？ (未知角色)",
          "ja": "受け取ってくれ",
          "tc": "請收下吧。",
          "sc": "请收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3485,
      "rec_id": "TALK_ID_60_0013_013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194928,
          "spk": "？？？ (未知角色)",
          "ja": "それじゃあの、小童",
          "tc": "那麼，小傢伙。",
          "sc": "那么，小家伙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194935,
          "spk": "？？？ (未知角色)",
          "ja": "また息子たちが腹を空かせたら",
          "tc": "之後要是我兒子們又餓了，",
          "sc": "之后要是我儿子们又饿了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194942,
          "spk": "？？？ (未知角色)",
          "ja": "その時はよろしく頼むぞ",
          "tc": "到時候再拜託你囉。",
          "sc": "到时候再拜托你啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3486,
      "rec_id": "TALK_ID_60_0014_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 194958,
          "spk": "？？？ (未知角色)",
          "ja": "おやおやおや",
          "tc": "哎呀哎呀哎呀。",
          "sc": "哎呀哎呀哎呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 194965,
          "spk": "？？？ (未知角色)",
          "ja": "キミはなんだい？",
          "tc": "你是什麼啊？",
          "sc": "你是什么啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194972,
          "spk": "？？？ (未知角色)",
          "ja": "ニンゲン……かな？",
          "tc": "難道是……人類？",
          "sc": "难道是……人类？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 194981,
          "spk": "？？？ (未知角色)",
          "ja": "ああ、ごめんね",
          "tc": "啊，抱歉啦，",
          "sc": "啊，抱歉啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 194988,
          "spk": "？？？ (未知角色)",
          "ja": "こんな夜中にニンゲンに出会うなんて",
          "tc": "我沒想到居然會在三更半夜碰到人類，",
          "sc": "我没想到居然会在三更半夜碰到人类，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 194995,
          "spk": "？？？ (未知角色)",
          "ja": "珍しくてね",
          "tc": "真的太難得了。",
          "sc": "真的太难得了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 195004,
          "spk": "？？？ (未知角色)",
          "ja": "ボクかい？　ボクは見ての通りの妖怪だよ",
          "tc": "你說我嗎？如你所見，我是妖怪啊。",
          "sc": "你说我吗？如你所见，我是妖怪啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 195011,
          "spk": "？？？ (未知角色)",
          "ja": "ニンゲンからは豆腐小僧って呼ばれてるよ",
          "tc": "人類都叫我「豆腐小僧」喔。",
          "sc": "人类都叫我“豆腐小僧”哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 195020,
          "spk": "？？？ (未知角色)",
          "ja": "ナニをしてるのかって？",
          "tc": "你問我在做什麼？",
          "sc": "你问我在做什么？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 195027,
          "spk": "？？？ (未知角色)",
          "ja": "豆腐を運んでるのさ",
          "tc": "我在搬豆腐啦。",
          "sc": "我在搬豆腐啦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 195034,
          "spk": "？？？ (未知角色)",
          "ja": "別に悪いことはしてないよ",
          "tc": "可沒有做什麼壞事喔！",
          "sc": "可没有做什么坏事哦！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 195043,
          "spk": "？？？ (未知角色)",
          "ja": "あ、そうだ、キミ",
          "tc": "啊，對了。",
          "sc": "啊，对了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 195050,
          "spk": "？？？ (未知角色)",
          "ja": "せっかくだし、ボクの頼みを聞いておくれよ",
          "tc": "難得遇見人類，你能幫我個忙嗎？",
