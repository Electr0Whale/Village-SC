    {
      "file": "talk.dat",
      "rec_idx": 3495,
      "rec_id": "TALK_ID_60_0015_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 195527,
          "spk": "？？？ (未知角色)",
          "ja": "おんやぁ……",
          "tc": "哦……",
          "sc": "哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 195534,
          "spk": "？？？ (未知角色)",
          "ja": "ニンゲンのガキやん",
          "tc": "是人類小孩呢。",
          "sc": "是人类小孩呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 195541,
          "spk": "？？？ (未知角色)",
          "ja": "なにしてはんの？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 195550,
          "spk": "？？？ (未知角色)",
          "ja": "こんな時間に出歩いて",
          "tc": "在這種時間跑到外面來，",
          "sc": "在这种时间跑到外面来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 195557,
          "spk": "？？？ (未知角色)",
          "ja": "妖怪が怖くないんかいな？",
          "tc": "你不怕碰到妖怪嗎？",
          "sc": "你不怕碰到妖怪吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 195566,
          "spk": "？？？ (未知角色)",
          "ja": "……変わっとんなぁ、まあええわ",
          "tc": "……真是個怪孩子，不過算了。",
          "sc": "……真是个怪孩子，不过算了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 195573,
          "spk": "？？？ (未知角色)",
          "ja": "せっかくやし、ウチの頼みを聞いてくれへん？",
          "tc": "難得遇見人類，你能幫我個忙嗎？",
          "sc": "难得遇见人类，你能帮我个忙吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 195589,
          "spk": "？？？ (未知角色)",
          "ja": "ウチな、魚が好きやねん",
          "tc": "我很愛吃魚呢。",
          "sc": "我很爱吃鱼呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 195596,
          "spk": "？？？ (未知角色)",
          "ja": "せやからあんさんにたくさん獲ってきて",
          "tc": "所以想請你幫忙",
          "sc": "所以想请你帮忙"
        },
        {
          "f_idx": 10,
          "pidx_tc": 195603,
          "spk": "？？？ (未知角色)",
          "ja": "ほしいんや",
          "tc": "多抓一點魚給我。",
          "sc": "多抓一点鱼给我。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 195612,
          "spk": "？？？ (未知角色)",
          "ja": "どんな魚でもええから、",
          "tc": "什麼魚都可以，",
          "sc": "什么鱼都可以，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 195619,
          "spk": "？？？ (未知角色)",
          "ja": "なるたけ活きのええヤツを頼むわ",
          "tc": "盡量抓新鮮一點的就好。",
          "sc": "尽量抓新鲜一点的就好。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 195635,
          "spk": "？？？ (未知角色)",
          "ja": "自分で獲れって？",
          "tc": "叫我自己去抓？",
          "sc": "叫我自己去抓？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 195642,
          "spk": "？？？ (未知角色)",
          "ja": "そんなんできひんわぁ",
          "tc": "那可不成～",
          "sc": "那可不成～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 195649,
          "spk": "？？？ (未知角色)",
          "ja": "ウチのきれいな毛並みが台無しになるやろ？",
          "tc": "豈不是毀了我這身漂亮的毛嗎？",
          "sc": "岂不是毁了我这身漂亮的毛吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 195658,
          "spk": "？？？ (未知角色)",
          "ja": "ニンゲンの店からかっぱらうのは",
          "tc": "我是可以從人類的店裡偷到魚，",
          "sc": "我是可以从人类的店里偷到鱼，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 195665,
          "spk": "？？？ (未知角色)",
          "ja": "できるんやけど、あんま調子乗ってると",
          "tc": "但要是太囂張的話，",
          "sc": "但要是太嚣张的话，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 195672,
          "spk": "？？？ (未知角色)",
          "ja": "しばかれるかもしれへんし",
          "tc": "搞不好會被修理一頓。",
          "sc": "说不定会被修理一顿。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 195681,
