    },
    {
      "file": "talk.dat",
      "rec_idx": 8410,
      "rec_id": "TALK_ID_70_2070_005_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434165,
          "spk": "茶梅 (サザンカ)",
          "ja": "なら、アタシのおススメ聴かせよっか？",
          "tc": "不然讓你聽聽我推薦的曲子吧？",
          "sc": "不然让你听听我推荐的曲子吧？"
        },
