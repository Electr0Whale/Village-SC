          "f_idx": 1,
          "pidx_tc": 434172,
          "spk": "茶梅 (サザンカ)",
          "ja": "きっと気に入ると思うからさ",
          "tc": "我想你一定會喜歡的。",
          "sc": "我想你一定会喜欢的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8411,
      "rec_id": "TALK_ID_70_2070_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435478,
          "spk": "茶梅 (サザンカ)",
          "ja": "おっ、気に入った？",
          "tc": "哦，你喜歡嗎？",
          "sc": "哦，你喜欢吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435485,
          "spk": "茶梅 (サザンカ)",
          "ja": "めちゃくちゃ美味しいよね",
          "tc": "超好吃對吧？",
          "sc": "超好吃对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435496,
          "spk": "茶梅 (サザンカ)",
          "ja": "さっすが高級品って感じ",
          "tc": "真不愧是高級貨啊。",
          "sc": "真不愧是高级货啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8412,
      "rec_id": "TALK_ID_70_2070_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435514,
          "spk": "茶梅 (サザンカ)",
          "ja": "ん～？",
          "tc": "嗯～？",
          "sc": "嗯～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 435521,
          "spk": "茶梅 (サザンカ)",
          "ja": "なに遠慮してんの？",
          "tc": "你幹嘛跟我客氣？",
          "sc": "你干嘛跟我客气？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 435532,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシとアンタの仲だし",
          "tc": "憑我們兩個的交情，",
          "sc": "凭我们两个的交情，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 435539,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんなの今さらっしょ",
          "tc": "事到如今還客氣什麼嘛。",
          "sc": "事到如今还客气什么嘛。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 435550,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、ほら",
          "tc": "所以囉，來嘛！",
          "sc": "所以嘛，来嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8413,
      "rec_id": "TALK_ID_70_2080_003_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 457440,
          "spk": "六角 (ロッカク)",
          "ja": "そうそう",
          "tc": "就是這樣，",
          "sc": "就是这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 457447,
          "spk": "六角 (ロッカク)",
          "ja": "ヒトの好意は受け取っておくもんっスよ",
          "tc": "你就收下別人的好意吧。",
          "sc": "你就收下别人的好意哟。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 457458,
          "spk": "六角 (ロッカク)",
          "ja": "特に、ワシみたいな男の善意なんて",
          "tc": "尤其是像我這種男人的善意，",
          "sc": "尤其是像我这种男人的善意，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 457465,
          "spk": "六角 (ロッカク)",
          "ja": "いつ品切れしてもおかしくないっスからねえ",
          "tc": "什麼時候缺貨都不奇怪。",
          "sc": "什么时候缺货都不奇怪。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 457483,
          "spk": "六角 (ロッカク)",
          "ja": "せっかくだ",
          "tc": "難得都來了，",
          "sc": "难得都来了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 457490,
          "spk": "六角 (ロッカク)",
          "ja": "デザートにこの、フルーツも付けましょう",
          "tc": "我就送你這個水果，當作是飯後甜點吧。",
          "sc": "我就送你这个水果，当作是饭后甜点吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 457501,
          "spk": "六角 (ロッカク)",
          "ja": "ま、我が家のおやつの残りなんスが……",
          "tc": "雖然這是我家剩下來的……",
          "sc": "虽然这是我家剩下来的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8414,
      "rec_id": "TALK_ID_70_2080_003_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 457533,
          "spk": "六角 (ロッカク)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 457540,
          "spk": "六角 (ロッカク)",
          "ja": "もしかして、さっきの帳簿のこと",
          "tc": "難道說你是在在意",
          "sc": "难道说你是在在意"
        },
        {
          "f_idx": 2,
          "pidx_tc": 457547,
          "spk": "六角 (ロッカク)",
          "ja": "気にしてるんスか？",
          "tc": "我剛剛說的記帳的事嗎？",
          "sc": "我刚刚说的记帐的事吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 457558,
          "spk": "六角 (ロッカク)",
          "ja": "子どもが遠慮なんてするものじゃないっスよ",
          "tc": "小孩子不必顧慮這些啦，",
          "sc": "小孩子不必顾虑这些啦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 457565,
          "spk": "六角 (ロッカク)",
          "ja": "そもそも、本当に苦しかったら",
          "tc": "而且要是我日子真的過不下去，",
          "sc": "而且要是我日子真的过不下去，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 457572,
          "spk": "六角 (ロッカク)",
          "ja": "とっくの昔に他の村人に泣きついてるっス",
          "tc": "我老早就去找其他村民哭訴了。",
          "sc": "我老早就去找其他村民哭诉呐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 457583,
          "spk": "六角 (ロッカク)",
          "ja": "その時は<player>さんが",
          "tc": "到時候啊，<player>，",
          "sc": "到时候啊，<player>，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 457590,
          "spk": "六角 (ロッカク)",
          "ja": "いの一番の候補っスから",
          "tc": "我一定會第一個去找你幫忙的，",
          "sc": "我一定会第一个去找你帮忙的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 457597,
          "spk": "六角 (ロッカク)",
          "ja": "覚悟しといてくださいね？",
          "tc": "所以你就先做好心理準備吧。",
          "sc": "所以你就先做好心理准备吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 457608,
          "spk": "六角 (ロッカク)",
          "ja": "なぁんて、冗談っスけどね",
          "tc": "我開玩笑的啦。",
          "sc": "我开玩笑呐。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 457615,
          "spk": "六角 (ロッカク)",
          "ja": "お金はほら、大酒呑みの連中から",
          "tc": "錢的話，我會從那群酒鬼們身上",
          "sc": "钱的话，我会从那群酒鬼们身上"
        },
        {
          "f_idx": 11,
          "pidx_tc": 457622,
          "spk": "六角 (ロッカク)",
          "ja": "絞れるだけ絞りますんで",
          "tc": "榨得乾乾淨淨的。",
          "sc": "榨得干干净净的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8415,
      "rec_id": "TALK_ID_70_2080_007_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 460174,
          "spk": "六角 (ロッカク)",
          "ja": "定番の塩焼きも美味いっスけど",
          "tc": "經典的鹽烤雖然也很好吃，",
          "sc": "经典的盐烤虽然也很好吃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 460181,
          "spk": "六角 (ロッカク)",
          "ja": "丸ごと揚げてがぶっといくのもいいもんっス",
          "tc": "不過把整條丟下去炸，直接這樣吃也不錯。",
          "sc": "不过把整条丢下去炸，直接这样吃也不错呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 460199,
          "spk": "六角 (ロッカク)",
          "ja": "特に酔っ払って、前後不覚になった酔客でも",
          "tc": "這道料理的賣點，",
          "sc": "这道料理的卖点，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 460206,
          "spk": "六角 (ロッカク)",
          "ja": "気にせず食えるのが売りってところっス",
          "tc": "就是連喝醉酒、神智不清的客人都能放心地吃。",
          "sc": "就是连喝醉酒、神智不清的客人都能放心地吃呐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 460222,
          "spk": "六角 (ロッカク)",
          "ja": "こいつでキスケさん辺りが",
          "tc": "只要木助他們能配著這道菜喝完整瓶燒酒，",
          "sc": "只要木助他们能配着这道菜喝完整瓶烧酒，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 460229,
          "spk": "六角 (ロッカク)",
          "ja": "焼酎の一本でも空けてくれればめっけもんっス",
          "tc": "那我就謝天謝地了。",
          "sc": "那我就谢天谢地呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8416,
      "rec_id": "TALK_ID_70_2080_007_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 460254,
          "spk": "六角 (ロッカク)",
          "ja": "これは試食っスよ",
          "tc": "這是試吃啦。",
          "sc": "这是试吃哟。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 460261,
          "spk": "六角 (ロッカク)",
          "ja": "頼んでおいて金なんて取れねっス",
          "tc": "既然是拜託你吃，就不會跟你收錢。",
          "sc": "既然是拜托你吃，就不会跟你收钱呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 460272,
          "spk": "六角 (ロッカク)",
          "ja": "ワタもキレイに抜いてますし、",
          "tc": "我把內臟都清乾淨了，",
          "sc": "我把内脏都清干净了，"
        },
        {
