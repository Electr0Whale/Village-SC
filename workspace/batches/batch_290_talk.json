      "rec_id": "TALK_ID_70_2070_003_10_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 432970,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、ドローンと一緒に",
          "tc": "那我拿無人機過來的時候",
          "sc": "那我拿无人机过来的时候"
        },
        {
          "f_idx": 1,
          "pidx_tc": 432977,
          "spk": "茶梅 (サザンカ)",
          "ja": "ジュース持ってくるから",
          "tc": "順便拿果汁給你，",
          "sc": "顺便拿果汁给你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 432984,
          "spk": "茶梅 (サザンカ)",
          "ja": "それでも飲んでてよ",
          "tc": "你就在旁邊喝吧～",
          "sc": "你就在旁边喝吧～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8409,
      "rec_id": "TALK_ID_70_2070_005_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 434120,
          "spk": "茶梅 (サザンカ)",
          "ja": "どれ？　これ？",
