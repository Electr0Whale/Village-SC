  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6004,
      "rec_id": "TALK_ID_10_0601_025_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350285,
          "spk": "林 (リン)",
          "ja": "……あなた",
          "tc": "原來妳……",
          "sc": "原来你……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350292,
          "spk": "林 (リン)",
          "ja": "本気でそこまで考えてくれてたのね",
          "tc": "認真為我考慮了這麼多呢。",
          "sc": "认真为我考虑了这么多呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6005,
      "rec_id": "TALK_ID_10_0601_025_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350310,
          "spk": "帷 (トバリ)",
          "ja": "……アンタが村を捨てるって言ったとき、",
          "tc": "……當妳說要捨棄村子的時候，",
          "sc": "……当你说要舍弃村子的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350317,
          "spk": "帷 (トバリ)",
          "ja": "心臓がぎゅっとなった",
          "tc": "我的心口忽然一緊。",
          "sc": "我的心口忽然一紧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350326,
          "spk": "帷 (トバリ)",
          "ja": "アンタの声で終わりを聞いたみたいで",
          "tc": "彷彿聽見妳宣告了終結一樣，",
          "sc": "仿佛听见你宣告了终结一样，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350333,
          "spk": "帷 (トバリ)",
          "ja": "耐えられないの",
          "tc": "我沒辦法承受。",
          "sc": "我没办法承受。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 350342,
          "spk": "帷 (トバリ)",
          "ja": "だから、いつもの",
          "tc": "所以，請妳繼續當那個",
          "sc": "所以，请你继续当那个"
        },
        {
          "f_idx": 5,
          "pidx_tc": 350349,
          "spk": "帷 (トバリ)",
          "ja": "意地悪で自分勝手なリンでいて",
          "tc": "壞心眼又任性的林吧。",
          "sc": "使坏又任性的林吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 350360,
          "spk": "帷 (トバリ)",
          "ja": "なんのために、",
          "tc": "妳以為",
          "sc": "你以为"
        },
        {
          "f_idx": 7,
          "pidx_tc": 350367,
          "spk": "帷 (トバリ)",
          "ja": "私がアンタのそばにいると思っているの",
          "tc": "我是為了什麼留在妳身邊？",
          "sc": "我是为了什么留在你身边？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 350374,
          "spk": "帷 (トバリ)",
          "ja": "ピアスを開けたと思っているの",
          "tc": "又為了什麼要穿耳洞？",
          "sc": "又为了什么要穿耳洞？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 350383,
          "spk": "帷 (トバリ)",
          "ja": "危機が来た時、助け合うんじゃないの",
          "tc": "就是為了在危機來臨時互相幫助啊。",
          "sc": "就是为了在危机来临时互相帮助啊。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 350401,
          "spk": "林 (リン)",
          "ja": "……トバリ",
          "tc": "……帷。",
          "sc": "……帷。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6006,
      "rec_id": "TALK_ID_10_0601_025_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350419,
          "spk": "帷 (トバリ)",
          "ja": "……私は、ここに残る",
          "tc": "……我會留在這裡。",
          "sc": "……我会留在这里。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350426,
          "spk": "帷 (トバリ)",
          "ja": "最後までやってやる",
          "tc": "一直努力到最後。",
          "sc": "一直努力到最后。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350439,
          "spk": "林 (リン)",
          "ja": "終わらせるか、守るか",
          "tc": "無論要做個了結，還是守護到底，",
          "sc": "无论要做个了结，还是守护到底，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350446,
          "spk": "林 (リン)",
          "ja": "どちらにしても自分の責任で……",
          "tc": "我都會自己承擔責任……",
          "sc": "我都会自己承担责任……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 350466,
          "spk": "帷 (トバリ)",
          "ja": "……いい？",
          "tc": "……聽好了，",
          "sc": "……听好了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 350473,
          "spk": "帷 (トバリ)",
          "ja": "私たち、約束をしましょう",
          "tc": "我們做個約定吧。",
          "sc": "我们做个约定吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 350480,
          "spk": "帷 (トバリ)",
          "ja": "どちらかが疲れて迷ったら、互いに支え合う",
          "tc": "我們之中有人累了、迷惘了，就要互相扶持。",
          "sc": "我们之中有人累了、迷惘了，就要互相扶持。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 350493,
          "spk": "林 (リン)",
          "ja": "約束するわ",
          "tc": "我答應妳。",
          "sc": "我答应你。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 350502,
          "spk": "林 (リン)",
          "ja": "二人で、この村を終わらせるか、救うか",
          "tc": "不管是要終結或是拯救這座村子，",
          "sc": "不管是要终结或是拯救这座村子，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 350509,
          "spk": "林 (リン)",
          "ja": "どっちに転んでも、後悔しない道を選びましょう",
          "tc": "一起選出一條無論結果如何都不會後悔的路吧。",
          "sc": "一起选出一条无论结果如何都不会后悔的路吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6007,
      "rec_id": "TALK_ID_10_0601_026_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350542,
          "spk": "木助 (キスケ)",
          "ja": "よお",
          "tc": "嗨。",
          "sc": "嗨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350553,
          "spk": "木助 (キスケ)",
          "ja": "考えがまとまったんだ",
          "tc": "我整理好自己的想法了。",
          "sc": "我整理好自己的想法了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350560,
          "spk": "木助 (キスケ)",
          "ja": "てめぇにも、色々と迷惑をかけた",
          "tc": "之前也給你添了不少麻煩。",
          "sc": "之前也给你添了不少麻烦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350571,
          "spk": "木助 (キスケ)",
          "ja": "だから、ちゃんと今までのことや",
          "tc": "所以，我想把至今為止的事情，",
          "sc": "所以，我想把至今为止的事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 350578,
          "spk": "木助 (キスケ)",
          "ja": "これからのことを話しておこうと思って",
          "tc": "還有今後的打算，都好好跟你說清楚。",
          "sc": "还有今后的打算，都好好跟你说清楚。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 350589,
          "spk": "木助 (キスケ)",
          "ja": "ただ……お天道様の下じゃ、ちと話しづらい",
          "tc": "只不過……光天化日下有點難開口。",
          "sc": "只不过……光天化日下有点难开口。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 350596,
          "spk": "木助 (キスケ)",
          "ja": "誰にも聞かれたくねぇんだ",
          "tc": "我不想讓其他人聽見。",
          "sc": "我不想让其他人听见。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 350614,
          "spk": "木助 (キスケ)",
          "ja": "悪いが深夜になってから話したい",
          "tc": "抱歉，我想等深夜再跟你說。",
          "sc": "抱歉，我想等深夜再跟你说。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 350621,
          "spk": "木助 (キスケ)",
          "ja": "家で寝て、待っていてくれねぇか？",
          "tc": "你可以在家裡睡覺等我嗎？",
          "sc": "你可以在家里睡觉等我吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 350632,
          "spk": "木助 (キスケ)",
          "ja": "大丈夫だ、ちゃんと起こしてやるから",
          "tc": "不用擔心，我一定會把你叫醒的。",
          "sc": "不用担心，我一定会把你叫醒的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 350639,
          "spk": "木助 (キスケ)",
          "ja": "んじゃ、よろしくな",
          "tc": "那就之後見了。",
          "sc": "那就之后见了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6008,
      "rec_id": "TALK_ID_10_0601_027_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350659,
          "spk": "木助 (キスケ)",
          "ja": "よお、俺だ",
          "tc": "嗨，是我。",
          "sc": "嗨，是我。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350666,
          "spk": "木助 (キスケ)",
          "ja": "キスケだよ",
          "tc": "我是木助啦。",
          "sc": "我是木助啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6009,
      "rec_id": "TALK_ID_10_0601_027_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350682,
          "spk": "木助 (キスケ)",
          "ja": "ああ、扉は開けないでくれ",
          "tc": "啊啊，你別把門打開。",
          "sc": "啊啊，你别把门打开。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350689,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの顔を見て、",
          "tc": "看著你的臉講話，",
          "sc": "看着你的脸讲话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350696,
          "spk": "木助 (キスケ)",
          "ja": "話すことはちいとばかし難しいんだ",
          "tc": "對我來說有點困難。",
          "sc": "对我来说有点困难。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350705,
          "spk": "木助 (キスケ)",
          "ja": "だから……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 350712,
          "spk": "木助 (キスケ)",
          "ja": "このままで……許してくれ",
          "tc": "就讓我這樣說吧。",
          "sc": "就让我这样说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6010,
      "rec_id": "TALK_ID_10_0601_027_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350728,
          "spk": "木助 (キスケ)",
          "ja": "長い話になる",
          "tc": "這會是個很長的故事。",
          "sc": "这会是个很长的故事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350735,
          "spk": "木助 (キスケ)",
          "ja": "さて、どこから説明するかね……",
          "tc": "好了，要從哪開始說明呢……",
          "sc": "好了，要从哪开始说明呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350744,
          "spk": "木助 (キスケ)",
          "ja": "まずはこの、彼ヶ津村のことから",
          "tc": "可能得先從這座彼津村",
          "sc": "可能得先从这座彼津村"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350751,
          "spk": "木助 (キスケ)",
          "ja": "話さないといけねぇかもな",
          "tc": "開始講起才行。",
          "sc": "开始讲起才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6011,
      "rec_id": "TALK_ID_10_0601_027_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350767,
          "spk": "木助 (キスケ)",
          "ja": "今日はこの辺にしよう",
          "tc": "今天就先說到這邊吧。",
          "sc": "今天就先说到这边吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350776,
          "spk": "木助 (キスケ)",
          "ja": "また、夜中に来るから",
          "tc": "我改天半夜會再過來，",
          "sc": "我改天半夜会再过来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350783,
          "spk": "木助 (キスケ)",
          "ja": "続きはその時に……",
          "tc": "到時候再繼續說……",
          "sc": "到时候再继续说……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350792,
          "spk": "木助 (キスケ)",
          "ja": "……じゃあな",
          "tc": "……再見。",
          "sc": "……再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6012,
      "rec_id": "TALK_ID_10_0601_028_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350808,
          "spk": "木助 (キスケ)",
          "ja": "よお、俺だ",
          "tc": "嗨，是我。",
          "sc": "嗨，是我。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350817,
          "spk": "木助 (キスケ)",
          "ja": "今日も夜分に悪いな",
          "tc": "抱歉，今天也這麼晚打擾你。",
          "sc": "抱歉，今天也这么晚打扰你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 350824,
          "spk": "木助 (キスケ)",
          "ja": "話の続きをしに来たんだ",
          "tc": "我是來繼續上次的話題的。",
          "sc": "我是来继续上次的话题的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 350840,
          "spk": "木助 (キスケ)",
          "ja": "今日は……そうだな……",
          "tc": "今天的話……我想想……",
          "sc": "今天的话……我想想……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 350847,
          "spk": "木助 (キスケ)",
          "ja": "二十年前の話をしよう",
          "tc": "就來講二十年前的事吧。",
          "sc": "就来讲二十年前的事吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 350854,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはもう大体察しがついてるかもな",
          "tc": "你可能已經大致猜到了。",
          "sc": "你可能已经大致猜到了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 350863,
          "spk": "木助 (キスケ)",
          "ja": "だが、俺から見たこの村の歴史を——",
          "tc": "不過，我還是希望你可以了解──",
          "sc": "不过，我还是希望你可以了解——"
        },
        {
          "f_idx": 8,
          "pidx_tc": 350870,
          "spk": "木助 (キスケ)",
          "ja": "知っておいてほしいんだ",
          "tc": "從我眼中看到的，這座村子的歷史。",
          "sc": "从我眼中看到的，这座村子的历史。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6013,
      "rec_id": "TALK_ID_10_0601_028_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 350893,
          "spk": "木助 (キスケ)",
          "ja": "これが村で起きたことの真相だ",
          "tc": "這就是過去事件的真相。",
          "sc": "这就是过去事件的真相。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 350900,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもとんでもない場所に落ちちまったな",
          "tc": "你還真是流落到一個不得了的地方啊。",
          "sc": "你还真是流落到一个不得了的地方啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 350916,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは、この村に来てよかったのか？",
          "tc": "你來到這座村子真的好嗎？",
          "sc": "你来到这座村子真的好吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 350932,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 350939,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん",
          "tc": "呃……",
          "sc": "呃……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6014,
      "rec_id": "TALK_ID_10_0601_028_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351012,
          "spk": "木助 (キスケ)",
          "ja": "ここに来てくれたのがてめぇでよかった",
          "tc": "幸好來到這裡的是你。",
          "sc": "幸好来到这里的是你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351028,
          "spk": "木助 (キスケ)",
          "ja": "ただ暮らしているだけでも、",
          "tc": "就算你只是住在村子裡而已，",
          "sc": "就算你只是住在村子里而已，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351035,
          "spk": "木助 (キスケ)",
          "ja": "俺は……慰められたよ",
          "tc": "我也……得到了安慰。",
          "sc": "我也……得到了安慰。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351044,
          "spk": "木助 (キスケ)",
          "ja": "まるであの時のコダマが、",
          "tc": "簡直就像當時的木珠，",
          "sc": "简直就像当时的木珠，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 351051,
          "spk": "木助 (キスケ)",
          "ja": "村で暮らしているみてぇだった……",
          "tc": "在村子裡生活一樣……",
          "sc": "在村子里生活一样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6015,
      "rec_id": "TALK_ID_10_0601_028_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351074,
          "spk": "木助 (キスケ)",
          "ja": "だけど、あいつは……",
          "tc": "但是，那傢伙……",
          "sc": "但是，那家伙……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 351081,
          "spk": "木助 (キスケ)",
          "ja": "俺の家族は間違いを犯しちまった",
          "tc": "我的家人犯下了過錯。",
          "sc": "我的家人犯下了过错。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351088,
          "spk": "木助 (キスケ)",
          "ja": "死んでなお、償えない重い罪を……",
          "tc": "那是死也無法償還的重罪……",
          "sc": "那是死也无法偿还的重罪……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351097,
          "spk": "木助 (キスケ)",
          "ja": "俺はあいつに、償ってもらいたいんだ",
          "tc": "我希望那傢伙可以贖罪。",
          "sc": "我希望那家伙可以赎罪。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351104,
          "spk": "木助 (キスケ)",
          "ja": "過ちを叱ってやらないと……",
          "tc": "得斥責他的過錯才行……",
          "sc": "得斥责他的过错才行……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 351111,
          "spk": "木助 (キスケ)",
          "ja": "俺は兄なんだから……",
          "tc": "因為我是哥哥……",
          "sc": "因为我是哥哥……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6016,
      "rec_id": "TALK_ID_10_0601_028_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351127,
          "spk": "木助 (キスケ)",
          "ja": "……じゃあ",
          "tc": "……那麼，",
          "sc": "……那么，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 351134,
          "spk": "木助 (キスケ)",
          "ja": "また……夜に",
          "tc": "下次……晚上再見。",
          "sc": "下次……晚上再见。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351143,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが大人しく掟を守ってりゃ",
          "tc": "只要你乖乖遵守規矩，",
          "sc": "只要你乖乖遵守规矩，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351150,
          "spk": "木助 (キスケ)",
          "ja": "話しに来るよ",
          "tc": "我就會再來找你聊。",
          "sc": "我就会再来找你聊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351159,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "再見。",
          "sc": "再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6017,
      "rec_id": "TALK_ID_10_0601_029_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351211,
          "spk": "木助 (キスケ)",
          "ja": "戸締り、忘れてるぜ",
          "tc": "你忘了鎖門喔。",
          "sc": "你忘了锁门啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 351218,
          "spk": "木助 (キスケ)",
          "ja": "勝手に入ってきて悪いな",
          "tc": "擅自跑進來不好意思。",
          "sc": "擅自跑进来不好意思。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351229,
          "spk": "木助 (キスケ)",
          "ja": "そろそろ逃げずに、",
          "tc": "我想說，也差不多該好好面對你，",
          "sc": "我想说，也差不多该好好面对你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351236,
          "spk": "木助 (キスケ)",
          "ja": "ちゃんとてめぇに向き合わねえとって思ってな",
          "tc": "不能再逃避了。",
          "sc": "不能再逃避了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6018,
      "rec_id": "TALK_ID_10_0601_029_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351261,
          "spk": "木助 (キスケ)",
          "ja": "毎晩、俺の話に付き合わせて悪かった",
          "tc": "抱歉，每天晚上都要你聽我聊那些事。",
          "sc": "抱歉，每天晚上都要你听我聊那些事。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351277,
          "spk": "木助 (キスケ)",
          "ja": "だが今日でもう終わりにしよう",
          "tc": "就到今天為止吧。",
          "sc": "就到今天为止吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351284,
          "spk": "木助 (キスケ)",
          "ja": "ここからは……俺自身の話だ",
          "tc": "接下來要講的……是關於我自己的事。",
          "sc": "接下来要讲的……是关于我自己的事。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351295,
          "spk": "木助 (キスケ)",
          "ja": "……贖罪だよ",
          "tc": "……這是贖罪。",
          "sc": "……这是赎罪。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6019,
      "rec_id": "TALK_ID_10_0601_029_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351313,
          "spk": "木助 (キスケ)",
          "ja": "俺はこの二十年、",
          "tc": "這二十年來，",
          "sc": "这二十年来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 351320,
          "spk": "木助 (キスケ)",
          "ja": "ずっと罪の意識に苛まれながら生きてきた",
          "tc": "我一直活在受罪惡感折磨的日子裡。",
          "sc": "我一直活在受罪恶感折磨的日子里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351331,
          "spk": "木助 (キスケ)",
          "ja": "どうしてあの時、",
          "tc": "為什麼當時，",
          "sc": "为什么当时，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351338,
          "spk": "木助 (キスケ)",
          "ja": "コダマを助けられなかったんだろう",
          "tc": "我沒辦法拯救木珠呢。",
          "sc": "我没办法拯救木珠呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351345,
          "spk": "木助 (キスケ)",
          "ja": "俺もあの穴に、飛び込めなかったんだろう",
          "tc": "為什麼我沒能一起跳進那個洞裡呢。",
          "sc": "为什么我没能一起跳进那个洞里呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 351354,
          "spk": "木助 (キスケ)",
          "ja": "あの日俺は、",
          "tc": "那一天，",
          "sc": "那一天，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 351361,
          "spk": "木助 (キスケ)",
          "ja": "大切な家族の命ではなく、",
          "tc": "我沒有優先拯救重要的家人，",
          "sc": "我没有优先拯救重要的家人，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 351368,
          "spk": "木助 (キスケ)",
          "ja": "自分のかわいさを優先した",
          "tc": "而是選擇了顧全自己。",
          "sc": "而是选择了顾全自己。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 351379,
          "spk": "木助 (キスケ)",
          "ja": "村がこうなったのも、",
          "tc": "村子之所以會變成這樣，",
          "sc": "村子之所以会变成这样，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 351386,
          "spk": "木助 (キスケ)",
          "ja": "十年前に事件が起きたのも、",
          "tc": "還有十年前會發生那起事件。",
          "sc": "还有十年前会发生那起事件。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 351393,
          "spk": "木助 (キスケ)",
          "ja": "……全て、俺のせいなんだ",
          "tc": "……全部，都是我害的。",
          "sc": "……全部，都是我害的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 351404,
          "spk": "木助 (キスケ)",
          "ja": "俺が生きていることが、",
          "tc": "我活著這件事，",
          "sc": "我活着这件事，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 351411,
          "spk": "木助 (キスケ)",
          "ja": "コダマの死と罪の証のように思えて……",
          "tc": "就像在證明木珠的死，還有罪行……",
          "sc": "就像在证明木珠的死，还有罪行……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 351418,
          "spk": "木助 (キスケ)",
          "ja": "息をするたび胸が詰まる",
          "tc": "所以每次呼吸都感到無比沉重。",
          "sc": "所以每次呼吸都感到无比沉重。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 351427,
          "spk": "木助 (キスケ)",
          "ja": "しがらみは、糸のように絡みつく",
          "tc": "那些糾葛，就像蜘蛛絲一樣纏繞著我，",
          "sc": "那些纠葛，就像蜘蛛丝一样缠绕着我，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 351434,
          "spk": "木助 (キスケ)",
          "ja": "逃れようとすればするほど、",
          "tc": "我越想逃離，",
          "sc": "我越想逃离，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 351441,
          "spk": "木助 (キスケ)",
          "ja": "蜘蛛の糸のように深く体に食い込む……",
          "tc": "絲線就會把我勒得更緊。",
          "sc": "丝线就会把我勒得更紧。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 351452,
          "spk": "木助 (キスケ)",
          "ja": "生き残ったのは俺で、コダマは怨霊になった",
          "tc": "活下來的是我，而木珠成了怨靈。",
          "sc": "活下来的是我，而木珠成了怨灵。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 351459,
          "spk": "木助 (キスケ)",
          "ja": "俺の罪を、コダマの罪をどう扱えばいいのか、",
          "tc": "到底該怎麼面對我的罪過──木珠的罪過。",
          "sc": "到底该怎么面对我的罪过——木珠的罪过。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 351466,
          "spk": "木助 (キスケ)",
          "ja": "ずっとわからなかったんだ",
          "tc": "其實我一直不知道。",
          "sc": "其实我一直不知道。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 351477,
          "spk": "木助 (キスケ)",
          "ja": "俺はコダマを責められない",
          "tc": "我沒辦法責怪木珠。",
          "sc": "我没办法责怪木珠。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 351484,
          "spk": "木助 (キスケ)",
          "ja": "あいつの願いや恨みを、",
          "tc": "因為我沒有權利去阻止",
          "sc": "因为我没有权利去阻止"
        },
        {
          "f_idx": 22,
          "pidx_tc": 351491,
          "spk": "木助 (キスケ)",
          "ja": "俺には止める権利はないと思っていた",
          "tc": "他的願望和怨恨。",
          "sc": "他的愿望和怨恨。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 351502,
          "spk": "木助 (キスケ)",
          "ja": "そして事件から十年後……てめぇが現れた",
          "tc": "然後在事件發生的十年後……你出現了。",
          "sc": "然后在事件发生的十年后……你出现了。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 351520,
          "spk": "木助 (キスケ)",
          "ja": "「コダマ」があの時のまま戻ってきて、驚いたよ",
          "tc": "看到「木珠」以當時的模樣回來，我很震驚。",
          "sc": "看到“木珠”以当时的模样回来，我很震惊。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 351538,
          "spk": "木助 (キスケ)",
          "ja": "なぜ「コダマ」の姿をした何者かが、",
          "tc": "心想，",
          "sc": "心想，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 351545,
          "spk": "木助 (キスケ)",
          "ja": "何もなかったかのように",
          "tc": "為什麼會有個跟「木珠」長得一樣的人，",
          "sc": "为什么会有个跟“木珠”长得一样的人，"
        },
        {
          "f_idx": 29,
          "pidx_tc": 351552,
          "spk": "木助 (キスケ)",
          "ja": "村にやって来たんだって……",
          "tc": "若無其事來到了村子裡……",
          "sc": "若无其事来到了村子里……"
        },
        {
          "f_idx": 30,
          "pidx_tc": 351563,
          "spk": "木助 (キスケ)",
          "ja": "だが、俺にはすぐにてめぇの正体がわかった",
          "tc": "不過，我很快就知道你的真實身分了。",
          "sc": "不过，我很快就知道你的真实身分了。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 351574,
          "spk": "木助 (キスケ)",
          "ja": "<strong>「神は、物を受け取って願われたら、",
          "tc": "<strong>「神明只要收下供品，",
          "sc": "<strong>“神明只要收下供品，"
        },
        {
          "f_idx": 32,
          "pidx_tc": 351581,
          "spk": "木助 (キスケ)",
          "ja": "　必ず願いを叶えなければいけない」……</strong>",
          "tc": "　則有求必應」……</strong>",
          "sc": "　则有求必应”……</strong>"
        },
        {
          "f_idx": 34,
          "pidx_tc": 351597,
          "spk": "木助 (キスケ)",
          "ja": "村に伝わるこの話を試したら、",
          "tc": "因為我嘗試了在村子裡流傳的這個說法，",
          "sc": "因为我尝试了在村子里流传的这个说法，"
        },
        {
          "f_idx": 35,
          "pidx_tc": 351604,
          "spk": "木助 (キスケ)",
          "ja": "まるで縛られたかのように",
          "tc": "結果你就像受到了束縛一樣，",
          "sc": "结果你就像受到了束缚一样，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 351611,
          "spk": "木助 (キスケ)",
          "ja": "俺の願いを叶えようと動いた",
          "tc": "為了幫我實現願望而行動。",
          "sc": "为了帮我实现愿望而行动。"
        },
        {
          "f_idx": 37,
          "pidx_tc": 351622,
          "spk": "木助 (キスケ)",
          "ja": "それを見て確信した",
          "tc": "看到那個情景，",
          "sc": "看到那个情景，"
        },
        {
          "f_idx": 38,
          "pidx_tc": 351629,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは誰かにこの村を救えと願われたから、",
          "tc": "我確信你是因為某人求你拯救村子，",
          "sc": "我确信你是因为某人求你拯救村子，"
        },
        {
          "f_idx": 39,
          "pidx_tc": 351636,
          "spk": "木助 (キスケ)",
          "ja": "現れたんだろうってな……",
          "tc": "才出現在這裡的……",
          "sc": "才出现在这里的……"
        },
        {
          "f_idx": 40,
          "pidx_tc": 351647,
          "spk": "木助 (キスケ)",
          "ja": "だから、ナゴを村へ引き入れて",
          "tc": "所以，我把名護帶進了村子裡，",
          "sc": "所以，我把名护带进了村子里，"
        },
        {
          "f_idx": 41,
          "pidx_tc": 351654,
          "spk": "木助 (キスケ)",
          "ja": "図書館を整理させたんだ",
          "tc": "讓他去整理圖書館。",
          "sc": "让他去整理图书馆。"
        },
        {
          "f_idx": 42,
          "pidx_tc": 351663,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが本を読んで、村の歴史を解き明かして、",
          "tc": "我想，你看了那些書，了解村子的歷史後，",
          "sc": "我想，你看了那些书，了解村子的历史后，"
        },
        {
          "f_idx": 43,
          "pidx_tc": 351670,
          "spk": "木助 (キスケ)",
          "ja": "勝手に問題を解決してくれるんじゃねえかと",
          "tc": "說不定就會自己出手幫我們解決問題，",
          "sc": "说不定就会自己出手帮我们解决问题，"
        },
        {
          "f_idx": 44,
          "pidx_tc": 351677,
          "spk": "木助 (キスケ)",
          "ja": "期待していた……",
          "tc": "當時我抱著這種期待……",
          "sc": "当时我抱着这种期待……"
        },
        {
          "f_idx": 45,
          "pidx_tc": 351688,
          "spk": "木助 (キスケ)",
          "ja": "そして、俺は何もせず、",
          "tc": "所以我就想著，什麼都不要做，",
          "sc": "所以我就想着，什么都不要做，"
        },
        {
          "f_idx": 46,
          "pidx_tc": 351695,
          "spk": "木助 (キスケ)",
          "ja": "見ているだけにしておこうと思っていたんだ",
          "tc": "就看著你怎麼做。",
          "sc": "就看着你怎么做。"
        },
        {
          "f_idx": 47,
          "pidx_tc": 351704,
          "spk": "木助 (キスケ)",
          "ja": "……最初はてめぇに、",
          "tc": "……起初，",
          "sc": "……起初，"
        },
        {
          "f_idx": 48,
          "pidx_tc": 351711,
          "spk": "木助 (キスケ)",
          "ja": "嫌悪感しかなかったからな",
          "tc": "我對你只有滿滿的厭惡。",
          "sc": "我对你只有满满的厌恶。"
        },
        {
          "f_idx": 49,
          "pidx_tc": 351722,
          "spk": "木助 (キスケ)",
          "ja": "だが皮肉にも、てめぇはあまりにも素直で、",
          "tc": "但諷刺的是，你實在太率真，",
          "sc": "但讽刺的是，你实在太率真，"
        },
        {
          "f_idx": 50,
          "pidx_tc": 351729,
          "spk": "木助 (キスケ)",
          "ja": "あまりにも人間だった",
          "tc": "又太像人類了。",
          "sc": "又太像人类了。"
        },
        {
          "f_idx": 52,
          "pidx_tc": 351747,
          "spk": "木助 (キスケ)",
          "ja": "監視する時間が増えるほど、",
          "tc": "隨著監視你的時間變長，",
          "sc": "随着监视你的时间变长，"
        },
        {
          "f_idx": 53,
          "pidx_tc": 351754,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの仕草が目に入った",
          "tc": "你的行為舉止我也看得越多。",
          "sc": "你的行为举止我也看得越多。"
        },
        {
          "f_idx": 54,
          "pidx_tc": 351763,
          "spk": "木助 (キスケ)",
          "ja": "人の言うことをきく時の首の傾げ方、",
          "tc": "聽人講話時輕輕歪頭的模樣，",
          "sc": "听人讲话时轻轻歪头的模样，"
        },
        {
          "f_idx": 55,
          "pidx_tc": 351770,
          "spk": "木助 (キスケ)",
          "ja": "誰かの小さな頼みを受ける時の、かすかな震え",
          "tc": "接受別人的小小請求時，那細微的顫抖。",
          "sc": "接受别人的小小请求时，那细微的颤抖。"
        },
        {
          "f_idx": 57,
          "pidx_tc": 351788,
          "spk": "木助 (キスケ)",
          "ja": "俺はいつの間にか、",
          "tc": "在不知不覺間，",
          "sc": "在不知不觉间，"
        },
        {
          "f_idx": 58,
          "pidx_tc": 351795,
          "spk": "木助 (キスケ)",
          "ja": "憎しみの端に柔らかなものが入り込むのを",
          "tc": "我不由得容許了一些柔軟的情感，",
          "sc": "我不由得容许了一些柔软的情感，"
        },
        {
          "f_idx": 59,
          "pidx_tc": 351802,
          "spk": "木助 (キスケ)",
          "ja": "許してしまったんだ……",
          "tc": "從憎惡的邊緣滲入……",
          "sc": "从憎恶的边缘渗入……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6020,
      "rec_id": "TALK_ID_10_0601_029_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 351820,
          "spk": "木助 (キスケ)",
          "ja": "そして俺はまた……",
          "tc": "然後我又再次……",
          "sc": "然后我又再次……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 351827,
          "spk": "木助 (キスケ)",
          "ja": "コダマではなく、",
          "tc": "沒有選擇木珠，",
          "sc": "没有选择木珠，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 351834,
          "spk": "木助 (キスケ)",
          "ja": "お前を選んじまったんだよな……",
          "tc": "而是選擇了你……",
          "sc": "而是选择了你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 351845,
          "spk": "木助 (キスケ)",
          "ja": "……そう、俺はお前を選んだんだ",
          "tc": "…………沒錯，我選擇了你。",
          "sc": "……没错，我选择了你。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 351852,
          "spk": "木助 (キスケ)",
          "ja": "俺は、コダマをちゃんと",
          "tc": "我打算",
          "sc": "我打算"
        },
        {
          "f_idx": 5,
          "pidx_tc": 351859,
          "spk": "木助 (キスケ)",
          "ja": "殺してやりたいと思っている",
          "tc": "確確實實地殺死木珠。",
          "sc": "确确实实地杀死木珠。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 351868,
          "spk": "木助 (キスケ)",
          "ja": "コダマも、土地神も、全部まとめて終わらせたい",
          "tc": "木珠也好，土地神也好，我想讓這一切劃下句點。",
          "sc": "木珠也好，土地神也好，我想让这一切划下句点。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 351875,
          "spk": "木助 (キスケ)",
          "ja": "助けてくれなんて願えば、",
          "tc": "要是我請求你的幫助，",
          "sc": "要是我请求你的帮助，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 351882,
          "spk": "木助 (キスケ)",
          "ja": "きっとまたお前は縛られてしまう",
          "tc": "一定又會束縛住你。",
          "sc": "一定又会束缚住你。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 351893,
          "spk": "木助 (キスケ)",
          "ja": "でももう嫌なんだ",
          "tc": "可是我已經受夠了，",
          "sc": "可是我已经受够了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 351900,
          "spk": "木助 (キスケ)",
          "ja": "縛るのも、縛られるのも",
          "tc": "無論是去束縛別人，還是作為被束縛的那一方。",
          "sc": "无论是去束缚别人，还是作为被束缚的那一方。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 351911,
          "spk": "木助 (キスケ)",
          "ja": "だからこれは、神としてのお前じゃなくて",
          "tc": "所以我這句話，不是對身為神明的你，",
          "sc": "所以我这句话，不是对身为神明的你，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 351918,
          "spk": "木助 (キスケ)",
          "ja": "ここで暮らしたお前に言いたい",
          "tc": "而是對曾經生活在這裡的你說──",
          "sc": "而是对曾经生活在这里的你说——"
        },
        {
          "f_idx": 14,
          "pidx_tc": 351936,
          "spk": "木助 (キスケ)",
          "ja": "……俺を、助けてくれないか",
          "tc": "……你可以幫幫我嗎？",
          "sc": "……你可以帮帮我吗？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 351945,
          "spk": "木助 (キスケ)",
          "ja": "終わらせたいんだ",
          "tc": "我想結束這一切。",
          "sc": "我想结束这一切。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 351952,
          "spk": "木助 (キスケ)",
          "ja": "この手で、ちゃんと終わらせたい",
          "tc": "我想親手，好好做個了結。",
          "sc": "我想亲手，好好做个了结。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 351959,
          "spk": "木助 (キスケ)",
          "ja": "誰のせいでもない場所まで、戻りたい",
          "tc": "我想回到……那個誰都沒有錯的地方。",
          "sc": "我想回到……那个谁都没有错的地方。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 351968,
          "spk": "木助 (キスケ)",
          "ja": "コダマを……",
          "tc": "為了木珠……",
          "sc": "为了木珠……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 351975,
          "spk": "木助 (キスケ)",
          "ja": "……この村のしがらみを解くために、",
          "tc": "……為了解開這座村子的枷鎖，",
          "sc": "……为了解开这座村子的枷锁，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 351982,
          "spk": "木助 (キスケ)",
          "ja": "俺に協力してはくれねぇか……?",
          "tc": "你可以協助我嗎……？",
          "sc": "你可以协助我吗……？"
        },
        {
          "f_idx": 21,
          "pidx_tc": 351991,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 22,
          "pidx_tc": 351998,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6021,
      "rec_id": "TALK_ID_10_0601_029_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352092,
          "spk": "木助 (キスケ)",
          "ja": "俺は、コダマの所へ行こうと思っている",
          "tc": "我打算到木珠那裡去。",
          "sc": "我打算到木珠那里去。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352103,
          "spk": "木助 (キスケ)",
          "ja": "生贄ってのは、人柱だ",
          "tc": "所謂的活祭品就是活人奠基。",
          "sc": "所谓的活祭品就是活人奠基。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 352110,
          "spk": "木助 (キスケ)",
          "ja": "コダマの穢れた魂は、",
          "tc": "我想木珠遭到汙染的靈魂，",
          "sc": "我想木珠遭到污染的灵魂，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 352117,
          "spk": "木助 (キスケ)",
          "ja": "土地神に縛られているんだと思う",
          "tc": "應該是被土地神束縛著。",
          "sc": "应该是被土地神束缚着。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 352126,
          "spk": "木助 (キスケ)",
          "ja": "だから、あの大穴……",
          "tc": "所以，在那個大洞……",
          "sc": "所以，在那个大洞……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 352133,
          "spk": "木助 (キスケ)",
          "ja": "岩の下に、土地神とコダマは居る",
          "tc": "在那塊岩石底下，土地神和木珠就在那裡。",
          "sc": "在那块岩石底下，土地神和木珠就在那里。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 352151,
          "spk": "木助 (キスケ)",
          "ja": "俺の力がどこまで通じるかはわからねぇが……",
          "tc": "雖然不曉得靠我的力量，能做到什麼程度……",
          "sc": "虽然不晓得靠我的力量，能做到什么程度……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 352158,
          "spk": "木助 (キスケ)",
          "ja": "もう、傍観者でいることはやめたんだ",
          "tc": "但我已經不想再當旁觀者了。",
          "sc": "但我已经不想再当旁观者了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 352174,
          "spk": "木助 (キスケ)",
          "ja": "やってやるさ……",
          "tc": "我會努力……",
          "sc": "我会努力……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 352181,
          "spk": "木助 (キスケ)",
          "ja": "やれることをな",
          "tc": "盡自己所能做的。",
          "sc": "尽自己所能做的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6022,
      "rec_id": "TALK_ID_10_0601_029_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352199,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ……邪魔したな",
          "tc": "那就這樣……打擾了。",
          "sc": "那就这样……打扰了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352206,
          "spk": "木助 (キスケ)",
          "ja": "もう寝な、<player>……",
          "tc": "快睡吧，<player>……",
          "sc": "快睡吧，<player>……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 352217,
          "spk": "木助 (キスケ)",
          "ja": "あばよ",
          "tc": "掰啦。",
          "sc": "掰啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6023,
      "rec_id": "TALK_ID_10_0601_030_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352243,
          "spk": "堇怜 (スミレ)",
          "ja": "サザンカさんは、",
          "tc": "茶梅姐，",
          "sc": "茶梅姐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352250,
          "spk": "堇怜 (スミレ)",
          "ja": "彼ヶ津村を出なきゃいけないって話、聞いた？",
          "tc": "妳有聽說有關必須離開彼津村的這件事嗎？",
          "sc": "你有听说有关必须离开彼津村的这件事吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 352257,
          "spk": "堇怜 (スミレ)",
          "ja": "本当なのかな……",
          "tc": "是真的嗎……",
          "sc": "是真的吗……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 352270,
          "spk": "茶梅 (サザンカ)",
          "ja": "んー、聞いたけど……",
          "tc": "嗯～我是有聽說……",
          "sc": "嗯～我是有听说……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 352277,
          "spk": "茶梅 (サザンカ)",
          "ja": "リンがそんな冗談言うとは、思わないからなァ",
          "tc": "但林並不是會在這種事情上開玩笑的人。",
          "sc": "但林并不是会在这种事情上开玩笑的人。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 352288,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも……正直、簡単には納得できないよね～",
          "tc": "可是……老實說沒辦法輕易地接受啊～",
          "sc": "可是……老实说没办法轻易地接受啊～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 352295,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんから受け継いだ仕事、",
          "tc": "我也必須承繼",
          "sc": "我也必须承继"
        },
        {
          "f_idx": 7,
          "pidx_tc": 352302,
          "spk": "茶梅 (サザンカ)",
          "ja": "続けられなくなっちゃうし……",
          "tc": "爺爺傳給我的工作……",
          "sc": "爷爷传给我的工作……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 352315,
          "spk": "堇怜 (スミレ)",
          "ja": "村を出るなんて……",
          "tc": "離開村子這種事……",
          "sc": "离开村子这种事……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 352322,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮があったとしても、",
          "tc": "就算有鵺皮，",
          "sc": "就算有鵺皮，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 352329,
          "spk": "堇怜 (スミレ)",
          "ja": "どんだけ時間がかかるんだろ",
          "tc": "也不知道要花多少時間。",
          "sc": "也不知道要花多少时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6024,
      "rec_id": "TALK_ID_10_0601_030_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352347,
          "spk": "堇怜 (スミレ)",
          "ja": "そもそも僕たち、",
          "tc": "說到底，",
          "sc": "说到底，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352354,
          "spk": "堇怜 (スミレ)",
          "ja": "みんなばらばらになって、どこへ行けば……",
          "tc": "我們大家各奔東西是可以去哪裡……",
          "sc": "我们大家各奔东西是可以去哪里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6025,
      "rec_id": "TALK_ID_10_0601_030_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 352376,
          "spk": "林 (リン)",
          "ja": "あら、あなたたち",
          "tc": "哎，你們",
          "sc": "哎，你们"
        },
        {
          "f_idx": 1,
          "pidx_tc": 352383,
          "spk": "林 (リン)",
          "ja": "シケた顔してどうしたのかしら",
          "tc": "怎麼一臉愁容啊。",
          "sc": "怎么一脸愁容啊。"
        }
      ]
    }
