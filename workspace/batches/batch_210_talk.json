  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5171,
      "rec_id": "TALK_ID_10_0501_103_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300301,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんも",
          "tc": "洋妹妹也一樣，",
          "sc": "洋妹妹也一样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300308,
          "spk": "六角 (ロッカク)",
          "ja": "あの家のことは忘れましょう",
          "tc": "忘了那間房子的事吧。",
          "sc": "忘了那间房子的事吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300315,
          "spk": "六角 (ロッカク)",
          "ja": "ね？",
          "tc": "好嗎？",
          "sc": "好吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300328,
          "spk": "洋 (ヨウ)",
          "ja": "……うん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 300341,
          "spk": "六角 (ロッカク)",
          "ja": "それじゃ、解散っス",
          "tc": "那我們就解散吧。",
          "sc": "那我们就解散呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 300348,
          "spk": "六角 (ロッカク)",
          "ja": "もうろくな準備もせず、",
          "tc": "以後不能什麼準備都沒做，",
          "sc": "以后不能什么准备都没做，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 300355,
          "spk": "六角 (ロッカク)",
          "ja": "山の奥に入っちゃダメっスよ",
          "tc": "就跑到深山裡喔！",
          "sc": "就跑到深山里哟！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5172,
      "rec_id": "TALK_ID_10_0501_104_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300383,
          "spk": "六角 (ロッカク)",
          "ja": "……いいっスか、ヨウさん",
          "tc": "……聽好了，洋妹妹。",
          "sc": "……听好了，洋妹妹。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300394,
          "spk": "六角 (ロッカク)",
          "ja": "山奥で見たあの家のことは、",
          "tc": "在深山裡看到那間房子的事，",
          "sc": "在深山里看到那间房子的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300401,
          "spk": "六角 (ロッカク)",
          "ja": "もう忘れたほうがいいっス",
          "tc": "妳還是忘了比較好。",
          "sc": "你还是忘了比较好呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300410,
          "spk": "六角 (ロッカク)",
          "ja": "関わったってろくなことには",
          "tc": "就算扯上關係，",
          "sc": "就算扯上关系，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 300417,
          "spk": "六角 (ロッカク)",
          "ja": "ならないっスよ",
          "tc": "也不會有好事的。",
          "sc": "也不会有好事哟。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 300430,
          "spk": "洋 (ヨウ)",
          "ja": "……でも",
          "tc": "可是……",
          "sc": "可是……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 300443,
          "spk": "六角 (ロッカク)",
          "ja": "でも？",
          "tc": "可是？",
          "sc": "可是？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 300456,
          "spk": "洋 (ヨウ)",
          "ja": "声が、聞こえたの",
          "tc": "我有聽到聲音，",
          "sc": "我听见声音了，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 300463,
          "spk": "洋 (ヨウ)",
          "ja": "わたしを呼んでた、とおもう",
          "tc": "聽起來像是在呼喚我。",
          "sc": "听起来像是在呼唤我。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 300476,
          "spk": "六角 (ロッカク)",
          "ja": "……どんな声でした？",
          "tc": "……是什麼樣的聲音？",
          "sc": "……是什么样的声音？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 300489,
          "spk": "洋 (ヨウ)",
          "ja": "えっとね……途切れ途切れに、",
          "tc": "我想想……講話斷斷續續的，",
          "sc": "我想想……讲话断断续续的，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 300496,
          "spk": "洋 (ヨウ)",
          "ja": "カンタンな言葉を使って喋るの……",
          "tc": "說的話也很簡單……",
          "sc": "说的话也很简单……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 300503,
          "spk": "洋 (ヨウ)",
          "ja": "歌に聞こえるときもあるよ",
          "tc": "有時候聽起來就像歌聲喔！",
          "sc": "有时候听起来就像歌声哦！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 300514,
          "spk": "六角 (ロッカク)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 300527,
          "spk": "洋 (ヨウ)",
          "ja": "……おじちゃん？",
          "tc": "……叔叔？",
          "sc": "……叔叔？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 300540,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、いや",
          "tc": "啊，沒什麼。",
          "sc": "啊，没什么。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 300547,
          "spk": "六角 (ロッカク)",
          "ja": "なんでもないっス",
          "tc": "什麼事也沒有。",
          "sc": "什么事也没有呐。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 300558,
          "spk": "六角 (ロッカク)",
          "ja": "とにかく、あそこは危ないっスから",
          "tc": "總之，那個地方很危險，",
          "sc": "总之，那个地方很危险，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 300565,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんはもう近づかないほうがいい",
          "tc": "所以洋妹妹，妳以後還是別再靠近那裡了。",
          "sc": "所以洋妹妹，你以后还是别再靠近那里了。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 300574,
          "spk": "六角 (ロッカク)",
          "ja": "一人で山に入るのはダメって、",
          "tc": "我之前不是告訴過妳，",
          "sc": "我之前不是告诉过你，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 300581,
          "spk": "六角 (ロッカク)",
          "ja": "前から言ってるでしょう？",
          "tc": "不可以自己一個人上山嗎？",
          "sc": "不可以自己一个人上山吗？"
        },
        {
          "f_idx": 21,
          "pidx_tc": 300594,
          "spk": "洋 (ヨウ)",
          "ja": "ごめんなさい……",
          "tc": "對不起……",
          "sc": "对不起……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 300607,
          "spk": "六角 (ロッカク)",
          "ja": "わかってくれれば、いいんスよ",
          "tc": "妳能明白就好。",
          "sc": "你能明白就好。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 300614,
          "spk": "六角 (ロッカク)",
          "ja": "あとはワシに任せてください",
          "tc": "剩下的事交給我處理吧。",
          "sc": "剩下的事交给我处理吧。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 300625,
          "spk": "洋 (ヨウ)",
          "ja": "うん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5173,
      "rec_id": "TALK_ID_10_0501_104_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300651,
          "spk": "六角 (ロッカク)",
          "ja": "……あの死体は、間違いない",
          "tc": "……那些屍體，不會錯的。",
          "sc": "……那些尸体，不会错的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300658,
          "spk": "六角 (ロッカク)",
          "ja": "けど場所が違う",
          "tc": "但是地點不同，",
          "sc": "但是地点不同，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300665,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの記憶では、もっと麓側の……",
          "tc": "我記得應該更靠近山腳那邊……",
          "sc": "我记得应该更靠近山脚那边……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300676,
          "spk": "六角 (ロッカク)",
          "ja": "……なんにしても、放置はできないっスね",
          "tc": "……無論如何，都不能放著不管呢。",
          "sc": "……无论如何，都不能放着不管呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
