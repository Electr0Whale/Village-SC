          "pidx_tc": 307003,
          "spk": "名护 (ナゴ)",
          "ja": "何か条件があるんだろう？",
          "tc": "應該是有什麼條件吧？",
          "sc": "应该是有什么条件吧？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 307016,
          "spk": "琪娜娜 (チナナ)",
          "ja": "別にないよ",
          "tc": "沒有啊。",
          "sc": "没有啊。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 307023,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは普通に行き来しているだけさ",
          "tc": "我只是正常進出村子而已。",
          "sc": "我只是正常进出村子而已。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 307034,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そもそも、村の住人になったキミは、",
          "tc": "況且，你現在已經是村裡的居民了，",
          "sc": "况且，你现在已经是村里的居民了，"
