      "rec_id": "TALK_ID_10_0502_201_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 306871,
          "spk": "琪娜娜 (チナナ)",
          "ja": "で、ナゴさん",
          "tc": "那麼，名護先生，",
          "sc": "那么，名护先生，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 306878,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何をお探しで？",
          "tc": "你想找什麼呢？",
          "sc": "你想找什么呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 306891,
          "spk": "名护 (ナゴ)",
          "ja": "あ、いや……すまない",
          "tc": "啊，不是的……不好意思。",
          "sc": "啊，不是的……不好意思。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 306898,
          "spk": "名护 (ナゴ)",
          "ja": "客じゃないんだ",
          "tc": "我不是來買東西的。",
          "sc": "我不是来买东西的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 306905,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさんに聞きたいことがある",
          "tc": "我有件事想問琪娜娜小姐。",
          "sc": "我有件事想问琪娜娜小姐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 306918,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチに？",
          "tc": "有事問我？",
          "sc": "有事问我？"
        },
