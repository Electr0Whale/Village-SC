    {
      "file": "talk.dat",
      "rec_idx": 5176,
      "rec_id": "TALK_ID_10_0501_104_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300740,
          "spk": "洋 (ヨウ)",
          "ja": "……うん、だいじょうぶ",
          "tc": "……嗯，不要緊。",
          "sc": "……嗯，不要紧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300747,
          "spk": "洋 (ヨウ)",
          "ja": "ありがとう、しんぱいしてくれて",
          "tc": "謝謝你的關心。",
          "sc": "谢谢你的关心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5177,
      "rec_id": "TALK_ID_10_0501_104_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300765,
          "spk": "洋 (ヨウ)",
          "ja": "――キミは、",
          "tc": "……我想，",
          "sc": "……我想，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300772,
          "spk": "洋 (ヨウ)",
          "ja": "たすけてほしいんだよね？",
          "tc": "你希望我幫你對吧？",
          "sc": "你希望我帮你对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5178,
      "rec_id": "TALK_ID_10_0501_105_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300796,
          "spk": "裕太 (ユータ)",
          "ja": "……やあ",
          "tc": "……嗨。",
          "sc": "……嗨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300803,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと話、聞いてくれないかな",
          "tc": "我有點事想跟你說，方便嗎？",
          "sc": "我有点事想跟你说，方便吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300814,
          "spk": "裕太 (ユータ)",
          "ja": "急にごめん",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300821,
          "spk": "裕太 (ユータ)",
          "ja": "いきなり訪ねて来て、",
          "tc": "突然來找你，",
          "sc": "突然来找你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 300828,
          "spk": "裕太 (ユータ)",
          "ja": "迷惑かもしれないけど……",
          "tc": "可能造成你的困擾了……",
          "sc": "可能造成你的困扰了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5179,
      "rec_id": "TALK_ID_10_0501_105_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300846,
          "spk": "裕太 (ユータ)",
          "ja": "……よかった",
          "tc": "……太好了。",
          "sc": "……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300857,
          "spk": "裕太 (ユータ)",
          "ja": "話っていうのはもちろん",
          "tc": "我要講的，",
          "sc": "我要讲的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300864,
          "spk": "裕太 (ユータ)",
          "ja": "山奥で見つけた",
          "tc": "當然是之前在深山裡",
          "sc": "当然是之前在深山里"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300871,
          "spk": "裕太 (ユータ)",
          "ja": "あの家のことなんだけど",
          "tc": "發現的那間房子。",
          "sc": "发现的那间房子。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 300882,
          "spk": "裕太 (ユータ)",
          "ja": "<player>はあの時、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 300889,
          "spk": "裕太 (ユータ)",
          "ja": "家の中は見ていなかったよね……？",
          "tc": "你當時沒有往房子裡面看對吧……？",
          "sc": "你当时没有往房子里面看对吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5180,
      "rec_id": "TALK_ID_10_0501_105_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300907,
          "spk": "裕太 (ユータ)",
          "ja": "そっか",
          "tc": "這樣啊，",
          "sc": "这样啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300914,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、あれを知っているのは",
          "tc": "既然這樣，",
          "sc": "既然这样，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 300921,
          "spk": "裕太 (ユータ)",
          "ja": "俺だけなのか……",
          "tc": "知道那件事的應該只有我了……",
          "sc": "知道那件事的应该只有我了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 300932,
          "spk": "裕太 (ユータ)",
          "ja": "驚かないで聞いて欲しいんだけど、",
          "tc": "你聽了別嚇到，",
          "sc": "你听了别吓到，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 300939,
          "spk": "裕太 (ユータ)",
          "ja": "俺はあの時、あの家の窓から――",
          "tc": "我當時，透過那間房子的窗戶──",
          "sc": "我当时，透过那间房子的窗户——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5181,
      "rec_id": "TALK_ID_10_0501_105_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300955,
          "spk": "裕太 (ユータ)",
          "ja": "<strong>死体を、見たんだ</strong>",
          "tc": "<strong>看到了屍體。</strong>",
          "sc": "<strong>看到了尸体。</strong>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 300966,
          "spk": "裕太 (ユータ)",
          "ja": "それも……<strong>二人の人が、 ",
          "tc": "而且……看起來就像是 ",
          "sc": "而且……看起来就像是 "
        },
        {
          "f_idx": 2,
          "pidx_tc": 300973,
          "spk": "裕太 (ユータ)",
          "ja": "互いに刺し合っている</strong>ように見えた……",
          "tc": "<strong>兩個人互相刺殺</strong>……",
          "sc": "<strong>两个人互相刺杀</strong>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5182,
      "rec_id": "TALK_ID_10_0501_105_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 300998,
          "spk": "裕太 (ユータ)",
          "ja": "近ごろ、この村は",
          "tc": "最近這座村子裡，",
          "sc": "最近这座村子里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 301005,
          "spk": "裕太 (ユータ)",
          "ja": "色んな事件が起こってるだろう？",
          "tc": "發生了很多事件對吧？",
          "sc": "发生了很多事件对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 301012,
          "spk": "裕太 (ユータ)",
          "ja": "その、幽霊的な意味で",
          "tc": "我是指，比較「靈異」的那種。",
          "sc": "我是指，比较“灵异”的那种。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 301023,
          "spk": "裕太 (ユータ)",
          "ja": "前までは幽霊なんて",
          "tc": "在這之前，",
          "sc": "在这之前，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 301030,
          "spk": "裕太 (ユータ)",
          "ja": "全然信じていなかったんだけど……",
          "tc": "我完全不相信幽靈之類的存在……",
          "sc": "我完全不相信幽灵之类的存在……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 301041,
          "spk": "裕太 (ユータ)",
          "ja": "もしあの死体の魂に、",
          "tc": "但如果正在呼喚小洋的，",
          "sc": "但如果正在呼唤小洋的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 301048,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんが呼ばれているんだとしたら……",
          "tc": "是那些屍體的靈魂……",
          "sc": "是那些尸体的灵魂……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 301059,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんが危険だ……！",
          "tc": "小洋就危險了……！",
          "sc": "小洋就危险了……！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 301066,
          "spk": "裕太 (ユータ)",
          "ja": "……あの声は、ヨウちゃんを向こう側に",
          "tc": "……那個聲音，",
          "sc": "……那个声音，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 301073,
          "spk": "裕太 (ユータ)",
          "ja": "道連れにしようとしてるんだよ……！",
