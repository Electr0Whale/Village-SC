      "rec_id": "TALK_ID_10_0501_136_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305531,
          "spk": "？？？ (未知角色)",
          "ja": "オカエリ！　オカエリ！　オカエリ！",
          "tc": "歡迎回來！歡迎回來！歡迎回來！",
          "sc": "欢迎回来！欢迎回来！欢迎回来！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305544,
          "spk": "洋 (ヨウ)",
          "ja": "鳥さん、おしゃべりじょうずだね……！",
          "tc": "小鳥好會講話呢……！",
          "sc": "小鸟好会讲话呢……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5304,
      "rec_id": "TALK_ID_10_0501_136_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305570,
          "spk": "裕太 (ユータ)",
          "ja": "まさか……",
          "tc": "難道說……",
          "sc": "难道说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305577,
          "spk": "裕太 (ユータ)",
          "ja": "山からの声の正体ってこのオウム……？",
          "tc": "山裡傳來的聲音，其實是來自這隻鸚鵡……？",
          "sc": "山里传来的声音，其实是来自这只鹦鹉……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305584,
          "spk": "裕太 (ユータ)",
          "ja": "でも、どうやって今まで生きてたんだ……？",
          "tc": "可是牠怎麼有辦法活到現在……？",
          "sc": "可是它怎么有办法活到现在……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305597,
          "spk": "六角 (ロッカク)",
          "ja": "うーん……多分、普通のオウムじゃ",
          "tc": "嗯，我猜……",
          "sc": "嗯，我猜……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305604,
          "spk": "六角 (ロッカク)",
          "ja": "なくなってしまっている気がするっスけど……",
          "tc": "牠可能已經不是普通的鸚鵡了……",
          "sc": "它可能已经不是普通的鹦鹉了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 305615,
          "spk": "六角 (ロッカク)",
          "ja": "はーっ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 305622,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんを呼んでいたのはご両親じゃなくて、",
          "tc": "原來一直呼喚著洋妹妹的，並不是她的父母，",
          "sc": "原来一直呼唤着洋妹妹的，并不是她的父母，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 305629,
          "spk": "六角 (ロッカク)",
          "ja": "あの家で飼われていたコイツだったのか……",
          "tc": "而是以前養在那間房子裡的這傢伙啊……",
          "sc": "而是以前养在那间房子里的这家伙啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5305,
      "rec_id": "TALK_ID_10_0501_137_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305657,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、ヨウさん",
          "tc": "洋妹妹，妳看。",
          "sc": "洋妹妹，你看。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305664,
          "spk": "六角 (ロッカク)",
          "ja": "ご要望通り、助けたっスよ",
          "tc": "如妳所願，牠得救囉。",
          "sc": "如你所愿，它得救哟。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305677,
          "spk": "洋 (ヨウ)",
          "ja": "わぁ……！",
          "tc": "哇……！",
          "sc": "哇……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305688,
          "spk": "洋 (ヨウ)",
          "ja": "ね、キミの名前は？",
          "tc": "你叫什麼名字？",
          "sc": "你叫什么名字？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305699,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "オワン！　オワン！",
          "tc": "歐宛！歐宛！",
          "sc": "欧宛！欧宛！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 305712,
          "spk": "洋 (ヨウ)",
          "ja": "そっか、オワンっていうんだ",
          "tc": "哦，原來你叫歐宛啊。",
          "sc": "哦，原来你叫欧宛啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5306,
      "rec_id": "TALK_ID_10_0501_137_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305742,
          "spk": "洋 (ヨウ)",
          "ja": "わたしに、ずっと話しかけていたのは、",
          "tc": "之前一直在跟我講話的，",
          "sc": "之前一直在跟我讲话的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305749,
          "spk": "洋 (ヨウ)",
          "ja": "オワンだったんだね",
          "tc": "原來是歐宛呢。",
          "sc": "原来是欧宛呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305760,
          "spk": "洋 (ヨウ)",
          "ja": "オワン、ありがとう",
          "tc": "歐宛，謝謝你。",
          "sc": "欧宛，谢谢你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305767,
          "spk": "洋 (ヨウ)",
          "ja": "ずっとわたしを、呼んでいてくれて……",
          "tc": "是你一直呼喚我……",
          "sc": "是你一直呼唤我……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305774,
          "spk": "洋 (ヨウ)",
          "ja": "わたしも、ずっとキミに会いたかったよ",
          "tc": "我也一直很想去見你！",
          "sc": "我也一直很想去见你！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 305787,
          "spk": "裕太 (ユータ)",
          "ja": "たしかに歌が上手だなとは思ってたけど",
          "tc": "我之前的確想說那個歌聲還滿好聽的，",
          "sc": "我之前的确想说那个歌声还满好听的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 305794,
          "spk": "裕太 (ユータ)",
          "ja": "まさかオウムの歌声だったなんてね……",
          "tc": "沒想到居然是鸚鵡的歌聲呢……",
          "sc": "没想到居然是鹦鹉的歌声呢……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 305814,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんのご両親は、",
          "tc": "洋妹妹的父母，",
          "sc": "洋妹妹的父母，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 305821,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんだけじゃなくて",
          "tc": "是不是希望不只是洋妹妹，",
          "sc": "是不是希望不只是洋妹妹，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 305828,
          "spk": "六角 (ロッカク)",
          "ja": "この子も助けて欲しかったんスかね……",
          "tc": "還希望這孩子也能得救呢……",
          "sc": "还希望这孩子也能得救呢……"
        }
      ]
    },
    {
