          "pidx_tc": 306938,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、どうにかして",
          "tc": "我需要想辦法",
          "sc": "我需要想办法"
        },
        {
          "f_idx": 8,
          "pidx_tc": 306945,
          "spk": "名护 (ナゴ)",
          "ja": "村から出たいんだ",
          "tc": "離開村子。",
          "sc": "离开村子。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 306956,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさんが村から出ている",
          "tc": "可以請琪娜娜小姐告訴我，",
          "sc": "可以请琪娜娜小姐告诉我，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 306963,
          "spk": "名护 (ナゴ)",
          "ja": "方法を教えてもらえないか？",
          "tc": "妳是怎麼離開村子的嗎？",
          "sc": "你是怎么离开村子的吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 306976,
          "spk": "琪娜娜 (チナナ)",
          "ja": "またその話か～……",
          "tc": "又是這件事啊……",
          "sc": "又是这件事啊……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 306989,
          "spk": "名护 (ナゴ)",
          "ja": "どうしてチナナさんだけが",
          "tc": "為什麼只有琪娜娜小姐，",
          "sc": "为什么只有琪娜娜小姐，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 306996,
          "spk": "名护 (ナゴ)",
          "ja": "村を出入りできるんだ？",
          "tc": "能夠自由進出村子呢？",
