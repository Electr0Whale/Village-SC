      "rec_id": "TALK_ID_10_0502_201_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 306551,
          "spk": "堇怜 (スミレ)",
          "ja": "おー、<player>！",
          "tc": "哦～<player>！",
          "sc": "哦～<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 306558,
          "spk": "堇怜 (スミレ)",
          "ja": "実はキミに会いたかったんだぜ！",
          "tc": "其實我早就想去見你了！",
          "sc": "其实我早就想去见你了！"
