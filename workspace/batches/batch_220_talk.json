  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5633,
      "rec_id": "TALK_ID_10_0503_329_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 327651,
          "spk": "驹子 (コマコ)",
          "ja": "……ごめんね",
          "tc": "……對不起，",
          "sc": "……对不起，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 327658,
          "spk": "驹子 (コマコ)",
          "ja": "本当に、ごめんなさい",
          "tc": "真的很對不起。",
          "sc": "真的很对不起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 327667,
          "spk": "驹子 (コマコ)",
          "ja": "覚えてないけど、でも、",
          "tc": "雖然我不記得了，",
          "sc": "虽然我不记得了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 327674,
          "spk": "驹子 (コマコ)",
          "ja": "私がサザンカさんのお父さんと",
          "tc": "但是，聽說是我殺了",
          "sc": "但是，听说是我杀了"
        },
        {
          "f_idx": 4,
          "pidx_tc": 327681,
          "spk": "驹子 (コマコ)",
          "ja": "お母さんを殺したんだって",
          "tc": "茶梅姐的爸爸媽媽……",
          "sc": "茶梅姐的爸爸妈妈……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 327692,
          "spk": "驹子 (コマコ)",
          "ja": "忘れてて、ごめんなさい",
          "tc": "對不起，我不記得了。",
          "sc": "对不起，我不记得了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 327699,
          "spk": "驹子 (コマコ)",
          "ja": "まだちゃんと思い出せなくてごめんなさい",
          "tc": "對不起，我還沒有辦法想起來。",
          "sc": "对不起，我还没有办法想起来。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 327706,
          "spk": "驹子 (コマコ)",
          "ja": "謝っても取り返しがつかないよね",
          "tc": "但我就算道歉，也無法挽回對吧。",
          "sc": "但我就算道歉，也无法挽回对吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 327719,
          "spk": "茶梅 (サザンカ)",
          "ja": "……んーと",
          "tc": "……嗯～",
          "sc": "……嗯～"
        },
        {
          "f_idx": 9,
          "pidx_tc": 327726,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんで急にそんなこと言うの？",
          "tc": "妳怎麼突然說這種話？",
          "sc": "你怎么突然说这种话？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 327733,
          "spk": "茶梅 (サザンカ)",
          "ja": "黙ってりゃよかったじゃん",
          "tc": "明明別提就好了嘛。",
          "sc": "明明别提就好了嘛。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 327746,
          "spk": "驹子 (コマコ)",
          "ja": "……知ったからには、",
          "tc": "……我覺得，既然已經知道了，",
          "sc": "……我觉得，既然已经知道了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 327753,
          "spk": "驹子 (コマコ)",
          "ja": "謝って、罪滅ぼしをしなくちゃって思って……",
          "tc": "就必須道歉還有贖罪才行……",
          "sc": "就必须道歉还有赎罪才行……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 327771,
          "spk": "驹子 (コマコ)",
          "ja": "私、もう一度あの藪に行くよ",
          "tc": "我會再到草叢去一次。",
          "sc": "我会再到草丛去一次。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 327778,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんが言っていた「獣」に会わなくちゃ",
          "tc": "為了恢復所有的記憶，",
          "sc": "为了恢复所有的记忆，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 327785,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんと全部を思い出すためにも……",
          "tc": "必須去見哥哥提到的「野獸」才行……",
          "sc": "必须去见哥哥提到的“野兽”才行……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 327796,
          "spk": "驹子 (コマコ)",
          "ja": "記憶とサザンカさんの家の家宝を、",
          "tc": "我想取回",
          "sc": "我想取回"
        },
        {
          "f_idx": 18,
          "pidx_tc": 327803,
          "spk": "驹子 (コマコ)",
          "ja": "取り戻したいの",
          "tc": "我的記憶和茶梅姐家的傳家寶。",
          "sc": "我的记忆和茶梅姐家的传家宝。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 327814,
          "spk": "驹子 (コマコ)",
          "ja": "この村を救う手助けをすれば、",
          "tc": "幫忙拯救村子的話，",
          "sc": "帮忙拯救村子的话，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 327821,
          "spk": "驹子 (コマコ)",
          "ja": "少しは私がしたことの",
          "tc": "或許能對我過去的行為",
          "sc": "或许能对我过去的行为"
        },
        {
          "f_idx": 21,
          "pidx_tc": 327828,
          "spk": "驹子 (コマコ)",
          "ja": "罪滅ぼしになるんじゃないかなって……",
          "tc": "做出一些彌補吧……",
          "sc": "做出一些弥补吧……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 327841,
          "spk": "茶梅 (サザンカ)",
          "ja": "……ヤッバ",
          "tc": "……天啊！",
          "sc": "……天啊！"
        },
        {
          "f_idx": 23,
          "pidx_tc": 327848,
          "spk": "茶梅 (サザンカ)",
          "ja": "てことはさ、じいちゃんが「家宝」を",
          "tc": "所以意思也就是說，",
          "sc": "所以意思也就是说，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 327855,
          "spk": "茶梅 (サザンカ)",
          "ja": "その獣に渡したってことじゃん……？",
          "tc": "爺爺把「傳家寶」給了那頭野獸對吧……？",
          "sc": "爷爷把“传家宝”给了那头野兽对吧……？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 327866,
          "spk": "茶梅 (サザンカ)",
          "ja": "やっぱ埋蔵金あるんじゃん！",
          "tc": "果然地下寶藏是存在的！",
          "sc": "果然地下宝藏是存在的！"
        },
        {
          "f_idx": 26,
          "pidx_tc": 327873,
          "spk": "茶梅 (サザンカ)",
          "ja": "うわ、テンション上がる！",
          "tc": "哇～真讓人興奮！",
          "sc": "哇～真让人兴奋！"
        },
        {
          "f_idx": 27,
          "pidx_tc": 327880,
          "spk": "茶梅 (サザンカ)",
          "ja": "アツーイ！！",
          "tc": "太熱血沸騰了！！",
          "sc": "太热血沸腾了！！"
        },
        {
          "f_idx": 28,
          "pidx_tc": 327893,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……あ、あれ……",
          "tc": "咦……那、那個……",
          "sc": "咦……那、那个……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 327906,
          "spk": "茶梅 (サザンカ)",
          "ja": "え？　どした？",
          "tc": "欸？怎麼了？",
          "sc": "诶？怎么了？"
        },
        {
          "f_idx": 30,
          "pidx_tc": 327919,
          "spk": "驹子 (コマコ)",
          "ja": "……あの、怒らないの？",
          "tc": "……請問，妳不生氣嗎？",
          "sc": "……请问，你不生气吗？"
        },
        {
          "f_idx": 31,
          "pidx_tc": 327926,
          "spk": "驹子 (コマコ)",
          "ja": "私が、サザンカさんの両親を……",
          "tc": "是我把茶梅姐的爸媽給……",
          "sc": "是我把茶梅姐的爸妈给……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 327939,
          "spk": "茶梅 (サザンカ)",
          "ja": "あー……それね",
          "tc": "啊……那個啊。",
          "sc": "啊……那个啊。"
        },
        {
          "f_idx": 33,
          "pidx_tc": 327950,
          "spk": "茶梅 (サザンカ)",
          "ja": "……まあ、うん",
          "tc": "……總之，嗯。",
          "sc": "……总之，嗯。"
        },
        {
          "f_idx": 34,
          "pidx_tc": 327957,
          "spk": "茶梅 (サザンカ)",
          "ja": "怒ってないし、恨んでもないよ",
          "tc": "我既不生妳的氣，也不恨妳喔。",
          "sc": "我既不生你的气，也不恨你哦。"
        },
        {
          "f_idx": 35,
          "pidx_tc": 327970,
          "spk": "驹子 (コマコ)",
          "ja": "え……でも……",
          "tc": "咦……可是……",
          "sc": "咦……可是……"
        },
        {
          "f_idx": 36,
          "pidx_tc": 327983,
          "spk": "茶梅 (サザンカ)",
          "ja": "だって、コマコが悪いワケじゃない",
          "tc": "畢竟那又不是駒子的錯。",
          "sc": "毕竟那又不是驹子的错。"
        },
        {
          "f_idx": 37,
          "pidx_tc": 327990,
          "spk": "茶梅 (サザンカ)",
          "ja": "なにか悪いものに憑かれたって",
          "tc": "我聽說，",
          "sc": "我听说，"
        },
        {
          "f_idx": 38,
          "pidx_tc": 327997,
          "spk": "茶梅 (サザンカ)",
          "ja": "そう聞いているから",
          "tc": "妳是被某種壞東西附身了。",
          "sc": "你是被某种坏东西附身了。"
        },
        {
          "f_idx": 39,
          "pidx_tc": 328008,
          "spk": "茶梅 (サザンカ)",
          "ja": "責めたって",
          "tc": "所以就算責怪妳",
          "sc": "所以就算责怪你"
        },
        {
          "f_idx": 40,
          "pidx_tc": 328015,
          "spk": "茶梅 (サザンカ)",
          "ja": "どうにもならないでしょ",
          "tc": "也無濟於事吧。",
          "sc": "也无济于事吧。"
        },
        {
          "f_idx": 41,
          "pidx_tc": 328028,
          "spk": "驹子 (コマコ)",
          "ja": "……ごめんね、サザンカさん",
          "tc": "……對不起，茶梅姐，",
          "sc": "……对不起，茶梅姐，"
        },
        {
          "f_idx": 42,
          "pidx_tc": 328035,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんなさい……",
          "tc": "真的很對不起……",
          "sc": "真的很对不起……"
        },
        {
          "f_idx": 43,
          "pidx_tc": 328042,
          "spk": "驹子 (コマコ)",
          "ja": "私、罪を償うためならなんでもするから……",
          "tc": "為了贖罪，我什麼都願意做……",
          "sc": "为了赎罪，我什么都愿意做……"
        },
        {
          "f_idx": 44,
          "pidx_tc": 328055,
          "spk": "茶梅 (サザンカ)",
          "ja": "それよりさ、また藪に行くんだ？",
          "tc": "先不說這個了，妳要再到草叢去對吧？",
          "sc": "先不说这个了，你要再到草丛去对吧？"
        },
        {
          "f_idx": 46,
          "pidx_tc": 328075,
          "spk": "驹子 (コマコ)",
          "ja": "……うん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        },
        {
          "f_idx": 47,
          "pidx_tc": 328082,
          "spk": "驹子 (コマコ)",
          "ja": "山の藪、この前行った時に",
          "tc": "我之前到山上的草叢去時，",
          "sc": "我之前到山上的草丛去时，"
        },
        {
          "f_idx": 48,
          "pidx_tc": 328089,
          "spk": "驹子 (コマコ)",
          "ja": "雰囲気がおかしかったんだ",
          "tc": "那裡的感覺很奇怪。",
          "sc": "那里的感觉很奇怪。"
        },
        {
          "f_idx": 49,
          "pidx_tc": 328100,
          "spk": "驹子 (コマコ)",
          "ja": "もしかしたら、私が行かないと",
          "tc": "說不定我必須在場，",
          "sc": "说不定我必须在场，"
        },
        {
          "f_idx": 50,
          "pidx_tc": 328107,
          "spk": "驹子 (コマコ)",
          "ja": "その獣がいるところには辿り着けないのかも……",
          "tc": "才有辦法到達那頭野獸的所在之處……",
          "sc": "才有办法到达那头野兽的所在之处……"
        },
        {
          "f_idx": 51,
          "pidx_tc": 328120,
          "spk": "茶梅 (サザンカ)",
          "ja": "はっは～ん、そういうことね",
          "tc": "哦～原來是這麼回事。",
          "sc": "哦～原来是这么回事。"
        },
        {
          "f_idx": 52,
          "pidx_tc": 328127,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、マシンで探すのは",
          "tc": "那麼，探測器要找的",
          "sc": "那么，探测器要找的"
        },
        {
          "f_idx": 53,
          "pidx_tc": 328134,
          "spk": "茶梅 (サザンカ)",
          "ja": "埋蔵金じゃなくて藪にいる動物かァ",
          "tc": "就不是地下寶藏，而是草叢裡的動物了吧。",
          "sc": "就不是地下宝藏，而是草丛里的动物了吧。"
        },
        {
          "f_idx": 54,
          "pidx_tc": 328145,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああ、こうしちゃいられない！",
          "tc": "啊啊，我也不能繼續閒著了！",
          "sc": "啊啊，我也不能继续闲着了！"
        },
        {
          "f_idx": 55,
          "pidx_tc": 328152,
          "spk": "茶梅 (サザンカ)",
          "ja": "ダウジングマシンのチューニングしなきゃ！",
          "tc": "得去調整探測器才行！",
          "sc": "得去调整探测器才行！"
        },
        {
          "f_idx": 56,
          "pidx_tc": 328159,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシ、ワクワクしてきたよ！",
          "tc": "我開始興奮起來了！",
          "sc": "我开始兴奋起来了！"
        },
        {
          "f_idx": 57,
          "pidx_tc": 328172,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……サザンカさん、",
          "tc": "咦……茶梅姐，",
          "sc": "咦……茶梅姐，"
        },
        {
          "f_idx": 58,
          "pidx_tc": 328179,
          "spk": "驹子 (コマコ)",
          "ja": "一緒に来てくれるの？",
          "tc": "妳願意一起來嗎？",
          "sc": "你愿意一起来吗？"
        },
        {
          "f_idx": 59,
          "pidx_tc": 328192,
          "spk": "茶梅 (サザンカ)",
          "ja": "あたりまえっしょ！",
          "tc": "那還用說！",
          "sc": "那还用说！"
        },
        {
          "f_idx": 60,
          "pidx_tc": 328199,
          "spk": "茶梅 (サザンカ)",
          "ja": "埋蔵金、見つけ出さなきゃ",
          "tc": "我得找出地下寶藏才行。",
          "sc": "我得找出地下宝藏才行。"
        },
        {
          "f_idx": 61,
          "pidx_tc": 328210,
          "spk": "茶梅 (サザンカ)",
          "ja": "マシンの操作はアタシに任せてよ",
          "tc": "操作探測器的部分包在我身上，",
          "sc": "操作探测器的部分包在我身上，"
        },
        {
          "f_idx": 62,
          "pidx_tc": 328217,
          "spk": "茶梅 (サザンカ)",
          "ja": "その代わり、山の獣はコマコに任せるから",
          "tc": "相對地，山裡的野獸就交給駒子處理了。",
          "sc": "相对地，山里的野兽就交给驹子处理了。"
        },
        {
          "f_idx": 64,
          "pidx_tc": 328237,
          "spk": "驹子 (コマコ)",
          "ja": "うん、わかった",
          "tc": "嗯，我知道了。",
          "sc": "嗯，我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5634,
      "rec_id": "TALK_ID_10_0503_329_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 328263,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねえ、<player>も一緒に来るでしょ？",
          "tc": "我說，<player>你也會一起來對吧？",
          "sc": "我说，<player>你也会一起来对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 328272,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 2,
          "pidx_tc": 328279,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5635,
      "rec_id": "TALK_ID_10_0503_329_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 328299,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 328306,
          "spk": "驹子 (コマコ)",
          "ja": "いたんだね",
          "tc": "原來你也在這裡啊。",
          "sc": "原来你也在这里啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 328317,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……無理に",
          "tc": "<player>……你可以不用勉強自己",
          "sc": "<player>……你可以不用勉强自己"
        },
        {
          "f_idx": 3,
          "pidx_tc": 328324,
          "spk": "驹子 (コマコ)",
          "ja": "一緒に来なくても大丈夫だよ",
          "tc": "陪我一起去喔。",
          "sc": "陪我一起去哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5636,
      "rec_id": "TALK_ID_10_0503_329_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 328342,
          "spk": "茶梅 (サザンカ)",
          "ja": "人が多いほうが",
          "tc": "人越多就越容易",
          "sc": "人越多就越容易"
        },
        {
          "f_idx": 1,
          "pidx_tc": 328349,
          "spk": "茶梅 (サザンカ)",
