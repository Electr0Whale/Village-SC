  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5518,
      "rec_id": "TALK_ID_10_0502_218_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322668,
          "spk": "名护 (ナゴ)",
          "ja": "単語の意味がわからなかったら",
          "tc": "如果不知道單字的意思，",
          "sc": "如果不知道单字的意思，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 322675,
          "spk": "名护 (ナゴ)",
          "ja": "まず辞書を引きなさい",
          "tc": "就先查辭典。",
          "sc": "就先查辞典。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 322686,
          "spk": "名护 (ナゴ)",
          "ja": "それでもわからなかったら",
          "tc": "要是查了之後還是不懂，",
          "sc": "要是查了之后还是不懂，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 322693,
          "spk": "名护 (ナゴ)",
          "ja": "質問するといいよ",
          "tc": "就來問我。",
          "sc": "就来问我。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 322713,
          "spk": "堇怜 (スミレ)",
          "ja": "……はーい",
          "tc": "……好……",
          "sc": "……好……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 322726,
          "spk": "名护 (ナゴ)",
          "ja": "それにしても、急に勉強なんて",
          "tc": "話說回來，你怎麼會突然開始念書，",
          "sc": "话说回来，你怎么会突然开始念书，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 322733,
          "spk": "名护 (ナゴ)",
          "ja": "どういう心変わりだ？",
          "tc": "是有了什麼心境變化嗎？",
          "sc": "是有了什么心境变化吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 322746,
          "spk": "堇怜 (スミレ)",
          "ja": "んー……なんていうか",
          "tc": "嗯……怎麼說呢，",
          "sc": "嗯……怎么说呢，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 322753,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は、知らない事が",
          "tc": "我覺得，",
          "sc": "我觉得，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 322760,
          "spk": "堇怜 (スミレ)",
          "ja": "たくさんあるんだなと思ってさ",
          "tc": "自己不懂的事情太多了。",
          "sc": "自己不懂的事情太多了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 322769,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさんは村の外から来たのに",
          "tc": "名護哥明明是從村外來的，",
          "sc": "名护哥明明是从村外来的，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 322776,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮のこと、よく知ってたでしょ",
          "tc": "卻很了解鵺皮對吧？",
          "sc": "却很了解鵺皮对吧？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 322794,
          "spk": "堇怜 (スミレ)",
          "ja": "それに比べて、僕は",
          "tc": "相較之下，",
          "sc": "相较之下，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 322801,
          "spk": "堇怜 (スミレ)",
          "ja": "何も知らなさすぎたなって",
          "tc": "我實在是太無知了，",
          "sc": "我实在是太无知了，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 322808,
          "spk": "堇怜 (スミレ)",
          "ja": "恥ずかしくなったんだ",
          "tc": "覺得有點丟臉……",
          "sc": "觉得有点丢脸……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 322819,
          "spk": "堇怜 (スミレ)",
          "ja": "だから僕は、",
          "tc": "所以我決定了！",
          "sc": "所以我决定了！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 322826,
          "spk": "堇怜 (スミレ)",
          "ja": "村のことをもっと知りたい",
          "tc": "我要更了解這座村子。",
          "sc": "我要更了解这座村子。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 322837,
          "spk": "堇怜 (スミレ)",
          "ja": "それから、ちゃんと勉強もしてさ",
          "tc": "然後也要好好念書，",
          "sc": "然后也要好好念书，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 322844,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんのこと、本当の意味で",
          "tc": "希望有一天，",
          "sc": "希望有一天，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 322851,
          "spk": "堇怜 (スミレ)",
          "ja": "助けられるようになりたいんだ",
          "tc": "能夠真正幫上姊姊的忙。",
          "sc": "能够真正帮上姐姐的忙。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 322864,
          "spk": "名护 (ナゴ)",
          "ja": "うん、いいんじゃないか",
          "tc": "嗯，這樣很棒啊。",
          "sc": "嗯，这样很棒啊。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 322875,
          "spk": "名护 (ナゴ)",
          "ja": "俺ができることがあれば手伝うよ",
          "tc": "我可以在能力所及的範圍協助你喔！",
          "sc": "我可以在能力所及的范围协助你哦！"
        },
        {
          "f_idx": 24,
          "pidx_tc": 322882,
          "spk": "名护 (ナゴ)",
          "ja": "わからないことがあったら聞いてくれ",
          "tc": "要是碰到什麼不懂的，就來問我吧。",
          "sc": "要是碰到什么不懂的，就来问我吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5519,
      "rec_id": "TALK_ID_10_0502_218_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322909,
          "spk": "堇怜 (スミレ)",
          "ja": "え、ちょっと待ってよ！",
          "tc": "咦，等一下啦！",
          "sc": "咦，等一下啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 322916,
          "spk": "堇怜 (スミレ)",
          "ja": "わからないことだらけだって！",
          "tc": "就說我有超多不懂的地方了！",
          "sc": "就说我有超多不懂的地方了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5520,
      "rec_id": "TALK_ID_10_0502_218_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 322936,
          "spk": "堇怜 (スミレ)",
          "ja": "まずさ、これなんて読むの？",
          "tc": "首先啊，這個字要怎麼念？",
          "sc": "首先啊，这个字要怎么念？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 322943,
          "spk": "堇怜 (スミレ)",
          "ja": "読み方わかんなかったら",
          "tc": "不知道念法的話，",
          "sc": "不知道念法的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 322950,
          "spk": "堇怜 (スミレ)",
          "ja": "辞書も引けないよ！",
          "tc": "根本沒辦法查辭典啊！",
          "sc": "根本没办法查辞典啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 322961,
          "spk": "堇怜 (スミレ)",
          "ja": "ていうか、教えてほしいことが",
          "tc": "應該說，希望你教我的東西",
          "sc": "应该说，希望你教我的东西"
        },
        {
          "f_idx": 4,
          "pidx_tc": 322968,
          "spk": "堇怜 (スミレ)",
          "ja": "ありすぎるんだけど！？",
          "tc": "實在有太多了！！",
          "sc": "实在有太多了！！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 322979,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさん、どっか行かないでよ！",
          "tc": "名護哥，你可別去其他地方喔！",
          "sc": "名护哥，你可别去其他地方哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 322986,
          "spk": "堇怜 (スミレ)",
          "ja": "村にずっといてよー！",
          "tc": "永遠待在村子裡嘛～！",
          "sc": "永远待在村子里嘛～！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 322999,
          "spk": "名护 (ナゴ)",
          "ja": "……あのねぇ",
          "tc": "……我說你啊，",
          "sc": "……我说你啊，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 323006,
          "spk": "名护 (ナゴ)",
          "ja": "もうちょっと自分で考えるんだ",
          "tc": "你要自己先多動動腦。",
          "sc": "你要自己先多动动脑。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 323019,
          "spk": "堇怜 (スミレ)",
          "ja": "えー！？",
          "tc": "咦～！？",
          "sc": "咦～！？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 323030,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあさ、ちゃんと考えるから",
          "tc": "好，那我會好好動腦的，",
          "sc": "好，那我会好好动脑的，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 323037,
          "spk": "堇怜 (スミレ)",
          "ja": "そしたらナゴさん、ずっと村にいてくれる？",
          "tc": "名護哥就會永遠待在村子裡嗎？",
          "sc": "名护哥就会永远待在村子里吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 323057,
          "spk": "名护 (ナゴ)",
          "ja": "……なんでだよ",
          "tc": "……為什麼啊？",
          "sc": "……为什么啊？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 323070,
          "spk": "堇怜 (スミレ)",
          "ja": "だって、ナゴさんがいたら",
          "tc": "因為，名護哥在的話，",
          "sc": "因为，名护哥在的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 323077,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強教えてもらえるし",
          "tc": "就有人可以教我念書。",
          "sc": "就有人可以教我念书。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 323088,
          "spk": "堇怜 (スミレ)",
          "ja": "また姉さんとチナナさんが悪だくみしてても",
          "tc": "而且姊姊和琪娜娜姐又有什麼奸計，",
          "sc": "而且姐姐和琪娜娜姐又有什么奸计，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 323095,
          "spk": "堇怜 (スミレ)",
          "ja": "秘密を暴けると思うんだよね",
          "tc": "也有辦法揭發她們嘛。",
          "sc": "也有办法揭发她们嘛。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 323115,
          "spk": "名护 (ナゴ)",
          "ja": "悪だくみ呼ばわりは",
          "tc": "用奸計來形容",
          "sc": "用奸计来形容"
        },
        {
          "f_idx": 20,
          "pidx_tc": 323122,
          "spk": "名护 (ナゴ)",
          "ja": "可哀想だろう……",
          "tc": "也太過分了吧……",
          "sc": "也太过分了吧……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 323135,
          "spk": "堇怜 (スミレ)",
          "ja": "あと、すっごく可愛い",
          "tc": "還有，這樣你也可以隨時",
          "sc": "还有，这样你也可以随时"
        },
        {
          "f_idx": 22,
          "pidx_tc": 323142,
          "spk": "堇怜 (スミレ)",
          "ja": "猫の幽霊と、いつでも会えるんだよ！",
          "tc": "見到超可愛的幽靈貓喔！",
          "sc": "见到超可爱的幽灵猫哦！"
        },
        {
          "f_idx": 24,
          "pidx_tc": 323160,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなにいい村、他にないよ？",
          "tc": "這麼棒的村子，其他地方可都沒有喔！",
          "sc": "这么棒的村子，其他地方可都没有哦！"
        },
        {
          "f_idx": 25,
          "pidx_tc": 323167,
          "spk": "堇怜 (スミレ)",
          "ja": "住み着いちゃおうよ！",
          "tc": "你就定居在這裡嘛！",
          "sc": "你就定居在这里嘛！"
        },
        {
          "f_idx": 26,
          "pidx_tc": 323180,
          "spk": "名护 (ナゴ)",
          "ja": "……しゃべってる暇があったら",
          "tc": "……有這個時間閒聊的話，",
          "sc": "……有这个时间闲聊的话，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 323187,
          "spk": "名护 (ナゴ)",
          "ja": "勉強を再開したまえよ",
          "tc": "不如繼續念書。",
          "sc": "不如继续念书。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 323200,
          "spk": "堇怜 (スミレ)",
          "ja": "うっ……",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 323207,
          "spk": "堇怜 (スミレ)",
          "ja": "わかったよ～……",
          "tc": "知道了啦～",
          "sc": "知道了啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5521,
      "rec_id": "TALK_ID_10_0502_218_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323233,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん、来てたのか",
          "tc": "<player>，原來你來了啊。",
          "sc": "<player>，原来你来了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5522,
      "rec_id": "TALK_ID_10_0502_218_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323251,
          "spk": "名护 (ナゴ)",
          "ja": "ああ、スミレくんなら",
          "tc": "嗯，堇怜的話，",
          "sc": "嗯，堇怜的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323258,
          "spk": "名护 (ナゴ)",
          "ja": "放っておいても大丈夫だよ",
          "tc": "放他自己一個也沒問題。",
          "sc": "放他自己一个也没问题。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323269,
          "spk": "名护 (ナゴ)",
          "ja": "ああ見えてスミレくんに",
          "tc": "別看堇怜那樣，",
          "sc": "别看堇怜那样，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 323276,
          "spk": "名护 (ナゴ)",
          "ja": "根性があることは、",
          "tc": "他可是很有毅力的，",
          "sc": "他可是很有毅力的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 323283,
          "spk": "名护 (ナゴ)",
          "ja": "キミもよく知っているだろう？",
          "tc": "這點你也很清楚吧？",
          "sc": "这点你也很清楚吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 323294,
          "spk": "名护 (ナゴ)",
          "ja": "それにね……",
          "tc": "而且……",
          "sc": "而且……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5523,
      "rec_id": "TALK_ID_10_0502_218_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323312,
          "spk": "名护 (ナゴ)",
          "ja": "おっと",
          "tc": "哎呀。",
          "sc": "哎呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323319,
          "spk": "名护 (ナゴ)",
          "ja": "お帰り、ココ",
          "tc": "可可，你回來啦。",
          "sc": "可可，你回来啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5524,
      "rec_id": "TALK_ID_10_0502_218_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323335,
          "spk": "名护 (ナゴ)",
          "ja": "散歩していたのか？",
          "tc": "你剛剛是去散步嗎？",
          "sc": "你刚刚是去散步吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323342,
          "spk": "名护 (ナゴ)",
          "ja": "よしよし……",
          "tc": "好乖好乖……",
          "sc": "好乖好乖……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5525,
      "rec_id": "TALK_ID_10_0502_218_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323360,
          "spk": "名护 (ナゴ)",
          "ja": "ん？　……ああ",
          "tc": "嗯？喔……",
          "sc": "嗯？哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 323367,
          "spk": "名护 (ナゴ)",
          "ja": "――まあ、つまりだ",
          "tc": "──總而言之。",
          "sc": "——总而言之。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 323378,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、ココが満足するのを",
          "tc": "我想親眼看到可可牠",
          "sc": "我想亲眼看到可可它"
        },
        {
          "f_idx": 3,
          "pidx_tc": 323385,
          "spk": "名护 (ナゴ)",
          "ja": "見届けたいと思っている",
          "tc": "感到心滿意足的樣子",
          "sc": "感到心满意足的样子"
        },
        {
          "f_idx": 4,
          "pidx_tc": 323396,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくんに勉強を教える時間なら、",
          "tc": "至於要教堇怜念書的話，",
          "sc": "至于要教堇怜念书的话，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 323403,
          "spk": "名护 (ナゴ)",
          "ja": "これからたっぷりあるだろう",
          "tc": "今後時間還很多對吧？",
          "sc": "今后时间还很多对吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 323414,
          "spk": "名护 (ナゴ)",
          "ja": "そういうことだよ",
          "tc": "就是這麼回事。",
          "sc": "就是这么回事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5526,
      "rec_id": "TALK_ID_10_0502_250_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 323434,
          "spk": "主角心声/旁白/选项",
          "ja": "ここは……",
          "tc": "這裡是……",
          "sc": "这里是……"
        },
        {
