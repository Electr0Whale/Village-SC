  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1961,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_1232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147087,
          "spk": "名护 (ナゴ)",
          "ja": "……駄目だ、このままだと寝落ちする",
          "tc": "……不行，再這樣下去我會睡著的。",
          "sc": "……不行，再这样下去我会睡着的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147098,
          "spk": "名护 (ナゴ)",
          "ja": "いかんいかん……就寝前のルーティン……",
          "tc": "不行不行……要是不把睡前該做的……",
          "sc": "不行不行……要是不把睡前该做的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147105,
          "spk": "名护 (ナゴ)",
          "ja": "歯磨きとベッドメイクしないと、",
          "tc": "刷牙和整理床鋪完成，",
          "sc": "刷牙和整理床铺完成，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147112,
          "spk": "名护 (ナゴ)",
          "ja": "気になって深夜に起きてしまう……",
          "tc": "我一定會在意到半夜起床做完……",
          "sc": "我一定会在意到半夜起床做完……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1962,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147136,
          "spk": "名护 (ナゴ)",
          "ja": "雨か……",
          "tc": "下雨啊……",
          "sc": "下雨啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147147,
          "spk": "名护 (ナゴ)",
          "ja": "見るのはいいけど、",
          "tc": "賞雨是不錯，",
          "sc": "赏雨是不错，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147154,
          "spk": "名护 (ナゴ)",
          "ja": "濡れるのは嫌だね……",
          "tc": "但我不喜歡被淋濕……",
          "sc": "但我不喜欢被淋湿……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1963,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147178,
          "spk": "名护 (ナゴ)",
          "ja": "忙しいと、つい朝食を抜いてしまう……",
          "tc": "一忙起來，就會不小心忘了吃早餐……",
          "sc": "一忙起来，就会不小心忘了吃早餐……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147196,
          "spk": "名护 (ナゴ)",
          "ja": "体によくないのはわかっているし、",
          "tc": "我也很清楚不吃早餐對身體不好，",
          "sc": "我也很清楚不吃早餐对身体不好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147203,
          "spk": "名护 (ナゴ)",
          "ja": "簡単なことなのになかなか改善できないね……",
          "tc": "明明是很簡單的事情卻難以改善……",
          "sc": "明明是很简单的事情却难以改善……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1964,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147234,
          "spk": "名护 (ナゴ)",
          "ja": "今朝の夢は、とりわけ変だったな",
          "tc": "今天早上的夢，真的格外奇怪。",
          "sc": "今天早上的梦，真的格外奇怪。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147245,
          "spk": "名护 (ナゴ)",
          "ja": "寝る前に読んだ本の影響かな……",
          "tc": "應該是被睡前看的書影響了……",
          "sc": "应该是被睡前看的书影响了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1965,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147269,
          "spk": "名护 (ナゴ)",
          "ja": "猫に起こされずに迎える朝も",
          "tc": "已經有多少年，",
          "sc": "已经有多少年，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147276,
          "spk": "名护 (ナゴ)",
          "ja": "何年目になるだろうか……",
          "tc": "早上不是被貓叫醒的呢……",
          "sc": "早上不是被猫叫醒的呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1966,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147307,
          "spk": "名护 (ナゴ)",
          "ja": "……室内にこもってろという",
          "tc": "……這大概是老天爺要我乖乖待在房間裡吧，",
          "sc": "……这大概是老天爷要我乖乖待在房间里吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147314,
          "spk": "名护 (ナゴ)",
          "ja": "天からのお告げだな、そう解釈しよう",
          "tc": "就這麼解讀好了。",
          "sc": "就这么解读好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1967,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147345,
          "spk": "名护 (ナゴ)",
          "ja": "……あれ？　俺はこの後、",
          "tc": "……嗯？",
          "sc": "……嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147352,
          "spk": "名护 (ナゴ)",
          "ja": "何をしようとしていたんだっけ……",
          "tc": "我原本接下來打算要做什麼啊……",
          "sc": "我原本接下来打算要做什么啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147370,
          "spk": "名护 (ナゴ)",
          "ja": "ここに来てから、ど忘れが増えたよ……",
          "tc": "來到這裡之後，感覺變得容易忘東忘西了……",
          "sc": "来到这里之后，感觉变得容易忘东忘西了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 147377,
          "spk": "名护 (ナゴ)",
          "ja": "時間に追われることがないから、",
          "tc": "可能是因為不會被時間追著跑，",
          "sc": "可能是因为不会被时间追着跑，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 147384,
          "spk": "名护 (ナゴ)",
          "ja": "気が抜けてるのかな……？",
          "tc": "所以心態變得鬆懈了嗎……？",
          "sc": "所以心态变得松懈了吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1968,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147408,
          "spk": "名护 (ナゴ)",
          "ja": "今日の予定を整理しておこう",
          "tc": "來整理一下今天的行程好了。",
          "sc": "来整理一下今天的行程好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147419,
          "spk": "名护 (ナゴ)",
          "ja": "って、今の仕事は",
          "tc": "嗯，今天的工作",
          "sc": "嗯，今天的工作"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147426,
          "spk": "名护 (ナゴ)",
          "ja": "図書館の整理しかなかったか……",
          "tc": "就只有整理圖書館啊……",
          "sc": "就只有整理图书馆啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147433,
          "spk": "名护 (ナゴ)",
          "ja": "習慣って、抜けないもんだな",
          "tc": "所謂的習慣，就是難以改變啊。",
          "sc": "所谓的习惯，就是难以改变啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1969,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147457,
          "spk": "名护 (ナゴ)",
          "ja": "ほんと、のどかな村だ……",
          "tc": "真是個悠閒的村子……",
          "sc": "真是个悠闲的村子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147468,
          "spk": "名护 (ナゴ)",
          "ja": "平和そのものだな",
          "tc": "在夜晚來臨前，",
          "sc": "在夜晚来临前，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147475,
          "spk": "名护 (ナゴ)",
          "ja": "……夜を迎えるまでは",
          "tc": "簡直是和平之地……",
          "sc": "简直是和平之地……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1970,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147499,
          "spk": "名护 (ナゴ)",
          "ja": "雨だけでも憂鬱なのに",
          "tc": "光是下雨就夠讓人鬱悶了，",
          "sc": "光是下雨就够让人郁闷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147506,
          "spk": "名护 (ナゴ)",
          "ja": "さらに何か出るのは勘弁してくれよ……？",
          "tc": "拜託可別再冒出什麼東西了喔……？",
          "sc": "拜托可别再冒出什么东西了哦……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1971,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147537,
          "spk": "名护 (ナゴ)",
          "ja": "この村、夜になると真っ暗になるだろう？",
          "tc": "這個村子到了晚上就會一片漆黑對吧？",
          "sc": "这个村子到了晚上就会一片漆黑对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147544,
          "spk": "名护 (ナゴ)",
          "ja": "だから、なにかに出くわしてしまいそうで……",
          "tc": "總感覺會遇到什麼東西……",
          "sc": "总感觉会遇到什么东西……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147562,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さんも、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 147569,
          "spk": "名护 (ナゴ)",
          "ja": "暗くなる前に帰った方がいいよ",
          "tc": "你最好也在天黑前回家喔。",
          "sc": "你最好也在天黑前回家哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1972,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147593,
          "spk": "名护 (ナゴ)",
          "ja": "社会人になると、仕事終わりに",
          "tc": "一旦出社會之後，",
          "sc": "一旦出社会之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147600,
          "spk": "名护 (ナゴ)",
          "ja": "何かしようという気力はなかなか起きないな……",
          "tc": "下了班就很難再提起幹勁做些別的事了……",
          "sc": "下了班就很难再提起干劲做些别的事了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1973,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_WALK_20_109_1823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147624,
          "spk": "名护 (ナゴ)",
          "ja": "おや、<player>さん",
          "tc": "哦，<player>，",
          "sc": "哦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147631,
          "spk": "名护 (ナゴ)",
          "ja": "今日も一日お疲れさまだね",
          "tc": "今天也辛苦了。",
          "sc": "今天也辛苦了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147638,
          "spk": "名护 (ナゴ)",
          "ja": "気をつけて帰るんだよ",
          "tc": "回家路上要小心喔。",
          "sc": "回家路上要小心哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1974,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147662,
          "spk": "名护 (ナゴ)",
          "ja": "外で遊べなくて退屈そうな顔だね",
          "tc": "你一臉沒辦法出去玩很無聊的表情呢。",
          "sc": "你一脸没办法出去玩很无聊的表情呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147680,
          "spk": "名护 (ナゴ)",
          "ja": "読みたい本があったら、探してきてあげるよ",
          "tc": "如果有想看的書，我可以幫你找喔。",
          "sc": "如果有想看的书，我可以帮你找哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1975,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147711,
          "spk": "名护 (ナゴ)",
          "ja": "……俺のイメージしていた",
          "tc": "……在我的印象裡，",
          "sc": "……在我的印象里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147718,
          "spk": "名护 (ナゴ)",
          "ja": "図書館の司書は、ゴミ掃除を",
          "tc": "圖書館館員應該不用",
          "sc": "图书馆馆员应该不用"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147725,
          "spk": "名护 (ナゴ)",
          "ja": "日課にしてなかったと思うんだけどね",
          "tc": "每天收拾垃圾吧。",
          "sc": "每天收拾垃圾吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1976,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147749,
          "spk": "名护 (ナゴ)",
          "ja": "ゴミで散らかすのはまだ我慢できるけど",
          "tc": "看到垃圾亂放我還能忍，",
          "sc": "看到垃圾乱放我还能忍，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147756,
          "spk": "名护 (ナゴ)",
          "ja": "本をゴミ山の中に放り捨てるなんて……",
          "tc": "但把書丟到垃圾堆裡真的太誇張了……",
          "sc": "但把书丢到垃圾堆里真的太夸张了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147774,
          "spk": "名护 (ナゴ)",
          "ja": "マナー講習でも開くべきかな",
          "tc": "是不是該開個禮儀講座啊。",
          "sc": "是不是该开个礼仪讲座啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1977,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147805,
          "spk": "名护 (ナゴ)",
          "ja": "夏の雨は突然で困る",
          "tc": "夏天的雨總是說來就來，真讓人傷腦筋。",
          "sc": "夏天的雨总是说来就来，真让人伤脑筋。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147812,
          "spk": "名护 (ナゴ)",
          "ja": "せっかくの予定が台無しだ",
          "tc": "難得安排的行程都泡湯了。",
          "sc": "难得安排的行程都泡汤了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1978,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147836,
          "spk": "名护 (ナゴ)",
          "ja": "こうしてても、結構雨粒が当たるものだな",
          "tc": "就算待在這邊，還是會一直被雨噴到呢。",
          "sc": "就算待在这边，还是会一直被雨喷到呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147847,
          "spk": "名护 (ナゴ)",
          "ja": "横殴りの雨になったら",
          "tc": "要是雨開始橫著下了，",
          "sc": "要是雨开始横着下了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147854,
          "spk": "名护 (ナゴ)",
          "ja": "中にお邪魔させてもらうか……",
          "tc": "就拜託人家讓我進去躲個雨吧……",
          "sc": "就拜托人家让我进去躲个雨吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1979,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_2012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 147878,
          "spk": "名护 (ナゴ)",
          "ja": "うう……ずっと目を細めてたせいで、",
          "tc": "唔……一直瞇著眼睛看東西的關係，",
          "sc": "唔……一直眯着眼睛看东西的关系，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 147885,
          "spk": "名护 (ナゴ)",
          "ja": "やけに目が疲れるな",
          "tc": "眼睛非常容易疲勞。",
          "sc": "眼睛非常容易疲劳。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 147896,
          "spk": "名护 (ナゴ)",
          "ja": "このまま続けてたら",
          "tc": "這樣持續下去，",
          "sc": "这样持续下去，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 147903,
          "spk": "名护 (ナゴ)",
          "ja": "目の周りの筋肉が鍛えられて、",
          "tc": "可以鍛鍊眼睛周圍的肌肉，",
          "sc": "可以锻炼眼睛周围的肌肉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 147910,
          "spk": "名护 (ナゴ)",
          "ja": "視力も良くなったり……",
          "tc": "視力也會變好……",
          "sc": "视力也会变好……"
        },
        {
