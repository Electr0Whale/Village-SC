        },
        {
          "f_idx": 2,
          "pidx_tc": 84386,
          "spk": "洋 (ヨウ)",
          "ja": "いつもはシロージさんが刈ってるんだよ",
          "tc": "平常都是四郎治哥哥在負責除草的喔。",
          "sc": "平常都是四郎治哥哥在负责除草的哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 84393,
          "spk": "洋 (ヨウ)",
          "ja": "……今日はサボってるみたいだけど",
          "tc": "……雖然今天好像沒來除草。",
          "sc": "……虽然今天好像没来除草。"
        }
      ]
    },
    {
