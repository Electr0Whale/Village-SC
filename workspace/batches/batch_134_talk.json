          "f_idx": 1,
          "pidx_tc": 84459,
          "spk": "洋 (ヨウ)",
          "ja": "入ってきてないかなあ",
          "tc": "新的玩偶呢？",
          "sc": "新的玩偶呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
