      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 148176,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 148183,
          "spk": "名护 (ナゴ)",
          "ja": "メガネがないとやっぱり読みづらいな",
