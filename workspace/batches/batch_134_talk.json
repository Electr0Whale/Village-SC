          "f_idx": 2,
          "pidx_tc": 84752,
          "spk": "洋 (ヨウ)",
          "ja": "お散歩したいな",
          "tc": "就好想跟狗狗一起散步喔。",
          "sc": "就好想跟狗狗一起散步哦。"
        }
