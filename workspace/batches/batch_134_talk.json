        },
        {
          "f_idx": 1,
          "pidx_tc": 84428,
          "spk": "洋 (ヨウ)",
          "ja": "どんなお花を探してるのかな？",
          "tc": "是在找什麼樣的花呢？",
          "sc": "是在找什么样的花呢？"
        }
      ]
    },
    {
