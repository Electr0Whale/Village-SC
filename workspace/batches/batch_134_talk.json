          "f_idx": 1,
          "pidx_tc": 84783,
          "spk": "洋 (ヨウ)",
          "ja": "邪魔にならないようにしなくっちゃ",
          "tc": "要小心不要打擾到大家才行。",
          "sc": "要小心不要打扰到大家才行。"
        }
