      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 148633,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくんに誘われて川に入ったんだが、",
          "tc": "堇怜找我一起進河裡泡水，",
          "sc": "堇怜找我一起进河里泡水，"
