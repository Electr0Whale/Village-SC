          "f_idx": 4,
          "pidx_tc": 148665,
          "spk": "名护 (ナゴ)",
          "ja": "急に入ると体がびっくりするからね",
          "tc": "突然泡進河裡，身體會受到衝擊的。",
          "sc": "突然泡进河里，身体会受到冲击的。"
        }
      ]
    },
