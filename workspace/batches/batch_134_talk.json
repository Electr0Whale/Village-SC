      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84483,
          "spk": "洋 (ヨウ)",
          "ja": "生のタマネギって",
          "tc": "生的洋蔥",
          "sc": "生的洋葱"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84490,
          "spk": "洋 (ヨウ)",
          "ja": "どうしてあんなに辛いんだろう",
          "tc": "為什麼會那麼辣啊？",
          "sc": "为什么会那么辣啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 84501,
          "spk": "洋 (ヨウ)",
          "ja": "煮たら甘いのに……ふしぎ",
          "tc": "明明煮過之後很甜的……真是神奇。",
          "sc": "明明煮过之后很甜的……真是神奇。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2183,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84532,
          "spk": "洋 (ヨウ)",
          "ja": "んー……これ、ちょっと難しいかも",
          "tc": "嗯……這題有點難耶。",
          "sc": "嗯……这道题有点难呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84539,
          "spk": "洋 (ヨウ)",
          "ja": "えっと、三角形の面積がこうで、だから……",
          "tc": "我想想，三角形的面積是這樣，所以……",
          "sc": "我想想，三角形的面积是这样，所以……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2184,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84563,
          "spk": "洋 (ヨウ)",
          "ja": "宿題、ぜんぜん終わらない",
          "tc": "功課根本做不完。",
          "sc": "功课根本做不完。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84570,
          "spk": "洋 (ヨウ)",
          "ja": "でも、終わらないと遊べない",
          "tc": "但是不做完的話又不能玩。",
          "sc": "但是不做完的话又不能玩。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 84581,
          "spk": "洋 (ヨウ)",
          "ja": "子どもって、意外と大変なんだよ……",
          "tc": "當小孩也是很不容易的啊……",
          "sc": "当小孩也是很不容易的啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2185,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84612,
          "spk": "洋 (ヨウ)",
          "ja": "この時の登場人物の気持ちを答えなさい、かあ",
          "tc": "請回答文章中角色這時候的心情嗎……",
          "sc": "请回答文章中角色这时候的心情吗……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84619,
          "spk": "洋 (ヨウ)",
          "ja": "どこかに答えが書いてあるのかな",
          "tc": "會不會哪裡有寫答案呢？",
          "sc": "会不会哪里有写答案呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 84637,
          "spk": "洋 (ヨウ)",
          "ja": "それとも、想像しなさいってこと？",
          "tc": "還是說是要我想像？",
          "sc": "还是说是要我想像？"
        }
      ]
    },
    {
      "file": "talk.dat",
