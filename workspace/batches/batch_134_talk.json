      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_1800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84661,
          "spk": "洋 (ヨウ)",
          "ja": "雨って、どこから来るんだろう",
          "tc": "雨是從哪裡來的呢？",
          "sc": "雨是从哪里来的呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84668,
          "spk": "洋 (ヨウ)",
          "ja": "お空の神さまが泣いてるのかな？",
          "tc": "是天空的神明大人在哭泣嗎？",
          "sc": "是天空的神明大人在哭泣吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2187,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_1801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84692,
          "spk": "洋 (ヨウ)",
          "ja": "今日はなにをして遊ぼう",
          "tc": "今天要玩什麼好呢？",
          "sc": "今天要玩什么好呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84703,
          "spk": "洋 (ヨウ)",
          "ja": "……誰か、一緒に遊んでくれるかな",
          "tc": "……不知道會不會有人能陪我一起玩。",
          "sc": "……不知道会不会有人能陪我一起玩。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2188,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_1802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84734,
          "spk": "洋 (ヨウ)",
          "ja": "今日は暖かくて、風が気持ちいいね",
          "tc": "今天暖暖的，風吹起來也很舒服呢。",
          "sc": "今天暖暖的，风吹起来也很舒服呢。"
