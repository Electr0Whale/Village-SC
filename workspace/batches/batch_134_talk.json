        },
        {
          "f_idx": 2,
          "pidx_tc": 148190,
          "spk": "名护 (ナゴ)",
          "ja": "目を細めるのも限界があるし……",
          "tc": "但瞇著眼睛閱讀也有極限……",
          "sc": "但眯着眼睛阅读也有极限……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 148201,
          "spk": "名护 (ナゴ)",
          "ja": "サザンカさんに取り寄せるよう頼んだんだが、",
