      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30609,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、あそこをリスが走ってったよ",
          "tc": "剛剛有一隻松鼠跑過去了，",
          "sc": "刚刚有一只松鼠跑过去了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まんまると太ってたね",
          "tc": "圓滾滾的好胖一隻。",
          "sc": "圆滚滚的好胖一只。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3238,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3130",
      "lines": [
        {
          "f_idx": 1,
          "pidx_tc": 30665,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんて言うけどね",
          "tc": "晚上吹口哨會引蛇出洞，",
          "sc": "晚上吹口哨会引蛇出洞，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3239,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30707,
          "spk": "琪娜娜 (チナナ)",
          "ja": "は……っくしょん！",
          "tc": "哈……啾！",
          "sc": "哈……啾！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30718,
          "spk": "琪娜娜 (チナナ)",
          "ja": "う～……夜はけっこう",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30725,
          "spk": "琪娜娜 (チナナ)",
          "ja": "冷えるようになってきたねえ……",
          "tc": "晚上開始會冷了……",
          "sc": "晚上开始会冷了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3240,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30749,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小腹が空いちゃったな……",
          "tc": "肚子有點餓了……",
          "sc": "肚子有点饿了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30760,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ラーメンでも食べたい気分だけど",
          "tc": "我想吃拉麵，",
          "sc": "我想吃拉面，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3241,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30798,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おお……これは子どもの心を",
          "tc": "哦哦……",
          "sc": "哦哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30805,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鷲掴みにする品揃え……",
          "tc": "這些品項夠緊緊抓住孩子們的心啊……",
          "sc": "这些品项够紧紧抓住孩子们的心啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3242,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30847,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういえば、この中身を交換したり補充したり",
          "tc": "話說回來，我從來沒看過",
          "sc": "话说回来，我从来没看过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30854,
          "spk": "琪娜娜 (チナナ)",
          "ja": "してるところを一度も見たことがないんだよ",
          "tc": "茶梅幫這台轉蛋機進行交換或補充的樣子。",
          "sc": "茶梅帮这台转蛋机进行交换或补充的样子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3243,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30896,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや……このカプセルトイ、",
          "tc": "哦……這台轉蛋機",
          "sc": "哦……这台转蛋机"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30903,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あと少しで空っぽになりそうだよ",
          "tc": "裡面的玩具感覺快被轉完了呢。",
          "sc": "里面的玩具感觉快被转完了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30914,
          "spk": "琪娜娜 (チナナ)",
          "ja": "回しておいたほうがいいんじゃないかい？",
          "tc": "你要不要來轉一顆看看？",
          "sc": "你要不要来转一颗看看？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3244,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30945,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この季節は、食欲が止まらないんだよねぇ……",
          "tc": "到了這個季節，總是讓人胃口大開……",
          "sc": "到了这个季节，总是让人胃口大开……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30952,
          "spk": "琪娜娜 (チナナ)",
          "ja": "涼しくなった途端、",
          "tc": "為什麼天氣一變涼爽，",
          "sc": "为什么天气一变凉爽，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30959,
          "spk": "琪娜娜 (チナナ)",
          "ja": "急に元気になるのはなんでだろ",
          "tc": "精神就會突然好起來呢。",
          "sc": "精神就会突然好起来呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 30970,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ついでに甘いものも置いてくれないかな～",
          "tc": "要是能準備一些甜食就好了～",
          "sc": "要是能准备一些甜食就好了～"
        },
        {
          "f_idx": 4,
          "pidx_tc": 30977,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋って、そういうのが許される季節だろう？",
          "tc": "秋天就是可以放縱一下的季節吧？",
          "sc": "秋天就是可以放纵一下的季节吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3245,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3320",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31008,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はちょっと奮発して、",
          "tc": "我今天稍微奢侈了一下，",
          "sc": "我今天稍微奢侈了一下，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31015,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小鉢を追加してもらったんだ",
          "tc": "加點了一些小菜。",
          "sc": "加点了一些小菜。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3246,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31057,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おてんとさんが泣いてるけど",
          "tc": "雖然在下雨，",
          "sc": "虽然在下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31064,
          "spk": "琪娜娜 (チナナ)",
          "ja": "台風じゃないってだけで安心するね",
          "tc": "但至少不是颱風，這下就能放心了。",
          "sc": "但至少不是台风，这下就能放心了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31075,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、彼ヶ津村には滅多に台風なんて来ないけど",
          "tc": "不過彼津村本來就很少有颱風啦。",
          "sc": "不过彼津村本来就很少有台风啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3247,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31106,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋だねえ……",
          "tc": "秋天到了啊……",
          "sc": "秋天到了啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ユータが今年も焼き芋にハマったら",
          "tc": "如果裕太今年也沉迷於烤地瓜，",
          "sc": "如果裕太今年也沉迷于烤红薯，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31124,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご相伴にあずかる機会が増えそうだよ",
          "tc": "那我就有更多機會可以蹭到地瓜了。",
          "sc": "那我就有更多机会可以蹭到红薯了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3248,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31155,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、<player>か",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31166,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだい、並んで歩いたりして",
          "tc": "你怎麼跑到我旁邊來一起走？",
          "sc": "你怎么跑到我旁边来一起走？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31173,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手でも繋ぎたいのかい？",
          "tc": "是想跟我牽手嗎？",
          "sc": "是想跟我牵手吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3249,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31197,
          "spk": "琪娜娜 (チナナ)",
          "ja": "紅葉が進んで見応えのある",
          "tc": "楓葉漸漸開始變色，",
          "sc": "枫叶渐渐开始变色，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31204,
          "spk": "琪娜娜 (チナナ)",
          "ja": "景色になってきたねえ",
          "tc": "讓景色越來越精彩了呢。",
          "sc": "让景色越来越精彩了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3250,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31253,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはあれだ",
          "tc": "你就是所謂的那個……",
          "sc": "你就是所谓的那个……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31264,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雨にも負けず、風にも負けず、",
          "tc": "「不怕風也不怕雨」。",
          "sc": "“不怕风也不怕雨”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3251,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31302,
          "spk": "琪娜娜 (チナナ)",
          "ja": "つかぬことを聞くけどね",
          "tc": "冒昧跟你請教一下。",
          "sc": "冒昧跟你请教一下。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31313,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仲のいい二人が一緒に外を歩いていたら",
          "tc": "感情要好的兩人一起走在外面，",
          "sc": "感情要好的两人一起走在外面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31320,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それはデートと呼ぶのかな？",
          "tc": "這樣就算是約會嗎？",
          "sc": "这样就算是约会吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3252,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31344,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋は空が高い、なんて言うけどね",
          "tc": "俗話說秋高氣爽，",
          "sc": "俗话说秋高气爽，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 31369,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……いや、冗談だけどね？",
          "tc": "……我開玩笑的。",
          "sc": "……我开玩笑的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3253,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31393,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、お疲れ……ん、疲れてないって？",
          "tc": "嗨，辛苦……嗯？你說你不辛苦？",
          "sc": "嗨，辛苦……嗯？你说你不辛苦？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31411,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは！　大人はね、事あるごとに",
          "tc": "啊哈哈！大人凡事都會像這樣打招呼，",
          "sc": "啊哈哈！大人凡事都会像这样打招呼，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 31418,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お疲れ～って挨拶しあうもんなんだよ",
          "tc": "互道一句「辛苦了」喔。",
          "sc": "互道一句“辛苦了”哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3254,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31449,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜の水たまりは、避けて歩くことだね",
          "tc": "晚上走路時要注意避開水窪喔，",
          "sc": "晚上走路时要注意避开水洼哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31456,
          "spk": "琪娜娜 (チナナ)",
          "ja": "中に引きずり込まれたくはないだろう？",
          "tc": "你也不會想被拖進水窪裡吧？",
          "sc": "你也不会想被拖进水洼里吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31467,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……気をつけなね",
          "tc": "……要小心點喔。",
          "sc": "……要小心点哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3255,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31491,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、もしかして夜のパトロール中かい？",
          "tc": "哦？莫非你是在做夜間的巡邏嗎？",
          "sc": "哦？莫非你是在做夜间的巡逻吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31502,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういうのはキミの仕事じゃないよ",
          "tc": "這不是你的工作，",
          "sc": "这不是你的工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31509,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キスケにでも任せておくといいさ",
          "tc": "只要交給木助就好了。",
          "sc": "只要交给木助就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3256,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3822",
      "lines": [
        {
          "f_idx": 2,
          "pidx_tc": 31551,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まったく、<player>は悪ガキだねえ",
          "tc": "真是的，<player>是個壞孩子啊。",
          "sc": "真是的，<player>是个坏孩子啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 31562,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミは夜の恐ろしさを、",
          "tc": "你啊，",
          "sc": "你啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 31569,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もっと知ったほうがいいね",
          "tc": "應該要好好瞭解夜晚有多恐怖才對。",
          "sc": "应该要好好了解夜晚有多恐怖才对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3257,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31593,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は、星の名前っていくつわかる？",
          "tc": "<player>，你叫得出多少顆星星的名字啊？",
          "sc": "<player>，你叫得出多少颗星星的名字啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3258,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31649,
          "spk": "琪娜娜 (チナナ)",
          "ja": "足元が滑るから踏ん張らないとね",
