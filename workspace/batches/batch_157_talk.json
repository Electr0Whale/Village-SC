  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3294,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 169210,
          "spk": "六角 (ロッカク)",
          "ja": "ナゴさんどうっスか？",
          "tc": "名護先生，最近如何？",
          "sc": "名护先生，最近如何？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 169217,
          "spk": "六角 (ロッカク)",
          "ja": "村での暮らしは",
          "tc": "在村子裡的生活，",
          "sc": "在村子里的生活，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 169224,
          "spk": "六角 (ロッカク)",
          "ja": "もうだいぶ慣れましたか？",
          "tc": "你差不多習慣了嗎？",
          "sc": "你差不多习惯了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 169237,
          "spk": "名护 (ナゴ)",
          "ja": "今までの街での暮らしと比べたら",
          "tc": "比起以前住在市區時，",
          "sc": "比起以前住在市区时，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 169244,
          "spk": "名护 (ナゴ)",
          "ja": "不便なことが多いですけど……",
          "tc": "是有滿多不方便的地方……",
          "sc": "是有满多不方便的地方……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 169251,
          "spk": "名护 (ナゴ)",
          "ja": "自然を共にした生活も悪くないですね",
          "tc": "但是和大自然為伍的日子也不錯呢。",
          "sc": "但是和大自然为伍的日子也不错呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 169262,
          "spk": "名护 (ナゴ)",
          "ja": "ただ、虫だけはどうにかなりませんか？",
          "tc": "只不過，蟲子的問題難道就沒辦法了嗎？",
          "sc": "只不过，虫子的问题难道就没办法了吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 169269,
          "spk": "名护 (ナゴ)",
          "ja": "この前なんか、窓から侵入してきた",
          "tc": "前陣子有隻蟬從窗戶闖進來，",
          "sc": "前阵子有只蝉从窗户闯进来，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 169276,
          "spk": "名护 (ナゴ)",
          "ja": "セミの鳴き声に叩き起こされて……",
          "tc": "我還被牠的叫聲直接吵醒……",
          "sc": "我还被它的叫声直接吵醒……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 169289,
          "spk": "六角 (ロッカク)",
          "ja": "あはは、それはもう仕方ないっスね",
          "tc": "啊哈哈，那還真的沒辦法呢。",
          "sc": "啊哈哈，那还真的没办法呐。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 169296,
          "spk": "六角 (ロッカク)",
          "ja": "四方八方が大自然なもんで",
          "tc": "畢竟這裡四面八方都被大自然所圍繞，",
          "sc": "毕竟这里四面八方都被大自然所围绕，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 169303,
          "spk": "六角 (ロッカク)",
          "ja": "虫と無縁の生活なんて無理っスから",
          "tc": "想過上跟蟲子無緣的生活是根本不可能。",
          "sc": "想过上跟虫子无缘的生活是根本不可能。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 169314,
          "spk": "六角 (ロッカク)",
          "ja": "他には何かないっスか？",
          "tc": "還有其他不習慣的地方嗎？",
          "sc": "还有其他不习惯的地方不？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 169321,
          "spk": "六角 (ロッカク)",
          "ja": "やっぱり街での暮らしとは",
          "tc": "跟住在市區相比，",
          "sc": "跟住在市区相比，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 169328,
          "spk": "六角 (ロッカク)",
          "ja": "違うことが多いでしょうに",
          "tc": "應該還有很多不同的地方吧。",
          "sc": "应该还有很多不同的地方吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 169341,
          "spk": "名护 (ナゴ)",
          "ja": "そうですね……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 169348,
          "spk": "名护 (ナゴ)",
          "ja": "今になって温かい便座の偉大さを",
          "tc": "我現在才深刻體會到，",
          "sc": "我现在才深刻体会到，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 169355,
          "spk": "名护 (ナゴ)",
          "ja": "痛感しています",
          "tc": "溫感馬桶坐墊有多麼偉大。",
          "sc": "温感马桶坐垫有多么伟大。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 169368,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、そんなもんっスよね",
          "tc": "也是啦，會這樣很正常吧。",
          "sc": "也是啦，会这样很正常哟。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 169375,
          "spk": "六角 (ロッカク)",
          "ja": "便利な暮らしに慣れちまうと",
          "tc": "畢竟一旦習慣了便利的生活，",
          "sc": "毕竟一旦习惯了便利的生活，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 169382,
          "spk": "六角 (ロッカク)",
          "ja": "不満ってのは避けられないもんで",
          "tc": "對這裡會有不滿也是人之常情。",
          "sc": "对这里会有不满也是人之常情。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 169393,
          "spk": "六角 (ロッカク)",
          "ja": "ここだけの噂なんですが、",
          "tc": "告訴你一個小道傳聞，",
          "sc": "告诉你一个小道传闻，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 169400,
          "spk": "六角 (ロッカク)",
          "ja": "コンノさんの部屋のトイレには、温かい便座",
          "tc": "聽說今野房間的廁所，",
          "sc": "听说今野房间的厕所，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 169407,
          "spk": "六角 (ロッカク)",
          "ja": "どころか洗浄機能もついてるらしいっス",
          "tc": "不只有溫感馬桶坐墊，還有免治馬桶呢。",
          "sc": "不只有温感马桶坐垫，还有免治马桶呐。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 169420,
          "spk": "名护 (ナゴ)",
          "ja": "なっ……なんでコンノさんだけ",
          "tc": "什麼……為什麼只有今野",
          "sc": "什么……为什么只有今野"
        },
        {
          "f_idx": 25,
          "pidx_tc": 169427,
          "spk": "名护 (ナゴ)",
          "ja": "この村で現代人として暮らせてるんだよ……",
          "tc": "在這村裡過著現代人的生活啊……",
          "sc": "在这村里过着现代人的生活啊……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 169440,
          "spk": "六角 (ロッカク)",
          "ja": "おっとすみません",
          "tc": "哎呀，不好意思。",
          "sc": "哎呀，不好意思。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 169447,
          "spk": "六角 (ロッカク)",
          "ja": "食事の場にあるまじき話でしたね",
          "tc": "我不該在吃飯的地方聊這個的。",
          "sc": "我不该在吃饭的地方聊这个的。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 169458,
          "spk": "六角 (ロッカク)",
          "ja": "あ、そうだ",
          "tc": "啊，對了。",
          "sc": "啊，对了。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 169465,
          "spk": "六角 (ロッカク)",
          "ja": "冷やし梅茶漬け出せるっスけど",
          "tc": "我有提供梅子冷茶泡飯，",
          "sc": "我有提供梅子冷茶泡饭，"
        },
        {
          "f_idx": 30,
          "pidx_tc": 169472,
          "spk": "六角 (ロッカク)",
          "ja": "食べるっスか？",
          "tc": "你要吃嗎？",
          "sc": "你要吃不？"
        },
        {
          "f_idx": 31,
          "pidx_tc": 169485,
          "spk": "名护 (ナゴ)",
          "ja": "ええ、いただきます",
          "tc": "好，麻煩你了。",
          "sc": "好，麻烦你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3295,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 169513,
          "spk": "今野 (コンノ)",
          "ja": "おやァ、リンさん",
          "tc": "哎呀，林小姐。",
          "sc": "哎呀，林小姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 169520,
          "spk": "今野 (コンノ)",
          "ja": "お皿の隅でニンジンが寂しそうですよォ",
          "tc": "盤子邊邊的紅蘿蔔看起來很孤單耶～",
          "sc": "盘子边边的胡萝卜看起来很孤单呢～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 169529,
          "spk": "今野 (コンノ)",
          "ja": "嫌いなものを最後まで残す癖、",
          "tc": "您這種把討厭的東西留到最後的習慣，",
          "sc": "您这种把讨厌的东西留到最后的习惯，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 169536,
          "spk": "今野 (コンノ)",
          "ja": "なかなか抜けませんねェ",
          "tc": "一直改不掉呢～",
          "sc": "一直改不掉呢～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 169556,
          "spk": "林 (リン)",
          "ja": "別に、嫌いなわけじゃないわ",
          "tc": "我又不是因為討厭紅蘿蔔，",
          "sc": "我又不是因为讨厌胡萝卜，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 169563,
          "spk": "林 (リン)",
          "ja": "バランスを考えて食べているだけよ",
          "tc": "只是吃的時候有在留意營養均衡而已。",
          "sc": "只是吃的时候有在留意营养均衡而已。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 169576,
          "spk": "今野 (コンノ)",
          "ja": "では苦手を克服したんですかァ？",
          "tc": "所以您已經不怕吃紅蘿蔔了嗎～？",
          "sc": "所以您已经不怕吃胡萝卜了吗～？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 169583,
          "spk": "今野 (コンノ)",
          "ja": "昔は星形に切ってあげなければ",
          "tc": "以前要是我沒有幫您切成星星形狀，",
          "sc": "以前要是我没有帮您切成星星形状，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 169590,
          "spk": "今野 (コンノ)",
          "ja": "断固として口にしなかったじゃないですか",
          "tc": "您可是死都不肯吃呢。",
          "sc": "您可是死都不肯吃呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 169601,
          "spk": "今野 (コンノ)",
          "ja": "どうしても食べたくないなら",
          "tc": "如果您真的不想吃，",
          "sc": "如果您真的不想吃，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 169608,
          "spk": "今野 (コンノ)",
          "ja": "今からでも切ってあげますヨ",
          "tc": "我可以現在幫您切喔。",
          "sc": "我可以现在帮您切哟～。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 169615,
          "spk": "今野 (コンノ)",
          "ja": "キラキラのお星様、好きでしょう？",
          "tc": "您喜歡閃閃發光的星星對吧？",
          "sc": "您喜欢闪闪发光的星星对吧？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 169628,
          "spk": "林 (リン)",
          "ja": "い、いらないわよ！",
          "tc": "才、才不用！",
          "sc": "才、才不用！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 169635,
          "spk": "林 (リン)",
          "ja": "そんな昔の話を持ち出さないで",
          "tc": "別再提那麼久以前的事好不好，",
          "sc": "别再提那么久以前的事好不好，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 169642,
          "spk": "林 (リン)",
          "ja": "もう子どもじゃないんだから",
          "tc": "我已經不是小孩子了，",
          "sc": "我已经不是小孩子了，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 169655,
          "spk": "今野 (コンノ)",
          "ja": "そんなに熱くならないでくださいヨ",
          "tc": "您別那麼激動嘛。",
          "sc": "您别那么激动嘛。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 169662,
          "spk": "今野 (コンノ)",
          "ja": "ほら、急いで食べるとお腹を壊します",
          "tc": "慢慢吃，吃太快會消化不良的。",
          "sc": "慢慢吃，吃太快会消化不良的。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 169673,
          "spk": "今野 (コンノ)",
          "ja": "昔から、おいしいものは一瞬で",
          "tc": "您從以前就是這樣，",
          "sc": "您从以前就是这样，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 169680,
          "spk": "今野 (コンノ)",
          "ja": "たいらげてしまうんですからァ",
          "tc": "碰到好吃的東西一轉眼就吃完了。",
          "sc": "碰到好吃的东西一转眼就吃完了。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 169687,
          "spk": "今野 (コンノ)",
          "ja": "食べ過ぎないように気をつけてくださいネ",
          "tc": "要注意別吃太多喔！",
          "sc": "要注意别吃太多哟～！"
        },
        {
          "f_idx": 21,
          "pidx_tc": 169700,
          "spk": "林 (リン)",
          "ja": "もう、いい加減にして",
          "tc": "真是的，別再講了啦，",
          "sc": "真是的，别再讲了啦，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 169707,
          "spk": "林 (リン)",
          "ja": "あれこれ口を出されたら",
          "tc": "一直聽你碎碎念，",
          "sc": "一直听你碎碎念，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 169714,
          "spk": "林 (リン)",
          "ja": "食べた気がしないわよ",
          "tc": "害我都沒心情吃了。",
          "sc": "害我都没心情吃了。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 169727,
          "spk": "今野 (コンノ)",
          "ja": "おや、そうですかァ？",
          "tc": "哎呀，是這樣嗎？",
          "sc": "哎呀，是这样吗～？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 169738,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはリンさんの成長を見ながら",
          "tc": "對我來說，看著林小姐的成長一邊用餐，",
          "sc": "对我来说，看着林小姐的成长一边用餐，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 169745,
          "spk": "今野 (コンノ)",
          "ja": "いただく食事が、大好物なんですけどねェ",
          "tc": "可是一大樂事呢。",
          "sc": "可是一大乐事呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3296,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0023",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 169773,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……さっきから長々と商品を眺めてるから",
          "tc": "……妳從剛才就一直盯著商品看，",
          "sc": "……你从刚才就一直盯着商品看，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 169780,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思い切って聞くんだけどね",
          "tc": "我就直接問了。",
          "sc": "我就直接问了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 169791,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミ、買う気はある？",
          "tc": "……妳有打算要買嗎？",
          "sc": "……你有打算要买吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 169811,
          "spk": "帷 (トバリ)",
          "ja": "ううん、ただの冷やかしだけど？",
          "tc": "沒有，我只是逛逛而已啊？",
          "sc": "没有，我只是逛逛而已啊？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 169824,
          "spk": "琪娜娜 (チナナ)",
          "ja": "堂々と言うねえ……",
          "tc": "還真是理直氣壯……",
          "sc": "还真是理直气壮……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 169831,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういうハッキリした物言いは",
          "tc": "這麼乾脆的說話方式，",
          "sc": "这么干脆的说话方式，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 169838,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嫌いじゃないけども……",
          "tc": "我是不討厭啦……",
          "sc": "我是不讨厌啦……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 169849,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だけど、こっちも商売だ",
          "tc": "只不過，我也是要做生意的。",
          "sc": "只不过，我也是要做生意的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 169856,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か買ってくれないと",
          "tc": "要是妳什麼都不買，",
          "sc": "要是你什么都不买，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 169863,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おまんまにありつけないんだよ",
          "tc": "我會沒飯吃的。",
