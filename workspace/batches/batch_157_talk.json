          "f_idx": 1,
          "pidx_tc": 32786,
          "spk": "琪娜娜 (チナナ)",
          "ja": "みんなの夕飯を準備する、",
          "tc": "就能聞到空氣中傳來",
          "sc": "就能闻到空气中传来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32793,
          "spk": "琪娜娜 (チナナ)",
          "ja": "美味しそうな香りが漂ってくるよ",
          "tc": "大家在準備晚餐的美味香氣……",
          "sc": "大家在准备晚餐的美味香气……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32804,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチもお腹減ったな",
          "tc": "……我也餓了。",
          "sc": "……我也饿了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 32811,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今晩は何を食べようか……",
          "tc": "今天晚上要吃什麼好呢……",
          "sc": "今天晚上要吃什么好呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3282,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32835,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こうやって、何をするでもなくぼーっとしてると",
          "tc": "像這樣無所事事地發呆，",
          "sc": "像这样无所事事地发呆，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32842,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体中のネジがゆっくり緩んでいくような",
          "tc": "會感覺全身緊繃的神經",
          "sc": "会感觉全身紧绷的神经"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32849,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気がするんだよ",
          "tc": "都慢慢變鬆了。",
          "sc": "都慢慢变松了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3283,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4131",
      "lines": [
        {
          "f_idx": 2,
          "pidx_tc": 32909,
          "spk": "琪娜娜 (チナナ)",
          "ja": "コーンポタージュ……ミネストローネ……",
          "tc": "玉米濃湯……義式蔬菜湯……",
          "sc": "玉米浓汤……义式蔬菜汤……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3284,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32947,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミの家にいることが多くなったから",
          "tc": "我現在常常待在蓮實家，",
          "sc": "我现在常常待在莲实家，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32954,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スミレと顔を合わせる機会も増えてね",
          "tc": "所以碰到堇怜的機會也變多了。",
          "sc": "所以碰到堇怜的机会也变多了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32972,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これを機に「お姉ちゃん」なんて",
          "tc": "不知道他會不會因為這樣，",
          "sc": "不知道他会不会因为这样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 32979,
          "spk": "琪娜娜 (チナナ)",
          "ja": "呼んでくれないものかねえ",
          "tc": "開始叫我姐姐呢？",
          "sc": "开始叫我姐姐呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3285,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33010,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹があったまると、途端に体の",
          "tc": "肚子暖起來之後，",
          "sc": "肚子暖起来之后，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3286,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4320",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33066,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>もご飯かな？",
          "tc": "嗨，<player>，你也是來吃飯的嗎？",
          "sc": "嗨，<player>，你也是来吃饭的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33073,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よかったら隣で一緒にどうだい？",
          "tc": "那要不要坐我旁邊一起吃啊？",
          "sc": "那要不要坐我旁边一起吃啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3287,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33115,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやおや、キミほっぺが赤くなってるよ",
          "tc": "哎呀呀，你臉頰都變紅了。",
          "sc": "哎呀呀，你脸颊都变红了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンゴみたいで美味しそうだねえ",
          "tc": "像是蘋果一樣，感覺好像很好吃呢。",
          "sc": "像是苹果一样，感觉好像很好吃呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3288,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33164,
          "spk": "琪娜娜 (チナナ)",
          "ja": "う～寒い……",
          "tc": "嗚～好冷……",
          "sc": "呜～好冷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33171,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寒すぎて、顔のパーツが落っこちそうだよ",
          "tc": "冷到感覺我的五官都要從臉上掉下去了。",
          "sc": "冷到感觉我的五官都要从脸上掉下去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3289,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33220,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹がすいたねえ",
          "tc": "肚子餓了啊。",
          "sc": "肚子饿了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33227,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は今夜、何を食べるんだい？",
          "tc": "<player>，你今晚要吃什麼啊？",
          "sc": "<player>，你今晚要吃什么啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3290,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33269,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カチコチに凍った道を歩くと、",
          "tc": "走在這硬邦邦結冰的道路上，",
          "sc": "走在这硬邦邦结冰的道路上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 33294,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれはこの道といい勝負の固さだったねえ",
          "tc": "她肩膀的僵硬程度，足以跟這條路一較高下了。",
          "sc": "她肩膀的僵硬程度，足以跟这条路一较高下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3291,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33325,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこを見ても真っ白だねえ",
          "tc": "放眼過去都是一片雪白。",
          "sc": "放眼过去都是一片雪白。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3292,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33385,
          "spk": "琪娜娜 (チナナ)",
          "ja": "虫の気配もないし、",
          "tc": "既感受不到昆蟲的氣息，",
          "sc": "既感受不到昆虫的气息，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33392,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鳥の鳴き声も聞こえないね",
          "tc": "也聽不到鳥叫聲。",
          "sc": "也听不到鸟叫声。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33403,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも冬ごもりしたいよ",
          "tc": "我也好想冬眠啊。",
          "sc": "我也好想冬眠啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3293,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "冬はあったかいココアが",
          "tc": "不覺得冬天就是會",
          "sc": "不觉得冬天就是会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33434,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無性に飲みたくならないかい？",
          "tc": "莫名地想喝熱可可嗎？",
          "sc": "莫名地想喝热可可吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3294,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33476,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ついさっき気がついたんだけどね",
          "tc": "我剛剛才發現，",
          "sc": "我刚刚才发现，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33483,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうやら上着のポケットに穴が空いてるんだ",
          "tc": "我外套的口袋好像破洞了。",
          "sc": "我外套的口袋好像破洞了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33494,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手を突っこんでもスースーするよ……",
          "tc": "所以手插在口袋裡都還是冷颼颼的……",
          "sc": "所以手插在口袋里都还是冷飕飕的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3295,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33525,
          "spk": "琪娜娜 (チナナ)",
          "ja": "静かすぎて、自分の心臓の音が",
          "tc": "實在是太安靜了，",
          "sc": "实在是太安静了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33532,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うるさく聞こえるぐらいだよ",
          "tc": "都能聽見自己的心跳聲了，還有點吵。",
          "sc": "都能听见自己的心跳声了，还有点吵。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33543,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミの心臓はちゃんと動いてるかい？",
          "tc": "……你的心臟有好好在跳動嗎？",
          "sc": "……你的心脏有好好在跳动吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3296,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33567,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間にどこへ行くんだい？",
          "tc": "都這麼晚了，你是要去哪裡啊？",
          "sc": "都这么晚了，你是要去哪里啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33574,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もしかして村を出ようとしてるのかな？",
          "tc": "該不會是想要離開村子吧？",
          "sc": "该不会是想要离开村子吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33585,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……なーんてね、早めに帰るんだよ",
          "tc": "……開玩笑的，要早點回家喔。",
          "sc": "……开玩笑的，要早点回家哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3297,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33609,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜は月がやけに白くて",
          "tc": "不覺得今晚的月亮特別皎潔，",
          "sc": "不觉得今晚的月亮特别皎洁，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "目に刺さると思わないかい？",
          "tc": "很顯眼嗎？",
          "sc": "很显眼吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33627,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだか月に見られているみたいだよ",
          "tc": "就好像是月亮在看著我們一樣。",
          "sc": "就好像是月亮在看着我们一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3298,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33651,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昼間と同じ道なのに、",
          "tc": "明明這條路跟白天時是同一條，",
          "sc": "明明这条路跟白天时是同一条，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33658,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜が全然違う顔を見せてくるよ",
          "tc": "但晚上看起來卻是完全不同的模樣。",
          "sc": "但晚上看起来却是完全不同的模样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 33676,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は、どっちの顔が好みかな？",
          "tc": "<player>，你比較喜歡哪一種啊？",
          "sc": "<player>，你比较喜欢哪一种啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3299,
      "rec_id": "TALK_ID_STREET_VENDOR_BIRTHDAY_20_114_5000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33700,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、<player>じゃないか",
          "tc": "哦，這不是<player>嗎。",
          "sc": "哦，这不是<player>吗。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33707,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……もしかして、今日がなんの日か",
          "tc": "……你該不會以為，",
          "sc": "……你该不会以为，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33714,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチが忘れてるとでも思ったかい？",
          "tc": "我忘記今天是什麼日子了吧？",
          "sc": "我忘记今天是什么日子了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 33725,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハハハ、ちゃんと覚えてるさ",
          "tc": "哈哈哈，我可是記得很清楚的。",
          "sc": "哈哈哈，我可是记得很清楚的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 33732,
          "spk": "琪娜娜 (チナナ)",
          "ja": "誕生日おめでとう、<player>",
          "tc": "生日快樂，<player>。",
          "sc": "生日快乐，<player>。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 33739,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつも話し相手になってくれて、ありがとさん",
          "tc": "謝謝你總是陪我聊天啊。",
          "sc": "谢谢你总是陪我聊天啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 33750,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミには、ウチが外で買いつけといた",
          "tc": "我在外地採購時買了一個好東西，",
          "sc": "我在外地采购时买了一个好东西，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 33757,
          "spk": "琪娜娜 (チナナ)",
          "ja": "とっておきをプレゼントしようと思ってねえ",
          "tc": "想把它當成禮物送給你。",
          "sc": "想把它当成礼物送给你。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 33768,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、これだよ",
          "tc": "來，就是這個，",
          "sc": "来，就是这个，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 33775,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気に入ってくれるといいんだけど",
          "tc": "希望你會喜歡。",
          "sc": "希望你会喜欢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3300,
      "rec_id": "TALK_ID_STREET_VENDOR_BIRTHDAY_20_114_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33799,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい感じのラジオだろ？",
          "tc": "是台不錯的收音機吧？",
          "sc": "是台不错的收音机吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33806,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これがあれば、遠い街の音楽や",
          "tc": "有了它，就能收聽遠方城市的音樂，",
          "sc": "有了它，就能收听远方城市的音乐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33813,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いろんな人の話が聴けるんだ",
          "tc": "還有各式各樣的人的談話。",
          "sc": "还有各式各样的人的谈话。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 33824,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも外に出ていた頃は",
          "tc": "以前我會外出的時候，",
          "sc": "以前我会外出的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 33831,
          "spk": "琪娜娜 (チナナ)",
