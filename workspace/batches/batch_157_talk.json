      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32594,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、何か買いに来たのかい？",
          "tc": "哦？你是來買東西的嗎？",
          "sc": "哦？你是来买东西的吗？"
        },
