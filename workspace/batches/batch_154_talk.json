      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 166460,
          "spk": "莲实 (ハスミ)",
          "ja": "雪道は、かかとから強く踏み込まずに、",
          "tc": "走在積雪的道路上，要避免以腳跟用力踏上去，",
          "sc": "走在积雪的道路上，要避免以脚跟用力踏上去，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 166485,
          "spk": "莲实 (ハスミ)",
          "ja": "……先ほど私は見事に滑って転んだので",
          "tc": "……我剛剛華麗地滑了一大教，",
          "sc": "……我刚刚华丽地滑了一大教，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 166492,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも、気をつけてくださいね",
          "tc": "<player>你也要小心不要滑倒了。",
          "sc": "<player>你也要小心不要滑倒了。"
        }
      ]
    },
    {
