          "pidx_tc": 24037,
          "spk": "琪娜娜 (チナナ)",
          "ja": "花びらを浮かべた日本酒と一緒に",
          "tc": "搭配漂著花瓣的日本酒一起吃吃喝喝的，",
          "sc": "搭配漂着花瓣的日本酒一起吃吃喝喝的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 24044,
          "spk": "琪娜娜 (チナナ)",
          "ja": "呑み食いするのが最高なんだよねえ",
          "tc": "真是最棒的享受。",
