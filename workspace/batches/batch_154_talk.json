      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 22905,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 22912,
          "spk": "琪娜娜 (チナナ)",
