        {
          "f_idx": 0,
          "pidx_tc": 166236,
          "spk": "莲实 (ハスミ)",
          "ja": "霜がきれいに降りていて、",
          "tc": "冰霜落下的模樣真美，",
          "sc": "冰霜落下的模样真美，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 166243,
          "spk": "莲实 (ハスミ)",
          "ja": "冬らしい景色ですね……",
          "tc": "完全是冬日景色呢……",
          "sc": "完全是冬日景色呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 166254,
          "spk": "莲实 (ハスミ)",
          "ja": "見とれてしまいそうですが、",
          "tc": "雖然會讓人目不轉睛，",
          "sc": "虽然会让人目不转睛，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 166261,
          "spk": "莲实 (ハスミ)",
          "ja": "足元も滑りやすいですし、気をつけましょうね",
          "tc": "但地面很濕滑，走路要小心喔。",
          "sc": "但地面很湿滑，走路要小心哦。"
        }
      ]
    },
    {
