      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 166733,
          "spk": "莲实 (ハスミ)",
          "ja": "外での寒さが堪える分",
          "tc": "正因為外面冷得讓人受不了，",
          "sc": "正因为外面冷得让人受不了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 166740,
          "spk": "莲实 (ハスミ)",
          "ja": "ゆっくりお風呂に入る時間は幸せですね",
          "tc": "悠閒的泡澡時光更給人幸福的感覺。",
          "sc": "悠闲的泡澡时光更给人幸福的感觉。"
