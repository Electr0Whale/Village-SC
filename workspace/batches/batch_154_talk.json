  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3267,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32917,
          "spk": "琪娜娜 (チナナ)",
          "ja": "冬はあったかいココアが",
          "tc": "不覺得冬天就是會",
          "sc": "不觉得冬天就是会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32924,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無性に飲みたくならないかい？",
          "tc": "莫名地想喝熱可可嗎？",
          "sc": "莫名地想喝热可可吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、大人は熱燗派が多いけどね",
          "tc": "不過大人比較多是熱清酒派的。",
          "sc": "不过大人比较多是热清酒派的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3268,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32966,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ついさっき気がついたんだけどね",
          "tc": "我剛剛才發現，",
          "sc": "我刚刚才发现，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32973,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうやら上着のポケットに穴が空いてるんだ",
          "tc": "我外套的口袋好像破洞了。",
          "sc": "我外套的口袋好像破洞了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32984,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手を突っこんでもスースーするよ……",
          "tc": "所以手插在口袋裡都還是冷颼颼的……",
          "sc": "所以手插在口袋里都还是冷飕飕的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3269,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33015,
          "spk": "琪娜娜 (チナナ)",
          "ja": "静かすぎて、自分の心臓の音が",
          "tc": "實在是太安靜了，",
          "sc": "实在是太安静了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33022,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うるさく聞こえるぐらいだよ",
          "tc": "都能聽見自己的心跳聲了，還有點吵。",
          "sc": "都能听见自己的心跳声了，还有点吵。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33033,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミの心臓はちゃんと動いてるかい？",
          "tc": "……你的心臟有好好在跳動嗎？",
          "sc": "……你的心脏有好好在跳动吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3270,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33057,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間にどこへ行くんだい？",
          "tc": "都這麼晚了，你是要去哪裡啊？",
          "sc": "都这么晚了，你是要去哪里啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33064,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もしかして村を出ようとしてるのかな？",
          "tc": "該不會是想要離開村子吧？",
          "sc": "该不会是想要离开村子吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33075,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……なーんてね、早めに帰るんだよ",
          "tc": "……開玩笑的，要早點回家喔。",
          "sc": "……开玩笑的，要早点回家哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3271,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33099,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜は月がやけに白くて",
          "tc": "不覺得今晚的月亮特別皎潔，",
          "sc": "不觉得今晚的月亮特别皎洁，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33106,
          "spk": "琪娜娜 (チナナ)",
          "ja": "目に刺さると思わないかい？",
          "tc": "很顯眼嗎？",
          "sc": "很显眼吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 33117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだか月に見られているみたいだよ",
          "tc": "就好像是月亮在看著我們一樣。",
          "sc": "就好像是月亮在看着我们一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3272,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 33141,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昼間と同じ道なのに、",
          "tc": "明明這條路跟白天時是同一條，",
          "sc": "明明这条路跟白天时是同一条，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 33148,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜が全然違う顔を見せてくるよ",
          "tc": "但晚上看起來卻是完全不同的模樣。",
          "sc": "但晚上看起来却是完全不同的模样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 33166,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は、どっちの顔が好みかな？",
          "tc": "<player>，你比較喜歡哪一種啊？",
          "sc": "<player>，你比较喜欢哪一种啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3273,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 163443,
          "spk": "林 (リン)",
          "ja": "世間一般的には新年度が始まるわけだし、",
          "tc": "既然世間都要開始新的一年了，",
          "sc": "既然世间都要开始新的一年了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 163450,
          "spk": "林 (リン)",
          "ja": "村の設備を改築するのもありかもしれないわね",
          "tc": "或許也可以考慮整修一下村子裡的設施了呢。",
          "sc": "或许也可以考虑整修一下村子里的设施了呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 163470,
          "spk": "木助 (キスケ)",
          "ja": "長いこと雨風に晒されて、",
          "tc": "畢竟經過長年風吹雨打，",
          "sc": "毕竟经过长年风吹雨打，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 163477,
          "spk": "木助 (キスケ)",
          "ja": "だいぶ老朽化が進んでるもんな",
          "tc": "那些設施都已經相當老舊了。",
          "sc": "那些设施都已经相当老旧了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 163488,
          "spk": "木助 (キスケ)",
          "ja": "んじゃ、まずは見積り出せよ",
          "tc": "那先報個預算給我吧。",
          "sc": "那先报个预算给我吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 163495,
          "spk": "木助 (キスケ)",
          "ja": "もらった分の仕事はきっちりこなすぜ",
          "tc": "只要錢到位，保證做到位。",
          "sc": "只要钱到位，保证做到位。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 163515,
          "spk": "林 (リン)",
          "ja": "詳細は後で詰めるとして、",
          "tc": "細節先等之後再談，",
          "sc": "细节先等之后再谈，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 163522,
          "spk": "林 (リン)",
          "ja": "村中の公共施設を建て替えた場合に",
          "tc": "如果要改建村子裡的公共設施，",
          "sc": "如果要改建村子里的公共设施，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 163529,
          "spk": "林 (リン)",
          "ja": "かかる費用は…………",
          "tc": "整個花費…………",
          "sc": "整个花费……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 163542,
          "spk": "木助 (キスケ)",
          "ja": "ん？　どうした？",
          "tc": "嗯？怎麼了？",
          "sc": "嗯？怎么了？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 163549,
          "spk": "木助 (キスケ)",
          "ja": "何か問題か？",
          "tc": "有什麼問題嗎？",
          "sc": "有什么问题吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 163562,
          "spk": "林 (リン)",
          "ja": "ねえキスケさん",
          "tc": "我說，木助哥。",
          "sc": "我说，木助哥。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 163569,
          "spk": "林 (リン)",
          "ja": "まとめて発注する分、",
          "tc": "要是全都發包給你的話，",
          "sc": "要是全都发包给你的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 163576,
          "spk": "林 (リン)",
          "ja": "割引きとかって？",
          "tc": "有沒有打折啊？",
          "sc": "有没有打折啊？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 163589,
          "spk": "木助 (キスケ)",
          "ja": "値下げはねえぞ",
          "tc": "才沒那種事。",
          "sc": "才没那种事。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 163596,
          "spk": "木助 (キスケ)",
          "ja": "知ってるだろ",
          "tc": "你也知道吧，",
          "sc": "你也知道吧，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 163603,
          "spk": "木助 (キスケ)",
          "ja": "俺はもらった分の仕事しかしねえよ",
          "tc": "我這個人就是收多少錢做多少事。",
          "sc": "我这个人就是收多少钱做多少事。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 163616,
          "spk": "林 (リン)",
          "ja": "そうよね……",
          "tc": "我想也是……",
          "sc": "我想也是……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 163623,
          "spk": "林 (リン)",
          "ja": "設備を改築するには",
          "tc": "但是想要整修設施，",
          "sc": "但是想要整修设施，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 163630,
          "spk": "林 (リン)",
          "ja": "村の財源が厳しいわ……",
          "tc": "村子實在經費拮据……",
          "sc": "村子实在经费拮据……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 163641,
          "spk": "林 (リン)",
          "ja": "みんながちゃんと村にお金を",
          "tc": "要是大家有好好繳錢給村子，",
          "sc": "要是大家有好好缴钱给村子，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 163648,
          "spk": "林 (リン)",
          "ja": "納めてくれればこんなことには……",
          "tc": "也不至於財政吃緊……",
          "sc": "也不至于财政吃紧……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 163659,
          "spk": "林 (リン)",
          "ja": "村の存続のためには",
          "tc": "為了村子的存亡……",
          "sc": "为了村子的存亡……"
        },
        {
          "f_idx": 25,
          "pidx_tc": 163666,
          "spk": "林 (リン)",
          "ja": "今後はもっと厳しく",
          "tc": "往後我應該要更加嚴格",
          "sc": "往后我应该要更加严格"
        },
        {
          "f_idx": 26,
          "pidx_tc": 163673,
          "spk": "林 (リン)",
          "ja": "取り立てるべきね",
          "tc": "向大家徵收稅金才行。",
          "sc": "向大家征收税金才行。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 163686,
          "spk": "木助 (キスケ)",
          "ja": "あんまやりすぎると村の連中から",
          "tc": "當心別做得太過頭了，",
          "sc": "当心别做得太过头了，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 163693,
          "spk": "木助 (キスケ)",
          "ja": "反感買うから気を付けろよ……",
          "tc": "否則會讓村裡的人反感的……",
          "sc": "否则会让村里的人反感的……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 163706,
          "spk": "林 (リン)",
          "ja": "ええ、もちろん分かってるわ！",
          "tc": "嗯，這點我當然知道！",
          "sc": "嗯，这点我当然知道！"
        },
        {
          "f_idx": 30,
          "pidx_tc": 163713,
          "spk": "林 (リン)",
          "ja": "ギリギリのラインを見定めて",
          "tc": "我會掌握好底線，",
          "sc": "我会掌握好底线，"
        },
        {
          "f_idx": 31,
          "pidx_tc": 163720,
          "spk": "林 (リン)",
          "ja": "上手いことやってみせるから！",
          "tc": "穩穩處理好這件事的！",
          "sc": "稳稳处理好这件事的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3274,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 163748,
          "spk": "林 (リン)",
          "ja": "ヨウが私を見ると怯えるのよね……",
          "tc": "洋每次看到我都會很害怕呢……",
          "sc": "洋每次看到我都会很害怕呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 163755,
          "spk": "林 (リン)",
          "ja": "取り立ては免除してあげているのに、",
          "tc": "明明我都允許她不用繳稅了……",
          "sc": "明明我都允许她不用缴税了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 163762,
          "spk": "林 (リン)",
          "ja": "なんだか納得いかないわ",
          "tc": "感覺心裡不太平衡呢。",
          "sc": "感觉心里不太平衡呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 163775,
          "spk": "今野 (コンノ)",
          "ja": "まァ、リンさんには村長としての威厳が",
          "tc": "這個嘛，林小姐相當具有身為村長的威嚴，",
          "sc": "这个嘛，林小姐相当具有身为村长的威严，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 163782,
          "spk": "今野 (コンノ)",
          "ja": "十分に備わっている反面、",
          "tc": "但是相對地，",
          "sc": "但是相对地，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 163789,
          "spk": "今野 (コンノ)",
          "ja": "親しまれ度が伸び悩んでいますからねェ",
          "tc": "親近度倒是一直停滯不前呢。",
          "sc": "亲近度倒是一直停滞不前呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 163802,
          "spk": "林 (リン)",
          "ja": "……何よ、親しまれ度って",
          "tc": "……親近度是什麼啊？",
          "sc": "……亲近度是什么啊？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 163809,
          "spk": "林 (リン)",
          "ja": "変な言葉を作らないでくれない？",
          "tc": "可以不要創造奇怪的名詞嗎。",
          "sc": "可以不要创造奇怪的名词吗。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 163822,
          "spk": "今野 (コンノ)",
          "ja": "そういうとこですよォ……",
          "tc": "就是這種態度不好啦……",
          "sc": "就是这种态度不好啦……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 163829,
          "spk": "今野 (コンノ)",
          "ja": "親しみやすさ、可愛がられやすさ、",
          "tc": "比方說好親近、惹人憐愛，",
          "sc": "比方说好亲近、惹人怜爱，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 163836,
          "spk": "今野 (コンノ)",
          "ja": "愛嬌などが足りてないってことですヨ",
          "tc": "還有可愛討喜的魅力還不夠唷。",
          "sc": "还有可爱讨喜的魅力还不够哟～。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 163847,
          "spk": "今野 (コンノ)",
          "ja": "スミレさんやコマコさんを見習ってみては？",
          "tc": "不妨參考一下堇怜先生和駒子小姐的舉止吧？",
          "sc": "不妨参考一下堇怜先生和驹子小姐的举止吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 163854,
          "spk": "今野 (コンノ)",
          "ja": "お二人にはヨウさんも",
          "tc": "妳看洋妹妹，",
          "sc": "你看洋妹妹，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 163861,
          "spk": "今野 (コンノ)",
          "ja": "よく懐いているでしょう？",
          "tc": "她跟那兩位很親近吧。",
          "sc": "她跟那两位很亲近吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 163872,
          "spk": "今野 (コンノ)",
          "ja": "リンさんもヨウさんに懐いてほしいのであれば",
          "tc": "如果林小姐也希望洋妹妹可以親近您的話，",
          "sc": "如果林小姐也希望洋妹妹可以亲近您的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 163879,
          "spk": "今野 (コンノ)",
          "ja": "何かしら変わる必要がありますねェ",
          "tc": "就必須做出一些改變呢～",
          "sc": "就必须做出一些改变呢～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 163892,
          "spk": "林 (リン)",
