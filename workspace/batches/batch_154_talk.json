          "tc": "那我就在晚上6點等你來，",
          "sc": "那我就在晚上6点等你来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 23508,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また後で会おうじゃないか",
          "tc": "待會見囉，",
          "sc": "待会儿见啦，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 23515,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待ってるよ",
          "tc": "我等你。",
          "sc": "我等你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3102,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 23537,
          "spk": "琪娜娜 (チナナ)",
