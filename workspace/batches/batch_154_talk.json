          "f_idx": 3,
          "pidx_tc": 23562,
          "spk": "琪娜娜 (チナナ)",
          "ja": "懲りずにまた誘うと思うけど、",
          "tc": "我想我之後應該還是會試著約你，",
          "sc": "我想我之后应该还是会试着约你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 23569,
          "spk": "琪娜娜 (チナナ)",
          "ja": "都合のいい時は乗っておくれよ",
          "tc": "你有空的話再答應吧。",
          "sc": "你有空的话再答应吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 23576,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃ、またね",
          "tc": "那就下次再見囉。",
          "sc": "那就下次再见啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3103,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 23600,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだ、<player>",
          "tc": "對了，<player>，",
          "sc": "对了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 23607,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミ、お泊まり会って興味ないかい？",
          "tc": "你對去別人家過夜有興趣嗎？",
          "sc": "你对去别人家过夜有兴趣吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 23618,
          "spk": "琪娜娜 (チナナ)",
          "ja": "友達の家に泊まって、",
          "tc": "就是去住朋友家，",
          "sc": "就是去住朋友家，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 23625,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遅くまでお喋りしたりするんだよ",
          "tc": "然後大家一起聊天聊到三更半夜。",
          "sc": "然后大家一起聊天聊到三更半夜。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 23632,
          "spk": "琪娜娜 (チナナ)",
          "ja": "乙女的に言うとパジャマパーティーだね",
