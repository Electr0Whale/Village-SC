          "f_idx": 13,
          "pidx_tc": 167058,
          "spk": "莲实 (ハスミ)",
          "ja": "過ごせるといいんですけど",
          "tc": "放鬆身心的時光。",
          "sc": "放松身心的时光。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 167069,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れたり困ったことがあれば、",
          "tc": "要是累了，或遇到什麼困難，",
          "sc": "要是累了，或遇到什么困难，"
