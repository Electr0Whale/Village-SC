          "f_idx": 9,
          "pidx_tc": 167026,
          "spk": "莲实 (ハスミ)",
          "ja": "……<player>さんならきっと、",
          "tc": "……是<player>你的話，",
          "sc": "……要是<player>的话，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 167033,
          "spk": "莲实 (ハスミ)",
          "ja": "私よりも上手に使いこなせると思います",
          "tc": "一定會比我更懂得如何善用它吧。",
          "sc": "一定会比我更懂得如何善用它吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 167044,
          "spk": "莲实 (ハスミ)",
          "ja": "いつも忙しくしている<player>さんが、",
          "tc": "希望這能讓總是忙碌的<player>，",
          "sc": "希望这能让总是忙碌的<player>，"
