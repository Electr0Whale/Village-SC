          "ja": "「山盛りトマト」はトマトを皿に山盛りにして",
          "tc": "「番茄山」是在盤子上堆一堆番茄的料理，",
          "sc": "“西红柿山”是在盘子上堆一堆西红柿的料理，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 23297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無心で食べることで完成するレシピだよ！",
          "tc": "心無旁鶩的享受這道料理也是食譜的步驟！",
          "sc": "心无旁鹜的享受这道料理也是食谱的步骤！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 23304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "マヨネーズを添えて、そのままかぶりつくんだ",
          "tc": "而且要搭配上美乃滋，直接大口吃下去。",
          "sc": "而且要搭配上蛋黄酱，直接大口吃下去。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 23315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トマトの純粋な味を楽しみたくなったら",
          "tc": "如果你想要享受番茄純粹的滋味，",
          "sc": "如果你想要享受西红柿纯粹的滋味，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 23322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ぜひ、素敵な山盛りトマトを作っておくれ",
          "tc": "一定要做一盤超棒的番茄山來吃。",
          "sc": "一定要做一盘超棒的西红柿山来吃。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 23329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>も一緒にリコピン中毒になろう",
          "tc": "<player>也跟我一起來茄紅素中毒吧。",
          "sc": "<player>也跟我一起来茄红素中毒吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3100,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 23353,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……どうしてかな",
          "tc": "嗯……不知道為什麼，",
          "sc": "嗯……不知道为什么，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 23360,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はキミとゆっくり",
          "tc": "今天就是想跟你",
          "sc": "今天就是想跟你"
        },
        {
          "f_idx": 2,
          "pidx_tc": 23367,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お喋りしたい気分だよ",
          "tc": "悠哉地聊聊天。",
          "sc": "悠哉地聊聊天。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 23378,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうだ、今夜って時間あるかな？",
          "tc": "對了，你今晚有空嗎？",
          "sc": "对了，你今晚有空吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 23385,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチと一緒に夕食でもどうだろう",
          "tc": "要不要跟我一起吃晚餐？",
          "sc": "要不要跟我一起吃晚餐？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 23392,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご馳走するよ",
          "tc": "我請客喔。",
          "sc": "我请客哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 23403,
          "spk": "琪娜娜 (チナナ)",
          "ja": "午後６時に、",
          "tc": "晚上6點，",
          "sc": "晚上6点，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 23410,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつもお店を出してるところに来てくれれば",
          "tc": "到我平常擺攤的地方，",
          "sc": "到我平常摆摊的地方，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 23417,
          "spk": "琪娜娜 (チナナ)",
          "ja": "用意しておくからさ",
          "tc": "我會準備好等你來的。",
          "sc": "我会准备好等你来的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 23428,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大したおもてなしはできないけど、",
          "tc": "雖然沒辦法給你什麼盛大的款待，",
          "sc": "虽然没办法给你什么盛大的款待，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 23435,
          "spk": "琪娜娜 (チナナ)",
          "ja": "楽しい時間を過ごせると思うよ",
          "tc": "但我想應該能夠度過一段滿愉快的時光。",
          "sc": "但我想应该能够度过一段满愉快的时光。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 23442,
          "spk": "琪娜娜 (チナナ)",
          "ja": "都合はどうだい？",
          "tc": "怎麼樣？有時間嗎？",
          "sc": "怎么样？有时间吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 23451,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 13,
          "pidx_tc": 23458,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3101,
      "rec_id": "TALK_ID_STREET_VENDOR_SPECIAL_20_114_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 23476,
          "spk": "琪娜娜 (チナナ)",
          "ja": "来られそうなんだね",
          "tc": "你能來啊，",
          "sc": "你能来啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 23483,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それは良かったよ",
          "tc": "那真是太好了。",
          "sc": "那真是太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 23490,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜が楽しみだ",
          "tc": "真期待今晚。",
          "sc": "真期待今晚。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 23501,
          "spk": "琪娜娜 (チナナ)",
