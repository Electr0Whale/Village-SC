          "f_idx": 3,
          "pidx_tc": 166429,
          "spk": "莲实 (ハスミ)",
          "ja": "日焼けと同じように肌のケアが大事ですが、",
          "tc": "雖然和日曬一樣，都需要做好肌膚防曬，",
          "sc": "虽然和日晒一样，都需要做好肌肤防晒，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 166436,
          "spk": "莲实 (ハスミ)",
          "ja": "特に目の保護は忘れないようにしましょう",
          "tc": "但更不能忘了要保護眼睛喔。",
          "sc": "但更不能忘了要保护眼睛哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
