      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 166951,
          "spk": "莲实 (ハスミ)",
          "ja": "これはアロマディフューザーといって、",
          "tc": "這個叫做香氛擴香瓶，",
          "sc": "这个叫做香薰扩香瓶，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 166958,
          "spk": "莲实 (ハスミ)",
