      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270894,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>まるで瑞々しいマスカットや白桃を思わせる",
          "tc": "<speed 2.0>特徵是茶湯帶有一股清爽芳香，",
          "sc": "<speed 2.0>特征是茶汤带有一股清爽芳香，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270901,
          "spk": "今野 (コンノ)",
          "ja": "爽やかな芳香が特徴なんですよォ",
          "tc": "宛如鮮嫩多汁的麝香葡萄或白桃一般～",
          "sc": "宛如鲜嫩多汁的麝香葡萄或白桃一般～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270908,
          "spk": "今野 (コンノ)",
          "ja": "……そう、これこそが初摘みダージリンの真髄！</speed>",
          "tc": "……沒錯，這正是初摘大吉嶺茶葉的精隨啊！</speed>",
          "sc": "……没错，这正是初摘大吉岭茶叶的精随啊！</speed>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270917,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>お値段はなんと１０グラムで１,５００円！",
          "tc": "<speed 2.0>而且價格竟然高達10克1500元！",
          "sc": "<speed 2.0>而且价格竟然高达10克1500元！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270924,
          "spk": "今野 (コンノ)",
          "ja": "ご覧ください、このパッケージから漂う高級感を",
