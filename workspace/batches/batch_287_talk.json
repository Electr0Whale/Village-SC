      "rec_id": "TALK_ID_10_0302_021_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251095,
          "spk": "帷 (トバリ)",
          "ja": "……なに？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251102,
          "spk": "帷 (トバリ)",
          "ja": "私が手伝っているのが、そんなにおかしい？",
          "tc": "我來幫忙有那麼奇怪嗎？",
          "sc": "我来帮忙有那么奇怪吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251115,
          "spk": "驹子 (コマコ)",
          "ja": "トバリはリンの命令で、",
          "tc": "帷因為林的命令，",
          "sc": "帷因为林的命令，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 251122,
          "spk": "驹子 (コマコ)",
          "ja": "お手伝い券の消化中なんだ",
          "tc": "正在用掉幫忙券。",
          "sc": "正在用掉帮忙券。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 251133,
          "spk": "驹子 (コマコ)",
          "ja": "私が頼りないのを見かねて、",
          "tc": "她看不下去我這麼靠不住，",
          "sc": "她看不下去我这么靠不住，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 251140,
          "spk": "驹子 (コマコ)",
          "ja": "仕方なく手伝ってくれてるんだよ",
          "tc": "才不得已來幫我的。",
          "sc": "才不得已来帮我的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 251153,
          "spk": "帷 (トバリ)",
          "ja": "ところでアンタは一体何を……",
          "tc": "話說回來，你到底是有什麼事……",
          "sc": "话说回来，你到底是有什么事……"
        }
      ]
    },
