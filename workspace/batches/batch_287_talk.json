  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8182,
      "rec_id": "TALK_ID_10_0202_051_01_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235491,
          "spk": "林 (リン)",
          "ja": "さあ！　着いたわ！",
          "tc": "好！我們到了！",
          "sc": "好！我们到了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235498,
          "spk": "林 (リン)",
          "ja": "ここが、この村を築いてきた、",
          "tc": "這裡就是沉睡著建立這村子的、",
          "sc": "这里就是沉睡着建立这村子的、"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235505,
          "spk": "林 (リン)",
          "ja": "偉大なご先祖様たちが眠る墓地よ！",
          "tc": "我們偉大祖先們的墓地！",
          "sc": "我们伟大祖先们的墓地！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235518,
          "spk": "驹子 (コマコ)",
          "ja": "でも、<player>にはここで眠る",
          "tc": "可是，<player>的祖先",
          "sc": "可是，<player>的祖先"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235525,
          "spk": "驹子 (コマコ)",
          "ja": "ご先祖様なんて、いないはずだけど……",
          "tc": "應該不在這裡才對……",
          "sc": "应该不在这里才对……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235532,
          "spk": "驹子 (コマコ)",
          "ja": "どうして一緒に来てもらったの？",
          "tc": "為什麼也一起來了呢？",
          "sc": "为什么也一起来了呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8183,
      "rec_id": "TALK_ID_10_0202_051_01_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235550,
          "spk": "林 (リン)",
          "ja": "私たちがお参りに集中できるように、",
          "tc": "為了讓我們能專心掃墓，",
          "sc": "为了让我们能专心扫墓，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235557,
          "spk": "林 (リン)",
          "ja": "草むしりを手伝ってもらうことにしたの",
          "tc": "我拜託他來幫我們除草。",
          "sc": "我拜托他来帮我们除草。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235570,
          "spk": "驹子 (コマコ)",
          "ja": "あ……ああ……",
          "tc": "啊……這樣啊……",
          "sc": "啊……这样啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235577,
          "spk": "驹子 (コマコ)",
          "ja": "雑用を引き受けてもらうために……",
          "tc": "為了讓他做這些雜務……",
          "sc": "为了让他做这些杂务……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235590,
          "spk": "林 (リン)",
          "ja": "違うわ、大事な仕事よ！",
          "tc": "不對，這是重要的工作！",
          "sc": "不对，这是重要的工作！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235597,
          "spk": "林 (リン)",
          "ja": "全く、人聞きが悪いったら！",
          "tc": "真是的，說得那麼難聽！",
          "sc": "真是的，说得那么难听！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8184,
      "rec_id": "TALK_ID_10_0202_051_01_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235622,
          "spk": "林 (リン)",
          "ja": "何をぼーっとしてるのかしら！",
          "tc": "你怎麼還在發呆！",
          "sc": "你怎么还在发呆！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235629,
          "spk": "林 (リン)",
          "ja": "今日という日は、限られてるのよ！",
          "tc": "今天這一天可是很有限的！",
          "sc": "今天这一天可是很有限的！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235636,
          "spk": "林 (リン)",
          "ja": "のんびりしてる場合じゃないでしょ！",
          "tc": "沒有時間拖拖拉拉的！",
          "sc": "没有时间拖拖拉拉的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8185,
      "rec_id": "TALK_ID_10_0202_051_01_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235654,
          "spk": "林 (リン)",
          "ja": "コマコも、<player>がサボらないように、",
          "tc": "駒子也要好好盯著<player>，",
          "sc": "驹子也要好好盯着<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235661,
          "spk": "林 (リン)",
          "ja": "ちゃんと目を光らせておきなさいね！",
          "tc": "別讓他偷懶喔！",
          "sc": "别让他偷懒哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235681,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん、わかった……",
          "tc": "呃、嗯，我知道了……",
          "sc": "呃、嗯，我知道了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8186,
      "rec_id": "TALK_ID_10_0202_051_01_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235699,
          "spk": "林 (リン)",
          "ja": "さあ、<player>！",
          "tc": "好了，<player>！",
          "sc": "好了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235706,
          "spk": "林 (リン)",
          "ja": "さっそく草むしりを始めてちょうだい！",
          "tc": "快點開始除草吧！",
          "sc": "快点开始除草吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8187,
      "rec_id": "TALK_ID_10_0202_051_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235732,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235739,
          "spk": "驹子 (コマコ)",
          "ja": "今日も朝から大変だね……",
          "tc": "今天也從一大早開始就很辛苦呢……",
          "sc": "今天也从一大早开始就很辛苦呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235750,
          "spk": "驹子 (コマコ)",
          "ja": "私も今日は、リンに叩き起こされて",
          "tc": "我今天也是被林吵醒，",
          "sc": "我今天也是被林吵醒，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235757,
          "spk": "驹子 (コマコ)",
          "ja": "連れてこられたんだよ",
          "tc": "硬是被一起帶過來的。",
          "sc": "硬是被一起带过来的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235768,
          "spk": "驹子 (コマコ)",
          "ja": "このあたりは危ない獣もよく出るから、",
          "tc": "這附近常有危險的野獸出沒，",
          "sc": "这附近常有危险的野兽出没，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235775,
          "spk": "驹子 (コマコ)",
          "ja": "いざという時は、",
          "tc": "所以萬一發生狀況，",
          "sc": "所以万一发生状况，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 235782,
          "spk": "驹子 (コマコ)",
          "ja": "私が追い払わないといけないんだ",
          "tc": "我就必須趕走牠們才行。",
          "sc": "我就必须赶走它们才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8188,
      "rec_id": "TALK_ID_10_0202_051_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 235808,
          "spk": "驹子 (コマコ)",
          "ja": "私も後で、お母さんとお父さんに",
          "tc": "我等一下也得去祭拜",
          "sc": "我等一下也得去祭拜"
        },
        {
          "f_idx": 1,
          "pidx_tc": 235815,
          "spk": "驹子 (コマコ)",
          "ja": "お参りしなきゃいけないんだけど……",
          "tc": "爸爸媽媽，可是……",
          "sc": "爸爸妈妈，可是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 235824,
          "spk": "驹子 (コマコ)",
          "ja": "私、両親のことは全然覚えていなくて、",
          "tc": "我幾乎不記得他們的事情了，",
          "sc": "我几乎不记得他们的事情了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 235831,
          "spk": "驹子 (コマコ)",
          "ja": "なんて祈ればいいのか、わからないの……",
          "tc": "不知道該對他們祈禱什麼才好……",
          "sc": "不知道该对他们祈祷什么才好……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 235842,
          "spk": "驹子 (コマコ)",
          "ja": "だから実を言うと、",
          "tc": "所以老實說，",
          "sc": "所以老实说，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 235849,
          "spk": "驹子 (コマコ)",
          "ja": "お墓参りって苦手なんだよね……",
          "tc": "我其實不太喜歡掃墓呢……",
          "sc": "我其实不太喜欢扫墓呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8189,
      "rec_id": "TALK_ID_10_0202_051_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236011,
          "spk": "茶梅 (サザンカ)",
          "ja": "ところでさ",
          "tc": "話說回來，",
          "sc": "话说回来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236018,
          "spk": "茶梅 (サザンカ)",
          "ja": "それ、ウチの家の墓だよ？",
          "tc": "那可是我家的墳墓啊。",
          "sc": "那可是我家的坟墓啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236031,
          "spk": "四郎治 (シロージ)",
          "ja": "知ってるよ",
          "tc": "我知道。",
          "sc": "我知道。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236044,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんな熱心にお参りしなくてもいいって",
          "tc": "不需要這麼認真幫忙掃墓。",
          "sc": "不需要这么认真帮忙扫墓。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 236071,
          "spk": "四郎治 (シロージ)",
          "ja": "いや、させてくれ",
          "tc": "不，讓我做吧。",
          "sc": "不，让我做吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 236078,
          "spk": "四郎治 (シロージ)",
          "ja": "あれからまだ、十年しか経ってないんだから",
          "tc": "畢竟從那之後，也才過了十年而已。",
          "sc": "毕竟从那之后，也才过了十年而已。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 236091,
          "spk": "茶梅 (サザンカ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8190,
      "rec_id": "TALK_ID_10_0202_051_08_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237453,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237460,
          "spk": "驹子 (コマコ)",
          "ja": "迷子になっちゃうから、",
          "tc": "要是迷路就不好了，",
          "sc": "要是迷路就不好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237467,
          "spk": "驹子 (コマコ)",
          "ja": "あまり遠くに行っちゃダメだよ！",
          "tc": "不可以去太遠的地方喔！",
          "sc": "不可以去太远的地方哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8191,
      "rec_id": "TALK_ID_10_0202_051_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237487,
          "spk": "主角心声/旁白/选项",
          "ja": "もう雑草は見当たらない……",
          "tc": "已經找不到雜草了……",
          "sc": "已经找不到杂草了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237494,
          "spk": "主角心声/旁白/选项",
          "ja": "墓地をキレイにした！",
          "tc": "把墓地打掃乾淨了！",
          "sc": "把墓地打扫干净了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237501,
          "spk": "主角心声/旁白/选项",
          "ja": "リンに報告しよう！",
          "tc": "去向林報告吧！",
          "sc": "去向林报告吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8192,
      "rec_id": "TALK_ID_10_0202_051_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237521,
          "spk": "林 (リン)",
          "ja": "<player>、終わったの？",
          "tc": "<player>，你做完了嗎？",
          "sc": "<player>，你做完了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237534,
          "spk": "林 (リン)",
          "ja": "確かに、もう雑草は見当たらないわね！",
          "tc": "的確是看不到雜草了呢！",
          "sc": "的确是看不到杂草了呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237541,
          "spk": "林 (リン)",
          "ja": "よくやったわ、お疲れ様！",
          "tc": "做得好，辛苦你了！",
          "sc": "做得好，辛苦你了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237554,
          "spk": "林 (リン)",
          "ja": "私たちのお参りも終わった所よ",
          "tc": "我們也正好掃完墓了，",
          "sc": "我们也正好扫完墓了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237561,
          "spk": "林 (リン)",
          "ja": "一緒に、あなたの庭まで帰りましょうか",
          "tc": "一起走回你家庭院吧。",
          "sc": "一起走回你家庭院吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8193,
      "rec_id": "TALK_ID_10_0202_051_09_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237585,
          "spk": "林 (リン)",
          "ja": "今日はありがとう",
          "tc": "今天真是謝謝你了，",
          "sc": "今天真是谢谢你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237592,
          "spk": "林 (リン)",
          "ja": "あなたのおかげで、予定より早く",
          "tc": "多虧了你，",
          "sc": "多亏了你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237599,
          "spk": "林 (リン)",
          "ja": "お墓の掃除が片付いた",
          "tc": "掃墓比預定時間還早結束了。",
          "sc": "扫墓比预定时间还早结束了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237612,
          "spk": "林 (リン)",
          "ja": "……あ、そうだ！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237619,
          "spk": "林 (リン)",
          "ja": "お墓掃除を手伝ってくれたお礼を、",
          "tc": "我都忘了把幫忙掃墓的謝禮",
          "sc": "我都忘了把帮忙扫墓的谢礼"
        },
        {
          "f_idx": 5,
          "pidx_tc": 237626,
          "spk": "林 (リン)",
          "ja": "渡し忘れていたわ！",
          "tc": "交給你了！",
          "sc": "交给你了！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 237639,
          "spk": "林 (リン)",
          "ja": "改めて、お疲れさま！",
          "tc": "再次跟你說聲辛苦了！",
          "sc": "再次跟你说声辛苦了！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 237646,
          "spk": "林 (リン)",
          "ja": "よく頑張ってくれたわね！",
          "tc": "你真的很努力呢！",
          "sc": "你真的很努力呢！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 237653,
          "spk": "林 (リン)",
          "ja": "大したものじゃないけれど、受け取りなさい！",
          "tc": "雖然不是什麼貴重的東西，但就收下吧！",
          "sc": "虽然不是什么贵重的东西，但就收下吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8194,
      "rec_id": "TALK_ID_10_0202_051_09_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237677,
          "spk": "林 (リン)",
          "ja": "あなたの家は、物が少ないと思ったから、",
          "tc": "我想你家裡東西應該還很少，",
          "sc": "我想你家里东西应该还很少，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237684,
          "spk": "林 (リン)",
          "ja": "飾れて実用的な物を選んだのよ！",
          "tc": "所以選了能當擺飾的實用物品。",
          "sc": "所以选了能当摆饰的实用物品。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237691,
          "spk": "林 (リン)",
          "ja": "それを置いておけば、生活感が出るでしょう？",
          "tc": "擺上這個，應該會更有生活氣息了吧？",
          "sc": "摆上这个，应该会更有生活气息了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237704,
          "spk": "林 (リン)",
          "ja": "あなたの日頃の働きに、感謝を込めた物だから",
          "tc": "這裡面包含了對你日常工作的感謝之意，",
          "sc": "这里面包含了对你日常工作的感谢之意，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237711,
          "spk": "林 (リン)",
          "ja": "遠慮せず、受け取ってちょうだいね",
          "tc": "別客氣，收下吧。",
          "sc": "别客气，收下吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 237731,
          "spk": "林 (リン)",
          "ja": "さて、私はそろそろ失礼するわ",
