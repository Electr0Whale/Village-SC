          "ja": "きっと良くないことが起きちゃうから……！",
          "tc": "不然一定會發生不好的事……！",
          "sc": "不然一定会发生不好的事……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 264639,
          "spk": "名护 (ナゴ)",
          "ja": "あはは……！",
          "tc": "啊哈哈……！",
