        {
          "f_idx": 3,
          "pidx_tc": 250891,
          "spk": "驹子 (コマコ)",
          "ja": "夜中にピロの鳴き声を、聞いたって言うの",
          "tc": "在晚上聽到了嗶羅的叫聲。",
          "sc": "在晚上听到了哔罗的叫声。"
        }
      ]
    },
    {
