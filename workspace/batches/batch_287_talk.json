      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270824,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>二年前に注文したダージリンの茶葉が、",
          "tc": "<speed 2.0>我兩年前訂的大吉嶺茶葉啊，",
          "sc": "<speed 2.0>我两年前订的大吉岭茶叶啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270831,
          "spk": "今野 (コンノ)",
          "ja": "先ほどやっっっと届きましてね！",
          "tc": "剛才終～～～於送來了！",
          "sc": "刚才终～～～于送来了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270838,
          "spk": "今野 (コンノ)",
          "ja": "この茶葉はちょっとした逸品でしてェ</speed>",
          "tc": "這款茶葉可是極品中的極品啊～</speed>",
          "sc": "这款茶叶可是极品中的极品啊～</speed>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270849,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>噂ではヒマラヤの麓、標高二千メートルの",
          "tc": "<speed 2.0>據說是在喜馬拉雅山腳下，",
          "sc": "<speed 2.0>据说是在喜马拉雅山脚下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270856,
          "spk": "今野 (コンノ)",
          "ja": "茶園で、春のごく短い期間だけ手摘みされる",
          "tc": "標高2000公尺的茶園裡，只在春天",
          "sc": "标高2000公尺的茶园里，只在春天"
        },
        {
          "f_idx": 5,
          "pidx_tc": 270863,
          "spk": "今野 (コンノ)",
          "ja": "一番摘みのファーストフラッシュだそうでェ</speed>",
          "tc": "極短的採摘期才能手工採收的初摘茶喔～</speed>",
          "sc": "极短的采摘期才能手工采收的初摘茶哟～～</speed>"
        },
