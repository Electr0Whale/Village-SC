      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265772,
          "spk": "名护 (ナゴ)",
          "ja": "これは彼ヶ津村の民話なんだが、",
          "tc": "這本是關於彼津村的民間故事的書，",
          "sc": "这本是关于彼津村的民间故事的书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265779,
          "spk": "名护 (ナゴ)",
          "ja": "なんだか不穏なことが、書いてあってね……",
          "tc": "但裡面寫了一些感覺不太對勁的內容………",
          "sc": "但里面写了一些感觉不太对劲的内容……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265786,
          "spk": "名护 (ナゴ)",
          "ja": "同じことが起きるのではと心配になって……",
          "tc": "我擔心會不會發生同樣的事……",
          "sc": "我担心会不会发生同样的事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265797,
          "spk": "名护 (ナゴ)",
          "ja": "キミの意見を聞きたいんだ",
          "tc": "所以想聽聽你的意見。",
          "sc": "所以想听听你的意见。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265804,
          "spk": "名护 (ナゴ)",
          "ja": "今から読んであげるから、聞いてくれるかな？",
          "tc": "我現在就念給你聽，你能聽聽看嗎？",
          "sc": "我现在就念给你听，你能听听看吗？"
        }
      ]
    },
