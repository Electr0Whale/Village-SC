          "f_idx": 8,
          "pidx_tc": 337332,
          "spk": "四郎治 (シロージ)",
          "ja": "あの不思議なキツネには、",
          "tc": "會把這把柴刀交出去，",
          "sc": "会把这把柴刀交出去，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 337339,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコの記憶を封じ続けてもらうために",
