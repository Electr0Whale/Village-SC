      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336404,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃん！",
          "tc": "哥哥！",
          "sc": "哥哥！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336417,
          "spk": "茶梅 (サザンカ)",
          "ja": "シロージ……アンタ……",
          "tc": "四郎治……你……",
          "sc": "四郎治……你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336424,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんでここに……",
          "tc": "你怎麼會在這裡……",
          "sc": "你怎么会在这里……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 336437,
          "spk": "四郎治 (シロージ)",
          "ja": "始めたのは、俺だからな",
          "tc": "畢竟這件事因我而起，",
          "sc": "毕竟这件事因我而起，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 336444,
          "spk": "四郎治 (シロージ)",
          "ja": "終わらせに来た",
          "tc": "我是來劃下句點的。",
          "sc": "我是来划下句点的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 336457,
          "spk": "驹子 (コマコ)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5752,
      "rec_id": "TALK_ID_10_0503_345_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336475,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、あの時の獣だな？",
          "tc": "祢是當時的野獸吧？",
          "sc": "你是当时的野兽吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336482,
          "spk": "四郎治 (シロージ)",
          "ja": "……約束を違えに来たぞ",
          "tc": "……我來打破約定了。",
          "sc": "……我来打破约定了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336495,
          "spk": "驹子 (コマコ)",
          "ja": "約束……？",
          "tc": "約定……？",
          "sc": "约定……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 336502,
          "spk": "驹子 (コマコ)",
          "ja": "それって、神器を渡したときの……",
          "tc": "那是指，交出神器時許下的……",
          "sc": "那是指，交出神器时许下的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 336522,
          "spk": "四郎治 (シロージ)",
          "ja": "……コマコの記憶の封印は、",
          "tc": "……看來已經不需要封印",
          "sc": "……看来已经不需要封印"
        },
        {
          "f_idx": 6,
          "pidx_tc": 336529,
          "spk": "四郎治 (シロージ)",
          "ja": "もう必要ないらしい",
          "tc": "駒子的記憶了。",
          "sc": "驹子的记忆了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5753,
      "rec_id": "TALK_ID_10_0503_345_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336553,
          "spk": "？？？ (未知角色)",
          "ja": "そうか？",
          "tc": "是嗎？",
          "sc": "是吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336560,
          "spk": "？？？ (未知角色)",
          "ja": "再び心を病み",
          "tc": "她可能會再次心靈受創，",
          "sc": "她可能会再次心灵受创，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336567,
          "spk": "？？？ (未知角色)",
          "ja": "塞ぎ込むやもしれん",
          "tc": "陷入鬱鬱寡歡的情況。",
          "sc": "陷入郁郁寡欢的情况。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5754,
      "rec_id": "TALK_ID_10_0503_345_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336587,
          "spk": "四郎治 (シロージ)",
          "ja": "いいや、俺はそうは思わねぇよ",
          "tc": "不，我不那麼認為。",
          "sc": "不，我不那么认为。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336594,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコに隠してたことが、バレちまったしな",
          "tc": "畢竟以前瞞著駒子的事已經曝光了。",
          "sc": "毕竟以前瞒着驹子的事已经曝光了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336605,
          "spk": "四郎治 (シロージ)",
          "ja": "……いつまでも、この場所を",
          "tc": "……也無法讓她",
          "sc": "……也无法让她"
        },
        {
          "f_idx": 3,
          "pidx_tc": 336612,
          "spk": "四郎治 (シロージ)",
          "ja": "避け続けさせるわけにもいかない",
          "tc": "永遠避開這個地方。",
          "sc": "永远避开这个地方。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 336621,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカだって、",
          "tc": "況且茶梅也很想知道，",
          "sc": "况且茶梅也很想知道，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 336628,
          "spk": "四郎治 (シロージ)",
          "ja": "じいさんの話の真実を知りたがってる",
          "tc": "她爺爺說的話是真是假。",
          "sc": "她爷爷说的话是真是假。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 336639,
          "spk": "四郎治 (シロージ)",
          "ja": "だから……<strong>二つ目の約束</strong>――",
          "tc": "所以……<strong>第二個約定</strong>──",
          "sc": "所以……<strong>第二个约定</strong>——"
        },
        {
          "f_idx": 7,
          "pidx_tc": 336648,
          "spk": "四郎治 (シロージ)",
          "ja": "<strong>俺は、二度とキツネを傷つけてはならない</strong>……",
          "tc": "<strong>我不會再次傷害狐狸</strong>……",
          "sc": "<strong>我不会再次伤害狐狸</strong>……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 336655,
          "spk": "四郎治 (シロージ)",
          "ja": "この約束を破れば、",
          "tc": "只要我打破這個約定，",
          "sc": "只要我打破这个约定，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 336662,
          "spk": "四郎治 (シロージ)",
          "ja": "神器とコマコの記憶を返すんだな？",
          "tc": "祢就會把神器和駒子的記憶都還回來對吧？",
          "sc": "你就会把神器和驹子的记忆都还回来对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5755,
      "rec_id": "TALK_ID_10_0503_345_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336686,
          "spk": "四郎治 (シロージ)",
          "ja": "長らくの協力、感謝する",
          "tc": "感謝祢長久以來的協助。",
          "sc": "感谢你长久以来的协助。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5756,
      "rec_id": "TALK_ID_10_0503_345_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336721,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……キツネ？",
          "tc": "咦……狐狸？",
          "sc": "咦……狐狸？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336728,
          "spk": "驹子 (コマコ)",
          "ja": "キツネが化けてたの！？",
          "tc": "是狐狸化身的嗎！？",
          "sc": "是狐狸化身的吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336739,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんが神器を渡した相手って……",
          "tc": "原來爺爺說過的拿走神器的……",
          "sc": "原来爷爷说过的拿走神器的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 336746,
          "spk": "茶梅 (サザンカ)",
          "ja": "キツネだったってこと！？",
          "tc": "居然是狐狸！？",
          "sc": "居然是狐狸！？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 336759,
          "spk": "四郎治 (シロージ)",
          "ja": "キツネを傷つけるだけでも、",
          "tc": "為了不因只是傷到狐狸",
          "sc": "为了不因只是伤到狐狸"
        },
        {
          "f_idx": 5,
          "pidx_tc": 336766,
          "spk": "四郎治 (シロージ)",
          "ja": "約束を破ることになるとは……",
          "tc": "就違背約定……",
          "sc": "就违背约定……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 336773,
          "spk": "四郎治 (シロージ)",
          "ja": "……苦労したぜ",
          "tc": "……我真是費盡苦心啊。",
          "sc": "……我真是费尽苦心啊。"
        }
      ]
    },
    {
