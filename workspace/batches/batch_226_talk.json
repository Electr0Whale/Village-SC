          "pidx_tc": 337912,
          "spk": "茶梅 (サザンカ)",
          "ja": "となると、イチからマシンを",
          "tc": "既然如此，",
          "sc": "既然如此，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 337919,
          "spk": "茶梅 (サザンカ)",
          "ja": "発明しちゃったほうが早そーでさ",
          "tc": "感覺從頭發明一台新機器還比較快。",
          "sc": "感觉从头发明一台新机器还比较快。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 337930,
          "spk": "茶梅 (サザンカ)",
          "ja": "うう～ん……スマホのディスプレイと……",
          "tc": "嗯……手機螢幕跟……",
          "sc": "嗯……手机萤幕跟……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 337937,
          "spk": "茶梅 (サザンカ)",
          "ja": "やっぱり製氷皿は外せないよね……",
          "tc": "果然還是少不了製冰盒呢……",
          "sc": "果然还是少不了制冰盒呢……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 337950,
          "spk": "驹子 (コマコ)",
          "ja": "発明品に製氷皿……！？",
          "tc": "用製冰盒發明機器……！？",
          "sc": "用制冰盒发明机器……！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5771,
      "rec_id": "TALK_ID_10_0503_347_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337968,
          "spk": "驹子 (コマコ)",
          "ja": "どんなマシンができるのか、",
          "tc": "雖然會做出什麼樣的機器，",
          "sc": "虽然会做出什么样的机器，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337975,
          "spk": "驹子 (コマコ)",
          "ja": "全然わからないけど、ワクワクするね",
          "tc": "我完全沒概念，但真令人期待呢。",
          "sc": "我完全没概念，但真令人期待呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5772,
      "rec_id": "TALK_ID_10_0503_347_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337993,
          "spk": "驹子 (コマコ)",
          "ja": "神器探しではすごくお世話になったし、",
          "tc": "之前尋找神器的時候，妳幫了我很多忙，",
          "sc": "之前寻找神器的时候，你帮了我很多忙，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338000,
          "spk": "驹子 (コマコ)",
          "ja": "私も「空に浮く鍋」探し、手伝わせてほしいな",
          "tc": "所以我也想幫忙找「飄浮在空中的鍋子」。",
          "sc": "所以我也想帮忙找“飘浮在空中的锅子”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338020,
          "spk": "茶梅 (サザンカ)",
          "ja": "それはありがたいけど……",
          "tc": "那真是太感激妳了……",
          "sc": "那真是太感激你了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338027,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも、時間の無駄になるかもよ？",
          "tc": "但是，可能只會白白浪費時間喔！",
          "sc": "但是，可能只会白白浪费时间哦！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 338038,
          "spk": "茶梅 (サザンカ)",
          "ja": "胡散臭すぎるでしょ、",
          "tc": "畢竟「飄浮在空中的鍋子」",
          "sc": "毕竟“飘浮在空中的锅子”"
        },
        {
          "f_idx": 6,
          "pidx_tc": 338045,
          "spk": "茶梅 (サザンカ)",
          "ja": "「空に浮く鍋」って",
          "tc": "聽起來真的超可疑的吧。",
          "sc": "听起来真的超可疑的吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 338058,
          "spk": "驹子 (コマコ)",
          "ja": "そんなの気にしないよ",
          "tc": "那種事我不在意啦。",
          "sc": "那种事我不在意啦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 338065,
          "spk": "驹子 (コマコ)",
          "ja": "私がやりたいから、やるんだよ",
          "tc": "因為我是想幫忙才幫的。",
          "sc": "因为我是想帮忙才帮的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 338078,
          "spk": "茶梅 (サザンカ)",
          "ja": "……ん、わかった",
          "tc": "……嗯，我知道了。",
          "sc": "……嗯，我知道了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 338085,
          "spk": "茶梅 (サザンカ)",
          "ja": "サンキュー",
          "tc": "謝啦～",
          "sc": "谢啦～"
        }
      ]
    },
