      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336880,
          "spk": "茶梅 (サザンカ)",
          "ja": "コマコ？",
          "tc": "駒子？",
          "sc": "驹子？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336887,
          "spk": "茶梅 (サザンカ)",
          "ja": "大丈夫？",
          "tc": "妳還好嗎？",
          "sc": "你还好吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 336898,
          "spk": "驹子 (コマコ)",
          "ja": "うん……平気……",
          "tc": "嗯……我沒事……",
          "sc": "嗯……我没事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 336905,
          "spk": "驹子 (コマコ)",
          "ja": "急に、色々思い出したから……",
          "tc": "只是因為突然想起了很多事……",
          "sc": "只是因为突然想起了很多事……"
        }
      ]
    },
    {
      "file": "talk.dat",
