      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336930,
          "spk": "驹子 (コマコ)",
          "ja": "……それより、お兄ちゃん",
          "tc": "……比起這個，哥哥，",
          "sc": "……比起这个，哥哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336937,
          "spk": "驹子 (コマコ)",
          "ja": "そのナタは……？",
          "tc": "那把柴刀是……？",
          "sc": "那把柴刀是……？"
        }
      ]
    },
    {
      "file": "talk.dat",
