      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338160,
          "spk": "今野 (コンノ)",
          "ja": "嫌ですって！",
          "tc": "就說我不要了！",
          "sc": "就说我不要了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338167,
          "spk": "今野 (コンノ)",
          "ja": "離してくださいヨ！",
          "tc": "請放開我！",
          "sc": "请放开我！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 338178,
          "spk": "驹子 (コマコ)",
          "ja": "ええっ？",
          "tc": "咦咦？",
          "sc": "咦咦？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338185,
          "spk": "驹子 (コマコ)",
          "ja": "ちょ、ちょっとお兄ちゃん？",
          "tc": "等、等一下，哥哥？",
          "sc": "等、等一下，哥哥？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338192,
          "spk": "驹子 (コマコ)",
          "ja": "どうしたの？",
          "tc": "這是怎麼回事？",
          "sc": "这是怎么回事？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5776,
      "rec_id": "TALK_ID_10_0503_347_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338214,
          "spk": "四郎治 (シロージ)",
          "ja": "コンノが怪我した",
          "tc": "今野受傷了。",
          "sc": "今野受伤了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338221,
          "spk": "四郎治 (シロージ)",
          "ja": "ハスミんとこに連れてく",
          "tc": "我要帶他去蓮實那裡。",
          "sc": "我要带他去莲实那里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 338232,
          "spk": "今野 (コンノ)",
          "ja": "ですから平気ですって！",
          "tc": "就說我沒事了！",
          "sc": "就说我没事了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338239,
          "spk": "今野 (コンノ)",
          "ja": "余計なお世話ですヨォ！",
          "tc": "不用您多管閒事～！",
          "sc": "不用您多管闲事～！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338252,
          "spk": "茶梅 (サザンカ)",
          "ja": "怪我って、デコでしょ？",
          "tc": "受傷的地方是額頭吧？",
          "sc": "受伤的地方是额头吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 338259,
          "spk": "茶梅 (サザンカ)",
          "ja": "どしたの、それ",
          "tc": "你怎麼弄的啊？",
          "sc": "你怎么弄的啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5777,
      "rec_id": "TALK_ID_10_0503_347_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338277,
          "spk": "今野 (コンノ)",
          "ja": "それがですネ、自転車に乗ってみたら",
          "tc": "這個嘛，我試著騎上腳踏車，",
          "sc": "这个嘛，我试着骑上自行车，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338284,
          "spk": "今野 (コンノ)",
          "ja": "すってーんと転んじゃいましてェ",
          "tc": "然後就摔了個四腳朝天～",
          "sc": "然后就摔了个四脚朝天～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 338293,
          "spk": "今野 (コンノ)",
          "ja": "血がもう、ドバドバのビッシャビシャで",
          "tc": "結果當場血流如注，",
          "sc": "结果当场血流如注，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338300,
          "spk": "今野 (コンノ)",
          "ja": "痛いのなんので、大変だったんですヨ",
          "tc": "痛死我了，真是淒慘透頂。",
          "sc": "痛死我了，真是凄惨透顶哟～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338311,
          "spk": "今野 (コンノ)",
          "ja": "アァ～痛い",
          "tc": "啊～好痛。",
          "sc": "啊～好痛。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 338318,
          "spk": "今野 (コンノ)",
          "ja": "オォ～痛い",
          "tc": "噢～好痛。",
          "sc": "噢～好痛。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 338325,
          "spk": "今野 (コンノ)",
          "ja": "これは重傷ですヨ～",
          "tc": "我這可是重傷呢～",
          "sc": "我这可是重伤呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5778,
      "rec_id": "TALK_ID_10_0503_347_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338343,
          "spk": "四郎治 (シロージ)",
          "ja": "だからハスミに",
          "tc": "所以快去找蓮實",
          "sc": "所以快去找莲实"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338350,
          "spk": "四郎治 (シロージ)",
          "ja": "消毒してもらえよ",
          "tc": "幫你消毒啊。",
          "sc": "帮你消毒啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5779,
      "rec_id": "TALK_ID_10_0503_347_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338368,
          "spk": "今野 (コンノ)",
          "ja": "アァッ、嘘です！",
          "tc": "啊，我騙你們的！",
          "sc": "啊，我骗你们的！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338375,
          "spk": "今野 (コンノ)",
          "ja": "そんなに痛くないんです！",
          "tc": "根本沒有那麼痛！",
          "sc": "根本没有那么痛！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 338382,
          "spk": "今野 (コンノ)",
          "ja": "かすり傷ですよォ！",
          "tc": "只是擦傷啦～！",
          "sc": "只是擦伤啦～！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338395,
          "spk": "四郎治 (シロージ)",
          "ja": "放っておいたらどうせ、",
          "tc": "反正要是放著你不管，",
          "sc": "反正要是放着你不管，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338402,
          "spk": "四郎治 (シロージ)",
          "ja": "大怪我したってまた騒ぐだろ",
          "tc": "之後又會哇哇叫說自己受了重傷吧。",
          "sc": "之后又会哇哇叫说自己受了重伤吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 338422,
          "spk": "今野 (コンノ)",
          "ja": "でも消毒なんて絶対に",
          "tc": "可是消毒的話，",
          "sc": "可是消毒的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 338429,
          "spk": "今野 (コンノ)",
          "ja": "しみるじゃないですかァ",
          "tc": "一定會刺痛啊～",
          "sc": "一定会刺痛啊～"
        },
        {
          "f_idx": 8,
          "pidx_tc": 338436,
          "spk": "今野 (コンノ)",
          "ja": "痛いのは嫌いなんですよォ",
          "tc": "我怕痛啦～",
          "sc": "我怕痛啦～"
        },
        {
          "f_idx": 9,
          "pidx_tc": 338449,
          "spk": "四郎治 (シロージ)",
          "ja": "痛いのは一瞬だ",
          "tc": "痛也只是一瞬間。",
          "sc": "痛也只是一瞬间。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 338462,
          "spk": "今野 (コンノ)",
          "ja": "誰かァ……お助けェ……！",
          "tc": "誰快來……救救我啊……！",
          "sc": "谁快来……救救我啊……！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 338475,
          "spk": "驹子 (コマコ)",
          "ja": "な、なんか大変そうだね……",
          "tc": "看、看起來好慘喔……！",
          "sc": "看、看起来好惨哦……！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 338488,
          "spk": "茶梅 (サザンカ)",
          "ja": "コンノって意外と頼りないよね～",
          "tc": "沒想到今野這麼讓人不放心呢～",
          "sc": "没想到今野这么让人不放心呢～"
        }
      ]
    },
    {
