      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336955,
          "spk": "四郎治 (シロージ)",
          "ja": "これか",
          "tc": "這個嗎？",
          "sc": "这个吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5762,
      "rec_id": "TALK_ID_10_0503_346_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 336983,
          "spk": "四郎治 (シロージ)",
          "ja": "……こいつを初めて見たのは",
          "tc": "……我第一次見到它，",
          "sc": "……我第一次见到它，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 336990,
          "spk": "四郎治 (シロージ)",
          "ja": "十年前の事件の後",
          "tc": "是在十年前的事件發生之後。",
          "sc": "是在十年前的事件发生之后。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 337001,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカのじいさんが",
          "tc": "是茶梅的爺爺",
          "sc": "是茶梅的爷爷"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337008,
          "spk": "四郎治 (シロージ)",
          "ja": "家の中から出してきたんだ",
          "tc": "從家裡拿出來的。",
          "sc": "从家里拿出来的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5763,
      "rec_id": "TALK_ID_10_0503_346_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337036,
          "spk": "四郎治 (シロージ)",
          "ja": "悪かったな、コマコ",
          "tc": "抱歉啊，駒子。",
          "sc": "抱歉啊，驹子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337047,
          "spk": "四郎治 (シロージ)",
          "ja": "俺は随分と、",
          "tc": "一直以來，",
          "sc": "一直以来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 337054,
          "spk": "四郎治 (シロージ)",
          "ja": "たくさんのことを秘密にしてきた",
          "tc": "我真的對妳隱瞞了很多事。",
          "sc": "我真的对你隐瞒了很多事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337067,
          "spk": "驹子 (コマコ)",
          "ja": "……もう、いいよ",
          "tc": "……已經沒關係了。",
          "sc": "……已经没关系了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 337074,
          "spk": "驹子 (コマコ)",
          "ja": "私のためだったんでしょ",
          "tc": "哥哥也是為了我吧？",
          "sc": "哥哥也是为了我吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 337085,
          "spk": "驹子 (コマコ)",
          "ja": "でも……でもね",
          "tc": "可是……可是啊，",
          "sc": "可是……可是啊，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 337092,
          "spk": "驹子 (コマコ)",
          "ja": "もうお兄ちゃんに、",
          "tc": "我不會再讓哥哥",
          "sc": "我不会再让哥哥"
        },
        {
          "f_idx": 7,
          "pidx_tc": 337099,
          "spk": "驹子 (コマコ)",
          "ja": "心配かけたりしないから",
          "tc": "為我擔心了。",
          "sc": "为我担心了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 337110,
          "spk": "驹子 (コマコ)",
          "ja": "全部受け止めて、生きていく",
          "tc": "我會接受這一切，好好活下去。",
          "sc": "我会接受这一切，好好活下去。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 337117,
          "spk": "驹子 (コマコ)",
          "ja": "……罪滅ぼしをしながら、",
          "tc": "……一邊贖罪，",
          "sc": "……一边赎罪，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 337124,
          "spk": "驹子 (コマコ)",
          "ja": "私はこの村で生きていくよ",
          "tc": "一邊在這座村子生活下去。",
          "sc": "一边在这座村子生活下去。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 337137,
          "spk": "四郎治 (シロージ)",
          "ja": "……ああ",
          "tc": "……嗯。",
          "sc": "……嗯。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5764,
      "rec_id": "TALK_ID_10_0503_346_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 337155,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカにも謝らねぇとな",
          "tc": "茶梅，我也得跟妳道歉才行。",
          "sc": "茶梅，我也得跟你道歉才行。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 337162,
          "spk": "四郎治 (シロージ)",
          "ja": "埋蔵金、長いこと知らねぇフリしてて悪かった",
          "tc": "很抱歉長久以來，我都假裝不知道地下寶藏的事情。",
          "sc": "很抱歉长久以来，我都假装不知道地下宝藏的事情。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 337182,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ……このボロボロのナタが？",
          "tc": "所以……這把破破爛爛的柴刀就是……？",
          "sc": "所以……这把破破烂烂的柴刀就是……？"
        },
        {
