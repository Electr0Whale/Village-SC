      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3417,
      "rec_id": "TALK_ID_50_0011_003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189434,
          "spk": "？？？ (未知角色)",
          "ja": "ひとつ、お願いをお請けくださりませぬか",
          "tc": "您能否應允我一個不情之請？",
          "sc": "您能否应允我一个不情之请？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189441,
          "spk": "？？？ (未知角色)",
          "ja": "この子に、父の御顔を",
          "tc": "我想讓這孩子，",
          "sc": "我想让这孩子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189448,
          "spk": "？？？ (未知角色)",
          "ja": "拝ませてやりとうございます",
          "tc": "親眼見見他父親的容顏。",
          "sc": "亲眼见见他父亲的容颜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 189459,
          "spk": "？？？ (未知角色)",
          "ja": "何卒、そなたの御手にてこの子を",
          "tc": "懇請您親自帶著這個孩子，",
          "sc": "恳请您亲自带着这个孩子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 189466,
          "spk": "？？？ (未知角色)",
          "ja": "父の許へお連れくださいますよう、",
          "tc": "到他的父親身邊去，",
          "sc": "到他的父亲身边去，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 189473,
          "spk": "？？？ (未知角色)",
          "ja": "お願い申し上げるのですが……",
          "tc": "拜託您了……",
          "sc": "拜托您了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3418,
      "rec_id": "TALK_ID_50_0011_004",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189489,
          "spk": "？？？ (未知角色)",
          "ja": "どうか、抱く手を離さぬよう、",
          "tc": "請您要好好抱住他，千萬別鬆開手。",
          "sc": "请您要好好抱住他，千万别松开手。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189496,
          "spk": "？？？ (未知角色)",
          "ja": "……重ね重ね、",
          "tc": "……真的、真的，",
          "sc": "……真的、真的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189503,
          "spk": "？？？ (未知角色)",
          "ja": "くれぐれもお願い申し上げます……",
          "tc": "萬分拜託了……",
          "sc": "万分拜托了……"
        }
      ]
    },
    {
