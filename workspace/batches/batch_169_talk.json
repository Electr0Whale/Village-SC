      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189411,
          "spk": "？？？ (未知角色)",
          "ja": "もし……",
          "tc": "這位大人……",
          "sc": "这位大人……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189418,
          "spk": "？？？ (未知角色)",
          "ja": "恐れ入ります、そなた様……",
          "tc": "請恕我冒昧……",
          "sc": "请恕我冒昧……"
