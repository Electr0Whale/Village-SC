  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3407,
      "rec_id": "TALK_ID_50_0005_011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188891,
          "spk": "蓝衣商人 (？？？)",
          "ja": "おや……",
          "tc": "哎呀……",
          "sc": "哎呀……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 188898,
          "spk": "蓝衣商人 (？？？)",
          "ja": "また顔を見せおったか、お客人",
          "tc": "這位客官，你又來露臉了啊。",
          "sc": "这位客官，你又来露脸了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 188907,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ふふ……蝋燭は",
          "tc": "呵呵……",
          "sc": "呵呵……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 188914,
          "spk": "蓝衣商人 (？？？)",
          "ja": "まだ残っているであろう",
          "tc": "蠟燭應該還有剩吧。",
          "sc": "蜡烛应该还有剩吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 188923,
          "spk": "蓝衣商人 (？？？)",
          "ja": "それが尽きた折に、",
          "tc": "等用盡之際，",
          "sc": "等用尽之际，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 188930,
          "spk": "蓝衣商人 (？？？)",
          "ja": "またここへお越しなされ",
          "tc": "請再到這裡來。",
          "sc": "请再到这里来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3408,
      "rec_id": "TALK_ID_50_0005_012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188946,
          "spk": "蓝衣商人 (？？？)",
          "ja": "おや……そこのお客人",
          "tc": "哎呀……那邊的客官。",
          "sc": "哎呀……那边的客官。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 188962,
          "spk": "蓝衣商人 (？？？)",
          "ja": "こんな風も強い日に",
          "tc": "在風勢這般強勁的日子裡，",
          "sc": "在风势这般强劲的日子里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 188969,
          "spk": "蓝衣商人 (？？？)",
          "ja": "明かりも持たず、よくぞ歩いておるな",
          "tc": "居然沒帶照明就走在路上呢。",
          "sc": "居然没带照明就走在路上呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 188978,
          "spk": "蓝衣商人 (？？？)",
          "ja": "その手も、冷えておるじゃろう",
          "tc": "客官的手想必也很冷，",
          "sc": "客官的手想必也很冷，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 188985,
          "spk": "蓝衣商人 (？？？)",
          "ja": "火が恋しかろうて",
          "tc": "正需要火光溫暖吧。",
          "sc": "正需要火光温暖吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 189001,
          "spk": "蓝衣商人 (？？？)",
          "ja": "この青き蝋燭……",
          "tc": "這種藍色蠟燭……",
          "sc": "这种蓝色蜡烛……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 189008,
          "spk": "蓝衣商人 (？？？)",
          "ja": "風にも消えぬ、不思議な灯よ",
          "tc": "是風也吹不熄的神奇燭火喔。",
          "sc": "是风也吹不熄的神奇烛火哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 189015,
          "spk": "蓝衣商人 (？？？)",
          "ja": "五百文でどうじゃ",
          "tc": "賣你五百文如何？",
          "sc": "卖你五百文如何？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 189024,
          "spk": "蓝衣商人 (？？？)",
          "ja": "おやおや……",
          "tc": "哎呀哎呀……",
          "sc": "哎呀哎呀……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 189031,
          "spk": "蓝衣商人 (？？？)",
          "ja": "またお越しかね、お客人",
          "tc": "這位客官，你又來了呢。",
          "sc": "这位客官，你又来了呢。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 189040,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ふふ……",
          "tc": "呵呵……",
          "sc": "呵呵……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 189047,
          "spk": "蓝衣商人 (？？？)",
          "ja": "さては、蝋燭が尽き申したか",
          "tc": "看來，蠟燭已經用完了啊。",
          "sc": "看来，蜡烛已经用完了啊。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 189056,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ならば、もう一つ譲ってやろう",
          "tc": "那就再賣一支給你吧。",
          "sc": "那就再卖一支给你吧。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 189063,
          "spk": "蓝衣商人 (？？？)",
          "ja": "代金は五百文……支払えるかの？",
          "tc": "價格是五百文……你有錢嗎？",
          "sc": "价格是五百文……你有钱吗？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 189072,
          "spk": "主角心声/旁白/选项",
          "ja": "かう",
          "tc": "購買",
          "sc": "购买"
        },
        {
          "f_idx": 17,
          "pidx_tc": 189079,
          "spk": "主角心声/旁白/选项",
          "ja": "やめとく",
          "tc": "算了",
          "sc": "算了"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3409,
      "rec_id": "TALK_ID_50_0005_013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189105,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ほう……目が利くの",
          "tc": "哦……客官眼光真好。",
          "sc": "哦……客官眼光真好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189112,
          "spk": "蓝衣商人 (？？？)",
          "ja": "まいどあり",
          "tc": "多謝惠顧。",
          "sc": "多谢惠顾。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189121,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ただし、この蝋燭、一度きりの代物……",
          "tc": "不過，這種蠟燭只能用一次……",
          "sc": "不过，这种蜡烛只能用一次……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 189128,
          "spk": "蓝衣商人 (？？？)",
          "ja": "使うも使わぬも、そなたの覚悟次第じゃ",
          "tc": "用與不用，全看你的決心。",
          "sc": "用与不用，全看你的决心。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 189144,
          "spk": "蓝衣商人 (？？？)",
          "ja": "……まいどあり",
          "tc": "……多謝惠顧。",
          "sc": "……多谢惠顾。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 189153,
          "spk": "蓝衣商人 (？？？)",
          "ja": "今宵も闇は深かろう",
          "tc": "今夜的黑暗想必依舊深沉，",
          "sc": "今夜的黑暗想必依旧深沉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 189160,
          "spk": "蓝衣商人 (？？？)",
          "ja": "くれぐれも、足元にはお気をつけなされ",
          "tc": "請千萬要多注意腳邊。",
          "sc": "请千万要多注意脚边。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3410,
      "rec_id": "TALK_ID_50_0005_014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189187,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ふふ、ふふふ……",
          "tc": "呵呵、呵呵呵……",
          "sc": "呵呵、呵呵呵……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189196,
          "spk": "蓝衣商人 (？？？)",
          "ja": "灯り一つで運命は変わる",
          "tc": "一點燈火就能改變命運。",
          "sc": "一点灯火就能改变命运。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189203,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ケチるようでは、先は暗うて進めぬぞ",
          "tc": "若是這般吝嗇，前路將會晦暗難行喔！",
          "sc": "若是这般吝啬，前路将会晦暗难行哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 189219,
          "spk": "蓝衣商人 (？？？)",
          "ja": "……ほう、気に召さなんだか",
          "tc": "……哦，不合客官的意嗎？",
          "sc": "……哦，不合客官的意吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 189228,
          "spk": "蓝衣商人 (？？？)",
          "ja": "されど夜道は長く、",
          "tc": "然而夜路漫長，",
          "sc": "然而夜路漫长，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 189235,
          "spk": "蓝衣商人 (？？？)",
          "ja": "闇の中には「あれ」もおるゆえ……",
          "tc": "黑暗當中還有「那個」存在……",
          "sc": "黑暗当中还有“那个”存在……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 189244,
          "spk": "蓝衣商人 (？？？)",
          "ja": "せいぜい、気をつけて行かれよ……",
          "tc": "路上請多加留意……",
          "sc": "路上请多加留意……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 189251,
          "spk": "蓝衣商人 (？？？)",
          "ja": "ふふ、ふふふ……",
          "tc": "呵呵、呵呵呵……",
          "sc": "呵呵、呵呵呵……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3411,
      "rec_id": "TALK_ID_50_0005_015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189267,
          "spk": "蓝衣商人 (？？？)",
          "ja": "……おや？",
          "tc": "……哎呀？",
          "sc": "……哎呀？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189274,
          "spk": "蓝衣商人 (？？？)",
          "ja": "お客人、銭が足りぬではないか",
          "tc": "客官身上的錢不夠呢。",
          "sc": "客官身上的钱不够呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189283,
          "spk": "蓝衣商人 (？？？)",
          "ja": "また五百文揃えてここに来るがよろしい",
          "tc": "等湊齊五百文再到這裡來吧。",
          "sc": "等凑齐五百文再到这里来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3412,
      "rec_id": "TALK_ID_50_0005_016",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189306,
          "spk": "蓝衣商人 (？？？)",
          "ja": "おや、お客人",
          "tc": "哎呀，這位客官。",
          "sc": "哎呀，这位客官。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189313,
          "spk": "蓝衣商人 (？？？)",
          "ja": "これ以上持てぬようだが…",
          "tc": "你身上似乎放不下東西了……",
          "sc": "你身上似乎放不下东西了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189322,
          "spk": "蓝衣商人 (？？？)",
          "ja": "荷物を片してまた来るとよろしい",
          "tc": "請整理好行李再來吧。",
          "sc": "请整理好行李再来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3413,
      "rec_id": "TALK_ID_50_0005_020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189347,
          "spk": "主角心声/旁白/选项",
          "ja": "……懐中電灯の調子が悪いみたい",
          "tc": "……手電筒好像怪怪的。",
          "sc": "……手电筒好像怪怪的。"
        }
      ]
    },
    {
      "file": "talk.dat",
