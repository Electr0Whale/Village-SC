      "rec_id": "TALK_ID_50_0009_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189372,
          "spk": "主角心声/旁白/选项",
          "ja": "お地蔵さんだ",
          "tc": "是地藏王菩薩耶。",
          "sc": "是地藏王菩萨呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189379,
          "spk": "主角心声/旁白/选项",
          "ja": "雨で頭がすり減ってる",
          "tc": "頭都被雨水淋到磨平了。",
          "sc": "头都被雨水淋到磨平了。"
        }
      ]
