          "f_idx": 1,
          "pidx_tc": 194088,
          "spk": "林 (リン)",
          "ja": "私の名前はリンよ！",
          "tc": "我叫做林！",
          "sc": "我叫做林！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 194095,
          "spk": "林 (リン)",
          "ja": "この<strong>彼ヶ津村</strong>の村長なの",
