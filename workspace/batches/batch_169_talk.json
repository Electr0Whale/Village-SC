        {
          "f_idx": 7,
          "pidx_tc": 194138,
          "spk": "驹子 (コマコ)",
          "ja": "<player>の帰る場所を",
          "tc": "幫忙<player>尋找",
          "sc": "帮忙<player>寻找"
