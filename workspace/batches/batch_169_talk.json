          "spk": "今野 (コンノ)",
          "ja": "夜中にコソコソ一人で",
          "tc": "原來半夜獨自偷偷摸摸",
          "sc": "原来半夜独自偷偷摸摸"
        },
        {
          "f_idx": 4,
          "pidx_tc": 191327,
          "spk": "今野 (コンノ)",
          "ja": "この社にお供え物をしていたのは、",
          "tc": "來這座神社供奉供品的人，",
          "sc": "来这座神社供奉供品的人，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 191334,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんだったのですねェ",
          "tc": "就是<player>啊。",
          "sc": "就是<player>呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 191345,
          "spk": "今野 (コンノ)",
          "ja": "良い行いをしましたね、<player>さん",
          "tc": "<player>，您做了一件好事啊，",
          "sc": "<player>，您做了一件好事啊，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 191352,
          "spk": "今野 (コンノ)",
