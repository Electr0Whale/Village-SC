  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 739,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107575,
          "spk": "林 (リン)",
          "ja": "……何よ",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107582,
          "spk": "林 (リン)",
          "ja": "品評会に私が参加しないのは変かしら？",
          "tc": "我不參加評鑑會很奇怪嗎？",
          "sc": "我不参加评鉴会很奇怪吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107593,
          "spk": "林 (リン)",
          "ja": "今日はあえて、みんなに任せることにしたの",
          "tc": "今天是刻意交給大家去參加的，",
          "sc": "今天是刻意交给大家去参加的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107600,
          "spk": "林 (リン)",
          "ja": "これも村の発展のためよ",
          "tc": "這也是為了這個村子的發展。",
          "sc": "这也是为了这个村子的发展。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 740,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107631,
          "spk": "林 (リン)",
          "ja": "<player>、今回は出場するの？",
          "tc": "<player>，你這次會參加嗎？",
          "sc": "<player>，你这次会参加吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107638,
          "spk": "林 (リン)",
          "ja": "まぁどちらでも構わないけど",
          "tc": "嗯，雖然參不參加都無所謂，",
          "sc": "嗯，虽然参不参加都无所谓，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107649,
          "spk": "林 (リン)",
          "ja": "普段の仕事を評価されるというのは、",
          "tc": "但有人來評價平日的工作成果，",
          "sc": "但有人来评价平日的工作成果，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107656,
          "spk": "林 (リン)",
          "ja": "とてもいい経験になるはずよ",
          "tc": "應該會成為很棒的經驗喔。",
          "sc": "这一定会成为很棒的经验呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 741,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107680,
          "spk": "林 (リン)",
          "ja": "あら、<player>じゃない！",
          "tc": "哎呀，這不是<player>嗎！",
          "sc": "哎呀，这不是<player>吗！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107687,
          "spk": "林 (リン)",
          "ja": "楽しんでいるようで何よりだわ",
          "tc": "看你玩得很開心，真是太好了。",
          "sc": "看你玩得很开心，真是太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107698,
          "spk": "林 (リン)",
          "ja": "いつも忙しくしてるけど、",
          "tc": "雖然平常總是忙東忙西的，",
          "sc": "虽然平常总是忙东忙西的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107705,
          "spk": "林 (リン)",
          "ja": "お花見の日くらいは",
          "tc": "但至少賞花的日子，",
          "sc": "但至少赏花的日子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 107712,
          "spk": "林 (リン)",
          "ja": "みんなと過ごそうと思ってるの",
          "tc": "我打算跟大家一起度過。",
          "sc": "我打算跟大家一起度过。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 107723,
          "spk": "林 (リン)",
          "ja": "あなたも今日は力を抜いて",
          "tc": "你今天也放輕鬆點，",
          "sc": "你今天也放轻松点，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 107730,
          "spk": "林 (リン)",
          "ja": "桜をゆっくり眺めるといいわ",
          "tc": "悠閒地欣賞櫻花吧。",
          "sc": "悠闲地欣赏樱花吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 742,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107754,
          "spk": "林 (リン)",
          "ja": "……うん、<player>？",
          "tc": "……嗯，<player>？",
          "sc": "……嗯，<player>？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107761,
          "spk": "林 (リン)",
          "ja": "なにか用事？　私は忙しいんだけど",
          "tc": "有什麼事嗎？我可是很忙的。",
          "sc": "有什么事吗？我可是很忙的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107772,
          "spk": "林 (リン)",
          "ja": "見たらわかるでしょう",
          "tc": "你看一眼就知道了吧？",
          "sc": "你看一眼就知道了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107779,
          "spk": "林 (リン)",
          "ja": "サボってる人がいないかどうか",
          "tc": "我正在從遠處監視，",
          "sc": "我正在从远处监视，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 107786,
          "spk": "林 (リン)",
          "ja": "遠くから監視してるのよ！",
          "tc": "看看有沒有人在偷懶喔！",
          "sc": "看看有没有人在偷懒！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 107797,
          "spk": "林 (リン)",
          "ja": "働き者がいるからこそ",
          "tc": "正因為有辛勤工作的人，",
          "sc": "正因为有辛勤工作的人，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 107804,
          "spk": "林 (リン)",
          "ja": "楽しいお祭りが成り立つの",
          "tc": "歡樂的祭典才得以成立。",
          "sc": "欢乐的祭典才得以成立。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 107811,
          "spk": "林 (リン)",
          "ja": "あなたも肝に銘じておきなさい！",
          "tc": "你也要謹記在心喔！",
          "sc": "你也要谨记在心哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 743,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107835,
          "spk": "林 (リン)",
          "ja": "今年の収穫祭もいい調子ね",
          "tc": "今年的收穫祭典也很不錯呢。",
          "sc": "今年的收获祭典也很不错呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107842,
          "spk": "林 (リン)",
          "ja": "村のみんなにはたっぷり",
          "tc": "希望村子裡的大家",
          "sc": "希望村子里的大家"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107849,
          "spk": "林 (リン)",
          "ja": "羽を伸ばしてもらいたいわ",
          "tc": "都能好好放鬆一下。",
          "sc": "都能好好放松一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107860,
          "spk": "林 (リン)",
          "ja": "……うん？",
          "tc": "……嗯？",
          "sc": "……嗯？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 107867,
          "spk": "林 (リン)",
          "ja": "みんなのところに行かないのかって？",
          "tc": "你問我怎麼不過去找大家？",
          "sc": "你问我怎么不过去找大家？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 107874,
          "spk": "林 (リン)",
          "ja": "いいのよ、私がいると緊張するでしょう",
          "tc": "沒關係，我在的話大家會緊張吧。",
          "sc": "没关系，我在的话大家会紧张吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 107885,
          "spk": "林 (リン)",
          "ja": "息抜きってすごく大事なのよ",
          "tc": "適時放鬆真的非常重要。",
          "sc": "适时放松真的非常重要。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 107892,
          "spk": "林 (リン)",
          "ja": "いつも締めてばかりじゃ人は動かない……",
          "tc": "一直緊繃著的話，人會動彈不得的……",
          "sc": "一直紧绷着的话，人会动弹不得的……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 107899,
          "spk": "林 (リン)",
          "ja": "ほら、あなたもみんなと楽しんできなさい",
          "tc": "好啦，你也去跟大家一起享受一下吧。",
          "sc": "好啦，你也去跟大家一起享受一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 744,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 107923,
          "spk": "林 (リン)",
          "ja": "今年も無事に年末を",
          "tc": "今年也順利地",
          "sc": "今年也顺利地"
        },
        {
          "f_idx": 1,
          "pidx_tc": 107930,
          "spk": "林 (リン)",
          "ja": "迎えることができたわね……",
          "tc": "迎來了年末呢……",
          "sc": "迎来了年末呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 107937,
          "spk": "林 (リン)",
          "ja": "<player>もいろいろとご苦労様",
          "tc": "<player>各方面也辛苦了。",
          "sc": "<player>各方面也辛苦了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 107948,
          "spk": "林 (リン)",
          "ja": "あなたはもう年越しそば食べた？",
          "tc": "你已經吃過年蕎麥麵了嗎？",
          "sc": "你已经吃过年荞麦面了吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 107955,
          "spk": "林 (リン)",
          "ja": "言うまでもないだろうけど……",
          "tc": "雖然應該不用我說……",
          "sc": "虽然应该不用我说……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 107962,
          "spk": "林 (リン)",
          "ja": "絶対に逃しちゃダメよ！",
          "tc": "但絕對不能錯過喔！",
          "sc": "但绝对不能错过哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 107973,
          "spk": "林 (リン)",
          "ja": "食べないと年を越せずに",
          "tc": "要是沒吃的話，就會過不了年，",
          "sc": "要是没吃的话，就会过不了年，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 107980,
          "spk": "林 (リン)",
          "ja": "置いていかれちゃうんだから",
          "tc": "被留在今年的。",
          "sc": "被留在今年的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 107987,
          "spk": "林 (リン)",
          "ja": "いい？　必ず食べるのよ！",
          "tc": "聽好了？一定要吃喔！",
          "sc": "听好了？一定要吃！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 745,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 108011,
          "spk": "林 (リン)",
          "ja": "今回の品評会も、",
          "tc": "這次的評鑑會也順利結束了，",
          "sc": "这次的评鉴会也顺利结束了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 108018,
          "spk": "林 (リン)",
          "ja": "無事に終わってホッとしたわ……",
          "tc": "真是讓我鬆了一口氣……",
          "sc": "真是让我松了一口气……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 108036,
          "spk": "林 (リン)",
          "ja": "<player>は不参加だったようだけど、",
          "tc": "雖然<player>你好像沒參加，",
          "sc": "虽然<player>你好像没参加，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 108043,
          "spk": "林 (リン)",
          "ja": "きっと刺激を受けたんじゃない？",
          "tc": "但肯定受到了一些激勵吧？",
          "sc": "但肯定受到了一些激励吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 108061,
          "spk": "林 (リン)",
          "ja": "次回は参加してみるといいわ",
          "tc": "下次可以參加看看喔。",
          "sc": "下次可以参加看看哦。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 108068,
          "spk": "林 (リン)",
          "ja": "他の誰にも負けないくらいの、",
          "tc": "種出不輸給任何人的",
          "sc": "种出不输给任何人的"
        },
        {
          "f_idx": 8,
          "pidx_tc": 108075,
          "spk": "林 (リン)",
          "ja": "最高の作物を育てなさいね",
          "tc": "最棒的作物吧！",
          "sc": "最棒的作物吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 746,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 108099,
          "spk": "林 (リン)",
          "ja": "素晴らしかったわ、<player>！",
          "tc": "真了不起，<player>！",
          "sc": "真了不起，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 108106,
          "spk": "林 (リン)",
          "ja": "Ｓランク獲得、おめでとう",
          "tc": "恭喜你獲得S級評價。",
          "sc": "恭喜你获得S级评价。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 108117,
          "spk": "林 (リン)",
          "ja": "あなたが心血を注いで",
          "tc": "我能感覺到",
          "sc": "我能感觉到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 108124,
          "spk": "林 (リン)",
          "ja": "育てあげた作物だと感じたわ",
          "tc": "那是你傾注心血培育的作物。",
          "sc": "那是你倾注心血培育的作物。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 108131,
          "spk": "林 (リン)",
          "ja": "誇りを胸に、これからも精進しなさいね！",
          "tc": "懷著這份榮耀，今後也要繼續加油喔！",
          "sc": "怀着这份荣耀，今后也要继续加油哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 747,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 108155,
          "spk": "林 (リン)",
          "ja": "ご苦労だったわね、<player>",
          "tc": "辛苦你了，<player>。",
          "sc": "辛苦你了，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 108162,
          "spk": "林 (リン)",
          "ja": "私から見ても悪くなかったわよ",
          "tc": "在我看來還不錯啦。",
          "sc": "在我看来还不错啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 108173,
          "spk": "林 (リン)",
          "ja": "今後の成長が楽しみになったわ",
          "tc": "我開始期待你今後的成長了。",
          "sc": "我开始期待你今后的成长了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 108180,
          "spk": "林 (リン)",
          "ja": "次回はもっと努力してちょうだい",
          "tc": "下次要更努力喔。",
          "sc": "下次要更努力哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 748,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 108204,
          "spk": "林 (リン)",
          "ja": "<player>は出場しなかったのね",
          "tc": "<player>沒有出場啊。",
          "sc": "<player>没有出场啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 108211,
          "spk": "林 (リン)",
          "ja": "期待していたから、少し残念だわ",
          "tc": "虧我還很期待，有點遺憾呢。",
          "sc": "亏我还很期待，有点遗憾呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 108229,
          "spk": "林 (リン)",
          "ja": "動物を育てるというのは、",
          "tc": "不過飼養動物",
          "sc": "不过饲养动物"
        },
        {
          "f_idx": 4,
          "pidx_tc": 108236,
          "spk": "林 (リン)",
          "ja": "難しいことも多いから",
          "tc": "確實會遇到很多困難，",
          "sc": "确实会遇到很多困难，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 108243,
          "spk": "林 (リン)",
          "ja": "仕方のないことだけどね……",
          "tc": "這也是無可奈何啦……",
          "sc": "这也是无可奈何啦……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 108254,
          "spk": "林 (リン)",
          "ja": "次回の品評会は出るのかしら？",
          "tc": "你會參加下次的評鑑會嗎？",
          "sc": "你会参加下次的评鉴会吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 108261,
          "spk": "林 (リン)",
          "ja": "楽しみにしているわね",
          "tc": "我很期待喔。",
          "sc": "我很期待哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 749,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 108285,
          "spk": "林 (リン)",
          "ja": "良かったわよ、<player>！",
          "tc": "太好了，<player>！",
          "sc": "太好了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 108292,
          "spk": "林 (リン)",
          "ja": "堂々のＳランク、という感じね",
          "tc": "是當之無愧的S級呢。",
          "sc": "是当之无愧的S级呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 108303,
