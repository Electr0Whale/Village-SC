        {
          "f_idx": 2,
          "pidx_tc": 297992,
          "spk": "帷 (トバリ)",
          "ja": "今なんて……",
          "tc": "祢剛剛說什麼……",
          "sc": "你刚刚说什么……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298003,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 298012,
          "spk": "木珠 (コダマ)",
          "ja": "……こう、いうんだっけ",
          "tc": "……應該，是要這樣……講吧。",
          "sc": "……应该，是要这样……讲吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 298021,
          "spk": "木珠 (コダマ)",
          "ja": "かし、こみ、もうし、ます……",
          "tc": "謹此……相求……",
          "sc": "谨此……相求……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 298028,
          "spk": "木珠 (コダマ)",
          "ja": "ねがわ、くば、こたえ、たまえ……",
          "tc": "願祢……賜應……",
          "sc": "愿你……赐应……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 298037,
          "spk": "木珠 (コダマ)",
          "ja": "<strong>かみさ、ま……おねがい、します……",
          "tc": "<strong>神明大……人……拜託……",
          "sc": "<strong>神明大……人……拜托……"
        },
        {
