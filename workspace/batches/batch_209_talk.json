    {
      "file": "talk.dat",
      "rec_idx": 5136,
      "rec_id": "TALK_ID_10_0500_036_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298166,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298175,
          "spk": "木珠 (コダマ)",
          "ja": "やっぱ、り、かみさ、まは……",
          "tc": "神明大……人……果然……",
          "sc": "神明大……人……果然……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 298182,
          "spk": "木珠 (コダマ)",
          "ja": "ささげ、ものをする、と、",
          "tc": "一旦，收到……供品，",
          "sc": "一旦，收到……供品，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298189,
          "spk": "木珠 (コダマ)",
          "ja": "ねがいをかなえてくれ、る……んだ……",
          "tc": "就會幫忙，實現……願望……",
          "sc": "就会帮忙，实现……愿望……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 298198,
          "spk": "木珠 (コダマ)",
          "ja": "で、も、……",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 298205,
          "spk": "木珠 (コダマ)",
          "ja": "あなた、は……かみさ、まは……",
          "tc": "祢……神明大……人……",
          "sc": "你……神明大……人……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 298214,
          "spk": "木珠 (コダマ)",
          "ja": "コダマとの、やくそく、やぶった……",
          "tc": "違背了，跟木珠之間的……約定……",
          "sc": "违背了，跟木珠之间的……约定……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 298223,
          "spk": "木珠 (コダマ)",
          "ja": "だか、ら……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 298230,
          "spk": "木珠 (コダマ)",
          "ja": "コダマか、ら、うばった",
          "tc": "祢要把，從木珠這裡……搶走的……",
          "sc": "你要把，从木珠这里……抢走的……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 298237,
          "spk": "木珠 (コダマ)",
          "ja": "<strong>それ</strong>は、かえし、て……ね",
          "tc": "<strong>那個</strong>還回來……喔。",
          "sc": "<strong>那个</strong>还回来……哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 298246,
          "spk": "木珠 (コダマ)",
          "ja": "おねがい、します",
          "tc": "拜託祢……了。",
          "sc": "拜托你……了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 298253,
          "spk": "木珠 (コダマ)",
          "ja": "<strong>コダマの、からだを、かえして</strong>",
          "tc": "<strong>把身體，還給……木珠。</strong>",
          "sc": "<strong>把身体，还给……木珠。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5137,
      "rec_id": "TALK_ID_10_0500_100_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298273,
          "spk": "主角心声/旁白/选项",
          "ja": "そういえば……",
          "tc": "對了……",
          "sc": "对了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298280,
          "spk": "主角心声/旁白/选项",
          "ja": "トバリとコマコから祠の修復を頼まれてた",
          "tc": "帷和駒子拜託我修復那座祠堂。",
          "sc": "帷和驹子拜托我修复那座祠堂。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 298287,
          "spk": "主角心声/旁白/选项",
          "ja": "……直しておかなくちゃ",
          "tc": "……得趕快修好才行。",
          "sc": "……得赶快修好才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5138,
      "rec_id": "TALK_ID_10_0501_101_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298307,
          "spk": "六角 (ロッカク)",
          "ja": "……さてさて",
          "tc": "……這下好了，",
          "sc": "……这下好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298314,
          "spk": "六角 (ロッカク)",
          "ja": "いったい、どうしたもんスかねぇ",
          "tc": "到底該怎麼辦才好呢～？",
          "sc": "到底该怎么办才好呢～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5139,
      "rec_id": "TALK_ID_10_0501_101_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298332,
          "spk": "六角 (ロッカク)",
          "ja": "おや、<player>さん",
          "tc": "哦，是<player>啊，",
          "sc": "哦，是<player>啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298339,
          "spk": "六角 (ロッカク)",
          "ja": "ワシになんか用ですか？",
          "tc": "有事情找我嗎？",
          "sc": "有事情找我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 298350,
          "spk": "六角 (ロッカク)",
          "ja": "今ちょっと、立て込んでまして",
          "tc": "其實我正在忙，",
          "sc": "其实我正在忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298357,
          "spk": "六角 (ロッカク)",
          "ja": "料理のアドバイスとかは、",
          "tc": "如果是料理上的建議，",
          "sc": "如果是料理上的建议，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 298364,
          "spk": "六角 (ロッカク)",
          "ja": "今度にしてもらえると助かるんスけど",
          "tc": "要是能下次再說，我會很感謝你的。",
          "sc": "要是能下次再说，我会很感谢你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5140,
      "rec_id": "TALK_ID_10_0501_101_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298382,
          "spk": "六角 (ロッカク)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298389,
          "spk": "六角 (ロッカク)",
          "ja": "「ジンギ」を探してるですって……？",
          "tc": "你說你在找「神器」……？",
          "sc": "你说你在找“神器”……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 298400,
          "spk": "六角 (ロッカク)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298411,
          "spk": "六角 (ロッカク)",
          "ja": "いやァ……ワシは聞いたこともねぇっス",
          "tc": "不……我沒聽過耶。",
          "sc": "不……大叔我可没听说过呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 298418,
          "spk": "六角 (ロッカク)",
          "ja": "他を当たってほしいところっスね～……",
          "tc": "你還是去問問別人吧～",
          "sc": "你还是去问问别人吧～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 298436,
          "spk": "六角 (ロッカク)",
          "ja": "あっ、それよりも、話はかわるんスけど、",
          "tc": "啊，先不說這個了，",
          "sc": "啊，先不说这个了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 298443,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんに、頼みたいことがあるっス！",
          "tc": "<player>，我有件事想拜託你！",
          "sc": "<player>，我有件事想拜托你！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 298450,
          "spk": "六角 (ロッカク)",
          "ja": "聞いてもらってもいいっスか？",
          "tc": "可以聽我說一下嗎？",
          "sc": "可以听我说一下不？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 298461,
          "spk": "六角 (ロッカク)",
          "ja": "実は最近、ヨウさんの様子がおかしいんス",
          "tc": "其實，洋妹妹最近看起來不太對勁。",
          "sc": "其实，洋妹妹最近看起来不太对劲。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 298468,
          "spk": "六角 (ロッカク)",
          "ja": "妙にそわそわしてるといいますか、",
          "tc": "該說莫名心神不寧嗎？",
          "sc": "该说莫名心神不宁吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 298475,
          "spk": "六角 (ロッカク)",
          "ja": "隠し事をしてるって感じで……",
          "tc": "感覺像在隱瞞什麼……",
          "sc": "感觉像在隐瞒什么……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 298486,
          "spk": "六角 (ロッカク)",
          "ja": "どうやら、ワシに内緒で",
          "tc": "看來她似乎背著我，",
          "sc": "看来她似乎背着我，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 298493,
          "spk": "六角 (ロッカク)",
          "ja": "どこかに出かけてるみたいなんスよねえ",
          "tc": "不知道偷偷跑到哪裡去了。",
          "sc": "不知道偷偷跑到哪里去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5141,
      "rec_id": "TALK_ID_10_0501_101_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298511,
          "spk": "六角 (ロッカク)",
          "ja": "その様子だと、<player>さんにも",
          "tc": "看<player>的反應，",
          "sc": "看<player>的反应，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 298518,
          "spk": "六角 (ロッカク)",
          "ja": "心当たりはなさそうっスね",
          "tc": "你好像也沒有頭緒呢。",
          "sc": "你好像也没有头绪呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298536,
          "spk": "六角 (ロッカク)",
          "ja": "でも……ワシは心配なんスよ……",
          "tc": "可是……我真的很擔心她……",
          "sc": "可是……我真的很担心她……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 298543,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんは昔から、見えない何かと喋ったり、",
          "tc": "洋妹妹從以前就有讓人放不下心的地方，",
          "sc": "洋妹妹从以前就有让人放不下心的地方，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 298550,
          "spk": "六角 (ロッカク)",
          "ja": "危なっかしいところがあるので……",
          "tc": "像是跟看不見的東西說話……",
          "sc": "像是跟看不见的东西说话……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 298561,
          "spk": "六角 (ロッカク)",
          "ja": "ほら……掟にもあるでしょう……",
          "tc": "而且……規矩裡不也有嗎……",
          "sc": "而且……规矩里不也有吗……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 298568,
          "spk": "六角 (ロッカク)",
          "ja": "<strong>「掟の六、山からの声に応えるな」</strong>って……",
          "tc": "<strong>「規矩之六，別回應山裡傳來的聲音」</strong>……",
          "sc": "<strong>“规矩之六，别回应山里传来的声音”</strong>……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5142,
      "rec_id": "TALK_ID_10_0501_101_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298599,
          "spk": "六角 (ロッカク)",
          "ja": "……もしかして、声を追って山の橋向こうに？",
          "tc": "她該不會追著聲音，跑到山上那座橋的另一頭了？",
          "sc": "她该不会追着声音，跑到山上那座桥的另一头了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5143,
      "rec_id": "TALK_ID_10_0501_101_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 298631,
          "spk": "六角 (ロッカク)",
          "ja": "ああいや、こっちの話っス",
          "tc": "啊，沒什麼，當我沒說。",
          "sc": "啊，没什么，当我没说呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 298649,
          "spk": "六角 (ロッカク)",
          "ja": "とにかく、山には獣とかもいて危ないっスから",
          "tc": "總之，山裡有野獸出沒很危險，",
          "sc": "总之，山里有野兽出没很危险，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 298656,
          "spk": "六角 (ロッカク)",
          "ja": "もし、ヨウさんを見かけたら――",
          "tc": "要是你有看到洋妹妹──",
          "sc": "要是你瞧见洋妹妹的话——"
        },
        {
          "f_idx": 5,
          "pidx_tc": 298672,
          "spk": "六角 (ロッカク)",
          "ja": "一人で山の大橋の先に行こうとしていたら、",
