          "pidx_tc": 355404,
          "spk": "木珠 (コダマ)",
          "ja": "返せ返せ返せ返せ、返して……返して……",
          "tc": "還我還我還我還我，還給我……還給我……",
          "sc": "还我还我还我还我，还给我……还给我……"
        }
      ]
    },
    {
      "file": "talk.dat",
