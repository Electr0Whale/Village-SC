      "rec_id": "TALK_ID_10_0602_056_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355192,
          "spk": "木珠 (コダマ)",
          "ja": "返してよ……！！",
          "tc": "還給我啊……！！",
          "sc": "还给我啊……！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355199,
          "spk": "木珠 (コダマ)",
          "ja": "全部全部、きみのものじゃないくせに！！",
          "tc": "明明全部都不是屬於你的！！",
          "sc": "明明全部都不是属于你的！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6076,
      "rec_id": "TALK_ID_10_0602_056_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355219,
          "spk": "木助 (キスケ)",
          "ja": "こ……コダマ！？",
          "tc": "木……木珠！？",
          "sc": "木……木珠！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355226,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ、何を……！",
          "tc": "你要做什麼……！",
          "sc": "你要做什么……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6077,
      "rec_id": "TALK_ID_10_0602_056_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355246,
          "spk": "木珠 (コダマ)",
          "ja": "絶対に、体を、取り返すんだ……",
          "tc": "我一定要……把身體……拿回來……",
          "sc": "我一定要……把身体……拿回来……"
