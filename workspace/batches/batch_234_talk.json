  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6070,
      "rec_id": "TALK_ID_10_0602_056_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354850,
          "spk": "木助 (キスケ)",
          "ja": "……コダマ",
          "tc": "……木珠。",
          "sc": "……木珠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354861,
          "spk": "木珠 (コダマ)",
          "ja": "だ　れ……？",
          "tc": "是　誰……？",
          "sc": "是　谁……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354874,
          "spk": "木助 (キスケ)",
          "ja": "やっぱり、俺のこと",
          "tc": "你果然，",
          "sc": "你果然，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354881,
          "spk": "木助 (キスケ)",
          "ja": "わかんねえんだな……",
          "tc": "認不出我啊……",
          "sc": "认不出我啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 354892,
          "spk": "木助 (キスケ)",
          "ja": "おれは……樹木木助……",
          "tc": "我叫……樹木木助……",
          "sc": "我叫……树木木助……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 354899,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの兄貴だよ……",
          "tc": "是你的哥哥……",
          "sc": "是你的哥哥……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 354910,
          "spk": "木珠 (コダマ)",
          "ja": "うそ……　うそ　だ……",
          "tc": "騙人……　騙　人……",
          "sc": "骗人……　骗　人……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 354919,
          "spk": "木珠 (コダマ)",
          "ja": "だった　ら　どう　して……",
          "tc": "既然　這樣　你為　什麼……",
          "sc": "既然　这样　你为　什么……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 354926,
          "spk": "木珠 (コダマ)",
          "ja": "その　こ　の　みかたを　する　の……",
          "tc": "要　站在　祂　那邊……",
          "sc": "要　站在　他　那边……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 354939,
          "spk": "木助 (キスケ)",
          "ja": "お前が間違ったことをしたからだ",
          "tc": "因為你做錯了事。",
          "sc": "因为你做错了事。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 354946,
          "spk": "木助 (キスケ)",
          "ja": "だから俺は、てめぇを叱りにきたんだよ",
          "tc": "我是來罵你一頓的。",
          "sc": "我是来骂你一顿的。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 354964,
          "spk": "木珠 (コダマ)",
          "ja": "うそだ……う　そだ……",
          "tc": "騙人……騙　人……",
          "sc": "骗人……骗　人……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 354971,
          "spk": "木珠 (コダマ)",
          "ja": "からだ、かえし　て",
          "tc": "明明　我　只是，",
          "sc": "明明　我　只是，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 354978,
          "spk": "木珠 (コダマ)",
          "ja": "ほし　い　だけな　のに……",
          "tc": "想把　身體　拿回來　而已……",
          "sc": "想把　身体　拿回来　而已……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 354991,
          "spk": "木助 (キスケ)",
          "ja": "だからって",
          "tc": "就算是這樣，",
          "sc": "就算是这样，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 354998,
          "spk": "木助 (キスケ)",
          "ja": "村の連中を傷つけていいわけじゃない",
          "tc": "你也不能傷害村子裡的人。",
          "sc": "你也不能伤害村子里的人。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 355009,
          "spk": "木珠 (コダマ)",
          "ja": "ど　うして　どうして",
          "tc": "為　什麼　為什麼，",
          "sc": "为　什么　为什么，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 355016,
          "spk": "木珠 (コダマ)",
          "ja": "ただ　かがつ村　で、あの　ばしょで、",
          "tc": "我只　是想　在　彼津村，",
          "sc": "我只　是想　在　彼津村，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 355023,
          "spk": "木珠 (コダマ)",
          "ja": "く　らし　ていたい　だけなの　に",
          "tc": "在　那個　地方，生活　而已。",
          "sc": "在　那个　地方，生活　而已。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 355036,
          "spk": "木助 (キスケ)",
          "ja": "コダマ……",
          "tc": "木珠……",
          "sc": "木珠……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 355047,
          "spk": "木助 (キスケ)",
          "ja": "コダマ、聞いてくれ",
          "tc": "木珠，你聽我說。",
          "sc": "木珠，你听我说。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 355054,
          "spk": "木助 (キスケ)",
          "ja": "俺が悪かった",
          "tc": "都是我的錯。",
          "sc": "都是我的错。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 355061,
          "spk": "木助 (キスケ)",
          "ja": "恨むなら俺だ",
          "tc": "你要恨就恨我。",
          "sc": "你要恨就恨我。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 355072,
          "spk": "木珠 (コダマ)",
          "ja": "ゆるさ　ない",
          "tc": "不可　原諒。",
          "sc": "不可　原谅。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 355085,
          "spk": "木助 (キスケ)",
          "ja": "許さなくていい",
          "tc": "不用原諒我也沒關係。",
          "sc": "不用原谅我也没关系。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 355092,
          "spk": "木助 (キスケ)",
          "ja": "俺が死んで気が済むなら……",
          "tc": "如果我死了你就能消氣……",
          "sc": "如果我死了你就能消气……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6071,
      "rec_id": "TALK_ID_10_0602_056_02",
      "lines": [
        {
