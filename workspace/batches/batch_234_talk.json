          "pidx_tc": 355121,
          "spk": "木珠 (コダマ)",
          "ja": "ゆる　さない！",
          "tc": "不可　原諒！",
          "sc": "不可　原谅！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355128,
          "spk": "木珠 (コダマ)",
          "ja": "ゆるさ　ない！！　ゆるさない！！",
          "tc": "不可原　諒！！不可原諒！！",
          "sc": "不可原　谅！！不可原谅！！"
