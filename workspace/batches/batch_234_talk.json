      "rec_id": "TALK_ID_10_0602_056_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355424,
          "spk": "木助 (キスケ)",
          "ja": "……やるぞ、<player>",
          "tc": "……要上了，<player>！",
          "sc": "……要上了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355435,
          "spk": "木助 (キスケ)",
          "ja": "頼む……",
          "tc": "拜託你……",
          "sc": "拜托你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355442,
          "spk": "木助 (キスケ)",
          "ja": "コダマをもう、楽にさせてくれ",
          "tc": "讓木珠解脫吧。",
          "sc": "让木珠解脱吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6085,
      "rec_id": "TALK_ID_10_0602_057_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355466,
          "spk": "木助 (キスケ)",
          "ja": "コダマーッ！！",
          "tc": "木珠──！",
          "sc": "木珠——！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355475,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが死んだのは、",
          "tc": "你之所以會死，",
          "sc": "你之所以会死，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355482,
          "spk": "木助 (キスケ)",
          "ja": "俺が贄になり損ねたせいだろうが！",
          "tc": "都是因為我沒能成為祭品不是嗎！",
          "sc": "都是因为我没能成为祭品不是吗！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 355498,
          "spk": "木助 (キスケ)",
          "ja": "恨む相手は俺だろう！",
          "tc": "所以你該恨的人是我！",
          "sc": "所以你该恨的人是我！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 355505,
          "spk": "木助 (キスケ)",
          "ja": "だからもう他人を巻き込むな！",
          "tc": "不要把其他人捲進來！",
          "sc": "不要把其他人卷进来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6086,
      "rec_id": "TALK_ID_10_0602_057_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355529,
          "spk": "木助 (キスケ)",
          "ja": "いいぜ、俺を殺せよ、コダマ！",
          "tc": "可以啊，你就殺了我吧，木珠！",
          "sc": "可以啊，你就杀了我吧，木珠！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355540,
          "spk": "木助 (キスケ)",
          "ja": "そうしたらきっと、俺の血が",
          "tc": "這樣一來，我的血",
          "sc": "这样一来，我的血"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355547,
          "spk": "木助 (キスケ)",
          "ja": "<player>に奇跡を起こさせるだろう！！",
          "tc": "一定能讓<player>創造出奇蹟！！",
          "sc": "一定能让<player>创造出奇迹！！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 355558,
          "spk": "木助 (キスケ)",
          "ja": "だからてめぇは、覚悟しておくことだなァ！",
          "tc": "所以你就給我做好心理準備吧！",
          "sc": "所以你就给我做好心理准备吧！"
        }
      ]
    },
    {
