      "rec_id": "TALK_ID_10_0602_056_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355278,
          "spk": "木珠 (コダマ)",
          "ja": "生きたい、帰りたいよ！！",
          "tc": "我想活下去，我想回家啊！！",
          "sc": "我想活下去，我想回家啊！！"
        }
      ]
    },
    {
