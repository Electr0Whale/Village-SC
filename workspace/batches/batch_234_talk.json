      "rec_id": "TALK_ID_10_0602_056_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355294,
          "spk": "木珠 (コダマ)",
          "ja": "どうしてきみばっかり！！！",
          "tc": "為什麼只有你可以！！！",
          "sc": "为什么只有你可以！！！"
