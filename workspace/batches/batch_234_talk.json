    {
      "file": "talk.dat",
      "rec_idx": 6078,
      "rec_id": "TALK_ID_10_0602_056_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355262,
          "spk": "木珠 (コダマ)",
          "ja": "あきらめるなんて、できないよ……！",
          "tc": "我哪有可能放棄……！",
          "sc": "我哪有可能放弃……！"
