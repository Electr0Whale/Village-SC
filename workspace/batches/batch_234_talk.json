      "rec_id": "TALK_ID_10_0602_056_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355160,
          "spk": "木珠 (コダマ)",
          "ja": "約束を　忘れなければ！！！",
          "tc": "要是沒有忘記　約定！！！",
          "sc": "要是没有忘记　约定！！！"
        }
      ]
    },
    {
      "file": "talk.dat",
