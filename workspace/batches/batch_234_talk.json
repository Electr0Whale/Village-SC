      "rec_id": "TALK_ID_10_0602_056_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355176,
          "spk": "木珠 (コダマ)",
          "ja": "どうして　きみが　あそこにいるんだ！！！",
          "tc": "為什麼　你會　在那邊！！！",
          "sc": "为什么　你会　在那边！！！"
        }
      ]
    },
    {
      "file": "talk.dat",
