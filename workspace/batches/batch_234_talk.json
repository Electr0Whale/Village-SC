      "rec_id": "TALK_ID_10_0602_056_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355314,
          "spk": "木助 (キスケ)",
          "ja": "コダマ……てめぇは……",
          "tc": "木珠……你……",
          "sc": "木珠……你……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355323,
          "spk": "木助 (キスケ)",
          "ja": "祟り神になってるってのか……！！",
          "tc": "已經變成祟神了嗎……！！",
          "sc": "已经变成祟神了吗……！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6082,
      "rec_id": "TALK_ID_10_0602_056_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355347,
          "spk": "木助 (キスケ)",
          "ja": "コダマ！　いい加減にしろよ！！",
          "tc": "木珠！你給我適可而止！！",
          "sc": "木珠！你给我适可而止！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355356,
          "spk": "木助 (キスケ)",
          "ja": "てめぇももう十分奪っただろうが！！",
          "tc": "你也已經奪走夠多東西了吧！！",
          "sc": "你也已经夺走够多东西了吧！！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355363,
          "spk": "木助 (キスケ)",
          "ja": "これ以上、ダダをこねるのはやめろ！！",
          "tc": "別再繼續耍賴了！！",
          "sc": "别再继续耍赖了！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6083,
      "rec_id": "TALK_ID_10_0602_056_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355390,
          "spk": "木珠 (コダマ)",
          "ja": "返せ、返せ、返せ、返せ、返せ、返せ、",
          "tc": "還我，還我，還我，還我，還我，還我，",
          "sc": "还我，还我，还我，还我，还我，还我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355397,
          "spk": "木珠 (コダマ)",
          "ja": "返せ、返せ、返せ返せ返せ返せ返せ返せ返せ",
          "tc": "還我，還我，還我還我還我還我還我還我還我，",
          "sc": "还我，还我，还我还我还我还我还我还我还我，"
        },
        {
