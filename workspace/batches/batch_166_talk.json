    {
      "file": "talk.dat",
      "rec_idx": 3442,
      "rec_id": "TALK_ID_60_0012_003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 190343,
          "spk": "？？？ (未知角色)",
          "ja": "おぉ、また来たな、ニンゲンの子",
          "tc": "哦，人類小孩，你又來了啊。",
          "sc": "哦，人类小孩，你又来了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 190352,
          "spk": "？？？ (未知角色)",
          "ja": "まさか忘れとらんよな？",
          "tc": "你應該沒有忘記",
          "sc": "你应该没有忘记"
        },
        {
          "f_idx": 2,
          "pidx_tc": 190359,
          "spk": "？？？ (未知角色)",
          "ja": "ワシとの取引のことを",
          "tc": "我們說好的交易吧？",
          "sc": "我们说好的交易吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 190368,
          "spk": "？？？ (未知角色)",
          "ja": "畑でとれた春野菜を",
          "tc": "你可是答應過，",
          "sc": "你可是答应过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 190375,
          "spk": "？？？ (未知角色)",
          "ja": "持ってきてくれる約束だったがね",
          "tc": "要把田裡摘的春季蔬菜帶來給我呢。",
          "sc": "要把田里摘的春季蔬菜带来给我呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 190391,
          "spk": "？？？ (未知角色)",
          "ja": "ワシは律儀だで、",
          "tc": "我可是很守規矩的，",
          "sc": "我可是很守规矩的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 190398,
          "spk": "？？？ (未知角色)",
          "ja": "ちゃんと古銭も用意して待っとるんだわ",
          "tc": "早就準備好古錢在等著你呢。",
          "sc": "早就准备好古钱在等着你呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 190405,
          "spk": "？？？ (未知角色)",
          "ja": "種類も選ばせたるで、損はさせんってば",
          "tc": "種類也隨你挑，不會讓你吃虧的啦。",
          "sc": "种类也随你挑，不会让你吃亏的啦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 190414,
          "spk": "？？？ (未知角色)",
          "ja": "なぁに、野菜一つでええんだて",
          "tc": "放心，只要拿一個蔬菜來換就好，",
          "sc": "放心，只要拿一个蔬菜来换就好，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 190421,
          "spk": "？？？ (未知角色)",
          "ja": "こんなうまい話、逃す手はないがね？",
          "tc": "這麼划算的事情，錯過可惜喔！",
          "sc": "这么划算的事情，错过可惜哦！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 190437,
          "spk": "？？？ (未知角色)",
          "ja": "忘れたとは言わせんで？",
          "tc": "你可別說你忘了喔！",
          "sc": "你可别说你忘了哦！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 190444,
          "spk": "？？？ (未知角色)",
          "ja": "よろしく頼んだでよ",
          "tc": "麻煩你啦。",
          "sc": "麻烦你啦。"
        }
      ]
    },
