  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3424,
      "rec_id": "TALK_ID_60_0009_031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189270,
          "spk": "茶梅 (サザンカ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189277,
          "spk": "茶梅 (サザンカ)",
          "ja": "ナイスタイミングじゃん",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189288,
          "spk": "茶梅 (サザンカ)",
          "ja": "こないだ拾ったあの",
          "tc": "之前撿到的那台",
          "sc": "之前捡到的那台"
        },
        {
          "f_idx": 3,
          "pidx_tc": 189295,
          "spk": "茶梅 (サザンカ)",
          "ja": "音の鳴る機械……",
          "tc": "會發出聲音的機器……",
          "sc": "会发出声音的机器……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 189302,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちゃんと直ったんだ",
          "tc": "我已經修好了。",
          "sc": "我已经修好了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 189313,
          "spk": "茶梅 (サザンカ)",
          "ja": "３０個のパーツを組み立てるの",
          "tc": "要把30個零件組合起來，",
          "sc": "要把30个零件组合起来，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 189320,
          "spk": "茶梅 (サザンカ)",
          "ja": "めっちゃ大変だったんだけど",
          "tc": "真的超級累人……",
          "sc": "真的超级累人……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 189327,
          "spk": "茶梅 (サザンカ)",
          "ja": "パズルみたいで楽しかったよ",
          "tc": "不過就像在拼圖一樣，還挺好玩的！",
          "sc": "不过就像在拼图一样，还挺好玩的！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 189338,
          "spk": "茶梅 (サザンカ)",
          "ja": "それでさ、頼みがあるんだけど",
          "tc": "然後啊，我有件事想拜託你，",
          "sc": "然后啊，我有件事想拜托你，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 189345,
          "spk": "茶梅 (サザンカ)",
          "ja": "この機械……",
          "tc": "你可以……",
          "sc": "你可以……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 189352,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタが引き取ってくんない？",
          "tc": "收下這台機器嗎？",
          "sc": "收下这台机器吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 189363,
          "spk": "茶梅 (サザンカ)",
          "ja": "いや、プレーヤーはアタシんちに",
          "tc": "沒什麼，只是因為我家",
          "sc": "没什么，只是因为我家"
        },
        {
          "f_idx": 12,
          "pidx_tc": 189370,
          "spk": "茶梅 (サザンカ)",
          "ja": "すでにいっぱいあるんだよね",
          "tc": "已經有很多播放器了。",
          "sc": "已经有很多播放器了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 189381,
          "spk": "茶梅 (サザンカ)",
          "ja": "それに、コイツを置いておくと",
          "tc": "而且，",
          "sc": "而且，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 189388,
          "spk": "茶梅 (サザンカ)",
          "ja": "場所もとるうえに、",
          "tc": "我不僅需要空出地方放它，",
          "sc": "我不仅需要空出地方放它，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 189395,
          "spk": "茶梅 (サザンカ)",
          "ja": "何故か勝手に鳴り出したりすんだよ",
          "tc": "有時候它還會自己發出聲音耶。",
          "sc": "有时候它还会自己发出声音呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 189406,
          "spk": "茶梅 (サザンカ)",
          "ja": "基本的な機能は問題ないと思うから、",
          "tc": "反正基本功能應該沒有問題，",
          "sc": "反正基本功能应该没有问题，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 189413,
          "spk": "茶梅 (サザンカ)",
          "ja": "これはアンタにあげるよ",
          "tc": "這台就給你吧。",
          "sc": "这台就给你吧。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 189424,
          "spk": "茶梅 (サザンカ)",
          "ja": "名付けて",
          "tc": "我幫它取了個名字，",
          "sc": "我帮它取了个名字，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 189431,
          "spk": "茶梅 (サザンカ)",
          "ja": "「バイブス鬼アゲマシン」だよ",
          "tc": "叫做「超級嗨咖氣氛機」喔！",
          "sc": "叫做“超级嗨咖气氛机”哦！"
        },
        {
          "f_idx": 20,
          "pidx_tc": 189438,
          "spk": "茶梅 (サザンカ)",
          "ja": "ハイ、受け取って",
          "tc": "來，請收下。",
          "sc": "来，请收下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3425,
      "rec_id": "TALK_ID_60_0009_032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189462,
          "spk": "茶梅 (サザンカ)",
          "ja": "頑張って直したんだから",
          "tc": "我可是花了一番功夫才修好的，",
          "sc": "我可是花了一番功夫才修好的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189469,
          "spk": "茶梅 (サザンカ)",
          "ja": "使ってあげてね",
          "tc": "你要多拿來用喔。",
          "sc": "你要多拿来用哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3426,
      "rec_id": "TALK_ID_60_0009_121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188800,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ、<player>じゃん",
          "tc": "欸，這不是<player>嗎？",
          "sc": "诶，这不是<player>吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 188807,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんなところで何してんの？",
          "tc": "你在這種地方做什麼啊？",
          "sc": "你在这种地方做什么啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3427,
      "rec_id": "TALK_ID_60_0009_122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188831,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ、<player>じゃん",
          "tc": "欸，這不是<player>嗎？",
          "sc": "诶，这不是<player>吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 188838,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんな時間に何してんの？",
          "tc": "都這個時間了，你在做什麼啊？",
          "sc": "都这个时间了，你在做什么啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3428,
      "rec_id": "TALK_ID_60_0009_123",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188862,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシ？",
          "tc": "我嗎？",
          "sc": "我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 188869,
          "spk": "茶梅 (サザンカ)",
          "ja": "いやね、最近深夜になると",
          "tc": "這個嘛，最近只要一到深夜，",
          "sc": "这个嘛，最近只要一到深夜，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 188876,
          "spk": "茶梅 (サザンカ)",
          "ja": "変な音が聞こえてくるんだよね……",
          "tc": "我就會聽到奇怪的聲音……",
          "sc": "我就会听到奇怪的声音……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 188887,
          "spk": "茶梅 (サザンカ)",
          "ja": "気持ち悪くて寝れないから",
          "tc": "因為毛到沒辦法睡，",
          "sc": "因为毛到没办法睡，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 188894,
          "spk": "茶梅 (サザンカ)",
          "ja": "見に来たんだけど……",
          "tc": "所以就過來看看了……",
          "sc": "所以就过来看看了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 188905,
          "spk": "茶梅 (サザンカ)",
          "ja": "ソイツが音を鳴らしてたんだね",
          "tc": "原來是那傢伙在發出聲音啊。",
          "sc": "原来是那家伙在发出声音啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 188912,
          "spk": "茶梅 (サザンカ)",
          "ja": "不思議だな",
          "tc": "真不可思議。",
          "sc": "真不可思议。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 188919,
          "spk": "茶梅 (サザンカ)",
          "ja": "どう見ても壊れてるのに……",
          "tc": "明明怎麼看都已經壞了……",
          "sc": "明明怎么看都已经坏了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3429,
      "rec_id": "TALK_ID_60_0009_124",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188939,
          "spk": "？？？ (未知角色)",
          "ja": "<half>ナオシテ</half>……<half>ナオシテ</half>……",
          "tc": "<half>修好我</half>……<half>修好我</half>……",
