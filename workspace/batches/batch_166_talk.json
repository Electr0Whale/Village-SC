        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3430,
      "rec_id": "TALK_ID_60_0009_125",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 188959,
          "spk": "茶梅 (サザンカ)",
          "ja": "あー……こんな乱雑に",
          "tc": "啊……",
          "sc": "啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 188966,
          "spk": "茶梅 (サザンカ)",
          "ja": "パーツが詰め込まれてら",
          "tc": "零件亂七八糟塞在裡面，",
          "sc": "零件乱七八糟塞在里面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 188973,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんなんじゃ直んないよ",
          "tc": "這樣是修不好的啦。",
          "sc": "这样是修不好的啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 188984,
          "spk": "茶梅 (サザンカ)",
          "ja": "しょうがない……",
          "tc": "真沒辦法……",
          "sc": "真没办法……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 188991,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシが直してやるか",
          "tc": "就由我來修吧。",
          "sc": "就由我来修吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3431,
      "rec_id": "TALK_ID_60_0009_126",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189009,
          "spk": "茶梅 (サザンカ)",
          "ja": "ってことで、",
          "tc": "事情就是這樣，",
          "sc": "事情就是这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189016,
          "spk": "茶梅 (サザンカ)",
          "ja": "コイツはアタシが預かるよ",
          "tc": "這個就先由我來保管吧！",
          "sc": "这个就先由我来保管吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189023,
          "spk": "茶梅 (サザンカ)",
          "ja": "直るか試してみるね",
          "tc": "我再試試看修不修得好。",
          "sc": "我再试试看修不修得好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3432,
      "rec_id": "TALK_ID_60_0010_001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189493,
          "spk": "名护 (ナゴ)",
          "ja": "<player>さん……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189500,
          "spk": "名护 (ナゴ)",
          "ja": "もしかして……",
          "tc": "難道說……",
          "sc": "难道说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3433,
      "rec_id": "TALK_ID_60_0010_002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189518,
          "spk": "名护 (ナゴ)",
          "ja": "ついに全ての本が集まったのかい？",
          "tc": "終於找齊所有的書了嗎？",
          "sc": "终于找齐所有的书了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189536,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう、<player>さん！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 189543,
          "spk": "名护 (ナゴ)",
          "ja": "キミのおかげだな！",
          "tc": "真是多虧有你在！",
          "sc": "真是多亏有你在！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3434,
      "rec_id": "TALK_ID_60_0010_003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189561,
          "spk": "名护 (ナゴ)",
          "ja": "キミが集めてくれた本は、",
          "tc": "你幫忙收集的書裡頭，",
          "sc": "你帮忙收集的书里头，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189568,
          "spk": "名护 (ナゴ)",
          "ja": "彼ヶ津村の過去を読み解けるような",
          "tc": "記載了許多有助於解讀彼津村過往的內容，",
          "sc": "记载了许多有助于解读彼津村过往的内容，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189575,
          "spk": "名护 (ナゴ)",
          "ja": "興味深いことばかりが書いてあったよ",
          "tc": "全都相當耐人尋味呢。",
          "sc": "全都相当耐人寻味呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 189586,
          "spk": "名护 (ナゴ)",
          "ja": "……この村の歴史は、実に皮肉だ ",
          "tc": "……這個村子的歷史，還真是諷刺。",
          "sc": "……这个村子的历史，还真是讽刺。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 189604,
          "spk": "名护 (ナゴ)",
          "ja": "この場所で生き延びるために神に抗い、",
          "tc": "人們為了在這個地方活下去，一再對抗神明，",
          "sc": "人们为了在这个地方活下去，一再对抗神明，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 189611,
          "spk": "名护 (ナゴ)",
          "ja": "そのたびに人柱や掟という負のしがらみを",
          "tc": "過程中不斷增加人祭與規矩",
          "sc": "过程中不断增加人祭与规矩"
        },
        {
          "f_idx": 7,
          "pidx_tc": 189618,
          "spk": "名护 (ナゴ)",
          "ja": "増やし続けてきた……",
          "tc": "這種負面的枷鎖……",
          "sc": "这种负面的枷锁……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 189627,
          "spk": "名护 (ナゴ)",
          "ja": "血にまみれた土地だと、",
          "tc": "任誰都會說，",
          "sc": "任谁都会说，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 189634,
          "spk": "名护 (ナゴ)",
          "ja": "きっと誰もが言うだろう",
          "tc": "這裡是沾滿鮮血的土地吧。",
          "sc": "这里是沾满鲜血的土地吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 189645,
          "spk": "名护 (ナゴ)",
          "ja": "それでも……",
          "tc": "即使如此……",
          "sc": "即使如此……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 189652,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、この彼ヶ津村を",
          "tc": "我還是怎樣都沒辦法討厭",
          "sc": "我还是怎样都没办法讨厌"
        },
        {
          "f_idx": 12,
          "pidx_tc": 189659,
          "spk": "名护 (ナゴ)",
          "ja": "どうしても嫌いになれないよ",
          "tc": "這個彼津村。",
          "sc": "这个彼津村。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 189670,
          "spk": "名护 (ナゴ)",
          "ja": "神に屈せず、間違いかもしれない選択を",
          "tc": "不向神明屈服，",
          "sc": "不向神明屈服，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 189677,
          "spk": "名护 (ナゴ)",
          "ja": "何度も積み重ねてきた……",
          "tc": "一次次做出或許是錯誤的選擇……",
          "sc": "一次次做出或许是错误的选择……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 189684,
          "spk": "名护 (ナゴ)",
          "ja": "その愚かさも必死さも、全部が血の通った歴史だ",
          "tc": "那份愚昧、那種迫切，全是有血有肉的歷史。",
          "sc": "那份愚昧、那种迫切，全是有血有肉的历史。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 189695,
          "spk": "名护 (ナゴ)",
          "ja": "そして今も、",
          "tc": "而如今，",
          "sc": "而如今，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 189702,
          "spk": "名护 (ナゴ)",
          "ja": "その延長線上で俺たちは暮らしている……",
          "tc": "我們正活在他們所延續下來的未來……",
          "sc": "我们正活在他们所延续下来的未来……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 189709,
          "spk": "名护 (ナゴ)",
          "ja": "……人の営みの、尊さを感じるんだ",
