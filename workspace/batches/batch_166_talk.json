          "pidx_tc": 190047,
          "spk": "？？？ (未知角色)",
          "ja": "珍しいこともあるもんだわ",
          "tc": "這還真稀奇呢。",
          "sc": "这还真稀奇呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 190056,
          "spk": "？？？ (未知角色)",
          "ja": "子どものくせして、なんや土くせぇ……",
