  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7380,
      "rec_id": "TALK_ID_70_2090_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451285,
          "spk": "今野 (コンノ)",
          "ja": "まだ何かァ？",
          "tc": "又怎麼了？",
          "sc": "又怎么了～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451298,
          "spk": "四郎治 (シロージ)",
          "ja": "白髪が生えてんぞ",
          "tc": "你長白頭髮了。",
          "sc": "你长白头发了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 451311,
          "spk": "今野 (コンノ)",
          "ja": "はァッ！？",
          "tc": "什麼！？",
          "sc": "什么！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 451318,
          "spk": "今野 (コンノ)",
          "ja": "ど、どこです！？",
          "tc": "在、在哪裡！？",
          "sc": "在、在哪里！？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 451331,
          "spk": "四郎治 (シロージ)",
          "ja": "分け目のとこだよ",
          "tc": "在頭髮分邊的地方，",
          "sc": "在头发分边的地方，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 451338,
          "spk": "四郎治 (シロージ)",
          "ja": "抜いてやろうか？",
          "tc": "要我幫你拔嗎？",
          "sc": "要我帮你拔吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7381,
      "rec_id": "TALK_ID_70_2090_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451354,
          "spk": "今野 (コンノ)",
          "ja": "冗談じゃありませんヨ！",
          "tc": "別開玩笑了！",
          "sc": "别开玩笑了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451361,
          "spk": "今野 (コンノ)",
          "ja": "アナタ前に、他の髪も一緒に",
          "tc": "您之前拔的時候",
          "sc": "您之前拔的时候"
        },
        {
          "f_idx": 2,
          "pidx_tc": 451368,
          "spk": "今野 (コンノ)",
          "ja": "ブチブチと引き抜いたでしょう！",
          "tc": "不是連著其他頭髮也一起拔掉了嗎！",
          "sc": "不是连着其他头发也一起拔掉了吗！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7382,
      "rec_id": "TALK_ID_70_2090_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451394,
          "spk": "今野 (コンノ)",
          "ja": "<player>さん、ちょうどいいところに！",
          "tc": "<player>，您來得正好！",
          "sc": "<player>，您来得正好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451401,
          "spk": "今野 (コンノ)",
          "ja": "白髪を抜いてください！",
          "tc": "請幫我拔白頭髮吧！",
          "sc": "请帮我拔白头发吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7383,
      "rec_id": "TALK_ID_70_2090_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451432,
          "spk": "今野 (コンノ)",
          "ja": "抜きましたネ？",
          "tc": "拔掉了嗎？",
          "sc": "拔掉了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451439,
          "spk": "今野 (コンノ)",
          "ja": "どれどれ",
          "tc": "我看看。",
          "sc": "我看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7384,
      "rec_id": "TALK_ID_70_2090_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451457,
          "spk": "今野 (コンノ)",
          "ja": "おォ、ちゃんと一本だけ",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451464,
          "spk": "今野 (コンノ)",
          "ja": "抜けましたねェ",
          "tc": "真的只拔了一根呢。",
          "sc": "真的只拔了一根呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 451475,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、意外と器用じゃないですかァ",
          "tc": "沒想到您的手這麼巧，",
          "sc": "没想到您的手这么巧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 451482,
          "spk": "今野 (コンノ)",
          "ja": "普段は使わない指先でしょうにネ",
          "tc": "明明您平常應該是用不到指尖的。",
          "sc": "明明您平常应该是用不到指尖的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 451500,
          "spk": "今野 (コンノ)",
          "ja": "じゃ、失礼します",
          "tc": "那麼我就先告辭了。",
          "sc": "那么我就先告辞了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7385,
      "rec_id": "TALK_ID_70_2090_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451524,
          "spk": "四郎治 (シロージ)",
          "ja": "あの様子……",
          "tc": "看樣子……",
          "sc": "看样子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451531,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、気に入られてんな",
          "tc": "他好像還滿喜歡你的。",
          "sc": "他好像还满喜欢你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7386,
      "rec_id": "TALK_ID_70_2090_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451549,
          "spk": "四郎治 (シロージ)",
          "ja": "そんなお前に",
          "tc": "那我就把",
          "sc": "那我就把"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451556,
          "spk": "四郎治 (シロージ)",
          "ja": "コンノの取扱方法を",
          "tc": "對付今野的辦法",
          "sc": "对付今野的办法"
        },
        {
          "f_idx": 2,
          "pidx_tc": 451563,
          "spk": "四郎治 (シロージ)",
          "ja": "伝授してやる",
          "tc": "傳授給你吧。",
          "sc": "传授给你吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 451572,
          "spk": "四郎治 (シロージ)",
          "ja": "着てるものや持ち物なんかを",
          "tc": "你只要一直誇讚",
          "sc": "你只要一直夸赞"
        },
        {
          "f_idx": 4,
          "pidx_tc": 451579,
          "spk": "四郎治 (シロージ)",
          "ja": "とにかく褒めそやすと、",
          "tc": "他穿著的衣服或是身上的物品，",
          "sc": "他穿着的衣服或是身上的物品，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 451586,
          "spk": "四郎治 (シロージ)",
          "ja": "すぐに気分をよくするぜ",
          "tc": "他心情就會變得很好。",
          "sc": "他心情就会变得很好。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 451597,
          "spk": "四郎治 (シロージ)",
          "ja": "俺はこの方法で",
          "tc": "我就是用這招",
          "sc": "我就是用这招"
        },
        {
          "f_idx": 7,
          "pidx_tc": 451604,
          "spk": "四郎治 (シロージ)",
          "ja": "コンノから新品のスニーカーと",
          "tc": "從今野那邊拿到了新球鞋",
          "sc": "从今野那边拿到了新球鞋"
        },
        {
          "f_idx": 8,
          "pidx_tc": 451611,
          "spk": "四郎治 (シロージ)",
          "ja": "やたら暖かいコートをもらった",
          "tc": "和超級保暖的大衣。",
          "sc": "和超级保暖的大衣。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7387,
      "rec_id": "TALK_ID_70_2090_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451629,
          "spk": "四郎治 (シロージ)",
          "ja": "あいつは言葉はキツいけどな",
          "tc": "他講話雖然難聽，",
          "sc": "他讲话虽然难听，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451636,
          "spk": "四郎治 (シロージ)",
          "ja": "コツがわかれば扱いやすいんだよ",
          "tc": "但只要掌握了訣竅就很好相處了。",
          "sc": "但只要掌握了诀窍就很好相处了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 451654,
          "spk": "四郎治 (シロージ)",
          "ja": "それに、ああ見えて",
          "tc": "而且別看他那樣，",
          "sc": "而且别看他那样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 451661,
          "spk": "四郎治 (シロージ)",
          "ja": "村のことを思ってるぜ",
          "tc": "他其實很為村子著想。",
          "sc": "他其实很为村子着想。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 451670,
          "spk": "四郎治 (シロージ)",
          "ja": "本人に言えば",
          "tc": "但如果你問他，",
          "sc": "但如果你问他，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 451677,
          "spk": "四郎治 (シロージ)",
          "ja": "否定するだろうけどな",
          "tc": "他應該會否認。",
          "sc": "他应该会否认。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 451688,
          "spk": "四郎治 (シロージ)",
          "ja": "……ま、うまくやれよ",
          "tc": "……你加油吧。",
          "sc": "……你加油吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7388,
      "rec_id": "TALK_ID_70_2090_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 451714,
          "spk": "茶梅 (サザンカ)",
          "ja": "だからさ、勝手に",
          "tc": "你可不可以",
          "sc": "你可不可以"
        },
        {
          "f_idx": 1,
          "pidx_tc": 451721,
          "spk": "茶梅 (サザンカ)",
          "ja": "入ってこないでくんない？",
          "tc": "不要擅自跑進來啊？",
          "sc": "不要擅自跑进来啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 451728,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタは出禁だっつの",
          "tc": "我已經禁止你的出入了耶。",
          "sc": "我已经禁止你的出入了呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 451741,
          "spk": "今野 (コンノ)",
          "ja": "ワタシは事実を",
          "tc": "我也只是",
          "sc": "我也只是"
        },
        {
          "f_idx": 4,
          "pidx_tc": 451748,
          "spk": "今野 (コンノ)",
          "ja": "指摘している",
          "tc": "闡述了事實",
          "sc": "阐述了事实"
        },
        {
          "f_idx": 5,
          "pidx_tc": 451755,
          "spk": "今野 (コンノ)",
          "ja": "だけですよォ？",
          "tc": "而已啊。",
          "sc": "而已哟～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 451766,
          "spk": "今野 (コンノ)",
          "ja": "それくらいで出禁とは、",
          "tc": "這樣就要",
          "sc": "这样就要"
        },
        {
          "f_idx": 7,
          "pidx_tc": 451773,
          "spk": "今野 (コンノ)",
          "ja": "横暴極まりないとは",
          "tc": "被禁止出入，",
          "sc": "被禁止出入，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 451780,
          "spk": "今野 (コンノ)",
          "ja": "思わないんですかァ？",
          "tc": "您不覺得這樣太霸道了嗎？",
          "sc": "您不觉得这样太霸道了吗～？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 451793,
          "spk": "茶梅 (サザンカ)",
          "ja": "こっちにも",
          "tc": "但是",
          "sc": "但是"
        },
        {
          "f_idx": 10,
          "pidx_tc": 451800,
          "spk": "茶梅 (サザンカ)",
          "ja": "客を選ぶ権利って",
          "tc": "我也有權利",
          "sc": "我也有权利"
        },
        {
          "f_idx": 11,
          "pidx_tc": 451807,
          "spk": "茶梅 (サザンカ)",
          "ja": "もんがあるんだよね",
          "tc": "挑選客人啊。",
          "sc": "挑选客人啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 451820,
          "spk": "今野 (コンノ)",
          "ja": "ですが、よく見てくださいヨ",
          "tc": "可是您仔細看啊。",
          "sc": "可是您仔细看啊。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 451831,
          "spk": "今野 (コンノ)",
          "ja": "看板一つとっても、",
          "tc": "光看這個招牌就好，",
          "sc": "光看这个招牌就好，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 451838,
          "spk": "今野 (コンノ)",
          "ja": "もはやレトロではなく",
          "tc": "已經不能說是復古，",
          "sc": "已经不能说是复古，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 451845,
          "spk": "今野 (コンノ)",
          "ja": "廃墟に近いような有り様ですし",
          "tc": "而是根本像是廢墟了吧。",
          "sc": "而是根本像是废墟了吧。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 451858,
          "spk": "茶梅 (サザンカ)",
          "ja": "その感性、アンタの",
          "tc": "我覺得你的品味",
          "sc": "我觉得你的品味"
        },
        {
          "f_idx": 17,
          "pidx_tc": 451865,
          "spk": "茶梅 (サザンカ)",
          "ja": "コレクションくらい",
          "tc": "就跟你那些收藏品一樣，",
          "sc": "就跟你那些收藏品一样，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 451872,
          "spk": "茶梅 (サザンカ)",
          "ja": "ズレてると思うわ",
          "tc": "真的很差。",
          "sc": "真的很差。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 451885,
          "spk": "今野 (コンノ)",
          "ja": "漂うのは古臭い香り……",
          "tc": "再加上這股籠罩著店內的老舊味道……",
          "sc": "再加上这股笼罩着店内的老旧味道……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 451892,
          "spk": "今野 (コンノ)",
          "ja": "そう、埃と線香とい草の匂いです",
          "tc": "沒錯，就是灰塵、線香和榻榻米的味道。",
          "sc": "没错，就是灰尘、线香和榻榻米的味道。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 451905,
          "spk": "茶梅 (サザンカ)",
          "ja": "うちの店は板張りだから",
          "tc": "我們店裡是木頭地板，",
          "sc": "我们店里是木头地板，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 451912,
          "spk": "茶梅 (サザンカ)",
          "ja": "い草の匂いなんかしないっつの",
          "tc": "所以不會有什麼榻榻米的味道啦。",
          "sc": "所以不会有什么榻榻米的味道啦。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 451919,
          "spk": "茶梅 (サザンカ)",
          "ja": "鼻の掃除してんの？",
          "tc": "你有沒有在清潔你的鼻子啊？",
          "sc": "你有没有在清洁你的鼻子啊？"
        },
        {
          "f_idx": 24,
          "pidx_tc": 451932,
          "spk": "今野 (コンノ)",
          "ja": "なんという言い草！",
          "tc": "您講這是什麼話啊！",
          "sc": "您讲这是什么话啊！"
        },
        {
          "f_idx": 25,
          "pidx_tc": 451939,
          "spk": "今野 (コンノ)",
          "ja": "それが客への態度ですかァ？",
          "tc": "這就是您對待客人的態度嗎？",
          "sc": "这就是您对待客人的态度吗～？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 451952,
          "spk": "茶梅 (サザンカ)",
          "ja": "だからアンタは出禁だって",
          "tc": "所以我才禁止你出入啊，",
          "sc": "所以我才禁止你出入啊，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 451959,
          "spk": "茶梅 (サザンカ)",
          "ja": "文句があるなら来るな",
          "tc": "不爽就不要來嘛。",
          "sc": "不爽就不要来嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7389,
