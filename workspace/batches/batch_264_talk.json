          "spk": "今野 (コンノ)",
          "ja": "ハァ、やれやれ……",
          "tc": "唉，真是的……",
          "sc": "唉，真是的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7390,
      "rec_id": "TALK_ID_70_2090_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452010,
          "spk": "今野 (コンノ)",
          "ja": "おやァ？",
          "tc": "哦？",
          "sc": "哎呀～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452017,
          "spk": "今野 (コンノ)",
          "ja": "<player>さん、そこで",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452024,
          "spk": "今野 (コンノ)",
          "ja": "何をしてるんです？",
          "tc": "您在那裡做什麼呢？",
          "sc": "您在那里做什么呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7391,
      "rec_id": "TALK_ID_70_2090_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452042,
          "spk": "今野 (コンノ)",
          "ja": "あァ、今の聞いてましたァ？",
          "tc": "啊，您聽到剛剛的對話了嗎？",
          "sc": "啊，您听到刚刚的对话了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452049,
          "spk": "今野 (コンノ)",
          "ja": "サザンカさん、よく",
          "tc": "茶梅小姐的口齒",
          "sc": "茶梅小姐的口齿"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452056,
          "spk": "今野 (コンノ)",
          "ja": "口が回りますよネ",
          "tc": "真的是很伶俐啊。",
          "sc": "真的是很伶俐啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452067,
          "spk": "今野 (コンノ)",
          "ja": "ワタシとあれだけ言い合えるとは",
          "tc": "沒想到她能跟我拌嘴到這種程度，",
          "sc": "没想到她能跟我拌嘴到这种程度，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452074,
          "spk": "今野 (コンノ)",
          "ja": "やはり血は争えませんヨ",
          "tc": "果然是血緣是不會騙人的，",
          "sc": "果然是血缘是不会骗人的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452081,
          "spk": "今野 (コンノ)",
          "ja": "そっくりです",
          "tc": "真是太像了。",
          "sc": "真是太像了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7392,
      "rec_id": "TALK_ID_70_2090_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452099,
          "spk": "今野 (コンノ)",
          "ja": "ん？　出禁のことですかァ？",
          "tc": "嗯？您是問我被禁止出入的事嗎？",
          "sc": "嗯？您是问我被禁止出入的事吗～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452110,
          "spk": "今野 (コンノ)",
          "ja": "村の生命線とも言える",
          "tc": "明明這間店堪稱是",
          "sc": "明明这间店堪称是"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452117,
          "spk": "今野 (コンノ)",
          "ja": "店なのに、客を選ぶなんて",
          "tc": "這村子的命脈，",
          "sc": "这村子的命脉，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452124,
          "spk": "今野 (コンノ)",
          "ja": "信じられませんよねェ",
          "tc": "真是不敢相信她居然會挑客人。",
          "sc": "真是不敢相信她居然会挑客人呐～。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452135,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはただ親切心でもって",
          "tc": "我只是出於好意，",
          "sc": "我只是出于好意，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452142,
          "spk": "今野 (コンノ)",
          "ja": "掃除の行き届かなさを",
          "tc": "不斷地在提醒她",
          "sc": "不断地在提醒她"
        },
        {
          "f_idx": 6,
          "pidx_tc": 452149,
          "spk": "今野 (コンノ)",
          "ja": "指摘し続けているだけなのに",
          "tc": "哪裡沒有掃乾淨而已。",
          "sc": "哪里没有扫干净而已。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 452160,
          "spk": "今野 (コンノ)",
          "ja": "言い続けていたら",
          "tc": "持續提醒一段時間後，",
          "sc": "持续提醒一段时间后，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 452167,
          "spk": "今野 (コンノ)",
          "ja": "出禁だと言われたんです",
          "tc": "她就禁止我出入那間店了。",
          "sc": "她就禁止我出入那间店了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 452174,
          "spk": "今野 (コンノ)",
          "ja": "まったく、酷い話ですヨ",
          "tc": "真的是太沒有良心了。",
          "sc": "真的是太没有良心哟～。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 452185,
          "spk": "今野 (コンノ)",
          "ja": "商品棚に埃があったら",
          "tc": "商品架上有灰塵，",
          "sc": "商品架上有灰尘，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 452192,
          "spk": "今野 (コンノ)",
          "ja": "誰だって気になるでしょう？",
          "tc": "這任誰都會介意的吧？",
          "sc": "这任谁都会介意的吧？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 452208,
          "spk": "今野 (コンノ)",
          "ja": "床の艶も消え失せて",
          "tc": "地板的光澤",
          "sc": "地板的光泽"
        },
        {
          "f_idx": 14,
          "pidx_tc": 452215,
          "spk": "今野 (コンノ)",
          "ja": "久しいですし、窓ガラスは",
          "tc": "已經消失很久了，",
          "sc": "已经消失很久了，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 452222,
          "spk": "今野 (コンノ)",
          "ja": "いっつも曇ってますし",
          "tc": "玻璃窗也一直都是霧霧的。",
          "sc": "玻璃窗也一直都是雾雾的。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 452233,
          "spk": "今野 (コンノ)",
          "ja": "そもそも、こんな田舎臭さ",
          "tc": "而且說到底，",
          "sc": "而且说到底，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 452240,
          "spk": "今野 (コンノ)",
          "ja": "丸出しの店は、外観から",
          "tc": "這種散發著濃烈鄉下味的店家，",
          "sc": "这种散发着浓烈乡下味的店家，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 452247,
          "spk": "今野 (コンノ)",
          "ja": "改装すべきなんですヨ",
          "tc": "應該要從店面外觀整個大翻修才是。",
          "sc": "应该要从店面外观整个大翻修才是哟～。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 452258,
          "spk": "今野 (コンノ)",
          "ja": "店内も店外もピカピカに",
          "tc": "應該要讓這整間店",
          "sc": "应该要让这整间店"
        },
        {
          "f_idx": 20,
          "pidx_tc": 452265,
          "spk": "今野 (コンノ)",
          "ja": "綺麗にして、清潔さと美しさを",
          "tc": "都乾淨得發亮，",
          "sc": "都干净得发亮，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 452272,
          "spk": "今野 (コンノ)",
          "ja": "保つ努力をしなければねェ",
          "tc": "然後努力維持整潔與美觀才行。",
          "sc": "然后努力维持整洁与美观才行呐～。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 452283,
          "spk": "今野 (コンノ)",
          "ja": "……そういえば",
          "tc": "……說起來，",
          "sc": "……说起来，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 452290,
          "spk": "今野 (コンノ)",
          "ja": "アナタの家もなかなか",
          "tc": "您府上",
          "sc": "您府上"
        },
        {
          "f_idx": 24,
          "pidx_tc": 452297,
          "spk": "今野 (コンノ)",
          "ja": "汚いですよネ",
          "tc": "好像也是滿髒的。",
          "sc": "好像也是满脏的。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 452308,
          "spk": "今野 (コンノ)",
          "ja": "掃除くらい、きちんと",
          "tc": "您有沒有",
          "sc": "您有没有"
        },
        {
          "f_idx": 26,
          "pidx_tc": 452315,
          "spk": "今野 (コンノ)",
          "ja": "しているんですかァ？",
          "tc": "在好好打掃啊？",
          "sc": "在好好打扫啊～？"
        },
        {
          "f_idx": 27,
          "pidx_tc": 452324,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 28,
          "pidx_tc": 452331,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7393,
      "rec_id": "TALK_ID_70_2090_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452435,
          "spk": "今野 (コンノ)",
          "ja": "掃除というのは、",
          "tc": "打掃呢，",
          "sc": "打扫呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452442,
          "spk": "今野 (コンノ)",
          "ja": "道具の手入れから",
          "tc": "就得先從",
          "sc": "就得先从"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452449,
          "spk": "今野 (コンノ)",
          "ja": "始まっているんです",
          "tc": "保養工具開始。",
          "sc": "保养工具开始。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452460,
          "spk": "今野 (コンノ)",
          "ja": "穂先が乱れたホウキは",
          "tc": "掃把鬚雜亂的掃把",
          "sc": "扫把须杂乱的扫把"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452467,
          "spk": "今野 (コンノ)",
          "ja": "使い物になりませんし",
          "tc": "是不能使用的。",
          "sc": "是不能使用的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452476,
          "spk": "今野 (コンノ)",
          "ja": "使い古しのぼろ布で",
          "tc": "還有拿陳年的破布擦地，",
          "sc": "还有拿陈年的破布擦地，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 452483,
          "spk": "今野 (コンノ)",
          "ja": "いくら床を拭いても",
          "tc": "不管擦得再怎麼勤奮",
          "sc": "不管擦得再怎么勤奋"
        },
        {
          "f_idx": 7,
          "pidx_tc": 452490,
          "spk": "今野 (コンノ)",
          "ja": "大して綺麗にはなりません",
          "tc": "也無法擦得多乾淨。",
          "sc": "也无法擦得多干净。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 452501,
          "spk": "今野 (コンノ)",
          "ja": "毎朝起きたら布団を干して",
          "tc": "每天早上起床就晾棉被、",
          "sc": "每天早上起床就晾棉被、"
        },
        {
          "f_idx": 9,
          "pidx_tc": 452508,
          "spk": "今野 (コンノ)",
          "ja": "床を掃いて水拭きをする",
          "tc": "掃地板、拖地板。",
          "sc": "扫地板、拖地板。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 452524,
          "spk": "今野 (コンノ)",
          "ja": "週末には窓を磨いて",
          "tc": "週末則是要好好擦亮窗戶、",
          "sc": "周末则是要好好擦亮窗户、"
        },
        {
          "f_idx": 12,
          "pidx_tc": 452531,
          "spk": "今野 (コンノ)",
          "ja": "家具の埃を落とし",
          "tc": "除去家具的灰塵，",
          "sc": "除去家具的灰尘，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 452538,
          "spk": "今野 (コンノ)",
          "ja": "掃除用具の手入れをする",
          "tc": "然後保養打掃工具。",
          "sc": "然后保养打扫工具。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 452549,
          "spk": "今野 (コンノ)",
          "ja": "これを心がけるだけでも",
          "tc": "只要能好好做到這些，",
          "sc": "只要能好好做到这些，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 452556,
          "spk": "今野 (コンノ)",
          "ja": "家というものは",
          "tc": "就能夠維持",
          "sc": "就能够维持"
        },
        {
          "f_idx": 16,
          "pidx_tc": 452563,
          "spk": "今野 (コンノ)",
          "ja": "清潔さを保てるものです",
          "tc": "一個家的整潔了。",
          "sc": "一个家的整洁了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 452574,
          "spk": "今野 (コンノ)",
          "ja": "いいですかァ？",
          "tc": "聽好了，",
          "sc": "听好了，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 452581,
          "spk": "今野 (コンノ)",
          "ja": "くれぐれもサザンカさんの",
          "tc": "您可千萬",
          "sc": "您可千万"
        },
        {
          "f_idx": 19,
          "pidx_tc": 452588,
          "spk": "今野 (コンノ)",
          "ja": "ようになってはいけませんヨ",
          "tc": "不能變得像茶梅小姐那樣喔。",
          "sc": "不能变得像茶梅小姐那样哟～。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 452599,
          "spk": "今野 (コンノ)",
          "ja": "わかりましたネ？",
          "tc": "明白了嗎？",
          "sc": "明白了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7394,
      "rec_id": "TALK_ID_70_2090_005_07",
      "lines": [
        {
          "f_idx": 0,
