    {
      "file": "talk.dat",
      "rec_idx": 7399,
      "rec_id": "TALK_ID_70_2090_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452879,
          "spk": "今野 (コンノ)",
          "ja": "……ンフフフフ",
          "tc": "……呵呵呵呵呵，",
          "sc": "……呵呵呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452886,
          "spk": "今野 (コンノ)",
          "ja": "夜が怖いですか？",
          "tc": "您會害怕晚上嗎？",
          "sc": "您会害怕晚上吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452893,
          "spk": "今野 (コンノ)",
          "ja": "闇が怖いですか？",
          "tc": "您會害怕黑暗嗎？",
          "sc": "您会害怕黑暗吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452904,
          "spk": "今野 (コンノ)",
          "ja": "委ねてしまえば",
          "tc": "明明只要敞開心房，",
          "sc": "明明只要敞开心房，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452911,
          "spk": "今野 (コンノ)",
          "ja": "楽になれるのに、",
          "tc": "就能夠輕鬆許多的，",
          "sc": "就能够轻松许多的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452918,
          "spk": "今野 (コンノ)",
          "ja": "おかしいですネ",
          "tc": "您也真是奇怪。",
          "sc": "您也真是奇怪。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 452929,
          "spk": "今野 (コンノ)",
          "ja": "ワタシたちは夜を生きているというのに",
          "tc": "夜晚明明是我們生活的一部分，",
          "sc": "夜晚明明是我们生活的一部分，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 452936,
          "spk": "今野 (コンノ)",
          "ja": "一体、何を恐れることがあるんです？",
          "tc": "到底有什麼好怕的？",
          "sc": "到底有什么好怕的？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 452947,
          "spk": "今野 (コンノ)",
          "ja": "何かが潜んでいるとすれば",
          "tc": "如果真的有什麼東西潛伏著，",
          "sc": "如果真的有什么东西潜伏着，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 452954,
          "spk": "今野 (コンノ)",
          "ja": "それは昼も夜も同じこと",
          "tc": "那我想祂們也不會分白天還是黑夜吧。",
          "sc": "那我想他们也不会分白天还是黑夜吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 452965,
          "spk": "今野 (コンノ)",
          "ja": "ただ、見えるか",
          "tc": "差也只是差在我們",
          "sc": "差也只是差在我们"
        },
        {
          "f_idx": 11,
          "pidx_tc": 452972,
          "spk": "今野 (コンノ)",
          "ja": "見えないかの",
          "tc": "看得見",
          "sc": "看得见"
        },
        {
          "f_idx": 12,
          "pidx_tc": 452979,
          "spk": "今野 (コンノ)",
          "ja": "違いですヨ",
          "tc": "還是看不見而已。",
          "sc": "还是看不见而已哟～。"
        }
      ]
    },
