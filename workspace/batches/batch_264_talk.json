    {
      "file": "talk.dat",
      "rec_idx": 7395,
      "rec_id": "TALK_ID_70_2090_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452653,
          "spk": "今野 (コンノ)",
          "ja": "おやまァ",
          "tc": "哦，",
          "sc": "哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452660,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんですかァ",
          "tc": "這不是<player>嗎？",
          "sc": "这不是<player>吗～？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452671,
          "spk": "今野 (コンノ)",
          "ja": "こんな時間に好きこのんで",
          "tc": "沒想到喜歡在這種時間",
          "sc": "没想到喜欢在这种时间"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452678,
          "spk": "今野 (コンノ)",
          "ja": "竹林を歩く物好きが",
          "tc": "到竹林散步的怪人，",
          "sc": "到竹林散步的怪人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452685,
          "spk": "今野 (コンノ)",
          "ja": "まさかワタシ以外にいるとはねェ",
          "tc": "除了我以外還有別人啊。",
          "sc": "除了我以外还有别人呐～。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452696,
          "spk": "今野 (コンノ)",
          "ja": "まァ、騒がないなら",
          "tc": "如果您不會吵鬧的話，",
          "sc": "如果您不会吵闹的话，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 452703,
          "spk": "今野 (コンノ)",
          "ja": "近くにいても結構ですヨ",
          "tc": "待在我附近也沒關係的喔。",
          "sc": "待在我附近也没关系哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7396,
      "rec_id": "TALK_ID_70_2090_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452721,
          "spk": "今野 (コンノ)",
          "ja": "……この村は",
          "tc": "……我很討厭",
          "sc": "……我很讨厌"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452728,
          "spk": "今野 (コンノ)",
          "ja": "田舎くさくて",
          "tc": "這個村子，",
          "sc": "这个村子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452735,
          "spk": "今野 (コンノ)",
          "ja": "嫌いなんですけどネ",
          "tc": "因為實在是太鄉下了。",
          "sc": "因为实在是太乡下了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452746,
          "spk": "今野 (コンノ)",
          "ja": "この竹林は",
          "tc": "但是我很喜歡",
          "sc": "但是我很喜欢"
        },
        {
          "f_idx": 4,
          "pidx_tc": 452753,
          "spk": "今野 (コンノ)",
          "ja": "気に入ってるんですヨ",
          "tc": "這片竹林。",
          "sc": "这片竹林哟～。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 452764,
          "spk": "今野 (コンノ)",
          "ja": "特に夜は、風の声が",
          "tc": "尤其是在夜裡",
          "sc": "尤其是在夜里"
        },
        {
          "f_idx": 6,
          "pidx_tc": 452771,
          "spk": "今野 (コンノ)",
          "ja": "聞こえますからネ",
          "tc": "還能聽到風聲。",
          "sc": "还能听到风声。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7397,
      "rec_id": "TALK_ID_70_2090_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 452796,
          "spk": "今野 (コンノ)",
          "ja": "目を閉じて佇んでいると",
          "tc": "只要閉上眼睛靜靜地站著，",
          "sc": "只要闭上眼睛静静地站着，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 452803,
          "spk": "今野 (コンノ)",
          "ja": "風がワタシを取り巻いて",
          "tc": "風就會包圍住我，",
          "sc": "风就会包围住我，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 452810,
          "spk": "今野 (コンノ)",
          "ja": "穢れを取り払ってくれるんです",
          "tc": "並帶走我的污穢。",
          "sc": "并带走我的污秽。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 452821,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんも",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 4,
