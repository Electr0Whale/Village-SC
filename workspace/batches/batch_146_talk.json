      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 151807,
          "spk": "莲实 (ハスミ)",
          "ja": "あ、<player>さん……",
          "tc": "啊，<player>……",
          "sc": "啊，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 151814,
          "spk": "莲实 (ハスミ)",
          "ja": "いきなりこんなことを尋ねても",
          "tc": "雖然突然這麼問，",
          "sc": "虽然突然这么问，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 151821,
          "spk": "莲实 (ハスミ)",
          "ja": "困らせてしまうかもしれないですが……",
          "tc": "也許只會讓你感到困擾……",
          "sc": "也许只会让你感到困扰……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 151832,
          "spk": "莲实 (ハスミ)",
          "ja": "<tmpstr>をお持ちではないですか？",
          "tc": "請問你手邊有沒有<tmpstr>呢？",
          "sc": "请问你手边有没有<tmpstr>呢？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 151839,
          "spk": "莲实 (ハスミ)",
          "ja": "自分で調達してこようにも忙しくて",
          "tc": "雖然我也想自己想辦法，",
          "sc": "虽然我也想自己想办法，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 151846,
          "spk": "莲实 (ハスミ)",
          "ja": "なかなか手が回らなくて……",
          "tc": "但實在是忙到抽不出時間來……",
          "sc": "但实在是忙到抽不出时间来……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 151857,
          "spk": "莲实 (ハスミ)",
          "ja": "ちゃんとお礼はさせてもらいますから",
          "tc": "我一定會好好答謝你的，",
          "sc": "我一定会好好答谢你的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 151864,
          "spk": "莲实 (ハスミ)",
          "ja": "<gamevalue GAME_VALUE_TALK_NUM>日以内を目途にお願いできますか？",
          "tc": "所以能否大概在<gamevalue GAME_VALUE_TALK_NUM>天之內拿給我呢？",
          "sc": "所以能否大概在<gamevalue GAME_VALUE_TALK_NUM>天之内拿给我呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 151875,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん無理にとは言いませんけど……",
          "tc": "當然我也不會勉強你……",
          "sc": "当然我也不会勉强你……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 151882,
          "spk": "莲实 (ハスミ)",
          "ja": "こちら気に留めていただけると助かります",
          "tc": "只要你能稍微幫忙留意一下，我就很感激了。",
          "sc": "只要你能稍微帮忙留意一下，我就很感激了。"
        }
      ]
    },
