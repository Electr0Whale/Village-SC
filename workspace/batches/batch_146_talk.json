          "f_idx": 6,
          "pidx_tc": 152004,
          "spk": "莲实 (ハスミ)",
          "ja": "よろしくお願いします",
          "tc": "那麼就麻煩你了。",
          "sc": "那么就麻烦你了。"
        }
      ]
