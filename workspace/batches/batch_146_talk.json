  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2616,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_4231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68608,
          "spk": "裕太 (ユータ)",
          "ja": "家で鍋が食べたいから",
          "tc": "因為想在家裡吃火鍋，",
          "sc": "因为想在家里吃火锅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68615,
          "spk": "裕太 (ユータ)",
          "ja": "一人用の土鍋を作ろうと思ってるんだ",
          "tc": "所以我打算做一個獨享砂鍋。",
          "sc": "所以我打算做一个独享砂锅。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 68633,
          "spk": "裕太 (ユータ)",
          "ja": "どんなデザインにしようかな",
          "tc": "該怎麼設計好呢。",
          "sc": "该怎么设计好呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2617,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_4232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68657,
          "spk": "裕太 (ユータ)",
          "ja": "夜にソファでゆっくりする時間って",
          "tc": "晚上在沙發上放鬆的時間，",
          "sc": "晚上在沙发上放松的时间，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68664,
          "spk": "裕太 (ユータ)",
          "ja": "今日動かした体を明日に向けて、",
          "tc": "其實是為了明天，",
          "sc": "其实是为了明天，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68671,
          "spk": "裕太 (ユータ)",
          "ja": "ゆっくりチューニングする時間だと思うんだ",
          "tc": "在慢慢恢復今天勞動後的身體吧。",
          "sc": "在慢慢恢复今天劳动后的身体吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2618,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68695,
          "spk": "裕太 (ユータ)",
          "ja": "早朝はちょっとみぞれっぽかったんだけど",
          "tc": "今天早上雖然有點雨夾雪，",
          "sc": "今天早上虽然有点雨夹雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68702,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんとした雪になったね",
          "tc": "但現在變成真正的雪了。",
          "sc": "但现在变成真正的雪了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68713,
          "spk": "裕太 (ユータ)",
          "ja": "この感じだと牡丹雪になりそうだよ",
          "tc": "這樣感覺可以看到大粒的牡丹雪呢。",
          "sc": "这样感觉可以看到大粒的牡丹雪呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2619,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68744,
          "spk": "裕太 (ユータ)",
          "ja": "いいことを教えてあげる、<player>",
          "tc": "<player>，告訴你一件好事，",
          "sc": "<player>，告诉你一件好事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68755,
          "spk": "裕太 (ユータ)",
          "ja": "冬の朝は日陰を選んで歩くんだ",
          "tc": "冬天早上如果挑有陰影的地方走，",
          "sc": "冬天早上如果挑有阴影的地方走，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68762,
          "spk": "裕太 (ユータ)",
          "ja": "うまくいくと、霜柱をたくさん踏めるよ",
          "tc": "運氣好的話可以踩到很多霜柱喔。",
          "sc": "运气好的话可以踩到很多霜柱哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2620,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68793,
          "spk": "裕太 (ユータ)",
          "ja": "今日は木を観察する日にしてもいいな",
          "tc": "今天來好好觀察樹木也不錯。",
          "sc": "今天来好好观察树木也不错。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68811,
          "spk": "裕太 (ユータ)",
          "ja": "ほら、冬って葉っぱが少ないから",
          "tc": "你看，因為冬天的樹葉很少，",
          "sc": "你看，因为冬天的树叶很少，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 68818,
          "spk": "裕太 (ユータ)",
          "ja": "枝の形がよく見えて面白いんだよ",
          "tc": "可以清楚看到樹枝的形狀，很有趣喔。",
          "sc": "可以清楚看到树枝的形状，很有趣哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2621,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68849,
          "spk": "裕太 (ユータ)",
          "ja": "さっき、何かの足跡を見かけたよ",
          "tc": "我剛剛看到了某種生物的足跡喔！",
          "sc": "我刚刚看到了某种生物的足迹哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68856,
          "spk": "裕太 (ユータ)",
          "ja": "なんの動物だったんだろう……",
          "tc": "不知道是什麼動物……",
          "sc": "不知道是什么动物……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68863,
          "spk": "裕太 (ユータ)",
          "ja": "コマコちゃんなら分かるかな？",
          "tc": "如果問駒子，她會知道嗎？",
          "sc": "如果问驹子，她会知道吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2622,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68887,
          "spk": "裕太 (ユータ)",
          "ja": "これだけ冷えると、水道管をいかに",
          "tc": "這麼冷的天氣，",
          "sc": "这么冷的天气，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68894,
          "spk": "裕太 (ユータ)",
          "ja": "凍らせないかが大事になってくるよね",
          "tc": "確保水管不會結凍很重要呢。",
          "sc": "确保水管不会结冻很重要呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68905,
          "spk": "裕太 (ユータ)",
          "ja": "冬は蛇口を緩めておくんだって",
          "tc": "聽說冬天要把水龍頭稍微打開才行。",
          "sc": "听说冬天要把水龙头稍微打开才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2623,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68936,
          "spk": "裕太 (ユータ)",
          "ja": "アスファルトじゃない道を歩くのって",
          "tc": "一開始走在不是柏油路的道路上，",
          "sc": "一开始走在不是柏油路的道路上，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68943,
          "spk": "裕太 (ユータ)",
          "ja": "最初はけっこう疲れたんだけどね",
          "tc": "其實還滿累人的。",
          "sc": "其实还满累人的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 68954,
          "spk": "裕太 (ユータ)",
          "ja": "今は、こっちのほうが足に優しく感じるよ",
          "tc": "但我現在感覺這樣對腳比較沒有負擔呢。",
          "sc": "但我现在感觉这样对脚比较没有负担呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2624,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 68985,
          "spk": "裕太 (ユータ)",
          "ja": "手、かじかんできちゃったな……",
          "tc": "我的手開始凍僵了……",
          "sc": "我的手开始冻僵了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 68992,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんと手袋してくればよかったよ",
          "tc": "早知道就戴手套出門了。",
          "sc": "早知道就戴手套出门了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69003,
          "spk": "裕太 (ユータ)",
          "ja": "帰ったらハンドクリーム塗らないとね",
          "tc": "回去得好好塗一下護手霜了。",
          "sc": "回去得好好涂一下护手霜了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2625,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69034,
          "spk": "裕太 (ユータ)",
          "ja": "寒いと、息が白いのが楽しくて",
          "tc": "冷的時候吐出白色的氣息很好玩，",
          "sc": "冷的时候吐出白色的气息很好玩，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69041,
          "spk": "裕太 (ユータ)",
          "ja": "何度も息を吐いちゃうよね",
          "tc": "會忍不住一直呼氣呢。",
          "sc": "会忍不住一直呼气呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69059,
          "spk": "裕太 (ユータ)",
          "ja": "きっと、年を取っても楽しいんだろうな",
          "tc": "就算上了年紀，一定也會覺得很有趣吧。",
          "sc": "就算上了年纪，一定也会觉得很有趣吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2626,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69090,
          "spk": "裕太 (ユータ)",
          "ja": "雪がしんしん降るって",
          "tc": "不覺得「雪靜靜地下」",
          "sc": "不觉得“雪静静地下”"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69097,
          "spk": "裕太 (ユータ)",
          "ja": "こういうことかって思わない？",
          "tc": "就是這種感覺嗎？",
          "sc": "就是这种感觉吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69108,
          "spk": "裕太 (ユータ)",
          "ja": "自分の足音以外、何も聞こえないよ",
          "tc": "除了自己的腳步聲以外，什麼都聽不到。",
          "sc": "除了自己的脚步声以外，什么都听不到。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2627,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69139,
          "spk": "裕太 (ユータ)",
          "ja": "体の芯まで冷えてきた気がする……",
          "tc": "感覺連體內都開始變冷了……",
          "sc": "感觉连体内都开始变冷了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69157,
          "spk": "裕太 (ユータ)",
          "ja": "帰ったら焼き芋を作って熱いお茶と一緒に……",
          "tc": "回去之後要烤個地瓜，配熱茶一起……",
          "sc": "回去之后要烤个红薯，配热茶一起……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 69175,
          "spk": "裕太 (ユータ)",
          "ja": "……あっ、サツマイモ切らしてるんだった",
          "tc": "……啊！地瓜好像已經吃完了！",
          "sc": "……啊！红薯好像已经吃完了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2628,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69206,
          "spk": "裕太 (ユータ)",
          "ja": "うう……寒い……暗い……怖い……",
          "tc": "嗚嗚……好冷……好黑……好可怕……",
          "sc": "呜呜……好冷……好黑……好可怕……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69213,
          "spk": "裕太 (ユータ)",
          "ja": "暗い上に寒いなんてあんまりだ……",
          "tc": "又黑又冷的真是太過分了……",
          "sc": "又黑又冷的真是太过分了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69220,
          "spk": "裕太 (ユータ)",
          "ja": "春が待ち遠しいよ……",
          "tc": "好希望春天趕快來喔……",
          "sc": "好希望春天赶快来哦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2629,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_WALK_20_111_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69244,
          "spk": "裕太 (ユータ)",
          "ja": "今夜はとりわけ星が綺麗だね",
          "tc": "今晚的星星特別美呢，",
          "sc": "今晚的星星特别美呢，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69262,
          "spk": "裕太 (ユータ)",
          "ja": "星座の成り立ちを知ってると",
          "tc": "如果了解星座的由來，",
          "sc": "如果了解星座的由来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69269,
          "spk": "裕太 (ユータ)",
          "ja": "冬の空を見るのが楽しくなるよ",
          "tc": "觀賞冬天的星空就會更有樂趣喔。",
          "sc": "观赏冬天的星空就会更有乐趣哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2630,
      "rec_id": "TALK_ID_YOUNG_MAN_BIRTHDAY_20_111_5000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69293,
          "spk": "裕太 (ユータ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69300,
          "spk": "裕太 (ユータ)",
          "ja": "今日はおめでたい日だね！",
          "tc": "今天是個值得慶祝的日子呢！",
          "sc": "今天是值得庆祝的日子呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69311,
          "spk": "裕太 (ユータ)",
          "ja": "キミの誕生日を聞いた時から、",
          "tc": "從得知你生日的那一刻起，",
          "sc": "从得知你生日的那一刻起，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69318,
          "spk": "裕太 (ユータ)",
          "ja": "何かプレゼントしたいなって",
          "tc": "我就一直在想",
          "sc": "我就一直在想"
        },
        {
          "f_idx": 4,
          "pidx_tc": 69325,
          "spk": "裕太 (ユータ)",
          "ja": "ずっと考えててね……",
          "tc": "該送你什麼禮物才好……",
          "sc": "该送你什么礼物才好……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 69336,
          "spk": "裕太 (ユータ)",
          "ja": "ここはやっぱり、",
          "tc": "我想了想，覺得這種時候",
          "sc": "我想了想，觉得这种时候"
        },
        {
          "f_idx": 6,
          "pidx_tc": 69343,
          "spk": "裕太 (ユータ)",
          "ja": "手作りの何かがいいと思って",
          "tc": "果然還是送親手做的東西比較好，",
          "sc": "果然还是送亲手做的东西比较好，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 69350,
          "spk": "裕太 (ユータ)",
          "ja": "大作に取りかかったんだよ",
          "tc": "所以就著手挑戰了一件大作。",
          "sc": "所以就着手挑战了一件大作。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 69361,
          "spk": "裕太 (ユータ)",
          "ja": "何度か失敗したけど、",
          "tc": "雖然失敗了好幾次，",
          "sc": "虽然失败了好几次，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 69368,
          "spk": "裕太 (ユータ)",
          "ja": "なんとか間に合ってよかったよ",
          "tc": "但能趕上真是太好了。",
          "sc": "但能赶上真是太好了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 69375,
          "spk": "裕太 (ユータ)",
          "ja": "はい、これ！",
          "tc": "來，這個給你！",
          "sc": "来，这个给你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2631,
      "rec_id": "TALK_ID_YOUNG_MAN_BIRTHDAY_20_111_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69399,
          "spk": "裕太 (ユータ)",
          "ja": "茶道用の茶碗だよ",
          "tc": "是茶道用的茶碗喔。",
          "sc": "是茶道用的茶碗哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69406,
          "spk": "裕太 (ユータ)",
          "ja": "見てよ、この色合い",
          "tc": "你看，",
          "sc": "你看，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69413,
          "spk": "裕太 (ユータ)",
          "ja": "美しいだろう？",
          "tc": "這個色澤很美吧？",
          "sc": "这个色泽很美吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69424,
          "spk": "裕太 (ユータ)",
          "ja": "納得のいく色が出るまで頑張ったんだ",
          "tc": "為了做出理想的色澤，我可是下了不少工夫。",
          "sc": "为了做出理想的色泽，我可是下了不少工夫。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 69431,
          "spk": "裕太 (ユータ)",
          "ja": "キミにはこれでお茶を点ててほしいな",
          "tc": "希望你能用這個來點茶。",
