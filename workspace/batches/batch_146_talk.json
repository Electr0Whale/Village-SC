      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152075,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152082,
          "spk": "莲实 (ハスミ)",
