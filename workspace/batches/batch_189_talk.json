      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4329,
      "rec_id": "TALK_ID_10_0302_022_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251556,
          "spk": "帷 (トバリ)",
          "ja": "リンの監視から、",
