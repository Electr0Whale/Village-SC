        {
          "f_idx": 1,
          "pidx_tc": 250146,
          "spk": "名护 (ナゴ)",
          "ja": "まだ了承した訳じゃないが……",
          "tc": "我都還沒答應吧……",
          "sc": "我都还没答应吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250159,
          "spk": "林 (リン)",
          "ja": "あなたも知っていると思うけど、",
