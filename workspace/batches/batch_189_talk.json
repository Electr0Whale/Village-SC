        {
          "f_idx": 4,
          "pidx_tc": 251455,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そうだけど……",
          "tc": "是、是這樣沒錯……",
          "sc": "是、是这样没错……"
        }
