        {
          "f_idx": 6,
          "pidx_tc": 250191,
          "spk": "林 (リン)",
          "ja": "村の歴史や伝説についての資料を",
          "tc": "保管村子歷史和傳說等資料的",
          "sc": "保管村子历史和传说等资料的"
        },
        {
          "f_idx": 7,
          "pidx_tc": 250198,
          "spk": "林 (リン)",
          "ja": "保管している図書館なの",
          "tc": "圖書館喔。",
          "sc": "图书馆哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 250211,
          "spk": "名护 (ナゴ)",
          "ja": "……本当に貴重な資料だと思っているのか？",
          "tc": "……你們真的有把那當作貴重的資料嗎？",
          "sc": "……你们真的有把那当作贵重的资料吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 250218,
          "spk": "名护 (ナゴ)",
          "ja": "信じられないほど、",
          "tc": "那裡可是",
          "sc": "那里可是"
        },
        {
          "f_idx": 10,
          "pidx_tc": 250225,
          "spk": "名护 (ナゴ)",
          "ja": "ずさんな管理をされていたが……",
          "tc": "雜亂到難以置信的地步啊……",
          "sc": "杂乱到难以置信的地步啊……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 250238,
          "spk": "林 (リン)",
          "ja": "これからはナゴが図書館を開けてくれるから、",
          "tc": "今後會由名護負責開放圖書館，",
          "sc": "今后会由名护负责开放图书馆，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 250245,
          "spk": "林 (リン)",
          "ja": "あなたも気が向いたら、",
