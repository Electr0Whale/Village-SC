          "tc": "跑到哪裡去了呢……？",
          "sc": "跑到哪里去了呢……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251356,
          "spk": "帷 (トバリ)",
          "ja": "ここで見失ったの？",
          "tc": "是在這裡跟丟了嗎？",
          "sc": "是在这里跟丢了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 251369,
