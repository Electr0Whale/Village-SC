          "pidx_tc": 250736,
          "spk": "驹子 (コマコ)",
          "ja": "<player>はまだ子どもだし……",
          "tc": "<player>還只是小孩……",
          "sc": "<player>还只是小孩……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250747,
          "spk": "驹子 (コマコ)",
          "ja": "……暗いし、",
          "tc": "……這裡又很暗，",
          "sc": "……这里又很暗，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250754,
          "spk": "驹子 (コマコ)",
          "ja": "お化けも出るし、危ないし",
          "tc": "又有妖怪出沒，很危險的。",
          "sc": "又有妖怪出没，很危险的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250767,
          "spk": "帷 (トバリ)",
          "ja": "わざわざ私たちを追いかけてくるようなヤツが、",
          "tc": "這傢伙都特地追著我們跑來了，",
          "sc": "这家伙都特地追着我们跑来了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250774,
          "spk": "帷 (トバリ)",
          "ja": "深夜を怖がるとは思えないけど？",
          "tc": "我可不覺得他會害怕深夜喔。",
          "sc": "我可不觉得他会害怕深夜。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 250794,
          "spk": "驹子 (コマコ)",
          "ja": "で……でも……",
          "tc": "可……可是……",
          "sc": "可……可是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4318,
      "rec_id": "TALK_ID_10_0302_021_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250814,
          "spk": "帷 (トバリ)",
          "ja": "あのね、コマコはヨウに頼まれて、",
          "tc": "我跟你說，駒子是因為洋的拜託，",
          "sc": "我跟你说，驹子是因为洋的拜托，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250821,
          "spk": "帷 (トバリ)",
          "ja": "ニワトリの幽霊を探しているのよ",
          "tc": "正在尋找雞的幽靈。",
          "sc": "正在寻找鸡的幽灵。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250832,
          "spk": "帷 (トバリ)",
          "ja": "アンタの庭の鶏小屋で飼っていた、",
          "tc": "就是養在你庭院雞舍裡的",
          "sc": "就是养在你庭院鸡舍里的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250839,
          "spk": "帷 (トバリ)",
          "ja": "あのピロっていうニワトリ……",
          "tc": "那隻叫做嗶羅的雞……",
          "sc": "那只叫做哔罗的鸡……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250846,
          "spk": "帷 (トバリ)",
          "ja": "急にいなくなったの、覚えてるでしょ？",
          "tc": "你還記得牠突然不見了吧？",
          "sc": "你还记得它突然不见了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4319,
      "rec_id": "TALK_ID_10_0302_021_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250934,
          "spk": "帷 (トバリ)",
          "ja": "そんなの、この土地には",
          "tc": "在這片土地上",
          "sc": "在这片土地上"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250941,
          "spk": "帷 (トバリ)",
          "ja": "似たようなものがたくさんいるじゃない",
          "tc": "類似的東西都見怪不怪了吧。",
          "sc": "类似的东西都见怪不怪了吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250948,
          "spk": "帷 (トバリ)",
          "ja": "放っておけばいいものを……",
          "tc": "放著別管不就好了……",
          "sc": "放着别管不就好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4320,
      "rec_id": "TALK_ID_10_0302_021_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250966,
          "spk": "驹子 (コマコ)",
          "ja": "だ、ダメだよ……",
          "tc": "不、不行啦……",
          "sc": "不、不行啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250973,
          "spk": "驹子 (コマコ)",
          "ja": "幽霊を弔わずにいると、",
          "tc": "如果不弔祭幽靈，",
          "sc": "如果不吊祭幽灵，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250980,
          "spk": "驹子 (コマコ)",
          "ja": "やがて怨霊になっちゃうらしいし……",
          "tc": "據說最後會化為怨靈……",
          "sc": "据说最后会化为怨灵……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250991,
          "spk": "驹子 (コマコ)",
          "ja": "さらに時間が経つと、",
          "tc": "如果再繼續放任不管，",
          "sc": "如果再继续放任不管，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250998,
          "spk": "驹子 (コマコ)",
          "ja": "<strong>タタリ神</strong>と呼ばれる<strong>人を呪う怪異</strong>に",
          "tc": "還會變成<strong>能夠詛咒人</strong>的<strong>祟神</strong>，",
          "sc": "还会变成<strong>能够诅咒人</strong>的<strong>祟神</strong>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 251005,
          "spk": "驹子 (コマコ)",
          "ja": "なってしまうと言われているし……",
          "tc": "大家都這麼說……",
          "sc": "大家都这么说……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 251018,
          "spk": "帷 (トバリ)",
          "ja": "またそんな古臭い言い伝えを、",
          "tc": "又在大言不慚地講那些",
          "sc": "又在大言不惭地讲那些"
        },
        {
          "f_idx": 7,
          "pidx_tc": 251025,
          "spk": "帷 (トバリ)",
          "ja": "恥ずかしげもなく話して……",
          "tc": "老掉牙的傳說故事了……",
          "sc": "老掉牙的传说故事了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 251036,
          "spk": "帷 (トバリ)",
          "ja": "それにタタリ神って……あのニワトリが？",
          "tc": "而且妳說祟神……那隻雞行嗎？",
          "sc": "而且你说祟神……那只鸡行吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 251043,
          "spk": "帷 (トバリ)",
          "ja": "……いっそ見てみたいわ",
          "tc": "……我倒想親眼看看。",
          "sc": "……我倒想亲眼看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4321,
      "rec_id": "TALK_ID_10_0302_021_09",
      "lines": [
        {
