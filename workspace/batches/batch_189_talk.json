      "rec_id": "TALK_ID_10_0302_021_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251223,
          "spk": "驹子 (コマコ)",
          "ja": "あ！　いたよ！",
          "tc": "啊！看到了！",
