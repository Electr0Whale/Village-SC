          "ja": "だから、この道のことは",
          "tc": "所以，妳可別把這條路",
          "sc": "所以，你可别把这条路"
        },
        {
          "f_idx": 6,
          "pidx_tc": 251606,
          "spk": "帷 (トバリ)",
          "ja": "誰にも言わないでよね",
          "tc": "告訴別人喔。",
          "sc": "告诉别人。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 251619,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……う、うん",
          "tc": "咦……呃、嗯，",
