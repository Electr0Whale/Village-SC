{
  "batch_id": "batch_189_talk",
  "group": "talk",
  "files": [
    "talk.dat"
  ],
  "record_count": 42,
  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4292,
      "rec_id": "TALK_ID_10_0301_016_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249239,
          "spk": "木助 (キスケ)",
          "ja": "<player>、てめぇも身に覚えがあるだろ",
          "tc": "<player>，你應該也還記得吧。",
          "sc": "<player>，你应该也还记得吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249246,
          "spk": "木助 (キスケ)",
          "ja": "彼ヶ津村の一員になるために、",
          "tc": "你為了成為彼津村的一員，",
          "sc": "你为了成为彼津村的一员，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249253,
          "spk": "木助 (キスケ)",
          "ja": "<strong>大切に育てた作物</strong>を捧げたことを",
          "tc": "獻祭了自己<strong>用心培育的作物</strong>的那件事。",
          "sc": "献祭了自己<strong>用心培育的作物</strong>的那件事。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249264,
          "spk": "木助 (キスケ)",
          "ja": "この土地にはな、むかしから",
          "tc": "自古以來，這片土地",
          "sc": "自古以来，这片土地"
        },
        {
          "f_idx": 4,
          "pidx_tc": 249271,
          "spk": "木助 (キスケ)",
          "ja": "<strong>「とても気難しい」神さま</strong>が住んでるんだ",
          "tc": "就居住著一位<strong>「很難伺候」的神明大人</strong>。",
          "sc": "就居住着一位<strong>“很难伺候”的神明大人</strong>。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 249282,
          "spk": "木助 (キスケ)",
          "ja": "その神さまは落とした物を、",
          "tc": "那位神明大人會將掉落在村裡的東西",
          "sc": "那位神明大人会将掉落在村里的东西"
        },
        {
          "f_idx": 6,
          "pidx_tc": 249289,
          "spk": "木助 (キスケ)",
          "ja": "「落とし主からの捧げ物」だと思い込んで",
          "tc": "當作是「失主獻上的祭品」",
          "sc": "当作是“失主献上的祭品”"
        },
        {
          "f_idx": 7,
          "pidx_tc": 249296,
          "spk": "木助 (キスケ)",
          "ja": "受け取っちまうらしいな",
          "tc": "並收為己有。",
          "sc": "并收为己有。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 249309,
          "spk": "名护 (ナゴ)",
          "ja": "んな……何を勝手に！",
          "tc": "什麼……那也太不講道理了！",
          "sc": "什么……那也太不讲道理了！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 249316,
          "spk": "名护 (ナゴ)",
          "ja": "俺は大切な財布をその土地の神とやらに、",
          "tc": "我可沒有要把自己重要的錢包",
          "sc": "我可没有要把自己重要的钱包"
        },
        {
          "f_idx": 10,
          "pidx_tc": 249323,
          "spk": "名护 (ナゴ)",
          "ja": "捧げた覚えはないぞ……！",
          "tc": "獻給那個什麼土地神欸……！",
          "sc": "献给那个什么土地神诶……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4293,
      "rec_id": "TALK_ID_10_0301_016_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249341,
          "spk": "木助 (キスケ)",
          "ja": "そうさ、わざと捧げようが、",
          "tc": "沒錯，無論是有意的獻祭，",
          "sc": "没错，无论是有意的献祭，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249348,
          "spk": "木助 (キスケ)",
          "ja": "うっかり落とそうが関係ねえ",
          "tc": "還是無意的遺失，結果都無所謂。",
          "sc": "还是无意的遗失，结果都无所谓。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249359,
          "spk": "木助 (キスケ)",
          "ja": "出られなくなるのは、",
          "tc": "沒辦法離開村子這件事，",
          "sc": "没办法离开村子这件事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249366,
          "spk": "木助 (キスケ)",
          "ja": "曖昧だが簡単に言うと、",
          "tc": "雖然有點模糊，但簡單來說，",
          "sc": "虽然有点模糊，但简单来说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 249373,
          "spk": "木助 (キスケ)",
          "ja": "<strong>「呪い」</strong>みてぇなもんだ",
          "tc": "就是類似<strong>「詛咒」</strong>的東西。",
          "sc": "就是类似<strong>“诅咒”</strong>的东西。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 249384,
          "spk": "木助 (キスケ)",
          "ja": "落とし物の持ち主は、この土地に一本……",
          "tc": "遺失物的失主會與這片土地牽上一條……",
          "sc": "遗失物的失主会与这片土地牵上一条……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 249391,
          "spk": "木助 (キスケ)",
          "ja": "「しがらみ」として太い糸でつながれちまう",
          "tc": "名為「糾葛」的粗繩。",
          "sc": "名为“纠葛”的粗绳。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 249398,
          "spk": "木助 (キスケ)",
          "ja": "切ろうとしても、そう簡単には切れねえ",
          "tc": "就算想切斷，也沒有那麼容易。",
          "sc": "就算想切断，也没有那么容易。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 249411,
          "spk": "名护 (ナゴ)",
          "ja": "待てよ！",
          "tc": "等一下！",
          "sc": "等一下！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 249418,
          "spk": "名护 (ナゴ)",
          "ja": "俺は財布をなくしただけで……！",
          "tc": "我只是弄丟了錢包欸……！",
          "sc": "我只是弄丢了钱包诶……！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 249431,
          "spk": "木助 (キスケ)",
          "ja": "気の毒だが、もうしがらみはできちまってる",
          "tc": "很遺憾，但你就是已經產生了糾葛。",
          "sc": "很遗憾，但你就是已经产生了纠葛。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 249438,
          "spk": "木助 (キスケ)",
          "ja": "この土地は、てめぇを逃がすつもりはねえよ",
          "tc": "這片土地並不打算放過你。",
          "sc": "这片土地并不打算放过你。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 249458,
          "spk": "名护 (ナゴ)",
          "ja": "そんな……じゃああの財布は、",
          "tc": "怎麼會……那麼那個錢包",
          "sc": "怎么会……那么那个钱包"
        },
        {
          "f_idx": 14,
          "pidx_tc": 249465,
          "spk": "名护 (ナゴ)",
          "ja": "もう二度と戻ってこないのか……？",
          "tc": "再也拿不回來了嗎……？",
          "sc": "再也拿不回来了吗……？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 249478,
          "spk": "四郎治 (シロージ)",
          "ja": "そんなに大切なものなのか？",
          "tc": "它對你來說有這麼重要？",
          "sc": "它对你来说有这么重要？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 249485,
          "spk": "四郎治 (シロージ)",
          "ja": "ちなみに、いくらくらい入れてたんだよ",
          "tc": "順便問一下，裡面是放了多少錢？",
          "sc": "顺便问一下，里面是放了多少钱？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4294,
      "rec_id": "TALK_ID_10_0301_016_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249503,
          "spk": "名护 (ナゴ)",
          "ja": "１０万円……",
          "tc": "十萬元……",
          "sc": "十万元……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249518,
          "spk": "四郎治 (シロージ)",
          "ja": "……マジかよ",
          "tc": "……真的假的。",
          "sc": "……真的假的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249525,
          "spk": "四郎治 (シロージ)",
          "ja": "街の人間はいつも、",
          "tc": "城裡的人隨時都會在錢包裡",
          "sc": "城里的人随时都会在钱包里"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249532,
          "spk": "四郎治 (シロージ)",
          "ja": "そんな大金を財布に入れてんのか",
          "tc": "放這麼多錢啊？",
          "sc": "放这么多钱啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4295,
      "rec_id": "TALK_ID_10_0301_016_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249550,
          "spk": "名护 (ナゴ)",
          "ja": "さっきの話だと、財布を取り戻したら",
          "tc": "照剛剛說的，要是我能拿回錢包，",
          "sc": "照刚刚说的，要是我能拿回钱包，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249557,
          "spk": "名护 (ナゴ)",
          "ja": "村から出られる可能性があるってことだろう？",
          "tc": "就有可能能夠離開村子了吧？",
          "sc": "就有可能能够离开村子了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249564,
          "spk": "名护 (ナゴ)",
          "ja": "夜に探せば、見つかるのか……？",
          "tc": "晚上出去找找，就會找到嗎……？",
          "sc": "晚上出去找找，就会找到吗……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249577,
          "spk": "木助 (キスケ)",
          "ja": "やめとけ、やめとけ",
          "tc": "別想了、別想了。",
          "sc": "别想了、别想了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 249584,
          "spk": "木助 (キスケ)",
          "ja": "次は辻で倒れるどころじゃすまねぇぜ",
          "tc": "下次可就不會是倒在岔路這麼簡單的事了。",
          "sc": "下次可就不会是倒在岔路这么简单的事了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 249604,
          "spk": "名护 (ナゴ)",
          "ja": "そ、そんなに危険なのか？",
          "tc": "有、有那麼危險嗎？",
          "sc": "有、有那么危险吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 249617,
          "spk": "四郎治 (シロージ)",
          "ja": "でもさ、ナゴさん、結構探したんだろ？",
          "tc": "名護先生已經找很久了吧？",
          "sc": "名护先生已经找很久了吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 249626,
          "spk": "四郎治 (シロージ)",
          "ja": "そこまで探して見つからないなら、",
          "tc": "但找成那樣都找不到的話，",
          "sc": "但找成那样都找不到的话，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 249633,
          "spk": "四郎治 (シロージ)",
          "ja": "神じゃなくて、キツネか何かに",
          "tc": "或許拿走的不是神明，",
          "sc": "或许拿走的不是神明，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 249640,
          "spk": "四郎治 (シロージ)",
          "ja": "持ち去られているかもしれないぜ",
          "tc": "可能是被狐狸或者其他東西帶走了。",
          "sc": "可能是被狐狸或者其他东西带走了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 249651,
          "spk": "四郎治 (シロージ)",
          "ja": "それなら、夜に探してもムダかもしれん",
          "tc": "那樣的話，在晚上怎麼找都無濟於事。",
          "sc": "那样的话，在晚上怎么找都无济于事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4296,
      "rec_id": "TALK_ID_10_0301_016_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249676,
          "spk": "名护 (ナゴ)",
          "ja": "だからって諦められないだろ！",
          "tc": "就算這樣，我也不能放棄啊！",
          "sc": "就算这样，我也不能放弃啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4297,
      "rec_id": "TALK_ID_10_0301_016_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249694,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、お前、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249701,
          "spk": "四郎治 (シロージ)",
          "ja": "普段からあちこち走り回ってるだろ？",
          "tc": "你平常不是都到處跑嗎？",
          "sc": "你平常不是都到处跑吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249708,
          "spk": "四郎治 (シロージ)",
          "ja": "ついでに、探してやったらどうだ",
          "tc": "不如順便幫忙找？",
          "sc": "不如顺便帮忙找？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4298,
      "rec_id": "TALK_ID_10_0301_016_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249726,
          "spk": "木助 (キスケ)",
          "ja": "はあ？",
          "tc": "啊？",
          "sc": "啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249733,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが探してやれよ",
          "tc": "你去找啦。",
          "sc": "你去找啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249740,
          "spk": "木助 (キスケ)",
          "ja": "こいつに頼むな",
          "tc": "別拜託這傢伙。",
          "sc": "别拜托这家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4299,
      "rec_id": "TALK_ID_10_0301_016_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249758,
          "spk": "四郎治 (シロージ)",
          "ja": "だって、一日中山を歩く俺でも",
          "tc": "畢竟連整天都在山裡行走的我",
          "sc": "毕竟连整天都在山里行走的我"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249765,
          "spk": "四郎治 (シロージ)",
          "ja": "見つからねえし",
          "tc": "都找不到了。",
          "sc": "都找不到了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249778,
          "spk": "名护 (ナゴ)",
          "ja": "……<player>さん、シロージくん",
          "tc": "……<player>、四郎治，",
          "sc": "……<player>、四郎治，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249787,
          "spk": "名护 (ナゴ)",
          "ja": "見つけてくれたら、お礼に",
          "tc": "只要你們能找到，作為謝禮，",
          "sc": "只要你们能找到，作为谢礼，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 249794,
          "spk": "名护 (ナゴ)",
          "ja": "財布の中身は全額渡す",
          "tc": "錢包裡所有的錢就都送給你們。",
          "sc": "钱包里所有的钱就都送给你们。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 249801,
          "spk": "名护 (ナゴ)",
          "ja": "だから、探すのを手伝ってくれ",
          "tc": "所以，拜託幫我找錢包吧。",
          "sc": "所以，拜托帮我找钱包吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4300,
      "rec_id": "TALK_ID_10_0301_016_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249819,
          "spk": "四郎治 (シロージ)",
          "ja": "マジかよ",
          "tc": "真的假的。",
          "sc": "真的假的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249830,
          "spk": "四郎治 (シロージ)",
          "ja": "なら……もうちょっとだけ",
          "tc": "那……我就再稍微",
          "sc": "那……我就再稍微"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249837,
          "spk": "四郎治 (シロージ)",
          "ja": "探してやってもいいぜ",
          "tc": "幫忙找一下吧。",
          "sc": "帮忙找一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4301,
      "rec_id": "TALK_ID_10_0301_100_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249867,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249874,
          "spk": "林 (リン)",
          "ja": "ちょっと、あなたに用事があって来たのよ",
          "tc": "我有事要找你。",
          "sc": "我有事要找你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249885,
          "spk": "林 (リン)",
          "ja": "ところで、あなたはこの人を覚えてる？",
          "tc": "你還記得這個人嗎？",
          "sc": "你还记得这个人吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249892,
          "spk": "林 (リン)",
          "ja": "ナゴって言うんだけど……",
          "tc": "他叫名護……",
          "sc": "他叫名护……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4302,
      "rec_id": "TALK_ID_10_0301_100_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249910,
          "spk": "名护 (ナゴ)",
          "ja": "あ……や、やぁ……",
          "tc": "啊……嗨……",
          "sc": "啊……嗨……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249917,
          "spk": "名护 (ナゴ)",
          "ja": "こんにちは……突然来てすまないね……",
          "tc": "你好啊……抱歉這麼突然來訪……",
          "sc": "你好啊……抱歉这么突然来访……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 249937,
          "spk": "林 (リン)",
          "ja": "この人、いろいろあって、",
          "tc": "因為發生了一些事，",
          "sc": "因为发生了一些事，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 249944,
          "spk": "林 (リン)",
          "ja": "今日から村に住むことになったから",
          "tc": "這個人從今天起就要住在村子裡了。",
          "sc": "这个人从今天起就要住在村子里了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 249951,
          "spk": "林 (リン)",
          "ja": "あなたも村の一員として、仲良くしてちょうだい",
          "tc": "你身為這個村子的一員，要好好跟他相處喔。",
          "sc": "你身为这个村子的一员，要好好跟他相处哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4303,
      "rec_id": "TALK_ID_10_0301_100_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 249969,
          "spk": "林 (リン)",
          "ja": "ほら、ナゴ",
          "tc": "好了，名護，",
          "sc": "好了，名护，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 249976,
          "spk": "林 (リン)",
          "ja": "あなたもいつまで不機嫌な顔してるのかしら",
          "tc": "你要擺那臭臉到什麼時候啊？",
          "sc": "你要摆那臭脸到什么时候啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 249983,
          "spk": "林 (リン)",
          "ja": "ちゃんと挨拶でもしたらどう？",
          "tc": "還不跟人家好好打聲招呼？",
          "sc": "还不跟人家好好打声招呼？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4304,
      "rec_id": "TALK_ID_10_0301_100_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250001,
          "spk": "名护 (ナゴ)",
          "ja": "いや……これは睨んでいるわけじゃ……",
          "tc": "不……我並不是在瞪人……",
          "sc": "不……我并不是在瞪人……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4305,
      "rec_id": "TALK_ID_10_0301_100_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250021,
          "spk": "名护 (ナゴ)",
          "ja": "えっと……すまない",
          "tc": "呃……抱歉，",
          "sc": "呃……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250028,
          "spk": "名护 (ナゴ)",
          "ja": "これは、メガネをなくしてしまってね……",
          "tc": "因為我弄丟了眼鏡……",
          "sc": "因为我弄丢了眼镜……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250039,
          "spk": "名护 (ナゴ)",
          "ja": "俺は目が悪いから、",
          "tc": "但我的視力很差，",
          "sc": "但我的视力很差，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250046,
          "spk": "名护 (ナゴ)",
          "ja": "目を細めないとよく見えなくて……",
          "tc": "不把眼睛瞇起來就看不清楚……",
          "sc": "不把眼睛眯起来就看不清楚……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250053,
          "spk": "名护 (ナゴ)",
          "ja": "怒っているわけじゃないから、気にしないでくれ",
          "tc": "所以並不是在生氣，請你別介意。",
          "sc": "所以并不是在生气，请你别介意。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250064,
          "spk": "名护 (ナゴ)",
          "ja": "キミには前にも自己紹介したね",
          "tc": "之前我已經向你自我介紹過了吧？",
          "sc": "之前我已经向你自我介绍过了吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 250071,
          "spk": "名护 (ナゴ)",
          "ja": "俺のことは、ナゴと呼んでくれ",
          "tc": "你就叫我名護吧。",
          "sc": "你就叫我名护吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 250082,
          "spk": "名护 (ナゴ)",
          "ja": "……これから、よろしく頼むよ",
          "tc": "……今後還請多多指教。",
          "sc": "……今后还请多多指教。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4306,
      "rec_id": "TALK_ID_10_0301_100_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250107,
          "spk": "林 (リン)",
          "ja": "ナゴには村に住み込みで、",
          "tc": "名護會住在村子裡，",
