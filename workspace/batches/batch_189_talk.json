    },
    {
      "file": "talk.dat",
      "rec_idx": 4326,
      "rec_id": "TALK_ID_10_0302_022_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251417,
          "spk": "驹子 (コマコ)",
          "ja": "ねえ、トバリ……",
          "tc": "我說，帷……",
          "sc": "我说，帷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251424,
          "spk": "驹子 (コマコ)",
          "ja": "やっぱり、昼に探しに来ようよ",
          "tc": "我們還是白天再來找吧。",
          "sc": "我们还是白天再来找吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251437,
          "spk": "帷 (トバリ)",
          "ja": "「お化けは夜じゃないと見つからない」って",
          "tc": "「只有晚上才能找到妖怪」，",
          "sc": "“只有晚上才能找到妖怪”，"
        },
        {
