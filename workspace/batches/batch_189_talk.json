    {
      "file": "talk.dat",
      "rec_idx": 4324,
      "rec_id": "TALK_ID_10_0302_021_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251283,
          "spk": "帷 (トバリ)",
          "ja": "アンタもこうして深夜に散歩してるなら、",
