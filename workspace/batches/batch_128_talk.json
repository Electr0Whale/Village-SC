  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1663,
      "rec_id": "TALK_ID_SECRETARY_SPECIAL_20_108_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 130740,
          "spk": "今野 (コンノ)",
          "ja": "……アナタ、ワタシの部屋に",
          "tc": "……距離您開始",
          "sc": "……距离您开始"
        },
        {
          "f_idx": 1,
          "pidx_tc": 130747,
          "spk": "今野 (コンノ)",
          "ja": "出入りするようになって",
          "tc": "進出我的房間，",
          "sc": "进出我的房间，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 130754,
          "spk": "今野 (コンノ)",
          "ja": "どれくらい経ちましたっけ？",
          "tc": "已經過了多久了呢？",
          "sc": "已经过了多久了呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 130765,
          "spk": "今野 (コンノ)",
          "ja": "飽きもせずに通ってきますが",
          "tc": "雖然您經常跑來，都不會嫌煩，",
          "sc": "虽然您经常跑来，都不会嫌烦，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 130772,
          "spk": "今野 (コンノ)",
          "ja": "それで満足なんですか？",
          "tc": "但這樣您就滿意了嗎？",
          "sc": "但这样您就满意了吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 130779,
          "spk": "今野 (コンノ)",
          "ja": "たまには少し変わった経験はどうですか？",
          "tc": "偶爾來點不一樣的體驗如何？",
          "sc": "偶尔来点不一样的体验如何？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 130790,
          "spk": "今野 (コンノ)",
          "ja": "いえね、客用の布団を新調したんですが",
          "tc": "其實我買了訪客用的被褥，",
          "sc": "其实我买了访客用的被褥，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 130797,
          "spk": "今野 (コンノ)",
          "ja": "あまり出番がないものでねェ",
          "tc": "但都沒什麼出場機會。",
          "sc": "但都没什么出场机会呐～。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 130804,
          "spk": "今野 (コンノ)",
          "ja": "<player>さん、使ってみませんかァ？",
          "tc": "<player>，您要不要用用看呢？",
          "sc": "<player>，您要不要用用看呢～？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 130815,
          "spk": "今野 (コンノ)",
          "ja": "新品フカフカ高級布団が気になるようなら、",
          "tc": "如果您好奇這個蓬鬆的新品高級被褥的話，",
          "sc": "如果您好奇这个蓬松的新品高级被褥的话，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 130822,
          "spk": "今野 (コンノ)",
          "ja": "今夜午後６時にワタシの部屋に来てください",
          "tc": "就請於今晚6點過來我房間吧。",
          "sc": "就请于今晚6点过来我房间吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 130829,
          "spk": "今野 (コンノ)",
          "ja": "さァ、どうします？",
          "tc": "如何啊？",
          "sc": "如何啊？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 130838,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 13,
          "pidx_tc": 130845,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1664,
      "rec_id": "TALK_ID_SECRETARY_SPECIAL_20_108_0081",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 130863,
          "spk": "今野 (コンノ)",
          "ja": "二つ返事で了承とは……",
          "tc": "竟然爽快地答應了……",
          "sc": "竟然爽快地答应了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 130870,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、本当にヒマなんですねェ",
          "tc": "看來您真的很閒呢。",
          "sc": "看来您真的很闲呐～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 130888,
          "spk": "今野 (コンノ)",
          "ja": "まァいいでしょう",
          "tc": "算了，",
          "sc": "算了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 130895,
          "spk": "今野 (コンノ)",
          "ja": "それじゃ、午後６時ですからネ",
          "tc": "那就晚上6點見了，",
          "sc": "那就晚上6点见了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 130902,
          "spk": "今野 (コンノ)",
          "ja": "時間厳守でお願いしますヨ",
          "tc": "請您務必要準時喔。",
          "sc": "请您务必要准时哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1665,
      "rec_id": "TALK_ID_SECRETARY_SPECIAL_20_108_0082",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 130924,
          "spk": "今野 (コンノ)",
          "ja": "おやァ、そうですかァ",
          "tc": "哎呀，這樣嗎？",
          "sc": "哎呀，这样吗～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 130931,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんにも一丁前に",
          "tc": "看樣子<player>您也是有一些",
          "sc": "看样子<player>您也是有一些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 130938,
          "spk": "今野 (コンノ)",
          "ja": "予定というものがあるんですネ",
          "tc": "自己的行程啊。",
          "sc": "自己的行程啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 130949,
          "spk": "今野 (コンノ)",
          "ja": "ワタシからこんなお誘いをすることは",
          "tc": "那麼雖然我可能再也不會",
          "sc": "那么虽然我可能再也不会"
        },
        {
          "f_idx": 4,
          "pidx_tc": 130956,
          "spk": "今野 (コンノ)",
          "ja": "もう二度とないかもしれませんが",
          "tc": "像這樣邀請您了，",
          "sc": "像这样邀请您了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 130963,
          "spk": "今野 (コンノ)",
          "ja": "どうぞ、気にせず過ごしてくださいねェ",
          "tc": "但就請您放寬心，不必在意了。",
          "sc": "但就请您放宽心，不必在意呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1666,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 130987,
          "spk": "今野 (コンノ)",
          "ja": "アア……オアァァ……ァァァ……",
          "tc": "啊啊……哇啊啊……啊啊啊……",
          "sc": "啊啊……哇啊啊……啊啊啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 130994,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの株がァァ……",
          "tc": "我的股票啊啊……",
          "sc": "我的股票啊啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 131001,
          "spk": "今野 (コンノ)",
          "ja": "終わったァァァァ…………",
          "tc": "完蛋啦啊啊……",
          "sc": "完蛋啦啊啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131012,
          "spk": "今野 (コンノ)",
          "ja": "……なんです？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131019,
          "spk": "今野 (コンノ)",
          "ja": "見せ物じゃないんですヨ",
          "tc": "別在這裡看戲了，",
          "sc": "别在这里看戏了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 131026,
          "spk": "今野 (コンノ)",
          "ja": "ほら、どっか行ってください",
          "tc": "快去別的地方。",
          "sc": "快去别的地方。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1667,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131050,
          "spk": "今野 (コンノ)",
          "ja": "……どうにも緊張感に欠けた",
          "tc": "……看看您這表情，",
          "sc": "……看看您这表情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131057,
          "spk": "今野 (コンノ)",
          "ja": "顔をしていますねェ",
          "tc": "還真是一點都不緊張啊。",
          "sc": "还真是一点都不紧张呐～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 131068,
          "spk": "今野 (コンノ)",
          "ja": "アナタ、今日は見学だけの",
          "tc": "您今天",
          "sc": "您今天"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131075,
          "spk": "今野 (コンノ)",
          "ja": "つもりなんですか？",
          "tc": "只打算觀摩嗎？",
          "sc": "只打算观摩吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131082,
          "spk": "今野 (コンノ)",
          "ja": "せっかくならエントリーしたらどうです？",
          "tc": "機會難得，您不報名試試嗎？",
          "sc": "机会难得，您不报名试试吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1668,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131106,
          "spk": "今野 (コンノ)",
          "ja": "ん～いい香りですねェ……",
          "tc": "嗯～真香啊……",
          "sc": "嗯～真香啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131113,
          "spk": "今野 (コンノ)",
          "ja": "外での食事なんて普段ならごめんですが",
          "tc": "要是平常，對在外用餐我可是敬謝不敏的。",
          "sc": "要是平常，对在外用餐我可是敬谢不敏的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 131120,
          "spk": "今野 (コンノ)",
          "ja": "この日は特別ですね",
          "tc": "今天是例外。",
          "sc": "今天是例外。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131131,
          "spk": "今野 (コンノ)",
          "ja": "あぁ、どうも",
          "tc": "啊，您好啊。",
          "sc": "啊，您好啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131138,
          "spk": "今野 (コンノ)",
          "ja": "これは私用に用意した特別なお茶ですヨ",
          "tc": "這是我個人專用的特別茶飲，",
          "sc": "这是我个人专用的特别茶饮，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 131145,
          "spk": "今野 (コンノ)",
          "ja": "あげませんからねェ",
          "tc": "我是不會分給您的。",
          "sc": "我是不会分给您呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1669,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131169,
          "spk": "今野 (コンノ)",
          "ja": "花見会は、彼ヶ津村の中でも",
          "tc": "賞花大會是彼津村",
          "sc": "赏花大会是彼津村"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131176,
          "spk": "今野 (コンノ)",
          "ja": "毎年の人気イベントでしてねえ",
          "tc": "每年都很受歡迎的活動。",
          "sc": "每年都很受欢迎的活动。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131194,
          "spk": "今野 (コンノ)",
          "ja": "ワタシとしては、最も桜が",
          "tc": "我自己是希望可以把",
          "sc": "我自己是希望可以把"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131201,
          "spk": "今野 (コンノ)",
          "ja": "よく見える場所を有料席に",
          "tc": "能夠最清楚看見櫻花的位子",
          "sc": "能够最清楚看见樱花的位子"
        },
        {
          "f_idx": 5,
          "pidx_tc": 131208,
          "spk": "今野 (コンノ)",
          "ja": "指定したいんですヨ",
          "tc": "設定為付費座位。",
          "sc": "设定为付费座位哟～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 131219,
          "spk": "今野 (コンノ)",
          "ja": "だけどリンさんが、無粋だって",
          "tc": "但是林小姐卻反對說",
          "sc": "但是林小姐却反对说"
        },
        {
          "f_idx": 7,
          "pidx_tc": 131226,
          "spk": "今野 (コンノ)",
          "ja": "反対するんですよねェ",
          "tc": "這樣做太沒情調了。",
          "sc": "这样做太没情调呐～。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 131233,
          "spk": "今野 (コンノ)",
          "ja": "はァ、稼げるのにもったいない……",
          "tc": "唉，白白浪費賺錢的機會……",
          "sc": "唉，白白浪费赚钱的机会……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1670,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131257,
          "spk": "今野 (コンノ)",
          "ja": "今年もこの日が来ましたよ",
          "tc": "今年也迎來這個日子了，",
          "sc": "今年也迎来这个日子了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131264,
          "spk": "今野 (コンノ)",
          "ja": "ぼったく……コホン",
          "tc": "是可以大敲竹……咳咳。",
          "sc": "是可以大敲竹……咳咳。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 131271,
          "spk": "今野 (コンノ)",
          "ja": "利益率高めのお祭りです",
          "tc": "是利潤偏高的祭典。",
          "sc": "是利润偏高的祭典。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131282,
          "spk": "今野 (コンノ)",
          "ja": "<player>さんも是非、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131289,
          "spk": "今野 (コンノ)",
          "ja": "いろんなお店でお金を落としていってくださいネ",
          "tc": "您也務必到各店家多多消費喔。",
          "sc": "您也务必到各家店铺多多消费呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1671,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131313,
          "spk": "今野 (コンノ)",
          "ja": "一通り見て回りましたが、",
          "tc": "我稍微去繞了一圈，",
          "sc": "我稍微去绕了一圈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131320,
          "spk": "今野 (コンノ)",
          "ja": "どの屋台も価格設定が安すぎますネ",
          "tc": "發現每攤的價格都設定得太便宜了。",
          "sc": "发现每摊的价格都设定得太便宜了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131338,
          "spk": "今野 (コンノ)",
          "ja": "祭りの高揚感は",
          "tc": "祭典的興奮感",
          "sc": "祭典的兴奋感"
        },
        {
          "f_idx": 4,
          "pidx_tc": 131345,
          "spk": "今野 (コンノ)",
          "ja": "財布の紐を緩ませられる",
          "tc": "明明是讓大家掏錢出來的",
          "sc": "明明是让大家掏钱出来的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 131352,
          "spk": "今野 (コンノ)",
          "ja": "絶好の機会だというのにねェ",
          "tc": "大好機會。",
          "sc": "大好机会呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 131363,
          "spk": "今野 (コンノ)",
          "ja": "これからは祭り価格を導入しなければ",
          "tc": "以後如果不來採用特別的祭典價格，",
          "sc": "以后如果不来采用特别的祭典价格，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 131370,
          "spk": "今野 (コンノ)",
          "ja": "本来得られたはずの利益が",
          "tc": "那麼原本應該拿得到的利益",
          "sc": "那么原本应该拿得到的利益"
        },
        {
          "f_idx": 8,
          "pidx_tc": 131377,
          "spk": "今野 (コンノ)",
          "ja": "逃げてしまいますよォ",
          "tc": "都要溜走了。",
          "sc": "都要溜走哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1672,
      "rec_id": "TALK_ID_SECRETARY_HOLIDAY_20_108_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 131401,
          "spk": "今野 (コンノ)",
          "ja": "ん～早速いい香りがし始めてますねェ",
          "tc": "嗯～香味已經開始傳來了呢。",
          "sc": "嗯～香味已经开始传来了呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 131408,
          "spk": "今野 (コンノ)",
          "ja": "おや、アナタも来たんですか",
          "tc": "哦，您也來了啊，",
          "sc": "哦，您也来了啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 131419,
          "spk": "今野 (コンノ)",
          "ja": "今日は食べ放題ですからねェ",
          "tc": "今天是地瓜吃到飽喔。",
          "sc": "今天是红薯吃到饱呐～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 131426,
          "spk": "今野 (コンノ)",
          "ja": "毎年食べきれなかった焼き芋は",
          "tc": "吃不完的烤地瓜，",
          "sc": "吃不完的烤红薯，"
        },
