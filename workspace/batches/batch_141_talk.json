  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2365,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93712,
          "spk": "洋 (ヨウ)",
          "ja": "雪、思ったよりたくさん降ってる",
          "tc": "雪下得比想像中的還多呢。",
          "sc": "雪下得比想像中的还多呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93723,
          "spk": "洋 (ヨウ)",
          "ja": "新しく積もった雪の上を歩くの、好きだから",
          "tc": "我很喜歡走在剛積起來的雪上面，",
          "sc": "我很喜欢走在刚积起来的雪上面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93730,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ嬉しいな",
          "tc": "所以有點開心呢。",
          "sc": "所以有点开心呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2366,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93754,
          "spk": "洋 (ヨウ)",
          "ja": "わ、吐く息がまっしろ",
          "tc": "哇，吐出來的氣都白白的。",
          "sc": "哇，吐出来的气都白白的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93765,
          "spk": "洋 (ヨウ)",
          "ja": "もしかして、お空に浮かぶ雲って",
          "tc": "該不會飄在天空中的雲，",
          "sc": "该不会飘在天空中的云，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93772,
          "spk": "洋 (ヨウ)",
          "ja": "わたしたちの息から出来てるのかな？",
          "tc": "都是由我們吐出來的氣變成的吧？",
          "sc": "都是由我们吐出来的气变成的吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2367,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93796,
          "spk": "洋 (ヨウ)",
          "ja": "さっきサザンカさんが、",
          "tc": "剛才茶梅姐姐說，",
          "sc": "刚才茶梅姐姐说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93803,
          "spk": "洋 (ヨウ)",
          "ja": "冬にこそアイスが美味しいって言ってたけど……",
          "tc": "冬天吃冰才更好吃……",
          "sc": "冬天吃冰才更好吃……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93814,
          "spk": "洋 (ヨウ)",
          "ja": "わたしは、寒くなるだけだと思う……",
          "tc": "但我覺得這樣應該只會覺得更冷吧……",
          "sc": "但我觉得这样应该只会觉得更冷吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2368,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93845,
          "spk": "洋 (ヨウ)",
          "ja": "こんなに寒いと、お外で遊ぶのも大変だね",
          "tc": "天氣這麼冷，要在外面玩也很難吧。",
          "sc": "天气这么冷，要在外面玩也很难吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93863,
          "spk": "洋 (ヨウ)",
          "ja": "みんなはどんな風に過ごしてるのかな",
          "tc": "不知道大家都是怎麼度過的呢？",
          "sc": "不知道大家都是怎么度过的呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93870,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと、お話を聞いてみたいな",
          "tc": "有點想要問問看。",
          "sc": "有点想要问问看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2369,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93894,
          "spk": "洋 (ヨウ)",
          "ja": "雪って、本当にふしぎだね",
          "tc": "雪真的很不可思議呢。",
          "sc": "雪真的很不可思议呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93901,
          "spk": "洋 (ヨウ)",
          "ja": "どうしてあんなにキレイな形の結晶が、",
          "tc": "為什麼形狀那麼漂亮的結晶，",
          "sc": "为什么形状那么漂亮的结晶，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93908,
          "spk": "洋 (ヨウ)",
          "ja": "お空から降って来るんだろう",
          "tc": "會從天空上飛下來呢？",
          "sc": "会从天空上飞下来呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2370,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93932,
          "spk": "洋 (ヨウ)",
          "ja": "お山の木も、すっかり葉っぱが落ちちゃったね",
          "tc": "山上的樹，葉子都掉光光了呢。",
          "sc": "山上的树，叶子都掉光光了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 93950,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんはそれもフゼイって言ってたけど",
          "tc": "叔叔說這樣也別有一番風情，",
          "sc": "叔叔说这样也别有一番风情，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 93957,
          "spk": "洋 (ヨウ)",
          "ja": "葉っぱのない木はやっぱり寂しいと思うんだ",
          "tc": "但我還是覺得樹上沒有葉子感覺很寂寞。",
          "sc": "但我还是觉得树上没有叶子感觉很寂寞。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2371,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 93988,
          "spk": "洋 (ヨウ)",
          "ja": "そういえば、コマコちゃんのお仕事って",
          "tc": "對了，聽說駒子姐姐的工作",
          "sc": "对了，听说驹子姐姐的工作"
        },
        {
          "f_idx": 1,
          "pidx_tc": 93995,
          "spk": "洋 (ヨウ)",
          "ja": "冬の間が本番だって聞いたの",
          "tc": "在冬天才是最忙碌的時候。",
          "sc": "在冬天才是最忙碌的时候。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94006,
          "spk": "洋 (ヨウ)",
          "ja": "猟師さんって、大変なお仕事なんだね",
          "tc": "當獵師真的很辛苦呢。",
          "sc": "当猎师真的很辛苦呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2372,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94030,
          "spk": "洋 (ヨウ)",
          "ja": "今日の晩ご飯はなんだろう",
          "tc": "今天晚餐吃什麼呢？",
          "sc": "今天晚餐吃什么呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94037,
          "spk": "洋 (ヨウ)",
          "ja": "あったかいものだと嬉しいな",
          "tc": "真希望是熱呼呼的東西。",
          "sc": "真希望是热呼呼的东西。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94048,
          "spk": "洋 (ヨウ)",
          "ja": "たとえば、カレーとか……",
          "tc": "比方說咖哩之類的……",
          "sc": "比方说咖喱之类的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2373,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94072,
          "spk": "洋 (ヨウ)",
          "ja": "今日はもう、ずっと雪が降ってるみたい",
          "tc": "今天好像一直都在下雪。",
          "sc": "今天好像一直都在下雪。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94090,
          "spk": "洋 (ヨウ)",
          "ja": "このまま降り続いて、",
          "tc": "要是就這樣一直下雪，",
          "sc": "要是就这样一直下雪，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 94097,
          "spk": "洋 (ヨウ)",
          "ja": "お家が埋まっちゃったらどうしよう……",
          "tc": "我家被埋起來該怎麼辦……",
          "sc": "我家被埋起来该怎么办……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 94108,
          "spk": "洋 (ヨウ)",
          "ja": "その前に、重さでお家が潰れちゃうかな……？",
          "tc": "還是被埋起來前，會先因為雪太重被壓垮呢……？",
          "sc": "还是被埋起来前，会先因为雪太重被压垮呢……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2374,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94139,
          "spk": "洋 (ヨウ)",
          "ja": "すごい、もう真っ暗だ",
          "tc": "天啊，已經完全天黑了。",
          "sc": "天啊，已经完全天黑了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94150,
          "spk": "洋 (ヨウ)",
          "ja": "おつかいはもう終わったし、",
          "tc": "既然跑腿也結束，",
          "sc": "既然跑腿也结束，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94157,
          "spk": "洋 (ヨウ)",
          "ja": "そろそろお家に帰らないと",
          "tc": "也差不多該回家了。",
          "sc": "也差不多该回家了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2375,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94181,
          "spk": "洋 (ヨウ)",
          "ja": "そういえばサザンカさんのお店、",
          "tc": "說起來，",
          "sc": "说起来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94188,
          "spk": "洋 (ヨウ)",
          "ja": "まだ明かりがついてたな",
          "tc": "茶梅姐姐店裡的燈還亮著耶。",
          "sc": "茶梅姐姐店里的灯还亮着呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94199,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんもだけど、",
          "tc": "包含叔叔在內，",
          "sc": "包含叔叔在内，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 94206,
          "spk": "洋 (ヨウ)",
          "ja": "大人はちょっと働きすぎだよね",
          "tc": "大人們真的有點工作過頭了。",
          "sc": "大人们真的有点工作过头了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2376,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94230,
          "spk": "洋 (ヨウ)",
          "ja": "歩いてたら、耳が痛くなってきちゃった",
          "tc": "在路上走一走就開始覺得耳朵好痛喔。",
          "sc": "在路上走一走就开始觉得耳朵好痛哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94241,
          "spk": "洋 (ヨウ)",
          "ja": "どうして寒いと痛いんだろう",
          "tc": "為什麼天氣冷就會耳朵痛呢？",
          "sc": "为什么天气冷就会耳朵痛呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94248,
          "spk": "洋 (ヨウ)",
          "ja": "冬も人の体も、ふしぎがいっぱいだね",
          "tc": "不論是冬天還是人的身體，真的都很不可思議耶。",
          "sc": "不论是冬天还是人的身体，真的都很不可思议呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2377,
      "rec_id": "TALK_ID_GIRL_BIRTHDAY_20_110_5000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94279,
          "spk": "洋 (ヨウ)",
          "ja": "あっ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94286,
          "spk": "洋 (ヨウ)",
          "ja": "今日は<player>のお誕生日なんだよね？",
          "tc": "今天是<player>的生日對吧？",
          "sc": "今天是<player>的生日对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94293,
          "spk": "洋 (ヨウ)",
          "ja": "みんなから聞いたんだ",
          "tc": "我聽大家說的。",
          "sc": "我听大家说的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 94304,
          "spk": "洋 (ヨウ)",
          "ja": "お誕生日おめでとう！",
          "tc": "生日快樂！",
          "sc": "生日快乐！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 94311,
          "spk": "洋 (ヨウ)",
          "ja": "いつもみんなのこと助けてくれて",
          "tc": "你總是幫助大家，",
          "sc": "你总是帮助大家，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 94318,
          "spk": "洋 (ヨウ)",
          "ja": "本当にありがとね",
          "tc": "真的很謝謝你。",
          "sc": "真的很谢谢你。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 94329,
          "spk": "洋 (ヨウ)",
          "ja": "それでね、わたし",
          "tc": "所以啊，",
          "sc": "所以呢，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 94336,
          "spk": "洋 (ヨウ)",
          "ja": "<player>にプレゼントを用意したの",
          "tc": "我為<player>準備了禮物喔。",
          "sc": "我为<player>准备了礼物哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 94352,
          "spk": "洋 (ヨウ)",
          "ja": "いっしょうけんめい作ったんだ",
          "tc": "這是我很努力地做的，",
          "sc": "是我非常用心做出来的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 94359,
          "spk": "洋 (ヨウ)",
          "ja": "もらってくれる？",
          "tc": "你願意收下嗎？",
          "sc": "你愿意收下吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2378,
      "rec_id": "TALK_ID_GIRL_BIRTHDAY_20_110_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 94383,
          "spk": "洋 (ヨウ)",
          "ja": "あのね、折り紙を折ってみたの",
          "tc": "那個，我試著摺了紙。",
          "sc": "那个，我试着折了纸。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 94390,
          "spk": "洋 (ヨウ)",
          "ja": "このカエルのね、",
          "tc": "這隻青蛙啊，",
          "sc": "这只青蛙啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 94397,
          "spk": "洋 (ヨウ)",
          "ja": "後ろのここを押すとはねるんだよ",
          "tc": "按一下後面這邊就會跳起來喔。",
          "sc": "按一下后面这边就会跳起来哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 94408,
          "spk": "洋 (ヨウ)",
          "ja": "こっちのツルは自信作！",
          "tc": "這個紙鶴是我最有自信的作品！",
          "sc": "这个纸鹤是我最有自信的作品！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 94415,
          "spk": "洋 (ヨウ)",
          "ja": "首と尻尾を折る時は、紙をピッタリと",
          "tc": "在摺脖子跟尾巴的時候稍微留一點空隙，",
          "sc": "在折脖子和尾巴的时候稍微留一点空隙，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 94422,
          "spk": "洋 (ヨウ)",
          "ja": "くっつけないで折るとキレイにできるんだよ！",
          "tc": "就可以摺得很漂亮喔！",
          "sc": "就可以折得很漂亮哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 94433,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと難しかったけど、",
          "tc": "雖然有點難，",
          "sc": "虽然有点难，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 94440,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のお祝いだからがんばっちゃった",
          "tc": "但因為是要給<player>的賀禮，所以努力完成了。",
          "sc": "但因为是要给<player>的贺礼，所以我努力完成了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 94458,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のお部屋に",
          "tc": "要是<player>願意把它放在房間裡，",
          "sc": "要是<player>愿意把它放在房间里，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 94465,
          "spk": "洋 (ヨウ)",
          "ja": "かわいくかざってくれたら嬉しいな",
          "tc": "當作可愛的裝飾，我會很開心的。",
          "sc": "当成可爱的装饰，我会很开心的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 94476,
          "spk": "洋 (ヨウ)",
          "ja": "わたしね、<player>が",
          "tc": "我呀，因為<player>來到這個村子，",
          "sc": "我呀，因为<player>来到这个村子，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 94483,
          "spk": "洋 (ヨウ)",
          "ja": "この村にいてくれて毎日すっごく楽しいよ",
          "tc": "每天都過得很開心。",
          "sc": "每天都过得超级开心。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 94490,
          "spk": "洋 (ヨウ)",
          "ja": "これからも、いっぱい一緒に遊ぼうね",
          "tc": "以後也要常常一起玩喔。",
          "sc": "以后也要常常一起玩哦。"
