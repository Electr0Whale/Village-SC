          "f_idx": 8,
          "pidx_tc": 56951,
          "spk": "裕太 (ユータ)",
          "ja": "生クリームをこれでもかと乗せるんだ",
          "tc": "鮮奶油也像不用錢似的拚命加。",
          "sc": "鲜奶油也像不用钱似的拚命加。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 56960,
          "spk": "裕太 (ユータ)",
          "ja": "美味しいメロンと贅沢に使ったクリームを",
          "tc": "這樣就能打造出眾人心中的夢幻逸品，",
          "sc": "这样就能打造出众人心中的梦幻逸品，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 56967,
          "spk": "裕太 (ユータ)",
          "ja": "同時に楽しむことができるという、",
          "tc": "可以同時享受鮮美甜瓜",
          "sc": "可以同时享受鲜美甜瓜"
        },
        {
          "f_idx": 11,
          "pidx_tc": 56974,
          "spk": "裕太 (ユータ)",
          "ja": "みんなが夢見る至極の一品……",
          "tc": "和滿滿鮮奶油的雙重美味……",
          "sc": "和满满鲜奶油的双重美味……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 56985,
          "spk": "裕太 (ユータ)",
          "ja": "……なんて、作ったことはないから",
          "tc": "……說是這樣說，但我沒有實際做過，",
          "sc": "……说是这样说，但我没有实际做过，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 56992,
          "spk": "裕太 (ユータ)",
          "ja": "まだこのレシピは設計図の段階なんだけどね",
          "tc": "所以這個食譜還停留在設計階段。",
          "sc": "所以这个食谱还停留在设计阶段。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 57010,
          "spk": "裕太 (ユータ)",
          "ja": "でも、キミならきっと、",
          "tc": "不過，如果是你的話，",
          "sc": "不过，如果是你的话，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 57017,
          "spk": "裕太 (ユータ)",
          "ja": "このレシピを現実のものにしてくれるでしょ？",
          "tc": "一定會幫我實現這道料理的，對吧？",
          "sc": "一定会帮我实现这道料理的，对吧？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 57024,
          "spk": "裕太 (ユータ)",
          "ja": "「夢いっぱいメロン」の完成、楽しみにしてるよ",
          "tc": "我很期待「夢幻甜瓜」完成的那天喔！",
          "sc": "我很期待“梦幻甜瓜”完成的那天哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2388,
      "rec_id": "TALK_ID_YOUNG_MAN_SPECIAL_20_111_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 57048,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、聞いてよ！",
          "tc": "<player>，你聽我說！",
          "sc": "<player>，你听我说！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 57055,
          "spk": "裕太 (ユータ)",
          "ja": "俺の畑で、ナスがとれたんだ！",
          "tc": "我的田裡種出茄子了！",
          "sc": "我的田里种出茄子了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 57062,
          "spk": "裕太 (ユータ)",
          "ja": "小さくて形も歪だけど、俺が育てたナスだよ！",
          "tc": "雖然長得又小又歪，但這是我種出來的茄子喔！",
          "sc": "虽然长得又小又歪，但这是我种出来的茄子哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 57073,
          "spk": "裕太 (ユータ)",
          "ja": "だから記念に、レシピを考えたんだ",
          "tc": "所以為了紀念，我想了一道食譜。",
          "sc": "所以为了纪念，我想了一道食谱。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 57080,
          "spk": "裕太 (ユータ)",
          "ja": "ナスのおいしさをあますところなく味わえる、",
          "tc": "是能將茄子的美味發揮到淋漓盡致，",
          "sc": "是能将茄子的美味发挥到淋漓尽致，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 57087,
          "spk": "裕太 (ユータ)",
          "ja": "素晴らしいレシピだよ",
          "tc": "超級棒的食譜喔！",
          "sc": "超级棒的食谱哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 57098,
          "spk": "裕太 (ユータ)",
          "ja": "焼きナスで香りを、煮浸しで旨味を、",
          "tc": "用燒烤品嘗香氣，用燉煮品嘗鮮甜，",
          "sc": "用烧烤品尝香气，用炖煮品尝鲜甜，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 57105,
          "spk": "裕太 (ユータ)",
          "ja": "浅漬けでナスの生命力を感じる……",
          "tc": "再用淺漬來感受茄子的生命力……",
          "sc": "再用浅渍来感受茄子的生命力……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 57112,
          "spk": "裕太 (ユータ)",
          "ja": "さあ、受けとって！　「ナスづくし」レシピだ！",
          "tc": "來，收下吧！這是「茄子全餐」的食譜！",
          "sc": "来，收下吧！这是“茄子全餐”的食谱！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 57123,
          "spk": "裕太 (ユータ)",
          "ja": "この喜びを<player>に伝えられてよかったよ",
          "tc": "可以跟<player>分享這份喜悅真是太好了，",
          "sc": "可以跟<player>分享这份喜悦真是太好了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 57130,
          "spk": "裕太 (ユータ)",
          "ja": "ナスづくしの一皿、たくさん楽しんでね",
          "tc": "好好享受滿滿一盤茄子全餐吧！",
          "sc": "好好享受满满一盘茄子全餐吧！"
        }
      ]
    },
