      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150235,
          "spk": "名护 (ナゴ)",
          "ja": "……レシピ本を持ってきたけど",
          "tc": "……我帶了食譜回來，",
          "sc": "……我带了食谱回来，"
