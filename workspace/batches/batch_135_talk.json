        {
          "f_idx": 1,
          "pidx_tc": 150242,
          "spk": "名护 (ナゴ)",
          "ja": "何が書いてあるのか、全然理解できない……",
          "tc": "結果完全看不懂上面在寫什麼……",
          "sc": "结果完全看不懂上面在写什么……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150253,
          "spk": "名护 (ナゴ)",
          "ja": "せっかくの秋食材も、泣いてるな……",
          "tc": "難得的秋季食材，這下都要流淚了……",
          "sc": "难得的秋季食材，这下都要流泪了……"
        }
      ]
    },
    {
      "file": "talk.dat",
