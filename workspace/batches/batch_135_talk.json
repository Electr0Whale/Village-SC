      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152650,
          "spk": "名护 (ナゴ)",
          "ja": "寒い中、外で仕事している人もいるのに",
          "tc": "天氣這麼冷，還有人在外面工作，",
          "sc": "天气这么冷，还有人在外面工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152657,
          "spk": "名护 (ナゴ)",
          "ja": "何だか申し訳なくなってくるな……",
          "tc": "總覺得有點過意不去……",
          "sc": "总觉得有点过意不去……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 152668,
          "spk": "名护 (ナゴ)",
          "ja": "市役所員をしていた頃の外回りを思いだすよ",
          "tc": "讓我想起擔任市公所職員跑外勤的時候。",
          "sc": "让我想起担任市政厅职员跑外勤的时候。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2080,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152699,
          "spk": "名护 (ナゴ)",
          "ja": "ここにいると、たくさんの冬景色を味わえるんだ",
          "tc": "待在這裡，可以感受到許多冬日風景。",
          "sc": "待在这里，可以感受到许多冬日风景。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152706,
          "spk": "名护 (ナゴ)",
          "ja": "木枯らしの吹く音が聞こえたり、雪が舞って",
          "tc": "像是聽見秋風吹拂，或是看到閃亮的雪花飛舞……",
          "sc": "像是听见秋风吹拂，或是看到闪亮的雪花飞舞……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 152713,
          "spk": "名护 (ナゴ)",
          "ja": "キラキラ輝いて見えたり……自然の芸術だね",
          "tc": "這些都是大自然的藝術呢。",
          "sc": "这些都是大自然的艺术呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2081,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152737,
          "spk": "名护 (ナゴ)",
          "ja": "……雨でも雪でも、見る分には",
          "tc": "……無論雨還是雪，如果只是單純欣賞，",
          "sc": "……无论雨还是雪，如果只是单纯欣赏，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152744,
          "spk": "名护 (ナゴ)",
          "ja": "綺麗だな、美しいなって思うんだよな",
          "tc": "大家都會覺得很漂亮、很美麗對吧。",
          "sc": "大家都会觉得很漂亮、很美丽对吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 152762,
          "spk": "名护 (ナゴ)",
          "ja": "体感さえしなければ、",
          "tc": "只要不親身接觸到，",
          "sc": "只要不亲身接触到，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 152769,
          "spk": "名护 (ナゴ)",
          "ja": "ツラくも思わないのに",
          "tc": "就不會感到困擾。",
          "sc": "就不会感到困扰。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2082,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152793,
          "spk": "名护 (ナゴ)",
          "ja": "机で学ぶだけが勉強じゃないし、",
          "tc": "不是只有坐在書桌前念書才叫學習，",
          "sc": "不是只有坐在书桌前念书才叫学习，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152800,
          "spk": "名护 (ナゴ)",
          "ja": "子どもたちに冬の楽しみ方を教えるというのも",
          "tc": "教教孩子們怎麼享受冬天或許也不錯吧……",
          "sc": "教教孩子们怎么享受冬天或许也不错吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 152807,
          "spk": "名护 (ナゴ)",
          "ja": "いいかもな……むしろ、教わる側になるか？",
          "tc": "搞不好反而是我在受教呢？",
          "sc": "说不定反而是我在受教呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2083,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152831,
          "spk": "名护 (ナゴ)",
          "ja": "月冴ゆる冬の夜か……",
          "tc": "月色清冷的冬夜嗎……",
          "sc": "月色清冷的冬夜吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 152849,
          "spk": "名护 (ナゴ)",
          "ja": "今夜は冷えるし、綺麗に月が見えるだろうな",
          "tc": "今晚滿冷的，月亮應該可以看得很清楚吧。",
          "sc": "今晚满冷的，月亮应该可以看得很清楚吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2084,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4033",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152880,
          "spk": "名护 (ナゴ)",
          "ja": "……田舎暮らしをしながら",
          "tc": "……沒想到我會在鄉下生活，",
          "sc": "……没想到我会在乡下生活，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152887,
          "spk": "名护 (ナゴ)",
          "ja": "雪景色を眺めることになるなんてなぁ",
          "tc": "還像這樣看著雪景呢～",
          "sc": "还像这样看着雪景呢～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 152905,
          "spk": "名护 (ナゴ)",
          "ja": "人生何が起きるか、わからないものだよ",
          "tc": "誰都不知道人生這條路上會發生什麼事。",
          "sc": "谁都不知道人生这条路上会发生什么事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2085,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152936,
          "spk": "名护 (ナゴ)",
          "ja": "おや、<player>さん、いらっしゃい",
          "tc": "喔！<player>，歡迎你來。",
          "sc": "喔！<player>，欢迎你来。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 152943,
          "spk": "名护 (ナゴ)",
          "ja": "外は寒かったろう？",
          "tc": "外面很冷吧？",
          "sc": "外面很冷吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2086,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_4101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 152974,
          "spk": "名护 (ナゴ)",
          "ja": "外で本を読む経験は俺にもあるけど",
          "tc": "雖然我也曾在外面看書。",
          "sc": "虽然我也曾在外面看书。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 152992,
          "spk": "名护 (ナゴ)",
          "ja": "シロージくんが雪の降る中でも雑誌を",
          "tc": "但當我看到四郎治在雪中看雜誌時，",
          "sc": "但当我看到四郎治在雪中看杂志时，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 152999,
          "spk": "名护 (ナゴ)",
          "ja": "読んでいるのを見た時は目を疑ったよ……",
          "tc": "真的開始懷疑自己的眼睛……",
          "sc": "真的开始怀疑自己的眼睛……"
        }
      ]
    },
