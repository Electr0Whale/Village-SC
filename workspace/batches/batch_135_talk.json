      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 153030,
          "spk": "名护 (ナゴ)",
          "ja": "この図書館、寒いよな……",
          "tc": "這座圖書館真寒冷啊……",
          "sc": "这座图书馆真寒冷啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 153037,
          "spk": "名护 (ナゴ)",
          "ja": "まあ、外よりマシではあるんだが……",
          "tc": "不過還是比外頭好多了……",
          "sc": "不过还是比外头好多了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 153048,
          "spk": "名护 (ナゴ)",
          "ja": "暖房器具を注文しておいたんだけど、",
          "tc": "雖然我已經訂好了暖氣設備，",
          "sc": "虽然我已经订好了暖气设备，"
