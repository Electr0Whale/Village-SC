        {
          "f_idx": 0,
          "pidx_tc": 149976,
          "spk": "名护 (ナゴ)",
          "ja": "ホタルが生息できるような自然環境か……",
          "tc": "螢火蟲能夠棲息的自然環境啊……",
          "sc": "萤火虫能够栖息的自然环境啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 149994,
          "spk": "名护 (ナゴ)",
          "ja": "改めてこの村の、",
          "tc": "我再次感受到",
          "sc": "我再次感受到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150001,
          "spk": "名护 (ナゴ)",
          "ja": "豊かで美しい自然を感じたよ",
          "tc": "這座村子豐饒又美麗的大自然。",
          "sc": "这座村子丰饶又美丽的大自然。"
        }
      ]
    },
    {
      "file": "talk.dat",
