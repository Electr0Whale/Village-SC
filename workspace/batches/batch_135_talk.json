      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150284,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさんに頼んでおいた本、",
          "tc": "拜託琪娜娜小姐幫忙訂的書，",
          "sc": "拜托琪娜娜小姐帮忙订的书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150291,
          "spk": "名护 (ナゴ)",
          "ja": "いつ届くんだろう？",
          "tc": "什麼時候會到呢？",
          "sc": "什么时候会到呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150302,
          "spk": "名护 (ナゴ)",
          "ja": "もしかして……",
          "tc": "難道說……",
          "sc": "难道说……"
