      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150025,
          "spk": "名护 (ナゴ)",
          "ja": "公共の施設はみんなで利用するものだ",
          "tc": "公共設施是大家一起使用的。",
          "sc": "公共设施是大家一起使用的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150043,
          "spk": "名护 (ナゴ)",
          "ja": "図書館に限らず、大事に使うんだよ？",
          "tc": "不只是圖書館，用任何公共設施都要好好珍惜喔！",
          "sc": "不只是图书馆，用任何公共设施都要好好珍惜哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150050,
          "spk": "名护 (ナゴ)",
          "ja": "じゃないと、サービスが停止することもある",
          "tc": "不然，服務也有可能會停止。",
          "sc": "不然，服务也有可能会停止。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2025,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150081,
          "spk": "名护 (ナゴ)",
          "ja": "ゴミの片づけが習慣化したせいか",
          "tc": "可能是因為養成了收拾垃圾的習慣，",
          "sc": "可能是因为养成了收拾垃圾的习惯，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150088,
          "spk": "名护 (ナゴ)",
          "ja": "どんどん作業効率が上がってきたんだ",
          "tc": "清理效率開始越來越高了。",
          "sc": "清理效率开始越来越高了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150106,
          "spk": "名护 (ナゴ)",
          "ja": "……俺の仕事は司書のはずなのに、",
          "tc": "……沒想到我明明是圖書館員，",
          "sc": "……没想到我明明是图书馆员，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 150113,
          "spk": "名护 (ナゴ)",
          "ja": "こんな技能が身につくとは",
          "tc": "卻學會了這種技能。",
          "sc": "却学会了这种技能。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2026,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150137,
          "spk": "名护 (ナゴ)",
          "ja": "朝から図書館に来るなんて",
          "tc": "一大早就跑來圖書館，",
          "sc": "一大早就跑来图书馆，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150144,
          "spk": "名护 (ナゴ)",
          "ja": "感心だね、<player>さん",
          "tc": "<player>真讓人佩服呢。",
          "sc": "<player>真让人佩服呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150155,
          "spk": "名护 (ナゴ)",
          "ja": "探してる本があるなら、俺に言ってくれ",
          "tc": "如果有想找的書，就跟我說吧。",
          "sc": "如果有想找的书，就跟我说吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2027,
      "rec_id": "TALK_ID_CITY_HALL_STAFF_ROUTINE_20_109_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 150179,
          "spk": "名护 (ナゴ)",
          "ja": "自動車の走る音や、工事の音も無い……",
          "tc": "既沒有汽車行駛聲，也沒有施工聲……",
          "sc": "既没有汽车行驶声，也没有施工声……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 150186,
          "spk": "名护 (ナゴ)",
          "ja": "……この村は静かすぎるね",
          "tc": "……這個村子真是過於安靜呢。",
          "sc": "……这个村子真是过于安静呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 150197,
          "spk": "名护 (ナゴ)",
          "ja": "何かしてないと、逆に落ち着かないよ",
          "tc": "不做些什麼反而坐立難安。",
          "sc": "不做些什么反而坐立难安。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 150204,
          "spk": "名护 (ナゴ)",
          "ja": "暇ってこんなにきついんだな……",
          "tc": "無事可做居然會這麼痛苦……",
          "sc": "无事可做居然会这么痛苦……"
        }
      ]
    },
    {
      "file": "talk.dat",
