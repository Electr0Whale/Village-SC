    {
      "file": "talk.dat",
      "rec_idx": 3511,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189787,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、もう午後５時じゃないか",
          "tc": "哎呀，已經下午5點了嗎？",
          "sc": "哎呀，已经下午5点了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189794,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはもう帰るよ",
          "tc": "我要回家了，",
          "sc": "我要回家了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189801,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃあ、またね",
          "tc": "那就下次見囉！",
          "sc": "那就下次见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3512,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189827,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あら、もう午後５時だね",
          "tc": "哎呀，已經下午5點了啊。",
          "sc": "哎呀，已经下午5点了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189834,
          "spk": "琪娜娜 (チナナ)",
          "ja": "残念だけど、今日はここまで",
          "tc": "雖然很可惜，但今天就到這裡吧。",
          "sc": "虽然很可惜，但今天就到这里吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189841,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃあ、また来ておくれ",
          "tc": "下次要再來喔！",
          "sc": "下次要再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3513,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189867,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気づけば午後５時じゃないか",
          "tc": "回過神來怎麼已經下午5點了！",
          "sc": "回过神来怎么已经下午5点了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189874,
          "spk": "琪娜娜 (チナナ)",
          "ja": "名残惜しいけど、今日は店じまいだよ",
          "tc": "雖然很可惜，但今天要打烊了。",
          "sc": "虽然很可惜，但今天要打烊了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189881,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、次の機会にまたおいで",
          "tc": "<player>，下次有機會再來喔！",
          "sc": "<player>，下次有机会再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3514,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189907,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さて、今日のお仕事はおしまい",
          "tc": "好，今天可以收工了！",
          "sc": "好，今天可以收工了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189914,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはもう帰るから、",
          "tc": "我要回家了，",
          "sc": "我要回家了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189921,
          "spk": "琪娜娜 (チナナ)",
          "ja": "買いたかったらまた今度来ておくれ",
          "tc": "想買東西的話下次再來喔！",
          "sc": "想买东西的话下次再来哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3515,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189947,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おーい、<player>！",
          "tc": "喂～<player>！",
          "sc": "喂～<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189954,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そこに車を停めるから、",
          "tc": "抱歉，我想把車停在那裡，",
          "sc": "抱歉，我想把车停在那里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 189961,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど、道をあけてくれるかい？",
          "tc": "可以請你讓個路嗎？",
          "sc": "可以请你让个路吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3516,
      "rec_id": "TALK_ID_CLOSE_STREET_VENDOR_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 189987,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>！",
          "tc": "<player>！",
          "sc": "<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 189994,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっとどいておくれ！",
          "tc": "借過一下！",
          "sc": "借过一下！"
