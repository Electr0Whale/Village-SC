          "f_idx": 3,
          "pidx_tc": 190348,
          "spk": "主角心声/旁白/选项",
          "ja": "免許を持っているから、",
          "tc": "現在持有執照，",
          "sc": "现在持有执照，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 190355,
          "spk": "主角心声/旁白/选项",
          "ja": "入っても大丈夫なはず！",
          "tc": "進去應該沒問題！",
          "sc": "进去应该没问题！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 190362,
          "spk": "主角心声/旁白/选项",
          "ja": "フェンスをジャンプして飛び越えよう",
          "tc": "跳過圍籬過去吧。",
          "sc": "跳过围篱过去吧。"
        }
      ]
    },
