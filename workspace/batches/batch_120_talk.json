        {
          "f_idx": 5,
          "pidx_tc": 47688,
          "spk": "茶梅 (サザンカ)",
          "ja": "後の祭り感半端ないか……",
          "tc": "好像也很沒意義……",
          "sc": "好像也很没意义……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1218,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47712,
          "spk": "茶梅 (サザンカ)",
          "ja": "今日はエントリーしなかったんだ？",
          "tc": "你今天沒有報名參加啊？",
          "sc": "你今天没有报名参加啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47719,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、見学だけでも充分楽しめるからな～",
          "tc": "不過光是觀摩也很有趣了啦～",
          "sc": "不过光是观摩也很有趣了啦～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47730,
          "spk": "茶梅 (サザンカ)",
          "ja": "特に馬って表情豊かだし",
          "tc": "尤其馬的表情很豐富，",
          "sc": "尤其马的表情很丰富，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47737,
          "spk": "茶梅 (サザンカ)",
          "ja": "見てて飽きないよね",
          "tc": "看都看不膩呢～",
          "sc": "看都看不腻呢～"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47748,
          "spk": "茶梅 (サザンカ)",
          "ja": "今度、アンタのとこの馬も見せてよね",
          "tc": "下次也讓我看看你的馬吧，",
          "sc": "下次也让我看看你的马吧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 47755,
          "spk": "茶梅 (サザンカ)",
          "ja": "よかったら、だけどさ",
          "tc": "如果你願意的話啦。",
          "sc": "如果你愿意的话啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1219,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47779,
          "spk": "茶梅 (サザンカ)",
          "ja": "ね、アンタの馬すごくない？",
          "tc": "欸～你的馬也太讚了吧？",
          "sc": "诶～你的马也太赞了吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47786,
          "spk": "茶梅 (サザンカ)",
          "ja": "めっちゃ綺麗じゃん",
          "tc": "超級漂亮的耶。",
          "sc": "超级漂亮的呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47797,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシでもパッと見で",
          "tc": "連我也是光看第一眼",
          "sc": "连我也是光看第一眼"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47804,
          "spk": "茶梅 (サザンカ)",
          "ja": "ヤバッて思うくらいだし",
          "tc": "就覺得實在是太厲害了。",
          "sc": "就觉得实在是太厉害了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47811,
          "spk": "茶梅 (サザンカ)",
          "ja": "最高ランクなのも納得って感じ",
          "tc": "難怪你能拿到最高級的評分。",
          "sc": "难怪你能拿到最高级的评分。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1220,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47835,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタの馬、最高評価じゃないんだ？",
          "tc": "你的馬竟然沒拿到最高評價？",
          "sc": "你的马竟然没拿到最高评价？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47842,
          "spk": "茶梅 (サザンカ)",
          "ja": "う～ん……どういう審査基準？",
          "tc": "嗯……這審查的標準是什麼啊？",
          "sc": "嗯……这审查的标准是什么啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47853,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシはめっちゃいいと思うんだけどな……",
          "tc": "明明我覺得很不錯欸……",
          "sc": "明明我觉得很不错诶……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47860,
          "spk": "茶梅 (サザンカ)",
          "ja": "あのオッサンたち、見る目ないね～",
          "tc": "那些大叔真沒有眼光啊～",
          "sc": "那些大叔真没有眼光啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
