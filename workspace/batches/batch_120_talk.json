        {
          "f_idx": 3,
          "pidx_tc": 47670,
          "spk": "茶梅 (サザンカ)",
          "ja": "ぶっちゃけ納得いかないけど……",
          "tc": "總覺得不太能接受……",
          "sc": "总觉得不太能接受……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47681,
          "spk": "茶梅 (サザンカ)",
          "ja": "今さらなんか言ったところで",
          "tc": "但事到如今說這些",
          "sc": "但事到如今说这些"
