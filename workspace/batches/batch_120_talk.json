      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47197,
          "spk": "茶梅 (サザンカ)",
          "ja": "んー、この日のために",
          "tc": "嗯～為了這天，",
          "sc": "嗯～为了这天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47204,
          "spk": "茶梅 (サザンカ)",
          "ja": "必要なもの仕入れたり運んだり……",
          "tc": "要採購或運送必要的東西……",
          "sc": "要采购或运送必要的东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47211,
          "spk": "茶梅 (サザンカ)",
          "ja": "毎年忙しいんだよね",
          "tc": "每年都好忙碌啊。",
          "sc": "每年都好忙碌啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47222,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、当日は美味しいもの食べて",
          "tc": "不過，活動當天就能盡情地",
          "sc": "不过，活动当天就能尽情地"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47229,
          "spk": "茶梅 (サザンカ)",
          "ja": "楽させてもらうけど～",
          "tc": "享受美味的食物～",
          "sc": "享受美味的食物～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1211,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47253,
          "spk": "茶梅 (サザンカ)",
          "ja": "おモチは美味しいんだけど",
          "tc": "麻糬雖然很好吃，",
          "sc": "年糕虽然很好吃，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47260,
          "spk": "茶梅 (サザンカ)",
          "ja": "つくのがマジダルいんだよね～",
          "tc": "但搗的時候真的很累耶～",
          "sc": "但捣的时候真的很累呢～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47271,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、餅つき機でも",
          "tc": "所以我才提議了",
          "sc": "所以我才提议了"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47278,
          "spk": "茶梅 (サザンカ)",
          "ja": "使ったらって提案したんだけど……",
          "tc": "看要不要改用機器搗麻糬……",
          "sc": "看要不要改用机器捣年糕……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47285,
          "spk": "茶梅 (サザンカ)",
          "ja": "風情がないってさ",
          "tc": "結果卻被說這樣很沒氣氛。",
          "sc": "结果却被说这样很没气氛。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 47296,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、アタシは食べるだけだから",
          "tc": "反正我只負責吃而已，",
          "sc": "反正我只负责吃而已，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 47303,
          "spk": "茶梅 (サザンカ)",
          "ja": "好きにしたらって感じなんだけどね～",
          "tc": "所以想怎樣我都無所謂啦～",
          "sc": "所以想怎样我都无所谓啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1212,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47327,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタ、参加しなかったんだ？",
          "tc": "你沒參加評鑑會喔？",
          "sc": "你没参加评鉴会哦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47334,
          "spk": "茶梅 (サザンカ)",
          "ja": "そういう気分じゃなかったってこと？",
          "tc": "是沒那種興致嗎？",
          "sc": "是没那种兴致吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47345,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、参加するのもしないのも自由だし",
          "tc": "反正要不要參加是你的自由，",
          "sc": "反正要不要参加是你的自由，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47352,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタがいいならそれでいいんじゃない",
          "tc": "你沒關係的話那也沒什麼不好的吧。",
          "sc": "你没关系的话那也没什么不好的吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47363,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああ、でも……",
          "tc": "啊，不過……",
          "sc": "啊，不过……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 47370,
          "spk": "茶梅 (サザンカ)",
          "ja": "出てたら全力で応援してたよ",
          "tc": "你有參加的話，我就會替你加油的說。",
          "sc": "你有参加的话，我就会替你加油的说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1213,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47394,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>～",
          "tc": "<player>～",
          "sc": "<player>～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47401,
          "spk": "茶梅 (サザンカ)",
          "ja": "Ｓランクとか鬼スゴイじゃん",
          "tc": "居然能得到S級，也太狂了吧！",
          "sc": "居然能得到S级，也太狂了吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47412,
          "spk": "茶梅 (サザンカ)",
          "ja": "いっつもがんばって畑仕事してたし",
          "tc": "不過畢竟你一直很努力在種田，",
          "sc": "不过毕竟你一直很努力在种田，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47419,
          "spk": "茶梅 (サザンカ)",
          "ja": "当然っちゃ当然の結果かもしれないけど",
          "tc": "所以這好像也是理所當然的結果。",
          "sc": "所以这好像也是理所当然的结果。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47426,
          "spk": "茶梅 (サザンカ)",
          "ja": "それでもマジでリスペクトするわ",
          "tc": "但你真的太令人敬佩了啦。",
          "sc": "但你真的太令人敬佩了啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1214,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47450,
          "spk": "茶梅 (サザンカ)",
          "ja": "う～ん、残念だったね～",
          "tc": "嗯～真可惜～",
          "sc": "嗯～真可惜～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47457,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも、あんま気にすんな～？",
          "tc": "但你也不用太在意啦～",
          "sc": "但你也不用太在意啦～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47468,
          "spk": "茶梅 (サザンカ)",
          "ja": "品評会はあくまで他人の評価だからね",
          "tc": "評鑑會終究只是旁人的評價而已。",
          "sc": "评鉴会终究只是旁人的评价而已。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47475,
          "spk": "茶梅 (サザンカ)",
          "ja": "こういうのはさ……",
          "tc": "像這種事啊……",
          "sc": "像这种事啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47482,
          "spk": "茶梅 (サザンカ)",
          "ja": "自分が満足してればいいんだから",
          "tc": "只要自己覺得滿意就行了。",
          "sc": "只要自己觉得满意就行了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1215,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47506,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47513,
          "spk": "茶梅 (サザンカ)",
          "ja": "もしかして、エントリーしてない感じ？",
          "tc": "難道你沒報名參加嗎？",
          "sc": "难道你没报名参加吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47524,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんだ、家畜育ててるって話だったから",
          "tc": "什麼嘛，因為聽說你有養家畜，",
          "sc": "什么嘛，因为听说你有养家畜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47531,
          "spk": "茶梅 (サザンカ)",
          "ja": "どれくらい立派なのか",
          "tc": "所以我本來還很期待能看到",
          "sc": "所以我本来还很期待能看到"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47538,
          "spk": "茶梅 (サザンカ)",
          "ja": "期待してたんだけど……",
          "tc": "你養的家畜是什麼樣子呢……",
          "sc": "你养的家畜是什么样子呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 47549,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、いっか",
          "tc": "算了，",
          "sc": "算了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 47556,
          "spk": "茶梅 (サザンカ)",
          "ja": "今度、個人的に見せてよね",
          "tc": "你下次記得在私底下讓我看看喔。",
          "sc": "你下次记得在私底下让我看看哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1216,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47580,
          "spk": "茶梅 (サザンカ)",
          "ja": "最高ランクか～",
          "tc": "你拿到最高級的評分啦～",
          "sc": "你拿到最高级的评分啦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47587,
          "spk": "茶梅 (サザンカ)",
          "ja": "やったじゃん、<player>",
          "tc": "太好了呢，<player>。",
          "sc": "太好了呢，<player>。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 47596,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタ、生き物を育てたりすんの",
          "tc": "在養育生物這方面，",
          "sc": "在养育生物这方面，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 47603,
          "spk": "茶梅 (サザンカ)",
          "ja": "得意なんだね",
          "tc": "你很有才華耶。",
          "sc": "你挺有才华的嘛。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 47614,
          "spk": "茶梅 (サザンカ)",
          "ja": "ね～、なんかコツとかあんの？",
          "tc": "問你喔～你是不是有什麼訣竅啊？",
          "sc": "问你哦～你是不是有什么诀窍啊？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 47621,
          "spk": "茶梅 (サザンカ)",
          "ja": "よかったら、今度教えてよ",
          "tc": "不介意的話，你下次就告訴我吧。",
          "sc": "不介意的话，你下次就告诉我吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1217,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0155",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 47645,
          "spk": "茶梅 (サザンカ)",
          "ja": "え～？",
          "tc": "咦～？",
          "sc": "咦～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 47652,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>の動物、最高ランクじゃないんだ",
