      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98261,
          "spk": "堇怜 (スミレ)",
          "ja": "今日の朝ご飯も美味くできた",
          "tc": "今天的早餐也做得很好吃。",
          "sc": "今天的早餐也做得很好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98272,
          "spk": "堇怜 (スミレ)",
          "ja": "でもさすがに塩味に飽きてきたな……",
          "tc": "但果然有點吃膩鹽味了啊……",
          "sc": "但果然有点吃腻盐味了啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98279,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は味付けを変えてみるか……",
          "tc": "明天換個調味方式看看……",
          "sc": "明天换个调味方式看看……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2688,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98310,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱり朝はちゃんと食べないとね",
          "tc": "果然早餐就該好好吃一頓，",
          "sc": "果然早餐就该好好吃一顿，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98317,
          "spk": "堇怜 (スミレ)",
          "ja": "頭も体も働かないんだよな",
          "tc": "不然腦袋和身體都沒辦法動起來。",
          "sc": "不然脑袋和身体都没办法动起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2689,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98341,
          "spk": "堇怜 (スミレ)",
          "ja": "これだけ掃除すれば十分でしょ",
          "tc": "打掃到這個程度應該就夠了吧。",
          "sc": "打扫到这个程度应该就够了吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98352,
          "spk": "堇怜 (スミレ)",
          "ja": "キスケさん、お駄賃弾んでくれないかなぁ",
          "tc": "不知道木助哥會不會多給點小費。",
          "sc": "不知道木助哥会不会多给点小费。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2690,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98376,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は釣りに行こうと思ってたけど……",
          "tc": "今天原本想去釣魚的說……",
          "sc": "今天原本想去钓鱼的说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98383,
          "spk": "堇怜 (スミレ)",
          "ja": "まあ、手入れもしたかったからいいか",
          "tc": "算了，反正本來就打算要來保養釣具了。",
          "sc": "算了，反正本来就打算要来保养钓具了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2691,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98414,
          "spk": "堇怜 (スミレ)",
          "ja": "この釣り竿……",
          "tc": "這根釣竿……",
          "sc": "这根钓竿……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98421,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがにボロくなってきたなぁ……",
          "tc": "開始變舊了啊……",
          "sc": "开始变旧了啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98432,
          "spk": "堇怜 (スミレ)",
          "ja": "誰かおさがりをくれたり……しないか",
          "tc": "搞不好會有人把舊的讓給我……沒有這回事嗎。",
          "sc": "说不定会有人把旧的让给我……没有这回事吗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2692,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98463,
          "spk": "堇怜 (スミレ)",
          "ja": "明日に備えて、釣り具の準備してるんだ",
          "tc": "我正在準備明天要用的釣具。",
          "sc": "我正在准备明天要用的钓具。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98470,
          "spk": "堇怜 (スミレ)",
          "ja": "手入れしておかないと、ヤツらは釣れないからね",
          "tc": "不好好保養，可是沒辦法釣起魚的。",
          "sc": "不好好保养，可是没办法钓起鱼的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98488,
          "spk": "堇怜 (スミレ)",
          "ja": "今日釣りに行けなかった分、魚が増えてるはず！",
          "tc": "既然今天沒去釣，我想魚應該有變多了！",
          "sc": "既然今天没去钓，我想鱼应该有变多了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 98495,
          "spk": "堇怜 (スミレ)",
          "ja": "明日はいっぱい釣るぞー！",
          "tc": "明天要釣很多魚喔——！",
          "sc": "明天要钓很多鱼喔——！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2693,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1123",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98526,
          "spk": "堇怜 (スミレ)",
          "ja": "ふう、動き回って疲れた……",
          "tc": "呼，跑來跑去的真累……",
          "sc": "呼，跑来跑去的真累……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98544,
          "spk": "堇怜 (スミレ)",
          "ja": "一休みしたら次は何をしよう？",
          "tc": "稍微休息一下之後要做什麼好呢？",
          "sc": "稍微休息一下之后要做什么好呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98551,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、時間が惜しいよ",
          "tc": "唉，時間寶貴，",
          "sc": "唉，时间宝贵，"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2694,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1124",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98575,
          "spk": "堇怜 (スミレ)",
          "ja": "このあとは弓の練習をしようかな",
          "tc": "晚點來練習射箭好了。",
          "sc": "晚点来练习射箭好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98582,
          "spk": "堇怜 (スミレ)",
          "ja": "でも水切りの新記録にも挑戦したいしな……",
          "tc": "不過我也想挑戰打水漂的新紀錄……",
          "sc": "不过我也想挑战打水漂的新纪录……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2695,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1125",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98613,
          "spk": "堇怜 (スミレ)",
          "ja": "はあ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98620,
          "spk": "堇怜 (スミレ)",
          "ja": "朝から動き回ってたから、お腹が空いちゃった",
          "tc": "從早上開始就到處跑，肚子有點餓，",
          "sc": "从早上开始就到处跑，肚子有点饿，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98638,
          "spk": "堇怜 (スミレ)",
          "ja": "おやつでも買ってこうかな……",
          "tc": "去買點心好了……",
          "sc": "去买点心好了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 98645,
          "spk": "堇怜 (スミレ)",
          "ja": "でも無駄遣いになっちゃうしな……",
          "tc": "但那樣會變成浪費了……",
          "sc": "但那样会变成浪费了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2696,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98669,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコに教えてもらった",
          "tc": "駒子教我的",
          "sc": "驹子教我的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98676,
          "spk": "堇怜 (スミレ)",
          "ja": "引き方はもっとこう……",
          "tc": "拉弓方法比較像是……",
          "sc": "拉弓方法比较像是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98687,
          "spk": "堇怜 (スミレ)",
          "ja": "うん、こんな感じじゃない？",
          "tc": "嗯，應該是這樣吧？",
          "sc": "嗯，应该是这样吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2697,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98711,
          "spk": "堇怜 (スミレ)",
          "ja": "前よりはうまくなってきた気がするけど",
          "tc": "雖然覺得有比之前進步了，",
          "sc": "虽然觉得有比之前进步了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98718,
          "spk": "堇怜 (スミレ)",
          "ja": "自分だけじゃよくわからないや",
          "tc": "但光靠我自己也不太清楚。",
          "sc": "但光靠我自己也不太清楚。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98729,
          "spk": "堇怜 (スミレ)",
          "ja": "ねえ<player>、ちょっと見ててよ",
          "tc": "<player>，你幫我看看吧。",
          "sc": "<player>，你帮我看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2698,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98753,
          "spk": "堇怜 (スミレ)",
          "ja": "いてて……",
          "tc": "好痛……",
          "sc": "好痛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98760,
          "spk": "堇怜 (スミレ)",
          "ja": "練習しすぎて、指がちょっと痛いや",
          "tc": "練習過頭，手指有點痛。",
          "sc": "练习过头，手指有点痛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98771,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコはどうやって慣れたんだろ……",
          "tc": "駒子是怎麼習慣的啊……",
          "sc": "驹子是怎么习惯的啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98778,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の指も、いつか強くなるのかな……",
          "tc": "我的手指力氣也會有變強的一天嗎……",
          "sc": "我的手指力气也会有变强的一天吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2699,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98809,
          "spk": "堇怜 (スミレ)",
          "ja": "新しい餌も用意したし……",
          "tc": "今天準備了新的魚餌……",
          "sc": "今天准备了新的鱼饵……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98816,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はたくさん釣れる気がする！",
          "tc": "總覺得可以釣到很多魚！",
          "sc": "总觉得可以钓到很多鱼！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2700,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98847,
          "spk": "堇怜 (スミレ)",
          "ja": "僕の分と姉さんの分",
          "tc": "希望至少能釣到我的跟姊姊的份，",
          "sc": "希望至少能钓到我的跟姐姐的份，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98854,
          "spk": "堇怜 (スミレ)",
          "ja": "せめて一匹ずつは釣りたいな……",
          "tc": "一人一條啊……",
          "sc": "一人一条啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2701,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98878,
          "spk": "堇怜 (スミレ)",
          "ja": "釣り具の準備は万端",
          "tc": "釣具都準備好了，",
          "sc": "钓具都准备好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98885,
          "spk": "堇怜 (スミレ)",
          "ja": "川底には魚の気配もある",
          "tc": "河中也有看到魚影。",
          "sc": "河中也能隐约瞧见鱼影。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98896,
          "spk": "堇怜 (スミレ)",
          "ja": "あとはリンが高値で買ってくれる",
          "tc": "再來就只差釣起",
          "sc": "再来就只差钓起"
        },
        {
          "f_idx": 3,
          "pidx_tc": 98903,
          "spk": "堇怜 (スミレ)",
          "ja": "魚を釣るだけだね",
          "tc": "林願意高價收購的魚了。",
          "sc": "林愿意高价收购的鱼了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2702,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98927,
          "spk": "堇怜 (スミレ)",
          "ja": "とびきり美味そうな魚を釣れたら",
          "tc": "如果我釣到了看起來很美味的魚，",
          "sc": "如果我钓到了看起来很美味的鱼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98934,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>に食べてもらいたいんだ",
          "tc": "希望<player>能嘗嘗看。",
          "sc": "希望<player>能尝尝看。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 98945,
          "spk": "堇怜 (スミレ)",
          "ja": "だから僕のこと応援しててくれよな！",
          "tc": "所以幫我加油吧！",
          "sc": "所以帮我加油吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2703,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 98969,
          "spk": "堇怜 (スミレ)",
          "ja": "なかなか釣れないな……",
          "tc": "都釣不到呢……",
          "sc": "都钓不到呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 98976,
          "spk": "堇怜 (スミレ)",
          "ja": "別のポイントに移ったほうがいいかもな？",
          "tc": "也許換個地方釣比較好？",
          "sc": "也许换个地方钓比较好？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2704,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99000,
          "spk": "堇怜 (スミレ)",
          "ja": "あっ、釣竿が反応した！",
          "tc": "啊，釣竿在動了！",
          "sc": "啊，钓竿在动了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99011,
          "spk": "堇怜 (スミレ)",
          "ja": "……いや、気のせいか",
          "tc": "……只是錯覺嗎。",
          "sc": "……只是错觉吗。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99018,
          "spk": "堇怜 (スミレ)",
          "ja": "まだまだ釣れなさそうだなぁ",
          "tc": "看來沒麼容易釣到啊。",
          "sc": "看来没么容易钓到啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2705,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99042,
          "spk": "堇怜 (スミレ)",
          "ja": "食堂に来るたびに思うけど、",
          "tc": "每次來到餐廳我都覺得，",
          "sc": "每次来到餐厅我都觉得，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99049,
          "spk": "堇怜 (スミレ)",
          "ja": "ロッカクさんのご飯は",
          "tc": "六角叔做的飯",
          "sc": "六角叔做的饭"
        },
        {
          "f_idx": 2,
          "pidx_tc": 99056,
          "spk": "堇怜 (スミレ)",
          "ja": "具材がたっぷり入ってて美味いね！",
          "tc": "料放得很足，真的很好吃！",
          "sc": "料放得很足，真的很好吃！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2706,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99080,
          "spk": "堇怜 (スミレ)",
          "ja": "部屋の掃除をしたかったんだけど",
          "tc": "我本來想打掃房間的，",
          "sc": "我本来想打扫房间的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 99087,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は無理かもな……",
          "tc": "但今天應該沒辦法了……",
          "sc": "但今天应该没办法了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2707,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 99111,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は釣りをして、そのあとは……",
