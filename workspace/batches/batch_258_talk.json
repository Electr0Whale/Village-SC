    {
      "file": "talk.dat",
      "rec_idx": 7163,
      "rec_id": "TALK_ID_70_2060_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409100,
          "spk": "驹子 (コマコ)",
          "ja": "ねえ、<player>……",
          "tc": "欸，<player>……",
          "sc": "诶，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409107,
          "spk": "驹子 (コマコ)",
          "ja": "もう寝ちゃった……？",
          "tc": "你睡著了嗎……？",
          "sc": "你睡着了吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409116,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409123,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7164,
      "rec_id": "TALK_ID_70_2060_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409185,
          "spk": "驹子 (コマコ)",
          "ja": "眠くなるまでおしゃべりしようよ",
          "tc": "在睡著之前，我們就來聊天吧。",
          "sc": "在睡着之前，我们就来聊天吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409194,
          "spk": "驹子 (コマコ)",
          "ja": "……今日はごめんね？",
          "tc": "……今天真的很抱歉，",
          "sc": "……今天真的很抱歉，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409201,
          "spk": "驹子 (コマコ)",
          "ja": "急に二人きりになっちゃって",
          "tc": "突然就剩下我們兩個了。",
          "sc": "突然就剩下我们两个了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409210,
          "spk": "驹子 (コマコ)",
          "ja": "わかんないけど……",
          "tc": "雖然我不太確定……",
          "sc": "虽然我不太确定……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409217,
          "spk": "驹子 (コマコ)",
          "ja": "たぶん、お兄ちゃん、わざとだと思う……",
          "tc": "但我猜哥哥他應該是故意的……",
          "sc": "但我猜哥哥他应该是故意的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7165,
      "rec_id": "TALK_ID_70_2060_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409233,
          "spk": "驹子 (コマコ)",
          "ja": "私と<player>に",
          "tc": "因為他有說過，",
          "sc": "因为他有说过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409240,
          "spk": "驹子 (コマコ)",
          "ja": "もっと仲良くなってほしいって",
          "tc": "希望我和<player>的感情",
          "sc": "希望我和<player>的感情"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409247,
          "spk": "驹子 (コマコ)",
          "ja": "言ってたから……",
          "tc": "能再更好一些……",
          "sc": "能再更好一些……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409256,
          "spk": "驹子 (コマコ)",
          "ja": "ふふ、おせっかいだよねぇ",
          "tc": "呵呵，他很雞婆對吧。",
          "sc": "呵呵，他很鸡婆对吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409263,
          "spk": "驹子 (コマコ)",
          "ja": "心配しなくても、もう仲良しなのに",
          "tc": "其實我們早就很要好了，他可以不用操這個心的。",
          "sc": "其实我们早就很要好了，他可以不用操这个心的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409272,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7166,
      "rec_id": "TALK_ID_70_2060_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409288,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409295,
          "spk": "驹子 (コマコ)",
          "ja": "いつもありがとう",
          "tc": "謝謝你一直以來都在幫助我。",
          "sc": "谢谢你一直以来都在帮助我。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409304,
          "spk": "驹子 (コマコ)",
          "ja": "前に、リンに謝る時に",
          "tc": "像是之前我去跟林道歉的時候，",
          "sc": "像是之前我去跟林道歉的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409311,
          "spk": "驹子 (コマコ)",
          "ja": "助けてもらったりとか",
          "tc": "你也有幫忙。",
          "sc": "你也有帮忙。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409320,
          "spk": "驹子 (コマコ)",
          "ja": "私が祠でお祈りをした時、",
          "tc": "我在祠堂許願的時候，",
          "sc": "我在祠堂许愿的时候，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409327,
          "spk": "驹子 (コマコ)",
          "ja": "優しく見守ってくれたりとか……",
          "tc": "你也很溫柔地在一旁看著我……",
          "sc": "你也很温柔地在一旁看着我……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409336,
          "spk": "驹子 (コマコ)",
          "ja": "すごくありがたいなって思ってるの",
          "tc": "我真的非常感謝你。",
          "sc": "我真的非常感谢你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7167,
      "rec_id": "TALK_ID_70_2060_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409352,
          "spk": "驹子 (コマコ)",
          "ja": "私も<player>みたいに、",
          "tc": "我也想像<player>一樣，",
          "sc": "我也想像<player>一样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409359,
          "spk": "驹子 (コマコ)",
          "ja": "みんなを助けられる人になりたい",
          "tc": "成為一個能夠幫助大家的人。",
          "sc": "成为一个能够帮助大家的人。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409368,
          "spk": "驹子 (コマコ)",
          "ja": "もちろん、<player>のこともね",
          "tc": "當然了，<player>你也是喔。",
          "sc": "当然了，<player>你也是哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409384,
          "spk": "驹子 (コマコ)",
          "ja": "困った時は、いつでも言って",
          "tc": "如果你有困難，隨時都可以告訴我。",
          "sc": "如果你有困难，随时都可以告诉我。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409391,
          "spk": "驹子 (コマコ)",
          "ja": "絶対に<player>の力になるから",
          "tc": "我一定會幫<player>你的。",
          "sc": "我一定会帮<player>你的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409400,
          "spk": "驹子 (コマコ)",
          "ja": "ふふ……",
          "tc": "呵呵……",
          "sc": "呵呵……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 409407,
          "spk": "驹子 (コマコ)",
          "ja": "伝えたかったこと、ちゃんと言えた……",
          "tc": "我想講的都有好好說出口了呢……",
          "sc": "我想讲的都有好好说出口了呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7168,
      "rec_id": "TALK_ID_70_2060_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409427,
          "spk": "驹子 (コマコ)",
          "ja": "ん～……ふわぁあ……",
          "tc": "嗯～……呼啊～……",
          "sc": "嗯～……呼啊～……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409438,
          "spk": "驹子 (コマコ)",
          "ja": "えへへ……お泊り楽しかったね",
          "tc": "欸嘿嘿……一起過夜好好玩喔。",
          "sc": "诶嘿嘿……一起过夜好好玩哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409449,
          "spk": "驹子 (コマコ)",
          "ja": "またいつでも来てね",
          "tc": "你隨時都可以再過來住喔，",
          "sc": "你随时都可以再过来住哦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409456,
          "spk": "驹子 (コマコ)",
          "ja": "待ってるよ！",
          "tc": "我等你！",
          "sc": "我等你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7169,
      "rec_id": "TALK_ID_70_2070_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 431506,
          "spk": "茶梅 (サザンカ)",
          "ja": "はぁ～……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 431513,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんか今朝からずっとダルくってさ～",
          "tc": "總覺得今天從一早就好累～",
          "sc": "总觉得今天从一早就好累～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 431526,
          "spk": "四郎治 (シロージ)",
          "ja": "また朝まで発明でもしてて、",
          "tc": "八成又熬夜在搞發明，",
          "sc": "八成又熬夜在搞发明，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 431533,
          "spk": "四郎治 (シロージ)",
          "ja": "寝不足なんじゃないのか？",
          "tc": "所以睡眠不足吧？",
          "sc": "所以睡眠不足吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 431553,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、それもあるんだけど……",
          "tc": "雖然是這樣沒錯……",
          "sc": "虽然是这样没错……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 431560,
          "spk": "茶梅 (サザンカ)",
          "ja": "昨日、ずっと埋蔵金探し回ってたから",
          "tc": "昨天為了尋找地下寶藏到處跑，",
          "sc": "昨天为了寻找地下宝藏到处跑，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 431567,
          "spk": "茶梅 (サザンカ)",
          "ja": "その疲れが抜けてないのかも",
          "tc": "大概因為這樣疲勞還沒恢復吧。",
          "sc": "大概因为这样疲劳还没恢复吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 431580,
          "spk": "四郎治 (シロージ)",
          "ja": "よくもまあ懲りねぇな……",
          "tc": "妳還真是學不乖啊……",
          "sc": "你还真是学不乖啊……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 431587,
          "spk": "四郎治 (シロージ)",
          "ja": "そんなダルいなら今日は店を",
          "tc": "既然這麼累，",
          "sc": "既然这么累，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 431594,
          "spk": "四郎治 (シロージ)",
          "ja": "閉めたらどうだ？",
          "tc": "那今天乾脆別開店了吧？",
          "sc": "那今天干脆别开店了吧？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 431607,
          "spk": "茶梅 (サザンカ)",
          "ja": "店は村の生命線だって",
          "tc": "爺爺說過，",
          "sc": "爷爷说过，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 431614,
          "spk": "茶梅 (サザンカ)",
          "ja": "じいちゃんが言ってたし、",
          "tc": "這家店是村子的命脈，",
          "sc": "这家店是村子的命脉，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 431621,
          "spk": "茶梅 (サザンカ)",
          "ja": "急には休めないっしょ",
          "tc": "不能說休息就休息吧。",
          "sc": "不能说休息就休息吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 431634,
          "spk": "四郎治 (シロージ)",
          "ja": "律儀なもんだ……",
          "tc": "還真是一板一眼……",
          "sc": "还真是一板一眼……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 431647,
          "spk": "茶梅 (サザンカ)",
          "ja": "それに昨日も休んでるんだよ？",
          "tc": "何況昨天也休息了啊？",
          "sc": "何况昨天也休息了啊？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 431654,
          "spk": "茶梅 (サザンカ)",
          "ja": "連日お休みはできないって",
          "tc": "沒辦法連續休息好幾天啦。",
          "sc": "没办法连续休息好几天啦。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 431674,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、お前がそれでいいならいいが……",
          "tc": "妳覺得好就好……",
          "sc": "你觉得好就好……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 431681,
          "spk": "四郎治 (シロージ)",
          "ja": "ただ――",
          "tc": "只不過──",
          "sc": "只不过——"
        },
        {
          "f_idx": 20,
          "pidx_tc": 431694,
          "spk": "茶梅 (サザンカ)",
          "ja": "それで体調崩して",
          "tc": "萬一因此搞壞身體",
          "sc": "万一因此搞坏身体"
        },
        {
          "f_idx": 21,
          "pidx_tc": 431701,
          "spk": "茶梅 (サザンカ)",
          "ja": "臨時休業になったら世話ないって？",
          "tc": "變成要臨時公休不是更糟嗎？",
          "sc": "变成要临时休息不是更糟吗？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 431719,
          "spk": "茶梅 (サザンカ)",
          "ja": "わかってるって",
          "tc": "我知道啦。",
          "sc": "我知道啦。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 431732,
          "spk": "四郎治 (シロージ)",
          "ja": "なら、あんま無理すんなよ",
          "tc": "既然如此，就別太勉強了。",
          "sc": "既然如此，就别太勉强了。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 431743,
          "spk": "茶梅 (サザンカ)",
          "ja": "はいはい",
          "tc": "好好好。",
          "sc": "好好好。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 431756,
          "spk": "四郎治 (シロージ)",
          "ja": "……そろそろ休憩も終わりだな",
          "tc": "……差不多休息夠了。",
          "sc": "……差不多休息够了。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 431763,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ",
          "tc": "我走了。",
          "sc": "我走了。"
        },
        {
          "f_idx": 28,
          "pidx_tc": 431776,
          "spk": "茶梅 (サザンカ)",
          "ja": "バイバ～イ",
          "tc": "掰掰～",
          "sc": "掰掰～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7170,
      "rec_id": "TALK_ID_70_2070_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 431802,
          "spk": "茶梅 (サザンカ)",
          "ja": "おっ、なに？",
          "tc": "哦，怎麼了？",
          "sc": "哦，怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 431809,
          "spk": "茶梅 (サザンカ)",
          "ja": "うちに買い物？",
          "tc": "來買東西嗎？",
          "sc": "来买东西吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7171,
      "rec_id": "TALK_ID_70_2070_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 431827,
          "spk": "茶梅 (サザンカ)",
          "ja": "どしたのさ、そんな不安な顔して……",
