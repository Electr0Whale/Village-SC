  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7161,
      "rec_id": "TALK_ID_70_2060_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409023,
          "spk": "驹子 (コマコ)",
          "ja": "付き合わせてごめんね",
          "tc": "抱歉讓你陪我到這麼晚。",
          "sc": "抱歉让你陪我到这么晚。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409030,
          "spk": "驹子 (コマコ)",
          "ja": "もう、眠たいよね",
          "tc": "很睏了吧。",
          "sc": "很困了吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409041,
          "spk": "驹子 (コマコ)",
          "ja": "えっと……ちょっと狭いかもしれないけど、",
          "tc": "呃……雖然空間不大，",
          "sc": "呃……虽然空间不大，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409048,
          "spk": "驹子 (コマコ)",
          "ja": "寝床は私のベッドでいいかな？",
          "tc": "但可以睡在我的床上嗎？",
          "sc": "但可以睡在我的床上吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409057,
          "spk": "驹子 (コマコ)",
          "ja": "私、寝相が悪いから……",
          "tc": "但我睡相很差……",
          "sc": "但我睡相很差……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409064,
          "spk": "驹子 (コマコ)",
          "ja": "寝てるところ、蹴っちゃったらごめんね……",
          "tc": "抱歉，睡到一半可能會踢你……",
          "sc": "抱歉，睡到一半可能会踢你……"
        }
      ]
    },
