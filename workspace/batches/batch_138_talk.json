      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 84981,
          "spk": "洋 (ヨウ)",
          "ja": "図書館で借りたの、どれだっけ",
          "tc": "從圖書館借的是哪一本呢？",
          "sc": "从图书馆借的是哪一本呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 84988,
          "spk": "洋 (ヨウ)",
          "ja": "そろそろ返しに行かなくちゃ",
          "tc": "差不多該拿去還了。",
          "sc": "差不多该拿去还了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2167,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1003",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85012,
          "spk": "洋 (ヨウ)",
          "ja": "専用コインの残りは……",
          "tc": "專用硬幣……",
          "sc": "专用硬币……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85019,
          "spk": "洋 (ヨウ)",
          "ja": "……あと一枚",
          "tc": "……只剩下一枚了。",
          "sc": "……只剩下一枚了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85030,
          "spk": "洋 (ヨウ)",
          "ja": "……もう一回だけ回してみようかな",
          "tc": "……再轉一次看看好了。",
          "sc": "……再转一次看看好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2168,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1004",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85054,
          "spk": "洋 (ヨウ)",
          "ja": "今、サザンカさんは忙しいかな？",
          "tc": "茶梅姐姐現在很忙嗎？",
          "sc": "茶梅姐姐现在很忙吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85061,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけなら、",
          "tc": "不知道她願不願意",
          "sc": "不知道她愿不愿意"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85068,
          "spk": "洋 (ヨウ)",
          "ja": "わたしとお話してくれないかな……",
          "tc": "陪我說一下話……",
          "sc": "陪我说一下话……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2169,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1005",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85092,
          "spk": "洋 (ヨウ)",
          "ja": "この機械……",
          "tc": "這台機器……",
          "sc": "这台机器……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85099,
          "spk": "洋 (ヨウ)",
          "ja": "こんなに古いのにまだ動くんだよ",
          "tc": "明明這麼舊了，卻還能動呢。",
          "sc": "明明这么旧了，却还能动呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85110,
          "spk": "洋 (ヨウ)",
          "ja": "いつからここに置いてあるんだろう？",
          "tc": "到底是從什麼時候開始放在這裡的呢？",
          "sc": "到底是从什么时候开始放在这里的呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2170,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85134,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、今日も忙しそう",
          "tc": "叔叔今天好像也很忙。",
          "sc": "叔叔今天好像也很忙。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85145,
          "spk": "洋 (ヨウ)",
          "ja": "……なにか、お手伝いできないかな",
          "tc": "……有沒有我能幫上忙的呢？",
          "sc": "……有没有我能帮上忙的呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2171,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85169,
          "spk": "洋 (ヨウ)",
          "ja": "わあ、お魚がいっぱい動いてる",
          "tc": "哇，有好多魚在動。",
          "sc": "哇，有好多鱼在动。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85176,
          "spk": "洋 (ヨウ)",
          "ja": "雨の音にびっくりしてるのかなあ",
          "tc": "是不是被雨聲嚇到了呢？",
          "sc": "是不是被雨声吓到了呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2172,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85200,
          "spk": "洋 (ヨウ)",
          "ja": "靴の中、雨が入ってちゃぷちゃぷ音がするの",
          "tc": "水跑進鞋子裡發出的聲音，",
          "sc": "水跑进鞋子里发出的声音，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85207,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、ちょっとだけ楽しいかも",
          "tc": "總覺得滿有趣的。",
          "sc": "总觉得满有趣的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2173,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85238,
          "spk": "洋 (ヨウ)",
          "ja": "雨の日の外って、少し寂しいね",
          "tc": "下雨天外面有點冷清呢，",
          "sc": "下雨天外面有点冷清呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85245,
          "spk": "洋 (ヨウ)",
          "ja": "みんな、お家でじっとしてるのかな",
          "tc": "大家都乖乖待在家裡嗎？",
          "sc": "大家都乖乖待在家里吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2174,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1023",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85276,
          "spk": "洋 (ヨウ)",
          "ja": "わ、お魚が跳ねてる",
          "tc": "哇，有魚跳起來了。",
          "sc": "哇，有鱼跳起来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85287,
          "spk": "洋 (ヨウ)",
          "ja": "ここに釣り糸を垂らしたら、",
          "tc": "如果在這裡釣魚，",
          "sc": "如果在这里钓鱼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85294,
          "spk": "洋 (ヨウ)",
          "ja": "あの子が釣れるのかなぁ？",
          "tc": "不知道能不能釣到剛剛那條魚？",
          "sc": "不知道能不能钓到刚刚那条鱼？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2175,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1024",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85318,
          "spk": "洋 (ヨウ)",
          "ja": "水面がキラキラして、きれい",
          "tc": "水面閃閃發亮的，好漂亮。",
          "sc": "水面闪闪发亮的，好漂亮。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85329,
          "spk": "洋 (ヨウ)",
          "ja": "まるで宝石みたいだね",
          "tc": "看起來就像寶石一樣呢。",
          "sc": "看起来就像宝石一样呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2176,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1025",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85353,
          "spk": "洋 (ヨウ)",
          "ja": "……今なら水切り三回",
          "tc": "……現在打水漂的話",
          "sc": "……现在打水漂的话"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85360,
          "spk": "洋 (ヨウ)",
          "ja": "いけるかな……",
          "tc": "不知道能不能彈三下……",
          "sc": "不知道能不能弹三下……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85367,
          "spk": "洋 (ヨウ)",
          "ja": "まずは平らな小石を探さなきゃ……",
          "tc": "要先來找個扁平的小石頭才行……",
          "sc": "要先来找个扁平的小石头才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2177,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85391,
          "spk": "洋 (ヨウ)",
          "ja": "折り紙って、ふしぎ",
          "tc": "摺紙真是不可思議。",
          "sc": "折纸真是不可思议。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85398,
          "spk": "洋 (ヨウ)",
          "ja": "こうやってパタパタ折るだけで、",
          "tc": "只要像這樣摺來摺去，",
          "sc": "只要像这样折来折去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85405,
          "spk": "洋 (ヨウ)",
          "ja": "色んな形になれるんだもん",
          "tc": "就能變成各種形狀呢。",
          "sc": "就能变成各种形状呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2178,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85429,
          "spk": "洋 (ヨウ)",
          "ja": "スミレくんが前に、",
          "tc": "堇怜哥哥之前做了紙船，",
          "sc": "堇怜哥哥之前做了纸船，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85436,
          "spk": "洋 (ヨウ)",
          "ja": "紙のお船を川に浮かべてたけど……",
          "tc": "然後把它放進河裡漂……",
          "sc": "然后把它放进河里漂……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85447,
          "spk": "洋 (ヨウ)",
          "ja": "水で溶けちゃわないのかな？",
          "tc": "但紙船碰到水不會融化掉嗎？",
          "sc": "但纸船碰到水不会融化掉吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2179,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85478,
          "spk": "洋 (ヨウ)",
          "ja": "そうだ、お花を折ろう",
          "tc": "對了，來摺花好了。",
          "sc": "对了，来折花好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85489,
          "spk": "洋 (ヨウ)",
          "ja": "紙のお花なら枯れないし、",
          "tc": "紙做的花不會枯萎，",
          "sc": "纸做的花不会枯萎，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85496,
          "spk": "洋 (ヨウ)",
          "ja": "ずっと飾っていられるもんね",
          "tc": "可以一直裝飾著。",
          "sc": "可以一直装饰着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2180,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85520,
          "spk": "洋 (ヨウ)",
          "ja": "このお人形さんたちとも、",
          "tc": "如果也能和這些玩偶",
          "sc": "如果也能和这些玩偶"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85527,
          "spk": "洋 (ヨウ)",
          "ja": "一緒にお喋りできたらいいのに",
          "tc": "一起聊聊天就好了。",
          "sc": "一起聊聊天就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2181,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85551,
          "spk": "洋 (ヨウ)",
          "ja": "一人が寂しいときは、こうして",
          "tc": "我一個人很寂寞的時候，",
          "sc": "我一个人很寂寞的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85558,
          "spk": "洋 (ヨウ)",
          "ja": "お人形さんと遊んでるの",
          "tc": "就會像這樣跟玩偶玩。",
          "sc": "就会像这样跟玩偶玩。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85569,
          "spk": "洋 (ヨウ)",
          "ja": "ピヨピヨ……",
          "tc": "嗶嗶……",
          "sc": "哔哔……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 85576,
          "spk": "洋 (ヨウ)",
          "ja": "ヨウちゃん、いっしょにかくれんぼしよ……",
          "tc": "小洋，一起玩躲迷藏吧……",
          "sc": "小洋，一起玩躲迷藏吧……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 85587,
          "spk": "洋 (ヨウ)",
          "ja": "……ううう",
          "tc": "……嗚嗚嗚……",
          "sc": "……呜呜呜……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 85594,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか悲しくなってきた",
          "tc": "感覺的有點難過了起來。",
          "sc": "感觉的有点难过了起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2182,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85618,
          "spk": "洋 (ヨウ)",
          "ja": "あ、この子の目、とれちゃいそう",
          "tc": "啊，這個孩子的眼睛快掉了。",
          "sc": "啊，这个孩子的眼睛快掉了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85636,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが直してあげられればいいんだけど……",
          "tc": "要是我有辦法自己修補就好了……",
          "sc": "要是我有办法自己修补就好了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 85643,
          "spk": "洋 (ヨウ)",
          "ja": "あとでおじちゃんに相談してみよう",
          "tc": "晚點去找叔叔商量吧。",
          "sc": "晚点去找叔叔商量吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2183,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85667,
          "spk": "洋 (ヨウ)",
          "ja": "まだかな、まだかな……",
          "tc": "還沒來嗎，還沒來嗎……？",
          "sc": "还没来吗，还没来吗……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85674,
          "spk": "洋 (ヨウ)",
          "ja": "コマコちゃん、まだ来ないかな……",
          "tc": "駒子姐姐還不來嗎……",
          "sc": "驹子姐姐还不来吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2184,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85698,
          "spk": "洋 (ヨウ)",
          "ja": "今日はなにが釣れるかな……",
          "tc": "今天會釣到什麼呢……？",
          "sc": "今天会钓到什么呢……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 85709,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんは待つのが釣りのダイゴミ？",
          "tc": "雖然叔叔說等待才是釣魚的樂趣所在，",
          "sc": "虽然叔叔说等待才是钓鱼的乐趣所在，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85716,
          "spk": "洋 (ヨウ)",
          "ja": "って言うけれど、釣れたほうが絶対楽しいよね",
          "tc": "但釣到了肯定會更開心吧。",
          "sc": "但钓到了肯定会更开心吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2185,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85747,
          "spk": "洋 (ヨウ)",
          "ja": "川にお日様がキラキラ反射して、きれい",
          "tc": "太陽公公讓水面閃閃發光的，好漂亮喔。",
          "sc": "太阳公公让水面闪闪发光的，好漂亮哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85765,
          "spk": "洋 (ヨウ)",
          "ja": "でもこれじゃ、お魚が見えないね",
          "tc": "但是這樣就看不見魚了。",
          "sc": "但是这样就看不见鱼了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2186,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_1113",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 85796,
          "spk": "洋 (ヨウ)",
          "ja": "あ……今、ウキが動い……あれ？",
          "tc": "啊……剛剛浮標好像動了……奇怪？",
          "sc": "啊……刚刚浮标好像动了……奇怪？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 85814,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、もしかして寝ちゃってた？",
          "tc": "難道說叔叔睡著了嗎？",
          "sc": "难道说叔叔睡着了吗？"
