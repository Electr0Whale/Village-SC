      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4081,
      "rec_id": "TALK_ID_10_0201_024_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234039,
          "spk": "林 (リン)",
          "ja": "あなたが直したの？",
          "tc": "是你修的嗎？",
          "sc": "是你修的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234046,
          "spk": "林 (リン)",
          "ja": "村の神さまや文化を大切にする",
          "tc": "你這麼重視村子的神明大人與文化，",
          "sc": "你这么重视村子的神明大人与文化，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234053,
          "spk": "林 (リン)",
          "ja": "その心がけ、素晴らしいわ",
          "tc": "真是心態可嘉呢。",
          "sc": "真是心态可嘉呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4082,
      "rec_id": "TALK_ID_10_0201_024_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234071,
          "spk": "林 (リン)",
          "ja": "酷い有様だったでしょう……",
          "tc": "之前的樣子很慘對吧……",
          "sc": "之前的样子很惨对吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234078,
          "spk": "林 (リン)",
          "ja": "ここの祠、私が小さい頃は、",
          "tc": "在我小的時候，",
          "sc": "在我小的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234085,
          "spk": "林 (リン)",
          "ja": "こんな状態ではなかったの……",
          "tc": "這裡的祠堂並不是那個樣子的……",
          "sc": "这里的祠堂并不是那个样子的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 234096,
          "spk": "林 (リン)",
          "ja": "この村の神さまたちはね、",
          "tc": "只要對這個村子的",
          "sc": "只要对这个村子的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 234103,
          "spk": "林 (リン)",
          "ja": "捧げ物をすると、",
          "tc": "神明大人們獻上祭品，",
          "sc": "神明大人们献上祭品，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 234110,
          "spk": "林 (リン)",
          "ja": "どんな願いでも叶えてくれるのよ",
          "tc": "任何願望都會替我們實現。",
          "sc": "任何愿望都会替我们实现。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 234121,
          "spk": "林 (リン)",
          "ja": "だから村の神さまたちは、",
          "tc": "所以說，村子的神明大人們，",
          "sc": "所以说，村子的神明大人们，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 234128,
          "spk": "林 (リン)",
          "ja": "いつもどこかから、",
          "tc": "隨時都會在某處",
          "sc": "随时都会在某处"
        },
        {
          "f_idx": 8,
          "pidx_tc": 234135,
          "spk": "林 (リン)",
          "ja": "私たちを見守っているの……",
          "tc": "守望著我們……",
          "sc": "守望着我们……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 234144,
          "spk": "林 (リン)",
          "ja": "いつも、いつでもね……",
          "tc": "從古至今，恆久不變……",
          "sc": "从古至今，恒久不变……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4083,
      "rec_id": "TALK_ID_10_0201_024_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234168,
          "spk": "林 (リン)",
          "ja": "そうだわ、せっかくだから",
          "tc": "對了，既然都修了，",
          "sc": "对了，既然都修了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234175,
          "spk": "林 (リン)",
          "ja": "もっと綺麗に直してくれない？",
          "tc": "能不能再修得更好看一點？",
          "sc": "能不能再修得更好看一点？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234186,
          "spk": "林 (リン)",
          "ja": "新たに良い神さまがやって来て、",
          "tc": "說不定會有新的好神明大人",
          "sc": "说不定会有新的好神明大人"
        },
        {
          "f_idx": 3,
          "pidx_tc": 234193,
          "spk": "林 (リン)",
          "ja": "住んでくださるかもしれないわ",
          "tc": "降臨到這裡並居住下來呢。",
          "sc": "降临到这里并居住下来呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 234204,
          "spk": "林 (リン)",
          "ja": "そうね……鳥居でもあれば、",
          "tc": "我想想……如果有座鳥居的話，",
          "sc": "我想想……如果有座鸟居的话，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 234211,
          "spk": "林 (リン)",
          "ja": "もっと見栄えが良くなるかもしれない",
          "tc": "說不定看起來會更氣派一點。",
          "sc": "说不定看起来会更气派一点。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 234222,
          "spk": "林 (リン)",
          "ja": "これは命令ではないけれど、",
          "tc": "這不是命令，",
          "sc": "这不是命令，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 234229,
          "spk": "林 (リン)",
          "ja": "気が向いたら素材を集めて、",
          "tc": "等你有心情，再去收集材料，",
          "sc": "等你有心情，再去收集材料，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 234236,
          "spk": "林 (リン)",
          "ja": "祠を立派にしてちょうだい",
          "tc": "讓祠堂變得更加宏偉吧。",
          "sc": "让祠堂变得更加宏伟吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4084,
      "rec_id": "TALK_ID_10_0201_024_05",
      "lines": [
        {
          "f_idx": 0,
