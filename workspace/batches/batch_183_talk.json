          "pidx_tc": 234982,
          "spk": "驹子 (コマコ)",
          "ja": "ここでは他にも、",
          "tc": "另外這裡也有販賣",
          "sc": "另外这里也有贩卖"
        },
        {
          "f_idx": 9,
          "pidx_tc": 234989,
          "spk": "驹子 (コマコ)",
          "ja": "私が作った罠も売ってるんだけど、",
          "tc": "我製作的陷阱，",
          "sc": "我制作的陷阱，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 234996,
          "spk": "驹子 (コマコ)",
          "ja": "売ってあげられる個数は、制限してるんだ……",
          "tc": "但可以販售的數量是有限制的……",
          "sc": "但可以贩售的数量是有限制的……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 235007,
          "spk": "驹子 (コマコ)",
          "ja": "たくさん仕掛けたら、",
          "tc": "因為要是沒有節制的話，",
          "sc": "因为要是没有节制的话，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 235014,
          "spk": "驹子 (コマコ)",
          "ja": "山が罠だらけになっちゃうからね……",
          "tc": "山裡就會到處都是陷阱了……",
          "sc": "山里就会到处都是陷阱了……"
        }
      ]
    },
    {
      "file": "talk.dat",
