      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234293,
          "spk": "四郎治 (シロージ)",
          "ja": "んじゃ、行ってくる",
          "tc": "那我出門了。",
          "sc": "那我出门了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234306,
          "spk": "驹子 (コマコ)",
          "ja": "いってらっしゃい、お兄ちゃん",
          "tc": "路上小心，哥哥。",
          "sc": "路上小心，哥哥。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234313,
          "spk": "驹子 (コマコ)",
          "ja": "私も準備ができたら、すぐに行くから",
          "tc": "我準備好之後也會馬上過去的。",
          "sc": "我准备好之后也会马上过去的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4086,
      "rec_id": "TALK_ID_10_0202_050_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234338,
          "spk": "四郎治 (シロージ)",
          "ja": "そういえばお前、",
          "tc": "話說，",
          "sc": "话说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234345,
          "spk": "四郎治 (シロージ)",
          "ja": "罠はちゃんと手入れしたか?",
          "tc": "妳有好好保養陷阱嗎？",
          "sc": "你有好好保养陷阱吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234358,
          "spk": "驹子 (コマコ)",
          "ja": "うん、昨日のうちに、ちゃんと確認したよ",
          "tc": "嗯，我昨天有好好確認過了。",
          "sc": "嗯，我昨天有好好确认过了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 234371,
          "spk": "四郎治 (シロージ)",
          "ja": "賢い獣は、撃った矢の本数を数える",
          "tc": "聰明的野獸會記住射出的箭矢數量，",
          "sc": "聪明的野兽会记住射出的箭矢数量，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 234378,
          "spk": "四郎治 (シロージ)",
          "ja": "隠し矢も忘れずに持っていけよ",
          "tc": "不要忘記還要帶上暗箭喔。",
          "sc": "不要忘记还要带上暗箭啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 234398,
          "spk": "驹子 (コマコ)",
          "ja": "いつも一本は隠して持ってるから",
          "tc": "我平時都會藏一支箭在身上，",
          "sc": "我平时都会藏一支箭在身上，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 234405,
          "spk": "驹子 (コマコ)",
          "ja": "大丈夫だよ",
          "tc": "別擔心。",
          "sc": "别担心。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 234418,
          "spk": "四郎治 (シロージ)",
          "ja": "ハンカチは持ったか？",
          "tc": "手帕有帶嗎？",
          "sc": "手帕有带吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 234429,
          "spk": "四郎治 (シロージ)",
          "ja": "お前はよく怪我するから、",
          "tc": "畢竟妳常常受傷，",
          "sc": "毕竟你常常受伤，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 234436,
          "spk": "四郎治 (シロージ)",
          "ja": "絆創膏もあったほうが……",
          "tc": "最好再帶個OK繃……",
          "sc": "最好再带个OK绷……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 234449,
          "spk": "驹子 (コマコ)",
          "ja": "お、お兄ちゃん……",
          "tc": "哥、哥哥……",
          "sc": "哥、哥哥……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 234456,
          "spk": "驹子 (コマコ)",
          "ja": "毎日心配しすぎだよ……",
          "tc": "你每天都太過擔心了啦……",
          "sc": "你每天都太过担心了啦……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 234469,
          "spk": "四郎治 (シロージ)",
          "ja": "ム……すまん",
          "tc": "唔……抱歉。",
          "sc": "唔……抱歉。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4087,
      "rec_id": "TALK_ID_10_0202_050_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234489,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234496,
          "spk": "驹子 (コマコ)",
          "ja": "いらっしゃい",
          "tc": "歡迎你來。",
          "sc": "欢迎你来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 234509,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんから聞いたよ",
          "tc": "我聽哥哥說過了，",
          "sc": "我听哥哥说过了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 234516,
          "spk": "驹子 (コマコ)",
          "ja": "私の狩りのお仕事、手伝ってくれたんだって",
          "tc": "你要來幫忙我的狩獵工作。",
          "sc": "你要来帮忙我的狩猎工作。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 234529,
          "spk": "四郎治 (シロージ)",
          "ja": "少しでも、<player>が手伝ってくれれば、",
          "tc": "我想只要<player>來幫妳一點忙，",
          "sc": "我想只要<player>来帮你一点忙，"
        },
        {
          "f_idx": 5,
