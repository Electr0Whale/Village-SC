  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4068,
      "rec_id": "TALK_ID_10_0201_017_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233004,
          "spk": "林 (リン)",
          "ja": "<player>、もしかして……",
          "tc": "<player>，你該不會……",
          "sc": "<player>，你该不会……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233015,
          "spk": "林 (リン)",
          "ja": "またお手伝いが終わったって報告に来たの？",
          "tc": "又是來跟我說已經幫完所有的忙了吧？",
          "sc": "又是来跟我说已经帮完所有的忙了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233033,
          "spk": "林 (リン)",
          "ja": "もう、私からの依頼の準備ができたら",
          "tc": "我不是說了，",
          "sc": "我不是说了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233040,
          "spk": "林 (リン)",
          "ja": "あなたの家に行くって言ったでしょ？",
          "tc": "等委託準備好就會去你家嗎？",
          "sc": "等委托准备好就会去你家吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233051,
          "spk": "林 (リン)",
          "ja": "依頼の準備は……",
          "tc": "關於委託的準備嘛……",
          "sc": "关于委托的准备嘛……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233058,
          "spk": "林 (リン)",
          "ja": "そうね……健康診断が無事に済んで……",
          "tc": "我想想……在健康檢查順利完成……",
          "sc": "我想想……在健康检查顺利完成……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233065,
          "spk": "林 (リン)",
          "ja": "お墓参りも終わった頃にはできるかしら？",
          "tc": "還有掃墓也結束後，應該可以準備好吧？",
          "sc": "还有扫墓也结束后，应该可以准备好吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233076,
          "spk": "林 (リン)",
          "ja": "もう少しだけ、",
          "tc": "就跟村裡的大家",
          "sc": "就跟村里的大家"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233083,
          "spk": "林 (リン)",
          "ja": "村のみんなと交流して",
          "tc": "多多交流，",
          "sc": "多多交流，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233090,
          "spk": "林 (リン)",
          "ja": "待っててちょうだい",
          "tc": "再耐心等一下吧。",
          "sc": "再耐心等一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4069,
      "rec_id": "TALK_ID_10_0201_018_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233118,
          "spk": "林 (リン)",
          "ja": "おはよう、<player>！",
          "tc": "早安，<player>！",
          "sc": "早安，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233129,
          "spk": "林 (リン)",
          "ja": "私からの、お願い事の準備が整ったから",
          "tc": "我的委託已經準備好了，",
          "sc": "我的委托已经准备好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233136,
          "spk": "林 (リン)",
          "ja": "呼びに来たのよ",
          "tc": "所以就來找你囉。",
          "sc": "所以就来找你啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233147,
          "spk": "林 (リン)",
          "ja": "さあ、私についてきて",
          "tc": "來，跟我來吧。",
          "sc": "来，跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4070,
      "rec_id": "TALK_ID_10_0201_019_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233171,
          "spk": "林 (リン)",
          "ja": "あら、全部終わったの",
          "tc": "哎呀，你全都做完了啊。",
          "sc": "哎呀，你全都做完了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233178,
          "spk": "林 (リン)",
          "ja": "思ったより真面目じゃない",
          "tc": "你比我想得還要認真呢。",
          "sc": "你比我想得还要认真呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233189,
          "spk": "林 (リン)",
          "ja": "でも……",
          "tc": "但是……",
          "sc": "但是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233196,
          "spk": "林 (リン)",
          "ja": "まだ終わりじゃないわ",
          "tc": "還沒結束哦。",
          "sc": "还没结束哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233207,
          "spk": "林 (リン)",
          "ja": "私からの依頼がまだでしょう",
          "tc": "我還沒提出委託對吧。",
          "sc": "我还没提出委托对吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233225,
          "spk": "林 (リン)",
          "ja": "これからお願いを言うわ",
          "tc": "接下來我要說出我的請求，",
          "sc": "接下来我要说出我的请求，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233232,
          "spk": "林 (リン)",
          "ja": "ついて来て",
          "tc": "跟我來吧。",
          "sc": "跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4071,
      "rec_id": "TALK_ID_10_0201_020_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233256,
          "spk": "林 (リン)",
          "ja": "このバインダーを開いてみて",
          "tc": "你打開這個資料夾看看。",
          "sc": "你打开这个资料夹看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4072,
      "rec_id": "TALK_ID_10_0201_020_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233282,
          "spk": "林 (リン)",
          "ja": "これはね、",
          "tc": "這裡面是",
          "sc": "这里面是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233289,
          "spk": "林 (リン)",
          "ja": "村に必要な資材の一覧よ",
          "tc": "村子所需的物資一覽。",
          "sc": "村子所需的物资一览。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233300,
          "spk": "林 (リン)",
          "ja": "昔は、この村にはたくさんの人が住んでいて",
          "tc": "以前這個村子裡住了很多人，",
          "sc": "以前这个村子里住了很多人，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233307,
          "spk": "林 (リン)",
          "ja": "賑わっていたのよ",
          "tc": "非常熱鬧呢。",
          "sc": "非常热闹呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233318,
          "spk": "林 (リン)",
          "ja": "でも今は、どこもかしこも寂れてしまっている",
          "tc": "但現在到處很冷清，",
          "sc": "但现在到处很冷清，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233325,
          "spk": "林 (リン)",
          "ja": "まるで福が逃げて行ってしまったように……",
          "tc": "彷彿福氣都溜走了一樣……",
          "sc": "仿佛福气都溜走了一样……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233336,
          "spk": "林 (リン)",
          "ja": "かつての賑わいを取り戻すため、",
          "tc": "為了讓這裡恢復以往的熱鬧景象，",
          "sc": "为了让这里恢复以往的热闹景象，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233343,
          "spk": "林 (リン)",
          "ja": "まずは、村の入り口を",
          "tc": "首先，我打算把村子的入口",
          "sc": "首先，我打算把村子的入口"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233350,
          "spk": "林 (リン)",
          "ja": "綺麗に飾ろうと思っているの",
          "tc": "佈置得漂亮一點。",
          "sc": "布置得漂亮一点。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233361,
          "spk": "林 (リン)",
          "ja": "そこで、あなたには",
          "tc": "所以，我希望你能夠",
          "sc": "所以，我希望你能够"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233368,
          "spk": "林 (リン)",
          "ja": "ここに書かれた納品物を、",
          "tc": "把寫在清單上的物資",
          "sc": "把写在清单上的物资"
        },
        {
          "f_idx": 11,
          "pidx_tc": 233375,
          "spk": "林 (リン)",
          "ja": "全て集めて来て欲しいのよ",
          "tc": "都收集過來。",
          "sc": "都收集过来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4073,
      "rec_id": "TALK_ID_10_0201_020_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233399,
          "spk": "林 (リン)",
          "ja": "これも村のため……",
          "tc": "這也是為了這個村子……",
          "sc": "这也是为了这个村子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233406,
          "spk": "林 (リン)",
          "ja": "あなたにしかお願いできない、重要な仕事なの",
          "tc": "是一項只能拜託你來做的重要工作。",
          "sc": "是一项只能拜托你来做的重要工作。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233424,
          "spk": "林 (リン)",
          "ja": "私の家は、私が起きている間は",
          "tc": "只要是我醒著的時候，",
          "sc": "只要是我醒着的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233431,
          "spk": "林 (リン)",
          "ja": "開けておくからね",
          "tc": "我的家一直都會開放著。",
          "sc": "我的家一直都会开放着。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233442,
          "spk": "林 (リン)",
          "ja": "納品物が手に入ったら、",
          "tc": "你拿到物資後，",
          "sc": "你拿到物资后，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233449,
          "spk": "林 (リン)",
          "ja": "この部屋に持ってきてちょうだい",
          "tc": "就帶到這個房間來吧。",
          "sc": "就带到这个房间来吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233460,
          "spk": "林 (リン)",
          "ja": "これが終わったら、私からも感謝の印に",
          "tc": "等這些都完成後，我也會給你很棒的獎勵",
          "sc": "等这些都完成后，我也会给你很棒的奖励"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233467,
          "spk": "林 (リン)",
          "ja": "素敵なご褒美をあげるわ",
          "tc": "來表達我的感激。",
          "sc": "来表达我的感激。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233478,
          "spk": "林 (リン)",
          "ja": "ということで、頼んだわよ",
          "tc": "事情就是這樣，麻煩你囉。",
          "sc": "事情就是这样，麻烦你啦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233485,
          "spk": "林 (リン)",
          "ja": "なるべく早くよろしくね",
          "tc": "希望你盡快完成。",
          "sc": "希望你尽快完成。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4074,
      "rec_id": "TALK_ID_10_0201_022_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233509,
          "spk": "林 (リン)",
          "ja": "納品、終わったみたいね",
          "tc": "看來你收集完物資了，",
          "sc": "看来你收集完物资了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233520,
          "spk": "林 (リン)",
          "ja": "よくやったわ、<player>！",
          "tc": "做得好，<player>！",
          "sc": "做得好，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233527,
          "spk": "林 (リン)",
          "ja": "これでお手伝いは、",
          "tc": "如此，幫忙工作",
          "sc": "如此，帮忙工作"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233534,
          "spk": "林 (リン)",
          "ja": "すべて完了したことになるわ",
          "tc": "就算是全部完成了。",
          "sc": "就算是全部完成了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233545,
          "spk": "林 (リン)",
          "ja": "では、おまちかねの",
          "tc": "那麼，我得把你期待已久的",
          "sc": "那么，我得把你期待已久的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233552,
          "spk": "林 (リン)",
          "ja": "ご褒美をあげなくてはね",
          "tc": "獎勵交給你才行。",
          "sc": "奖励交给你才行。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233561,
          "spk": "林 (リン)",
          "ja": "私について来て",
          "tc": "跟我來吧。",
          "sc": "跟我来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4075,
      "rec_id": "TALK_ID_10_0201_023_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233585,
          "spk": "林 (リン)",
          "ja": "おめでとう！",
          "tc": "恭喜你！",
          "sc": "恭喜你！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233594,
          "spk": "林 (リン)",
          "ja": "あなたには、次の仕事を与えるわ！",
          "tc": "我要給你下一份工作！",
          "sc": "我要给你下一份工作！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233601,
          "spk": "林 (リン)",
          "ja": "次はこれらの納品を達成する権利よ！",
          "tc": "就是把這些物資收集完畢的權利！",
          "sc": "就是把这些物资收集完毕的权利！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4076,
      "rec_id": "TALK_ID_10_0201_023_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233632,
          "spk": "林 (リン)",
          "ja": "なによその顔",
          "tc": "你這是什麼表情，",
          "sc": "你这是什么表情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233639,
          "spk": "林 (リン)",
          "ja": "不服そうね",
          "tc": "不服氣是嗎？",
          "sc": "不服气是吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233650,
          "spk": "林 (リン)",
          "ja": "あなたはすでに、",
          "tc": "你不是已經得到",
          "sc": "你不是已经得到"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233657,
          "spk": "林 (リン)",
          "ja": "村人たちからの信頼を得られるっていう報酬を",
          "tc": "村民們的信任，",
          "sc": "村民们的信任，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233664,
          "spk": "林 (リン)",
          "ja": "受け取っているじゃない",
          "tc": "如此好的報酬了嗎？",
          "sc": "如此好的报酬了吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233675,
          "spk": "林 (リン)",
          "ja": "私もあなたのことを、信頼することにしたの",
          "tc": "我也決定要信任你了。",
          "sc": "我也决定要信任你了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233684,
          "spk": "林 (リン)",
          "ja": "信頼には、行動で応えねばならないわ",
          "tc": "而面對他人的信任，你得用行動做出回應。",
          "sc": "而面对他人的信任，你得用行动做出回应。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4077,
      "rec_id": "TALK_ID_10_0201_023_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233708,
          "spk": "林 (リン)",
          "ja": "一つの項目が全て終わり次第で、",
          "tc": "每完成一個項目，",
          "sc": "每完成一个项目，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233715,
          "spk": "林 (リン)",
          "ja": "ご褒美をあげましょう",
          "tc": "我就給你一次獎勵吧。",
          "sc": "我就给你一次奖励吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233724,
          "spk": "林 (リン)",
          "ja": "そうね……あなたの庭に建てられる",
          "tc": "我想想……我會去拜託木助哥，",
          "sc": "我想想……我会去拜托木助哥，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233731,
          "spk": "林 (リン)",
          "ja": "<strong>建築物</strong>の種類を増やしてもらえるように、",
          "tc": "請他增加你庭院裡能夠建造的",
          "sc": "请他增加你庭院里能够建造的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233738,
          "spk": "林 (リン)",
          "ja": "私からキスケさんに頼んであげるわ",
          "tc": "<strong>建築物</strong>種類。",
          "sc": "<strong>建筑物</strong>种类。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233749,
          "spk": "林 (リン)",
          "ja": "彼はあなたの働きをよく見ているから、",
          "tc": "他很瞭解你的工作表現，",
          "sc": "他很了解你的工作表现，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233756,
          "spk": "林 (リン)",
          "ja": "きっと協力してくれるはずよ",
          "tc": "一定會願意協助你的。",
          "sc": "一定会愿意协助你的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233767,
          "spk": "林 (リン)",
          "ja": "よかったわね",
          "tc": "很好不是嗎？",
          "sc": "很好不是吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233774,
          "spk": "林 (リン)",
          "ja": "みんなのお手伝いを、真面目にやっておいて",
          "tc": "都是多虧了你認真幫大家的忙。",
          "sc": "都是多亏了你认真帮大家的忙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4078,
      "rec_id": "TALK_ID_10_0201_023_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233799,
          "spk": "林 (リン)",
          "ja": "……なによ",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233806,
          "spk": "林 (リン)",
          "ja": "まだ不満かしら？",
          "tc": "還是不滿嗎？",
          "sc": "还是不满吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233817,
          "spk": "林 (リン)",
          "ja": "わかった、わかった……",
          "tc": "好啦，我知道了……",
          "sc": "好啦，我知道了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233824,
          "spk": "林 (リン)",
          "ja": "じゃあ、一つのカテゴリを達成する度に",
          "tc": "那麼，只要你每完成一整個大項目，",
          "sc": "那么，只要你每完成一整个大项目，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233831,
          "spk": "林 (リン)",
          "ja": "私からささやかなご褒美をあげるわ",
          "tc": "我就給你一份小小的獎勵。",
          "sc": "我就给你一份小小的奖励。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233842,
          "spk": "林 (リン)",
          "ja": "……どう？",
          "tc": "……怎麼樣？",
          "sc": "……怎么样？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233849,
          "spk": "林 (リン)",
          "ja": "少しはやる気が出た？",
          "tc": "比較有幹勁了嗎？",
          "sc": "比较有干劲了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4079,
      "rec_id": "TALK_ID_10_0201_023_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233867,
          "spk": "林 (リン)",
          "ja": "素直でよろしい",
          "tc": "你就是這麼老實。",
          "sc": "你就是这么老实。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233874,
          "spk": "林 (リン)",
          "ja": "ご褒美も、バインダーに記載しておくから、",
          "tc": "這些獎勵也會記載在資料夾裡，",
          "sc": "这些奖励也会记载在资料夹里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233881,
          "spk": "林 (リン)",
          "ja": "楽しみにして励むように",
          "tc": "你就滿懷期待地努力吧。",
          "sc": "你就满怀期待地努力吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233892,
          "spk": "林 (リン)",
          "ja": "……とはいえ、ここにある納品リストは、",
          "tc": "……不過，這裡的物資清單",
          "sc": "……不过，这里的物资清单"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233899,
          "spk": "林 (リン)",
          "ja": "さっき終わらせてくれたリストより難しい……",
          "tc": "要比你剛才完成的那個清單難多了……",
          "sc": "要比你刚才完成的那个清单难多了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233906,
          "spk": "林 (リン)",
          "ja": "きっと、一朝一夕では終わらないわ……",
          "tc": "肯定不會只是一朝一夕的功夫……",
          "sc": "肯定不会只是一朝一夕的功夫……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233917,
          "spk": "林 (リン)",
          "ja": "でも、あなたはこの彼ヶ津村に、",
          "tc": "但是，你今後也打算一直在",
          "sc": "但是，你今后也打算一直在"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233924,
          "spk": "林 (リン)",
          "ja": "これからも住んでくれるのでしょう？",
          "tc": "這彼津村住下去吧？",
          "sc": "这彼津村住下去吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233935,
          "spk": "林 (リン)",
          "ja": "だからこそ、あなたにお願いしたいの！",
          "tc": "所以我才會來拜託你！",
          "sc": "所以我才会来拜托你！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233942,
          "spk": "林 (リン)",
          "ja": "時間がかかっても構わないから、",
          "tc": "無論要花多久都沒有關係，",
          "sc": "无论要花多久都没有关系，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233949,
          "spk": "林 (リン)",
          "ja": "全てのものを集めて、納品してほしいのよ！",
          "tc": "將所有的物資都收集過來，完成清單吧！",
          "sc": "将所有的物资都收集过来，完成清单吧！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 233960,
          "spk": "林 (リン)",
          "ja": "この仕事を頼むということは、",
          "tc": "會來拜託你這個工作，",
          "sc": "会来拜托你这个工作，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 233967,
          "spk": "林 (リン)",
          "ja": "あなたを信頼しているということ！",
          "tc": "就代表了我有多麼信任你！",
          "sc": "就代表了我有多么信任你！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 233974,
          "spk": "林 (リン)",
          "ja": "私の信頼に応えてちょうだい",
          "tc": "好好回應我的信任吧。",
          "sc": "好好回应我的信任吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 233985,
          "spk": "林 (リン)",
          "ja": "頼んだわよ！",
          "tc": "拜託你囉。",
          "sc": "拜托你啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4080,
      "rec_id": "TALK_ID_10_0201_024_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234005,
          "spk": "林 (リン)",
          "ja": "あら……いつの間にか、",
          "tc": "哎呀……不知不覺中，",
          "sc": "哎呀……不知不觉中，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 234012,
          "spk": "林 (リン)",
