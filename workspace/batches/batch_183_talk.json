          "pidx_tc": 235106,
          "spk": "驹子 (コマコ)",
          "ja": "私やお兄ちゃんの仕事はね、",
          "tc": "我跟哥哥的工作",
          "sc": "我跟哥哥的工作"
        },
        {
          "f_idx": 9,
          "pidx_tc": 235113,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっと危ないけど、",
          "tc": "雖然有點危險，",
          "sc": "虽然有点危险，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 235120,
          "spk": "驹子 (コマコ)",
          "ja": "この村で暮らすのに欠かせない仕事なの",
          "tc": "但都是在這村子生活不可或缺的工作。",
          "sc": "但都是在这村子生活不可或缺的工作。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 235131,
          "spk": "驹子 (コマコ)",
          "ja": "村に来る動物や、侵食する草木を放っておくと、",
