    {
      "file": "talk.dat",
      "rec_idx": 4096,
      "rec_id": "TALK_ID_10_0202_050_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 234914,
          "spk": "驹子 (コマコ)",
          "ja": "狩猟免許は、",
          "tc": "狩獵執照",
