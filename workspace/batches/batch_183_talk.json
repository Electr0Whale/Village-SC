        {
          "f_idx": 3,
          "pidx_tc": 234939,
          "spk": "驹子 (コマコ)",
          "ja": "免許は、簡単に狩れる動物から順に",
          "tc": "執照已經按照動物的狩獵難度",
          "sc": "执照已经按照动物的狩猎难度"
        },
        {
          "f_idx": 4,
          "pidx_tc": 234946,
          "spk": "驹子 (コマコ)",
          "ja": "並べておいたから、その順番で取ってね",
          "tc": "排序好了，你就照順序取得吧。",
          "sc": "排序好了，你就照顺序取得吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 234957,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も、狩猟の腕を上げて",
          "tc": "等到<player>的狩獵技巧更加熟練，",
          "sc": "等到<player>的狩猎技巧更加熟练，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 234964,
          "spk": "驹子 (コマコ)",
          "ja": "お金に余裕ができたら、",
          "tc": "手頭也比較寬裕之後，",
          "sc": "手头也比较宽裕之后，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 234971,
          "spk": "驹子 (コマコ)",
          "ja": "色々な動物を獲る免許を、取ってみるといいよ",
