        {
          "f_idx": 12,
          "pidx_tc": 235138,
          "spk": "驹子 (コマコ)",
          "ja": "私たちの住む場所が、",
          "tc": "那麼我們能住的地方",
          "sc": "那么我们能住的地方"
        },
        {
          "f_idx": 13,
          "pidx_tc": 235145,
          "spk": "驹子 (コマコ)",
          "ja": "少しずつなくなっちゃうからね……",
          "tc": "就會一點一點地減少……",
          "sc": "就会一点一点地减少……"
