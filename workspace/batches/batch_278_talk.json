      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 427010,
          "spk": "莲实 (ハスミ)",
          "ja": "酔いが回らない状態で見上げる朝日は",
          "tc": "在沒喝醉的狀態下仰望早晨的太陽，",
          "sc": "在没喝醉的状态下仰望早晨的太阳，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 427017,
          "spk": "莲实 (ハスミ)",
          "ja": "とても気持ちがいいですね",
          "tc": "感覺非常舒服呢。",
          "sc": "感觉非常舒服呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7859,
      "rec_id": "TALK_ID_70_2140_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 427035,
          "spk": "莲实 (ハスミ)",
          "ja": "朝日を見ては、頭がガンガンする",
          "tc": "畢竟在我的印象中，",
          "sc": "毕竟在我的印象中，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 427042,
          "spk": "莲实 (ハスミ)",
          "ja": "記憶ばかりでしたから……",
          "tc": "早上看到太陽，頭總是會陣陣刺痛……",
          "sc": "早上看到太阳，头总是会阵阵刺痛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 427053,
          "spk": "莲实 (ハスミ)",
          "ja": "……こうして見ると、朝日というのは",
          "tc": "……不過這樣一看，",
          "sc": "……不过这样一看，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 427060,
          "spk": "莲实 (ハスミ)",
          "ja": "未来への希望に満ちていますね",
          "tc": "早晨的太陽充滿了對未來的希望呢。",
          "sc": "早晨的太阳充满了对未来的希望呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7860,
      "rec_id": "TALK_ID_70_2140_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 427078,
          "spk": "莲实 (ハスミ)",
          "ja": "今はなんだか、晴れやかな気持ちです",
          "tc": "現在的我，有種如釋重負的感覺。",
