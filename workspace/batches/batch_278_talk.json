  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7844,
      "rec_id": "TALK_ID_70_2140_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425847,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、いいタイミングで",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425854,
          "spk": "莲实 (ハスミ)",
          "ja": "いらしてくれました",
          "tc": "你來得正是時候。",
          "sc": "你来得正是时候。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425863,
          "spk": "莲实 (ハスミ)",
          "ja": "ちょうど試作中の料理……",
          "tc": "我還在試作中的料理……",
          "sc": "我还在试作中的料理……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425870,
          "spk": "莲实 (ハスミ)",
          "ja": "「豆腐ハンバーグ」が",
          "tc": "「豆腐漢堡排」",
          "sc": "“豆腐汉堡排”"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425877,
          "spk": "莲实 (ハスミ)",
          "ja": "完成したところなんです",
          "tc": "剛好完成了。",
          "sc": "刚好完成了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 425888,
          "spk": "莲实 (ハスミ)",
          "ja": "味の感想も聞かせてもらいたいですし",
          "tc": "我也想聽聽你對味道的感想，",
          "sc": "我也想听听你对味道的感想，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 425895,
          "spk": "莲实 (ハスミ)",
          "ja": "すぐ食事にしましょう",
          "tc": "馬上來用餐吧。",
          "sc": "马上来用餐吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7845,
      "rec_id": "TALK_ID_70_2140_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425919,
          "spk": "莲实 (ハスミ)",
          "ja": "せっかくの食事会なのに",
          "tc": "真抱歉難得聚餐，",
          "sc": "真抱歉难得聚餐，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425926,
          "spk": "莲实 (ハスミ)",
          "ja": "試作段階の料理でごめんなさい",
          "tc": "卻端出還在試作的料理。",
          "sc": "却端出还在试作的料理。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425937,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、どうしても",
          "tc": "可是我無論如何",
          "sc": "可是我无论如何"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425944,
          "spk": "莲实 (ハスミ)",
          "ja": "食べてもらいたくて……",
          "tc": "都想讓你嘗嘗……",
          "sc": "都想让你尝尝……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425953,
          "spk": "莲实 (ハスミ)",
          "ja": "これは、みんなの健康のことを考えて、",
          "tc": "這是以大家的健康為出發點，",
          "sc": "这是以大家的健康为出发点，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 425960,
          "spk": "莲实 (ハスミ)",
          "ja": "私なりの新しい挑戦なんです",
          "tc": "屬於我的全新的挑戰。",
          "sc": "属于我的全新的挑战。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 425971,
          "spk": "莲实 (ハスミ)",
          "ja": "健康的に、でもおいしい料理が作れないかと",
          "tc": "我每天都在不斷嘗試",
          "sc": "我每天都在不断尝试"
        },
        {
          "f_idx": 7,
          "pidx_tc": 425978,
          "spk": "莲实 (ハスミ)",
          "ja": "日々試行錯誤しているんですよ",
          "tc": "想要做出健康又美味的料理。",
          "sc": "想要做出健康又美味的料理。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 425989,
          "spk": "莲实 (ハスミ)",
          "ja": "漢方薬を調合するように",
          "tc": "雖然沒辦法像調配漢方藥那樣",
          "sc": "虽然没办法像调配汉方药那样"
        },
        {
          "f_idx": 9,
          "pidx_tc": 425996,
          "spk": "莲实 (ハスミ)",
          "ja": "すんなりとは成功しませんが……",
          "tc": "一下子就順利成功……",
          "sc": "一下子就顺利成功……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 426007,
          "spk": "莲实 (ハスミ)",
          "ja": "食事療法の面でも",
          "tc": "但我希望在食療方面",
          "sc": "但我希望在食疗方面"
        },
        {
          "f_idx": 11,
          "pidx_tc": 426014,
          "spk": "莲实 (ハスミ)",
          "ja": "みんなの力になりたいですから",
          "tc": "也能幫上大家的忙。",
          "sc": "也能帮上大家的忙。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 426032,
          "spk": "莲实 (ハスミ)",
          "ja": "この料理はおいしくできたはずですし",
          "tc": "加上這次的料理味道應該不錯，",
          "sc": "加上这次的料理味道应该不错，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 426039,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんにも喜んでいただける……",
          "tc": "還能讓<player>也感到開心……",
          "sc": "还能让<player>也感到开心……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 426050,
          "spk": "莲实 (ハスミ)",
          "ja": "そう思ってるんですけど、どうでしょう？",
          "tc": "雖然我是這麼想的，你覺得呢？",
          "sc": "虽然我是这么想的，你觉得呢？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 426057,
          "spk": "莲实 (ハスミ)",
          "ja": "料理の味の方は……？",
          "tc": "料理的味道如何……？",
          "sc": "料理的味道如何……？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 426066,
          "spk": "主角心声/旁白/选项",
          "ja": "おいしい！",
          "tc": "好吃！",
          "sc": "好吃！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 426073,
          "spk": "主角心声/旁白/选项",
          "ja": "あんまり！",
          "tc": "不是很愛！",
          "sc": "不是很爱！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7846,
      "rec_id": "TALK_ID_70_2140_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426184,
          "spk": "莲实 (ハスミ)",
          "ja": "他にも、作ってみようと思っている",
          "tc": "除此之外，",
          "sc": "除此之外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426191,
          "spk": "莲实 (ハスミ)",
          "ja": "料理のアイデアがいくつかあるんです",
          "tc": "我還有幾個關於料理的點子想嘗試。",
          "sc": "我还有几个关于料理的点子想尝试。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426202,
          "spk": "莲实 (ハスミ)",
          "ja": "いずれは、そのメニューの数々が",
          "tc": "有一天，說不定那些菜色",
          "sc": "有一天，说不定那些菜色"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426209,
          "spk": "莲实 (ハスミ)",
          "ja": "食卓に並ぶかもしれませんね",
          "tc": "會一一出現在餐桌上喔！",
          "sc": "会一一出现在餐桌上哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426220,
          "spk": "莲实 (ハスミ)",
          "ja": "健康づくりに欠かせないのは",
          "tc": "要打造健康的身體，",
          "sc": "要打造健康的身体，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426227,
          "spk": "莲实 (ハスミ)",
          "ja": "毎日の食事からですし",
          "tc": "就必須從每天的飲食開始著手，",
          "sc": "就必须从每天的饮食开始着手，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426234,
          "spk": "莲实 (ハスミ)",
          "ja": "がんばって挑戦を続けます",
          "tc": "我會持續努力挑戰的。",
          "sc": "我会持续努力挑战的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 426245,
          "spk": "莲实 (ハスミ)",
          "ja": "こうして健康料理を",
          "tc": "只要像這樣",
          "sc": "只要像这样"
        },
        {
          "f_idx": 8,
          "pidx_tc": 426252,
          "spk": "莲实 (ハスミ)",
          "ja": "生みだし続けていったら……",
          "tc": "持續研發健康料理……",
          "sc": "持续研发健康料理……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 426263,
          "spk": "莲实 (ハスミ)",
          "ja": "私自身の食生活も",
          "tc": "說不定我的飲食生活",
          "sc": "说不定我的饮食生活"
        },
        {
          "f_idx": 10,
          "pidx_tc": 426270,
          "spk": "莲实 (ハスミ)",
          "ja": "改善されるかもしれませんね",
          "tc": "也能獲得改善呢。",
          "sc": "也能获得改善呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7847,
      "rec_id": "TALK_ID_70_2140_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426294,
          "spk": "莲实 (ハスミ)",
          "ja": "来てくれたんですね、<player>さん",
          "tc": "歡迎你來，<player>。",
          "sc": "欢迎你来，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426301,
          "spk": "莲实 (ハスミ)",
          "ja": "私の……この部屋に",
          "tc": "這就是……我的房間……",
          "sc": "这就是……我的房间……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7848,
      "rec_id": "TALK_ID_70_2140_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426319,
          "spk": "莲实 (ハスミ)",
          "ja": "本当は、あなたが来る前に",
          "tc": "我本來是打算在你來之前，",
          "sc": "我本来是打算在你来之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426326,
          "spk": "莲实 (ハスミ)",
          "ja": "片づけようかとも思ったんですけど――",
          "tc": "先好好整理一下的──",
          "sc": "先好好整理一下的——"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426337,
          "spk": "莲实 (ハスミ)",
          "ja": "この部屋がありのままの自分ですし",
          "tc": "但這個房間象徵了最真實的我，",
          "sc": "但这个房间象征了最真实的我，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426344,
          "spk": "莲实 (ハスミ)",
          "ja": "堂々と公開することにしました",
          "tc": "所以我決定大大方方公開。",
          "sc": "所以我决定大大方方公开。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426355,
          "spk": "莲实 (ハスミ)",
          "ja": "くつろいでいただける自信はありませんが",
          "tc": "雖然沒自信能讓你感到舒適，",
          "sc": "虽然没自信能让你感到舒适，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426362,
          "spk": "莲实 (ハスミ)",
          "ja": "どうか……帰らないでください",
          "tc": "還請你……不要掉頭就走……",
          "sc": "还请你……不要掉头就走……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7849,
      "rec_id": "TALK_ID_70_2140_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426386,
          "spk": "莲实 (ハスミ)",
          "ja": "……よかった、受け入れてもらえて",
          "tc": "……還好你願意留下。",
          "sc": "……还好你愿意留下。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426404,
          "spk": "莲实 (ハスミ)",
          "ja": "この部屋の惨状を",
          "tc": "知道房間慘況的人……",
          "sc": "知道房间惨况的人……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426411,
          "spk": "莲实 (ハスミ)",
          "ja": "知っているのはチナナだけです",
          "tc": "只有琪娜娜。",
          "sc": "只有琪娜娜。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426422,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナからは来るたびに",
          "tc": "琪娜娜每次來拜訪",
          "sc": "琪娜娜每次来拜访"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426429,
          "spk": "莲实 (ハスミ)",
          "ja": "片づけるようにと口うるさく……",
          "tc": "都會一直碎碎念叫我收拾……",
          "sc": "都会一直碎碎念叫我收拾……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7850,
      "rec_id": "TALK_ID_70_2140_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426447,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも、部屋の片づけを？",
          "tc": "<player>也覺得該整理一下？",
          "sc": "<player>也觉得该整理一下？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426454,
          "spk": "莲实 (ハスミ)",
          "ja": "……そうですよね、さすがにこれだと",
          "tc": "……說得也是，",
          "sc": "……说得也是，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426461,
          "spk": "莲实 (ハスミ)",
          "ja": "足の踏み場もありませんから",
          "tc": "畢竟現在這樣連能站的地方都沒有。",
          "sc": "毕竟现在这样连能站的地方都没有。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426472,
          "spk": "莲实 (ハスミ)",
          "ja": "招待しておきながら",
          "tc": "明明是我邀你來的，",
          "sc": "明明是我邀你来的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426479,
          "spk": "莲实 (ハスミ)",
          "ja": "手間をかけてしまい、申し訳ないです……",
          "tc": "卻給你添麻煩了，真的很抱歉……",
          "sc": "却给你添麻烦了，真的很抱歉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7851,
      "rec_id": "TALK_ID_70_2140_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426503,
          "spk": "莲实 (ハスミ)",
          "ja": "す、少しは片付きましたかね……",
          "tc": "應、應該有稍微整齊了點……",
          "sc": "应、应该有稍微整齐了点……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7852,
      "rec_id": "TALK_ID_70_2140_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426521,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、ありがとうございます",
          "tc": "<player>，謝謝你。",
          "sc": "<player>，谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426528,
          "spk": "莲实 (ハスミ)",
          "ja": "遅くまで手伝ってもらって、",
          "tc": "讓你幫我到這麼晚，",
          "sc": "让你帮我到这么晚，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426535,
          "spk": "莲实 (ハスミ)",
          "ja": "すみませんでした……",
          "tc": "真是不好意思……",
          "sc": "真是不好意思……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426546,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、部屋が片付いて、",
          "tc": "不過整理了房間後，",
          "sc": "不过整理了房间后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426553,
          "spk": "莲实 (ハスミ)",
          "ja": "すこし気が楽になりました",
          "tc": "感覺心情也比較輕鬆了。",
          "sc": "感觉心情也比较轻松了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426560,
          "spk": "莲实 (ハスミ)",
          "ja": "今夜は気持ちよく寝れそうです",
          "tc": "感覺今天晚上可以舒服地睡一覺。",
          "sc": "感觉今天晚上可以舒服地睡一觉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426571,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも疲れたでしょう？",
          "tc": "想必<player>你也累了吧？",
          "sc": "想必<player>你也累了吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 426578,
          "spk": "莲实 (ハスミ)",
          "ja": "どうぞ、小さいベッドですが、",
          "tc": "雖然床是小了點，",
          "sc": "虽然床是小了点，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 426585,
          "spk": "莲实 (ハスミ)",
          "ja": "お好きに使ってくださいね",
          "tc": "但請不要客氣。",
          "sc": "但请不要客气。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 426596,
          "spk": "莲实 (ハスミ)",
          "ja": "ベッドだけは<player>さんが来る前に、",
          "tc": "只有床是<player>你來之前，",
          "sc": "只有床是<player>你来之前，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 426603,
          "spk": "莲实 (ハスミ)",
          "ja": "片づけておいたのでね……",
          "tc": "就整理好的……",
          "sc": "就整理好的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7853,
      "rec_id": "TALK_ID_70_2140_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426623,
          "spk": "莲实 (ハスミ)",
          "ja": "結局、部屋の片づけで",
          "tc": "結果光是整理房間就沒時間了，",
          "sc": "结果光是整理房间就没时间了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426630,
          "spk": "莲实 (ハスミ)",
          "ja": "ほとんど終わってしまい、ごめんなさい",
          "tc": "真的很對不起。",
          "sc": "真的很对不起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426639,
          "spk": "莲实 (ハスミ)",
          "ja": "これじゃあ、どっちが大人なのか",
          "tc": "這樣都不曉得",
          "sc": "这样都不晓得"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426646,
          "spk": "莲实 (ハスミ)",
          "ja": "わからなくなってしまいますね",
          "tc": "究竟誰才是大人了呢。",
          "sc": "究竟谁才是大人了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7854,
      "rec_id": "TALK_ID_70_2140_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426662,
          "spk": "莲实 (ハスミ)",
          "ja": "気にしてないですか？",
          "tc": "你說你不介意？",
          "sc": "你说你不介意？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426669,
          "spk": "莲实 (ハスミ)",
          "ja": "……ありがとうございます、",
          "tc": "……謝謝你，",
          "sc": "……谢谢你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426676,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん",
          "tc": "<player>。",
          "sc": "<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426685,
          "spk": "莲实 (ハスミ)",
          "ja": "それなら、たまには……",
          "tc": "既然如此，那我就……",
          "sc": "既然如此，那我就……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426692,
          "spk": "莲实 (ハスミ)",
          "ja": "甘えちゃおうかな",
          "tc": "偶爾撒撒嬌吧。",
          "sc": "偶尔撒撒娇吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426710,
          "spk": "莲实 (ハスミ)",
          "ja": "たくさんたくさん、秘密を抱えてきましたけど",
          "tc": "儘管曾經有過很多很多的祕密，",
          "sc": "尽管曾经有过很多很多的秘密，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 426717,
          "spk": "莲实 (ハスミ)",
          "ja": "この秘密はちょっとワクワクしますね",
          "tc": "但這個祕密讓人有點興奮呢。",
          "sc": "但这个秘密让人有点兴奋呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 426726,
          "spk": "莲实 (ハスミ)",
          "ja": "誰にも、迷惑がかかることは",
          "tc": "而且，",
          "sc": "而且，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 426733,
          "spk": "莲实 (ハスミ)",
          "ja": "ありませんから",
          "tc": "也不會對任何人造成困擾。",
          "sc": "也不会对任何人造成困扰。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7855,
      "rec_id": "TALK_ID_70_2140_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426749,
          "spk": "莲实 (ハスミ)",
          "ja": "……秘密は時として、人の心と身体を",
          "tc": "……有時候，",
          "sc": "……有时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426756,
          "spk": "莲实 (ハスミ)",
          "ja": "傷つけることもありました",
          "tc": "祕密會對人的身心造成傷害。",
          "sc": "秘密会对人的身心造成伤害。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426765,
          "spk": "莲实 (ハスミ)",
          "ja": "私が勝手に作った秘密なのに",
          "tc": "原本明明是我擅自塑造出來的祕密，",
          "sc": "原本明明是我擅自塑造出来的秘密，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426772,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナを巻き込んでしまったこと……",
          "tc": "結果竟然把琪娜娜也捲了進來……",
          "sc": "结果竟然把琪娜娜也卷了进来……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426779,
          "spk": "莲实 (ハスミ)",
          "ja": "本当に申し訳なく思ってるんです",
          "tc": "這點我真的打從心底感到抱歉。",
          "sc": "这点我真的打从心底感到抱歉。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426790,
          "spk": "莲实 (ハスミ)",
          "ja": "それと、スミレに事実を",
          "tc": "還有一直對堇怜",
          "sc": "还有一直对堇怜"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426797,
          "spk": "莲实 (ハスミ)",
          "ja": "隠し続けてきたことも……",
          "tc": "隱瞞實情的事也是……",
          "sc": "隐瞒实情的事也是……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 426806,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんにも",
          "tc": "<player>你也有",
          "sc": "<player>你也有"
        },
        {
          "f_idx": 8,
          "pidx_tc": 426813,
          "spk": "莲实 (ハスミ)",
          "ja": "人には言えないような秘密なんて",
          "tc": "無法向別人坦誠的",
          "sc": "无法向别人坦诚的"
        },
        {
          "f_idx": 9,
          "pidx_tc": 426820,
          "spk": "莲实 (ハスミ)",
          "ja": "あったりしますか？",
          "tc": "祕密嗎？",
          "sc": "秘密吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 426829,
          "spk": "主角心声/旁白/选项",
          "ja": "ある",
          "tc": "會",
          "sc": "会"
        },
        {
          "f_idx": 11,
          "pidx_tc": 426836,
          "spk": "主角心声/旁白/选项",
          "ja": "ない",
          "tc": "不會",
          "sc": "不会"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7856,
      "rec_id": "TALK_ID_70_2140_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426921,
          "spk": "莲实 (ハスミ)",
          "ja": "もしもこの先、誰にも相談できず",
          "tc": "要是以後你有什麼煩惱",
          "sc": "要是以后你有什么烦恼"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426928,
          "spk": "莲实 (ハスミ)",
          "ja": "思い悩んでしまった時……",
          "tc": "無法跟任何人商量……",
          "sc": "无法跟任何人商量……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426937,
          "spk": "莲实 (ハスミ)",
          "ja": "私でよければ、話を聞かせてください",
          "tc": "可以的話，請說給我聽吧。",
          "sc": "可以的话，请说给我听吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426944,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんの味方になりますから",
          "tc": "我會站在<player>這邊的，",
          "sc": "我会站在<player>这边的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426953,
          "spk": "莲实 (ハスミ)",
          "ja": "どうかそのことを",
          "tc": "你要記得喔，",
          "sc": "你要记得哦，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426960,
          "spk": "莲实 (ハスミ)",
          "ja": "覚えておいてくださいね",
          "tc": "千萬別忘記囉！",
          "sc": "千万别忘了哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7857,
      "rec_id": "TALK_ID_70_2140_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426976,
          "spk": "莲实 (ハスミ)",
          "ja": "……ふふ、気が向いたら",
          "tc": "……呵呵，你不嫌棄的話，",
          "sc": "……呵呵，你不嫌弃的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426983,
          "spk": "莲实 (ハスミ)",
          "ja": "またお泊りに来てください",
