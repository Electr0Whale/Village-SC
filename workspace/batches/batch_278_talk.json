          "sc": "那么，路上小心。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 427096,
          "spk": "莲实 (ハスミ)",
          "ja": "今日も元気に過ごしましょう",
          "tc": "今天也打起精神來吧！",
          "sc": "今天也打起精神来吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7861,
      "rec_id": "TALK_ID_70_2150_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392068,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392075,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの店に",
          "tc": "你是要來",
          "sc": "你是要来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392082,
          "spk": "琪娜娜 (チナナ)",
          "ja": "用だった？",
          "tc": "買東西的嗎？",
          "sc": "买东西的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392093,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いね、見てのとおり",
          "tc": "抱歉，你也看到了，",
          "sc": "抱歉，你也看到了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392100,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は店じまいだよ",
          "tc": "我今天已經打烊了。",
          "sc": "我今天已经打烊了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392111,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か買いたいものがあるなら",
          "tc": "你如果有什麼想買的，",
          "sc": "你如果有什么想买的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392118,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また出直しておいで",
          "tc": "就等明天再來吧。",
          "sc": "就等明天再来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7862,
      "rec_id": "TALK_ID_70_2150_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392136,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さて今日はどこで……",
          "tc": "那麼今天要在哪裡……",
          "sc": "那么今天要在哪里……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392143,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ、そうだ……",
          "tc": "啊，對了……",
          "sc": "啊，对了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392154,
          "spk": "琪娜娜 (チナナ)",
          "ja": "頼みがあるんだけど、",
          "tc": "我有件事想拜託你，",
          "sc": "我有件事想拜托你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392161,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もし夜にウチのトラックを見つけても、",
          "tc": "如果你在晚上遇到了我的卡車，",
          "sc": "如果你在晚上遇到了我的卡车，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392168,
          "spk": "琪娜娜 (チナナ)",
          "ja": "近くをうろつかないでくれると助かるんだ",
          "tc": "也不要在車附近徘徊喔。",
          "sc": "也不要在车附近徘徊哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392179,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こう見えても意外と繊細なんでね",
          "tc": "別看我這樣，我可是很敏感的。",
          "sc": "别看我这样，我可是很敏感的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392186,
          "spk": "琪娜娜 (チナナ)",
          "ja": "足音がすると眠れないんだよ",
          "tc": "一點點腳步聲都會害我睡不著。",
          "sc": "一点点脚步声都会害我睡不着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7863,
      "rec_id": "TALK_ID_70_2150_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392211,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、そうか",
          "tc": "啊，對喔，",
          "sc": "啊，对哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392218,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはまだ知らないのか",
          "tc": "你還不知道吧。",
          "sc": "你还不知道吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392229,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはトラックで",
          "tc": "我都是在這台卡車上",
          "sc": "我都是在这台卡车上"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392236,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝泊まりしているんだよ",
          "tc": "過夜的。",
          "sc": "过夜的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7864,
      "rec_id": "TALK_ID_70_2150_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392254,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ベッドが恋しくなったら ",
          "tc": "雖然想睡床的時候，",
          "sc": "虽然想睡床的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392261,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミに言って診療所を借りたり、",
          "tc": "我會跟蓮實借她的診所睡，",
          "sc": "我会跟莲实借她的诊所睡，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392268,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ホテルの部屋をとったりすることもあるけどね",
          "tc": "或是去旅館睡。",
          "sc": "或是去旅馆睡。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは車中泊が",
          "tc": "我喜歡",
          "sc": "我喜欢"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392286,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気に入っているんだ",
          "tc": "在車子裡過夜。",
          "sc": "在车子里过夜。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きな場所にトラックを停めて",
          "tc": "把卡車停在喜歡的地方，",
          "sc": "把卡车停在喜欢的地方，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きな景色を眺めながら寝られる",
          "tc": "邊欣賞著喜歡的景色邊睡，",
          "sc": "边欣赏着喜欢的景色边睡，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392311,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなに贅沢なことがあるかい？",
          "tc": "還有什麼比這更奢侈的呢？",
          "sc": "还有什么比这更奢侈的呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "特に海辺なんて",
          "tc": "尤其是海邊，",
          "sc": "尤其是海边，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "最高で……",
          "tc": "海邊真的是太讚了……",
          "sc": "海边真的是太赞了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392336,
          "spk": "琪娜娜 (チナナ)",
          "ja": "………………",
          "tc": "………………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7865,
      "rec_id": "TALK_ID_70_2150_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392360,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……いや、ちょっと配慮が足りなかった",
          "tc": "……唉，我說話真是不夠小心啊。",
          "sc": "……唉，我说话真是不够小心啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392367,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはここから簡単には出られない",
          "tc": "畢竟你沒辦法",
          "sc": "毕竟你没办法"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392374,
          "spk": "琪娜娜 (チナナ)",
          "ja": "身の上だったよね……",
          "tc": "隨意離開這裡……",
          "sc": "随意离开这里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7866,
      "rec_id": "TALK_ID_70_2150_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392392,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よく考えてみたら、",
          "tc": "仔細想想，",
          "sc": "仔细想想，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "海辺は波の音が",
          "tc": "海邊的波浪聲",
          "sc": "海边的波浪声"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392406,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うるさすぎるよ",
          "tc": "實在是很吵。",
          "sc": "实在是很吵。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392417,
          "spk": "琪娜娜 (チナナ)",
          "ja": "太陽の光が反射して眩しいし、",
          "tc": "太陽光還會反射，很刺眼，",
          "sc": "太阳光还会反射，很刺眼，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392424,
          "spk": "琪娜娜 (チナナ)",
          "ja": "潮風はベタベタしているしで、",
          "tc": "海風又黏答答的，",
          "sc": "海风又黏答答的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392431,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ろくなことがないね",
          "tc": "根本沒什麼好的。",
          "sc": "根本没什么好的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392442,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、別に村の外なんて",
          "tc": "所以你不必",
          "sc": "所以你不必"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392449,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気にしなくていいと思うよ",
          "tc": "惦記著村外的事。",
          "sc": "惦记着村外的事。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392460,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミもこの村のことを気に入ってるなら、",
          "tc": "既然你也很喜歡這個村子，",
          "sc": "既然你也很喜欢这个村子，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392467,
          "spk": "琪娜娜 (チナナ)",
          "ja": "わざわざ村の外へ行きたいだなんて",
          "tc": "你應該不會想要",
          "sc": "你应该不会想要"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392474,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思わないだろう？",
          "tc": "大費周章地跑去村外吧？",
          "sc": "大费周章地跑去村外吧？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 392483,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 12,
          "pidx_tc": 392490,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "會",
          "sc": "会"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7867,
      "rec_id": "TALK_ID_70_2150_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392601,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは故郷であるこの村が大好きなんだ",
          "tc": "我超級喜歡這座村子，這裡是我的故鄉。",
          "sc": "我超级喜欢这座村子，这里是我的故乡。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392608,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、キミにも気に入ってもらえると嬉しいよ",
          "tc": "所以我希望你也喜歡這裡。",
          "sc": "所以我希望你也喜欢这里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7868,
      "rec_id": "TALK_ID_70_2150_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392641,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はいはい、それくらいにしときな",
          "tc": "好了，差不多就好了，",
          "sc": "好了，差不多就好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392648,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また酔って転んだら大変でしょ",
          "tc": "要是再喝醉跌倒就不好了。",
          "sc": "要是再喝醉跌倒就不好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392668,
          "spk": "莲实 (ハスミ)",
          "ja": "へ、へいきよぉ……",
          "tc": "沒、沒事啦……",
          "sc": "没、没事啦……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392675,
          "spk": "莲实 (ハスミ)",
          "ja": "しんぱいしょうなんだからぁ……",
          "tc": "妳就愛瞎操心……",
          "sc": "你就爱瞎操心……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392682,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふ、うふふふふ……",
          "tc": "呵呵、呵呵呵呵呵……",
          "sc": "呵呵、呵呵呵呵呵……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392695,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな状態なんだから",
          "tc": "妳都這種狀態了，",
          "sc": "你都这种状态了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392702,
          "spk": "琪娜娜 (チナナ)",
          "ja": "心配するに決まっているよ",
          "tc": "我當然會擔心啊。",
          "sc": "我当然会担心啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7869,
      "rec_id": "TALK_ID_70_2150_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392724,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、いいところに",
          "tc": "哦，你來得正好，",
          "sc": "哦，你来得正好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392731,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと手伝ってくれないかい？",
          "tc": "可以幫我一下嗎？",
          "sc": "可以帮我一下吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392742,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミをベッドに運びたいから",
          "tc": "我想把蓮實抬去床上，",
          "sc": "我想把莲实抬去床上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392749,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一緒に支えてくれないかな",
          "tc": "你可不可以幫我一起抬？",
          "sc": "你可不可以帮我一起抬？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7870,
      "rec_id": "TALK_ID_70_2150_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392773,
          "spk": "琪娜娜 (チナナ)",
          "ja": "片付けまで",
          "tc": "竟然還麻煩你",
          "sc": "竟然还麻烦你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392780,
          "spk": "琪娜娜 (チナナ)",
          "ja": "手伝ってもらって",
          "tc": "收拾東西，",
          "sc": "收拾东西，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392787,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪かったねえ",
          "tc": "真是不好意思啊。",
          "sc": "真是不好意思啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392798,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人じゃ骨が折れると",
          "tc": "我剛剛還想說要是我自己來，",
          "sc": "我刚刚还想说要是我自己来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392805,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思っていたんだ",
          "tc": "應該會累死。",
          "sc": "应该会累死。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392812,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ありがとさん",
          "tc": "謝啦。",
          "sc": "谢啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7871,
      "rec_id": "TALK_ID_70_2150_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392830,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミが心配かい？",
          "tc": "你在擔心蓮實嗎？",
          "sc": "你在担心莲实吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392837,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大丈夫、起きたら",
          "tc": "沒事的，",
          "sc": "没事的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392844,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けろっとしているよ",
          "tc": "她醒來之後就會若無其事的了。",
          "sc": "她醒来之后就会若无其事的了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7872,
      "rec_id": "TALK_ID_70_2150_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392862,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あの子があそこまで",
          "tc": "她如果醉到像現在這樣，",
          "sc": "她如果醉到像现在这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392869,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酔ったら、とりあえず",
          "tc": "那只要讓她",
          "sc": "那只要让她"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392876,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝かせておけば大丈夫",
          "tc": "躺下來睡就會好了。",
          "sc": "躺下来睡就会好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392887,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミが酔い潰れて",
          "tc": "我們的聚會",
          "sc": "我们的聚会"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392894,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お開きになることなんて",
          "tc": "本來就常常因為蓮實喝了個爛醉",
          "sc": "本来就常常因为莲实喝了个烂醉"
        },
        {
          "f_idx": 5,
          "pidx_tc": 392901,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しょっちゅうだからね",
          "tc": "而結束。",
          "sc": "而结束。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 392912,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ま、酒が多少の",
          "tc": "……如果酒精",
          "sc": "……如果酒精"
        },
        {
          "f_idx": 7,
          "pidx_tc": 392919,
          "spk": "琪娜娜 (チナナ)",
          "ja": "息抜きになるならいいさ",
          "tc": "能稍微讓她放鬆的話就好。",
          "sc": "能稍微让她放松的话就好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 392928,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチにできることは、",
          "tc": "我能做的，",
          "sc": "我能做的，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 392935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酒に付き合うぐらいだし……",
          "tc": "也就只有陪她喝酒了……",
          "sc": "也就只有陪她喝酒了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 392946,
          "spk": "琪娜娜 (チナナ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7873,
      "rec_id": "TALK_ID_70_2150_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392964,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さて、帰るかねえ",
          "tc": "好了，該回家了。",
          "sc": "好了，该回家了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392971,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも眠たくなってきた",
          "tc": "我也開始睏了。",
          "sc": "我也开始困了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7874,
      "rec_id": "TALK_ID_70_2150_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392995,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393002,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ああ、その段ボールか",
          "tc": "……喔，你說那個紙箱嗎？",
          "sc": "……哦，你说那个纸箱吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393009,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのまま置いといていいよ",
          "tc": "你放著就好。",
          "sc": "你放着就好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393020,
          "spk": "琪娜娜 (チナナ)",
          "ja": "面と向かって渡すと",
          "tc": "要是當面給她，",
          "sc": "要是当面给她，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393027,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミは受け取らないからね",
          "tc": "她是不會收的。",
          "sc": "她是不会收的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 393034,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝ているうちに置いとくんだ",
          "tc": "我都趁她睡覺的時候放著。",
          "sc": "我都趁她睡觉的时候放着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7875,
      "rec_id": "TALK_ID_70_2150_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 393052,
          "spk": "琪娜娜 (チナナ)",
          "ja": "中身は食料だよ",
          "tc": "裡面是些糧食，",
          "sc": "里面是些粮食，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 393059,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミと、",
          "tc": "是給蓮實",
          "sc": "是给莲实"
        },
        {
          "f_idx": 2,
          "pidx_tc": 393066,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べ盛りのスミレの分さ",
          "tc": "以及正在發育期的堇怜的。",
          "sc": "以及正在发育期的堇怜的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 393077,
          "spk": "琪娜娜 (チナナ)",
          "ja": "念のために言っとくけど、",
          "tc": "為了保險起見，我還是說一聲好了，",
          "sc": "为了保险起见，我还是说一声好了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 393084,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミは食べないようにね",
          "tc": "你可不要偷吃喔。",
          "sc": "你可不要偷吃哦。"
        }
      ]
    }
  ]
}