          "f_idx": 21,
          "pidx_tc": 394237,
          "spk": "林 (リン)",
          "ja": "さあ、行くわよ、<player>！！",
          "tc": "好，要開始囉，<player>！！",
          "sc": "好，要开始喽，<player>！！"
