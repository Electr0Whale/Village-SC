    {
      "file": "talk.dat",
      "rec_idx": 6982,
      "rec_id": "TALK_ID_70_2050_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 394056,
          "spk": "林 (リン)",
          "ja": "あら、<player>じゃない",
          "tc": "哎呀，這不是<player>嗎？",
          "sc": "哎呀，这不是<player>吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 394063,
          "spk": "林 (リン)",
          "ja": "いいところで出会ったわね",
          "tc": "在這裡遇見你真是太剛好了。",
          "sc": "在这里遇见你真是太刚好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 394074,
          "spk": "林 (リン)",
          "ja": "あなたの頑張りはいつも見ているわ",
          "tc": "我一直以來都有看到你的努力。",
          "sc": "你的努力我一直都看在眼里呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 394081,
          "spk": "林 (リン)",
          "ja": "朝も早いし、仕事も最後までやり切るし……",
          "tc": "不僅早起，工作也會確實完成……",
          "sc": "不仅早起，工作也会确实完成……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 394088,
          "spk": "林 (リン)",
          "ja": "……まあ、合格点をあげる",
          "tc": "……總之，我覺得你合格了。",
          "sc": "……总之，我觉得你合格了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 394099,
          "spk": "林 (リン)",
          "ja": "ただ……私から言わせてもらえば、",
          "tc": "只不過……如果要我說的話，",
          "sc": "只不过……如果要我说的话，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 394106,
          "spk": "林 (リン)",
          "ja": "決定的に足りてないものがあるわ",
          "tc": "你有確實不足的地方。",
          "sc": "你有确实不足的地方。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 394117,
          "spk": "林 (リン)",
          "ja": "あなたにはもっと",
          "tc": "我希望你今後",
          "sc": "我希望你今后"
