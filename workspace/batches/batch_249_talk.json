  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6965,
      "rec_id": "TALK_ID_70_2040_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426442,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、<player>",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426453,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はロッカクさんにもらったそばを茹でて",
          "tc": "今天六角叔給了我一些蕎麥麵，",
          "sc": "今天六角叔给了我一些荞麦面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426460,
          "spk": "四郎治 (シロージ)",
          "ja": "「たぬきそば」にしたんだ",
          "tc": "所以我就煮了「天婦羅花蕎麥麵」。",
          "sc": "所以我就煮了“天妇罗花荞麦面”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426471,
          "spk": "四郎治 (シロージ)",
          "ja": "伸びちまうから",
          "tc": "我怕麵會糊掉，",
          "sc": "我怕面会糊掉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426478,
          "spk": "四郎治 (シロージ)",
          "ja": "早く食おうぜ",
          "tc": "所以我們趕快吃吧。",
          "sc": "所以我们赶快吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6966,
      "rec_id": "TALK_ID_70_2040_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426502,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……さっぱりしててうめぇ",
          "tc": "嗯……真清爽，好吃。",
          "sc": "嗯……真清爽，好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426513,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>は",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426520,
          "spk": "四郎治 (シロージ)",
          "ja": "食べることは好きか？",
          "tc": "你喜歡吃東西嗎？",
          "sc": "你喜欢吃东西吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426529,
          "spk": "主角心声/旁白/选项",
          "ja": "すき",
          "tc": "喜歡",
          "sc": "喜欢"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426536,
          "spk": "主角心声/旁白/选项",
          "ja": "きらい",
          "tc": "不喜歡",
          "sc": "不喜欢"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6967,
      "rec_id": "TALK_ID_70_2040_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426611,
          "spk": "四郎治 (シロージ)",
          "ja": "一人で食う飯はつまんねぇけど",
          "tc": "雖然自己一個人吃飯很無聊，",
          "sc": "虽然自己一个人吃饭很无聊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426618,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>と一緒だと違うな",
          "tc": "但跟<player>你一起吃，感覺就不一樣了。",
          "sc": "但跟<player>你一起吃，感觉就不一样了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426627,
          "spk": "四郎治 (シロージ)",
          "ja": "また、食べに来いよ",
          "tc": "下次再來過來一起吃飯吧。",
          "sc": "下次再来过来一起吃饭吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6968,
      "rec_id": "TALK_ID_70_2040_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426651,
          "spk": "四郎治 (シロージ)",
          "ja": "おう、待ってたぜ",
          "tc": "哦，就等你來了。",
          "sc": "哦，就等你来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426658,
          "spk": "四郎治 (シロージ)",
          "ja": "遠慮なくくつろいでくれ",
          "tc": "不用客氣，當作自己家吧。",
          "sc": "不用客气，当作自己家吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6969,
      "rec_id": "TALK_ID_70_2040_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426676,
          "spk": "四郎治 (シロージ)",
          "ja": "と言っても",
          "tc": "說是這麼說，",
          "sc": "说是这么说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426683,
          "spk": "四郎治 (シロージ)",
          "ja": "うちにお前が喜びそうなものはないな……",
          "tc": "但我家好像沒有你會喜歡的東西……",
          "sc": "但我家好像没有你会喜欢的东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426694,
          "spk": "四郎治 (シロージ)",
          "ja": "ああそうだ",
          "tc": "啊，對了，",
          "sc": "啊，对了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426701,
          "spk": "四郎治 (シロージ)",
          "ja": "庭に出て空でも見ないか",
          "tc": "你要不要跟我去庭院看天空？",
          "sc": "你要不要跟我去庭院看天空？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6970,
      "rec_id": "TALK_ID_70_2040_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426719,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ、行こう",
          "tc": "那我們走吧。",
          "sc": "那我们走吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6971,
      "rec_id": "TALK_ID_70_2040_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426743,
          "spk": "四郎治 (シロージ)",
          "ja": "山からの眺めもよかったけど",
          "tc": "山上的景觀是很美，",
          "sc": "山上的景观是很美，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426750,
          "spk": "四郎治 (シロージ)",
          "ja": "庭から見る空も悪くないだろ",
          "tc": "不過在庭院看天空也很不錯吧？",
          "sc": "不过在庭院看天空也很不错吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6972,
      "rec_id": "TALK_ID_70_2040_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426775,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコもここから",
          "tc": "駒子她也很喜歡",
          "sc": "驹子她也很喜欢"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426782,
          "spk": "四郎治 (シロージ)",
          "ja": "空を見上げるのが好きなんだ",
          "tc": "在這裡仰望天空。",
          "sc": "在这里仰望天空。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426793,
          "spk": "四郎治 (シロージ)",
          "ja": "小さい頃",
          "tc": "在我們還小的時候，",
          "sc": "在我们还小的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426800,
          "spk": "四郎治 (シロージ)",
          "ja": "星を取ってきてほしいって",
          "tc": "她有一次還要我把星星摘下來給她，",
          "sc": "她有一次还要我把星星摘下来给她，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426807,
          "spk": "四郎治 (シロージ)",
          "ja": "言われて困ったもんだ",
          "tc": "真是讓我傷透了腦筋。",
          "sc": "真是让我伤透了脑筋。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6973,
      "rec_id": "TALK_ID_70_2040_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426825,
          "spk": "四郎治 (シロージ)",
          "ja": "お前はなんも言わねぇな……",
          "tc": "你真的話很少呢……",
          "sc": "你真的话很少呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426832,
          "spk": "四郎治 (シロージ)",
          "ja": "たまにはもうちょっと、",
          "tc": "偶爾講一些",
          "sc": "偶尔讲一些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426839,
          "spk": "四郎治 (シロージ)",
          "ja": "ワガママ言ってもいいんだぜ",
          "tc": "任性的話也可以啊。",
          "sc": "任性的话也可以啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426850,
          "spk": "四郎治 (シロージ)",
          "ja": "さすがに星は取ってこれねぇけど、",
          "tc": "雖然無法把星星摘下來給你，",
          "sc": "虽然无法把星星摘下来给你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426857,
          "spk": "四郎治 (シロージ)",
          "ja": "俺にできることだったら、",
          "tc": "所以如果有什麼我能做的，",
          "sc": "所以如果有什么我能做的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426864,
          "spk": "四郎治 (シロージ)",
          "ja": "力になってやれるかもしれないからな",
          "tc": "或許可以幫得上忙。",
          "sc": "或许可以帮得上忙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6974,
      "rec_id": "TALK_ID_70_2040_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426888,
          "spk": "四郎治 (シロージ)",
          "ja": "やべえ……ずっと空を見てて、",
          "tc": "糟糕……一直看著天空，",
          "sc": "糟糕……一直看着天空，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426895,
          "spk": "四郎治 (シロージ)",
          "ja": "首痛めちまいそうだ……",
          "tc": "脖子都痛起來了……",
          "sc": "脖子都痛起来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6975,
      "rec_id": "TALK_ID_70_2040_010_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426913,
          "spk": "四郎治 (シロージ)",
          "ja": "誘っておいて悪いが、",
          "tc": "抱歉，雖然是我邀你來的，",
          "sc": "抱歉，虽然是我邀你来的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426920,
          "spk": "四郎治 (シロージ)",
          "ja": "楽しませるようなものは、もうないんだ",
          "tc": "但已經沒有什麼有樂趣的事了。",
          "sc": "但已经没有什么有乐趣的事了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426931,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、今日も忙しそうだったし、",
          "tc": "你今天看起來也很忙，",
          "sc": "你今天看起来也很忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426938,
          "spk": "四郎治 (シロージ)",
          "ja": "疲れてるだろ？",
          "tc": "應該累了吧？",
          "sc": "应该累了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426949,
          "spk": "四郎治 (シロージ)",
          "ja": "だから、もう寝ようぜ",
          "tc": "所以來睡覺吧。",
          "sc": "所以来睡觉吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426956,
          "spk": "四郎治 (シロージ)",
          "ja": "腰に負担がかからない",
          "tc": "我把我自豪的床墊借你，",
          "sc": "我把我自豪的床垫借你，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426963,
          "spk": "四郎治 (シロージ)",
          "ja": "自慢のマットレスを貸してやるよ",
          "tc": "它可不會造成腰的負擔喔。",
          "sc": "它可不会造成腰的负担啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6976,
      "rec_id": "TALK_ID_70_2040_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426983,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426990,
          "spk": "四郎治 (シロージ)",
          "ja": "寝る前に少しいいか",
          "tc": "在睡覺之前可以稍微聊一聊嗎？",
          "sc": "在睡觉之前可以稍微聊一聊吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6977,
      "rec_id": "TALK_ID_70_2040_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 427006,
          "spk": "四郎治 (シロージ)",
          "ja": "……ずっと考えてたんだ",
          "tc": "……我一直都在思考，",
          "sc": "……我一直都在思考，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 427013,
          "spk": "四郎治 (シロージ)",
          "ja": "俺のやってきたことは",
          "tc": "我的所作所為",
          "sc": "我的所作所为"
        },
        {
          "f_idx": 2,
          "pidx_tc": 427020,
          "spk": "四郎治 (シロージ)",
          "ja": "本当に、正しかったのかって",
          "tc": "真的是正確的嗎？",
          "sc": "真的是正确的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 427029,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコの罪を俺が隠し続けたせいで",
          "tc": "因為我掩蓋了駒子的罪，",
          "sc": "因为我掩盖了驹子的罪，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 427036,
          "spk": "四郎治 (シロージ)",
          "ja": "あいつは、償う機会を失った",
          "tc": "結果導致她錯過了贖罪的機會。",
          "sc": "结果导致她错过了赎罪的机会。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 427052,
          "spk": "四郎治 (シロージ)",
          "ja": "分かってたんだ",
          "tc": "我都知道的。",
          "sc": "我都知道的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 427059,
          "spk": "四郎治 (シロージ)",
          "ja": "それでも俺は……あの時の選択を、",
          "tc": "即使如此我還是……只能認為",
          "sc": "即使如此我还是……只能认为"
        },
        {
          "f_idx": 8,
          "pidx_tc": 427066,
          "spk": "四郎治 (シロージ)",
          "ja": "正しいって思い込むしかなかった",
          "tc": "我當時的選擇是正確的。",
          "sc": "我当时的选择是正确的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 427075,
          "spk": "四郎治 (シロージ)",
          "ja": "……怖かったんだよ",
          "tc": "……我好害怕。",
          "sc": "……我好害怕。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 427082,
          "spk": "四郎治 (シロージ)",
          "ja": "あいつが壊れるんじゃないかって",
          "tc": "她會不會就那樣崩潰。",
          "sc": "她会不会就那样崩溃。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 427089,
          "spk": "四郎治 (シロージ)",
          "ja": "だから、守ることばかり考えてたんだ",
          "tc": "所以我只想著要保護她。",
          "sc": "所以我只想着要保护她。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 427098,
          "spk": "四郎治 (シロージ)",
          "ja": "でも……違ったんだな",
          "tc": "可是……我錯了。",
          "sc": "可是……我错了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 427105,
          "spk": "四郎治 (シロージ)",
          "ja": "あいつは、自分で向き合えた",
          "tc": "她靠著自己的力量去面對了。",
          "sc": "她靠着自己的力量去面对了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 427112,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が思ってたより、ずっと強かった",
          "tc": "她比我想的還要堅強。",
          "sc": "她比我想的还要坚强。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 427121,
          "spk": "四郎治 (シロージ)",
          "ja": "俺の方が、あいつを信じきれてなかったんだ",
          "tc": "是當時的我沒能相信她。",
          "sc": "是当时的我没能相信她。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 427128,
          "spk": "四郎治 (シロージ)",
          "ja": "……やっぱり俺の性質は、過保護みたいだな",
          "tc": "……看來我這個人就是會保護過頭。",
          "sc": "……看来我这个人就是会保护过头。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 427144,
          "spk": "四郎治 (シロージ)",
          "ja": "これからは俺も、",
          "tc": "從今以後，",
          "sc": "从今以后，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 427151,
          "spk": "四郎治 (シロージ)",
          "ja": "自分のやったことから目を逸らさない",
          "tc": "我也會正視自己做過的事。",
          "sc": "我也会正视自己做过的事。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 427158,
          "spk": "四郎治 (シロージ)",
          "ja": "きっかけをくれたお前には、感謝してる",
          "tc": "我很感謝你給了我這個機會。",
          "sc": "我很感谢你给了我这个机会。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 427167,
          "spk": "四郎治 (シロージ)",
          "ja": "だから、伝えておきたかったんだ",
          "tc": "我就是想告訴你這個。",
          "sc": "我就是想告诉你这个。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 427174,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがとう、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 427181,
