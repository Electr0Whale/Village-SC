        {
          "f_idx": 8,
          "pidx_tc": 394124,
          "spk": "林 (リン)",
          "ja": "知識とノウハウを身につけてもらいたいの",
          "tc": "能夠確實學會知識或技術。",
          "sc": "能够确实学会知识或技术。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 394133,
          "spk": "林 (リン)",
          "ja": "……そのために必要なのが、何か分かる？",
          "tc": "……你知道為此所需的東西是什麼嗎？",
          "sc": "……你知道为此所需的东西是什么吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 394151,
          "spk": "林 (リン)",
          "ja": "……体力よ！",
          "tc": "……是體力！",
          "sc": "……是体力！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 394162,
          "spk": "林 (リン)",
          "ja": "いい？　体力っていうのはね、",
          "tc": "聽好了。體力這種東西，",
          "sc": "听好了。体力这种东西，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 394169,
          "spk": "林 (リン)",
          "ja": "精神的な「あと一歩」を踏み出せるかどうかを",
          "tc": "是決定能不能踏出",
          "sc": "是决定能不能踏出"
        },
        {
          "f_idx": 14,
          "pidx_tc": 394176,
          "spk": "林 (リン)",
          "ja": "決めるものなの",
          "tc": "精神上「最後一步」的關鍵。",
          "sc": "精神上“最后一步”的关键。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 394187,
          "spk": "林 (リン)",
          "ja": "というわけで……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 394194,
          "spk": "林 (リン)",
          "ja": "彼ヶ津村のおすすめランニングコースを",
          "tc": "就讓我來告訴你我最推薦的",
          "sc": "就让我来告诉你我最推荐的"
        },
        {
          "f_idx": 17,
          "pidx_tc": 394201,
          "spk": "林 (リン)",
          "ja": "教えてあげるわ！",
          "tc": "彼津村跑步路線吧！",
          "sc": "彼津村跑步路线吧！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 394212,
          "spk": "林 (リン)",
          "ja": "この辺りを一周して、余裕があったらもう一周！",
          "tc": "繞著這一帶跑一圈，感覺很輕鬆的話就再一圈！",
          "sc": "绕着这一带跑一圈，感觉很轻松的话就再一圈！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 394219,
          "spk": "林 (リン)",
          "ja": "坂道は止まらずに一気に駆け上がること！",
          "tc": "一口氣跑上坡道！",
          "sc": "一口气跑上坡道！"
        },
        {
          "f_idx": 20,
          "pidx_tc": 394226,
          "spk": "林 (リン)",
          "ja": "呼吸は三歩で吸って、三歩で吐く！",
          "tc": "呼吸方式是三步一吸氣，三步一吐氣！",
          "sc": "呼吸方式是三步一吸气，三步一吐气！"
        },
