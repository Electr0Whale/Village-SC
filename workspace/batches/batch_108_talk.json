  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 560,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1221",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122558,
          "spk": "四郎治 (シロージ)",
          "ja": "なんかいつもより多いな……",
          "tc": "感覺份量好像比平常還多啊……",
          "sc": "感觉份量好像比平常还多啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122565,
          "spk": "四郎治 (シロージ)",
          "ja": "ロッカクさん、大盛りにしてくれたのか？",
          "tc": "六角叔是不是幫我多添了啊？",
          "sc": "六角叔是不是帮我多添了啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122576,
          "spk": "四郎治 (シロージ)",
          "ja": "あとで礼言っとかねぇとな",
          "tc": "待會要跟他道謝才行。",
          "sc": "待会要跟他道谢才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 561,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1222",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122600,
          "spk": "四郎治 (シロージ)",
          "ja": "店で食うと片付けしなくていいから楽だ",
          "tc": "在餐廳吃飯不用自己收拾，所以很輕鬆。",
          "sc": "在餐厅吃饭不用自己收拾，所以很轻松。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122618,
          "spk": "四郎治 (シロージ)",
          "ja": "食うこと自体がめんどくさくなっちまう時は",
          "tc": "但連飯都懶得吃的時候",
          "sc": "但连饭都懒得吃的时候"
        },
        {
          "f_idx": 3,
          "pidx_tc": 122625,
          "spk": "四郎治 (シロージ)",
          "ja": "どうしようもねぇんだけどな",
          "tc": "也沒辦法啊。",
          "sc": "也没办法啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 562,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122656,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかくだからゲームをしたいんだが……",
          "tc": "雖然機會難得，還滿想玩遊戲的……",
          "sc": "虽然机会难得，还满想玩游戏的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122674,
          "spk": "四郎治 (シロージ)",
          "ja": "ふわぁ……",
          "tc": "呼啊……",
          "sc": "呼啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 122685,
          "spk": "四郎治 (シロージ)",
          "ja": "こりゃ無理そうだな……",
          "tc": "但這下是玩不了了……",
          "sc": "但这下是玩不了了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 563,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122716,
          "spk": "四郎治 (シロージ)",
          "ja": "次の仕事の準備をしたり、",
          "tc": "為準備之後的工作，",
          "sc": "为准备之后的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122723,
          "spk": "四郎治 (シロージ)",
          "ja": "計画を立てておきたいんだが……",
          "tc": "我想要先做好計畫……",
          "sc": "我想要先做好计划……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122734,
          "spk": "四郎治 (シロージ)",
          "ja": "うーん、駄目だ",
          "tc": "嗯……不行啊，",
          "sc": "嗯……不行啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 122741,
          "spk": "四郎治 (シロージ)",
          "ja": "眠くて何も考えられない……",
          "tc": "太睏了，都沒辦法思考了……",
          "sc": "太困了，都没办法思考了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 564,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_1232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122772,
          "spk": "四郎治 (シロージ)",
          "ja": "めちゃくちゃねみい……",
          "tc": "超級睏的……",
          "sc": "超级困的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122779,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は夢も何も見ないくらい",
          "tc": "我想今天應該不會作夢，",
          "sc": "我想今天应该不会作梦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122786,
          "spk": "四郎治 (シロージ)",
          "ja": "深く眠れそうだな……",
          "tc": "直接一覺到天亮吧……",
          "sc": "直接一觉到天亮吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 565,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122810,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコが湿気を気にしてたな",
          "tc": "駒子她很在意濕氣。",
          "sc": "驹子她很在意湿气。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122817,
          "spk": "四郎治 (シロージ)",
          "ja": "髪が跳ねて困るんだと",
          "tc": "她說這樣頭髮會亂翹，很困擾。",
          "sc": "她说这样头发会乱翘，很困扰。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122828,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>は大丈夫そうか？",
          "tc": "<player>你呢，你沒問題嗎？",
          "sc": "<player>你呢，你没问题吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 566,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122852,
          "spk": "四郎治 (シロージ)",
          "ja": "……なんだ？　俺、臭うか？",
          "tc": "……怎麼了？我很臭嗎？",
          "sc": "……怎么了？我很臭吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122863,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろ風呂に入らないと",
          "tc": "那我差不多該去洗澡了，",
          "sc": "那我差不多该去洗澡了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122870,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコに小言を言われそうだ……",
          "tc": "不然感覺會被駒子念……",
          "sc": "不然感觉会被驹子念……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 567,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122894,
          "spk": "四郎治 (シロージ)",
          "ja": "帰ったらずっとサボってた",
          "tc": "我回來之後就一直在偷懶，",
          "sc": "我回来之后就一直在偷懒，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122901,
          "spk": "四郎治 (シロージ)",
          "ja": "仕事道具の手入れでもするか",
          "tc": "不如來保養一下工作用具好了。",
          "sc": "不如来保养一下工作用具好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 568,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122932,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、舗装されてない道は",
          "tc": "<player>，在走沒有鋪裝的道路的時候",
          "sc": "<player>，在走没有铺装的道路的时候"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122939,
          "spk": "四郎治 (シロージ)",
          "ja": "気を付けて歩かないと危ないぜ",
          "tc": "要小心點，不然很危險。",
          "sc": "要小心点，不然很危险。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 122946,
          "spk": "四郎治 (シロージ)",
          "ja": "急いで走ったりして、転ぶなよ",
          "tc": "你可別因為要趕路就跑起來，會跌倒的。",
          "sc": "你可别因为要赶路就跑起来，会跌倒的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 569,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 122970,
          "spk": "四郎治 (シロージ)",
          "ja": "まだ雨が降ってるか",
          "tc": "還在下雨啊。",
          "sc": "还在下雨啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 122977,
          "spk": "四郎治 (シロージ)",
          "ja": "キャンプ場の様子を見とかないとな……",
          "tc": "我得去看一下營地的情況……",
          "sc": "我得去看一下营地的情况……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 570,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123008,
          "spk": "四郎治 (シロージ)",
          "ja": "あ～そういえば漫画を受け取りに",
          "tc": "啊～對了，我得去琪娜娜那邊",
          "sc": "啊～对了，我得去琪娜娜那边"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123015,
          "spk": "四郎治 (シロージ)",
          "ja": "チナナんとこに行かねえとな",
          "tc": "拿漫畫才行。",
          "sc": "拿漫画才行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123026,
          "spk": "四郎治 (シロージ)",
          "ja": "気が向いたタイミングで行くか……",
          "tc": "等哪天再去吧……",
          "sc": "等哪天再去吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 571,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123050,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコの心配をしてたら",
          "tc": "我還在為駒子擔心，",
          "sc": "我还在为驹子担心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123057,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が忘れ物をしちまった……",
          "tc": "結果反而是我自己忘了帶東西……",
          "sc": "结果反而是我自己忘了带东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123064,
          "spk": "四郎治 (シロージ)",
          "ja": "気を付けないといけねぇな",
          "tc": "我也要小心點才行啊。",
          "sc": "我也要小心点才行啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 572,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123088,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はいい木材が手に入った",
          "tc": "今天拿到了不錯的木材，",
          "sc": "今天拿到了不错的木材，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123095,
          "spk": "四郎治 (シロージ)",
          "ja": "キスケのやつ、喜ぶだろうな",
          "tc": "木助那傢伙看到應該會很高興吧。",
          "sc": "木助那家伙看到应该会很高兴吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 573,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123119,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は雨も降ってる",
          "tc": "今天也在下雨，",
          "sc": "今天也在下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123126,
          "spk": "四郎治 (シロージ)",
          "ja": "夜遊びもほどほどにしとけよ",
          "tc": "你晚上可不要玩到太晚了，",
          "sc": "你晚上可不要玩到太晚了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123133,
          "spk": "四郎治 (シロージ)",
          "ja": "俺も適当なタイミングで寝るからさ",
          "tc": "我也看時間差不多就會去睡了。",
          "sc": "我也看时间差不多就会去睡了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 574,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123157,
          "spk": "四郎治 (シロージ)",
          "ja": "よお……",
          "tc": "唷……",
          "sc": "哟……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123164,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、晩飯はもう食ったのか？",
          "tc": "你吃過晚餐了嗎？",
          "sc": "你吃过晚餐了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123175,
          "spk": "四郎治 (シロージ)",
          "ja": "腹が減ってると寝付けないぞ",
          "tc": "餓著肚子可是沒辦法睡著的。",
          "sc": "饿着肚子可是没办法睡着的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 123182,
          "spk": "四郎治 (シロージ)",
          "ja": "変なことに巻き込まれないためにも、",
          "tc": "為避免被捲入奇怪的事情，",
          "sc": "为避免被卷入奇怪的事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 123189,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと食ってしっかり寝たほうがいいぜ",
          "tc": "還是好好吃飯好好睡覺比較好。",
          "sc": "还是好好吃饭好好睡觉比较好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 575,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123213,
          "spk": "四郎治 (シロージ)",
          "ja": "あんまり夜に出歩くなよ",
          "tc": "晚上不要太常出門，",
          "sc": "晚上不要太常出门，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123220,
          "spk": "四郎治 (シロージ)",
          "ja": "何があるかわからねぇしな",
          "tc": "因為不知道會遇到什麼，",
          "sc": "因为不知道会遇到什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123227,
          "spk": "四郎治 (シロージ)",
          "ja": "危ねぇぞ",
          "tc": "很危險的。",
          "sc": "很危险的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 576,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_1823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123251,
          "spk": "四郎治 (シロージ)",
          "ja": "ふわぁ……ねみい",
          "tc": "呼啊……好想睡。",
          "sc": "呼啊……好想睡。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123262,
          "spk": "四郎治 (シロージ)",
          "ja": "いろいろしようと思ってたけど",
          "tc": "本來想做點雜事的，",
          "sc": "本来想做点杂事的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123269,
          "spk": "四郎治 (シロージ)",
          "ja": "諦めて今日は早めに寝るとするか",
          "tc": "但今天還是早點睡吧。",
          "sc": "但今天还是早点睡吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 577,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123293,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が暑さで倒れたら",
          "tc": "我要是熱昏了，",
          "sc": "我要是热昏了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123300,
          "spk": "四郎治 (シロージ)",
          "ja": "誰か呼んできてくれると助かる",
          "tc": "希望你能幫我叫人過來。",
          "sc": "希望你能帮我叫人过来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123311,
          "spk": "四郎治 (シロージ)",
          "ja": "……なんてな、冗談だ",
          "tc": "……我開玩笑的。",
          "sc": "……我开玩笑的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 578,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123335,
          "spk": "四郎治 (シロージ)",
          "ja": "よっと……ふう",
          "tc": "嘿咻……呼……",
          "sc": "嘿咻……呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 123346,
          "spk": "四郎治 (シロージ)",
          "ja": "こうして必死に薪割りなんてしてると",
          "tc": "像這樣卯足全力砍柴，",
          "sc": "像这样卯足全力砍柴，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 123353,
          "spk": "四郎治 (シロージ)",
          "ja": "汗が止まらねぇな……",
          "tc": "汗水就會停不下來啊……",
          "sc": "汗水就会停不下来啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 579,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 123377,
          "spk": "四郎治 (シロージ)",
