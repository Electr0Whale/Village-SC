      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106013,
          "spk": "林 (リン)",
          "ja": "あら……<player>",
          "tc": "哎呀……是<player>啊。",
          "sc": "哎呀……是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106020,
          "spk": "林 (リン)",
          "ja": "エントリーしてなかったじゃない",
          "tc": "你這次沒報名啊？",
          "sc": "你这次没报名啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106027,
          "spk": "林 (リン)",
          "ja": "少し残念だったわ",
          "tc": "有點遺憾呢。",
          "sc": "有点遗憾呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106038,
          "spk": "林 (リン)",
          "ja": "馬の調子がよくなかったのかしら",
          "tc": "是馬的狀況不太好嗎？",
          "sc": "是马的状况不太好吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106045,
          "spk": "林 (リン)",
          "ja": "そういう時もあるわよね、仕方ないわ",
          "tc": "也是會有這種時候啦，沒辦法。",
          "sc": "也是会有这种时候啦，没办法。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 106063,
          "spk": "林 (リン)",
          "ja": "次は馬と一緒に",
          "tc": "下次要跟馬一起",
          "sc": "下次要跟马一起"
        },
        {
          "f_idx": 7,
          "pidx_tc": 106070,
          "spk": "林 (リン)",
          "ja": "万全の状態で臨んでみなさい",
          "tc": "以最佳狀態上陣喔。",
          "sc": "以最佳状态上阵哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 106077,
          "spk": "林 (リン)",
          "ja": "私、けっこう期待してるんだから",
          "tc": "我可是相當看好你喔。",
          "sc": "我可是相当看好你哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 746,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106101,
          "spk": "林 (リン)",
          "ja": "<player>、Ｓランクおめでとう！",
          "tc": "<player>，恭喜你獲得S級評價！",
          "sc": "<player>，恭喜你获得S级评价！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106108,
          "spk": "林 (リン)",
          "ja": "あなたのおかげで、",
          "tc": "多虧了你，",
          "sc": "多亏了你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106115,
          "spk": "林 (リン)",
          "ja": "素晴らしい品評会になったわ！",
          "tc": "這場評鑑會非常精采！",
          "sc": "这场评鉴会非常精采！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106126,
          "spk": "林 (リン)",
          "ja": "馬と<player>の絆の強さが",
          "tc": "<player>跟馬之間的深刻情誼，",
          "sc": "<player>跟马之间的深刻情谊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106133,
          "spk": "林 (リン)",
          "ja": "きっと評価につながったのね……！",
          "tc": "肯定是獲得好評的關鍵吧……！",
          "sc": "肯定是获得好评的关键吧……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106140,
          "spk": "林 (リン)",
          "ja": "私が言うんだから、間違いないわ",
          "tc": "我都這麼說了，絕對不會錯。",
          "sc": "我都这么说了，绝对不会错。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 747,
      "rec_id": "TALK_ID_VILLAGE_HEAD_HOLIDAY_20_104_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106164,
          "spk": "林 (リン)",
          "ja": "<player>、お疲れ様",
          "tc": "<player>，辛苦你了。",
          "sc": "<player>，辛苦你了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106171,
          "spk": "林 (リン)",
          "ja": "健闘していて良かったわ",
          "tc": "你有奮力一搏，真是太好了。",
          "sc": "你有奋力一搏，真是太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106182,
          "spk": "林 (リン)",
          "ja": "でも私、あなたならもっと",
          "tc": "不過我覺得如果是你，",
          "sc": "不过我觉得如果是你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106189,
          "spk": "林 (リン)",
          "ja": "上を目指せると思うの",
          "tc": "應該還能更上一層樓呢。",
          "sc": "应该还能更上一层楼呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106196,
          "spk": "林 (リン)",
          "ja": "次に向けてもっと仕上げてちょうだい！",
          "tc": "下次要再準備得更完善喔！",
          "sc": "下次要再准备得更完善哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 748,
      "rec_id": "TALK_ID_VILLAGE_HEAD_PRESENT_20_104_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106220,
          "spk": "林 (リン)",
          "ja": "私にプレゼントがあるの？",
          "tc": "你要送我禮物嗎？",
          "sc": "你要送我礼物吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106227,
          "spk": "林 (リン)",
          "ja": "いいじゃない、殊勝な心がけね",
          "tc": "不錯嘛，真是可貴的心意。",
          "sc": "不错嘛，真是可贵的心意。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106234,
          "spk": "林 (リン)",
          "ja": "ぜひ受け取らせてもらうわ",
          "tc": "那我就收下囉。",
          "sc": "那我就收下啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106245,
          "spk": "林 (リン)",
          "ja": "え、これって……！",
          "tc": "咦，這是……！",
          "sc": "咦，这是……！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106252,
          "spk": "林 (リン)",
          "ja": "どうして私の好きなものを……？",
          "tc": "你怎麼知道我喜歡的東西……？",
          "sc": "你怎么知道我喜欢的东西……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106263,
          "spk": "林 (リン)",
          "ja": "そう……知ってくれていたのね",
          "tc": "是嗎……原來你有留意到了啊。",
          "sc": "是吗……原来你有留意到了啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 106270,
          "spk": "林 (リン)",
          "ja": "嬉しいわ、どうもありがとう！",
          "tc": "我好開心，真的很謝謝你！",
          "sc": "我好开心，真的很谢谢你！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 106277,
          "spk": "林 (リン)",
          "ja": "大切にさせてもらうわね",
          "tc": "我會好好珍惜的。",
          "sc": "我会好好珍惜的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 106286,
          "spk": "林 (リン)",
          "ja": "これだけ慕ってくれる村人がいるんだもの、",
          "tc": "有這麼崇敬我的村民在，",
          "sc": "有这么崇敬我的村民在，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 106293,
          "spk": "林 (リン)",
          "ja": "私も村長として、",
          "tc": "作為村長的我，",
          "sc": "作为村长的我，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 106300,
          "spk": "林 (リン)",
          "ja": "もっとしっかりやらないとね！",
          "tc": "也得更加努力才行！",
          "sc": "也得更加努力才行！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 749,
      "rec_id": "TALK_ID_VILLAGE_HEAD_PRESENT_20_104_0201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106324,
          "spk": "林 (リン)",
          "ja": "何か私に用事？　<player>",
          "tc": "你找我有什麼事嗎？<player>。",
          "sc": "你找我有什么事吗？<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106331,
          "spk": "林 (リン)",
          "ja": "できれば手短にお願いね……",
          "tc": "可以的話，希望你長話短說……",
          "sc": "可以的话，希望你长话短说……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106342,
          "spk": "林 (リン)",
          "ja": "……って、え？　私に贈り物？",
          "tc": "……嗯、咦？要送我禮物？",
          "sc": "……嗯、咦？要送我礼物？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106349,
          "spk": "林 (リン)",
          "ja": "ありがたいわ、ぜひ受け取らせてちょうだい！",
          "tc": "謝謝你，那我就收下囉！",
          "sc": "谢谢你，那我就收下啦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106360,
          "spk": "林 (リン)",
          "ja": "このプレゼント……",
          "tc": "這份禮物……",
          "sc": "这份礼物……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106367,
          "spk": "林 (リン)",
          "ja": "あなたの気づかいを感じるわね",
          "tc": "能夠感受到你的體貼呢。",
          "sc": "能够感受到你的体贴呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 106374,
          "spk": "林 (リン)",
          "ja": "なんだか優しい気持ちになったわ……",
          "tc": "總覺得心裡很溫暖……",
          "sc": "总觉得心里很温暖……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 106385,
          "spk": "林 (リン)",
          "ja": "とはいえ、甘くするつもりはないけど！",
          "tc": "話雖如此，我可不打算手下留情！",
          "sc": "话虽如此，我可不打算手下留情！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 106392,
          "spk": "林 (リン)",
          "ja": "これからも村のためにがんばりなさい",
          "tc": "今後也為了村子好好加油吧。",
          "sc": "今后也为了村子好好加油吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 106399,
          "spk": "林 (リン)",
          "ja": "期待しているわよ",
          "tc": "我會好好期待的。",
          "sc": "我会好好期待的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 750,
      "rec_id": "TALK_ID_VILLAGE_HEAD_PRESENT_20_104_0202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106423,
          "spk": "林 (リン)",
          "ja": "へえ、私に贈り物だなんて",
          "tc": "喔？要送我禮物？",
          "sc": "喔？要送我礼物？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106430,
          "spk": "林 (リン)",
          "ja": "気が効いてるわね、<player>！",
          "tc": "你很貼心嘛，<player>！",
          "sc": "你很贴心嘛，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106437,
          "spk": "林 (リン)",
          "ja": "見せてもらおうかしら",
          "tc": "讓我打開看看吧。",
          "sc": "让我打开看看吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106448,
          "spk": "林 (リン)",
          "ja": "うっ……！",
          "tc": "唔……！",
          "sc": "唔……！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106455,
          "spk": "林 (リン)",
          "ja": "こ、これってまさか……",
          "tc": "這、這難道是……",
          "sc": "这、这难道是……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106462,
          "spk": "林 (リン)",
          "ja": "ちょっと、あなたねぇ！",
          "tc": "等等，我說你啊！",
          "sc": "等等，我说你啊！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 106473,
          "spk": "林 (リン)",
          "ja": "……その顔、どうやら他意はないようね",
          "tc": "……看你這表情，似乎也沒有惡意呢。",
          "sc": "……看你这表情，似乎也没有恶意呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 106480,
          "spk": "林 (リン)",
          "ja": "純粋に贈ってくれてるってワケ？",
          "tc": "只是單純想送給我嗎？",
          "sc": "只是单纯想送给我吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 106487,
          "spk": "林 (リン)",
          "ja": "なら、ありがたく受け取るけど",
          "tc": "那我就心懷感激地收下了。",
          "sc": "那我就心怀感激地收下了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 106498,
          "spk": "林 (リン)",
          "ja": "もしまたプレゼントしてくれる時は、",
          "tc": "不過如果下次還要送我禮物，",
          "sc": "不过如果下次还要送我礼物，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 106505,
          "spk": "林 (リン)",
          "ja": "くれぐれも、他のものでお願いね？",
          "tc": "拜託你務必送別的東西喔。",
          "sc": "拜托你务必送别的东西哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 751,
      "rec_id": "TALK_ID_VILLAGE_HEAD_PRESENT_20_104_0203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106529,
          "spk": "林 (リン)",
          "ja": "あら、贈り物だなんて……",
          "tc": "哎，送我禮物……",
          "sc": "哎，送我礼物……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106536,
          "spk": "林 (リン)",
          "ja": "私の誕生日を祝ってくれるのね！",
          "tc": "你要替我慶生啊！",
          "sc": "你要替我庆生啊！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106543,
          "spk": "林 (リン)",
          "ja": "とても嬉しいわ、ありがとう",
          "tc": "我很開心喔，謝謝你。",
          "sc": "我很开心，谢谢你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106554,
          "spk": "林 (リン)",
          "ja": "毎年忙しくて忘れそうになるんだけど",
          "tc": "雖然每年都忙到快要忘了，",
          "sc": "虽然每年都忙到快要忘了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106561,
          "spk": "林 (リン)",
          "ja": "村のみんなが祝ってくれるおかげで",
          "tc": "但多虧村裡的大家為我慶生，",
          "sc": "但多亏村里的大家为我庆生，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106568,
          "spk": "林 (リン)",
          "ja": "忘れずに済むのよね",
          "tc": "我才不至於真的忘記。",
          "sc": "我才不至于真的忘记。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 106579,
          "spk": "林 (リン)",
          "ja": "私も村長として、",
          "tc": "這樣我可以認為",
          "sc": "这样我可以认为"
        },
        {
          "f_idx": 7,
          "pidx_tc": 106586,
          "spk": "林 (リン)",
          "ja": "みんなに慕われていると",
          "tc": "我身為村長",
          "sc": "我身为村长"
        },
        {
          "f_idx": 8,
          "pidx_tc": 106593,
          "spk": "林 (リン)",
          "ja": "思っていいのかしら……",
          "tc": "很受到大家的敬重嗎……",
          "sc": "很受到大家的敬重吗……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 106604,
          "spk": "林 (リン)",
          "ja": "ともかく、感謝するわ",
          "tc": "總之，我很感謝你。",
          "sc": "总之，我很感谢你。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 106611,
          "spk": "林 (リン)",
          "ja": "あなたの誕生日も祝わせてもらうから",
          "tc": "你生日時，我也會幫你慶生的。",
          "sc": "你生日时，我也会帮你庆生的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 106618,
          "spk": "林 (リン)",
          "ja": "楽しみにしていなさい！",
          "tc": "你就好好期待吧！",
          "sc": "你就好好期待吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 752,
      "rec_id": "TALK_ID_VILLAGE_HEAD_PRESENT_20_104_0204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106642,
          "spk": "林 (リン)",
          "ja": "もう……そんなにたくさん受け取れないわ……",
          "tc": "真是的……我不能收那麼多東西啦……",
          "sc": "真是的……我不能收那么多东西啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106653,
          "spk": "林 (リン)",
          "ja": "贈り物で私の機嫌を取ろうとしているの？",
          "tc": "你是想用禮物來討我歡心嗎？",
          "sc": "你是想用礼物来讨我欢心吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106660,
          "spk": "林 (リン)",
          "ja": "期待しないでちょうだい",
          "tc": "你可別抱太大的期望喔。",
          "sc": "你可别抱太大的期望哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 753,
      "rec_id": "TALK_ID_VILLAGE_HEAD_THUNDERSTORM_20_104_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 106684,
          "spk": "林 (リン)",
          "ja": "ちょっと、<player>！？",
          "tc": "喂，<player>！？",
          "sc": "喂，<player>！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 106691,
          "spk": "林 (リン)",
          "ja": "こんな天気の日に外を出歩くなんて",
          "tc": "這種天氣還出門走動，",
          "sc": "这种天气还出门走动，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 106698,
          "spk": "林 (リン)",
          "ja": "危ないでしょ！",
