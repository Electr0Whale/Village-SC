  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7697,
      "rec_id": "TALK_ID_70_2120_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443506,
          "spk": "裕太 (ユータ)",
          "ja": "あー、よく眠れたね！",
          "tc": "啊～睡得真好！",
          "sc": "啊～睡得真好！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443513,
          "spk": "裕太 (ユータ)",
          "ja": "何か楽しい夢を見たような気が",
          "tc": "我好像夢到了很開心的夢，",
          "sc": "我好像梦到了很开心的梦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443520,
          "spk": "裕太 (ユータ)",
          "ja": "するんだけど、思い出せないや",
          "tc": "但完全想不起來。",
          "sc": "但完全想不起来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443531,
          "spk": "裕太 (ユータ)",
          "ja": "<player>と真っ暗な部屋で",
          "tc": "跟<player>你在全黑的房間裡",
          "sc": "跟<player>你在全黑的房间里"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443538,
          "spk": "裕太 (ユータ)",
          "ja": "小声で喋るのも楽しかったな",
          "tc": "小小聲講話真好玩。",
          "sc": "小小声讲话真好玩。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443556,
          "spk": "裕太 (ユータ)",
          "ja": "修学旅行を思いだして、",
          "tc": "這讓我回想起了校外教學，",
          "sc": "这让我回想起了校外教学，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443563,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと青春気分っていうか",
          "tc": "感覺有種青春的感覺，",
          "sc": "感觉有种青春的感觉，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443570,
          "spk": "裕太 (ユータ)",
          "ja": "懐かしい感じがしたよ",
          "tc": "也令人有點懷念呢。",
          "sc": "也令人有点怀念呢。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 443581,
          "spk": "裕太 (ユータ)",
          "ja": "キミがもう少し大きくなったら",
          "tc": "等你再稍微長大一點，",
          "sc": "等你再稍微长大一点，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 443588,
          "spk": "裕太 (ユータ)",
          "ja": "恋バナしながら寝るのもいいよね",
          "tc": "我們就可以邊睡邊聊戀愛話題了。",
          "sc": "我们就可以边睡边聊恋爱话题了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 443606,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>って",
          "tc": "啊，是說<player>，",
          "sc": "啊，是说<player>，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 443613,
          "spk": "裕太 (ユータ)",
          "ja": "気になってる相手はいるの？",
          "tc": "你有沒有在意的人啊？",
          "sc": "你有没有在意的人啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7698,
      "rec_id": "TALK_ID_70_2120_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443631,
          "spk": "裕太 (ユータ)",
          "ja": "あはは！",
          "tc": "啊哈哈！",
          "sc": "啊哈哈！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443638,
          "spk": "裕太 (ユータ)",
          "ja": "そういう話は",
          "tc": "這個話題",
          "sc": "这个话题"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443645,
          "spk": "裕太 (ユータ)",
          "ja": "また今度しようか",
          "tc": "我們就下次再聊吧。",
          "sc": "我们就下次再聊吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443656,
          "spk": "裕太 (ユータ)",
          "ja": "こう見えても俺、",
          "tc": "別看我這樣，",
          "sc": "别看我这样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443663,
          "spk": "裕太 (ユータ)",
          "ja": "秘密は守る主義なんだ",
          "tc": "我可是很會保密的喔。",
          "sc": "我可是很会保密的哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443681,
          "spk": "裕太 (ユータ)",
          "ja": "あとは、修学旅行といえば",
          "tc": "還有，說到校外教學，",
          "sc": "还有，说到校外教学，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443688,
          "spk": "裕太 (ユータ)",
          "ja": "枕投げとかね",
          "tc": "就不得不來場枕頭戰呢。",
          "sc": "就不得不来场枕头战呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443699,
          "spk": "裕太 (ユータ)",
          "ja": "<player>がしたいなら",
          "tc": "如果<player>有興趣，",
          "sc": "如果<player>有兴趣，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 443706,
          "spk": "裕太 (ユータ)",
          "ja": "枕をたくさん用意しておくよ",
          "tc": "我可以準備一堆枕頭喔。",
          "sc": "我可以准备一堆枕头哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 443717,
          "spk": "裕太 (ユータ)",
          "ja": "あとは……俺はあまり気が進まないけど",
          "tc": "還有……雖然我沒什麼興趣，",
          "sc": "还有……虽然我没什么兴趣，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 443724,
          "spk": "裕太 (ユータ)",
          "ja": "怪談話をするのも修学旅行の定番だね",
          "tc": "但講鬼故事也是校外教學必做的事呢。",
          "sc": "但讲鬼故事也是校外教学必做的事呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 443742,
          "spk": "裕太 (ユータ)",
          "ja": "俺はあまり気が進まないけど！",
          "tc": "雖然我對這個真的沒什麼興趣！",
          "sc": "虽然我对这个真的没什么兴趣！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7699,
      "rec_id": "TALK_ID_70_2120_010_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443760,
          "spk": "裕太 (ユータ)",
          "ja": "とにかく、泊まりだからこそ",
          "tc": "總之，",
          "sc": "总之，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443767,
          "spk": "裕太 (ユータ)",
          "ja": "できることとか楽しいことって",
          "tc": "還有很多很多好玩的事",
          "sc": "还有很多很多好玩的事"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443774,
          "spk": "裕太 (ユータ)",
          "ja": "いろいろあるからさ",
          "tc": "是一起過夜才能做的。",
          "sc": "是一起过夜才能做的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443785,
          "spk": "裕太 (ユータ)",
          "ja": "また絶対に",
          "tc": "所以你下次",
          "sc": "所以你下次"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443792,
          "spk": "裕太 (ユータ)",
          "ja": "泊まりにおいでね",
          "tc": "一定要再來我家過夜喔。",
          "sc": "一定要再来我家过夜哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443799,
          "spk": "裕太 (ユータ)",
          "ja": "待ってるよ",
          "tc": "我等你！",
          "sc": "我等你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7700,
      "rec_id": "TALK_ID_70_2130_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443823,
          "spk": "堇怜 (スミレ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443830,
          "spk": "堇怜 (スミレ)",
          "ja": "キミも釣りに来たの？",
          "tc": "你也來釣魚嗎？",
          "sc": "你也来钓鱼吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7701,
      "rec_id": "TALK_ID_70_2130_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443848,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、隣おいでよ",
          "tc": "來，到我旁邊來吧。",
          "sc": "来，到我旁边来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7702,
      "rec_id": "TALK_ID_70_2130_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443872,
          "spk": "堇怜 (スミレ)",
          "ja": "釣りって良いよね……",
          "tc": "釣魚很不錯吧……",
          "sc": "钓鱼很不错吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443879,
          "spk": "堇怜 (スミレ)",
          "ja": "静かな自然の中なのに、",
          "tc": "雖然身在寧靜的大自然中，",
          "sc": "虽然身在宁静的大自然中，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443886,
          "spk": "堇怜 (スミレ)",
          "ja": "魚との駆け引きの興奮を味わえて……",
          "tc": "卻能體驗與魚搏鬥的刺激……",
          "sc": "却能体验与鱼搏斗的刺激……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443897,
          "spk": "堇怜 (スミレ)",
          "ja": "まあでも、僕にとっては",
          "tc": "不過，對我來說，",
          "sc": "不过，对我来说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443904,
          "spk": "堇怜 (スミレ)",
          "ja": "仕事に近い感覚だけど……",
          "tc": "更像在工作就是了……",
          "sc": "更像在工作就是了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443915,
          "spk": "堇怜 (スミレ)",
          "ja": "魚はリンに売ったり、",
          "tc": "我釣到的魚會賣給林，",
          "sc": "我钓到的鱼会卖给林，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443922,
          "spk": "堇怜 (スミレ)",
          "ja": "自分で食べるために釣ってるんだ",
          "tc": "或是自己拿來吃。",
          "sc": "或是自己拿来吃。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443933,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、釣りばっかしてると",
          "tc": "只不過老是在釣魚的話，",
          "sc": "只不过老是在钓鱼的话，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443940,
          "spk": "堇怜 (スミレ)",
          "ja": "学生は勉強に集中しなさいって",
          "tc": "姊姊就會一直念我，",
          "sc": "姐姐就会一直念我，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 443947,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんがうるさいんだよ",
          "tc": "說學生就該專心讀書。",
          "sc": "说学生就该专心读书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7703,
      "rec_id": "TALK_ID_70_2130_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443971,
          "spk": "堇怜 (スミレ)",
          "ja": "言ってなかったっけ？",
          "tc": "我沒說過嗎？",
          "sc": "我没说过吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443978,
          "spk": "堇怜 (スミレ)",
          "ja": "通信制の学校に通ってるんだ",
          "tc": "我正在念函授學校。",
          "sc": "我正在念函授学校。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443989,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強は嫌いじゃないけどさ……",
          "tc": "雖然我不討厭念書……",
          "sc": "虽然我不讨厌念书……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443996,
          "spk": "堇怜 (スミレ)",
          "ja": "大学に行くってなったら",
          "tc": "可是如果要上大學，",
          "sc": "可是如果要上大学，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444003,
          "spk": "堇怜 (スミレ)",
          "ja": "お金がかかるだろ？",
          "tc": "會很花錢不是嗎？",
          "sc": "会很花钱不是吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444014,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も、村の外に",
          "tc": "雖然我也不是",
          "sc": "虽然我也不是"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444021,
          "spk": "堇怜 (スミレ)",
          "ja": "興味がないわけじゃないんだけど……",
          "tc": "對村子外面的世界沒有興趣……",
          "sc": "对村子外面的世界没有兴趣……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 444028,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが、また心配するだろうからなぁ……",
          "tc": "但畢竟又會讓姊姊擔心……",
          "sc": "但毕竟又会让姐姐担心……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7704,
      "rec_id": "TALK_ID_70_2130_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444046,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、あの人って無駄に心配性だろ？",
          "tc": "你也知道，我姊姊就是愛操心嘛。",
          "sc": "你也知道，我姐姐就是爱操心嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444064,
          "spk": "堇怜 (スミレ)",
          "ja": "頭がいいぶん、いろんな最悪のケースまで",
          "tc": "因為很聰明，所以連各種最壞的狀況",
          "sc": "因为很聪明，所以连各种最坏的状况"
        },
        {
          "f_idx": 3,
          "pidx_tc": 444071,
          "spk": "堇怜 (スミレ)",
          "ja": "考えちゃうんだろうけど……",
          "tc": "都先想到了……",
          "sc": "都先想到了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 444078,
          "spk": "堇怜 (スミレ)",
          "ja": "さすがに、ちょっと考えすぎなんだよね",
          "tc": "我是覺得她有點想太多了。",
          "sc": "我是觉得她有点想太多了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 444089,
          "spk": "堇怜 (スミレ)",
          "ja": "僕なんて、ピアスも",
          "tc": "就連耳環也是，",
          "sc": "就连耳环也是，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 444096,
          "spk": "堇怜 (スミレ)",
          "ja": "成人するまではダメって言われてるんだぜ",
          "tc": "姊姊命令我到成年之前都不可以打耳洞呢。",
          "sc": "姐姐命令我到成年之前都不可以打耳洞呢。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 444107,
          "spk": "堇怜 (スミレ)",
          "ja": "バイキンが入って腫れるかもしれないって……",
          "tc": "說要是細菌感染會紅腫發炎……",
          "sc": "说要是细菌感染会红肿发炎……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 444114,
          "spk": "堇怜 (スミレ)",
          "ja": "自分は開けてるくせにさ",
          "tc": "但她自己卻有打耳洞。",
          "sc": "但她自己却有打耳洞。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 444125,
          "spk": "堇怜 (スミレ)",
          "ja": "ほんと、過保護なんだ……",
          "tc": "真的是保護過頭了……",
          "sc": "真的是保护过头了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 444132,
          "spk": "堇怜 (スミレ)",
          "ja": "そのくせ、何でも一人で抱え込もうとするし……",
          "tc": "然而她卻總想一個人承擔一切……",
          "sc": "然而她却总想一个人承担一切……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 444139,
          "spk": "堇怜 (スミレ)",
          "ja": "まったく、世話の焼ける人なんだよね……",
          "tc": "真是讓人操心啊……",
          "sc": "真是让人操心啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7705,
      "rec_id": "TALK_ID_70_2130_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444163,
          "spk": "堇怜 (スミレ)",
          "ja": "……あ、<player>！",
          "tc": "……啊，<player>！",
          "sc": "……啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444170,
          "spk": "堇怜 (スミレ)",
          "ja": "引いてる、引いてるよっ！",
          "tc": "上鉤了，有魚上鉤了！",
          "sc": "上钩了，有鱼上钩了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7706,
      "rec_id": "TALK_ID_70_2130_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 444194,
          "spk": "堇怜 (スミレ)",
          "ja": "お～なかなかの大物だ……",
          "tc": "哦～還真大隻耶……",
          "sc": "哦～还真大只呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 444205,
          "spk": "堇怜 (スミレ)",
          "ja": "これだけ大きければ一日分……",
          "tc": "這麼大隻的話應該可以吃一天……",
          "sc": "这么大只的话应该可以吃一天……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 444212,
          "spk": "堇怜 (スミレ)",
          "ja": "いや、二日分は困らなさそう……",
          "tc": "不，吃兩天都沒問題……",
          "sc": "不，吃两天都没问题……"
        },
        {
