  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2429,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 59879,
          "spk": "裕太 (ユータ)",
          "ja": "一息つきたくなると、",
          "tc": "每當想要鬆口氣的時候，",
          "sc": "每当想要松口气的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 59886,
          "spk": "裕太 (ユータ)",
          "ja": "ここで景色を眺めて過ごすんだ",
          "tc": "我就會來這裡看風景度過一天。",
          "sc": "我就会来这里看风景度过一天。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 59893,
          "spk": "裕太 (ユータ)",
          "ja": "俺のお気に入りの場所だよ",
          "tc": "這是我很喜歡的地方喔。",
          "sc": "这是我很喜欢的地方哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2430,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 59917,
          "spk": "裕太 (ユータ)",
          "ja": "植物って、たくさん話しかけると",
          "tc": "植物這種東西，只要多跟它說說話，",
          "sc": "植物这种东西，只要多跟它说说话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 59924,
          "spk": "裕太 (ユータ)",
          "ja": "綺麗な花が咲くらしいんだ",
          "tc": "據說就會開出美麗的花朵喔。",
          "sc": "据说就会开出美丽的花朵哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 59935,
          "spk": "裕太 (ユータ)",
          "ja": "大きく育てよ～美しく咲けよ～",
          "tc": "要好好長大～開得又大又美喔～",
          "sc": "要好好长大～开得又大又美哦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2431,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 59966,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、これは……もしかして……",
          "tc": "咦？這是……難道說……",
          "sc": "咦？这是……难道说……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 59977,
          "spk": "裕太 (ユータ)",
          "ja": "わき芽が出てきたんじゃないか？",
          "tc": "長出側芽了嗎？",
          "sc": "长出侧芽了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 59984,
          "spk": "裕太 (ユータ)",
          "ja": "やった！　やっと成功だ！",
          "tc": "太好了！終於成功了！",
          "sc": "太好了！终于成功了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2432,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60008,
          "spk": "裕太 (ユータ)",
          "ja": "この子は俺のこと、どう思ってるのかな",
          "tc": "不知道這孩子覺得我怎麼樣，",
          "sc": "不知道这孩子觉得我怎么样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60015,
          "spk": "裕太 (ユータ)",
          "ja": "大切な友達だと思ってくれてたらいいな",
          "tc": "希望它認為我是一個重要的朋友。",
          "sc": "希望它认为我是一个重要的朋友。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2433,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60046,
          "spk": "裕太 (ユータ)",
          "ja": "雨、けっこう降ってるね",
          "tc": "雨下得很大呢。",
          "sc": "雨下得很大呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60053,
          "spk": "裕太 (ユータ)",
          "ja": "今日は濡れないでできることを",
          "tc": "今天是不是應該找些",
          "sc": "今天是不是应该找些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60060,
          "spk": "裕太 (ユータ)",
          "ja": "探したほうがよさそうかな",
          "tc": "不會被淋濕的活動比較好呢？",
          "sc": "不会被淋湿的活动比较好呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2434,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60084,
          "spk": "裕太 (ユータ)",
          "ja": "この雨、何時から降ってたんだろう",
          "tc": "這場雨是從什麼時候開始下的呢？",
          "sc": "这场雨是从什么时候开始下的呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60091,
          "spk": "裕太 (ユータ)",
          "ja": "寝てる間は気がつかなかったよ",
          "tc": "睡著的時候都沒有注意到。",
          "sc": "睡着的时候都没有注意到。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2435,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60115,
          "spk": "裕太 (ユータ)",
          "ja": "遠くの景色が雨で霧がかって見えるね",
          "tc": "遠處的景色都因為下雨變得霧濛濛的。",
          "sc": "远处的景色都因为下雨变得雾蒙蒙的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60133,
          "spk": "裕太 (ユータ)",
          "ja": "……なんだか、風流を感じるねぇ",
          "tc": "……總覺得別有一番韻味呢。",
          "sc": "……总觉得别有一番韵味呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2436,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1103",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60157,
          "spk": "裕太 (ユータ)",
          "ja": "この川の透明度は、何度見ても感動するよ",
          "tc": "這條河真的很清澈，每次看見都令人感動。",
          "sc": "这条河真的很清澈，每次看见都令人感动。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60164,
          "spk": "裕太 (ユータ)",
          "ja": "都会じゃこんなに綺麗な川、",
          "tc": "這麼美麗的河川，",
          "sc": "这么美丽的河川，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60171,
          "spk": "裕太 (ユータ)",
          "ja": "なかなか見られないんだ",
          "tc": "在城市裡不常見呢。",
          "sc": "在城市里不常见呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2437,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1104",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60195,
          "spk": "裕太 (ユータ)",
          "ja": "ここから川を見ると、太陽の光を浴びた水面が",
          "tc": "你看，從這邊看過去，",
          "sc": "你看，从这边看过去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60202,
          "spk": "裕太 (ユータ)",
          "ja": "キラキラ輝いててキレイなんだ",
          "tc": "沐浴在陽光下的水面閃閃發亮著。",
          "sc": "沐浴在阳光下的水面闪闪发亮着。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 60220,
          "spk": "裕太 (ユータ)",
          "ja": "何時間でも見てられるよね……",
          "tc": "可以在這裡看好幾個小時都不會膩……",
          "sc": "可以在这里看好几个小时都不会腻……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 60227,
          "spk": "裕太 (ユータ)",
          "ja": "ホント、助かるよ……",
          "tc": "真的很不錯……",
          "sc": "真的很不错……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2438,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1105",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60251,
          "spk": "裕太 (ユータ)",
          "ja": "川って、止まることなく",
          "tc": "河川總是不停流動，",
          "sc": "河川总是不停流动，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60258,
          "spk": "裕太 (ユータ)",
          "ja": "常に流れてるんだよ",
          "tc": "從來不會停止呢。",
          "sc": "从来不会停止呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60269,
          "spk": "裕太 (ユータ)",
          "ja": "……時間と一緒だね",
          "tc": "……就和時間一樣。",
          "sc": "……就和时间一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2439,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60293,
          "spk": "裕太 (ユータ)",
          "ja": "そういえば知ってる？",
          "tc": "話說你知道嗎？",
          "sc": "话说你知道吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60300,
          "spk": "裕太 (ユータ)",
          "ja": "春によく見られるメジロって鳥がいるんだけど",
          "tc": "春天有一種常見的鳥日文名字叫「繡眼鳥」，",
          "sc": "春天有一种常见的鸟日文名字叫“绣眼鸟”，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60307,
          "spk": "裕太 (ユータ)",
          "ja": "実はメグロって名前の鳥もいるんだって",
          "tc": "但其實也有一種鳥叫「目黑」喔。",
          "sc": "但其实也有一种鸟叫“目黑”哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2440,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60331,
          "spk": "裕太 (ユータ)",
          "ja": "俺の腕って、やっぱり細いかな？",
          "tc": "我的手臂果然太細了嗎？",
          "sc": "我的手臂果然太细了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60338,
          "spk": "裕太 (ユータ)",
          "ja": "前にシロージに二度見されたんだよね",
          "tc": "之前四郎治看到整個人愣了一下。",
          "sc": "之前四郎治看到整个人愣了一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 60356,
          "spk": "裕太 (ユータ)",
          "ja": "……筋トレしようかな",
          "tc": "要不要練一點肌肉呢……",
          "sc": "要不要练一点肌肉呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2441,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60380,
          "spk": "裕太 (ユータ)",
          "ja": "最近、俳句にハマってるんだ",
          "tc": "我最近對俳句很有興趣。",
          "sc": "我最近对俳句很有兴趣。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60387,
          "spk": "裕太 (ユータ)",
          "ja": "一句読んでみたから聞いてくれる？",
          "tc": "我做了一句詩，你可以聽聽看嗎？",
          "sc": "我做了一句诗，你可以听听看吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60398,
          "spk": "裕太 (ユータ)",
          "ja": "「一人でも　ベンチに残る　春のぬくみ」",
          "tc": "「一人獨坐　長椅邊猶有　春暖餘溫」",
          "sc": "“一人独坐　长椅边犹有　春暖余温”"
        },
        {
          "f_idx": 5,
          "pidx_tc": 60423,
          "spk": "裕太 (ユータ)",
          "ja": "……どう？　結構イカしてない？",
          "tc": "……怎麼樣？很有味道吧？",
          "sc": "……怎么样？很有味道吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2442,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60447,
          "spk": "裕太 (ユータ)",
          "ja": "ああっ……！",
          "tc": "啊啊……！",
          "sc": "啊啊……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60454,
          "spk": "裕太 (ユータ)",
          "ja": "また新たなインスピレーションが湧いた！",
          "tc": "我又湧出新的靈感了！",
          "sc": "我又涌出新的灵感了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60461,
          "spk": "裕太 (ユータ)",
          "ja": "工作スキルがどんどん上がっちゃうよ！",
          "tc": "勞作技巧要越來越強了！",
          "sc": "劳作技巧要越来越强了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2443,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60485,
          "spk": "裕太 (ユータ)",
          "ja": "あれ？　俺が想像してた",
          "tc": "奇怪？怎麼好像……",
          "sc": "奇怪？怎么好像……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60492,
          "spk": "裕太 (ユータ)",
          "ja": "完成図から遠のいてきてる……",
          "tc": "越來越偏離我原本想像的成品了……",
          "sc": "越来越偏离我原本想像的成品了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60503,
          "spk": "裕太 (ユータ)",
          "ja": "……まあ、これはこれでいいか！",
          "tc": "……不過這樣也很不錯嘛！",
          "sc": "……不过这样也很不错嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2444,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60527,
          "spk": "裕太 (ユータ)",
          "ja": "よし……ついに完成だ……",
          "tc": "好……終於完成了……",
          "sc": "好……终于完成了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60534,
          "spk": "裕太 (ユータ)",
          "ja": "今回はいい感じにできたかも",
          "tc": "這次感覺做得還不錯。",
          "sc": "这次感觉做得还不错。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60545,
          "spk": "裕太 (ユータ)",
          "ja": "上手に作れると熱中しちゃうね",
          "tc": "一旦做得順手，就會越做越入迷呢。",
          "sc": "一旦做得顺手，就会越做越入迷呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 60552,
          "spk": "裕太 (ユータ)",
          "ja": "物作りってすごく楽しいよ！",
          "tc": "自己做東西真的很好玩！",
          "sc": "自己做东西真的很好玩！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2445,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60583,
          "spk": "裕太 (ユータ)",
          "ja": "……ハッ！",
          "tc": "……啊！",
          "sc": "……啊！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60590,
          "spk": "裕太 (ユータ)",
          "ja": "ね、寝落ちかけてた……",
          "tc": "差、差點就睡著了……",
          "sc": "差、差点就睡着了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2446,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60614,
          "spk": "裕太 (ユータ)",
          "ja": "今日は楽しかったな",
          "tc": "今天過得真開心。",
          "sc": "今天过得真开心。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60621,
          "spk": "裕太 (ユータ)",
          "ja": "……明日はもっと楽しいといいな",
          "tc": "……希望明天可以更開心。",
          "sc": "……希望明天可以更开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2447,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60645,
          "spk": "裕太 (ユータ)",
          "ja": "この村の人はみんな、空模様を見るだけで",
          "tc": "這個村子裡的人啊，",
          "sc": "这个村子里的人啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 60652,
          "spk": "裕太 (ユータ)",
          "ja": "明日の天気を言い当てられるんだよ",
          "tc": "只要觀察天色，就能猜中明天的天氣喔。",
          "sc": "只要观察天色，就能猜中明天的天气哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 60663,
          "spk": "裕太 (ユータ)",
          "ja": "俺も住み続けてたら、",
          "tc": "如果我繼續住在這裡，",
          "sc": "如果我继续住在这里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 60670,
          "spk": "裕太 (ユータ)",
          "ja": "いつかわかるようになるのかな……？",
          "tc": "是不是有一天也能分辨天色呢……？",
          "sc": "是不是有一天也能分辨天色呢……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2448,
      "rec_id": "TALK_ID_YOUNG_MAN_ROUTINE_20_111_1200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 60694,
          "spk": "裕太 (ユータ)",
          "ja": "雨の休日にすべきことって",
