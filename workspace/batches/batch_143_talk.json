  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2648,
      "rec_id": "TALK_ID_BOY_PRESENT_20_112_0203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95242,
          "spk": "堇怜 (スミレ)",
          "ja": "あっ……！",
          "tc": "啊……！",
          "sc": "啊……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95249,
          "spk": "堇怜 (スミレ)",
          "ja": "もしかして僕に誕生日プレゼント？",
          "tc": "這難道是給我的生日禮物嗎？",
          "sc": "这难道是给我的生日礼物吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95256,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱりそうだよね？",
          "tc": "果然是這樣嗎？",
          "sc": "果然是这样吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95267,
          "spk": "堇怜 (スミレ)",
          "ja": "うわあ……嬉しいな！",
          "tc": "哇……好開心喔！",
          "sc": "哇……好开心哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 95274,
          "spk": "堇怜 (スミレ)",
          "ja": "ありがとう、<player>！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 95285,
          "spk": "堇怜 (スミレ)",
          "ja": "正直言うとさ……",
          "tc": "坦白說……",
          "sc": "坦白说……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 95292,
          "spk": "堇怜 (スミレ)",
          "ja": "誰か僕にプレゼントをくれないかなって",
          "tc": "我確實有點期待",
          "sc": "我确实有点期待"
        },
        {
          "f_idx": 7,
          "pidx_tc": 95299,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっとだけ期待してたんだ",
          "tc": "會不會有人送禮物給我。",
          "sc": "会不会有人送礼物给我。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 95310,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、実際にもらったらプレゼントよりも",
          "tc": "不過實際收到禮物之後，我發現比起禮物，",
          "sc": "不过实际收到礼物之后，我发现比起礼物，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 95317,
          "spk": "堇怜 (スミレ)",
          "ja": "祝ってくれた気持ちが嬉しくなったよ",
          "tc": "那份祝福我的心情讓我更開心！",
          "sc": "那份祝福我的心情让我更开心！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 95324,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、本当にありがとう！",
          "tc": "真的很謝謝你，<player>！",
          "sc": "真的很谢谢你，<player>！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2649,
      "rec_id": "TALK_ID_BOY_PRESENT_20_112_0204",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95348,
          "spk": "堇怜 (スミレ)",
          "ja": "いや、さすがに貰ってばっかなのは悪いって",
          "tc": "不不不，我不能老是一直拿你的東西啦。",
          "sc": "不不不，我不能老是一直拿你的东西啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95355,
          "spk": "堇怜 (スミレ)",
          "ja": "お小遣いとか大丈夫？",
          "tc": "你零用錢夠用嗎？",
          "sc": "你零用钱够用吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95362,
          "spk": "堇怜 (スミレ)",
          "ja": "あんまり無理しないでくれよ？",
          "tc": "不要勉強喔。",
          "sc": "不要勉强哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2650,
      "rec_id": "TALK_ID_BOY_THUNDERSTORM_20_112_0300",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95386,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、知ってる？",
          "tc": "<player>，你知道嗎，",
          "sc": "<player>，你知道吗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95393,
          "spk": "堇怜 (スミレ)",
          "ja": "雷ってたまに人に落ちることもあるんだよ",
          "tc": "閃電有時候會打到人喔。",
          "sc": "闪电有时候会打到人哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95404,
          "spk": "堇怜 (スミレ)",
          "ja": "な、怖いだろ？",
          "tc": "很恐怖對吧？",
          "sc": "很恐怖对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95415,
          "spk": "堇怜 (スミレ)",
          "ja": "危ないから今日みたいな日は",
          "tc": "因為很危險，所以我覺得像今天這種日子",
          "sc": "因为很危险，所以我觉得像今天这种日子"
        },
        {
          "f_idx": 4,
          "pidx_tc": 95422,
          "spk": "堇怜 (スミレ)",
          "ja": "家でじっとしてる方がいいと思うよ",
          "tc": "你還是乖乖待在家裡比較好喔。",
          "sc": "你还是乖乖待在家里比较好哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2651,
      "rec_id": "TALK_ID_BOY_THUNDERSTORM_20_112_0301",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95453,
          "spk": "堇怜 (スミレ)",
          "ja": "うわ、すっごい雷だな……",
          "tc": "哇，雷聲好驚人……",
          "sc": "哇，雷声好惊人……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95464,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっとだけ外に出て、",
          "tc": "都有點想去外面",
          "sc": "都有点想去外面"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95471,
          "spk": "堇怜 (スミレ)",
          "ja": "様子を見てみたくなるくらいだよ",
          "tc": "看看樣子了。",
          "sc": "看看样子了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95478,
          "spk": "堇怜 (スミレ)",
          "ja": "そうは言っても危ないから出ないけどさ",
          "tc": "話雖如此，因為很危險的，所以我不會這麼做啦。",
          "sc": "话虽如此，因为很危险的，所以我不会这么做啦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 95489,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>もほどほどにしておいた方が",
          "tc": "<player>，你也差不多了",
          "sc": "<player>，你也差不多了"
        },
        {
          "f_idx": 5,
          "pidx_tc": 95496,
          "spk": "堇怜 (スミレ)",
          "ja": "いいんじゃない？",
          "tc": "就回家比較好吧？",
          "sc": "就回家比较好吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2652,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95520,
          "spk": "堇怜 (スミレ)",
          "ja": "今、ストレッチしてたんだ",
          "tc": "我現在正在做伸展操，",
          "sc": "我现在正在做伸展操，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95527,
          "spk": "堇怜 (スミレ)",
          "ja": "体を動かすと気持ちいいよ",
          "tc": "活動筋骨的感覺真好。",
          "sc": "活动筋骨的感觉真好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95538,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も一緒にどうだい？",
          "tc": "<player>要不要也跟我一起做啊？",
          "sc": "<player>要不要也跟我一起做啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2653,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95562,
          "spk": "堇怜 (スミレ)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95569,
          "spk": "堇怜 (スミレ)",
          "ja": "朝早くから動き出しててえらいよ",
          "tc": "一大早就開始活動真的很了不起。",
          "sc": "一大早就开始活动真的很了不起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95580,
          "spk": "堇怜 (スミレ)",
          "ja": "時は金なり、早起きは三文の徳だもんね！",
          "tc": "俗話說時間就是金錢，早起的鳥兒有蟲吃嘛！",
          "sc": "俗话说时间就是金钱，早起的鸟儿有虫吃嘛！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95587,
          "spk": "堇怜 (スミレ)",
          "ja": "キミもよくわかってるね！",
          "tc": "你很懂嘛！",
          "sc": "你很懂嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2654,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95618,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は何をして過ごそうか……",
          "tc": "今天要做什麼好呢……",
          "sc": "今天要做什么好呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95625,
          "spk": "堇怜 (スミレ)",
          "ja": "釣りか、遊びか、小銭拾いか……",
          "tc": "釣魚？玩遊戲？還是撿零錢……",
          "sc": "钓鱼？玩游戏？还是捡零钱……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95636,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も遊びに行くなら、",
          "tc": "<player>如果也要去玩的話，",
          "sc": "<player>如果也要去玩的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95643,
          "spk": "堇怜 (スミレ)",
          "ja": "ストレッチしといたほうがいいんじゃない？",
          "tc": "不如先做點伸展操吧？",
          "sc": "不如先做点伸展操吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2655,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95667,
          "spk": "堇怜 (スミレ)",
          "ja": "このお菓子、美味しそうなんだけど、",
          "tc": "這個點心看起來好好吃喔，",
          "sc": "这个点心看起来好好吃哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95674,
          "spk": "堇怜 (スミレ)",
          "ja": "今、手持ちがちょっと心もとないな……",
          "tc": "但現在手頭有點緊……",
          "sc": "但现在手头有点紧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95685,
          "spk": "堇怜 (スミレ)",
          "ja": "どっかで誰かのお手伝いして、",
          "tc": "去看看有沒有人需要幫忙，",
          "sc": "去看看有没有人需要帮忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95692,
          "spk": "堇怜 (スミレ)",
          "ja": "お駄賃をたかってこようかな……",
          "tc": "賺點零用錢好了……",
          "sc": "赚点零用钱好了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2656,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95716,
          "spk": "堇怜 (スミレ)",
          "ja": "こうやって見てると、",
          "tc": "像這樣在店裡逛，",
          "sc": "像这样在店里逛，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95723,
          "spk": "堇怜 (スミレ)",
          "ja": "いろいろ欲しくなっちゃうよね……",
          "tc": "想要的東西就會越來越多呢……",
          "sc": "想要的东西就会越来越多呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95734,
          "spk": "堇怜 (スミレ)",
          "ja": "サザンカさん、割引してくれると思う？",
          "tc": "你覺得茶梅姐會願意幫我打折嗎？",
          "sc": "你觉得茶梅姐会愿意帮我打折吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2657,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95758,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、欲しいものがあるの？",
          "tc": "<player>有想要的東西嗎？",
          "sc": "<player>有想要的东西吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95769,
          "spk": "堇怜 (スミレ)",
          "ja": "僕もあるけど、今は我慢かなぁ……",
          "tc": "我也有，但只能先忍忍了……",
          "sc": "我也有，但只能先忍忍了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2658,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95800,
          "spk": "堇怜 (スミレ)",
          "ja": "お地蔵さんって",
          "tc": "你覺得地藏菩薩",
          "sc": "你觉得地藏菩萨"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95807,
          "spk": "堇怜 (スミレ)",
          "ja": "願い事を叶えたりしてくれると思う？",
          "tc": "會幫我實現願望嗎？",
          "sc": "会帮我实现愿望吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95818,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱ、タダじゃ叶えてくれないか",
          "tc": "我想應該是不會免費實現願望的吧。",
          "sc": "我想应该是不会免费实现愿望的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2659,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95842,
          "spk": "堇怜 (スミレ)",
          "ja": "このあたり、いつもキレイだよね",
          "tc": "這附近總是很乾淨呢，",
          "sc": "这附近总是很干净呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95849,
          "spk": "堇怜 (スミレ)",
          "ja": "誰か信心深い人が掃除してるのかな",
          "tc": "……不知道是不是有很虔誠的人在打掃。",
          "sc": "……不知道是不是有很虔诚的人在打扫。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2660,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95880,
          "spk": "堇怜 (スミレ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95887,
          "spk": "堇怜 (スミレ)",
          "ja": "暇そうだね",
          "tc": "你好像很閒耶。",
          "sc": "你好像很闲呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95898,
          "spk": "堇怜 (スミレ)",
          "ja": "僕？　僕は暇に決まってるじゃん！",
          "tc": "我嗎？我當然很閒啊！",
          "sc": "我吗？我当然很闲啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 95905,
          "spk": "堇怜 (スミレ)",
          "ja": "やることとしたら、小銭探しくらいだよ！",
          "tc": "要做的事情，也就只有撿零錢而已！",
          "sc": "要做的事情，也就只有捡零钱而已！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2661,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95936,
          "spk": "堇怜 (スミレ)",
          "ja": "いい感じに手入れできたかな……",
          "tc": "我應該保養得還不錯吧……",
          "sc": "我应该保养得还不错吧……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95947,
          "spk": "堇怜 (スミレ)",
          "ja": "これで立派な魚が釣れるはず！",
          "tc": "這下應該就能釣到大魚了！",
          "sc": "这下应该就能钓到大鱼了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 95954,
          "spk": "堇怜 (スミレ)",
          "ja": "がんばるぞ……！",
          "tc": "我要努力釣魚……！",
          "sc": "我要努力钓鱼……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2662,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 95985,
          "spk": "堇怜 (スミレ)",
          "ja": "新しい釣具を買うお金はないし",
          "tc": "畢竟沒錢買新的釣具，",
          "sc": "毕竟没钱买新的钓具，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 95992,
          "spk": "堇怜 (スミレ)",
          "ja": "大切に使わないとな……",
          "tc": "得好好珍惜才行……",
          "sc": "得好好珍惜才行……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 96010,
          "spk": "堇怜 (スミレ)",
          "ja": "今度、<player>の道具も見てあげるよ",
          "tc": "下次我也來幫忙看看<player>你的用具吧。",
          "sc": "下次我也来帮忙看看<player>你的用具吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2663,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_1032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 96041,
          "spk": "堇怜 (スミレ)",
          "ja": "よーし、綺麗になった",
          "tc": "好，變乾淨了。",
          "sc": "好，变干净了。"
        },
        {
          "f_idx": 1,
