          "spk": "洋 (ヨウ)",
          "ja": "そんなに嫌なんだ",
          "tc": "這麼不喜歡啊。",
          "sc": "这么不喜欢啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 211530,
          "spk": "驹子 (コマコ)",
          "ja": "そう言わずに、",
          "tc": "別這麼說嘛，",
          "sc": "别这么说嘛，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 211537,
          "spk": "驹子 (コマコ)",
          "ja": "この子のためを思って飼ってあげて……！",
          "tc": "為了這孩子著想，你就養牠嘛……！",
          "sc": "为了这孩子着想，你就养它嘛……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 211546,
          "spk": "主角心声/旁白/选项",
          "ja": "わかった",
          "tc": "知道了",
