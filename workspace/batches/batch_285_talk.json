      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367670,
          "spk": "四郎治 (シロージ)",
          "ja": "そうか、ちょうどいい",
          "tc": "這樣啊，那正好，",
          "sc": "这样啊，那正好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367677,
          "spk": "四郎治 (シロージ)",
          "ja": "手伝ってほしいことがあったんだよ",
          "tc": "我有事要請你幫忙。",
          "sc": "我有事要请你帮忙。"
