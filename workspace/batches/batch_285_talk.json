      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 211451,
          "spk": "驹子 (コマコ)",
          "ja": "で、でもうちも飼えないし、",
          "tc": "可、可是我也不能養，",
          "sc": "可、可是我也不能养，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 211458,
          "spk": "驹子 (コマコ)",
          "ja": "あそこで育てるのが一番いいと思うの……",
          "tc": "把牠養在你那邊是最好的方式……",
          "sc": "把它养在你那边是最好的方式……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 211476,
          "spk": "驹子 (コマコ)",
          "ja": "だから……お願い、<player>……",
          "tc": "所以……拜託你，<player>……",
          "sc": "所以……拜托你，<player>……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 211483,
          "spk": "驹子 (コマコ)",
          "ja": "預かってあげて……",
          "tc": "你就養牠嘛……",
          "sc": "你就养它嘛……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 211492,
          "spk": "主角心声/旁白/选项",
          "ja": "わかった",
          "tc": "知道了",
          "sc": "知道了"
        },
        {
