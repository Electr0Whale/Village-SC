      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 354819,
          "spk": "木助 (キスケ)",
          "ja": "……おかえり、コダマ",
          "tc": "……歡迎回來，木珠。",
          "sc": "……欢迎回来，木珠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 354830,
          "spk": "木助 (キスケ)",
          "ja": "聞こえるか、てめぇの面倒は",
          "tc": "你有聽到嗎？",
          "sc": "你听见了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 354837,
          "spk": "木助 (キスケ)",
          "ja": "<player>が見ておいてくれるってよ",
          "tc": "<player>說會負責照顧妳喔。",
          "sc": "<player>说会负责照顾你啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 354848,
          "spk": "木助 (キスケ)",
          "ja": "だから……安心して眠れ……",
          "tc": "所以……你就放心沉睡吧……",
          "sc": "所以……你就放心沉睡吧……"
