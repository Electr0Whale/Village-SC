      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 211374,
          "spk": "洋 (ヨウ)",
          "ja": "そっかぁ……残念だね",
          "tc": "這樣啊……真可惜。",
          "sc": "这样啊……真可惜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 211394,
          "spk": "驹子 (コマコ)",
          "ja": "え、ええっ？",
          "tc": "咦、咦咦？",
          "sc": "咦、咦咦？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 211401,
          "spk": "驹子 (コマコ)",
          "ja": "ほんとに？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 211410,
          "spk": "驹子 (コマコ)",
          "ja": "……どうしても、ダメかな？",
          "tc": "……無論如何都不行嗎？",
          "sc": "……无论如何都不行吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 211417,
          "spk": "驹子 (コマコ)",
          "ja": "この犬、飼ってくれないかな？",
          "tc": "不收留這隻狗嗎？",
          "sc": "不收留这只狗吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 211426,
          "spk": "主角心声/旁白/选项",
          "ja": "いいよ",
          "tc": "好啊",
          "sc": "好啊"
        },
        {
          "f_idx": 7,
          "pidx_tc": 211433,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
