      "rec_id": "TALK_ID_10_0602_067_02_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355659,
          "spk": "林 (リン)",
          "ja": "……そうね",
          "tc": "……是啊。",
          "sc": "……是啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355672,
          "spk": "帷 (トバリ)",
          "ja": "私たちは、生きなきゃね",
          "tc": "我們必須活下去才行呢。",
          "sc": "我们必须活下去才行呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 355679,
          "spk": "帷 (トバリ)",
          "ja": "なにがあっても……",
          "tc": "不管發生什麼事……",
          "sc": "不管发生什么事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 355690,
          "spk": "帷 (トバリ)",
          "ja": "……帰ろう",
          "tc": "……回去吧。",
          "sc": "……回去吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 355697,
          "spk": "帷 (トバリ)",
          "ja": "私たちの家へ……",
          "tc": "回我們的家……",
          "sc": "回我们的家……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 355710,
          "spk": "林 (リン)",
          "ja": "ええ、<player>が救った、この土地で……",
          "tc": "沒錯，因為在<player>所拯救的這片土地上……",
          "sc": "没错，因为在<player>所拯救的这片土地上……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 355717,
          "spk": "林 (リン)",
          "ja": "日々の暮らしが待ってるのだから",
          "tc": "日常的生活還在等著我們呢。",
          "sc": "日常的生活还在等着我们呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 355735,
          "spk": "林 (リン)",
          "ja": "帰りましょう、彼ヶ津村へ",
          "tc": "大家回去吧，回到彼津村。",
          "sc": "大家回去吧，回到彼津村。"
        }
      ]
    },
