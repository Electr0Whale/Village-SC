      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214303,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱり……！",
          "tc": "果然是這樣……！",
          "sc": "果然是这样……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214310,
          "spk": "堇怜 (スミレ)",
          "ja": "あれから山に行ったっきりなんだ！",
          "tc": "她在那之後進了山就沒回來了！",
          "sc": "她在那之后进了山就没回来了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8126,
      "rec_id": "TALK_ID_10_0102_037_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214333,
          "spk": "林 (リン)",
          "ja": "山はコマコとシロージが探してくれてるわ",
          "tc": "山那邊有駒子與四郎治他們在幫忙找，",
          "sc": "山那边有驹子与四郎治他们在帮忙找，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214340,
          "spk": "林 (リン)",
          "ja": "私たちも行きましょう！",
          "tc": "我們也過去吧！",
          "sc": "我们也过去吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8127,
      "rec_id": "TALK_ID_10_0102_037_04_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214358,
          "spk": "堇怜 (スミレ)",
          "ja": "え！？　ちょっと待って！",
          "tc": "咦！？等一下！",
          "sc": "咦！？等一下！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214365,
          "spk": "堇怜 (スミレ)",
          "ja": "こいつにも探させるの！？",
          "tc": "也要讓他幫忙找嗎！？",
          "sc": "也要让他帮忙找吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214378,
          "spk": "林 (リン)",
          "ja": "キスケさんが連れて来いって言うのよ",
          "tc": "是木助哥說要帶他過來的。",
          "sc": "是木助哥说要带他过来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214391,
          "spk": "堇怜 (スミレ)",
          "ja": "猫の手でも借りたいのか……",
          "tc": "現在只能用盡一切手段去找人了嗎……",
          "sc": "现在只能用尽一切手段去找人了吗……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214404,
          "spk": "林 (リン)",
          "ja": "ほら、早く行きましょう！",
          "tc": "好了，我們快出發吧！",
          "sc": "好了，我们快出发吧！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 214411,
          "spk": "林 (リン)",
          "ja": "午後１１時になる前に見つけないと！",
          "tc": "得在晚上11點前找到人才行！",
          "sc": "得在晚上11点前找到人才行！"
        }
      ]
    },
