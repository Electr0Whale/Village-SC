      "rec_id": "TALK_ID_70_0040_001_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367695,
          "spk": "四郎治 (シロージ)",
          "ja": "無理強いするつもりはねぇが",
          "tc": "雖然我不想勉強你，",
          "sc": "虽然我不想勉强你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367702,
          "spk": "四郎治 (シロージ)",
          "ja": "お手伝い券を使いたいんだろ？",
          "tc": "但你想用掉幫忙券吧？",
          "sc": "但你想用掉帮忙券吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8297,
      "rec_id": "TALK_ID_70_0040_001_03_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367720,
          "spk": "四郎治 (シロージ)",
          "ja": "だったら簡単な手伝いがあるんだ",
          "tc": "既然這樣，我有件簡單的事想拜託你。",
          "sc": "既然这样，我有件简单的事想拜托你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8298,
      "rec_id": "TALK_ID_70_0090_001_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 359844,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの時間を割いて",
          "tc": "畢竟這等於是要我",
          "sc": "毕竟这等于是要我"
        },
        {
          "f_idx": 1,
          "pidx_tc": 359851,
          "spk": "今野 (コンノ)",
          "ja": "アナタに付き合うのですから、",
          "tc": "抽出時間應付您，",
          "sc": "抽出时间应付您，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 359858,
          "spk": "今野 (コンノ)",
          "ja": "これぐらいいただくのは当然ですヨ",
          "tc": "所以收點費用是應該的嘛。",
          "sc": "所以收点费用是应该的嘛哟～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8299,
      "rec_id": "TALK_ID_70_0090_003_07_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360467,
          "spk": "今野 (コンノ)",
          "ja": "これで少しは元気が出ます",
          "tc": "這樣我也稍微比較有精神了。",
          "sc": "这样我也稍微比较有精神了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 360474,
          "spk": "今野 (コンノ)",
          "ja": "些細な額とはいえ",
          "tc": "雖然不是什麼大數目，",
          "sc": "虽然不是什么大数目，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 360481,
          "spk": "今野 (コンノ)",
          "ja": "手元に金があると安心しますねェ",
          "tc": "但手頭上有錢還是很令人放心啊。",
          "sc": "但手头上有钱还是很令人放心呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8300,
      "rec_id": "TALK_ID_70_0090_003_07_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 360505,
          "spk": "今野 (コンノ)",
          "ja": "……えっ？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 360512,
          "spk": "今野 (コンノ)",
          "ja": "これっぽっちしか持っていないんですか？",
          "tc": "您手上只有這點錢啊？",
          "sc": "您手上只有这点钱啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 360519,
          "spk": "今野 (コンノ)",
          "ja": "ずいぶんと慎ましい暮らしがお好みのようで",
          "tc": "您似乎很喜歡安分守己地過日子啊。",
          "sc": "您似乎很喜欢安分守己地过日子啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 360530,
          "spk": "今野 (コンノ)",
          "ja": "……まあ、ないよりマシですねェ",
          "tc": "……算了，有總比沒有好，",
          "sc": "……算了，有总比没有好，"
        },
        {
          "f_idx": 4,
