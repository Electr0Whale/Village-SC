      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 216798,
          "spk": "洋 (ヨウ)",
          "ja": "ほ、ほんとう！？",
          "tc": "真、真的嗎！？",
          "sc": "真、真的吗！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 216805,
          "spk": "洋 (ヨウ)",
          "ja": "ありがとう、<player>！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 216816,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃんがニワトリになって、",
          "tc": "等到嗶羅長大成雞，",
          "sc": "等到哔罗长大成鸡，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 216823,
          "spk": "洋 (ヨウ)",
          "ja": "タマゴを産んだら、<player>にあげるからね！",
          "tc": "會下蛋之後，都會給<player>的！",
          "sc": "会下蛋之后，都会给<player>的！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 216834,
          "spk": "洋 (ヨウ)",
          "ja": "じゃ、じゃあさっそく",
          "tc": "那、那事不宜遲，",
          "sc": "那、那事不宜迟，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 216841,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん、鶏小屋につれてくる",
          "tc": "我們得做好準備，",
          "sc": "我们得做好准备，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 216848,
          "spk": "洋 (ヨウ)",
          "ja": "準備をととのえなくちゃ！",
          "tc": "把嗶羅帶到雞舍去才行！",
          "sc": "把哔罗带到鸡舍去才行！"
        }
      ]
    },
    {
