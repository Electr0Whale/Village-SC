          "ja": "期待してもいいぜ～～",
          "tc": "你就好好期待吧～～",
          "sc": "你就好好期待吧～～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8294,
      "rec_id": "TALK_ID_70_0030_004_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364324,
          "spk": "木助 (キスケ)",
          "ja": "人に親切にさらたときゃ",
          "tc": "有人釋出善意的時候，",
          "sc": "有人释出善意的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364331,
          "spk": "木助 (キスケ)",
          "ja": "笑顔で「ありがとう」だろが",
          "tc": "就該笑著說「謝謝」接受才對吧？",
          "sc": "就该笑着说“谢谢”接受才对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364347,
          "spk": "木助 (キスケ)",
          "ja": "ったく……躾がなってねぇやつだなァ",
          "tc": "真是……沒禮貌的傢伙。",
          "sc": "真是……没礼貌的家伙。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364354,
          "spk": "木助 (キスケ)",
          "ja": "親の顔がみてみてェよ……",
          "tc": "真不知道你父母都怎麼教的……",
          "sc": "真不知道你父母都怎么教的……"
        }
      ]
    },
    {
