        {
          "f_idx": 2,
          "pidx_tc": 216754,
          "spk": "洋 (ヨウ)",
          "ja": "飼ってくれる？",
          "tc": "養在你家裡嗎？",
          "sc": "养在你家里吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 216763,
