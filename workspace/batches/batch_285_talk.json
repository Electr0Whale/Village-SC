      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 355585,
          "spk": "木助 (キスケ)",
          "ja": "さあ、みんな",
          "tc": "好了，大家。",
          "sc": "好了，大家。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 355592,
          "spk": "木助 (キスケ)",
          "ja": "この村を蝕む土地神も、悪い怨霊も消えた",
          "tc": "侵蝕這座村子的土地神，還有壞怨靈都消失了。",
          "sc": "侵蚀这座村子的土地神，还有坏怨灵都消失了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 355610,
          "spk": "帷 (トバリ)",
          "ja": "キスケさん……",
          "tc": "木助先生……",
          "sc": "木助先生……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 355621,
          "spk": "林 (リン)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 355634,
          "spk": "木助 (キスケ)",
          "ja": "ここにはもう用はない",
          "tc": "這裡的事情都處理完了。",
          "sc": "这里的事情都处理完了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 355641,
          "spk": "木助 (キスケ)",
          "ja": "さあ、彼ヶ津村へ帰ろう",
          "tc": "好了，大家回彼津村去吧。",
          "sc": "好了，大家回彼津村去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
