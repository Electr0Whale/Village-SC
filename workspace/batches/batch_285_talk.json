          "tc": "你不明白現在事態緊急嗎……",
          "sc": "你不明白现在事态紧急吗……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214623,
          "spk": "木助 (キスケ)",
          "ja": "……てめぇは報酬がないと、",
          "tc": "……沒有報酬，",
          "sc": "……没有报酬，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214630,
          "spk": "木助 (キスケ)",
          "ja": "俺たちの言うことは聞かねえんだったな？",
          "tc": "你就不願意照我們說的去做，是吧？",
          "sc": "你就不愿意照我们说的去做，是吧？"
        }
      ]
    },
    {
