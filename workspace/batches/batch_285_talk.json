  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8092,
      "rec_id": "TALK_ID_10_0102_030_01_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209572,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタさ、あの庭を開拓するんよね？",
          "tc": "你是要開墾那片庭院對吧？",
          "sc": "你是要开垦那片庭院对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209579,
          "spk": "茶梅 (サザンカ)",
          "ja": "だったらカマとか必要じゃね？",
          "tc": "那應該需要鐮刀之類的？",
          "sc": "那应该需要镰刀之类的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209586,
          "spk": "茶梅 (サザンカ)",
          "ja": "もちろん取り揃えてるから見てってよ",
          "tc": "當然，這裡應有盡有，你可以慢慢逛。",
          "sc": "当然，这里应有尽有，你可以慢慢逛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8093,
      "rec_id": "TALK_ID_10_0102_030_01_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209612,
          "spk": "茶梅 (サザンカ)",
          "ja": "どしたん？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 209619,
          "spk": "茶梅 (サザンカ)",
          "ja": "雑貨よりアタシが気になる？",
          "tc": "比起雜貨，你更在意我嗎？",
          "sc": "比起杂货，你更在意我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209626,
          "spk": "茶梅 (サザンカ)",
          "ja": "それとも、見られてたら選びにくいタイプ？",
          "tc": "還是說，你是那種被盯著就不太敢買東西的人？",
          "sc": "还是说，你是那种被盯着就不太敢买东西的人？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8095,
      "rec_id": "TALK_ID_10_0102_030_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217282,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、チナナさんに、<player>じゃないか",
          "tc": "哦，是琪娜娜姐和<player>！",
          "sc": "哦，是琪娜娜姐和<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217289,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなところで何してるの？",
          "tc": "你們在這裡做什麼？",
          "sc": "你们在这里做什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、お二人とも",
          "tc": "嗨，兩位。",
          "sc": "嗨，两位。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217311,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>がハスミに用事だよ",
          "tc": "<player>有事找蓮實。",
          "sc": "<player>有事找莲实。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217318,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと時間とれるかな？",
          "tc": "現在有空嗎？",
          "sc": "现在有空吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217331,
          "spk": "莲实 (ハスミ)",
          "ja": "診療所に来るだなんて、",
          "tc": "居然會來診所，",
          "sc": "居然会来诊所，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 217338,
          "spk": "莲实 (ハスミ)",
          "ja": "どこか、お加減でも悪いのですか？",
          "tc": "有什麼地方不舒服嗎？",
          "sc": "有什么地方不舒服吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 217349,
          "spk": "莲实 (ハスミ)",
          "ja": "ここには病室もありますし、",
          "tc": "診所裡面也有病房，",
          "sc": "诊所里面也有病房，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 217356,
          "spk": "莲实 (ハスミ)",
          "ja": "私もすぐに診察できますから……",
          "tc": "我也可以馬上幫你看病……",
          "sc": "我也可以马上帮你看病……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 217369,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは、ハスミ、心配し過ぎだよ",
          "tc": "啊哈哈，蓮實，妳擔心過頭了。",
          "sc": "啊哈哈，莲实，你担心过头了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 217376,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>の顔色を見てみなよ、",
          "tc": "妳看看<player>的臉色，",
          "sc": "你看看<player>的脸色，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 217383,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこも悪いようには見えないだろう？",
          "tc": "怎麼看都不像是生病的樣子嘛。",
          "sc": "怎么看都不像是生病的样子嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8096,
      "rec_id": "TALK_ID_10_0102_030_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217401,
          "spk": "莲实 (ハスミ)",
          "ja": "だって、あの土地の管理を言い渡されたのよ",
          "tc": "但他可是被分配去管理那片土地呀。",
          "sc": "但他可是被分配去管理那片土地呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217408,
          "spk": "莲实 (ハスミ)",
          "ja": "きっと大変なお仕事だから、",
          "tc": "想必是很辛苦的工作，",
          "sc": "想必是很辛苦的工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217415,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れが溜まってしまったのかと……",
          "tc": "我擔心會不會積累了不少疲勞……",
          "sc": "我担心会不会积累了不少疲劳……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8097,
      "rec_id": "TALK_ID_10_0102_030_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217433,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さん、いつも深く考えすぎだよ",
          "tc": "姊姊總是想太多了。",
          "sc": "姐姐总是想太多了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217440,
          "spk": "堇怜 (スミレ)",
          "ja": "その気負うクセ、直したほうがいいと思う",
          "tc": "妳這容易緊張的習慣，還是改一改會比較好喔。",
          "sc": "你这容易紧张的习惯，还是改一改会比较好哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8098,
      "rec_id": "TALK_ID_10_0102_030_02_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217467,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、僕とハスミ姉さんは姉弟なんだ！",
          "tc": "<player>，我和蓮實是姊弟。",
          "sc": "<player>，我和莲实是姐弟。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217474,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんは心配性で口うるさいかもしれないけど、",
          "tc": "姊姊很愛操心，可能有點愛嘮叨，",
          "sc": "姐姐很爱操心，可能有点爱唠叨，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217481,
          "spk": "堇怜 (スミレ)",
          "ja": "僕らと仲良くしてくれると嬉しいな",
          "tc": "但還是希望你能跟我們好好相處。",
          "sc": "但还是希望你能跟我们好好相处。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217494,
          "spk": "莲实 (ハスミ)",
          "ja": "こら、スミレ……",
          "tc": "喂，堇怜……",
          "sc": "喂，堇怜……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217501,
          "spk": "莲实 (ハスミ)",
          "ja": "そういう言い方はやめなさい……",
          "tc": "怎麼那麼說呢……",
          "sc": "怎么那么说呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8099,
      "rec_id": "TALK_ID_10_0102_030_02_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217519,
          "spk": "堇怜 (スミレ)",
          "ja": "ごめんごめん、悪気はないんだ",
          "tc": "抱歉抱歉。我沒有惡意。",
          "sc": "抱歉抱歉。我没有恶意。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8100,
      "rec_id": "TALK_ID_10_0102_030_02_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217549,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃ、姉さん",
          "tc": "先這樣吧，姊姊。",
          "sc": "先这样吧，姐姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217556,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は遊びに出かけるから",
          "tc": "我要去外面玩囉。",
          "sc": "我要出去玩啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217569,
          "spk": "莲实 (ハスミ)",
          "ja": "えっ……スミレ……",
          "tc": "咦……堇怜……",
          "sc": "咦……堇怜……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217576,
          "spk": "莲实 (ハスミ)",
          "ja": "お昼ご飯は……",
          "tc": "午餐呢……",
          "sc": "午餐呢……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217589,
          "spk": "堇怜 (スミレ)",
          "ja": "いらない！",
          "tc": "不用了！",
          "sc": "不用了！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217596,
          "spk": "堇怜 (スミレ)",
          "ja": "もしお腹が減っても、",
          "tc": "就算我真的肚子餓了，",
          "sc": "就算我真的肚子饿了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 217603,
          "spk": "堇怜 (スミレ)",
          "ja": "兵糧丸つくってカジるから大丈夫！",
          "tc": "我也會自己做兵糧丸來吃的，別擔心！",
          "sc": "我也会自己做兵粮丸来吃的，别担心！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 217614,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃ、姉さん、行ってきます！",
          "tc": "那麼，姊姊，我先走了！",
          "sc": "那么，姐姐，我先走了！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 217621,
          "spk": "堇怜 (スミレ)",
          "ja": "チナナさん、<player>、またね！",
          "tc": "琪娜娜姐、<player>，再見囉！",
          "sc": "琪娜娜姐、<player>，再见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8101,
      "rec_id": "TALK_ID_10_0102_030_02_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217649,
          "spk": "莲实 (ハスミ)",
          "ja": "もう……",
          "tc": "真是的……",
          "sc": "真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217656,
          "spk": "莲实 (ハスミ)",
          "ja": "本当に大丈夫かしら……",
          "tc": "真的沒問題嗎……",
          "sc": "真的没问题吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8102,
      "rec_id": "TALK_ID_10_0102_030_02_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217706,
          "spk": "莲实 (ハスミ)",
          "ja": "ところでチナナ、",
          "tc": "話說回來，琪娜娜，",
          "sc": "话说回来，琪娜娜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217713,
          "spk": "莲实 (ハスミ)",
          "ja": "私に用事とは……",
          "tc": "妳找我有什麼事……",
          "sc": "你找我有什么事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217726,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、そうだったね",
          "tc": "啊，對。",
          "sc": "啊，对。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217733,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はお願いがあってきたんだよ",
          "tc": "今天我是有事來拜託妳的。",
          "sc": "今天我是有事来拜托你的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217744,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、小さいのに",
          "tc": "<player>明明這麼小，",
          "sc": "<player>明明这么小，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217751,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大変な仕事をしているだろう？",
          "tc": "卻做著那麼辛苦的工作。",
          "sc": "却做着那么辛苦的工作。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 217762,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも頼み事を請け負ってもらったから、",
          "tc": "我也有拜託他幫忙，",
          "sc": "我也有拜托他帮忙，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 217769,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この子にも<strong>「兵糧丸」</strong>の作り方を",
          "tc": "所以不知道可不可以請妳教他",
          "sc": "所以不知道可不可以请你教他"
        },
        {
          "f_idx": 8,
          "pidx_tc": 217776,
          "spk": "琪娜娜 (チナナ)",
          "ja": "教えてあげてほしいんだけど、いいかな？",
          "tc": "<strong>「兵糧丸」</strong>的製作方法呢？",
          "sc": "<strong>“兵粮丸”</strong>的制作方法呢？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 217789,
          "spk": "莲实 (ハスミ)",
          "ja": "なるほど、それが用事ということね",
          "tc": "原來如此，是這件事啊。",
          "sc": "原来如此，是这件事啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 217796,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん構わないわ",
          "tc": "當然可以。",
          "sc": "当然可以。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8103,
      "rec_id": "TALK_ID_10_0102_030_02_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217822,
          "spk": "莲实 (ハスミ)",
          "ja": "このメモに作り方が書いてあります",
          "tc": "我把做法寫在紙條上了，",
          "sc": "我把做法写在纸条上了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217829,
          "spk": "莲实 (ハスミ)",
          "ja": "どうぞ、受け取ってください",
          "tc": "請你收下吧。",
          "sc": "请你收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8104,
      "rec_id": "TALK_ID_10_0102_030_02_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217853,
          "spk": "莲实 (ハスミ)",
          "ja": "その、<strong>兵糧丸</strong>というものは、",
          "tc": "所謂的<strong>兵糧丸</strong>",
          "sc": "所谓的<strong>兵粮丸</strong>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217860,
          "spk": "莲实 (ハスミ)",
          "ja": "野草から取れる実や根を使った",
          "tc": "是用野草的果實、草根製成的，",
          "sc": "是用野草的果实、草根制成的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 217867,
          "spk": "莲实 (ハスミ)",
          "ja": "昔から食べられている非常食なんです",
          "tc": "從以前就有人在吃，是傳統應急糧食。",
          "sc": "从以前就有人在吃，是传统应急粮食。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 217878,
          "spk": "莲实 (ハスミ)",
          "ja": "作り方は簡単なので、",
          "tc": "做法也很簡單，",
          "sc": "做法也很简单，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 217885,
          "spk": "莲实 (ハスミ)",
          "ja": "材料を作業台で加工すれば、",
          "tc": "只要備好材料在工作台加工，",
          "sc": "只要备好材料在工作台加工，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 217892,
          "spk": "莲实 (ハスミ)",
          "ja": "きっとすぐに作ることが出来ますよ",
          "tc": "應該很快就能做出來了。",
          "sc": "应该很快就能做出来了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 217903,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れて動けなくなった時に、",
          "tc": "要是你累到動彈不得，",
          "sc": "要是你累到动弹不得，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 217910,
          "spk": "莲实 (ハスミ)",
          "ja": "食べてみてくださいね",
          "tc": "可以拿出來吃看看。",
          "sc": "可以拿出来吃看看。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 217917,
          "spk": "莲实 (ハスミ)",
          "ja": "……味は保証できませんが",
          "tc": "……只是味道方面就沒辦法保證了。",
          "sc": "……只是味道方面就没办法保证了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8105,
      "rec_id": "TALK_ID_10_0102_030_02_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217941,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、兵糧丸があるからといって、",
          "tc": "不過，就算有了兵糧丸，",
          "sc": "不过，就算有了兵粮丸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217948,
