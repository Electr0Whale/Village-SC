      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 211573,
          "spk": "驹子 (コマコ)",
          "ja": "よかったぁ！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 211580,
          "spk": "驹子 (コマコ)",
          "ja": "キミも犬嫌いだったら、",
          "tc": "要是連你都討厭狗，",
          "sc": "要是连你都讨厌狗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 211587,
          "spk": "驹子 (コマコ)",
          "ja": "どうしようかと思ったよ！",
          "tc": "那我就不知道該怎麼辦才好了！",
          "sc": "那我就不知道该怎么办才好了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 211598,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、<player>",
          "tc": "那麼，<player>，",
          "sc": "那么，<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 211605,
          "spk": "驹子 (コマコ)",
          "ja": "この子に名前をつけてあげて",
          "tc": "你來為牠取名字吧。",
          "sc": "你来为它取名字吧。"
        }
      ]
    },
