          "f_idx": 1,
          "pidx_tc": 216697,
          "spk": "？？？ (未知角色)",
          "ja": "飼ってもらえばいいんじゃないかな？",
          "tc": "妳覺得怎麼樣？",
          "sc": "你觉得怎么样？"
        }
      ]
    },
