    },
    {
      "file": "talk.dat",
      "rec_idx": 2322,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91663,
          "spk": "洋 (ヨウ)",
          "ja": "秋になると、コマコちゃんは少し忙しそう",
          "tc": "到了秋天，駒子姐姐會變得比較忙。",
          "sc": "到了秋天，驹子姐姐会变得比较忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91681,
          "spk": "洋 (ヨウ)",
          "ja": "今は猟師さんの狩りのシーズンなんだっけ",
          "tc": "現在好像是獵師狩獵的旺季。",
          "sc": "现在好像是猎师狩猎的旺季。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2323,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91705,
          "spk": "洋 (ヨウ)",
          "ja": "今夜はお月様がとってもキレイなんだよ",
          "tc": "今天晚上的月亮很漂亮呢，",
          "sc": "今天晚上的月亮很漂亮呢，"
        },
        {
