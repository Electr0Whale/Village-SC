    {
      "file": "talk.dat",
      "rec_idx": 2312,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91223,
          "spk": "洋 (ヨウ)",
          "ja": "……雨、冷たくてビックリしちゃった",
          "tc": "……雨滴好冰，嚇了我一跳。",
          "sc": "……雨滴好冰，吓了我一跳。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91241,
          "spk": "洋 (ヨウ)",
          "ja": "もう、夏は終わっちゃったんだね……",
          "tc": "夏天已經結束了呢……",
          "sc": "夏天已经结束了呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2313,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91265,
          "spk": "洋 (ヨウ)",
          "ja": "さっき、野良のネコちゃんが",
          "tc": "剛才有隻小野貓在睡午覺，",
          "sc": "刚才有只小野猫在睡午觉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91272,
          "spk": "洋 (ヨウ)",
          "ja": "気持ちよさそうにお昼寝してたんだ",
          "tc": "感覺很睡得舒服呢。",
          "sc": "感觉很睡得舒服呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91283,
          "spk": "洋 (ヨウ)",
          "ja": "秋になって、涼しくなったからかな？",
          "tc": "是因為秋天到了，變涼的關係嗎？",
          "sc": "是因为秋天到了，变凉的关系吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2314,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91314,
          "spk": "洋 (ヨウ)",
          "ja": "秋は急に冷えるから気をつけてって",
          "tc": "蓮實姐姐有提醒我，",
          "sc": "莲实姐姐有提醒我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91321,
          "spk": "洋 (ヨウ)",
          "ja": "ハスミさんに言われたけど……",
          "tc": "要注意秋天會突然變冷……",
          "sc": "要注意秋天会突然变冷……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91332,
          "spk": "洋 (ヨウ)",
          "ja": "温かい飲み物とかを",
          "tc": "是不是喝點熱熱的飲料",
          "sc": "是不是喝点热热的饮料"
        },
        {
          "f_idx": 3,
          "pidx_tc": 91339,
          "spk": "洋 (ヨウ)",
          "ja": "飲めばいいのかな……？",
          "tc": "會比較好呢……？",
          "sc": "会比较好呢……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2315,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91363,
          "spk": "洋 (ヨウ)",
          "ja": "今日はどこに遊びに行こうかな？",
          "tc": "今天要去哪裡玩呢？",
          "sc": "今天要去哪里玩呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91370,
          "spk": "洋 (ヨウ)",
          "ja": "お山にしようかな？　川もいいかな？",
          "tc": "去山裡玩好？還是去河邊玩？",
          "sc": "去山里玩好？还是去河边玩？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91381,
          "spk": "洋 (ヨウ)",
          "ja": "できれば誰かと一緒に遊びたいな",
          "tc": "不過還是想找人一起玩呢。",
          "sc": "不过还是想找人一起玩呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2316,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91405,
          "spk": "洋 (ヨウ)",
          "ja": "夏の雨はザーザーって感じだけど、",
          "tc": "夏天的雨是稀里嘩啦的感覺，",
          "sc": "夏天的雨是稀里哗啦的感觉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91412,
          "spk": "洋 (ヨウ)",
          "ja": "秋の雨はしとしとって感じがするね",
          "tc": "秋天的雨卻是滴滴答答的感覺呢。",
          "sc": "秋天的雨却是滴滴答答的感觉呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2317,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91436,
          "spk": "洋 (ヨウ)",
          "ja": "夏は緑一色だった山の木が",
          "tc": "夏天一片綠油油的山跟樹",
          "sc": "夏天一片绿油油的山跟树"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91443,
          "spk": "洋 (ヨウ)",
          "ja": "赤になったり黄色になったりするの",
          "tc": "都變得紅紅黃黃的，",
          "sc": "都变得红红黄黄的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 91461,
          "spk": "洋 (ヨウ)",
          "ja": "なんだかとってもふしぎな感じ",
          "tc": "感覺真是不可思議。",
          "sc": "感觉真是不可思议。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2318,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91485,
          "spk": "洋 (ヨウ)",
          "ja": "そういえば、ユータさんが",
          "tc": "對了，裕太哥哥有說過",
          "sc": "对了，裕太哥哥有说过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91492,
          "spk": "洋 (ヨウ)",
          "ja": "秋は芸術の季節って言ってたの……",
          "tc": "秋天是藝術的季節……",
          "sc": "秋天是艺术的季节……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91503,
          "spk": "洋 (ヨウ)",
          "ja": "芸術……帰ったらお絵かきしようかな？",
          "tc": "藝術……回家之後來畫畫好了。",
          "sc": "艺术……回家之后来画画好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2319,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91534,
          "spk": "洋 (ヨウ)",
          "ja": "お出かけするのは楽しいけど、",
          "tc": "雖然出門很開心，",
          "sc": "虽然出门很开心，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91541,
          "spk": "洋 (ヨウ)",
          "ja": "一人はやっぱり寂しいな",
          "tc": "但是一個人還是很寂寞。",
          "sc": "但是一个人还是很寂寞。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91548,
          "spk": "洋 (ヨウ)",
          "ja": "誰か、暇だったりしないかな……",
          "tc": "有沒有人有空跟我一起玩呢……",
          "sc": "有没有人有空跟我一起玩呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2320,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91572,
          "spk": "洋 (ヨウ)",
          "ja": "くしゅんっ",
          "tc": "哈啾！",
          "sc": "哈啾！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91583,
          "spk": "洋 (ヨウ)",
          "ja": "濡れたから、寒くなってきちゃった",
          "tc": "因為淋濕，覺得身體開始變冷了。",
          "sc": "因为淋湿，觉得身体开始变冷了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91590,
          "spk": "洋 (ヨウ)",
          "ja": "暖かくして寝なきゃだね……",
          "tc": "得把身體弄暖，睡飽一點才行……",
          "sc": "得把身体弄暖，睡饱一点才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2321,
      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_3821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91614,
          "spk": "洋 (ヨウ)",
          "ja": "暗くなってきちゃった",
          "tc": "天開始變黑了。",
          "sc": "天开始变黑了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91621,
          "spk": "洋 (ヨウ)",
          "ja": "今はもう、夜のほうがお昼より長いんだっけ？",
          "tc": "現在是不是晚上已經比白天長了？",
          "sc": "现在是不是晚上已经比白天长了？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 91639,
          "spk": "洋 (ヨウ)",
          "ja": "……なんかちょっと、悲しいね",
          "tc": "……總覺得有點難過呢。",
          "sc": "……总觉得有点难过呢。"
        }
