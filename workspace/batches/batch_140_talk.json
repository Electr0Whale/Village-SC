      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 90855,
          "spk": "洋 (ヨウ)",
          "ja": "ほら見て、オワン",
          "tc": "歐宛你看，",
          "sc": "欧宛你看，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 90862,
          "spk": "洋 (ヨウ)",
          "ja": "今ね、オワンのことを描いてるの",
          "tc": "這是我畫的歐宛喔。",
          "sc": "这是我画的欧宛哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 90869,
          "spk": "洋 (ヨウ)",
          "ja": "ほら、どう？　似てるでしょ？",
          "tc": "怎麼樣？很像吧？",
          "sc": "怎么样？很像吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 90880,
          "spk": "欧万 (オワン/鹦鹉)",
          "ja": "ニテル！　ニテル！",
          "tc": "很像！很像！",
          "sc": "很像！很像！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 90893,
          "spk": "洋 (ヨウ)",
          "ja": "ふふっ、ありがとう",
          "tc": "呵呵，謝謝你。",
          "sc": "呵呵，谢谢你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 90904,
          "spk": "洋 (ヨウ)",
          "ja": "となりに描くのは誰にしようかな……",
          "tc": "旁邊要畫誰呢……",
          "sc": "旁边要画谁呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 90911,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱり、おじちゃんかな？",
          "tc": "果然還是畫叔叔好了。",
          "sc": "果然还是画叔叔好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2304,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 90935,
          "spk": "洋 (ヨウ)",
          "ja": "うーん……",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 90942,
          "spk": "洋 (ヨウ)",
          "ja": "ワンちゃんの毛並みがうまく描けない……",
          "tc": "沒辦法把狗狗的毛畫得很好……",
          "sc": "没办法把狗狗的毛画得很好……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 90949,
          "spk": "洋 (ヨウ)",
          "ja": "どうすればいいんだろう？",
          "tc": "該怎麼辦呢？",
          "sc": "该怎么办呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2305,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 90973,
          "spk": "洋 (ヨウ)",
          "ja": "このクレヨンはね、おじちゃんが買ってくれたの",
          "tc": "這個蠟筆啊，是叔叔買給我的。",
          "sc": "这个蜡笔啊，是叔叔买给我的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 90980,
          "spk": "洋 (ヨウ)",
          "ja": "色がいっぱいあって、見てるだけで楽しいんだ",
          "tc": "有很多種顏色，只是欣賞也覺得很開心喔。",
          "sc": "有很多种颜色，只是欣赏也觉得很开心哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2306,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3203",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91011,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はお絵かき、好き？",
          "tc": "<player>喜歡畫畫嗎？",
          "sc": "<player>喜欢画画吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91022,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはけっこう好きかも",
          "tc": "我還滿喜歡的喔。",
          "sc": "我还满喜欢的哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2307,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91046,
          "spk": "洋 (ヨウ)",
          "ja": "色んなものが置いてあるね",
          "tc": "擺著各式各樣的東西呢。",
          "sc": "摆着各式各样的东西呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91053,
          "spk": "洋 (ヨウ)",
          "ja": "お菓子も美味しそう……",
          "tc": "點心看起來好像也很好吃……",
          "sc": "点心看起来好像也很好吃……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91064,
          "spk": "洋 (ヨウ)",
          "ja": "今いくら持ってたっけ……",
          "tc": "現在身上有多少錢呢……",
          "sc": "现在身上有多少钱呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2308,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91088,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、今日のご飯は",
          "tc": "感覺今天的料理",
          "sc": "感觉今天的料理"
        },
        {
          "f_idx": 1,
          "pidx_tc": 91095,
          "spk": "洋 (ヨウ)",
          "ja": "美味しそうなものがいっぱいだね",
          "tc": "有好多看起來很好吃的東西。",
          "sc": "有好多看起来很好吃的东西。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 91102,
          "spk": "洋 (ヨウ)",
          "ja": "これがみんなの言ってた、食欲の秋なのかな",
          "tc": "這就是大家說的「食欲之秋」嗎？",
          "sc": "这就是大家说的“食欲之秋”吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2309,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_3230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 91126,
          "spk": "洋 (ヨウ)",
          "ja": "んー……目が、しょぼしょぼする……",
          "tc": "唔……眼睛澀澀的……",
          "sc": "唔……眼睛涩涩的……"
