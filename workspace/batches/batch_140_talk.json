        {
          "f_idx": 1,
          "pidx_tc": 91137,
          "spk": "洋 (ヨウ)",
          "ja": "もう、このまま寝ちゃおうかな……",
          "tc": "乾脆直接睡覺好了……",
          "sc": "干脆直接睡觉好了……"
        }
      ]
    },
    {
