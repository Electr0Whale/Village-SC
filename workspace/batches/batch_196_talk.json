          "spk": "林 (リン)",
          "ja": "ちょっと！！",
          "tc": "喂！！",
          "sc": "喂！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4627,
      "rec_id": "TALK_ID_10_0401_004_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267966,
          "spk": "堇怜 (スミレ)",
          "ja": "り、リン！？",
          "tc": "是、是林！？",
          "sc": "是、是林！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267973,
          "spk": "堇怜 (スミレ)",
          "ja": "どこから聞いてたの？",
          "tc": "妳從哪裡開始聽的？",
          "sc": "你从哪里开始听的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267986,
          "spk": "林 (リン)",
          "ja": "どうせトバリでしょ！",
          "tc": "肯定又是帷對吧！",
          "sc": "肯定又是帷对吧！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267995,
          "spk": "林 (リン)",
          "ja": "ひどいのよ、あの子！",
          "tc": "她真的太過分了！",
          "sc": "她真的太过分了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 268002,
          "spk": "林 (リン)",
          "ja": "この私に変なあだ名つけて！！",
          "tc": "竟敢給本小姐取奇怪的綽號！！",
          "sc": "竟敢给本小姐取奇怪的绰号！！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 268020,
          "spk": "林 (リン)",
          "ja": "もう、全然こりてないのかしら……！！",
          "tc": "我看她根本沒學到教訓是吧……！！",
          "sc": "我看她根本没学到教训是吧……！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4628,
      "rec_id": "TALK_ID_10_0401_004_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 268040,
          "spk": "茶梅 (サザンカ)",
          "ja": "リン……気持ちはわかるけど、",
          "tc": "林……我懂妳的心情，",
          "sc": "林……我懂你的心情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 268047,
          "spk": "茶梅 (サザンカ)",
          "ja": "もうちょっとトバリに歩み寄ってあげたら？",
          "tc": "妳就多體諒一下帷吧？",
          "sc": "你就多体谅一下帷吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 268065,
          "spk": "茶梅 (サザンカ)",
          "ja": "この村は普通じゃないじゃん？",
          "tc": "畢竟這座村子的確不太正常嘛～",
          "sc": "毕竟这座村子的确不太正常嘛～"
        },
        {
          "f_idx": 4,
          "pidx_tc": 268072,
          "spk": "茶梅 (サザンカ)",
          "ja": "色々知りたがってるんでしょ？",
          "tc": "她應該有很多想知道的事吧？",
          "sc": "她应该有很多想知道的事吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 268092,
          "spk": "堇怜 (スミレ)",
          "ja": "実を言うと僕も、",
          "tc": "老實說，",
          "sc": "老实说，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 268099,
          "spk": "堇怜 (スミレ)",
          "ja": "村長であるリンに聞いてみたいことが……",
          "tc": "連我也有事情想問身為村長的林……",
          "sc": "连我也有事情想问身为村长的林……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 268112,
          "spk": "林 (リン)",
          "ja": "私に聞いたって何も教えないわよ",
          "tc": "就算你問我，我也什麼都不會說喔！",
          "sc": "就算你问我，我也什么都不会说哦！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 268132,
          "spk": "堇怜 (スミレ)",
          "ja": "そ、そんな頭ごなしかよ……",
          "tc": "也、也太固執了吧……",
          "sc": "也、也太固执了吧……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 268145,
          "spk": "林 (リン)",
          "ja": "何を教えても、",
          "tc": "因為不管我說了什麼，",
          "sc": "因为不管我说了什么，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 268152,
          "spk": "林 (リン)",
          "ja": "厄介事が起きるもの",
          "tc": "都只會造成更多麻煩而已啊。",
          "sc": "都只会造成更多麻烦而已啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4629,
      "rec_id": "TALK_ID_10_0401_004_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 268170,
          "spk": "林 (リン)",
          "ja": "彼ヶ津村は変わってはならないの",
          "tc": "彼津村，是不可以改變的。",
          "sc": "彼津村，是不可以改变的。"
        },
