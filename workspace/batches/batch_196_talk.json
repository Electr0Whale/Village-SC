      "rec_id": "TALK_ID_10_0401_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266807,
          "spk": "茶梅 (サザンカ)",
          "ja": "アハハ、変な声！",
          "tc": "啊哈哈，好怪的聲音！",
          "sc": "啊哈哈，好怪的声音！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266818,
          "spk": "堇怜 (スミレ)",
          "ja": "もう、止めてよソレ！",
          "tc": "喂喂喂，關掉啦！",
          "sc": "喂喂喂，关掉啦！"
