          "tc": "拜金醜八怪……",
          "sc": "拜金丑八怪……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4626,
      "rec_id": "TALK_ID_10_0401_004_17",
      "lines": [
        {
