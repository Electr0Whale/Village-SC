      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4612,
      "rec_id": "TALK_ID_10_0401_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266840,
          "spk": "？？？ (未知角色)",
          "ja": "カチッ……ガガガ……",
          "tc": "咔噠……嘎嘎嘎……",
          "sc": "咔哒……嘎嘎嘎……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266847,
          "spk": "？？？ (未知角色)",
          "ja": "コレ……釣り上げるの大変だったんだぜピー……",
          "tc": "要釣起這個……真是累死人了嗶……",
          "sc": "要钓起这个……真是累死人了哔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266856,
          "spk": "？？？ (未知角色)",
          "ja": "ガガガ……百円以上の価値は絶対あるって",
          "tc": "嘎嘎嘎……絕對有一百元以上的價值……",
          "sc": "嘎嘎嘎……绝对有一百元以上的价值……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266863,
          "spk": "？？？ (未知角色)",
          "ja": "ピー……ガガガ……",
          "tc": "嗶～……嘎嘎嘎……",
          "sc": "哔～……嘎嘎嘎……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4613,
      "rec_id": "TALK_ID_10_0401_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266885,
          "spk": "堇怜 (スミレ)",
          "ja": "僕こんな声じゃないよ！",
          "tc": "我的聲音才不是這樣！",
          "sc": "我的声音才不是这样！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266892,
          "spk": "堇怜 (スミレ)",
          "ja": "ソレ、どっか壊れてるんじゃないんですか？",
          "tc": "那個東西是哪裡故障了吧？",
          "sc": "那个东西是哪里故障了吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266903,
          "spk": "茶梅 (サザンカ)",
          "ja": "アハハ！",
          "tc": "啊哈哈！",
          "sc": "啊哈哈！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266910,
          "spk": "茶梅 (サザンカ)",
          "ja": "これはただのレコーダーだから、",
          "tc": "這只是普通的錄音機，",
          "sc": "这只是普通的录音机，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266917,
          "spk": "茶梅 (サザンカ)",
          "ja": "ボイチェンなんかできないってぇ",
          "tc": "哪來變聲器的功能啦～",
          "sc": "哪来变声器的功能啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4614,
      "rec_id": "TALK_ID_10_0401_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266939,
          "spk": "帷 (トバリ)",
          "ja": "ちょっといい？",
          "tc": "可以打擾一下嗎？",
          "sc": "可以打扰一下吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4615,
      "rec_id": "TALK_ID_10_0401_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266963,
          "spk": "帷 (トバリ)",
          "ja": "それ、私に貸して欲しいのだけど",
          "tc": "那個，可以借我嗎？",
          "sc": "那个，可以借我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266976,
          "spk": "茶梅 (サザンカ)",
          "ja": "……え、めずらし",
          "tc": "……咦，真難得耶～",
          "sc": "……咦，真难得呢～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266983,
          "spk": "茶梅 (サザンカ)",
          "ja": "いいけど一体どうしたのさ",
          "tc": "可以是可以，不過妳到底想用來做什麼？",
          "sc": "可以是可以，不过你到底想用来做什么？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266996,
          "spk": "帷 (トバリ)",
          "ja": "別に、暇つぶしに使うだけ",
          "tc": "沒什麼，只是想打發時間。",
          "sc": "没什么，只是想打发时间。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267011,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、なるほど",
          "tc": "喔喔，原來如此。",
          "sc": "喔哦，原来如此。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267018,
          "spk": "堇怜 (スミレ)",
          "ja": "キミみたいな都会っ子にとっては、",
          "tc": "對妳這種在都市長大的小孩來說，",
          "sc": "对你这种在都市长大的小孩来说，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267025,
          "spk": "堇怜 (スミレ)",
          "ja": "なんもないこの村は暇だよね",
          "tc": "這個什麼都沒有的村子應該很無聊吧。",
          "sc": "这个什么都没有的村子应该很无聊吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267036,
          "spk": "堇怜 (スミレ)",
          "ja": "僕に聞けばこんなガラクタより、",
          "tc": "要是妳問我的話，我可以告訴妳",
          "sc": "要是你问我的话，我可以告诉你"
        },
        {
          "f_idx": 8,
          "pidx_tc": 267043,
          "spk": "堇怜 (スミレ)",
          "ja": "もっとスリルがあって、刺激的な遊びを",
          "tc": "比這種破銅爛鐵，",
          "sc": "比这种破铜烂铁，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 267050,
          "spk": "堇怜 (スミレ)",
          "ja": "教えてあげられるのに",
          "tc": "更刺激更好玩的遊戲。",
          "sc": "更刺激更好玩的游戏。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 267063,
          "spk": "帷 (トバリ)",
          "ja": "遊びで使うわけじゃないから",
          "tc": "我不是要拿來玩。",
          "sc": "我不是要拿来玩。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 267072,
          "spk": "帷 (トバリ)",
          "ja": "この村をどうにかするために、",
          "tc": "為了這座村子，",
          "sc": "为了这座村子，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 267079,
          "spk": "帷 (トバリ)",
          "ja": "そのボイスレコーダーを貸して欲しいの",
          "tc": "希望妳能把那台錄音機借給我。",
          "sc": "希望你能把那台录音机借给我。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 267092,
          "spk": "堇怜 (スミレ)",
          "ja": "アハハ、これ、ポンコツだよ？",
          "tc": "啊哈哈，這只是台破爛耶！",
          "sc": "啊哈哈，这只是台破烂呢！"
        },
        {
          "f_idx": 14,
          "pidx_tc": 267099,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなガラクタでどうにかできるの？",
          "tc": "妳拿這種破機器能做什麼啊？",
          "sc": "你拿这种破机器能做什么啊？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 267119,
          "spk": "茶梅 (サザンカ)",
          "ja": "相変わらずトバリは不思議な子だねぇ",
          "tc": "果然帷還是一樣讓人猜不透呢～",
          "sc": "果然帷还是一样让人猜不透呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4616,
      "rec_id": "TALK_ID_10_0401_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267139,
          "spk": "茶梅 (サザンカ)",
          "ja": "はい、どうぞ",
          "tc": "來，借妳吧。",
          "sc": "来，借你吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267146,
          "spk": "茶梅 (サザンカ)",
          "ja": "壊さないでよね？",
          "tc": "可別弄壞囉！",
          "sc": "可别弄坏了哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267153,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシが一ヶ月かけて、基盤から組んだんだから",
          "tc": "我可是花了一個月從電路板開始組裝的。",
          "sc": "我可是花了一个月从电路板开始组装的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4617,
      "rec_id": "TALK_ID_10_0401_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267171,
          "spk": "帷 (トバリ)",
          "ja": "……ありがと",
          "tc": "……謝謝。",
          "sc": "……谢谢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4618,
      "rec_id": "TALK_ID_10_0401_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267203,
          "spk": "帷 (トバリ)",
          "ja": "……アンタたちは、",
          "tc": "……你們，",
          "sc": "……你们，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267210,
          "spk": "帷 (トバリ)",
          "ja": "この村での暮らしに文句ないの？",
          "tc": "對在這裡的生活難道都沒有怨言嗎？",
          "sc": "对在这里的生活难道都没有怨言吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267230,
          "spk": "堇怜 (スミレ)",
          "ja": "……？",
          "tc": "……？",
          "sc": "……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4619,
      "rec_id": "TALK_ID_10_0401_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267246,
          "spk": "帷 (トバリ)",
          "ja": "こんなものを作ったり、",
          "tc": "無論是做這種東西，",
          "sc": "无论是做这种东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267253,
          "spk": "帷 (トバリ)",
          "ja": "川に石を投げたりなんかして……",
          "tc": "還是朝河裡丟石頭……",
          "sc": "还是朝河里丢石头……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267260,
          "spk": "帷 (トバリ)",
          "ja": "どう考えたって、暇つぶしでしょ",
          "tc": "怎麼想都是為了打發時間吧？",
          "sc": "怎么想都是为了打发时间吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267275,
          "spk": "茶梅 (サザンカ)",
          "ja": "んー……アタシは、",
          "tc": "嗯～……我啊，",
          "sc": "嗯～……我啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267282,
          "spk": "茶梅 (サザンカ)",
          "ja": "この村から出たことないからわかんないけど、",
          "tc": "畢竟從來沒出過這座村子也不確定，",
          "sc": "毕竟从来没出过这座村子也不确定，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267289,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタから見たら、暇な田舎者に見えるかもね",
          "tc": "但在妳看來，我或許就是個很閒的鄉下人吧。",
          "sc": "但在你看来，我或许就是个很闲的乡下人吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267304,
          "spk": "帷 (トバリ)",
          "ja": "私が聞きたいのは、その日常が",
          "tc": "我想問的是，",
          "sc": "我想问的是，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267311,
          "spk": "帷 (トバリ)",
          "ja": "退屈だとは思わないのかってことよ",
          "tc": "不覺得過這種日子很無聊嗎？",
          "sc": "不觉得过这种日子很无聊吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4620,
      "rec_id": "TALK_ID_10_0401_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267338,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、逆に聞くけど",
          "tc": "那我反問妳，",
          "sc": "那我反问你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267345,
          "spk": "堇怜 (スミレ)",
          "ja": "都会に住んでたら、",
          "tc": "難道只要住在都市，",
          "sc": "难道只要住在都市，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267352,
          "spk": "堇怜 (スミレ)",
          "ja": "そんな「虚しさ」って感じなくなるの？",
          "tc": "就不會有那股「空虛感」了嗎？",
          "sc": "就不会有那股“空虚感”了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267365,
          "spk": "茶梅 (サザンカ)",
          "ja": "どーせ、都会の人間だって日々に疲れて、",
          "tc": "反正都市人還不是每天都疲於奔命，",
          "sc": "反正都市人还不是每天都疲于奔命，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267372,
          "spk": "茶梅 (サザンカ)",
          "ja": "何かを忘れるために暇つぶししてるじゃん？",
          "tc": "也會靠打發時間來忘掉煩心事啊。",
          "sc": "也会靠打发时间来忘掉烦心事啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267379,
          "spk": "茶梅 (サザンカ)",
          "ja": "どこにいたって大差ないっしょ",
          "tc": "不管在哪裡都差不多吧。",
          "sc": "不管在哪里都差不多吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267392,
          "spk": "帷 (トバリ)",
          "ja": "でも、この村は……違う",
          "tc": "可是，這座村子……不一樣。",
          "sc": "可是，这座村子……不一样。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267399,
          "spk": "帷 (トバリ)",
          "ja": "掟や信仰で、がんじがらめになってる",
          "tc": "這裡被規矩和信仰給緊緊束縛住了。",
          "sc": "这里被规矩和信仰给紧紧束缚住了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4621,
      "rec_id": "TALK_ID_10_0401_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267428,
          "spk": "帷 (トバリ)",
          "ja": "不気味な夜の声や、",
          "tc": "晚上詭異的怪聲，",
          "sc": "晚上诡异的怪声，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267435,
          "spk": "帷 (トバリ)",
          "ja": "あの異様な空気……",
          "tc": "還有那股不尋常的氣氛……",
          "sc": "还有那股不寻常的气氛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267446,
          "spk": "帷 (トバリ)",
          "ja": "どうして、そんなものに囲まれて",
          "tc": "為什麼你們生活在這種環境下，",
          "sc": "为什么你们生活在这种环境下，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267453,
          "spk": "帷 (トバリ)",
          "ja": "平気でいられるの？",
          "tc": "還能若無其事的樣子？",
          "sc": "还能若无其事的样子？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267466,
          "spk": "堇怜 (スミレ)",
          "ja": "小さい頃からずっとこうだったから",
          "tc": "因為從小就一直是這樣。",
          "sc": "因为从小就一直是这样。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267473,
          "spk": "堇怜 (スミレ)",
          "ja": "って言えばそれまでだけど……",
          "tc": "要硬說的話，也只能這麼解釋吧……",
          "sc": "要硬说的话，也只能这么解释吧……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267484,
          "spk": "堇怜 (スミレ)",
          "ja": "夜の声は、むしろ安心するかもね",
          "tc": "至於夜裡的聲音，我聽了反倒挺安心的。",
          "sc": "至于夜里的声音，我听了反倒挺安心的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267491,
          "spk": "堇怜 (スミレ)",
          "ja": "あれが聞こえると、良い意味でも悪い意味でも",
          "tc": "無論是好是壞，只要聽到那個聲音，",
          "sc": "无论是好是坏，只要听到那个声音，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 267498,
          "spk": "堇怜 (スミレ)",
          "ja": "「ああ今日も変わらない」って思えて",
          "tc": "就會覺得「啊，今天也是老樣子呢」。",
          "sc": "就会觉得“啊，今天也是老样子呢”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4622,
      "rec_id": "TALK_ID_10_0401_004_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267516,
          "spk": "帷 (トバリ)",
          "ja": "……信じられない",
          "tc": "……真不敢相信。",
          "sc": "……真不敢相信。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267523,
          "spk": "帷 (トバリ)",
          "ja": "よくそんな精神で過ごせるわ",
          "tc": "真虧你們能靠這種心態過活耶！",
          "sc": "真亏你们能靠这种心态过活呢！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267539,
          "spk": "帷 (トバリ)",
          "ja": "変わらないことはそんなに大事なの？",
          "tc": "一成不變的生活難道就這麼重要嗎？",
          "sc": "一成不变的生活难道就这么重要吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267559,
          "spk": "茶梅 (サザンカ)",
          "ja": "うーん……難しいね",
          "tc": "嗯……這還真難回答耶。",
          "sc": "嗯……这还真难回答呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267572,
          "spk": "茶梅 (サザンカ)",
          "ja": "そりゃ、一度は都会も見てみたいさ",
          "tc": "當然我也會想見識看看大城市，",
          "sc": "当然我也会想见识看看大城市，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267579,
          "spk": "茶梅 (サザンカ)",
          "ja": "ショッピングとかもしてみたいし、",
          "tc": "還想去逛逛街啊，",
          "sc": "还想去逛逛街啊，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 267586,
          "spk": "茶梅 (サザンカ)",
          "ja": "ライブにも行ってみたいよ",
          "tc": "或是聽個演唱會啊。",
          "sc": "或是听个演唱会啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 267595,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも、街に住みたいっていうわけじゃないんだ",
          "tc": "不過，這並不代表我想住在都市。",
          "sc": "不过，这并不代表我想住在都市。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 267613,
          "spk": "茶梅 (サザンカ)",
          "ja": "消極的な選択に見えるかもしれないけど、",
          "tc": "雖然妳可能會覺得這是種消極的選擇，",
          "sc": "虽然你可能会觉得这是种消极的选择，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 267620,
          "spk": "茶梅 (サザンカ)",
          "ja": "どこで暮らすかよりも、",
          "tc": "但我覺得比起住在哪裡，",
          "sc": "但我觉得比起住在哪里，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 267627,
          "spk": "茶梅 (サザンカ)",
          "ja": "何をして暮らすかが重要だと思うけどな",
          "tc": "更重要的是怎樣去過生活。",
          "sc": "更重要的是怎样去过生活。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 267638,
          "spk": "茶梅 (サザンカ)",
          "ja": "それこそ、この土地は",
          "tc": "正因為這樣，",
          "sc": "正因为这样，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 267645,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシにとって最高だよ",
          "tc": "這片土地對我來說棒透了！",
          "sc": "这片土地对我来说棒透了！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 267656,
          "spk": "茶梅 (サザンカ)",
          "ja": "逆に都会にはまだあるのかい？",
          "tc": "反過來說，都市現在還有這些嗎？",
          "sc": "反过来说，都市现在还有这些吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 267663,
          "spk": "茶梅 (サザンカ)",
          "ja": "夜中に響く、不気味な声や物音が",
          "tc": "像是半夜令人發毛的聲響，",
          "sc": "像是半夜令人发毛的声响，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 267670,
          "spk": "茶梅 (サザンカ)",
          "ja": "不可解な現象や、不思議なものに隠された秘密が",
          "tc": "或是隱藏在神祕現象或奇妙事物背後的祕密。",
          "sc": "或是隐藏在神秘现象或奇妙事物背后的秘密。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 267683,
          "spk": "帷 (トバリ)",
          "ja": "そんなもの、あるわけが……",
          "tc": "那種東西，都市裡最好會有啦……",
          "sc": "那种东西，都市里最好会有啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4623,
      "rec_id": "TALK_ID_10_0401_004_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267701,
          "spk": "茶梅 (サザンカ)",
          "ja": "人も建物も感情すら流れていく場所とは違う",
          "tc": "都市是人、建築甚至感情都只是過客的地方，",
          "sc": "都市是人、建筑甚至感情都只是过客的地方，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267708,
          "spk": "茶梅 (サザンカ)",
          "ja": "ここは不思議なものも、怖いものも、",
          "tc": "但這裡不一樣，不管是神祕或恐怖的事物，",
          "sc": "但这里不一样，不管是神秘或恐怖的事物，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267715,
          "spk": "茶梅 (サザンカ)",
          "ja": "全部まとめて変わらないんだよ",
          "tc": "在這裡全部都不會改變。",
          "sc": "在这里全部都不会改变。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267724,
          "spk": "茶梅 (サザンカ)",
          "ja": "こんな面白いものが残る場所、",
          "tc": "能讓這麼有趣的東西保存下來的地方，",
          "sc": "能让这么有趣的东西保存下来的地方，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267731,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシにとってはここだけだからね",
          "tc": "對我來說，就只有這座村子了。",
          "sc": "对我来说，就只有这座村子了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267744,
          "spk": "堇怜 (スミレ)",
          "ja": "アハハ……サザンカさんは前向きだなぁ",
          "tc": "啊哈哈……茶梅姐真正向耶～",
          "sc": "啊哈哈……茶梅姐真正向呢～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267757,
          "spk": "茶梅 (サザンカ)",
          "ja": "暴くべき謎がある方が楽しいからね",
          "tc": "有謎團可以解開才有趣嘛！",
          "sc": "有谜团可以解开才有趣嘛！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267764,
          "spk": "茶梅 (サザンカ)",
          "ja": "でも、それは悪いことじゃないでしょ",
          "tc": "這樣也不錯啊，不是嗎？",
          "sc": "这样也不错啊，不是吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 267784,
          "spk": "帷 (トバリ)",
          "ja": "……なるほど",
          "tc": "……原來如此。",
          "sc": "……原来如此。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 267791,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ、私もそう考えることにしよう",
          "tc": "那我也試著這樣想好了。",
          "sc": "那我也试着这样想好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4624,
      "rec_id": "TALK_ID_10_0401_004_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267813,
          "spk": "帷 (トバリ)",
          "ja": "あの銭ゲバブスが隠した秘密を暴くことが、",
          "tc": "揭穿那個拜金醜八怪的祕密，",
          "sc": "揭穿那个拜金丑八怪的秘密，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267820,
          "spk": "帷 (トバリ)",
          "ja": "この村での私の趣味……とね",
          "tc": "就是我在這座村子的……興趣。",
          "sc": "就是我在这座村子的……兴趣。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267842,
          "spk": "堇怜 (スミレ)",
          "ja": "銭ゲバっ……！？",
          "tc": "拜金醜……！？",
          "sc": "拜金丑……！？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267849,
          "spk": "堇怜 (スミレ)",
          "ja": "え……それまさか、リンのこと……",
          "tc": "咦……妳該不會是在說林吧……",
          "sc": "咦……你该不会是在说林吧……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267862,
          "spk": "茶梅 (サザンカ)",
          "ja": "ぶっっ……何そのあだ名！",
          "tc": "噗……那什麼綽號啊！",
          "sc": "噗……那什么绰号啊！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267869,
          "spk": "茶梅 (サザンカ)",
          "ja": "ウケる～～！！",
          "tc": "笑死我了～～！！",
          "sc": "笑死我了～～！！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267882,
          "spk": "帷 (トバリ)",
          "ja": "じゃ、私は面倒ごとになる前に行くから",
          "tc": "那我要先走了，省得惹麻煩上身。",
          "sc": "那我要先走了，省得惹麻烦上身。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4625,
      "rec_id": "TALK_ID_10_0401_004_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267913,
          "spk": "堇怜 (スミレ)",
          "ja": "それにしてもトバリも言うなぁ……",
          "tc": "話說帷還真敢講耶……",
