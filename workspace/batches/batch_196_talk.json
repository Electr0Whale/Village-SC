  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4591,
      "rec_id": "TALK_ID_10_0401_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265863,
          "spk": "名护 (ナゴ)",
          "ja": "リンさん……",
          "tc": "林小姐……",
          "sc": "林小姐……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265870,
          "spk": "名护 (ナゴ)",
          "ja": "ちょうどいいところに……",
          "tc": "妳來得正好……",
          "sc": "你来得正好……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265883,
          "spk": "林 (リン)",
          "ja": "私になにか用かしら？",
          "tc": "找我有什麼事嗎？",
          "sc": "找我有什么事吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265890,
          "spk": "林 (リン)",
          "ja": "手短に頼みたいのだけれど",
          "tc": "希望你可以長話短說。",
          "sc": "希望你可以长话短说。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265903,
          "spk": "名护 (ナゴ)",
          "ja": "大丈夫、時間は取らせないから",
          "tc": "放心，不會耽誤到妳的時間。",
          "sc": "放心，不会耽误到你的时间。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265910,
          "spk": "名护 (ナゴ)",
          "ja": "この本を見て欲しいんだ、ここの記述が……",
          "tc": "我想請妳看看這本書，關於這段文字……",
          "sc": "我想请你看看这本书，关于这段文字……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4592,
      "rec_id": "TALK_ID_10_0401_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265935,
          "spk": "林 (リン)",
          "ja": "……ミミズが這ったような字で、",
          "tc": "……這字長得跟蚯蚓一樣，",
          "sc": "……这字长得跟蚯蚓一样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265942,
          "spk": "林 (リン)",
          "ja": "私には読めないわ",
          "tc": "我可看不懂。",
          "sc": "我可看不懂。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265949,
          "spk": "林 (リン)",
          "ja": "なんて書いてあるの？",
          "tc": "這上面寫了什麼？",
          "sc": "这上面写了什么？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4593,
      "rec_id": "TALK_ID_10_0401_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265967,
          "spk": "名护 (ナゴ)",
          "ja": "古語だが訳すと",
          "tc": "這是古文，簡單翻譯就是……",
          "sc": "这是古文，简单翻译就是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265974,
          "spk": "名护 (ナゴ)",
          "ja": "「土地の神が地中から出て来て、村人全員を……",
          "tc": "「土地之神從地底現身，將村民全部……」",
          "sc": "“土地之神从地底现身，将村民全部……”"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4594,
      "rec_id": "TALK_ID_10_0401_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266001,
          "spk": "林 (リン)",
          "ja": "読むのを止めて！",
          "tc": "別再往下念了！",
          "sc": "别再往下念了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4595,
      "rec_id": "TALK_ID_10_0401_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266019,
          "spk": "名护 (ナゴ)",
          "ja": "この村のことだ……",
          "tc": "裡面說的就是這座村莊……",
          "sc": "里面说的就是这座村庄……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266026,
          "spk": "名护 (ナゴ)",
          "ja": "伝承とはいえ、",
          "tc": "雖然只是傳說，",
          "sc": "虽然只是传说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266033,
          "spk": "名护 (ナゴ)",
          "ja": "何が起きても不思議ではない……",
          "tc": "但無論發生什麼事都不奇怪……",
          "sc": "但无论发生什么事都不奇怪……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266046,
          "spk": "林 (リン)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4596,
      "rec_id": "TALK_ID_10_0401_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266064,
          "spk": "林 (リン)",
          "ja": "<player>、あなたは帰りなさい",
          "tc": "<player>，你先回去。",
          "sc": "<player>，你先回去。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266077,
          "spk": "名护 (ナゴ)",
          "ja": "いや、この子にも",
          "tc": "不，這件事",
          "sc": "不，这件事"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266084,
          "spk": "名护 (ナゴ)",
          "ja": "教えてやるべきじゃないのか",
          "tc": "應該也要讓這孩子知道才對。",
          "sc": "应该也要让这孩子知道才对。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266093,
          "spk": "名护 (ナゴ)",
          "ja": "……リンさん、キミには面と向かって",
          "tc": "……林小姐，",
          "sc": "……林小姐，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266100,
          "spk": "名护 (ナゴ)",
          "ja": "聞いたことがなかったね",
          "tc": "我從沒像這樣當面問過妳吧。",
          "sc": "我从没像这样当面问过你吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 266111,
          "spk": "名护 (ナゴ)",
          "ja": "この村は一体、何を隠しているんだ",
          "tc": "這座村子，到底在隱藏什麼事？",
          "sc": "这座村子，到底在隐藏什么事？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 266122,
          "spk": "名护 (ナゴ)",
          "ja": "俺たちは、この村は、",
          "tc": "我們，還有這座村子，",
          "sc": "我们，还有这座村子，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 266129,
          "spk": "名护 (ナゴ)",
          "ja": "とんでもない危険に",
          "tc": "是不是正暴露在",
          "sc": "是不是正暴露在"
        },
        {
          "f_idx": 8,
          "pidx_tc": 266136,
          "spk": "名护 (ナゴ)",
          "ja": "晒されているんじゃないのか",
          "tc": "什麼不得了的危險之中？",
          "sc": "什么不得了的危险之中？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4598,
      "rec_id": "TALK_ID_10_0401_002_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266159,
          "spk": "林 (リン)",
          "ja": "まさか！",
          "tc": "怎麼可能！",
          "sc": "怎么可能！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266166,
          "spk": "林 (リン)",
          "ja": "この村は平和よ、素晴らしい土地よ",
          "tc": "這座村子是片既和平又山明水秀的土地。",
          "sc": "这座村子是片既和平又山明水秀的土地。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266186,
          "spk": "名护 (ナゴ)",
          "ja": "またそうやって誤魔化して……",
          "tc": "妳又打算這樣蒙混過去……",
          "sc": "你又打算这样蒙混过去……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4599,
      "rec_id": "TALK_ID_10_0401_002_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266208,
          "spk": "木助 (キスケ)",
          "ja": "おーい、ナゴ、",
          "tc": "喂～名護，",
          "sc": "喂～名护，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266215,
          "spk": "木助 (キスケ)",
          "ja": "仕事は順調かァ？",
          "tc": "工作還順利吧～？",
          "sc": "工作还顺利吧～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4600,
      "rec_id": "TALK_ID_10_0401_002_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266239,
          "spk": "木助 (キスケ)",
          "ja": "……あん？",
          "tc": "……啥？",
          "sc": "……啥？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266246,
          "spk": "木助 (キスケ)",
          "ja": "リンに<player>？",
          "tc": "林和<player>也在？",
          "sc": "林和<player>也在？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4601,
      "rec_id": "TALK_ID_10_0401_002_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266262,
          "spk": "名护 (ナゴ)",
          "ja": "……アンタ、人を信用せずに利用していると",
          "tc": "……妳像這樣利用人卻不信任人，",
          "sc": "……你像这样利用人却不信任人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266269,
          "spk": "名护 (ナゴ)",
          "ja": "いつか手痛い裏切りに遭うぞ",
          "tc": "當心總有一天會被狠狠背叛。",
          "sc": "当心总有一天会被狠狠背叛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266289,
          "spk": "林 (リン)",
          "ja": "何が言いたいの？",
          "tc": "你想說什麼？",
          "sc": "你想说什么？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266296,
          "spk": "林 (リン)",
          "ja": "まさか、キスケさんに期待してもらっている",
          "tc": "難道你身負木助哥的期待，",
          "sc": "难道你身负木助哥的期待，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 266303,
          "spk": "林 (リン)",
          "ja": "あなたが、裏切るつもり？",
          "tc": "卻打算要背叛嗎？",
          "sc": "却打算要背叛吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 266316,
          "spk": "木助 (キスケ)",
          "ja": "……なんだよ、この空気は",
          "tc": "……氣氛怎麼鬧成這樣？",
          "sc": "……气氛怎么闹成这样？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 266329,
          "spk": "林 (リン)",
          "ja": "私がその気になれば、",
          "tc": "只要我有那個意思，",
          "sc": "只要我有那个意思，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 266336,
          "spk": "林 (リン)",
          "ja": "あなたは峠で永遠に彷徨うことになるわよ",
          "tc": "你可是會永遠迷失在隘口喔。",
          "sc": "你可是会永远迷失在隘口哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 266349,
          "spk": "名护 (ナゴ)",
          "ja": "脅しのつもりか？",
          "tc": "妳是在威脅我嗎？",
          "sc": "你是在威胁我吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 266356,
          "spk": "名护 (ナゴ)",
          "ja": "そうやって人の自由を奪うのが、",
          "tc": "像這樣剝奪他人的自由，",
          "sc": "像这样剥夺他人的自由，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 266363,
          "spk": "名护 (ナゴ)",
          "ja": "この村のやり方なのか",
          "tc": "就是這座村子的作風嗎？",
          "sc": "就是这座村子的作风吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 266376,
          "spk": "木助 (キスケ)",
          "ja": "待てよ、ナゴ",
          "tc": "你等等，名護，",
          "sc": "你等等，名护，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 266383,
          "spk": "木助 (キスケ)",
          "ja": "聞き捨てならねえな",
          "tc": "這我可不能裝沒聽見啊。",
          "sc": "这我可不能装没听见啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4602,
      "rec_id": "TALK_ID_10_0401_002_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266401,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ……身の程をわきまえた方がいいぜ",
          "tc": "你這傢伙……最好還是認清自己的分寸。",
          "sc": "你这家伙……最好还是认清自己的分寸。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266408,
          "spk": "木助 (キスケ)",
          "ja": "部外者にしては、ずいぶんふてぶてしい態度だな",
          "tc": "以一個外人來說，這態度可真夠囂張的。",
          "sc": "以一个外人来说，这态度可真够嚣张的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266428,
          "spk": "名护 (ナゴ)",
          "ja": "村に閉じ込められた俺に、",
          "tc": "我被困在村子裡後，",
          "sc": "我被困在村子里后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266435,
          "spk": "名护 (ナゴ)",
          "ja": "仕事や家を与えたアンタがそれを言うのか？",
          "tc": "是你給了我工作和住處，而你現在卻要說這種話嗎？",
          "sc": "是你给了我工作和住处，而你现在却要说这种话吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 266455,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの仕事は、図書館を片付けて",
          "tc": "你這傢伙的工作就是整理圖書館，",
          "sc": "你这家伙的工作就是整理图书馆，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 266462,
          "spk": "木助 (キスケ)",
          "ja": "祟りの原因を探すことだ",
          "tc": "尋找作祟的緣由。",
          "sc": "寻找作祟的缘由。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4603,
      "rec_id": "TALK_ID_10_0401_002_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266485,
          "spk": "林 (リン)",
          "ja": "<player>、あなたはもう帰りなさい",
          "tc": "<player>，你先回去吧。",
          "sc": "<player>，你先回去吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266492,
          "spk": "林 (リン)",
          "ja": "あなたまで巻き込みたくない",
          "tc": "我不希望連你也被捲進這件事。",
          "sc": "我不希望连你也被卷进这件事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4604,
      "rec_id": "TALK_ID_10_0401_002_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266512,
          "spk": "名护 (ナゴ)",
          "ja": "いや、<player>さん",
          "tc": "不對，<player>，",
          "sc": "不对，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266519,
          "spk": "名护 (ナゴ)",
          "ja": "キミも聞くべきだ",
          "tc": "這些話你也該聽才對。",
          "sc": "这些话你也该听才对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4605,
      "rec_id": "TALK_ID_10_0401_002_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266537,
          "spk": "名护 (ナゴ)",
          "ja": "理由なく意味のわからない掟に従わされて、",
          "tc": "平白被迫服從那些莫名其妙的規矩，",
          "sc": "平白被迫服从那些莫名其妙的规矩，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266544,
          "spk": "名护 (ナゴ)",
          "ja": "断れない理由のある人間に、仕事をさせて……",
          "tc": "還強迫那些有苦衷而無法拒絕的人去工作…………",
          "sc": "还强迫那些有苦衷而无法拒绝的人去工作……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266560,
          "spk": "名护 (ナゴ)",
          "ja": "こんな状態で、素晴らしい村だって",
          "tc": "妳真的打從心底認為",
          "sc": "你真的打从心底认为"
        },
        {
          "f_idx": 4,
          "pidx_tc": 266567,
          "spk": "名护 (ナゴ)",
          "ja": "心から言えるのか？",
          "tc": "這種狀態稱得上是美好的村子嗎？",
          "sc": "这种状态称得上是美好的村子吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 266587,
          "spk": "木助 (キスケ)",
          "ja": "村のあり方は、村が決めることだ",
          "tc": "村子的事，由我們村子自己決定。",
          "sc": "村子的事，由我们村子自己决定。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 266594,
          "spk": "木助 (キスケ)",
          "ja": "この話は終わりだ",
          "tc": "這個話題就到此為止。",
          "sc": "这个话题就到此为止。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4607,
      "rec_id": "TALK_ID_10_0401_002_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266617,
          "spk": "木助 (キスケ)",
          "ja": "さあ、<player>もリンも、",
          "tc": "好啦，<player>還有林也是，",
          "sc": "好啦，<player>还有林也是，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266624,
          "spk": "木助 (キスケ)",
          "ja": "ナゴの邪魔をするな",
          "tc": "別打擾名護了，",
          "sc": "别打扰名护了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266631,
          "spk": "木助 (キスケ)",
          "ja": "帰ろうぜ",
          "tc": "都回家去吧。",
          "sc": "都回家去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4608,
      "rec_id": "TALK_ID_10_0401_002_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266659,
          "spk": "木助 (キスケ)",
          "ja": "ナゴが何をわめいてたかは知らねぇが、",
          "tc": "雖然不知道名護在鬧什麼，",
          "sc": "虽然不知道名护在闹什么，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266666,
          "spk": "木助 (キスケ)",
          "ja": "気にしなくていいからな",
          "tc": "但你別放在心上。",
          "sc": "但你别放在心上。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266677,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは自由に暮らしていれば、",
          "tc": "只要你這傢伙能過上自由的日子，",
          "sc": "只要你这家伙能过上自由的日子，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266684,
          "spk": "木助 (キスケ)",
          "ja": "それでいいんだ",
          "tc": "我就心滿意足了。",
          "sc": "我就心满意足了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4609,
      "rec_id": "TALK_ID_10_0401_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266708,
          "spk": "名护 (ナゴ)",
          "ja": "……すまない",
          "tc": "……抱歉，",
          "sc": "……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266715,
          "spk": "名护 (ナゴ)",
          "ja": "あのときは取り乱してしまったね",
          "tc": "是我不小心亂了分寸。",
          "sc": "是我不小心乱了分寸。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266726,
          "spk": "名护 (ナゴ)",
          "ja": "いや、忘れてくれ",
          "tc": "沒事，把它忘了吧。",
          "sc": "没事，把它忘了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266733,
          "spk": "名护 (ナゴ)",
          "ja": "ただの言い伝えの話だからね",
          "tc": "畢竟那就只是個傳說罷了。",
          "sc": "毕竟那就只是个传说罢了。"
        }
      ]
    },
    {
