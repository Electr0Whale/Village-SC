    {
      "file": "talk.dat",
      "rec_idx": 8165,
      "rec_id": "TALK_ID_10_0301_009_50_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239612,
          "spk": "主角心声/旁白/选项",
          "ja": "そういえば酸っぱい樹液を２個持っている",
          "tc": "想起身上有兩份酸酸的樹液。",
          "sc": "想起身上有两份酸酸的树液。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 239619,
          "spk": "主角心声/旁白/选项",
          "ja": "ハスミに渡しに行こう",
          "tc": "拿去交給蓮實吧。",
          "sc": "拿去交给莲实吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8166,
      "rec_id": "TALK_ID_10_0301_009_50_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 239635,
          "spk": "主角心声/旁白/选项",
          "ja": "酸っぱい樹液を２個あつめた",
          "tc": "收集到了兩份酸酸的樹液。",
          "sc": "收集到了两份酸酸的树液。"
        },
        {
          "f_idx": 1,
