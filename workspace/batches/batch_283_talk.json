  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8154,
      "rec_id": "TALK_ID_10_0202_051_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 232208,
          "spk": "茶梅 (サザンカ)",
          "ja": "ところでさ",
          "tc": "話說回來，",
          "sc": "话说回来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 232215,
          "spk": "茶梅 (サザンカ)",
          "ja": "それ、ウチの家の墓だよ？",
          "tc": "那可是我家的墳墓啊。",
          "sc": "那可是我家的坟墓啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 232228,
          "spk": "四郎治 (シロージ)",
          "ja": "知ってるよ",
          "tc": "我知道。",
          "sc": "我知道。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 232241,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんな熱心にお参りしなくてもいいって",
          "tc": "不需要這麼認真幫忙掃墓。",
          "sc": "不需要这么认真帮忙扫墓。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 232268,
          "spk": "四郎治 (シロージ)",
          "ja": "いや、させてくれ",
          "tc": "不，讓我做吧。",
          "sc": "不，让我做吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 232275,
          "spk": "四郎治 (シロージ)",
          "ja": "あれからまだ、十年しか経ってないんだから",
          "tc": "畢竟從那之後，也才過了十年而已。",
          "sc": "毕竟从那之后，也才过了十年而已。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 232288,
          "spk": "茶梅 (サザンカ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8155,
      "rec_id": "TALK_ID_10_0202_051_08_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233650,
          "spk": "驹子 (コマコ)",
          "ja": "あっ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233657,
          "spk": "驹子 (コマコ)",
          "ja": "迷子になっちゃうから、",
          "tc": "要是迷路就不好了，",
          "sc": "要是迷路就不好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233664,
          "spk": "驹子 (コマコ)",
          "ja": "あまり遠くに行っちゃダメだよ！",
          "tc": "不可以去太遠的地方喔！",
          "sc": "不可以去太远的地方哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8156,
      "rec_id": "TALK_ID_10_0202_051_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233684,
          "spk": "主角心声/旁白/选项",
          "ja": "もう雑草は見当たらない……",
          "tc": "已經找不到雜草了……",
          "sc": "已经找不到杂草了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233691,
          "spk": "主角心声/旁白/选项",
          "ja": "墓地をキレイにした！",
          "tc": "把墓地打掃乾淨了！",
          "sc": "把墓地打扫干净了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233698,
          "spk": "主角心声/旁白/选项",
          "ja": "リンに報告しよう！",
          "tc": "去向林報告吧！",
          "sc": "去向林报告吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8157,
      "rec_id": "TALK_ID_10_0202_051_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233718,
          "spk": "林 (リン)",
          "ja": "<player>、終わったの？",
          "tc": "<player>，你做完了嗎？",
          "sc": "<player>，你做完了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233731,
          "spk": "林 (リン)",
          "ja": "確かに、もう雑草は見当たらないわね！",
          "tc": "的確是看不到雜草了呢！",
          "sc": "的确是看不到杂草了呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233738,
          "spk": "林 (リン)",
          "ja": "よくやったわ、お疲れ様！",
          "tc": "做得好，辛苦你了！",
          "sc": "做得好，辛苦你了！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233751,
          "spk": "林 (リン)",
          "ja": "私たちのお参りも終わった所よ",
          "tc": "我們也正好掃完墓了，",
          "sc": "我们也正好扫完墓了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233758,
          "spk": "林 (リン)",
          "ja": "一緒に、あなたの庭まで帰りましょうか",
          "tc": "一起走回你家庭院吧。",
          "sc": "一起走回你家庭院吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8158,
      "rec_id": "TALK_ID_10_0202_051_09_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233782,
          "spk": "林 (リン)",
          "ja": "今日はありがとう",
          "tc": "今天真是謝謝你了，",
          "sc": "今天真是谢谢你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233789,
          "spk": "林 (リン)",
          "ja": "あなたのおかげで、予定より早く",
          "tc": "多虧了你，",
          "sc": "多亏了你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233796,
          "spk": "林 (リン)",
          "ja": "お墓の掃除が片付いた",
          "tc": "掃墓比預定時間還早結束了。",
          "sc": "扫墓比预定时间还早结束了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233809,
          "spk": "林 (リン)",
          "ja": "……あ、そうだ！",
          "tc": "……啊，對了！",
          "sc": "……啊，对了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233816,
          "spk": "林 (リン)",
          "ja": "お墓掃除を手伝ってくれたお礼を、",
          "tc": "我都忘了把幫忙掃墓的謝禮",
          "sc": "我都忘了把帮忙扫墓的谢礼"
        },
        {
          "f_idx": 5,
          "pidx_tc": 233823,
          "spk": "林 (リン)",
          "ja": "渡し忘れていたわ！",
          "tc": "交給你了！",
          "sc": "交给你了！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233836,
          "spk": "林 (リン)",
          "ja": "改めて、お疲れさま！",
          "tc": "再次跟你說聲辛苦了！",
          "sc": "再次跟你说声辛苦了！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233843,
          "spk": "林 (リン)",
          "ja": "よく頑張ってくれたわね！",
          "tc": "你真的很努力呢！",
          "sc": "你真的很努力呢！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233850,
          "spk": "林 (リン)",
          "ja": "大したものじゃないけれど、受け取りなさい！",
          "tc": "雖然不是什麼貴重的東西，但就收下吧！",
          "sc": "虽然不是什么贵重的东西，但就收下吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8159,
      "rec_id": "TALK_ID_10_0202_051_09_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 233874,
          "spk": "林 (リン)",
          "ja": "あなたの家は、物が少ないと思ったから、",
          "tc": "我想你家裡東西應該還很少，",
          "sc": "我想你家里东西应该还很少，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 233881,
          "spk": "林 (リン)",
          "ja": "飾れて実用的な物を選んだのよ！",
          "tc": "所以選了能當擺飾的實用物品。",
          "sc": "所以选了能当摆饰的实用物品。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 233888,
          "spk": "林 (リン)",
          "ja": "それを置いておけば、生活感が出るでしょう？",
          "tc": "擺上這個，應該會更有生活氣息了吧？",
          "sc": "摆上这个，应该会更有生活气息了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 233901,
          "spk": "林 (リン)",
          "ja": "あなたの日頃の働きに、感謝を込めた物だから",
          "tc": "這裡面包含了對你日常工作的感謝之意，",
          "sc": "这里面包含了对你日常工作的感谢之意，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 233908,
          "spk": "林 (リン)",
          "ja": "遠慮せず、受け取ってちょうだいね",
          "tc": "別客氣，收下吧。",
          "sc": "别客气，收下吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 233928,
          "spk": "林 (リン)",
          "ja": "さて、私はそろそろ失礼するわ",
          "tc": "好，那我也該走了，",
          "sc": "好，那我也该走了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 233935,
          "spk": "林 (リン)",
          "ja": "あなたはこれから、",
          "tc": "畢竟你接下來還得",
          "sc": "毕竟你接下来还得"
        },
        {
          "f_idx": 8,
          "pidx_tc": 233942,
          "spk": "林 (リン)",
          "ja": "自分の仕事で忙しいでしょうからね",
          "tc": "忙自己的工作吧。",
          "sc": "忙自己的工作吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 233955,
          "spk": "林 (リン)",
          "ja": "じゃあ、今日はありがとう！",
          "tc": "先這樣啦，今天真是謝謝你了！",
          "sc": "先这样啦，今天真是谢谢你了！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 233962,
          "spk": "林 (リン)",
          "ja": "助かったわ、またよろしくね！",
          "tc": "幫了大忙，下次有機會再拜託你！",
          "sc": "帮了大忙，下次有机会再拜托你！"
        }
      ]
    },
    {
