          "pidx_tc": 289817,
          "spk": "木助 (キスケ)",
          "ja": "てめぇを保護してくれる奴がいるはずさ",
          "tc": "一定會有人願意收留你的。",
          "sc": "一定会有人愿意收留你的。"
        },
