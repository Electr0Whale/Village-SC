          "f_idx": 2,
          "pidx_tc": 288475,
          "spk": "木助 (キスケ)",
          "ja": "最初から無駄だとわかっているコトを",
          "tc": "但你應該曉得吧？",
          "sc": "但你应该晓得吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 288482,
          "spk": "木助 (キスケ)",
          "ja": "やろうとしていることはわかるだろ",
          "tc": "你想做的事從一開始就是在白費功夫。",
          "sc": "你想做的事从一开始就是在白费功夫。"
