  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7989,
      "rec_id": "TALK_ID_10_0101_008_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199460,
          "spk": "？？？ (未知角色)",
          "ja": "おや、コマコちゃん",
          "tc": "哦？駒子，",
          "sc": "哦？驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199467,
          "spk": "？？？ (未知角色)",
          "ja": "見慣れない子を連れてるね",
          "tc": "妳帶著一個沒看過的孩子啊。",
          "sc": "你带着一个没看过的孩子啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199480,
          "spk": "驹子 (コマコ)",
          "ja": "こんにちは、ユータさん",
          "tc": "你好，裕太哥。",
          "sc": "你好，裕太哥。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199487,
          "spk": "驹子 (コマコ)",
          "ja": "この子は<player>",
          "tc": "這孩子叫<player>。",
          "sc": "这孩子叫<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199494,
          "spk": "驹子 (コマコ)",
          "ja": "さっき村に来たばかりなの",
          "tc": "才剛來到這個村子。",
          "sc": "才刚来到这个村子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199507,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、ここに住むんだね！",
          "tc": "那麼，他會住在這裡對吧！",
          "sc": "那么，他会住在这里对吧！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 199514,
          "spk": "裕太 (ユータ)",
          "ja": "ここはいいところだよ～？",
          "tc": "這裡可是個好地方啊～",
          "sc": "这里可是个好地方啊～"
        },
        {
          "f_idx": 7,
          "pidx_tc": 199527,
          "spk": "驹子 (コマコ)",
          "ja": "ち、ちがうよユータさん",
          "tc": "不、不是啦，裕太哥。",
          "sc": "不、不是啦，裕太哥。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 199534,
          "spk": "驹子 (コマコ)",
          "ja": "この子は迷子なだけだから、",
          "tc": "這孩子只是迷路了，",
          "sc": "这孩子只是迷路了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 199541,
          "spk": "驹子 (コマコ)",
          "ja": "お家を探してあげなきゃいけないの",
          "tc": "所以得幫他找到該回去的地方。",
          "sc": "所以得帮他找到该回去的地方。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 199554,
          "spk": "裕太 (ユータ)",
          "ja": "えっ、せっかく来たんだから",
          "tc": "咦？難得都來了，",
          "sc": "咦？难得都来了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 199561,
          "spk": "裕太 (ユータ)",
          "ja": "ゆっくり村暮らしを楽しめばいいのに",
          "tc": "悠閒享受村裡的生活也可以啊。",
          "sc": "悠闲享受村里的生活也可以啊。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 199581,
          "spk": "驹子 (コマコ)",
          "ja": "確かに、お家が見つかるまでは",
          "tc": "在我們找到他該回去的地方前，",
          "sc": "在我们找到他该回去的地方前，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 199588,
          "spk": "驹子 (コマコ)",
          "ja": "住むことになっちゃうだろうけど……",
          "tc": "是得住在這裡沒錯啦……",
          "sc": "是得住在这里没错啦……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 199608,
          "spk": "裕太 (ユータ)",
          "ja": "それは大変だ！",
          "tc": "那可不得了！",
          "sc": "那可不得了！"
        },
        {
          "f_idx": 17,
          "pidx_tc": 199615,
          "spk": "裕太 (ユータ)",
          "ja": "一度住めば、",
          "tc": "因為一旦住下來，",
          "sc": "因为一旦住下来，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 199622,
          "spk": "裕太 (ユータ)",
          "ja": "帰りたくなくなっちゃうだろうから！",
          "tc": "就會變得不想回去了啊！",
          "sc": "就会变得不想回去了啊！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 199635,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、<player>",
          "tc": "我說，<player>，",
          "sc": "我说，<player>，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 199642,
          "spk": "裕太 (ユータ)",
          "ja": "俺のことはユータって呼んで！",
          "tc": "你就叫我裕太吧！",
          "sc": "你就叫我裕太吧！"
        },
        {
          "f_idx": 21,
          "pidx_tc": 199649,
          "spk": "裕太 (ユータ)",
          "ja": "困ったことがあれば気軽に相談してね",
          "tc": "有什麼煩惱都可以盡量找我商量。",
          "sc": "有什么烦恼都可以尽量找我商量。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7990,
      "rec_id": "TALK_ID_10_0101_008_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199677,
          "spk": "驹子 (コマコ)",
          "ja": "ところでユータさんは、",
          "tc": "話說回來，裕太哥，",
          "sc": "话说回来，裕太哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199684,
          "spk": "驹子 (コマコ)",
          "ja": "ここで何してたの？",
          "tc": "你在這裡做什麼？",
          "sc": "你在这里做什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199697,
          "spk": "裕太 (ユータ)",
          "ja": "先輩に相談しようと思って来たんだ",
          "tc": "我是來這裡找學長商量事情的。",
          "sc": "我是来这里找学长商量事情的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199704,
          "spk": "裕太 (ユータ)",
          "ja": "昨日のお祭りの後片付け、",
          "tc": "因為昨天祭典的收拾善後工作",
          "sc": "因为昨天祭典的收拾善后工作"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199711,
          "spk": "裕太 (ユータ)",
          "ja": "俺も手伝わせてほしくてね",
          "tc": "我也想幫點忙啊。",
          "sc": "我也想帮点忙啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199724,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんが手伝わなくていいって",
          "tc": "我聽木助哥說",
          "sc": "我听木助哥说"
        },
        {
          "f_idx": 6,
          "pidx_tc": 199731,
          "spk": "驹子 (コマコ)",
          "ja": "言ってたけど……",
          "tc": "不需要幫忙的……",
          "sc": "不需要帮忙的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 199744,
          "spk": "裕太 (ユータ)",
          "ja": "俺、いつもなにもしてないから",
          "tc": "我平時什麼都沒做，",
          "sc": "我平时什么都没做，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 199751,
          "spk": "裕太 (ユータ)",
          "ja": "たまには、片付けまで参加したいんだ",
          "tc": "偶爾也想要參與到最後的收拾啊。",
          "sc": "偶尔也想要参与到最后的收拾啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7991,
      "rec_id": "TALK_ID_10_0101_008_05_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199777,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、早く帰ってこないかなぁ……",
          "tc": "學長能不能早一點回來啊……",
          "sc": "学长能不能早一点回来啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7992,
      "rec_id": "TALK_ID_10_0101_008_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 199805,
          "spk": "？？？ (未知角色)",
          "ja": "あ、コマコ",
          "tc": "啊，是駒子。",
          "sc": "啊，是驹子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 199812,
          "spk": "？？？ (未知角色)",
          "ja": "こんな時間に珍しい",
          "tc": "這時間看到妳還真稀奇。",
          "sc": "这时间看到你还真稀奇。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 199819,
          "spk": "？？？ (未知角色)",
          "ja": "なにしてるんだ？",
          "tc": "妳在做什麼啊？",
          "sc": "你在做什么啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 199832,
          "spk": "驹子 (コマコ)",
          "ja": "スミレくん、ヨウちゃん、こんにちは",
          "tc": "堇怜，小洋，你們好啊。",
          "sc": "堇怜，小洋，你们好啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 199839,
          "spk": "驹子 (コマコ)",
          "ja": "この子……<player>は山で迷ってて……",
          "tc": "這孩子……<player>他在山裡迷路了……",
          "sc": "这孩子……<player>他在山里迷路了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 199846,
          "spk": "驹子 (コマコ)",
          "ja": "村まで連れてきたんだ",
          "tc": "所以我就把他帶來了村裡。",
          "sc": "所以我就把他带来了村里。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 199859,
          "spk": "堇怜 (スミレ)",
          "ja": "ふーん、なるほど、だから",
          "tc": "哦，原來如此。",
          "sc": "哦，原来如此。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 199866,
          "spk": "堇怜 (スミレ)",
          "ja": "仕事切り上げて戻ってきたんだ",
          "tc": "所以妳才提早結束工作先回來了啊。",
          "sc": "所以你才提早结束工作先回来了啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 199879,
          "spk": "驹子 (コマコ)",
          "ja": "二人はヤギさんのお世話かな？",
          "tc": "你們是在照顧山羊嗎？",
          "sc": "你们是在照顾山羊吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 199892,
          "spk": "洋 (ヨウ)",
          "ja": "うん、お耳のリボン、",
          "tc": "嗯，牠耳朵上的蝴蝶結",
          "sc": "嗯，它耳朵上的蝴蝶结"
        },
        {
          "f_idx": 10,
          "pidx_tc": 199899,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがつけてあげたんだよ",
          "tc": "就是我幫牠綁上去的。",
          "sc": "就是我帮它绑上去的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 199912,
          "spk": "堇怜 (スミレ)",
          "ja": "やめとけって言ったんだけどさ",
          "tc": "我說過別那麼做了，",
          "sc": "我说过别那么做了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 199919,
          "spk": "堇怜 (スミレ)",
          "ja": "ヨウが、言うこと聞かなくて……",
          "tc": "但洋她就是不聽……",
          "sc": "但洋她就是不听……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 199932,
          "spk": "堇怜 (スミレ)",
          "ja": "それよりコマコは",
          "tc": "是說駒子，",
          "sc": "是说驹子，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 199939,
          "spk": "堇怜 (スミレ)",
          "ja": "そいつと話していいの？",
          "tc": "妳跟那邊那個講話沒問題嗎？",
          "sc": "你跟那边那个讲话没问题吗？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 199955,
          "spk": "堇怜 (スミレ)",
          "ja": "リンに怒られなかったか？",
          "tc": "沒被林罵嗎？",
          "sc": "没被林骂吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 199968,
          "spk": "驹子 (コマコ)",
          "ja": "え……うん",
          "tc": "呃……嗯。",
          "sc": "呃……嗯。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 199975,
          "spk": "驹子 (コマコ)",
          "ja": "緊急事態だし、子どもだから……",
          "tc": "畢竟事態緊急，而且他只是個孩子……",
          "sc": "毕竟事态紧急，而且他只是个孩子……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 199988,
          "spk": "堇怜 (スミレ)",
          "ja": "ふーん、なるほど",
          "tc": "哦，這樣啊。",
          "sc": "哦，这样啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7993,
      "rec_id": "TALK_ID_10_0101_008_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 200018,
          "spk": "驹子 (コマコ)",
          "ja": "もう、お祭りの片付けは",
          "tc": "祭典的善後工作",
          "sc": "祭典的善后工作"
        },
        {
          "f_idx": 1,
          "pidx_tc": 200025,
          "spk": "驹子 (コマコ)",
          "ja": "ほとんど終わってるんだね",
          "tc": "已經幾乎差不多結束了吧。",
          "sc": "已经几乎差不多结束了吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 200038,
          "spk": "堇怜 (スミレ)",
          "ja": "さっきまで、みんなと一緒に片付けてたんだ",
          "tc": "和大家一起整理到剛才。",
          "sc": "和大家一起整理到刚才。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 200045,
          "spk": "堇怜 (スミレ)",
          "ja": "リンは、どっか行っちゃうし……",
          "tc": "也不知道林跑到哪裡去了……",
          "sc": "也不知道林跑到哪里去了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 200052,
          "spk": "堇怜 (スミレ)",
          "ja": "毎年毎年、ホントめんどくさいよ……",
          "tc": "每一年都這樣，真麻煩……",
          "sc": "每一年都这样，真麻烦……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 200065,
          "spk": "驹子 (コマコ)",
          "ja": "あ、あはは……",
          "tc": "啊、啊哈哈……",
          "sc": "啊、啊哈哈……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 200072,
          "spk": "驹子 (コマコ)",
          "ja": "リンも忙しいんだと思うよ……",
          "tc": "我想林她一定也很忙的……",
          "sc": "我想林她一定也很忙的……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 200085,
          "spk": "堇怜 (スミレ)",
          "ja": "今日だけじゃなくて、昨日から僕が",
          "tc": "不只今天，從昨天起",
          "sc": "不只今天，从昨天起"
        },
        {
          "f_idx": 8,
          "pidx_tc": 200092,
          "spk": "堇怜 (スミレ)",
          "ja": "そのヤギにエサをやってるんだぜ？",
          "tc": "就是我在負責餵那隻山羊耶！",
          "sc": "就是我在负责喂那只山羊呢！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 200099,
          "spk": "堇怜 (スミレ)",
          "ja": "リンがやればいいのに……",
          "tc": "明明讓林去做就好了……",
          "sc": "明明让林去做就好了……"
        }
      ]
    },
