      "rec_id": "TALK_ID_10_0500_020_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 289792,
          "spk": "木助 (キスケ)",
          "ja": "そうか、よかった",
          "tc": "是嗎，太好了。",
          "sc": "是吗，太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 289799,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ、荷物をまとめ始めてくれ",
          "tc": "那你就開始收拾行李吧。",
          "sc": "那你就开始收拾行李吧。"
        },
