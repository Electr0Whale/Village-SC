        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8167,
      "rec_id": "TALK_ID_10_0302_021_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247028,
          "spk": "驹子 (コマコ)",
          "ja": "あの子はもう……",
          "tc": "我本來以為……",
          "sc": "我本来以为……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247035,
          "spk": "驹子 (コマコ)",
          "ja": "死んじゃったんだと思うんだけど……",
          "tc": "牠已經死掉了……",
          "sc": "它已经死掉了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247046,
          "spk": "驹子 (コマコ)",
          "ja": "でも……ヨウちゃんがね、",
          "tc": "可是……小洋她說，",
          "sc": "可是……小洋她说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247053,
          "spk": "驹子 (コマコ)",
          "ja": "夜中にピロの鳴き声を、聞いたって言うの",
          "tc": "在晚上聽到了嗶羅的叫聲。",
          "sc": "在晚上听到了哔罗的叫声。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8168,
      "rec_id": "TALK_ID_10_0302_021_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247071,
          "spk": "驹子 (コマコ)",
          "ja": "きっと、お化けになって",
          "tc": "所以我猜牠一定是變成了妖怪，",
          "sc": "所以我猜它一定是变成了妖怪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247078,
          "spk": "驹子 (コマコ)",
          "ja": "夜中を彷徨っているんじゃないかって思って……",
          "tc": "正在夜裡徘徊……",
          "sc": "正在夜里徘徊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8169,
      "rec_id": "TALK_ID_10_0302_021_08_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247225,
          "spk": "驹子 (コマコ)",
          "ja": "タタリ神になって人を襲うだなんて……",
          "tc": "要是真的變成祟神襲擊人……",
          "sc": "要是真的变成祟神袭击人……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247232,
          "spk": "驹子 (コマコ)",
          "ja": "ピロもヨウちゃんも可哀想だから……",
          "tc": "那嗶羅還有小洋都太可憐了……",
          "sc": "那哔罗还有小洋都太可怜了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247239,
          "spk": "驹子 (コマコ)",
          "ja": "私たちで見つけて、ちゃんと弔ってあげたいの",
          "tc": "還是由我們找出嗶羅，好好弔祭牠吧。",
          "sc": "还是由我们找出哔罗，好好吊祭它吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8170,
      "rec_id": "TALK_ID_10_0302_021_08_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247257,
          "spk": "帷 (トバリ)",
          "ja": "……なに？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247264,
          "spk": "帷 (トバリ)",
          "ja": "私が手伝っているのが、そんなにおかしい？",
          "tc": "我來幫忙有那麼奇怪嗎？",
          "sc": "我来帮忙有那么奇怪吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247277,
          "spk": "驹子 (コマコ)",
          "ja": "トバリはリンの命令で、",
          "tc": "帷因為林的命令，",
          "sc": "帷因为林的命令，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247284,
          "spk": "驹子 (コマコ)",
          "ja": "お手伝い券の消化中なんだ",
          "tc": "正在用掉幫忙券。",
          "sc": "正在用掉帮忙券。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247295,
          "spk": "驹子 (コマコ)",
          "ja": "私が頼りないのを見かねて、",
          "tc": "她看不下去我這麼靠不住，",
          "sc": "她看不下去我这么靠不住，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247302,
          "spk": "驹子 (コマコ)",
          "ja": "仕方なく手伝ってくれてるんだよ",
          "tc": "才不得已來幫我的。",
          "sc": "才不得已来帮我的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247315,
          "spk": "帷 (トバリ)",
          "ja": "ところでアンタは一体何を……",
          "tc": "話說回來，你到底是有什麼事……",
          "sc": "话说回来，你到底是有什么事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8172,
      "rec_id": "TALK_ID_10_0303_063_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260722,
          "spk": "名护 (ナゴ)",
          "ja": "……キミも気にしないタイプなんだね",
          "tc": "……你也是不在意的人啊。",
          "sc": "……你也是不在意的人啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8173,
      "rec_id": "TALK_ID_10_0303_063_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 260749,
          "spk": "驹子 (コマコ)",
          "ja": "ええ！？",
          "tc": "咦！？",
          "sc": "咦！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 260756,
          "spk": "驹子 (コマコ)",
          "ja": "祠に自分を祀ったの！？",
          "tc": "你在祠堂供奉自己嗎！？",
          "sc": "你在祠堂供奉自己吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 260767,
          "spk": "驹子 (コマコ)",
          "ja": "な……ば、バチ当たりだから、",
          "tc": "那……那會遭天譴的，",
          "sc": "那……那会遭天谴的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 260774,
          "spk": "驹子 (コマコ)",
          "ja": "そんなこと言っちゃダメだよ……",
          "tc": "不可以這樣說……",
          "sc": "不可以这样说……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 260781,
          "spk": "驹子 (コマコ)",
          "ja": "きっと良くないことが起きちゃうから……！",
          "tc": "不然一定會發生不好的事……！",
          "sc": "不然一定会发生不好的事……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 260794,
          "spk": "名护 (ナゴ)",
          "ja": "あはは……！",
          "tc": "啊哈哈……！",
          "sc": "啊哈哈……！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 260801,
          "spk": "名护 (ナゴ)",
          "ja": "キミは、そういう冗談も言えるんだな",
          "tc": "你還會開這種玩笑啊。",
          "sc": "你还会开这种玩笑啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8174,
      "rec_id": "TALK_ID_10_0401_002_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 261927,
          "spk": "名护 (ナゴ)",
          "ja": "これは彼ヶ津村の民話なんだが、",
          "tc": "這本是關於彼津村的民間故事的書，",
          "sc": "这本是关于彼津村的民间故事的书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 261934,
          "spk": "名护 (ナゴ)",
          "ja": "なんだか不穏なことが、書いてあってね……",
          "tc": "但裡面寫了一些感覺不太對勁的內容………",
          "sc": "但里面写了一些感觉不太对劲的内容……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 261941,
          "spk": "名护 (ナゴ)",
          "ja": "同じことが起きるのではと心配になって……",
          "tc": "我擔心會不會發生同樣的事……",
          "sc": "我担心会不会发生同样的事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 261952,
          "spk": "名护 (ナゴ)",
          "ja": "キミの意見を聞きたいんだ",
          "tc": "所以想聽聽你的意見。",
          "sc": "所以想听听你的意见。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 261959,
          "spk": "名护 (ナゴ)",
          "ja": "今から読んであげるから、聞いてくれるかな？",
          "tc": "我現在就念給你聽，你能聽聽看嗎？",
          "sc": "我现在就念给你听，你能听听看吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8175,
      "rec_id": "TALK_ID_10_0401_010_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266961,
          "spk": "今野 (コンノ)",
          "ja": "よくぞ聞いてくれましたァ！",
          "tc": "問得好～！",
          "sc": "问得好～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8176,
      "rec_id": "TALK_ID_10_0401_010_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 266979,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>二年前に注文したダージリンの茶葉が、",
          "tc": "<speed 2.0>我兩年前訂的大吉嶺茶葉啊，",
          "sc": "<speed 2.0>我两年前订的大吉岭茶叶啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266986,
          "spk": "今野 (コンノ)",
          "ja": "先ほどやっっっと届きましてね！",
          "tc": "剛才終～～～於送來了！",
          "sc": "刚才终～～～于送来了！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266993,
          "spk": "今野 (コンノ)",
          "ja": "この茶葉はちょっとした逸品でしてェ</speed>",
          "tc": "這款茶葉可是極品中的極品啊～</speed>",
          "sc": "这款茶叶可是极品中的极品啊～</speed>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267004,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>噂ではヒマラヤの麓、標高二千メートルの",
          "tc": "<speed 2.0>據說是在喜馬拉雅山腳下，",
          "sc": "<speed 2.0>据说是在喜马拉雅山脚下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267011,
          "spk": "今野 (コンノ)",
          "ja": "茶園で、春のごく短い期間だけ手摘みされる",
          "tc": "標高2000公尺的茶園裡，只在春天",
          "sc": "标高2000公尺的茶园里，只在春天"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267018,
          "spk": "今野 (コンノ)",
          "ja": "一番摘みのファーストフラッシュだそうでェ</speed>",
          "tc": "極短的採摘期才能手工採收的初摘茶喔～</speed>",
          "sc": "极短的采摘期才能手工采收的初摘茶哟～～</speed>"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267031,
          "spk": "驹子 (コマコ)",
          "ja": "……？、？？",
          "tc": "……？？？",
          "sc": "……？？？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8177,
      "rec_id": "TALK_ID_10_0401_010_05_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 267049,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>まるで瑞々しいマスカットや白桃を思わせる",
          "tc": "<speed 2.0>特徵是茶湯帶有一股清爽芳香，",
          "sc": "<speed 2.0>特征是茶汤带有一股清爽芳香，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 267056,
          "spk": "今野 (コンノ)",
          "ja": "爽やかな芳香が特徴なんですよォ",
          "tc": "宛如鮮嫩多汁的麝香葡萄或白桃一般～",
          "sc": "宛如鲜嫩多汁的麝香葡萄或白桃一般～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 267063,
          "spk": "今野 (コンノ)",
          "ja": "……そう、これこそが初摘みダージリンの真髄！</speed>",
          "tc": "……沒錯，這正是初摘大吉嶺茶葉的精隨啊！</speed>",
          "sc": "……没错，这正是初摘大吉岭茶叶的精随啊！</speed>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 267072,
          "spk": "今野 (コンノ)",
          "ja": "<speed 2.0>お値段はなんと１０グラムで１,５００円！",
          "tc": "<speed 2.0>而且價格竟然高達10克1500元！",
          "sc": "<speed 2.0>而且价格竟然高达10克1500元！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 267079,
          "spk": "今野 (コンノ)",
          "ja": "ご覧ください、このパッケージから漂う高級感を",
          "tc": "兩位請看，這散發著高級感的包裝。",
          "sc": "两位请看，这散发着高级感的包装。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 267086,
          "spk": "今野 (コンノ)",
          "ja": "……まさに“香りを飲む”贅沢というものです</speed>",
          "tc": "……這正是所謂「啜飲芬芳」的奢華享受啊！</speed>",
          "sc": "……这正是所谓“啜饮芬芳”的奢华享受啊！</speed>"
        },
        {
          "f_idx": 6,
          "pidx_tc": 267097,
          "spk": "今野 (コンノ)",
          "ja": "ワタシはこれを今から楽しまねばならないので、",
          "tc": "我接下來得去好好享用這杯大吉嶺了，",
          "sc": "我接下来得去好好享用这杯大吉岭了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 267104,
          "spk": "今野 (コンノ)",
          "ja": "アナタたちに構ってる暇がないのです",
          "tc": "才沒那個閒功夫搭理兩位。",
          "sc": "才没那个闲功夫搭理两位。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 267124,
          "spk": "驹子 (コマコ)",
          "ja": "あ……えーっと",
          "tc": "啊……呃～",
          "sc": "啊……呃～"
        },
        {
          "f_idx": 10,
          "pidx_tc": 267137,
          "spk": "今野 (コンノ)",
          "ja": "あ、でも、これを飲みながらでしたら、",
          "tc": "啊，不過，如果是邊喝邊聽的話，",
          "sc": "啊，不过，如果是边喝边听的话，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 267144,
          "spk": "今野 (コンノ)",
          "ja": "話を聞いて差し上げても構わないですよ",
          "tc": "我也不是不能聽聽兩位想說什麼啦，",
          "sc": "我也不是不能听听两位想说什么啦，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 267151,
          "spk": "今野 (コンノ)",
          "ja": "なにしろ、ワタシは機嫌が良いので！",
          "tc": "畢竟我現在心情正好嘛！",
          "sc": "毕竟我现在心情正好嘛！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 267162,
          "spk": "驹子 (コマコ)",
          "ja": "え……あ……",
          "tc": "咦……啊……",
          "sc": "咦……啊……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 267169,
          "spk": "驹子 (コマコ)",
          "ja": "は、はい……",
          "tc": "好、好的……",
          "sc": "好、好的……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 267182,
          "spk": "今野 (コンノ)",
          "ja": "もちろん、アナタがたの分はありませんよ",
          "tc": "當然，這東西可沒兩位的份！",
          "sc": "当然，这东西可没两位的份！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 267189,
          "spk": "今野 (コンノ)",
          "ja": "香りだけ楽しませてあげましょうねェ",
          "tc": "就讓兩位在旁邊聞香吧～",
          "sc": "就让两位在旁边闻香吧～"
        }
      ]
    },
