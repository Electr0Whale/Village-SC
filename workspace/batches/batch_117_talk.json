          "spk": "驹子 (コマコ)",
          "ja": "セミが鳴いてると、気配を隠せて",
          "tc": "蟬在叫的時候，可以掩飾我的動靜，",
          "sc": "蝉在叫的时候，可以掩饰我的动静，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39226,
          "spk": "驹子 (コマコ)",
          "ja": "狩りもしやすくなるんだ",
          "tc": "狩獵起來也會比較容易。",
          "sc": "狩猎起来也会比较容易。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39237,
          "spk": "驹子 (コマコ)",
          "ja": "おかげで今は素材の在庫もたくさんあるよ",
          "tc": "多虧如此，現在材料的庫存很充足喔。",
          "sc": "多亏如此，现在材料的库存很充足哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1053,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39261,
          "spk": "驹子 (コマコ)",
          "ja": "手入れしてるだけなのに",
          "tc": "明明只是在進行保養",
          "sc": "明明只是在进行保养"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39268,
          "spk": "驹子 (コマコ)",
          "ja": "汗かいちゃうよね……",
          "tc": "就流汗了……",
          "sc": "就流汗了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39279,
          "spk": "驹子 (コマコ)",
          "ja": "手が滑らないよう気をつけなくちゃ",
          "tc": "我得要小心不要手滑。",
          "sc": "我得要小心不要手滑。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1054,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39310,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんがおすすめしてくれた",
          "tc": "木助哥推薦給我的",
          "sc": "木助哥推荐给我的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39317,
          "spk": "驹子 (コマコ)",
          "ja": "手入れ道具、すごく良い感じなの",
          "tc": "保養工具非常好用呢。",
          "sc": "保养工具非常好用呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39328,
          "spk": "驹子 (コマコ)",
          "ja": "今度お礼言いに行かないとね",
          "tc": "下次要去跟他道謝才行。",
          "sc": "下次要去跟他道谢才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1055,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39352,
          "spk": "驹子 (コマコ)",
          "ja": "なんか……ちょっとヘタってきたかな……",
          "tc": "好像……有點開始變鈍了呢……",
          "sc": "好像……有点开始变钝了呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39359,
          "spk": "驹子 (コマコ)",
          "ja": "そろそろ柄の部分も",
          "tc": "差不多也該把握柄的部分",
          "sc": "差不多也该把握柄的部分"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39366,
          "spk": "驹子 (コマコ)",
          "ja": "取り替えてあげないと危ないかも……",
          "tc": "替換掉才安全……",
          "sc": "替换掉才安全……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1056,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2113",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39390,
          "spk": "驹子 (コマコ)",
          "ja": "あ、良かったら見ていく？",
          "tc": "啊，你有空的話要去看看嗎？",
          "sc": "啊，你有空的话要去看看吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39401,
          "spk": "驹子 (コマコ)",
          "ja": "罠作りにはコツがあるんだよ",
          "tc": "製作陷阱是有訣竅的，",
          "sc": "制作陷阱是有诀窍的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39408,
          "spk": "驹子 (コマコ)",
          "ja": "動物に気づかれないように、",
          "tc": "必須要小心別被動物發現，",
          "sc": "必须要小心别被动物发现，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39415,
          "spk": "驹子 (コマコ)",
          "ja": "自然に溶け込む感じで作らないとダメなの",
          "tc": "讓陷阱可以自然地融入周遭的環境。",
          "sc": "让陷阱可以自然地融入周遭的环境。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1057,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2114",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39439,
          "spk": "驹子 (コマコ)",
          "ja": "この時期は元気な動物が",
          "tc": "這個時期，充滿活力的動物",
          "sc": "这个时期，充满活力的动物"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39446,
          "spk": "驹子 (コマコ)",
          "ja": "よく罠に引っかかってくれるんだ",
          "tc": "常常會踩到陷阱。",
          "sc": "常常会踩到陷阱。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39457,
          "spk": "驹子 (コマコ)",
          "ja": "暑くてじっとできないんだろうね",
          "tc": "可能是熱到靜不下來吧。",
          "sc": "可能是热到静不下来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1058,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2115",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39488,
          "spk": "驹子 (コマコ)",
          "ja": "罠作りの後はどうしようかな……",
          "tc": "製作完陷阱之後要做什麼呢……",
          "sc": "制作完陷阱之后要做什么呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39506,
          "spk": "驹子 (コマコ)",
          "ja": "とりあえず、リンのところにでも行って、",
          "tc": "總之先去林那裡",
          "sc": "总之先去林那里"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39513,
          "spk": "驹子 (コマコ)",
          "ja": "お仕事がないか聞いてみようっと",
          "tc": "問問看有沒有其他工作吧。",
          "sc": "问问看有没有其他工作吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1059,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2116",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39537,
          "spk": "驹子 (コマコ)",
          "ja": "こうやって紐を編み込むみたいなの",
          "tc": "像編繩子這類的工作雖然很單調，",
          "sc": "像编绳子这类的工作虽然很单调，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39544,
          "spk": "驹子 (コマコ)",
          "ja": "地味な作業だけど、好きなんだよね",
          "tc": "但是我很喜歡呢。",
          "sc": "但是我很喜欢呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1060,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39575,
          "spk": "驹子 (コマコ)",
          "ja": "雨が降ると地面がぬかるんじゃうでしょ？",
          "tc": "一下雨地面不是就會滿是泥巴嗎？",
          "sc": "一下雨地面不是就会满是泥巴吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39593,
          "spk": "驹子 (コマコ)",
          "ja": "山だと土砂崩れとかが起きることもあるから",
          "tc": "而且山區還有可能會發生土石流，",
          "sc": "而且山区还有可能会发生土石流，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39600,
          "spk": "驹子 (コマコ)",
          "ja": "様子を見てるんだ……",
          "tc": "所以我在觀察情況……",
          "sc": "所以我在观察情况……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1061,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39624,
          "spk": "驹子 (コマコ)",
          "ja": "虫の声がすごいねぇ",
          "tc": "蟲鳴好大聲啊，",
          "sc": "虫鸣好大声啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39631,
          "spk": "驹子 (コマコ)",
          "ja": "楽しくおしゃべりしてるのかな？",
          "tc": "牠們是不是在開心的聊天呢？",
          "sc": "它们是不是在开心的聊天呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1062,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39662,
          "spk": "驹子 (コマコ)",
          "ja": "緑がいっぱいだと癒されるんだって",
          "tc": "「整片綠色的風景很療癒」",
          "sc": "“整片绿色的风景很疗愈”"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39669,
          "spk": "驹子 (コマコ)",
          "ja": "ユータさんが言ってたけど……",
          "tc": "裕太哥是這麼說的……",
          "sc": "裕太哥是这么说的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39676,
          "spk": "驹子 (コマコ)",
          "ja": "緑を見ると、どうして癒されるのかな？",
          "tc": "但為什麼看著綠色就會被療癒呢……",
          "sc": "但为什么看着绿色就会被疗愈呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39687,
          "spk": "驹子 (コマコ)",
          "ja": "私はあんまり、癒されたことないかな……",
          "tc": "我不覺得自己有被療癒到……",
          "sc": "我不觉得自己有被疗愈到……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1063,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39718,
          "spk": "驹子 (コマコ)",
          "ja": "この時期は、暑くてなかなか寝付けないね……",
          "tc": "這個時期常常會熱到睡不著呢……",
          "sc": "这个时期常常会热到睡不着呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39736,
          "spk": "驹子 (コマコ)",
          "ja": "何か良い道具がないか",
          "tc": "我去問問看茶梅姐",
          "sc": "我去问问看茶梅姐"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39743,
          "spk": "驹子 (コマコ)",
          "ja": "サザンカさんに相談してみようかな……",
          "tc": "有沒有什麼好道具可以用好了。",
          "sc": "有没有什么好道具可以用好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1064,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39767,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっとうたた寝しただけで",
          "tc": "我只是稍微打個瞌睡",
          "sc": "我只是稍微打个瞌睡"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39774,
          "spk": "驹子 (コマコ)",
          "ja": "汗かいちゃった……",
          "tc": "就流汗了……",
          "sc": "就流汗了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39785,
          "spk": "驹子 (コマコ)",
          "ja": "うう、もう夜なのに暑すぎるよ……",
          "tc": "嗚嗚，怎麼晚上還那麼熱啊……",
          "sc": "呜呜，怎么晚上还那么热啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1065,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39816,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃん、この時期でも",
          "tc": "哥哥連這個時期",
          "sc": "哥哥连这个时期"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39823,
          "spk": "驹子 (コマコ)",
          "ja": "山のテントで寝てたりするんだよ",
          "tc": "也會在山上搭帳篷過夜。",
          "sc": "也会在山上搭帐篷过夜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39830,
          "spk": "驹子 (コマコ)",
          "ja": "いつか蒸し焼きになっちゃうよ……",
          "tc": "好擔心他有天會被曬乾……",
          "sc": "好担心他有天会被晒干……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1066,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39854,
          "spk": "驹子 (コマコ)",
          "ja": "夏は素材があっという間に",
          "tc": "到了夏天，",
          "sc": "到了夏天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39861,
          "spk": "驹子 (コマコ)",
          "ja": "なくなっちゃうんだよね",
          "tc": "材料都會轉眼間消耗殆盡，",
          "sc": "材料都会转眼间消耗殆尽，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39868,
          "spk": "驹子 (コマコ)",
          "ja": "みんな一生懸命動く時期だからかな",
          "tc": "因為這是大家拚命工作的時期。",
          "sc": "因为这是大家拚命工作的时期。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1067,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39892,
          "spk": "驹子 (コマコ)",
          "ja": "物が多いから、たまに整理しておかないと、",
          "tc": "因為東西太多，偶爾不整理的話，",
          "sc": "因为东西太多，偶尔不整理的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39899,
          "spk": "驹子 (コマコ)",
          "ja": "なにも入らなくなっちゃうんだ……",
          "tc": "就什麼都放不下了……",
          "sc": "就什么都放不下了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 39917,
          "spk": "驹子 (コマコ)",
          "ja": "私、ものを捨てるのが苦手なの……",
          "tc": "我不擅長丟東西……",
          "sc": "我不擅长丢东西……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 39924,
          "spk": "驹子 (コマコ)",
          "ja": "壊れた罠とかも万が一のことを考えると、",
          "tc": "就連壞掉的陷阱也是，考慮到要是有個萬一，",
          "sc": "就连坏掉的陷阱也是，考虑到要是有个万一，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 39931,
          "spk": "驹子 (コマコ)",
          "ja": "なかなか捨てられなくって……",
          "tc": "就很難丟掉……",
          "sc": "就很难丢掉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1068,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39955,
          "spk": "驹子 (コマコ)",
          "ja": "うん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 39962,
          "spk": "驹子 (コマコ)",
          "ja": "なにか気になるものでもあった？",
          "tc": "有什麼很在意的東西嗎？",
          "sc": "有什么很在意的东西吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 39969,
          "spk": "驹子 (コマコ)",
          "ja": "出してあげるから言ってね",
          "tc": "你都可以跟我說，我拿給你看。",
          "sc": "你都可以跟我说，我拿给你看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1069,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 39993,
          "spk": "驹子 (コマコ)",
          "ja": "うーん……弓引きの調子が",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40000,
          "spk": "驹子 (コマコ)",
          "ja": "なんか良くないなぁ",
          "tc": "拉弓變得卡卡的。",
          "sc": "拉弓变得卡卡的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40011,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんに教えてもらおうかな？",
          "tc": "我去問問看哥哥怎麼辦好了。",
          "sc": "我去问问看哥哥怎么办好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1070,
      "rec_id": "TALK_ID_HUNTER_ROUTINE_20_105_2211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 40035,
          "spk": "驹子 (コマコ)",
          "ja": "はぁ……なんだか憂鬱だなぁ",
          "tc": "唉……好鬱悶啊。",
          "sc": "唉……好郁闷啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 40046,
          "spk": "驹子 (コマコ)",
          "ja": "雨が降ってると、",
          "tc": "下雨天有時候",
          "sc": "下雨天有时候"
        },
        {
          "f_idx": 2,
          "pidx_tc": 40053,
