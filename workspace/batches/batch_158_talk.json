  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3301,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 167109,
          "spk": "林 (リン)",
          "ja": "世間一般的には新年度が始まるわけだし、",
          "tc": "既然世間都要開始新的一年了，",
          "sc": "既然世间都要开始新的一年了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 167116,
          "spk": "林 (リン)",
          "ja": "村の設備を改築するのもありかもしれないわね",
          "tc": "或許也可以考慮整修一下村子裡的設施了呢。",
          "sc": "或许也可以考虑整修一下村子里的设施了呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 167136,
          "spk": "木助 (キスケ)",
          "ja": "長いこと雨風に晒されて、",
          "tc": "畢竟經過長年風吹雨打，",
          "sc": "毕竟经过长年风吹雨打，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 167143,
          "spk": "木助 (キスケ)",
          "ja": "だいぶ老朽化が進んでるもんな",
          "tc": "那些設施都已經相當老舊了。",
          "sc": "那些设施都已经相当老旧了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 167154,
          "spk": "木助 (キスケ)",
          "ja": "んじゃ、まずは見積り出せよ",
          "tc": "那先報個預算給我吧。",
          "sc": "那先报个预算给我吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 167161,
          "spk": "木助 (キスケ)",
          "ja": "もらった分の仕事はきっちりこなすぜ",
          "tc": "只要錢到位，保證做到位。",
          "sc": "只要钱到位，保证做到位。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 167181,
          "spk": "林 (リン)",
          "ja": "詳細は後で詰めるとして、",
          "tc": "細節先等之後再談，",
          "sc": "细节先等之后再谈，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 167188,
          "spk": "林 (リン)",
          "ja": "村中の公共施設を建て替えた場合に",
          "tc": "如果要改建村子裡的公共設施，",
          "sc": "如果要改建村子里的公共设施，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 167195,
          "spk": "林 (リン)",
          "ja": "かかる費用は…………",
          "tc": "整個花費…………",
          "sc": "整个花费……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 167208,
          "spk": "木助 (キスケ)",
          "ja": "ん？　どうした？",
          "tc": "嗯？怎麼了？",
          "sc": "嗯？怎么了？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 167215,
          "spk": "木助 (キスケ)",
          "ja": "何か問題か？",
          "tc": "有什麼問題嗎？",
          "sc": "有什么问题吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 167228,
          "spk": "林 (リン)",
          "ja": "ねえキスケさん",
          "tc": "我說，木助哥。",
          "sc": "我说，木助哥。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 167235,
          "spk": "林 (リン)",
          "ja": "まとめて発注する分、",
          "tc": "要是全都發包給你的話，",
          "sc": "要是全都发包给你的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 167242,
          "spk": "林 (リン)",
          "ja": "割引きとかって？",
          "tc": "有沒有打折啊？",
          "sc": "有没有打折啊？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 167255,
          "spk": "木助 (キスケ)",
          "ja": "値下げはねえぞ",
          "tc": "才沒那種事。",
          "sc": "才没那种事。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 167262,
          "spk": "木助 (キスケ)",
          "ja": "知ってるだろ",
          "tc": "你也知道吧，",
          "sc": "你也知道吧，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 167269,
          "spk": "木助 (キスケ)",
          "ja": "俺はもらった分の仕事しかしねえよ",
          "tc": "我這個人就是收多少錢做多少事。",
          "sc": "我这个人就是收多少钱做多少事。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 167282,
          "spk": "林 (リン)",
          "ja": "そうよね……",
          "tc": "我想也是……",
          "sc": "我想也是……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 167289,
          "spk": "林 (リン)",
          "ja": "設備を改築するには",
          "tc": "但是想要整修設施，",
          "sc": "但是想要整修设施，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 167296,
          "spk": "林 (リン)",
          "ja": "村の財源が厳しいわ……",
          "tc": "村子實在經費拮据……",
          "sc": "村子实在经费拮据……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 167307,
          "spk": "林 (リン)",
          "ja": "みんながちゃんと村にお金を",
          "tc": "要是大家有好好繳錢給村子，",
          "sc": "要是大家有好好缴钱给村子，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 167314,
          "spk": "林 (リン)",
          "ja": "納めてくれればこんなことには……",
          "tc": "也不至於財政吃緊……",
          "sc": "也不至于财政吃紧……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 167325,
          "spk": "林 (リン)",
          "ja": "村の存続のためには",
          "tc": "為了村子的存亡……",
          "sc": "为了村子的存亡……"
        },
        {
          "f_idx": 25,
          "pidx_tc": 167332,
          "spk": "林 (リン)",
          "ja": "今後はもっと厳しく",
          "tc": "往後我應該要更加嚴格",
          "sc": "往后我应该要更加严格"
        },
        {
          "f_idx": 26,
          "pidx_tc": 167339,
          "spk": "林 (リン)",
          "ja": "取り立てるべきね",
          "tc": "向大家徵收稅金才行。",
          "sc": "向大家征收税金才行。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 167352,
          "spk": "木助 (キスケ)",
          "ja": "あんまやりすぎると村の連中から",
          "tc": "當心別做得太過頭了，",
          "sc": "当心别做得太过头了，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 167359,
          "spk": "木助 (キスケ)",
          "ja": "反感買うから気を付けろよ……",
          "tc": "否則會讓村裡的人反感的……",
          "sc": "否则会让村里的人反感的……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 167372,
          "spk": "林 (リン)",
          "ja": "ええ、もちろん分かってるわ！",
          "tc": "嗯，這點我當然知道！",
          "sc": "嗯，这点我当然知道！"
        },
        {
          "f_idx": 30,
          "pidx_tc": 167379,
          "spk": "林 (リン)",
          "ja": "ギリギリのラインを見定めて",
          "tc": "我會掌握好底線，",
          "sc": "我会掌握好底线，"
        },
        {
          "f_idx": 31,
          "pidx_tc": 167386,
          "spk": "林 (リン)",
          "ja": "上手いことやってみせるから！",
          "tc": "穩穩處理好這件事的！",
          "sc": "稳稳处理好这件事的！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3302,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 167414,
          "spk": "林 (リン)",
          "ja": "ヨウが私を見ると怯えるのよね……",
          "tc": "洋每次看到我都會很害怕呢……",
          "sc": "洋每次看到我都会很害怕呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 167421,
          "spk": "林 (リン)",
          "ja": "取り立ては免除してあげているのに、",
          "tc": "明明我都允許她不用繳稅了……",
          "sc": "明明我都允许她不用缴税了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 167428,
          "spk": "林 (リン)",
          "ja": "なんだか納得いかないわ",
          "tc": "感覺心裡不太平衡呢。",
          "sc": "感觉心里不太平衡呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 167441,
          "spk": "今野 (コンノ)",
          "ja": "まァ、リンさんには村長としての威厳が",
          "tc": "這個嘛，林小姐相當具有身為村長的威嚴，",
          "sc": "这个嘛，林小姐相当具有身为村长的威严，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 167448,
          "spk": "今野 (コンノ)",
          "ja": "十分に備わっている反面、",
          "tc": "但是相對地，",
          "sc": "但是相对地，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 167455,
          "spk": "今野 (コンノ)",
          "ja": "親しまれ度が伸び悩んでいますからねェ",
          "tc": "親近度倒是一直停滯不前呢。",
          "sc": "亲近度倒是一直停滞不前呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 167468,
          "spk": "林 (リン)",
          "ja": "……何よ、親しまれ度って",
          "tc": "……親近度是什麼啊？",
          "sc": "……亲近度是什么啊？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 167475,
          "spk": "林 (リン)",
          "ja": "変な言葉を作らないでくれない？",
          "tc": "可以不要創造奇怪的名詞嗎。",
          "sc": "可以不要创造奇怪的名词吗。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 167488,
          "spk": "今野 (コンノ)",
          "ja": "そういうとこですよォ……",
          "tc": "就是這種態度不好啦……",
          "sc": "就是这种态度不好啦……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 167495,
          "spk": "今野 (コンノ)",
          "ja": "親しみやすさ、可愛がられやすさ、",
          "tc": "比方說好親近、惹人憐愛，",
          "sc": "比方说好亲近、惹人怜爱，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 167502,
          "spk": "今野 (コンノ)",
          "ja": "愛嬌などが足りてないってことですヨ",
          "tc": "還有可愛討喜的魅力還不夠唷。",
          "sc": "还有可爱讨喜的魅力还不够哟～。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 167513,
          "spk": "今野 (コンノ)",
          "ja": "スミレさんやコマコさんを見習ってみては？",
          "tc": "不妨參考一下堇怜先生和駒子小姐的舉止吧？",
          "sc": "不妨参考一下堇怜先生和驹子小姐的举止吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 167520,
          "spk": "今野 (コンノ)",
          "ja": "お二人にはヨウさんも",
          "tc": "妳看洋妹妹，",
          "sc": "你看洋妹妹，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 167527,
          "spk": "今野 (コンノ)",
          "ja": "よく懐いているでしょう？",
          "tc": "她跟那兩位很親近吧。",
          "sc": "她跟那两位很亲近吧。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 167538,
          "spk": "今野 (コンノ)",
          "ja": "リンさんもヨウさんに懐いてほしいのであれば",
          "tc": "如果林小姐也希望洋妹妹可以親近您的話，",
          "sc": "如果林小姐也希望洋妹妹可以亲近您的话，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 167545,
          "spk": "今野 (コンノ)",
          "ja": "何かしら変わる必要がありますねェ",
          "tc": "就必須做出一些改變呢～",
          "sc": "就必须做出一些改变呢～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 167558,
          "spk": "林 (リン)",
          "ja": "別に、懐いてほしいわけじゃないわよ",
          "tc": "我又沒有特別想讓她親近我。",
          "sc": "我又没有特别想让她亲近我。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 167576,
          "spk": "林 (リン)",
          "ja": "……でも、参考までに聞いてあげる",
          "tc": "……但我就當作參考姑且聽聽看吧。",
          "sc": "……但我就当作参考姑且听听看吧。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 167583,
          "spk": "林 (リン)",
          "ja": "どこを変えたらいいって言うの？",
          "tc": "你倒是說說看我有哪裡需要改進？",
          "sc": "你倒是说说看我有哪里需要改进？"
        },
        {
          "f_idx": 20,
          "pidx_tc": 167596,
          "spk": "今野 (コンノ)",
          "ja": "手っ取り早いのは、外見の印象を",
          "tc": "最快的方式──",
          "sc": "最快的方式——"
        },
        {
          "f_idx": 21,
          "pidx_tc": 167603,
          "spk": "今野 (コンノ)",
          "ja": "もっととっつきやすくしてしまうことですヨ",
          "tc": "就是讓自己的外在形象更加平易近人。",
          "sc": "就是让自己的外在形象更加平易近人哟～。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 167621,
          "spk": "今野 (コンノ)",
          "ja": "ちょうど外には綺麗な花がたくさん",
          "tc": "正好外面開著許多漂亮的花，",
          "sc": "正好外面开着许多漂亮的花，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 167628,
          "spk": "今野 (コンノ)",
          "ja": "咲いていることですし、頭に桜の花でも",
          "tc": "何不把櫻花裝飾在頭上，",
          "sc": "何不把樱花装饰在头上，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 167635,
          "spk": "今野 (コンノ)",
          "ja": "飾ってみるというのはどうですかァ？",
          "tc": "您看這樣如何～？",
          "sc": "您看这样如何～？"
        },
        {
          "f_idx": 26,
          "pidx_tc": 167648,
          "spk": "林 (リン)",
          "ja": "頭に花を咲かせろっていうの？",
          "tc": "你是要我把花插在頭上嗎？",
          "sc": "你是要我把花插在头上吗？"
        },
        {
          "f_idx": 27,
          "pidx_tc": 167655,
          "spk": "林 (リン)",
          "ja": "村の代表がそんな間抜けな格好",
          "tc": "身為村子的代表，",
          "sc": "身为村子的代表，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 167662,
          "spk": "林 (リン)",
          "ja": "できるわけないじゃない",
          "tc": "我怎麼可能打扮成那種蠢樣？",
          "sc": "我怎么可能打扮成那种蠢样？"
        },
        {
          "f_idx": 29,
          "pidx_tc": 167673,
          "spk": "林 (リン)",
          "ja": "まったくもう！",
          "tc": "真是夠了！",
          "sc": "真是够了！"
        },
        {
          "f_idx": 30,
          "pidx_tc": 167680,
          "spk": "林 (リン)",
          "ja": "からかわないでちょうだい",
          "tc": "別戲弄我好不好。",
          "sc": "别戏弄我好不好。"
        },
        {
          "f_idx": 32,
          "pidx_tc": 167700,
          "spk": "今野 (コンノ)",
          "ja": "しごく真面目にアドバイスした",
          "tc": "我可是掏心挖肺",
          "sc": "我可是掏心挖肺"
        },
        {
          "f_idx": 33,
          "pidx_tc": 167707,
          "spk": "今野 (コンノ)",
          "ja": "つもりなんですけどねェ……",
          "tc": "在給您建議的說……",
          "sc": "在给您建议的说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3303,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 167737,
          "spk": "六角 (ロッカク)",
          "ja": "今日の料理には",
          "tc": "今天的餐點裡啊，",
          "sc": "今天的餐点里啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 167744,
          "spk": "六角 (ロッカク)",
          "ja": "今朝いただいた山菜を使ってるっスよ！",
          "tc": "用了妳早上拿來的山菜喔！",
          "sc": "用了你早上拿来的山菜哟！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 167764,
          "spk": "驹子 (コマコ)",
          "ja": "とってもおいしいよ！",
          "tc": "超好吃的～！",
          "sc": "超好吃的～！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 167771,
          "spk": "驹子 (コマコ)",
          "ja": "いつもありがとうロッカクさん、",
          "tc": "六角叔，謝謝你總是做這麼好吃的料理給我們，",
          "sc": "六角叔，谢谢你总是做这么好吃的料理给我们，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 167778,
          "spk": "驹子 (コマコ)",
          "ja": "山菜が採れたら、また持ってくるね",
          "tc": "我下次採到山菜會再拿過來的。",
          "sc": "我下次采到山菜会再拿过来的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 167791,
          "spk": "六角 (ロッカク)",
          "ja": "そりゃ助かるっスねぇ",
          "tc": "那真是感謝啊，",
          "sc": "那真是感谢啊，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 167798,
          "spk": "六角 (ロッカク)",
          "ja": "材料なんてあればあるだけいいんスから",
          "tc": "畢竟食材這種東西當然是越多越好。",
          "sc": "毕竟食材这种东西当然是越多越好。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 167818,
          "spk": "驹子 (コマコ)",
          "ja": "今日持ってきた山菜は、",
          "tc": "話說今天拿過來的山菜，",
          "sc": "话说今天拿过来的山菜，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 167825,
