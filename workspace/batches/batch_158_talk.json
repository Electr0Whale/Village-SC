  "line_count": 198,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3301,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0028",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 171169,
          "spk": "四郎治 (シロージ)",
          "ja": "……おい",
          "tc": "……喂。",
          "sc": "……喂。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 171176,
          "spk": "四郎治 (シロージ)",
          "ja": "森に立ち入るつもりか？",
          "tc": "妳打算進森林裡嗎？",
          "sc": "你打算进森林里吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 171189,
          "spk": "帷 (トバリ)",
          "ja": "うん、ちょっとは",
          "tc": "嗯，我想說稍微進去一下，",
          "sc": "嗯，我想说稍微进去一下，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 171196,
          "spk": "帷 (トバリ)",
          "ja": "暑さも和らぐかもと思って",
          "tc": "說不定會涼快一點。",
          "sc": "说不定会凉快一点。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 171203,
          "spk": "帷 (トバリ)",
          "ja": "何か問題ある？",
          "tc": "有什麼問題嗎？",
          "sc": "有什么问题吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 171216,
          "spk": "四郎治 (シロージ)",
          "ja": "軽い気持ちで入ろうとしない方がいい",
          "tc": "最好不要抱著那種隨便的心態進去，",
          "sc": "最好不要抱着那种随便的心态进去，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171223,
          "spk": "四郎治 (シロージ)",
          "ja": "お前の存在が、森の生き物を",
          "tc": "光是妳進去這件事，",
          "sc": "光是你进去这件事，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171230,
          "spk": "四郎治 (シロージ)",
          "ja": "刺激することもあるからな",
          "tc": "就可能會刺激到森林裡的生物。",
          "sc": "就可能会刺激到森林里的生物。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 171241,
          "spk": "四郎治 (シロージ)",
          "ja": "無暗にテリトリーを侵さないこと……",
          "tc": "別隨意侵入牠們的領域……",
          "sc": "别随意侵入它们的领域……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171248,
          "spk": "四郎治 (シロージ)",
          "ja": "言うなれば、自然の「掟」だ",
          "tc": "這可以說是大自然的「規矩」。",
          "sc": "这可以说是大自然的“规矩”。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171261,
          "spk": "帷 (トバリ)",
          "ja": "……そう言うと",
          "tc": "……你覺得這樣跟我說，",
          "sc": "……你觉得这样跟我说，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 171268,
          "spk": "帷 (トバリ)",
          "ja": "私がひるむとでも思ったの？",
          "tc": "我就會覺得害怕嗎？",
          "sc": "我就会觉得害怕吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171279,
          "spk": "帷 (トバリ)",
          "ja": "掟上等",
          "tc": "有規矩正好，",
          "sc": "有规矩正好，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 171286,
          "spk": "帷 (トバリ)",
          "ja": "むしろ、こっちから破ってやる",
          "tc": "那就由我來打破。",
          "sc": "那就由我来打破。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 171299,
          "spk": "四郎治 (シロージ)",
          "ja": "お前には逆効果だったみたいだな……",
          "tc": "看來對妳而言是反效果呢……",
          "sc": "看来对你而言是反效果呢……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171310,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ、言い方を変えるぜ？",
          "tc": "那我換個說法好了。",
          "sc": "那我换个说法好了。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 171317,
          "spk": "四郎治 (シロージ)",
          "ja": "生き物には踏み入れてはならない",
          "tc": "對生物來說，",
          "sc": "对生物来说，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 171324,
          "spk": "四郎治 (シロージ)",
          "ja": "領域というものがあるんだよ",
          "tc": "自己的領域是不容許侵犯的空間。",
          "sc": "自己的领域是不容许侵犯的空间。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 171335,
          "spk": "四郎治 (シロージ)",
          "ja": "俺がお前のプライベートな空間に",
          "tc": "如果我大剌剌地闖入妳的私人空間，",
          "sc": "如果我大剌剌地闯入你的私人空间，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 171342,
          "spk": "四郎治 (シロージ)",
          "ja": "ズカズカ踏み入っても構わねえのか？",
          "tc": "妳也覺得無所謂嗎？",
          "sc": "你也觉得无所谓吗？"
        },
        {
          "f_idx": 20,
          "pidx_tc": 171355,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 171368,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が言いたいのは、そういうことだ",
          "tc": "我想說的就是這個。",
          "sc": "我想说的就是这个。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 171375,
          "spk": "四郎治 (シロージ)",
          "ja": "結局どうするか決めるのはお前だけどな",
          "tc": "不過最終要怎麼做，還是取決於妳。",
          "sc": "不过最终要怎么做，还是取决于你。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 171388,
          "spk": "帷 (トバリ)",
          "ja": "もうわかったって",
          "tc": "好啦，我知道了啦。",
          "sc": "好啦，我知道了啦。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 171395,
          "spk": "帷 (トバリ)",
          "ja": "どうしても入りたいワケじゃないし",
          "tc": "反正我也不是非進去不可，",
          "sc": "反正我也不是非进去不可，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 171402,
          "spk": "帷 (トバリ)",
          "ja": "今日は遠慮しておく",
          "tc": "今天就算了。",
          "sc": "今天就算了。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 171413,
          "spk": "帷 (トバリ)",
          "ja": "……せっかく、忠告してくれたんだし",
          "tc": "……畢竟你都特地給了我忠告。",
          "sc": "……毕竟你都特地给了我忠告。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3302,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0029",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 171441,
          "spk": "堇怜 (スミレ)",
          "ja": "ふぅ……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 171448,
          "spk": "堇怜 (スミレ)",
          "ja": "惜しいな",
          "tc": "真可惜。",
          "sc": "真可惜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 171461,
          "spk": "驹子 (コマコ)",
          "ja": "的の中心から少し下にズレちゃったね",
          "tc": "這次往靶心下方偏了一點呢。",
          "sc": "这次往靶心下方偏了一点呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 171468,
          "spk": "驹子 (コマコ)",
          "ja": "でも前より上手くなってると思うよ",
          "tc": "但我覺得已經比之前進步囉。",
          "sc": "但我觉得已经比之前进步多了呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 171481,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコの教え方が上手だからだよ",
          "tc": "這都是因為駒子很會教啊。",
          "sc": "这都是因为驹子很会教啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 171488,
          "spk": "堇怜 (スミレ)",
          "ja": "他に気をつけることはある？",
          "tc": "其他還有什麼要注意的嗎？",
          "sc": "其他还有什么要注意的吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171501,
          "spk": "驹子 (コマコ)",
          "ja": "背中で弓を引けるようになってきてるし",
          "tc": "你已經開始學會用背部的力量拉弓了，",
          "sc": "你已经开始学会用背部的力量拉弓了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171508,
          "spk": "驹子 (コマコ)",
          "ja": "その調子で練習すれば大丈夫",
          "tc": "照這樣繼續練習就沒問題了。",
          "sc": "照这样继续练习就没问题了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171526,
          "spk": "驹子 (コマコ)",
          "ja": "あとは、この時期だと汗かな",
          "tc": "還有就是，現在這個季節要注意汗水吧。",
          "sc": "还有就是，现在这个季节要注意汗水吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171539,
          "spk": "堇怜 (スミレ)",
          "ja": "汗？ 水分補給なら",
          "tc": "汗水？",
          "sc": "汗水？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 171546,
          "spk": "堇怜 (スミレ)",
          "ja": "しっかり取ってるよ？",
          "tc": "我有好好補充水分啊？",
          "sc": "我有好好补充水分啊？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171559,
          "spk": "驹子 (コマコ)",
          "ja": "ううん、そうじゃなくて",
          "tc": "不是那個意思，",
          "sc": "不是那个意思，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 171566,
          "spk": "驹子 (コマコ)",
          "ja": "さっき汗拭ってたでしょ？",
          "tc": "你剛剛有擦汗對吧？",
          "sc": "你刚刚有擦汗对吧？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 171577,
          "spk": "驹子 (コマコ)",
          "ja": "今は練習だから大丈夫だけど、",
          "tc": "現在是練習所以沒關係，",
          "sc": "现在是练习所以没关系，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171584,
          "spk": "驹子 (コマコ)",
          "ja": "もし森の中で獲物を狩る時は",
          "tc": "但如果在森林中狩獵的時候，",
          "sc": "但如果在森林中狩猎的时候，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 171591,
          "spk": "驹子 (コマコ)",
          "ja": "物音立てないように気をつけてね",
          "tc": "要留意別發出聲響喔！",
          "sc": "要留意别发出声响哦！"
        },
        {
          "f_idx": 17,
          "pidx_tc": 171604,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、なるほど！",
          "tc": "啊，原來如此！",
          "sc": "啊，原来如此！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 171611,
          "spk": "堇怜 (スミレ)",
          "ja": "茂みから狙うなら",
          "tc": "如果是躲在草叢裡瞄準獵物，",
          "sc": "如果是躲在草丛里瞄准猎物，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 171618,
          "spk": "堇怜 (スミレ)",
          "ja": "我慢しないといけないんだ",
          "tc": "就得忍住才行吧。",
          "sc": "就得忍住才行吧。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 171631,
          "spk": "驹子 (コマコ)",
          "ja": "そうそう",
          "tc": "沒錯，",
          "sc": "没错，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 171638,
          "spk": "驹子 (コマコ)",
          "ja": "他にも木が生い茂ってる場所とかね",
          "tc": "另外在樹木茂密的地方也一樣。",
          "sc": "另外在树木茂密的地方也一样。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 171649,
          "spk": "驹子 (コマコ)",
          "ja": "汗が気になるようなら、",
          "tc": "如果真的怕流汗的話，",
          "sc": "如果真的怕流汗的话，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 171656,
          "spk": "驹子 (コマコ)",
          "ja": "木の上に登って狙うのがおすすめだよ",
          "tc": "建議可以爬到樹上瞄準獵物喔！",
          "sc": "建议可以爬到树上瞄准猎物哦！"
        },
        {
          "f_idx": 24,
          "pidx_tc": 171669,
          "spk": "堇怜 (スミレ)",
          "ja": "へぇ……知らなかった",
          "tc": "哦……原來是這樣。",
          "sc": "哦……原来是这样。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 171676,
          "spk": "堇怜 (スミレ)",
          "ja": "まだまだ学ぶことが多いなぁ",
          "tc": "我還有很多要學的呢。",
          "sc": "我还有很多要学的呢。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 171683,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコはすごいね",
          "tc": "駒子好厲害喔！",
          "sc": "驹子好厉害哦！"
        },
        {
          "f_idx": 27,
          "pidx_tc": 171696,
          "spk": "驹子 (コマコ)",
          "ja": "え、えへへ……",
          "tc": "啊，嘿嘿……",
          "sc": "啊，嘿嘿……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 171703,
          "spk": "驹子 (コマコ)",
          "ja": "そんな大したことないと思うけど……",
          "tc": "我覺得這不算什麼啦……",
          "sc": "我觉得这不算什么啦……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 171710,
          "spk": "驹子 (コマコ)",
          "ja": "……ほら、そろそろ練習再開しよう",
          "tc": "……來，我們差不多該繼續練習了。",
          "sc": "……来，我们差不多该继续练习了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3303,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 171738,
          "spk": "木助 (キスケ)",
          "ja": "さぁて……休憩も済んだし",
          "tc": "好……也休息得差不多了，",
          "sc": "好……也休息得差不多了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 171745,
          "spk": "木助 (キスケ)",
          "ja": "もうひと働きするかァ",
          "tc": "再努力工作一下吧。",
          "sc": "再努力工作一下吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 171758,
          "spk": "莲实 (ハスミ)",
          "ja": "毎日、暑い中大変ですね……",
          "tc": "每天都在大熱天下工作，真辛苦呢……",
          "sc": "每天都在大热天下工作，真辛苦呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 171765,
          "spk": "莲实 (ハスミ)",
          "ja": "村のためにいつもありがとうございます",
          "tc": "謝謝你總是為了村子這般付出。",
          "sc": "谢谢你总是为了村子这般付出。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 171785,
          "spk": "木助 (キスケ)",
          "ja": "気にすんなって",
          "tc": "別放在心上啦。",
          "sc": "别放在心上啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 171792,
          "spk": "木助 (キスケ)",
          "ja": "もの作って渡すのが俺の仕事なんだからよ",
          "tc": "畢竟製作東西交出去，本來就是我的工作。",
          "sc": "毕竟制作东西交出去，本来就是我的工作。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 171803,
          "spk": "木助 (キスケ)",
          "ja": "それに、クソ暑い日の作業も",
          "tc": "況且，在熱得要命的日子裡工作，",
          "sc": "况且，在热得要命的日子里工作，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 171810,
          "spk": "木助 (キスケ)",
          "ja": "悪いことばかりじゃねぇぜ？",
          "tc": "也不是只有壞處喔！",
          "sc": "也不是只有坏处啊！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 171823,
          "spk": "莲实 (ハスミ)",
          "ja": "そうなんですか……？",
          "tc": "是這樣嗎……？",
          "sc": "是这样吗……？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 171830,
          "spk": "莲实 (ハスミ)",
          "ja": "意外な言葉ですね……",
          "tc": "你這麼說還真讓我意外……",
          "sc": "你这么说还真让我意外……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 171843,
          "spk": "木助 (キスケ)",
          "ja": "暑くて参っちまいそうになるが",
          "tc": "雖然會讓人熱到受不了，",
          "sc": "虽然会让人热到受不了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 171850,
          "spk": "木助 (キスケ)",
          "ja": "仕事終わりには、酒が待ってるからな",
          "tc": "但工作結束後，還有酒在等著啊。",
          "sc": "但工作结束后，还有酒在等着啊。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 171868,
          "spk": "木助 (キスケ)",
          "ja": "暑い日にキンキンに冷えた酒を呑む",
          "tc": "在大熱天來上一杯冰得透心涼的酒，",
          "sc": "在大热天来上一杯冰得透心凉的酒，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 171875,
          "spk": "木助 (キスケ)",
          "ja": "これほどの幸せ、他にねえからな！",
