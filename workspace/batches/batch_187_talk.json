        {
          "f_idx": 1,
          "pidx_tc": 246101,
          "spk": "木助 (キスケ)",
          "ja": "ため息なんかついてやがったか",
          "tc": "唉聲嘆氣的啊。",
          "sc": "唉声叹气的啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 246114,
          "spk": "名护 (ナゴ)",
          "ja": "……キスケさん",
          "tc": "……木助先生。",
          "sc": "……木助先生。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 246127,
          "spk": "木助 (キスケ)",
          "ja": "毎日暇してんじゃねえかと思ってよ、",
          "tc": "我想說你可能每天都很閒，",
          "sc": "我想说你可能每天都很闲，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 246134,
          "spk": "木助 (キスケ)",
          "ja": "ちょうどいい仕事があるから、",
          "tc": "剛好有個適合你的工作，",
          "sc": "刚好有个适合你的工作，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 246141,
          "spk": "木助 (キスケ)",
          "ja": "頼みに来たんだぜ",
          "tc": "打算拜託你去做。",
          "sc": "打算拜托你去做。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 246154,
          "spk": "名护 (ナゴ)",
          "ja": "俺は別に暇じゃない",
          "tc": "我一點都不閒。",
          "sc": "我一点都不闲。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 246165,
          "spk": "名护 (ナゴ)",
          "ja": "毎日毎日、怒ってるはずの彼女と上司への報告、",
          "tc": "我每天都在想要怎麼面對生氣的女友，",
          "sc": "我每天都在想要怎么面对生气的女友，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 246172,
          "spk": "名护 (ナゴ)",
          "ja": "それに払ってない家賃のことまで……",
          "tc": "怎麼向上司報告，還有未繳的房租……",
          "sc": "怎么向上司报告，还有未缴的房租……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 246179,
          "spk": "名护 (ナゴ)",
          "ja": "あちこちへの言い訳を考えるので手一杯だ",
          "tc": "光是要想一大堆的藉口就忙不過來了。",
          "sc": "光是要想一大堆的借口就忙不过来了。"
        },
