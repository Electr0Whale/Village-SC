      "rec_id": "TALK_ID_10_0301_013_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246276,
          "spk": "名护 (ナゴ)",
          "ja": "なんだよここは……",
          "tc": "這是什麼地方……？",
          "sc": "这是什么地方……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246291,
          "spk": "木助 (キスケ)",
          "ja": "昔から、俺の家が管理してる図書館だ",
          "tc": "這裡是圖書館，以前是由我家負責管理。",
          "sc": "这里是图书馆，以前是由我家负责管理。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 246298,
          "spk": "木助 (キスケ)",
          "ja": "しばらく使ってなかったんだがな……",
          "tc": "但已經有一段時間沒有使用了……",
          "sc": "但已经有一段时间没有使用了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4249,
      "rec_id": "TALK_ID_10_0301_013_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246323,
          "spk": "木助 (キスケ)",
          "ja": "この村には、",
          "tc": "這個村子",
          "sc": "这个村子"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246330,
          "spk": "木助 (キスケ)",
          "ja": "無駄に長い歴史があんだよ",
          "tc": "有一段冗長的歷史。",
          "sc": "有一段冗长的历史。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 246341,
          "spk": "木助 (キスケ)",
          "ja": "これまでの歴史の中で、村から",
          "tc": "而在這麼長的歷史當中，",
          "sc": "而在这么长的历史当中，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 246348,
          "spk": "木助 (キスケ)",
          "ja": "出られた人が、全くいなかったわけじゃない",
          "tc": "並非沒有完全沒有人離開這個村子。",
          "sc": "并非没有完全没有人离开这个村子。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 246355,
          "spk": "木助 (キスケ)",
          "ja": "ただ今は、誰もその方法を知らないだけなんだ",
          "tc": "只是如今已經沒人知道那個方法而已。",
          "sc": "只是如今已经没人知道那个方法而已。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4250,
      "rec_id": "TALK_ID_10_0301_013_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246373,
          "spk": "木助 (キスケ)",
          "ja": "この図書館には村の伝承や昔話が",
          "tc": "這座圖書館裡藏著",
          "sc": "这座图书馆里藏着"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246380,
          "spk": "木助 (キスケ)",
          "ja": "書かれた本が眠ってる",
          "tc": "記載了村子的傳說與故事的書。",
          "sc": "记载了村子的传说与故事的书。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 246398,
          "spk": "木助 (キスケ)",
          "ja": "それらを読み解けば、",
          "tc": "只要解讀那些書，",
