      "rec_id": "TALK_ID_10_0301_013_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246002,
          "spk": "名护 (ナゴ)",
          "ja": "今日もこの村を散策してるところ？",
          "tc": "你今天也在村子裡四處散步嗎？",
          "sc": "你今天也在村子里四处散步吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246009,
          "spk": "名护 (ナゴ)",
          "ja": "キミは相変わらず忙しそうだね……",
          "tc": "你還是老樣子，看起來很忙啊……",
          "sc": "你还是老样子，看起来很忙啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 246027,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、今日も無駄に",
          "tc": "我今天也是白費功夫地",
          "sc": "我今天也是白费功夫地"
        },
        {
          "f_idx": 4,
          "pidx_tc": 246034,
          "spk": "名护 (ナゴ)",
          "ja": "峠を歩き回ってきたところだ",
          "tc": "在隘口來來回回而已。",
          "sc": "在隘口来来回回而已。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 246045,
          "spk": "名护 (ナゴ)",
          "ja": "もう何度目の挑戦だろうな……",
          "tc": "都記不清挑戰過多少次了……",
          "sc": "都记不清挑战过多少次了……"
        },
