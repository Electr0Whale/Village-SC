          "ja": "あら、<player>さん",
          "tc": "哎呀，<player>，",
          "sc": "哎呀，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243579,
          "spk": "莲实 (ハスミ)",
          "ja": "これは……リンが言っていた",
          "tc": "這是……林說過，",
          "sc": "这是……林说过，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243586,
          "spk": "莲实 (ハスミ)",
          "ja": "気付け薬のための、酸っぱい樹液ですね？",
          "tc": "用來製作回神藥的酸酸的樹液，對吧？",
          "sc": "用来制作回神药的酸酸的树液，对吧？"
