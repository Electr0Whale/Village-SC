          "pidx_tc": 246052,
          "spk": "名护 (ナゴ)",
          "ja": "さすがに疲れたよ",
          "tc": "我也實在是累了。",
          "sc": "我也实在是累了。"
        }
      ]
    },
    {
      "file": "talk.dat",
