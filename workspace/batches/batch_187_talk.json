      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243486,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、<player>さん",
          "tc": "哎呀，<player>，",
          "sc": "哎呀，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243493,
          "spk": "莲实 (ハスミ)",
          "ja": "これは……リンが言っていた",
          "tc": "這是……林說過，",
          "sc": "这是……林说过，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243500,
          "spk": "莲实 (ハスミ)",
          "ja": "気付け薬のための、酸っぱい樹液ですね？",
          "tc": "用來製作回神藥的酸酸的樹液，對吧？",
          "sc": "用来制作回神药的酸酸的树液，对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 243511,
          "spk": "莲实 (ハスミ)",
          "ja": "申し訳ないのですが、気付け薬を作るには",
          "tc": "不好意思，但要製作回神藥，",
          "sc": "不好意思，但要制作回神药，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 243518,
          "spk": "莲实 (ハスミ)",
          "ja": "酸っぱい樹液が２個必要なんです",
          "tc": "需要兩份酸酸的樹液。",
          "sc": "需要两份酸酸的树液。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 243534,
          "spk": "莲实 (ハスミ)",
          "ja": "お手数をおかけしますが、",
          "tc": "給你添麻煩了，",
          "sc": "给你添麻烦了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 243541,
          "spk": "莲实 (ハスミ)",
          "ja": "２個集めて持ってきてくださいますか？",
          "tc": "但可以請你收集兩份過來嗎？",
          "sc": "但可以请你收集两份过来吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
