          "f_idx": 10,
          "pidx_tc": 246192,
          "spk": "木助 (キスケ)",
          "ja": "そんな心配する前に、",
          "tc": "在擔心那種事之前，",
          "sc": "在担心那种事之前，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 246199,
          "spk": "木助 (キスケ)",
          "ja": "まずは村から出ることだろ？",
          "tc": "能離開這村子再說吧。",
          "sc": "能离开这村子再说吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 246210,
          "spk": "木助 (キスケ)",
          "ja": "そんなてめぇに、ちょうど良い仕事だぜ",
          "tc": "剛好有份工作，你最適合來做了。",
          "sc": "刚好有份工作，你最适合来做了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 246217,
          "spk": "木助 (キスケ)",
          "ja": "ついて来な",
          "tc": "跟我來吧。",
          "sc": "跟我来吧。"
        }
      ]
    },
