    {
      "file": "talk.dat",
      "rec_idx": 4221,
      "rec_id": "TALK_ID_10_0301_009_62",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243631,
          "spk": "莲实 (ハスミ)",
          "ja": "それにしてもリンったら……",
          "tc": "不過林也真是的……",
          "sc": "不过林也真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243638,
          "spk": "莲实 (ハスミ)",
          "ja": "わざわざ、<player>さんに頼まなくても",
          "tc": "其實不用特地麻煩<player>，",
          "sc": "其实不用特地麻烦<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243645,
          "spk": "莲实 (ハスミ)",
          "ja": "言われれば私が用意したのに……",
          "tc": "只要跟我說一聲，我就能準備……",
          "sc": "只要跟我说一声，我就能准备……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4222,
      "rec_id": "TALK_ID_10_0301_009_63",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 243663,
          "spk": "莲实 (ハスミ)",
          "ja": "もしかして、<player>さん",
          "tc": "難道說，<player>，",
          "sc": "难道说，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 243670,
          "spk": "莲实 (ハスミ)",
          "ja": "リンを怒らせるようなコトをしましたね？",
          "tc": "你又惹林生氣了嗎？",
          "sc": "你又惹林生气了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 243677,
          "spk": "莲实 (ハスミ)",
          "ja": "まさか、また掟を破ったとか……？",
          "tc": "該不會又打破規矩了吧……？",
          "sc": "该不会又打破规矩了吧……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 243688,
          "spk": "莲实 (ハスミ)",
          "ja": "前にも言ったかと思いますが、",
          "tc": "先前也跟你說過，",
          "sc": "先前也跟你说过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 243695,
          "spk": "莲实 (ハスミ)",
          "ja": "掟は私たちの暮らしを、守るためにあるのです",
          "tc": "規矩是為了保護我們的生活而存在的。",
          "sc": "规矩是为了保护我们的生活而存在的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 243706,
          "spk": "莲实 (ハスミ)",
          "ja": "説教がましくてすみません……",
          "tc": "或許有點像是說教……",
          "sc": "或许有点像是说教……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 243713,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、あなたの身の安全のためにも、",
          "tc": "但就算是為了你自身安全著想，",
          "sc": "但就算是为了你自身安全着想，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 243720,
          "spk": "莲实 (ハスミ)",
          "ja": "あまり不用意な行動は控えてくださいね",
          "tc": "還是請你盡量避免衝動的行為喔。",
          "sc": "还是请你尽量避免冲动的行为哦。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 243731,
          "spk": "莲实 (ハスミ)",
          "ja": "酸っぱい樹液、ありがとうございます",
          "tc": "謝謝你帶來酸酸的樹液。",
          "sc": "谢谢你带来酸酸的树液。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 243738,
          "spk": "莲实 (ハスミ)",
          "ja": "これでナゴさんを",
          "tc": "有了這個，我想應該就能",
          "sc": "有了这个，我想应该就能"
        },
        {
          "f_idx": 10,
          "pidx_tc": 243745,
          "spk": "莲实 (ハスミ)",
          "ja": "起こすことができると思います",
          "tc": "喚醒名護先生了。",
          "sc": "唤醒名护先生了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 243756,
          "spk": "莲实 (ハスミ)",
          "ja": "それでは……",
          "tc": "我就先失陪了……",
          "sc": "我就先失陪了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4223,
      "rec_id": "TALK_ID_10_0301_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 244993,
          "spk": "帷 (トバリ)",
          "ja": "あんなに惑わされるなって注意したのに",
          "tc": "我明明再三警告過不能被迷惑的。",
          "sc": "我明明再三警告过不能被迷惑的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245000,
          "spk": "帷 (トバリ)",
          "ja": "……役立たずね",
          "tc": "……真沒用。",
          "sc": "……真没用。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4224,
      "rec_id": "TALK_ID_10_0301_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245027,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……あの男のせいで",
          "tc": "唉……都是那男人的錯……",
          "sc": "唉……都是那男人的错……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245034,
          "spk": "帷 (トバリ)",
          "ja": "……期待していた私が、",
          "tc": "……或許抱持著期待的我，",
          "sc": "……或许抱持着期待的我，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 245041,
          "spk": "帷 (トバリ)",
          "ja": "馬鹿だったのかもしれない",
          "tc": "才是最笨的那一個。",
          "sc": "才是最笨的那一个。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4225,
      "rec_id": "TALK_ID_10_0301_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245059,
          "spk": "帷 (トバリ)",
          "ja": "……やっぱり、",
          "tc": "……果然還是",
          "sc": "……果然还是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245066,
          "spk": "帷 (トバリ)",
          "ja": "他人に頼ったりなんか",
          "tc": "不該依靠",
          "sc": "不该依靠"
        },
        {
          "f_idx": 2,
          "pidx_tc": 245073,
          "spk": "帷 (トバリ)",
          "ja": "すべきじゃなかったわ",
          "tc": "其他人。",
          "sc": "其他人。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4226,
      "rec_id": "TALK_ID_10_0301_011_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245093,
          "spk": "林 (リン)",
          "ja": "まったく！",
          "tc": "真是的！",
          "sc": "真是的！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245100,
          "spk": "林 (リン)",
          "ja": "何度言わせれば気が済むの！？",
          "tc": "到底要我說多少次！？",
          "sc": "到底要我说多少次！？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4227,
      "rec_id": "TALK_ID_10_0301_011_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245122,
          "spk": "林 (リン)",
          "ja": "掟っていうのは守るものなのよ！",
          "tc": "規矩是用來遵守的！",
          "sc": "规矩是用来遵守的！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245129,
          "spk": "林 (リン)",
          "ja": "あなたがいた養護施設にだって、",
          "tc": "就算是妳以前待的育幼院，",
          "sc": "就算是你以前待的育幼院，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 245136,
          "spk": "林 (リン)",
          "ja": "ルールはあったでしょう！？",
          "tc": "應該也有那裡該遵守的規矩吧！？",
          "sc": "应该也有那里该遵守的规矩吧！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 245149,
          "spk": "帷 (トバリ)",
          "ja": "だったら、掟の意味を教えてくれない？",
          "tc": "那妳可以告訴我那些規矩的意義嗎？",
          "sc": "那你可以告诉我那些规矩的意义吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 245156,
          "spk": "帷 (トバリ)",
          "ja": "意味のあるルールなら守るかもね",
          "tc": "如果是有意義的規矩，我或許願意遵守。",
          "sc": "如果是有意义的规矩，我或许愿意遵守。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 245176,
          "spk": "林 (リン)",
          "ja": "ゲームにルールがあるのに意味がいるかしら？",
          "tc": "遊戲有規則，這也需要意義嗎？",
          "sc": "游戏有规则，这也需要意义吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 245183,
          "spk": "林 (リン)",
          "ja": "「トランプは52枚で」ってルール、",
          "tc": "「撲克牌有52張」這條規則，",
          "sc": "“扑克牌有52张”这条规则，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 245190,
          "spk": "林 (リン)",
          "ja": "いちいち理由考えたりしないでしょう？",
          "tc": "妳也不會去深究它有什麼意義吧？",
          "sc": "你也不会去深究它有什么意义吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 245203,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ説明してよ",
          "tc": "那妳解釋看看嘛。",
          "sc": "那你解释看看嘛。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 245210,
          "spk": "帷 (トバリ)",
          "ja": "どうして、こんなホコリまみれの風習を",
          "tc": "這種陳舊的風俗習慣",
          "sc": "这种陈旧的风俗习惯"
        },
        {
          "f_idx": 11,
          "pidx_tc": 245217,
          "spk": "帷 (トバリ)",
          "ja": "守る必要があるの？",
          "tc": "為什麼有遵守的必要？",
          "sc": "为什么有遵守的必要？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 245230,
          "spk": "林 (リン)",
          "ja": "あなたも夜に出歩いて、",
          "tc": "妳晚上外出的時候，",
          "sc": "你晚上外出的时候，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 245237,
          "spk": "林 (リン)",
          "ja": "恐ろしい目にあっているでしょ！？",
          "tc": "不都遇上可怕的事情了嗎！？",
          "sc": "不都遇上可怕的事情了吗！？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 245244,
          "spk": "林 (リン)",
          "ja": "掟はそういう危険から身を守るためのものよ！",
          "tc": "規矩就是用來保護我們遠離那些危險事物的！",
          "sc": "规矩就是用来保护我们远离那些危险事物的！"
        },
        {
          "f_idx": 15,
          "pidx_tc": 245257,
          "spk": "帷 (トバリ)",
          "ja": "むしろ、掟のせいでもっと恐ろしい目に",
          "tc": "那可不見得，我覺得反而是規矩害我",
          "sc": "那可不见得，我觉得反而是规矩害我"
        },
        {
          "f_idx": 16,
          "pidx_tc": 245264,
          "spk": "帷 (トバリ)",
          "ja": "あってるんだけど",
          "tc": "遭遇到更加可怕的事情才對。",
          "sc": "遭遇到更加可怕的事情才对。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 245277,
          "spk": "帷 (トバリ)",
          "ja": "アンタが掟に隠してる秘密、",
          "tc": "總有一天，我絕對會揭穿",
          "sc": "总有一天，我绝对会揭穿"
        },
        {
          "f_idx": 18,
          "pidx_tc": 245284,
          "spk": "帷 (トバリ)",
          "ja": "いつか絶対、暴いてやるから……",
          "tc": "妳隱藏在規矩之下的祕密……",
          "sc": "你隐藏在规矩之下的秘密……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4228,
      "rec_id": "TALK_ID_10_0301_011_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245309,
          "spk": "林 (リン)",
          "ja": "秘密を暴くですって！？",
          "tc": "妳說要揭露祕密！？",
          "sc": "你说要揭露秘密！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245316,
          "spk": "林 (リン)",
          "ja": "それも掟にするなと書いてあるでしょ！",
          "tc": "規矩不就寫了不可以那麼做了嗎！？",
          "sc": "规矩不就写了不可以那么做了吗！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 245334,
          "spk": "林 (リン)",
          "ja": "なに？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 245341,
          "spk": "林 (リン)",
          "ja": "掟を一つずつ破って、",
          "tc": "妳是打算一一打破規矩，",
          "sc": "你是打算一一打破规矩，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 245348,
          "spk": "林 (リン)",
          "ja": "何が起きるか試してるわけ！？",
          "tc": "試試看到底會發生什麼事嗎！？",
          "sc": "试试看到底会发生什么事吗！？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 245361,
          "spk": "帷 (トバリ)",
          "ja": "アンタ自身だって",
          "tc": "明明妳自己",
          "sc": "明明你自己"
        },
        {
          "f_idx": 7,
          "pidx_tc": 245368,
          "spk": "帷 (トバリ)",
          "ja": "たまに掟を破っているくせに",
          "tc": "有時也會打破規矩。",
          "sc": "有时也会打破规矩。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 245381,
          "spk": "林 (リン)",
          "ja": "私は……！！",
          "tc": "我是因為……！！",
          "sc": "我是因为……！！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 245392,
          "spk": "林 (リン)",
          "ja": "…………ッ！",
          "tc": "………嘖！",
          "sc": "……啧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4229,
      "rec_id": "TALK_ID_10_0301_011_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 245412,
          "spk": "林 (リン)",
          "ja": "……そう、そんなに",
          "tc": "……這樣啊，",
          "sc": "……这样啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 245419,
          "spk": "林 (リン)",
          "ja": "怖い目にあうのが好きなのね……",
          "tc": "妳就這麼喜歡遭遇那些可怕的事啊……",
          "sc": "你就这么喜欢遭遇那些可怕的事啊……"
