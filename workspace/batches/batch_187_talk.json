        },
        {
          "f_idx": 4,
          "pidx_tc": 250971,
          "spk": "帷 (トバリ)",
          "ja": "<strong>「あの事件から十年目」の年らしいから……</strong>",
          "tc": "<strong>「那起事件後的第十年」……</strong>",
          "sc": "<strong>“那起事件后的第十年”……</strong>"
