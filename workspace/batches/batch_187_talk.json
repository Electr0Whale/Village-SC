          "pidx_tc": 251534,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの断れない意志の弱さを、",
          "tc": "別把妳這種無法拒絕人的軟弱意志，",
          "sc": "别把你这种无法拒绝人的软弱意志，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 251541,
          "spk": "木助 (キスケ)",
          "ja": "アイツにも背負わせるんじゃねえ",
          "tc": "強加在那傢伙身上！",
          "sc": "强加在那家伙身上！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 251552,
          "spk": "驹子 (コマコ)",
          "ja": "そ……そうだけど……",
          "tc": "是……是這樣沒錯……",
          "sc": "是……是这样没错……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 251559,
          "spk": "驹子 (コマコ)",
          "ja": "これは……",
          "tc": "可是這是……",
          "sc": "可是这是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4364,
      "rec_id": "TALK_ID_10_0302_029_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251581,
          "spk": "帷 (トバリ)",
          "ja": "<player>を巻き込んだのは私よ",
          "tc": "把<player>捲進來的人是我。",
          "sc": "把<player>卷进来的人是我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4365,
      "rec_id": "TALK_ID_10_0302_029_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251612,
          "spk": "帷 (トバリ)",
          "ja": "コマコを責めるのはやめて",
          "tc": "不要責備駒子。",
          "sc": "不要责备驹子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4366,
      "rec_id": "TALK_ID_10_0302_029_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251632,
          "spk": "木助 (キスケ)",
          "ja": "ああ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251639,
          "spk": "木助 (キスケ)",
          "ja": "じゃあてめぇにも言ってやる",
          "tc": "那我就對妳也說一遍。",
          "sc": "那我就对你也说一遍。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251648,
          "spk": "木助 (キスケ)",
          "ja": "他人の頼み事に、",
          "tc": "不要把其他人拜託妳們的事，",
          "sc": "不要把其他人拜托你们的事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 251655,
          "spk": "木助 (キスケ)",
          "ja": "アイツを巻き込んでやるなよ",
          "tc": "波及到那傢伙身上！",
          "sc": "波及到那家伙身上！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 251668,
          "spk": "帷 (トバリ)",
          "ja": "掟……村人の頼み事は、",
          "tc": "規矩……村民的委託，",
          "sc": "规矩……村民的委托，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 251675,
          "spk": "帷 (トバリ)",
          "ja": "必ず聞いて協力しろ、でしょう？",
          "tc": "一定得去幫忙，沒錯吧？",
          "sc": "一定得去帮忙，没错吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 251693,
          "spk": "帷 (トバリ)",
          "ja": "この村の変な風習を作っているのは",
          "tc": "在村子裡立下奇怪習俗的，",
          "sc": "在村子里立下奇怪习俗的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 251700,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちじゃない",
          "tc": "不就是你們自己嗎？",
          "sc": "不就是你们自己吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 251713,
          "spk": "木助 (キスケ)",
          "ja": "言い訳の時だけ、",
          "tc": "別只在為自己找藉口的時候",
          "sc": "别只在为自己找借口的时候"
        },
        {
          "f_idx": 10,
          "pidx_tc": 251720,
          "spk": "木助 (キスケ)",
          "ja": "良いように掟を持ち出すんじゃねえ",
          "tc": "才搬出規矩來方便說話。",
          "sc": "才搬出规矩来方便说话。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 251731,
          "spk": "木助 (キスケ)",
          "ja": "俺が言いたいのは、",
          "tc": "我要說的是，",
          "sc": "我要说的是，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 251738,
          "spk": "木助 (キスケ)",
          "ja": "本心もないのに、人の言うことを",
          "tc": "明明不是出自真心，",
          "sc": "明明不是出自真心，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 251745,
          "spk": "木助 (キスケ)",
          "ja": "聞くなってことだよ",
          "tc": "就別照著別人說的話去做。",
          "sc": "就别照着别人说的话去做。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 251758,
          "spk": "帷 (トバリ)",
          "ja": "でも……協力することで、",
          "tc": "不過……在幫助別人的過程中，",
          "sc": "不过……在帮助别人的过程中，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 251765,
          "spk": "帷 (トバリ)",
          "ja": "目的に近づいていくのは気分がいいわ",
          "tc": "慢慢達成目的的感覺還真不錯。",
          "sc": "慢慢达成目的的感觉还真不错。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 251776,
          "spk": "帷 (トバリ)",
          "ja": "見てなさい、こうして少しずつ、",
          "tc": "等著瞧吧，我會像這樣",
          "sc": "等着瞧吧，我会像这样"
        },
        {
          "f_idx": 17,
          "pidx_tc": 251783,
          "spk": "帷 (トバリ)",
          "ja": "この村の……アンタたちが隠してる",
          "tc": "一點一點地……把你們",
          "sc": "一点一点地……把你们"
        },
        {
          "f_idx": 18,
          "pidx_tc": 251790,
          "spk": "帷 (トバリ)",
          "ja": "秘密を暴いてやるんだから",
          "tc": "隱藏在村子裡的祕密揭露出來。",
          "sc": "隐藏在村子里的秘密揭露出来。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 251803,
          "spk": "木助 (キスケ)",
          "ja": "ほう……やっぱり",
          "tc": "哦……果然啊，",
          "sc": "哦……果然啊，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 251810,
          "spk": "木助 (キスケ)",
          "ja": "それがてめぇの目的かよ",
          "tc": "那才是妳的目的啊。",
          "sc": "那才是你的目的啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4367,
      "rec_id": "TALK_ID_10_0302_029_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251828,
          "spk": "帷 (トバリ)",
          "ja": "行くよ、コマコ",
          "tc": "我們走，駒子。",
          "sc": "我们走，驹子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251841,
          "spk": "驹子 (コマコ)",
          "ja": "え……でも……",
          "tc": "咦……可是……",
          "sc": "咦……可是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251854,
          "spk": "帷 (トバリ)",
          "ja": "コマコ、私とこの男",
          "tc": "駒子，我跟這男人，",
          "sc": "驹子，我跟这男人，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 251861,
          "spk": "帷 (トバリ)",
          "ja": "どちらの味方をするつもりなの？",
          "tc": "妳到底想站在那一邊？",
          "sc": "你到底想站在那一边？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 251874,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん、ごめん",
          "tc": "呃、嗯，抱歉。",
          "sc": "呃、嗯，抱歉。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 251887,
          "spk": "帷 (トバリ)",
          "ja": "行くよ",
          "tc": "走了。",
          "sc": "走了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4368,
      "rec_id": "TALK_ID_10_0302_029_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251911,
          "spk": "木助 (キスケ)",
          "ja": "おい！",
          "tc": "喂！",
          "sc": "喂！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251918,
          "spk": "木助 (キスケ)",
          "ja": "秘密を探るのはいいが、",
          "tc": "要調查祕密是妳的事，",
          "sc": "要调查秘密是你的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251925,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもコマコを巻き込むなよ！",
          "tc": "但不要把駒子也捲進去了！",
          "sc": "但不要把驹子也卷进去了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4369,
      "rec_id": "TALK_ID_10_0302_029_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251949,
          "spk": "木助 (キスケ)",
          "ja": "……全く",
          "tc": "……真是的，",
          "sc": "……真是的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 251956,
          "spk": "木助 (キスケ)",
          "ja": "どいつもこいつも言われるがまま……",
          "tc": "嘖，每個傢伙都只會聽他人的話行動……",
          "sc": "啧，每个家伙都只会听他人的话行动……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 251963,
          "spk": "木助 (キスケ)",
          "ja": "自分の意思はねえのかよ……",
          "tc": "就沒一點自己的想法嗎？",
          "sc": "就没一点自己的想法吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4370,
      "rec_id": "TALK_ID_10_0302_029_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251981,
          "spk": "木助 (キスケ)",
          "ja": "おい、最初から聞いてたんだろ",
          "tc": "喂，你從一開始就在聽吧。",
          "sc": "喂，你从一开始就在听吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4371,
      "rec_id": "TALK_ID_10_0302_029_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252006,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも、嫌だったら",
          "tc": "你也一樣，要是不願意，",
          "sc": "你也一样，要是不愿意，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252013,
          "spk": "木助 (キスケ)",
          "ja": "嫌ってハッキリ言え",
          "tc": "就明白地說出不願意。",
          "sc": "就明白地说出不愿意。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252024,
          "spk": "木助 (キスケ)",
          "ja": "……てめぇにとっては難しいかもしれんが、",
          "tc": "……這對你來說或許很難，",
          "sc": "……这对你来说或许很难，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252031,
          "spk": "木助 (キスケ)",
          "ja": "命令に逆らう手段を覚えるべきだ",
          "tc": "但你該學會違抗命令的方法。",
          "sc": "但你该学会违抗命令的方法。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 252049,
          "spk": "木助 (キスケ)",
          "ja": "じゃないと、いつか",
          "tc": "不然總有一天，",
          "sc": "不然总有一天，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 252056,
          "spk": "木助 (キスケ)",
          "ja": "とんでもねえことに巻き込まれちまうぞ",
          "tc": "你會被捲進不得了的事情。",
          "sc": "你会被卷进不得了的事情。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 252065,
          "spk": "木助 (キスケ)",
          "ja": "命令に従ってるだけじゃ",
          "tc": "如果只會服從命令，",
          "sc": "如果只会服从命令，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 252072,
          "spk": "木助 (キスケ)",
          "ja": "それは「生きる」んじゃなくて、",
          "tc": "那不叫「活著」，",
          "sc": "那不叫“活着”，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 252079,
          "spk": "木助 (キスケ)",
          "ja": "「操られてる」って言うんだ",
          "tc": "而是「被操縱」。",
          "sc": "而是“被操纵”。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 252090,
          "spk": "木助 (キスケ)",
          "ja": "本当の自由を得たいなら、忘れんな",
          "tc": "想獲得真正的自由，就別忘了這一點。",
          "sc": "想获得真正的自由，就别忘了这一点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4372,
      "rec_id": "TALK_ID_10_0302_030_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252121,
          "spk": "名护 (ナゴ)",
          "ja": "おや……<player>さん",
          "tc": "哦……<player>，",
          "sc": "哦……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252128,
          "spk": "名护 (ナゴ)",
          "ja": "持っているそれはもしかして……",
          "tc": "你拿著的該不會是……",
          "sc": "你拿着的该不会是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252135,
          "spk": "名护 (ナゴ)",
          "ja": "この図書館の本……？",
          "tc": "這座圖書館的書……？",
          "sc": "这座图书馆的书……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252148,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252155,
          "spk": "名护 (ナゴ)",
          "ja": "早速見つけてくれたんだね",
          "tc": "這麼快就找來了啊。",
          "sc": "这么快就找来了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4373,
      "rec_id": "TALK_ID_10_0302_030_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252173,
          "spk": "名护 (ナゴ)",
          "ja": "ほら、あそこの棚……",
          "tc": "你看，那邊的書架……",
          "sc": "你看，那边的书架……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252180,
          "spk": "名护 (ナゴ)",
          "ja": "本が抜けているのが見えるだろう？",
          "tc": "看得出來有空著的地方吧？",
          "sc": "看得出来有空着的地方吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252193,
          "spk": "名护 (ナゴ)",
          "ja": "きっとこれは、この図書館から",
          "tc": "這本書一定就是",
          "sc": "这本书一定就是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252200,
          "spk": "名护 (ナゴ)",
          "ja": "持ち出されたものだろう",
          "tc": "從圖書館被帶出去的。",
          "sc": "从图书馆被带出去的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4374,
      "rec_id": "TALK_ID_10_0302_030_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252218,
          "spk": "名护 (ナゴ)",
          "ja": "とにかく、助かったよ",
          "tc": "總之，謝謝你了。",
          "sc": "总之，谢谢你了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252225,
          "spk": "名护 (ナゴ)",
          "ja": "この本にトバリさんの言う伝承が",
          "tc": "希望這本書裡有寫到",
          "sc": "希望这本书里有写到"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252232,
          "spk": "名护 (ナゴ)",
          "ja": "書いてあるといいんだが……",
          "tc": "帷小姐所說的那個傳說啊……",
          "sc": "帷小姐所说的那个传说啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 252245,
          "spk": "名护 (ナゴ)",
          "ja": "とりあえず今晩、読んでみることにするよ",
          "tc": "總之我今晚會先讀一讀。",
          "sc": "总之我今晚会先读一读。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 252252,
          "spk": "名护 (ナゴ)",
          "ja": "トバリさんが探している記述があれば、",
          "tc": "如果上面有帷小姐在找的記載，",
          "sc": "如果上面有帷小姐在找的记载，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 252259,
          "spk": "名护 (ナゴ)",
          "ja": "すぐに連絡してあげよう",
          "tc": "我會馬上聯絡你們。",
          "sc": "我会马上联络你们。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4375,
      "rec_id": "TALK_ID_10_0302_030_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252279,
          "spk": "主角心声/旁白/选项",
          "ja": "ナゴに本を渡した",
          "tc": "將書交給了名護。",
          "sc": "将书交给了名护。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4376,
      "rec_id": "TALK_ID_10_0302_030_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 252299,
          "spk": "名护 (ナゴ)",
          "ja": "今後も本を見つけたら、",
          "tc": "要是你之後還有找到書，",
          "sc": "要是你之后还有找到书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 252306,
          "spk": "名护 (ナゴ)",
          "ja": "ここに持ってきてくれ",
          "tc": "請帶來這裡給我。",
          "sc": "请带来这里给我。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 252319,
