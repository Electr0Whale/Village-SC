          "sc": "有关的线索。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 246425,
          "spk": "名护 (ナゴ)",
          "ja": "本当か！？",
          "tc": "是真的嗎！？",
          "sc": "是真的吗！？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 246432,
          "spk": "名护 (ナゴ)",
          "ja": "たしかに、この村から誰も出られたことが",
          "tc": "的確啊，畢竟不可能",
          "sc": "的确啊，毕竟不可能"
        },
        {
          "f_idx": 8,
          "pidx_tc": 246439,
          "spk": "名护 (ナゴ)",
          "ja": "ないはずがないもんな",
          "tc": "從來都沒人離開過這村子嘛。",
          "sc": "从来都没人离开过这村子嘛。"
        }
      ]
    },
    {
