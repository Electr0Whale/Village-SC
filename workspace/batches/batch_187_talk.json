        },
        {
          "f_idx": 5,
          "pidx_tc": 251064,
          "spk": "名护 (ナゴ)",
          "ja": "まさかそんな原因だったというのか……！?",
          "tc": "但沒想到原因居然是這個……！？",
          "sc": "但没想到原因居然是这个……！？"
        }
      ]
    },
    {
