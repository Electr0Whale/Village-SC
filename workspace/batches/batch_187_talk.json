      "rec_id": "TALK_ID_10_0301_013_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246693,
          "spk": "名护 (ナゴ)",
          "ja": "ちょっとどころの話じゃないだろ！",
          "tc": "這才不是有點！",
          "sc": "这才不是有点！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246700,
          "spk": "名护 (ナゴ)",
          "ja": "埃は積もり放題で、本は床に散乱している！",
          "tc": "到處都積滿了灰塵，書本也散落一地！",
          "sc": "到处都积满了灰尘，书本也散落一地！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 246716,
          "spk": "名护 (ナゴ)",
          "ja": "一体いつから掃除をしていないんだ？",
          "tc": "到底是從什麼時候開始沒打掃的？",
          "sc": "到底是从什么时候开始没打扫的？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 246723,
          "spk": "名护 (ナゴ)",
          "ja": "俺にこれを片付けろって言うのか！？",
          "tc": "你叫我整理這種地方！？",
          "sc": "你叫我整理这种地方！？"
