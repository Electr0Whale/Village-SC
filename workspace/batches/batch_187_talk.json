          "pidx_tc": 246913,
          "spk": "木助 (キスケ)",
          "ja": "全員にとって、良い話じゃねぇか",
          "tc": "這對所有人來說都是件好事啊。",
          "sc": "这对所有人来说都是件好事啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 246926,
          "spk": "名护 (ナゴ)",
          "ja": "こんな状態になるまで放置してあるなら、",
          "tc": "當初會把這裡放著不管到這種狀態，",
          "sc": "当初会把这里放着不管到这种状态，"
