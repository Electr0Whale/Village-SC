        {
          "f_idx": 6,
          "pidx_tc": 246743,
          "spk": "木助 (キスケ)",
          "ja": "そうだぜ",
          "tc": "是啊。",
          "sc": "是啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 246750,
          "spk": "木助 (キスケ)",
          "ja": "文系ならこういうの、",
          "tc": "文科的人，",
          "sc": "文科的人，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 246757,
          "spk": "木助 (キスケ)",
          "ja": "整頓すんのは得意だろ？",
          "tc": "不是很擅長整理這些東西嗎？",
          "sc": "不是很擅长整理这些东西吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 246770,
          "spk": "名护 (ナゴ)",
          "ja": "整理整頓と文系の専攻は",
          "tc": "整理環境跟文科專業",
          "sc": "整理环境跟文科专业"
        },
        {
          "f_idx": 10,
          "pidx_tc": 246777,
          "spk": "名护 (ナゴ)",
          "ja": "何の関係もないだろう！",
          "tc": "一點關係都沒有吧！",
          "sc": "一点关系都没有吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4257,
      "rec_id": "TALK_ID_10_0301_013_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246795,
          "spk": "名护 (ナゴ)",
          "ja": "うぅ……この無秩序な状態を見ているだけで、",
          "tc": "嗚……光是看到這亂七八糟的狀態，",
          "sc": "呜……光是看到这乱七八糟的状态，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 246802,
          "spk": "名护 (ナゴ)",
          "ja": "全身に鳥肌が出てくる……",
