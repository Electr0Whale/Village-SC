  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4335,
      "rec_id": "TALK_ID_10_0302_023_33",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250093,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、またね",
          "tc": "那麼，下次見囉，",
          "sc": "那么，下次见啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250100,
          "spk": "驹子 (コマコ)",
          "ja": "おやすみなさい……",
          "tc": "晚安……",
          "sc": "晚安……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4336,
      "rec_id": "TALK_ID_10_0302_023_34",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250122,
          "spk": "帷 (トバリ)",
          "ja": "……でも、本当にニワトリが生き返ったら",
          "tc": "……如果雞真的復活了，",
          "sc": "……如果鸡真的复活了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250129,
          "spk": "帷 (トバリ)",
          "ja": "あのお化けは……また……",
          "tc": "那妖怪……又會……",
          "sc": "那妖怪……又会……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4337,
      "rec_id": "TALK_ID_10_0302_023_35",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250149,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ……どうしたの？",
          "tc": "帷……怎麼了嗎？",
          "sc": "帷……怎么了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4338,
      "rec_id": "TALK_ID_10_0302_023_36",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250167,
          "spk": "帷 (トバリ)",
          "ja": "いえ、なんでもない",
          "tc": "不，沒什麼。",
          "sc": "不，没什么。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250174,
          "spk": "帷 (トバリ)",
          "ja": "さっさと帰りましょ",
          "tc": "我們快回去吧。",
          "sc": "我们快回去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4339,
      "rec_id": "TALK_ID_10_0302_027_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250196,
          "spk": "木助 (キスケ)",
          "ja": "よぉ……",
          "tc": "嗨……",
          "sc": "嗨……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250203,
          "spk": "木助 (キスケ)",
          "ja": "なーにやってんだ",
          "tc": "你在做什麼啊？",
          "sc": "你在做什么啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4340,
      "rec_id": "TALK_ID_10_0302_027_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250225,
          "spk": "木助 (キスケ)",
          "ja": "また、誰かの頼み事のために",
          "tc": "該不會又為了某個人的委託",
          "sc": "该不会又为了某个人的委托"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250232,
          "spk": "木助 (キスケ)",
          "ja": "走り回ってんじゃねえだろうな？",
          "tc": "在四處奔走了吧？",
          "sc": "在四处奔走了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4341,
      "rec_id": "TALK_ID_10_0302_027_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250250,
          "spk": "裕太 (ユータ)",
          "ja": "へえ……財布を探して、ニワトリを探して……",
          "tc": "哦……找錢包、找雞……",
          "sc": "哦……找钱包、找鸡……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250257,
          "spk": "裕太 (ユータ)",
          "ja": "次は本を探してるんだ",
          "tc": "接著還要找書是吧。",
          "sc": "接着还要找书是吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250264,
          "spk": "裕太 (ユータ)",
          "ja": "まるで人助けのわらしべ長者だね！",
          "tc": "根本就是接委託的富翁吧！",
          "sc": "根本就是接委托的富翁吧！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250277,
          "spk": "木助 (キスケ)",
          "ja": "なに笑ってんだよてめぇは……",
          "tc": "你這傢伙是在笑什麼……",
          "sc": "你这家伙是在笑什么……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250284,
          "spk": "木助 (キスケ)",
          "ja": "<player>も、んなバカバカしい頼みなんて",
          "tc": "<player>也是，那種莫名其妙的委託……",
          "sc": "<player>也是，那种莫名其妙的委托……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250291,
          "spk": "木助 (キスケ)",
          "ja": "聞いてんじゃねーぞ",
          "tc": "根本就不該接吧。",
          "sc": "根本就不该接吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4342,
      "rec_id": "TALK_ID_10_0302_027_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250309,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、そんなこと言うのは",
          "tc": "學長，講那種話",
          "sc": "学长，讲那种话"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250316,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっとかわいそうじゃない……？",
          "tc": "有點傷人了吧……？",
          "sc": "有点伤人了吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4343,
      "rec_id": "TALK_ID_10_0302_027_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250334,
          "spk": "裕太 (ユータ)",
          "ja": "ごめんね、<player>",
          "tc": "抱歉啊，<player>，",
          "sc": "抱歉啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250341,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、今日は酷く酔ってるみたいで……",
          "tc": "學長今天好像醉到不行……",
          "sc": "学长今天好像醉到不行……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250354,
          "spk": "木助 (キスケ)",
          "ja": "ったく、てめぇには、",
          "tc": "真受不了，你這傢伙",
          "sc": "真受不了，你这家伙"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250361,
          "spk": "木助 (キスケ)",
          "ja": "自分ってもんはねえのか",
          "tc": "難道就沒一點自己的想法嗎？",
          "sc": "难道就没一点自己的想法吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250370,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが言いなりになってる相手にとっちゃ、",
          "tc": "對那個你唯命是從的人來說，",
          "sc": "对那个你唯命是从的人来说，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250377,
          "spk": "木助 (キスケ)",
          "ja": "その「従順さ」は都合のいい道具でしかねぇ！",
          "tc": "你的「聽話」不過是個便利的工具罷了！",
          "sc": "你的“听话”不过是个便利的工具罢了！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 250384,
          "spk": "木助 (キスケ)",
          "ja": "自由を殺すもんなんだぞ！",
          "tc": "是在扼殺你的自由啊！",
          "sc": "是在扼杀你的自由啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4344,
      "rec_id": "TALK_ID_10_0302_027_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250402,
          "spk": "裕太 (ユータ)",
          "ja": "先輩！！",
          "tc": "學長！！",
          "sc": "学长！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250409,
          "spk": "裕太 (ユータ)",
          "ja": "<player>が人助けしてるのを、",
          "tc": "<player>是在幫助別人，",
          "sc": "<player>是在帮助别人，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250416,
          "spk": "裕太 (ユータ)",
          "ja": "そんなふうに言っちゃダメだろ",
          "tc": "你不能那樣說啊！",
          "sc": "你不能那样说啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4345,
      "rec_id": "TALK_ID_10_0302_027_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250434,
          "spk": "裕太 (ユータ)",
          "ja": "情けは人のためならず……",
          "tc": "善有善報……",
          "sc": "善有善报……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250441,
          "spk": "裕太 (ユータ)",
          "ja": "わらしべ長者も最後には富豪だ",
          "tc": "行善就能積德。",
          "sc": "行善就能积德。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250457,
          "spk": "裕太 (ユータ)",
          "ja": "人助けは、きっとキミ自身に",
          "tc": "幫助別人的行為，",
          "sc": "帮助别人的行为，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250464,
          "spk": "裕太 (ユータ)",
          "ja": "いいことが返ってくるだろうからね",
          "tc": "最終一定會變成好事回報到自己身上。",
          "sc": "最终一定会变成好事回报到自己身上。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250477,
          "spk": "木助 (キスケ)",
          "ja": "ケッ、どいつもこいつも……",
          "tc": "嘖，每個傢伙都一個樣……",
          "sc": "啧，每个家伙都一个样……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 250484,
          "spk": "木助 (キスケ)",
          "ja": "「いい子」でいることに必死でいやがる",
          "tc": "拼命想做個「好孩子」。",
          "sc": "拼命想做个“好孩子”。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 250495,
          "spk": "木助 (キスケ)",
          "ja": "今にみてろ、",
          "tc": "等著瞧吧，",
          "sc": "等着瞧吧，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 250502,
          "spk": "木助 (キスケ)",
          "ja": "自分が何を望んでたかすら忘れちまう",
          "tc": "到頭來會連自己想要的是什麼都忘掉的。",
          "sc": "到头来会连自己想要的是什么都忘掉的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4346,
      "rec_id": "TALK_ID_10_0302_027_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250527,
          "spk": "裕太 (ユータ)",
          "ja": "先輩……",
          "tc": "學長……",
          "sc": "学长……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250534,
          "spk": "裕太 (ユータ)",
          "ja": "今日は流石に呑み過ぎだよ",
          "tc": "你今天實在是喝得過頭了。",
          "sc": "你今天实在是喝得过头了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250545,
          "spk": "木助 (キスケ)",
          "ja": "従ってばかりのてめぇが、",
          "tc": "只知道順從的你，",
          "sc": "只知道顺从的你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250552,
          "spk": "木助 (キスケ)",
          "ja": "「選んだ」と言える日は、",
          "tc": "能說出「這是我自己選的」這一天，",
          "sc": "能说出“这是我自己选的”这一天，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250559,
          "spk": "木助 (キスケ)",
          "ja": "きっと一生来ないだろうよ",
          "tc": "恐怕一輩子都不會發生吧。",
          "sc": "恐怕一辈子都不会发生吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 250572,
          "spk": "裕太 (ユータ)",
          "ja": "ほんと……",
          "tc": "真是的……",
          "sc": "真是的……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 250579,
          "spk": "裕太 (ユータ)",
          "ja": "どうしちゃったんだよ……",
          "tc": "學長到底是怎麼了……",
          "sc": "学长到底是怎么了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 250586,
          "spk": "裕太 (ユータ)",
          "ja": "ほら、家に帰りましょう",
          "tc": "好了，該回家了吧。",
          "sc": "好了，该回家了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4347,
      "rec_id": "TALK_ID_10_0302_027_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250604,
          "spk": "木助 (キスケ)",
          "ja": "うるせえ！",
          "tc": "少囉唆！",
          "sc": "少啰嗦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250611,
          "spk": "木助 (キスケ)",
          "ja": "俺が行くのは食堂だ！",
          "tc": "我要去的是餐廳！",
          "sc": "我要去的是餐厅！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250618,
          "spk": "木助 (キスケ)",
          "ja": "まだ呑むぞ！！",
          "tc": "我還要繼續喝！！",
          "sc": "我还要继续喝！！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250629,
          "spk": "裕太 (ユータ)",
          "ja": "ダメですって……",
          "tc": "不行啦……",
          "sc": "不行啦……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250636,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、出禁なんだから……",
          "tc": "學長都被禁止入店了……",
          "sc": "学长都被禁止入店了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4348,
      "rec_id": "TALK_ID_10_0302_027_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250652,
          "spk": "裕太 (ユータ)",
          "ja": "ご、ごめんね<player>",
          "tc": "抱、抱歉啊，<player>。",
          "sc": "抱、抱歉啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250659,
          "spk": "裕太 (ユータ)",
          "ja": "先輩は、俺が家へ連れて帰るから……",
          "tc": "我會把學長送回家的……",
          "sc": "我会把学长送回家的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4349,
      "rec_id": "TALK_ID_10_0302_028_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250681,
          "spk": "帷 (トバリ)",
          "ja": "ねえ、お願い",
          "tc": "拜託你了，",
          "sc": "拜托你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250688,
          "spk": "帷 (トバリ)",
          "ja": "あの本を探して",
          "tc": "幫忙找那本書吧。",
          "sc": "帮忙找那本书吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4350,
      "rec_id": "TALK_ID_10_0302_028_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250710,
          "spk": "名护 (ナゴ)",
          "ja": "いや、無理だって",
          "tc": "唉，就說沒辦法了。",
          "sc": "唉，就说没办法了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250717,
          "spk": "名护 (ナゴ)",
          "ja": "どれだけの本がこの図書館に、",
          "tc": "妳知道這座圖書館裡還有多少書沒整理，",
          "sc": "你知道这座图书馆里还有多少书没整理，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 250724,
          "spk": "名护 (ナゴ)",
          "ja": "整理もされずに転がってると思ってるんだ",
          "tc": "就這樣散落在地上嗎？",
          "sc": "就这样散落在地上吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250733,
          "spk": "名护 (ナゴ)",
          "ja": "そんな時を巻き戻す伝承だなんて……",
          "tc": "這時居然要我去找倒轉時間的傳說……",
          "sc": "这时居然要我去找倒转时间的传说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4351,
      "rec_id": "TALK_ID_10_0302_028_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250758,
          "spk": "帷 (トバリ)",
          "ja": "この見えてる範囲だけでしょ？",
          "tc": "也就是這目光可及的範圍之內而已吧？",
          "sc": "也就是这目光可及的范围之内而已吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250765,
          "spk": "帷 (トバリ)",
          "ja": "昔の話かもしれないけど、探してよ",
          "tc": "雖然可能只是故事，但你就找找看嘛。",
          "sc": "虽然可能只是故事，但你就找找看嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 250785,
          "spk": "名护 (ナゴ)",
          "ja": "……そもそも、キミは何が目的なんだ",
          "tc": "……說到底，妳有什麼目的？",
          "sc": "……说到底，你有什么目的？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 250792,
          "spk": "名护 (ナゴ)",
          "ja": "そんな古い伝承を探してどうする？",
          "tc": "為什麼要去找那麼古老的傳說？",
          "sc": "为什么要去找那么古老的传说？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4352,
      "rec_id": "TALK_ID_10_0302_028_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 250817,
          "spk": "帷 (トバリ)",
          "ja": "仕方ないでしょ",
          "tc": "我也沒辦法啊。",
          "sc": "我也没办法啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 250824,
          "spk": "帷 (トバリ)",
