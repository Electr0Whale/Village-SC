        },
        {
          "f_idx": 8,
          "pidx_tc": 251005,
          "spk": "名护 (ナゴ)",
          "ja": "この村で事件が起きたのか？",
          "tc": "這村子曾經發生過什麼事件嗎？",
          "sc": "这村子曾经发生过什么事件吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4355,
      "rec_id": "TALK_ID_10_0302_028_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 251023,
          "spk": "帷 (トバリ)",
