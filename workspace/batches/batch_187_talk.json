      "rec_id": "TALK_ID_10_0301_013_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 246094,
          "spk": "木助 (キスケ)",
          "ja": "こんなところで、",
          "tc": "原來你在這裡",
          "sc": "原来你在这里"
