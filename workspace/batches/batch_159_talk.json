  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3308,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0035",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 173202,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ふぅー……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 173209,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こう毎日暑いと参っちゃうねえ",
          "tc": "每天都這麼熱，真讓人受不了耶。",
          "sc": "每天都这么热，真让人受不了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 173218,
          "spk": "琪娜娜 (チナナ)",
          "ja": "灼熱の炎天下で露店を開くのも大変だよ",
          "tc": "在大太陽底下擺攤很辛苦啊。",
          "sc": "在大太阳底下摆摊很辛苦啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 173225,
          "spk": "琪娜娜 (チナナ)",
          "ja": "アツアツの鉄板の上で、",
          "tc": "畢竟感覺就像被放在",
          "sc": "毕竟感觉就像被放在"
        },
        {
          "f_idx": 4,
          "pidx_tc": 173232,
          "spk": "琪娜娜 (チナナ)",
          "ja": "炙り焼きにされてる感覚を味わえるからね",
          "tc": "熱騰騰的鐵板上炙燒一樣呢。",
          "sc": "热腾腾的铁板上炙烧一样呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 173245,
          "spk": "莲实 (ハスミ)",
          "ja": "……冗談になってないわよ",
          "tc": "……這個比喻一點也不好笑。",
          "sc": "……这个比喻一点也不好笑。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 173252,
          "spk": "莲实 (ハスミ)",
          "ja": "いつか本当に、焼きチナナに",
          "tc": "我真擔心哪一天，",
          "sc": "我真担心哪一天，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 173259,
          "spk": "莲实 (ハスミ)",
          "ja": "なってしまわないか心配だわ……",
          "tc": "妳會不會真的成了炭烤琪娜娜……",
          "sc": "你会不会真的成了炭烤琪娜娜……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 173272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あのね、ハスミ",
          "tc": "……我說啊，蓮實。",
          "sc": "……我说啊，莲实。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 173279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ボケてるの？　それとも",
          "tc": "妳是在說笑嗎？",
          "sc": "你是在说笑吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 173286,
          "spk": "琪娜娜 (チナナ)",
          "ja": "心配してくれてるの？",
          "tc": "還是真的在擔心我啊？",
          "sc": "还是真的在担心我啊？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 173299,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん心配してるに決まってるじゃない",
          "tc": "當然是在擔心妳啊。",
          "sc": "当然是在担心你啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 173306,
          "spk": "莲实 (ハスミ)",
          "ja": "チナナが露店を開いてる時は",
          "tc": "琪娜娜每次擺攤，",
          "sc": "琪娜娜每次摆摊，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 173313,
          "spk": "莲实 (ハスミ)",
          "ja": "いつも気が気じゃないんだから",
          "tc": "我可是都在提心吊膽呢。",
          "sc": "我可是都在提心吊胆呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 173326,
          "spk": "琪娜娜 (チナナ)",
          "ja": "へえ……ハスミに想ってもらえてるなんて",
          "tc": "是喔……蓮實居然這麼為我著想，",
          "sc": "是哦……莲实居然这么为我着想，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 173333,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嬉しい限りだねえ",
          "tc": "我真的很高興耶。",
          "sc": "我真的很高兴呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 173344,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そっかあ……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 173351,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミは、ウチが心配なんだあ",
          "tc": "原來蓮實這麼擔心我啊。",
          "sc": "原来莲实这么担心我啊。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 173364,
          "spk": "莲实 (ハスミ)",
          "ja": "な、何よ、ニヤニヤして……",
          "tc": "妳、妳在偷笑什麼啦……",
          "sc": "你、你在偷笑什么啦……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 173371,
          "spk": "莲实 (ハスミ)",
          "ja": "恥ずかしいから、ハッキリ口にしないで",
          "tc": "別講得那麼白，聽了很難為情。",
          "sc": "别讲得那么白，听了很难为情。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 173384,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなにウチのことが心配なら",
          "tc": "既然妳那麼擔心我，",
          "sc": "既然你那么担心我，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 173391,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここの払いは、ハスミ持ちでいいよね？",
          "tc": "那這裡的帳就由妳來買單可以吧？",
          "sc": "那这里的帐就由你来买单可以吧？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 173398,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの財布も苦しいって悲鳴あげてるから",
          "tc": "因為我的錢包也在發出痛苦的哀號。",
          "sc": "因为我的钱包也在发出痛苦的哀号。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 173411,
          "spk": "莲实 (ハスミ)",
          "ja": "……それはそれ、これはこれ",
          "tc": "……一碼歸一碼。",
          "sc": "……一码归一码。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 173418,
          "spk": "莲实 (ハスミ)",
          "ja": "自分のお財布の心配は自分でして",
          "tc": "自己的錢包自己去擔心吧。",
          "sc": "自己的钱包自己去担心吧。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 173431,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやおや……村の名医も",
          "tc": "哎呀哎呀……看來就連村裡的名醫，",
          "sc": "哎呀哎呀……看来就连村里的名医，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 173438,
          "spk": "琪娜娜 (チナナ)",
          "ja": "懐までは救ってはくれないみたいだね",
          "tc": "也救不了別人的財務危機呢。",
          "sc": "也救不了别人的财务危机呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3309,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0036",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 173473,
          "spk": "林 (リン)",
          "ja": "図書館の管理は上手くやれているみたいね",
          "tc": "看來管理圖書館的工作進行得很順利呢。",
          "sc": "看来管理图书馆的工作进行得很顺利呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 173480,
          "spk": "林 (リン)",
          "ja": "あなたに仕事を任せて正解だったわ",
          "tc": "把這件事交給你果然是對的。",
          "sc": "把这件事交给你果然是对的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 173493,
          "spk": "名护 (ナゴ)",
          "ja": "……半ば強引に",
          "tc": "……雖然根本沒有拒絕的餘地，",
          "sc": "……虽然根本没有拒绝的余地，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 173500,
          "spk": "名护 (ナゴ)",
          "ja": "押し付けられたようなものだったけどな",
          "tc": "算是半強迫的就是了。",
          "sc": "算是半强迫的就是了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 173513,
          "spk": "林 (リン)",
          "ja": "ただ……利用者がまばらなのが",
          "tc": "只不過……",
          "sc": "只不过……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 173520,
          "spk": "林 (リン)",
          "ja": "気になるところね",
          "tc": "使用者太少這點讓我有點在意呢。",
          "sc": "使用者太少这点让我有点在意呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 173531,
          "spk": "林 (リン)",
          "ja": "無料で読むことができるのに",
          "tc": "明明可以免費看書，",
          "sc": "明明可以免费看书，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 173538,
          "spk": "林 (リン)",
          "ja": "どうしてみんな、もっと利用しないのかしら",
          "tc": "大家為什麼不多加利用呢？",
          "sc": "大家为什么不多加利用呢？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 173551,
          "spk": "名护 (ナゴ)",
          "ja": "いくら無料だからといって、",
          "tc": "就算不用錢，",
          "sc": "就算不用钱，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 173558,
          "spk": "名护 (ナゴ)",
          "ja": "興味を持ってもらえないことには",
          "tc": "如果大家對那些書沒有興趣，",
          "sc": "如果大家对那些书没有兴趣，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 173565,
          "spk": "名护 (ナゴ)",
          "ja": "足を運ぶ気にはなれないさ",
          "tc": "自然也不會想過來看啊。",
          "sc": "自然也不会想过来看啊。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 173576,
          "spk": "名护 (ナゴ)",
          "ja": "まずは、本を読む習慣をつけないと",
          "tc": "還是得先培養閱讀習慣才行。",
          "sc": "还是得先培养阅读习惯才行。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 173596,
          "spk": "林 (リン)",
          "ja": "それなら、朗読会を開いてみるのはどう？",
          "tc": "既然如此，來試辦朗讀會怎麼樣？",
          "sc": "既然如此，来试办朗读会怎么样？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 173603,
          "spk": "林 (リン)",
          "ja": "読書の秋って言うし、",
          "tc": "人家都說是「閱讀之秋」嘛，",
          "sc": "人家都说是“阅读之秋”嘛，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 173610,
          "spk": "林 (リン)",
          "ja": "アピールするのにピッタリだと思うの",
          "tc": "在這個時節宣傳正合適。",
          "sc": "在这个时节宣传正合适。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 173621,
          "spk": "林 (リン)",
          "ja": "それで、本の面白さを知ってもらうのよ",
          "tc": "來藉此讓大家了解書本的有趣之處吧！",
          "sc": "来借此让大家了解书本的有趣之处吧！"
        },
        {
          "f_idx": 17,
          "pidx_tc": 173634,
          "spk": "名护 (ナゴ)",
          "ja": "いいんじゃないかな……",
          "tc": "聽起來不錯呢……",
          "sc": "听起来不错呢……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 173641,
          "spk": "名护 (ナゴ)",
          "ja": "そういうイベントを開くというなら",
          "tc": "如果要辦這種活動，",
          "sc": "如果要办这种活动，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 173648,
          "spk": "名护 (ナゴ)",
          "ja": "俺は別に構わないよ",
          "tc": "我倒是沒有意見。",
          "sc": "我倒是没有意见。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 173661,
          "spk": "林 (リン)",
          "ja": "なに、人ごとみたいに言ってるのよ",
          "tc": "怎麼說得好像跟你無關一樣，",
          "sc": "怎么说得好像跟你无关一样，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 173668,
          "spk": "林 (リン)",
          "ja": "朗読会、あなた主催でやってもらうのに",
          "tc": "朗讀會要交給你來主辦耶！",
          "sc": "朗读会要交给你来主办呢！"
        },
        {
          "f_idx": 23,
          "pidx_tc": 173686,
          "spk": "林 (リン)",
          "ja": "そういうことで、頼んだわよ",
          "tc": "事情就是這樣，麻煩你囉。",
          "sc": "事情就是这样，麻烦你啦。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 173693,
          "spk": "林 (リン)",
          "ja": "どんな本を選ぶかは、あなたにお任せするわ",
          "tc": "要選怎樣的書就交給你決定了。",
          "sc": "要选怎样的书就交给你决定了。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 173706,
          "spk": "名护 (ナゴ)",
          "ja": "ただの雑談から仕事を増やしてくるとは……",
          "tc": "沒想到只是閒聊一下工作就增加了……",
          "sc": "没想到只是闲聊一下工作就增加了……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 173713,
          "spk": "名护 (ナゴ)",
          "ja": "キミは、やっぱり油断ならないな",
          "tc": "面對妳果然不能大意。",
          "sc": "面对你果然不能大意。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3310,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0037",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 173750,
          "spk": "林 (リン)",
          "ja": "はぁ……今月も村の財政は火の車",
          "tc": "唉……這個月村子的財政還是很吃緊。",
          "sc": "唉……这个月村子的财政还是很吃紧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 173757,
          "spk": "林 (リン)",
          "ja": "何か挽回の一手はないのかしら……",
          "tc": "有沒有什麼扭轉局勢的方法呢……",
          "sc": "有没有什么扭转局势的方法呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 173777,
          "spk": "六角 (ロッカク)",
          "ja": "耳が痛いっスね……",
          "tc": "聽了真刺耳啊……",
          "sc": "听了真刺耳啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 173784,
          "spk": "六角 (ロッカク)",
          "ja": "ワシも店がもっと繁盛すれば",
          "tc": "要是我店裡的生意更好一點，",
          "sc": "要是我店里的生意更好一点，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 173791,
          "spk": "六角 (ロッカク)",
          "ja": "協力できるんですが……",
          "tc": "就能幫上忙了……",
          "sc": "就能帮上忙了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 173804,
          "spk": "裕太 (ユータ)",
          "ja": "基本的に彼ヶ津村の中で",
          "tc": "畢竟彼津村的經濟，",
          "sc": "毕竟彼津村的经济，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 173811,
          "spk": "裕太 (ユータ)",
          "ja": "経済が完結しちゃってるから",
          "tc": "基本上都是內部循環，",
          "sc": "基本上都是内部循环，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 173818,
          "spk": "裕太 (ユータ)",
          "ja": "どうしようもない部分はあるよね",
          "tc": "所以有些問題的確無從解決。",
          "sc": "所以有些问题的确无从解决。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 173829,
          "spk": "裕太 (ユータ)",
          "ja": "この村はいわば鎖国状態だからね",
          "tc": "這個村子基本上就跟鎖國沒兩樣。",
          "sc": "这个村子基本上就跟锁国没两样。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 173836,
          "spk": "裕太 (ユータ)",
          "ja": "歴史を振り返ればわかるけど",
          "tc": "回顧歷史就能明白，",
          "sc": "回顾历史就能明白，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 173843,
          "spk": "裕太 (ユータ)",
          "ja": "それってやっぱり不健全だと思うんだ",
          "tc": "這種狀態其實不太健康。",
          "sc": "这种状态其实不太健康。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 173856,
          "spk": "林 (リン)",
          "ja": "ペラペラと偉そうに……",
          "tc": "在那邊說得頭頭是道……",
          "sc": "在那边说得头头是道……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 173863,
          "spk": "林 (リン)",
          "ja": "なら、解決策の一つでも示しなさいよ",
          "tc": "那你倒是提出個解決方法啊。",
          "sc": "那你倒是提出个解决方法啊。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 173883,
          "spk": "裕太 (ユータ)",
          "ja": "うーん、そうだな……",
          "tc": "嗯～這個嘛……",
          "sc": "嗯～这个嘛……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 173890,
          "spk": "裕太 (ユータ)",
          "ja": "なら仮装通貨のマイニングはどうかな？",
          "tc": "那虛擬貨幣挖礦怎麼樣？",
          "sc": "那虚拟货币挖矿怎么样？"
        },
        {
