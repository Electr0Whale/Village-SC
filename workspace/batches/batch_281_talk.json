      "rec_id": "TALK_ID_90_2002_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 469632,
          "spk": "林 (リン)",
          "ja": "まだ土地を増やしたいのなら、",
          "tc": "要是想擴建土地的話，",
          "sc": "要是想扩建土地的话，"
