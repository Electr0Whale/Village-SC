          "ja": "<strong>素材とお金を用意して、",
          "tc": "<strong>就準備好材料和費用，",
          "sc": "<strong>就准备好材料和费用，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 469646,
          "spk": "林 (リン)",
