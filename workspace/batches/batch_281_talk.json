    {
      "file": "talk.dat",
      "rec_idx": 8104,
      "rec_id": "TALK_ID_10_0102_041_07_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213244,
          "spk": "？？？ (未知角色)",
          "ja": "んじゃ、あらためまして",
          "tc": "我來正式自我介紹一下吧。",
          "sc": "我来正式自我介绍一下吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213262,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はじめまして",
          "tc": "你好，",
          "sc": "你好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213269,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの名前は、チナナだよ",
          "tc": "我的名字是琪娜娜。",
          "sc": "我的名字是琪娜娜。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213278,
          "spk": "琪娜娜 (チナナ)",
          "ja": "月、水、金、日曜日に",
          "tc": "每個星期一、三、五、日，",
          "sc": "每个星期一、三、五、日，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213285,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の外から商品を仕入れて来てるんだ",
          "tc": "我會來擺攤賣一些從村外進貨的商品。",
          "sc": "我会来摆摊卖一些从村外进货的商品。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 213303,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次来るのは明後日……水曜だね",
          "tc": "下次來會是後天……星期三的時候。",
          "sc": "下次来会是后天……星期三的时候。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 213310,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは明日街に帰って、キミの小屋で",
          "tc": "我明天會回鎮上，",
          "sc": "我明天会回镇上，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 213317,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ピロちゃんを飼う準備をしてくるよ",
          "tc": "籌備東西讓你的雞舍能養嗶羅。",
          "sc": "筹备东西让你的鸡舍能养哔罗。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 213328,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、小屋にピロちゃんが来るのは水曜日だ",
          "tc": "所以嗶羅會在星期三搬進你的雞舍。",
          "sc": "所以哔罗会在星期三搬进你的鸡舍。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 213335,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それまでは、ウチの車に隠して飼っておこう",
          "tc": "在那之前，會先養在我的車裡。",
          "sc": "在那之前，会先养在我的车里。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 213353,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにしても、キミ……",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 213360,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人であの広い庭を管理するんだって？",
          "tc": "聽說你得獨自打理那麼大的庭院啊？",
          "sc": "听说你得独自打理那么大的庭院啊？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 213367,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな小さな子どもに、リンも無茶を言うね",
          "tc": "連對這麼小的孩子，林也這麼強人所難呢。",
          "sc": "连对这么小的孩子，林也这么强人所难呢。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 213378,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それに加えて次はヒヨコまで……",
          "tc": "不僅如此，接下來連小雞都……",
          "sc": "不仅如此，接下来连小鸡都……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 213385,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだか押し付けてしまって、",
          "tc": "算是硬塞給你了，",
          "sc": "算是硬塞给你了，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 213392,
          "spk": "琪娜娜 (チナナ)",
          "ja": "申し訳ない気持ちになってきたよ……",
          "tc": "我開始感到抱歉……",
          "sc": "我开始感到抱歉……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 213403,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なにかお礼をしたいけれど、",
          "tc": "雖然想做點什麼來表示感謝，但……",
          "sc": "虽然想做点什么来表示感谢，但……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 213410,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、手持ちにいいモノはないし……",
          "tc": "現在手邊沒有什麼好東西……",
          "sc": "现在手边没有什么好东西……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 213428,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 213435,
          "spk": "琪娜娜 (チナナ)",
          "ja": "動物のお世話は力仕事だろうから、",
          "tc": "照顧動物應該是件費力的工作吧，",
          "sc": "照顾动物应该是件费力的工作吧，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 213442,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体力を補うモノとかはどうだい？",
          "tc": "給你點補充體力的東西怎麼樣？",
          "sc": "给你点补充体力的东西怎么样？"
        },
        {
          "f_idx": 25,
          "pidx_tc": 213453,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ただ、これはウチじゃなくて、",
          "tc": "……不過，不是我店裡的商品，",
          "sc": "……不过，不是我店里的商品，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 213460,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ある人からもらえるモノなんだ",
          "tc": "是可以從某個人那裡拿到的東西。",
          "sc": "是可以从某个人那里拿到的东西。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 213467,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど一緒に来てくれるかい？",
          "tc": "不好意思，你能跟我一起去嗎？",
          "sc": "不好意思，你能跟我一起去吗？"
        }
      ]
    },
