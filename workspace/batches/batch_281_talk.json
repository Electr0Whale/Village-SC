          "f_idx": 2,
          "pidx_tc": 398048,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よしよし",
          "tc": "好乖好乖。",
          "sc": "好乖好乖。"
        }
      ]
    },
    {
