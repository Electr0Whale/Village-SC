          "f_idx": 2,
          "pidx_tc": 206056,
          "spk": "茶梅 (サザンカ)",
          "ja": "なくなっちゃうかもしれないからさ",
          "tc": "說不定就賣完囉。",
          "sc": "说不定就要卖完啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 206067,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああそうだ、アタシが居ないときでも",
          "tc": "啊對了，即使是我不在的時候，",
          "sc": "啊对了，即使是我不在的时候，"
        },
