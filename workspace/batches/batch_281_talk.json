          "f_idx": 4,
          "pidx_tc": 206074,
          "spk": "茶梅 (サザンカ)",
          "ja": "その棚から商品、持ってっていいから",
          "tc": "你也可以從架上拿走商品。",
          "sc": "你也可以从架上拿走商品。"
        },
