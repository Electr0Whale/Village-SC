      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 469793,
          "spk": "木助 (キスケ)",
          "ja": "それにしても……てめぇもまた、",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
