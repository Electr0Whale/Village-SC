          "sc": "我随时都很欢迎的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7937,
      "rec_id": "TALK_ID_90_2001_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 468799,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕事の仕入れは",
          "tc": "店裡要用的商品",
          "sc": "店里要用的商品"
