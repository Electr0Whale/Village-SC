          "ja": "あ、土地の代金の支払いはキスケさんにお願いね",
          "tc": "對了，土地的費用請直接交給木助哥。",
          "sc": "对了，土地的费用请直接交给木助哥。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 469664,
          "spk": "林 (リン)",
          "ja": "後で、私がキスケさんから受け取るから",
          "tc": "我之後會再跟他收款。",
          "sc": "我之后会再跟他收款。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 469682,
          "spk": "林 (リン)",
          "ja": "もちろん、無理に買えとは言わないわ！",
          "tc": "當然，我不是要強迫你買！",
          "sc": "当然，我不是要强迫你买！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 469689,
          "spk": "林 (リン)",
          "ja": "でも、あなたがもっと広い土地を求めるなら、",
          "tc": "只是如果你需要更寬敞的土地，",
          "sc": "只是如果你需要更宽敞的土地，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 469696,
          "spk": "林 (リン)",
          "ja": "売ってあげてもいい……それだけの話よ",
          "tc": "我願意再賣給你……就是這麼回事。",
          "sc": "我愿意再卖给你……就是这么回事。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 469707,
          "spk": "林 (リン)",
          "ja": "じゃあ、私からの話はこれだけ",
          "tc": "我想跟你說的就是這些。",
          "sc": "我想跟你说的就是这些。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 469714,
          "spk": "林 (リン)",
          "ja": "購入するかどうか、よく検討してちょうだいね",
          "tc": "至於要不要買，你就再好好考慮一下吧。",
          "sc": "至于要不要买，你就再好好考虑一下吧。"
        }
      ]
    },
