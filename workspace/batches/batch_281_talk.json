          "f_idx": 5,
          "pidx_tc": 206081,
          "spk": "茶梅 (サザンカ)",
          "ja": "……ただし、ちゃんとお金は置いてってよね",
          "tc": "……不過你要乖乖把錢留下來啊。",
          "sc": "……不过你要乖乖把钱留下来啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 206092,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃ、今後ともごひいきに",
          "tc": "今後也請你多多關照啦，",
          "sc": "今后也请你多多关照啦，"
        },
