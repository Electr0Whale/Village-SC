        {
          "f_idx": 1,
          "pidx_tc": 469800,
          "spk": "木助 (キスケ)",
          "ja": "めんどくさいモンを買っちまったなァ",
          "tc": "你還真是買了個麻煩的東西啊。",
          "sc": "你还真是买了个麻烦的东西啊。"
        },
