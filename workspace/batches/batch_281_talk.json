    {
      "file": "talk.dat",
      "rec_idx": 7944,
      "rec_id": "TALK_ID_90_2002_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 469411,
          "spk": "林 (リン)",
          "ja": "私からの手紙、読んでくれたかしら？",
          "tc": "你讀過我的信了嗎？",
          "sc": "你读过我的信了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 469418,
          "spk": "林 (リン)",
          "ja": "例の話が気になるんじゃない？",
          "tc": "是不是很在意裡面提到的那件事？",
          "sc": "是不是很在意里面提到的那件事？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 469436,
          "spk": "林 (リン)",
          "ja": "きっとあなたは大喜びするでしょうから、",
          "tc": "我想你一定會很開心，",
          "sc": "我想你一定会很开心，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 469443,
          "spk": "林 (リン)",
          "ja": "私も早く話したかったの！",
          "tc": "所以想早點告訴你！",
          "sc": "所以想早点告诉你！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 469450,
          "spk": "林 (リン)",
          "ja": "今からちゃんと説明してあげるわね！",
          "tc": "我現在就跟你好好說明一下！",
          "sc": "我现在就跟你好好说明一下！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 469461,
          "spk": "林 (リン)",
          "ja": "あなた、私から土地を",
          "tc": "你之前從我這裡",
          "sc": "你之前从我这里"
        },
        {
          "f_idx": 7,
          "pidx_tc": 469468,
          "spk": "林 (リン)",
          "ja": "たくさん買ってくれたわよね？",
          "tc": "買了不少土地吧？",
          "sc": "买了不少土地吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 469477,
          "spk": "林 (リン)",
          "ja": "おかげで私は土地を腐らせずに運用できて、",
          "tc": "托你的福，我才能讓土地充分發揮價值，",
          "sc": "托你的福，我才能让土地充分发挥价值，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 469484,
          "spk": "林 (リン)",
          "ja": "あなたは色々なモノを生産して出荷できる……",
          "tc": "而你也能生產各式各樣的東西拿去出貨……",
          "sc": "而你也能生产各式各样的东西拿去出货……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 469502,
          "spk": "林 (リン)",
          "ja": "その結果、最近の彼ヶ津村の収入は",
          "tc": "拜此所賜，",
          "sc": "拜此所赐，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 469509,
          "spk": "林 (リン)",
          "ja": "うなぎ登りなのよ！",
          "tc": "最近彼津村的收入可說是節節高升！",
          "sc": "最近彼津村的收入可说是节节高升！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 469520,
          "spk": "林 (リン)",
          "ja": "この調子で稼いでいけば、",
          "tc": "如果收入能這樣繼續成長，",
          "sc": "如果收入能这样继续成长，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 469527,
          "spk": "林 (リン)",
          "ja": "村の街灯も増やせるかもしれないわ！",
          "tc": "或許就能幫村裡多裝幾盞路燈了！",
          "sc": "或许就能帮村里多装几盏路灯了！"
        },
        {
          "f_idx": 15,
          "pidx_tc": 469538,
          "spk": "林 (リン)",
          "ja": "だから……またうちの土地を、",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 469545,
          "spk": "林 (リン)",
          "ja": "売ってあげてもいいと思っているの",
          "tc": "我覺得可以再把手上的土地賣給你。",
          "sc": "我觉得可以再把手上的土地卖给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
