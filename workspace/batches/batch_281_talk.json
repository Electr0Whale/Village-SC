          "pidx_tc": 469866,
          "spk": "木助 (キスケ)",
          "ja": "畑を作るどころか、",
          "tc": "別說是打造農田了，",
          "sc": "别说是打造农田了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 469873,
          "spk": "木助 (キスケ)",
          "ja": "まずは開拓からになるだろうよ",
          "tc": "恐怕得先從開荒整地開始做起。",
          "sc": "恐怕得先从开荒整地开始做起。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 469891,
          "spk": "木助 (キスケ)",
          "ja": "ただ、整備したら悪くない土地になるだろう",
          "tc": "但好好整地的話，應該會是塊滿不錯的土地。",
          "sc": "但好好整地的话，应该会是块满不错的土地。"
