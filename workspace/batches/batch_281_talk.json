        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8103,
      "rec_id": "TALK_ID_10_0102_041_05_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213151,
          "spk": "？？？ (未知角色)",
          "ja": "ど、どうしてもダメかな……？",
          "tc": "無、無論如何都不行嗎……？",
          "sc": "无、无论如何都不行吗……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213158,
          "spk": "？？？ (未知角色)",
          "ja": "ヨウがこんなに泣いていることだし……",
          "tc": "洋都哭成這樣了……",
          "sc": "洋都哭成这样了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213165,
          "spk": "？？？ (未知角色)",
          "ja": "キミに飼ってほしいんだけど……いいかな？",
          "tc": "我是真心希望你能養牠……可以嗎？",
          "sc": "我是真心希望你能养它……可以吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213174,
          "spk": "主角心声/旁白/选项",
