        {
          "f_idx": 4,
          "pidx_tc": 468833,
          "spk": "茶梅 (サザンカ)",
          "ja": "したかったんだよね",
          "tc": "重新布置一下呢。",
          "sc": "重新布置一下呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 468844,
          "spk": "茶梅 (サザンカ)",
          "ja": "ハートのクッションとメイクボックス……",
          "tc": "再訂個愛心抱枕、化妝箱……",
          "sc": "再订个爱心抱枕、化妆箱……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 468851,
          "spk": "茶梅 (サザンカ)",
          "ja": "それにルームフレグランスも頼もうかな～",
          "tc": "還有室內香氛好了～",
          "sc": "还有室内香氛好了～"
        },
        {
          "f_idx": 8,
          "pidx_tc": 468871,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほいほい",
          "tc": "好的好的。",
          "sc": "好的好的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 468878,
          "spk": "琪娜娜 (チナナ)",
          "ja": "んじゃ、メモしとくよ",
          "tc": "那我記下來。",
          "sc": "那我记下来。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 468891,
          "spk": "茶梅 (サザンカ)",
          "ja": "それにしてもコレ、仕入れにも使えて、",
          "tc": "話說回來，這不只能用來採購店裡的商品，",
          "sc": "话说回来，这不只能用来采购店里的商品，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 468898,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの趣味のグッズまで注文できるなんて",
          "tc": "連我自己喜歡的東西也能訂，",
          "sc": "连我自己喜欢的东西也能订，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 468905,
          "spk": "茶梅 (サザンカ)",
          "ja": "マジで便利だわ～",
          "tc": "實在太方便了～",
          "sc": "实在太方便了～"
        },
        {
          "f_idx": 13,
          "pidx_tc": 468916,
          "spk": "茶梅 (サザンカ)",
          "ja": "ほんと、いいもんもらったよ",
          "tc": "真是收到了一個好東西呢。",
          "sc": "真是收到了一个好东西呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 468923,
          "spk": "茶梅 (サザンカ)",
          "ja": "サンキュー、チナナ",
          "tc": "謝啦，琪娜娜。",
          "sc": "谢啦，琪娜娜。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 468936,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どういたしまして",
          "tc": "不客氣。",
          "sc": "不客气。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 468943,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こっちも商売が繁盛して助かるよ",
          "tc": "這樣我的生意也會跟著變好，幫大忙了。",
          "sc": "这样我的生意也会跟着变好，帮大忙了。"
        }
      ]
    },
    {
