    {
      "file": "talk.dat",
      "rec_idx": 7939,
      "rec_id": "TALK_ID_90_2001_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 468988,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>！",
          "tc": "嗨，<player>！",
          "sc": "嗨，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 468995,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もしかして……ウチからの手紙を",
          "tc": "你是不是……",
          "sc": "你是不是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 469002,
          "spk": "琪娜娜 (チナナ)",
          "ja": "読んでくれたのかな？",
          "tc": "讀過我寄的信了啊？",
          "sc": "读过我寄的信了啊？"
        },
        {
          "f_idx": 3,
