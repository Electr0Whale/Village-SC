  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7926,
      "rec_id": "TALK_ID_70_2150_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397254,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秘密基地っぽくて",
          "tc": "是不是很像祕密基地？",
          "sc": "是不是很像秘密基地？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397261,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なかなかいいだろう？",
          "tc": "很不錯吧？",
          "sc": "很不错吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここは二人で寝るには",
          "tc": "雖然這裡睡兩個人",
          "sc": "虽然这里睡两个人"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっとばかし狭いけどね",
          "tc": "是有一點點擠，",
          "sc": "是有一点点挤，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397286,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それもまた楽しいんだよ",
          "tc": "但這也是一種樂趣嘛。",
          "sc": "但这也是一种乐趣嘛。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜は今みたいに",
          "tc": "晚上只要像現在一樣",
          "sc": "晚上只要像现在一样"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "車内灯を点けていれば",
          "tc": "打開車內燈，",
          "sc": "打开车内灯，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397311,
          "spk": "琪娜娜 (チナナ)",
          "ja": "明るくて過ごしやすいし",
          "tc": "就會很明亮了，很方便。",
          "sc": "就会很明亮了，很方便。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 397322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気分を変えて",
          "tc": "或者如果想要換個心情，",
          "sc": "或者如果想要换个心情，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 397329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ランタンの明かりで",
          "tc": "打開燈籠的燈",
          "sc": "打开灯笼的灯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 397336,
          "spk": "琪娜娜 (チナナ)",
          "ja": "過ごすのもいいもんだよ",
          "tc": "也不錯。",
          "sc": "也不错。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 397347,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜の運転席って",
          "tc": "晚上的駕駛座",
          "sc": "晚上的驾驶座"
        },
        {
          "f_idx": 12,
          "pidx_tc": 397354,
          "spk": "琪娜娜 (チナナ)",
          "ja": "落ち着くんだよねえ",
          "tc": "很讓人放鬆呢。",
          "sc": "很让人放松呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 397363,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝る前はここで",
          "tc": "我睡前都會在這裡",
          "sc": "我睡前都会在这里"
        },
        {
          "f_idx": 14,
          "pidx_tc": 397370,
          "spk": "琪娜娜 (チナナ)",
          "ja": "本を読んだり、",
          "tc": "讀讀書、",
          "sc": "读读书、"
        },
        {
          "f_idx": 15,
          "pidx_tc": 397377,
          "spk": "琪娜娜 (チナナ)",
          "ja": "虫の声を聞いたり……",
          "tc": "聽聽蟲鳴……",
          "sc": "听听虫鸣……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 397388,
          "spk": "琪娜娜 (チナナ)",
          "ja": "天気が良ければ",
          "tc": "然後天氣好的時候，",
          "sc": "然后天气好的时候，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 397395,
          "spk": "琪娜娜 (チナナ)",
          "ja": "窓を開けて",
          "tc": "我會打開車窗",
          "sc": "我会打开车窗"
        },
        {
          "f_idx": 18,
          "pidx_tc": 397402,
          "spk": "琪娜娜 (チナナ)",
          "ja": "星を眺めたりするんだよ",
          "tc": "看星星。",
          "sc": "看星星。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 397413,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ああ、でも今日は",
          "tc": "……啊，",
          "sc": "……啊，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 397420,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう遅いからね",
          "tc": "不過今天已經很晚了，",
          "sc": "不过今天已经很晚了，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 397427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝るとしようか",
          "tc": "所以我們還是先睡吧。",
          "sc": "所以我们还是先睡吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7927,
      "rec_id": "TALK_ID_70_2150_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397447,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……起きてるかい、<player>",
          "tc": "……你還醒著嗎，<player>？",
          "sc": "……你还醒着吗，<player>？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7928,
      "rec_id": "TALK_ID_70_2150_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397463,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっと",
          "tc": "哎呀，",
          "sc": "哎呀，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こっちは見ないでくれるかい？",
          "tc": "可以不要看我嗎？",
          "sc": "可以不要看我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと気恥ずかしくてね",
          "tc": "我有一點不好意思。",
          "sc": "我有一点不好意思。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7929,
      "rec_id": "TALK_ID_70_2150_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397493,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなこと、面と向かっては",
          "tc": "雖然這種事",
          "sc": "虽然这种事"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397500,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なかなか言えないけどさ",
          "tc": "實在是很難當著面開口，",
          "sc": "实在是很难当着面开口，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397507,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鵺の皮の件では、世話になったね",
          "tc": "但關於鵺皮那件事，我還是要謝謝你的幫忙。",
          "sc": "但关于鵺皮那件事，我还是要谢谢你的帮忙。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397516,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチはずっと",
          "tc": "……我一直都希望",
          "sc": "……我一直都希望"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397523,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミにまた笑ってほしいと",
          "tc": "能夠再看到",
          "sc": "能够再看到"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397530,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思っていたんだ",
          "tc": "應該會累死。",
          "sc": "应该会累死。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397539,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのためにどうしたらいいのか、",
          "tc": "但是我卻不知道該怎麼做。",
          "sc": "但是我却不知道该怎么做。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397546,
          "spk": "琪娜娜 (チナナ)",
          "ja": "答えが出ないまま",
          "tc": "我始終都找不到答案，",
          "sc": "我始终都找不到答案，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 397553,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村を行き来していたわけだけど",
          "tc": "就這樣一直在村子裡進進出出的。",
          "sc": "就这样一直在村子里进进出出的。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 397562,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今は、こんなに簡単なこと",
          "tc": "所以現在我才會覺得很驚訝，",
          "sc": "所以现在我才会觉得很惊讶，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 397569,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だったのかって驚いているよ",
          "tc": "想說原來答案這麼簡單。",
          "sc": "想说原来答案这么简单。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7930,
      "rec_id": "TALK_ID_70_2150_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397585,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……でもねえ",
          "tc": "……可是啊，",
          "sc": "……可是啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397592,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミとスミレがね",
          "tc": "蓮實和堇怜啊，",
          "sc": "莲实和堇怜啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397601,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの傷を見ると、",
          "tc": "他們每次只要一看到我的傷口，",
          "sc": "他们每次只要一看到我的伤口，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397608,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悲しそうな申し訳なさそうな",
          "tc": "都會露出",
          "sc": "都会露出"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397615,
          "spk": "琪娜娜 (チナナ)",
          "ja": "顔をするんだよ",
          "tc": "悲傷又愧疚的表情。",
          "sc": "悲伤又愧疚的表情。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397624,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチとしては、ハスミとスミレを",
          "tc": "……雖然我對於自己有保護好蓮實和堇怜、",
          "sc": "……虽然我对于自己有保护好莲实和堇怜、"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397631,
          "spk": "琪娜娜 (チナナ)",
          "ja": "無傷で守り通したことは、",
          "tc": "他們兩個人都毫髮無傷這件事，",
          "sc": "他们两个人都毫发无伤这件事，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397638,
          "spk": "琪娜娜 (チナナ)",
          "ja": "誇っていいことだと思っているんだけどね",
          "tc": "是非常引以為傲的。",
          "sc": "是非常引以为傲的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7931,
      "rec_id": "TALK_ID_70_2150_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397654,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ねえ、<player>",
          "tc": "……我問你，<player>。",
          "sc": "……我问你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397663,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチが長い間ハスミとスミレの",
          "tc": "你覺得我長時間以來",
          "sc": "你觉得我长时间以来"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397670,
          "spk": "琪娜娜 (チナナ)",
          "ja": "代わりにやってきたことは、",
          "tc": "代替蓮實和堇怜做的那些",
          "sc": "代替莲实和堇怜做的那些"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397677,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よかったと思うかい？",
          "tc": "是好的嗎？",
          "sc": "是好的吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397686,
          "spk": "主角心声/旁白/选项",
          "ja": "よかった",
          "tc": "是好的",
          "sc": "是好的"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397693,
          "spk": "主角心声/旁白/选项",
          "ja": "よくない",
          "tc": "不太好",
          "sc": "不太好"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7932,
      "rec_id": "TALK_ID_70_2150_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397769,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……答えにくいことを",
          "tc": "……抱歉問了你",
          "sc": "……抱歉问了你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397776,
          "spk": "琪娜娜 (チナナ)",
          "ja": "質問して悪かったね",
          "tc": "這麼難回答的問題。",
          "sc": "这么难回答的问题。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397785,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミの言葉には",
          "tc": "總覺得你講話",
          "sc": "总觉得你讲话"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397792,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嘘がない気がして",
          "tc": "都很真誠，",
          "sc": "都很真诚，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397799,
          "spk": "琪娜娜 (チナナ)",
          "ja": "つい聞きたくなっちゃうんだ",
          "tc": "所以讓我忍不住想問你。",
          "sc": "所以让我忍不住想问你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397808,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あのね、<player>",
          "tc": "……那個啊，<player>，",
          "sc": "……那个啊，<player>，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397815,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはキミに恩がある",
          "tc": "你真的對我有恩。",
          "sc": "你真的对我有恩。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397824,
          "spk": "琪娜娜 (チナナ)",
          "ja": "できれば、ウチはこれから",
          "tc": "所以如果可以，",
          "sc": "所以如果可以，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 397831,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>も守ってやれたらと",
          "tc": "我以後也想要",
          "sc": "我以后也想要"
        },
        {
          "f_idx": 9,
          "pidx_tc": 397838,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思っているよ",
          "tc": "繼續保護<player>。",
          "sc": "继续保护<player>。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 397847,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鵺の皮がないウチに",
          "tc": "雖然我也不知道",
          "sc": "虽然我也不知道"
        },
        {
          "f_idx": 11,
          "pidx_tc": 397854,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何ができるのかは",
          "tc": "沒有了鵺皮的我",
          "sc": "没有了鵺皮的我"
        },
        {
          "f_idx": 12,
          "pidx_tc": 397861,
          "spk": "琪娜娜 (チナナ)",
          "ja": "かなり怪しいところだけどね",
          "tc": "還能做些什麼，",
          "sc": "还能做些什么，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 397870,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でも、困ったことがあれば",
          "tc": "不過如果你遇到了困難，",
          "sc": "不过如果你遇到了困难，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 397877,
          "spk": "琪娜娜 (チナナ)",
          "ja": "話ぐらいは聞けるだろうさ",
          "tc": "我還是能陪你商量的。",
          "sc": "我还是能陪你商量的。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 397886,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かあったら",
          "tc": "所以你以後要是遇到了什麼事，",
          "sc": "所以你以后要是遇到了什么事，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 397893,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いつでも頼るんだよ",
          "tc": "都可以來找我喔。",
          "sc": "都可以来找我哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7933,
      "rec_id": "TALK_ID_70_2150_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397909,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……いい子だね",
          "tc": "……好孩子。",
          "sc": "……好孩子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7934,
      "rec_id": "TALK_ID_70_2150_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 397929,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ～……昨日はなんて",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 397936,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こっぱずかしい話を",
          "tc": "我昨天到底為什麼會講那些",
          "sc": "我昨天到底为什么会讲那些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 397943,
          "spk": "琪娜娜 (チナナ)",
          "ja": "したんだろうねえ……",
          "tc": "那麼難為情的話啊……",
          "sc": "那么难为情的话啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 397952,
          "spk": "琪娜娜 (チナナ)",
          "ja": "素面であんなこと",
          "tc": "真是不敢相信，",
          "sc": "真是不敢相信，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397959,
          "spk": "琪娜娜 (チナナ)",
          "ja": "堂々と言っちゃうなんて",
          "tc": "我明明就沒喝醉，",
          "sc": "我明明就没喝醉，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397966,
          "spk": "琪娜娜 (チナナ)",
          "ja": "信じられないねえ……",
          "tc": "居然還能面不改色地說出那些話……",
          "sc": "居然还能面不改色地说出那些话……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397977,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これだから夜は",
          "tc": "夜晚就是",
          "sc": "夜晚就是"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397984,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おセンチになりやすくて",
          "tc": "容易讓人多愁善感，",
          "sc": "容易让人多愁善感，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 397991,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困るんだよ",
          "tc": "真傷腦筋。",
          "sc": "真伤脑筋。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 398002,
          "spk": "琪娜娜 (チナナ)",
          "ja": "頼むから、昨日のことは",
          "tc": "拜託你了，",
          "sc": "拜托你了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 398009,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチとキミだけの秘密に",
          "tc": "希望你能把昨天的事",
          "sc": "希望你能把昨天的事"
        },
        {
          "f_idx": 11,
          "pidx_tc": 398016,
          "spk": "琪娜娜 (チナナ)",
          "ja": "してほしいんだけど……",
          "tc": "當作我們兩個人之間的祕密……",
          "sc": "当作我们两个人之间的秘密……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7935,
      "rec_id": "TALK_ID_70_2150_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 398034,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、よかった……",
