          "pidx_tc": 468806,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それで終わりかい？",
          "tc": "都採購好了嗎？",
          "sc": "都采购好了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 468819,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょいまち！",
          "tc": "等一下！",
