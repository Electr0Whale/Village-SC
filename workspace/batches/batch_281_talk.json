        },
        {
          "f_idx": 4,
          "pidx_tc": 210622,
          "spk": "林 (リン)",
          "ja": "ほら、早く行きましょう！",
          "tc": "好了，我們快出發吧！",
          "sc": "好了，我们快出发吧！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 210629,
          "spk": "林 (リン)",
          "ja": "午後１１時になる前に見つけないと！",
          "tc": "得在晚上11點前找到人才行！",
          "sc": "得在晚上11点前找到人才行！"
        }
      ]
    },
