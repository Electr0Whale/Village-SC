          "sc": "来，收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7940,
      "rec_id": "TALK_ID_90_2001_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 469048,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それは、ウチからの素敵なプレゼント、",
          "tc": "這就是我要給你的超棒禮物，",
          "sc": "这就是我要给你的超棒礼物，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 469055,
          "spk": "琪娜娜 (チナナ)",
          "ja": "家具の「カタログ」さ！",
          "tc": "家具的「目錄」！",
          "sc": "家具的“目录”！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 469064,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一度でも手に入れた家具なら、",
          "tc": "只要是曾獲得過的家具，",
          "sc": "只要是曾获得过的家具，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 469071,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう一度注文できる便利なシロモノだよ",
          "tc": "都能透過它再次訂購，非常方便。",
          "sc": "都能透过它再次订购，非常方便。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 469089,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カタログには、",
          "tc": "目錄裡會列出",
          "sc": "目录里会列出"
        },
        {
          "f_idx": 6,
          "pidx_tc": 469096,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これまで手に入れた家具が",
          "tc": "你至今曾獲得過的",
          "sc": "你至今曾获得过的"
        },
        {
          "f_idx": 7,
          "pidx_tc": 469103,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一覧で載ってるんだよ",
          "tc": "所有家具。",
          "sc": "所有家具。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 469114,
          "spk": "琪娜娜 (チナナ)",
          "ja": "欲しいものを選んで注文してくれれば、",
          "tc": "只要選好想要的商品下單訂購，",
          "sc": "只要选好想要的商品下单订购，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 469121,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチが郵送でキミの家まで届けるって仕組みさ",
          "tc": "我就會用郵寄的方式送到你家。",
          "sc": "我就会用邮寄的方式送到你家。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 469139,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ただし、<strong>一日のうちに",
          "tc": "不過一天最多只能訂購",
          "sc": "不过一天最多只能订购"
        },
        {
          "f_idx": 12,
          "pidx_tc": 469146,
          "spk": "琪娜娜 (チナナ)",
          "ja": "注文できる家具は五種類</strong>までだよ",
          "tc": "<strong>五種</strong>家具喔。",
          "sc": "<strong>五种</strong>家具哦。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 469157,
          "spk": "琪娜娜 (チナナ)",
          "ja": "同じ家具なら何個でも注文できるけど、",
          "tc": "如果是同一款家具的話想訂幾個都可以，",
          "sc": "如果是同一款家具的话想订几个都可以，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 469164,
          "spk": "琪娜娜 (チナナ)",
          "ja": "種類は増やせないから、",
          "tc": "但不能增加訂購的種類，",
          "sc": "但不能增加订购的种类，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 469171,
          "spk": "琪娜娜 (チナナ)",
          "ja": "その辺はよく考えておくれ",
          "tc": "所以要好好考慮一下。",
          "sc": "所以要好好考虑一下。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 469184,
          "spk": "茶梅 (サザンカ)",
          "ja": "一日に五種類までかぁ",
          "tc": "一天只能訂五種啊。",
          "sc": "一天只能订五种啊。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 469195,
          "spk": "茶梅 (サザンカ)",
          "ja": "まぁ……そんなに一気に頼むこともないし、",
          "tc": "不過……通常也不會一次訂那麼多，",
          "sc": "不过……通常也不会一次订那么多，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 469202,
          "spk": "茶梅 (サザンカ)",
          "ja": "十分かな～",
          "tc": "應該很足夠了吧～",
          "sc": "应该很足够了吧～"
        },
        {
          "f_idx": 19,
          "pidx_tc": 469215,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、もう一つ、",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 469222,
          "spk": "琪娜娜 (チナナ)",
          "ja": "伝えとくことがあるんだった",
          "tc": "還有一件事得先告訴你。",
          "sc": "还有一件事得先告诉你。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 469233,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カタログで注文する場合、",
          "tc": "透過目錄訂購商品時，",
          "sc": "透过目录订购商品时，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 469240,
          "spk": "琪娜娜 (チナナ)",
          "ja": "少しだけ手数料をいただくよ",
          "tc": "會收取一點手續費喔。",
          "sc": "会收取一点手续费哦。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 469251,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<strong>家具の値段に、価格の5％だけ",
          "tc": "<strong>訂購時會在",
          "sc": "<strong>订购时会在"
        },
        {
          "f_idx": 24,
          "pidx_tc": 469258,
          "spk": "琪娜娜 (チナナ)",
          "ja": "売価を上乗せさせてもらうよ</strong>",
          "tc": "家具售價裡加上５％的費用</strong>。",
          "sc": "家具售价里加上５％的费用</strong>。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 469265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけどよろしくね",
          "tc": "還請見諒囉。",
          "sc": "还请多多包涵啦。"
        }
      ]
    },
