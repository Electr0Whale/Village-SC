          "pidx_tc": 469941,
          "spk": "木助 (キスケ)",
          "ja": "また骨が折れる仕事になるだろうが、",
          "tc": "接下來恐怕得花不少力氣整地，",
          "sc": "接下来恐怕得花不少力气整地，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 469948,
          "spk": "木助 (キスケ)",
          "ja": "せっかく買った土地なんだ",
          "tc": "不過既然你都買下這塊土地了，",
          "sc": "不过既然你都买下这块土地了，"
