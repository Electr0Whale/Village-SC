  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8065,
      "rec_id": "TALK_ID_10_0102_030_02_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213767,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃ、姉さん",
          "tc": "先這樣吧，姊姊。",
          "sc": "先这样吧，姐姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213774,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は遊びに出かけるから",
          "tc": "我要去外面玩囉。",
          "sc": "我要出去玩啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213787,
          "spk": "莲实 (ハスミ)",
          "ja": "えっ……スミレ……",
          "tc": "咦……堇怜……",
          "sc": "咦……堇怜……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213794,
          "spk": "莲实 (ハスミ)",
          "ja": "お昼ご飯は……",
          "tc": "午餐呢……",
          "sc": "午餐呢……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213807,
          "spk": "堇怜 (スミレ)",
          "ja": "いらない！",
          "tc": "不用了！",
          "sc": "不用了！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213814,
          "spk": "堇怜 (スミレ)",
          "ja": "もしお腹が減っても、",
          "tc": "就算我真的肚子餓了，",
          "sc": "就算我真的肚子饿了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 213821,
          "spk": "堇怜 (スミレ)",
          "ja": "兵糧丸つくってカジるから大丈夫！",
          "tc": "我也會自己做兵糧丸來吃的，別擔心！",
          "sc": "我也会自己做兵粮丸来吃的，别担心！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 213832,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃ、姉さん、行ってきます！",
          "tc": "那麼，姊姊，我先走了！",
          "sc": "那么，姐姐，我先走了！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 213839,
          "spk": "堇怜 (スミレ)",
          "ja": "チナナさん、<player>、またね！",
          "tc": "琪娜娜姐、<player>，再見囉！",
          "sc": "琪娜娜姐、<player>，再见啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8066,
      "rec_id": "TALK_ID_10_0102_030_02_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213867,
          "spk": "莲实 (ハスミ)",
          "ja": "もう……",
          "tc": "真是的……",
          "sc": "真是的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213874,
          "spk": "莲实 (ハスミ)",
          "ja": "本当に大丈夫かしら……",
          "tc": "真的沒問題嗎……",
          "sc": "真的没问题吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8067,
      "rec_id": "TALK_ID_10_0102_030_02_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213924,
          "spk": "莲实 (ハスミ)",
          "ja": "ところでチナナ、",
          "tc": "話說回來，琪娜娜，",
          "sc": "话说回来，琪娜娜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213931,
          "spk": "莲实 (ハスミ)",
          "ja": "私に用事とは……",
          "tc": "妳找我有什麼事……",
          "sc": "你找我有什么事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213944,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、そうだったね",
          "tc": "啊，對。",
          "sc": "啊，对。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213951,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はお願いがあってきたんだよ",
          "tc": "今天我是有事來拜託妳的。",
          "sc": "今天我是有事来拜托你的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213962,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、小さいのに",
          "tc": "<player>明明這麼小，",
          "sc": "<player>明明这么小，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213969,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大変な仕事をしているだろう？",
          "tc": "卻做著那麼辛苦的工作。",
          "sc": "却做着那么辛苦的工作。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 213980,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも頼み事を請け負ってもらったから、",
          "tc": "我也有拜託他幫忙，",
          "sc": "我也有拜托他帮忙，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 213987,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この子にも<strong>「兵糧丸」</strong>の作り方を",
          "tc": "所以不知道可不可以請妳教他",
          "sc": "所以不知道可不可以请你教他"
        },
        {
          "f_idx": 8,
          "pidx_tc": 213994,
          "spk": "琪娜娜 (チナナ)",
          "ja": "教えてあげてほしいんだけど、いいかな？",
          "tc": "<strong>「兵糧丸」</strong>的製作方法呢？",
          "sc": "<strong>“兵粮丸”</strong>的制作方法呢？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 214007,
          "spk": "莲实 (ハスミ)",
          "ja": "なるほど、それが用事ということね",
          "tc": "原來如此，是這件事啊。",
          "sc": "原来如此，是这件事啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 214014,
          "spk": "莲实 (ハスミ)",
          "ja": "もちろん構わないわ",
          "tc": "當然可以。",
          "sc": "当然可以。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8068,
      "rec_id": "TALK_ID_10_0102_030_02_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214040,
          "spk": "莲实 (ハスミ)",
          "ja": "このメモに作り方が書いてあります",
          "tc": "我把做法寫在紙條上了，",
          "sc": "我把做法写在纸条上了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214047,
          "spk": "莲实 (ハスミ)",
          "ja": "どうぞ、受け取ってください",
          "tc": "請你收下吧。",
          "sc": "请你收下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8069,
      "rec_id": "TALK_ID_10_0102_030_02_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214071,
          "spk": "莲实 (ハスミ)",
          "ja": "その、<strong>兵糧丸</strong>というものは、",
          "tc": "所謂的<strong>兵糧丸</strong>",
          "sc": "所谓的<strong>兵粮丸</strong>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214078,
          "spk": "莲实 (ハスミ)",
          "ja": "野草から取れる実や根を使った",
          "tc": "是用野草的果實、草根製成的，",
          "sc": "是用野草的果实、草根制成的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214085,
          "spk": "莲实 (ハスミ)",
          "ja": "昔から食べられている非常食なんです",
          "tc": "從以前就有人在吃，是傳統應急糧食。",
          "sc": "从以前就有人在吃，是传统应急粮食。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214096,
          "spk": "莲实 (ハスミ)",
          "ja": "作り方は簡単なので、",
          "tc": "做法也很簡單，",
          "sc": "做法也很简单，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214103,
          "spk": "莲实 (ハスミ)",
          "ja": "材料を作業台で加工すれば、",
          "tc": "只要備好材料在工作台加工，",
          "sc": "只要备好材料在工作台加工，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 214110,
          "spk": "莲实 (ハスミ)",
          "ja": "きっとすぐに作ることが出来ますよ",
          "tc": "應該很快就能做出來了。",
          "sc": "应该很快就能做出来了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 214121,
          "spk": "莲实 (ハスミ)",
          "ja": "疲れて動けなくなった時に、",
          "tc": "要是你累到動彈不得，",
          "sc": "要是你累到动弹不得，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 214128,
          "spk": "莲实 (ハスミ)",
          "ja": "食べてみてくださいね",
          "tc": "可以拿出來吃看看。",
          "sc": "可以拿出来吃看看。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 214135,
          "spk": "莲实 (ハスミ)",
          "ja": "……味は保証できませんが",
          "tc": "……只是味道方面就沒辦法保證了。",
          "sc": "……只是味道方面就没办法保证了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8070,
      "rec_id": "TALK_ID_10_0102_030_02_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214159,
          "spk": "莲实 (ハスミ)",
          "ja": "でも、兵糧丸があるからといって、",
          "tc": "不過，就算有了兵糧丸，",
          "sc": "不过，就算有了兵粮丸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214166,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレのようにご飯を抜いてはいけませんよ",
          "tc": "也不能像堇怜那樣不吃正餐喔。",
          "sc": "也不能像堇怜那样不吃正餐哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214173,
          "spk": "莲实 (ハスミ)",
          "ja": "本当は<strong>ご飯を食べて、スタミナをつけないと</strong>",
          "tc": "正常是要<strong>吃飯補充體力才行的</strong>。",
          "sc": "正常是要<strong>吃饭补充体力才行的</strong>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214184,
          "spk": "莲实 (ハスミ)",
          "ja": "あまりご無理されないよう",
          "tc": "不要太過勉強自己，",
          "sc": "不要太过勉强自己，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214191,
          "spk": "莲实 (ハスミ)",
          "ja": "体調と相談しながら、",
          "tc": "視情況量力而為，",
          "sc": "视情况量力而为，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 214198,
          "spk": "莲实 (ハスミ)",
          "ja": "お仕事、頑張ってくださいね",
          "tc": "努力工作吧。",
          "sc": "努力工作吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8071,
      "rec_id": "TALK_ID_10_0102_030_02_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにしても……",
          "tc": "不過話說回來……",
          "sc": "不过话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミ、この子はなんというか……",
          "tc": "蓮實，這個孩子該怎麼說呢……",
          "sc": "莲实，这个孩子该怎么说呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214238,
          "spk": "琪娜娜 (チナナ)",
          "ja": "噂通りの出で立ちだと思わないかい……？",
          "tc": "不覺得這身打扮正如傳聞所說的那樣嗎……？",
          "sc": "不觉得这身打扮正如传闻所说的那样吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8072,
      "rec_id": "TALK_ID_10_0102_030_02_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214256,
          "spk": "莲实 (ハスミ)",
          "ja": "……チナナ",
          "tc": "……琪娜娜，",
          "sc": "……琪娜娜，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214263,
          "spk": "莲实 (ハスミ)",
          "ja": "あんまりジロジロ見ては失礼よ",
          "tc": "別一直盯著看，這樣很失禮喔。",
          "sc": "别一直盯着看，这样很失礼哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214276,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ふふ……これからの活躍に",
          "tc": "呵呵……我只是想要說對於你今後的表現",
          "sc": "呵呵……我只是想要说对于你今后的表现"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214283,
          "spk": "琪娜娜 (チナナ)",
          "ja": "期待しているって言いたいのさ",
          "tc": "我很期待喔。",
          "sc": "我很期待哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8073,
      "rec_id": "TALK_ID_10_0102_030_02_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214303,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……さて、用事は済んだし",
          "tc": "……那麼，事情都辦完了，",
          "sc": "……那么，事情都办完了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214310,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチももう行くよ",
          "tc": "我也要走了。",
          "sc": "我也要走了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214317,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、今後ともごひいきにね",
          "tc": "<player>，今後也請你多多關照啦。",
          "sc": "<player>，今后也请你多多关照啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214330,
          "spk": "莲实 (ハスミ)",
          "ja": "では、私も仕事に戻りますね",
          "tc": "那麼，我也回去忙了。",
          "sc": "那么，我也回去忙了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214337,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん、具合が悪くなったら、",
          "tc": "<player>，如果你身體有什麼不舒服，",
          "sc": "<player>，如果你身体有什么不舒服，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 214344,
          "spk": "莲实 (ハスミ)",
          "ja": "お気軽にご相談ください",
          "tc": "可以隨時來找我商量。",
          "sc": "可以随时来找我商量。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8074,
      "rec_id": "TALK_ID_10_0102_031_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205870,
          "spk": "茶梅 (サザンカ)",
          "ja": "いらっしゃ～い",
          "tc": "歡迎光臨～",
          "sc": "欢迎光临～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205881,
          "spk": "茶梅 (サザンカ)",
          "ja": "とりあえず最近のオススメ商品は……",
          "tc": "總之，最近的推薦商品是……",
          "sc": "总之，最近的推荐商品是……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205888,
          "spk": "茶梅 (サザンカ)",
          "ja": "持ち物が多いと困るから、",
          "tc": "隨身物品太多會很麻煩，",
          "sc": "随身物品太多会很麻烦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205895,
          "spk": "茶梅 (サザンカ)",
          "ja": "やっぱカバンじゃね……？",
          "tc": "有個包包應該不錯吧……？",
          "sc": "有个包包应该不错吧……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205906,
          "spk": "茶梅 (サザンカ)",
          "ja": "そう言えばアンタ、",
          "tc": "話說，你不是從裕太那裡",
          "sc": "话说，你不是从裕太那里"
        },
        {
          "f_idx": 5,
          "pidx_tc": 205913,
          "spk": "茶梅 (サザンカ)",
          "ja": "ユータからメモ帳をもらってたんじゃない？",
          "tc": "拿到了筆記本嗎？",
          "sc": "拿到了笔记本吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 205924,
          "spk": "茶梅 (サザンカ)",
          "ja": "いい機会だから使ってみたら？",
          "tc": "趁這個機會用看看吧？",
          "sc": "趁这个机会用看看吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8075,
      "rec_id": "TALK_ID_10_0102_031_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205948,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちゃんとメモった？",
          "tc": "記好了嗎？",
          "sc": "记好了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205955,
          "spk": "茶梅 (サザンカ)",
          "ja": "一応確認しておきなよ",
          "tc": "先確認看看吧。",
          "sc": "先确认看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8076,
      "rec_id": "TALK_ID_10_0102_031_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205979,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、アンタみたいに忙しいヤツは",
          "tc": "不過像你這麼忙的人，",
          "sc": "不过像你这么忙的人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205986,
          "spk": "茶梅 (サザンカ)",
          "ja": "やりたいことを忘れないためにも、",
          "tc": "為了不忘記該做的事情，",
          "sc": "为了不忘记该做的事情，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205993,
          "spk": "茶梅 (サザンカ)",
          "ja": "メモるクセをつけるといいかもね",
          "tc": "養成做筆記的習慣應該滿有用的。",
          "sc": "养成做笔记的习惯应该满有用的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 206004,
          "spk": "茶梅 (サザンカ)",
          "ja": "うちの商品だけじゃなくて<strong>別の店の商品</strong>や、",
          "tc": "不只是我店裡的商品，<strong>其他店的商品</strong>、",
          "sc": "不只是我店里的商品，<strong>其他店的商品</strong>、"
        },
        {
          "f_idx": 4,
          "pidx_tc": 206011,
          "spk": "茶梅 (サザンカ)",
          "ja": "<strong>頼まれごと</strong>、<strong>やること</strong>、<strong>目標</strong>……",
          "tc": "<strong>委託要辦的事</strong>、<strong>該做的事</strong>、<strong>目標</strong>……",
          "sc": "<strong>委托要办的事</strong>、<strong>该做的事</strong>、<strong>目标</strong>……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 206018,
          "spk": "茶梅 (サザンカ)",
          "ja": "とりあえずメモっといて損はないからね",
          "tc": "總之都記下來，不會有壞處的啦。",
          "sc": "总之都记下来，不会有坏处的啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8077,
      "rec_id": "TALK_ID_10_0102_031_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 206042,
          "spk": "茶梅 (サザンカ)",
          "ja": "早くお金を稼いでおいでよ",
          "tc": "快點去賺錢，再來找我吧。",
          "sc": "快点去赚钱，再来找我吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 206049,
          "spk": "茶梅 (サザンカ)",
          "ja": "ボーっとしてるとアンタの欲しいもの、",
          "tc": "要是拖拖拉拉，你想要的東西",
          "sc": "要是拖拖拉拉，你想要的东西"
