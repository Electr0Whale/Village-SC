        {
          "f_idx": 1,
          "pidx_tc": 78089,
          "spk": "六角 (ロッカク)",
          "ja": "気がつけば、籠の中がもう一杯だ",
          "tc": "一回過神來就發現竹簍已經滿了。",
          "sc": "一回过神来就发现竹篓已经满了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 78100,
          "spk": "六角 (ロッカク)",
          "ja": "魚たちも冬に備えてるのかもしれないっスね",
          "tc": "這些魚可能也在準備過冬吧。",
          "sc": "这些鱼可能也在准备过冬呐。"
