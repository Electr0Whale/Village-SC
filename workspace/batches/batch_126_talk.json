          "f_idx": 0,
          "pidx_tc": 77803,
          "spk": "六角 (ロッカク)",
          "ja": "だんだんと肌寒くなってきて、",
          "tc": "天氣開始漸漸變冷了，",
          "sc": "天气开始渐渐变冷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 77810,
          "spk": "六角 (ロッカク)",
          "ja": "温かい飯が恋しい季節なんスよね",
          "tc": "到了這個季節就想吃熱騰騰的飯呢。",
          "sc": "到了这个季节就想吃热腾腾的饭呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 77828,
          "spk": "六角 (ロッカク)",
          "ja": "……そろそろ店でも出してみるか",
          "tc": "……差不多可以在店裡賣了。",
          "sc": "……差不多可以在店里卖了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1569,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 77859,
          "spk": "六角 (ロッカク)",
          "ja": "ロッカクよ、今日も一日善き人であれ",
          "tc": "六角啊，你今天也要當個好人喔。",
          "sc": "六角啊，今天也要当个好人呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 77877,
          "spk": "六角 (ロッカク)",
          "ja": "じゃないと、",
          "tc": "不然，",
          "sc": "不然，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 77884,
          "spk": "六角 (ロッカク)",
          "ja": "あの人たちに顔向けできないっスからね……",
          "tc": "你會對不起那些人的……",
          "sc": "你会对不起那些人的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1570,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 77908,
          "spk": "六角 (ロッカク)",
          "ja": "こうしてみると、秋の空ってのは",
          "tc": "這樣一看，會發現秋天的天空",
          "sc": "这样一看，会发现秋天的天空"
        },
        {
          "f_idx": 1,
          "pidx_tc": 77915,
          "spk": "六角 (ロッカク)",
          "ja": "本当に高いんスよねえ……不思議っス",
          "tc": "真的很高很遠……真是神奇啊。",
          "sc": "真的很高很远……真是神奇呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1571,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 77946,
          "spk": "六角 (ロッカク)",
          "ja": "こうして朝からのんびりする時間ってのは、",
          "tc": "能像這樣從一早就度過這麼愜意的時光，",
          "sc": "能像这样从一早就度过这么惬意的时光，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 77953,
          "spk": "六角 (ロッカク)",
          "ja": "最高の贅沢の一つだと思うんスよ",
          "tc": "我覺得這就是最奢侈的享受之一。",
          "sc": "我觉得这就是最奢侈的享受之一。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 77964,
          "spk": "六角 (ロッカク)",
          "ja": "ふぁーあ、朝から眠くなってきちまった……",
          "tc": "呼啊，明明還一大早的卻開始想睡了……",
          "sc": "呼啊，明明还一大早的却开始想睡了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1572,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 77995,
          "spk": "六角 (ロッカク)",
          "ja": "最近、ここで妙に人に会うんスよね",
          "tc": "最近莫名常常在這裡遇到其他人。",
          "sc": "最近莫名常常在这里遇到其他人。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 78013,
          "spk": "六角 (ロッカク)",
          "ja": "もしかして、この小さい村の中で",
          "tc": "難道這個小小的村子",
          "sc": "难道这个小小的村子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 78020,
          "spk": "六角 (ロッカク)",
          "ja": "釣りが流行ってたりするんスかね……？",
          "tc": "正在流行釣魚嗎……？",
          "sc": "正在流行钓鱼吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1573,
      "rec_id": "TALK_ID_OLD_MAN_ROUTINE_20_107_3111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 78044,
          "spk": "六角 (ロッカク)",
          "ja": "最近、目が悪くなったのか",
          "tc": "最近不知道是不是視力變差了，",
          "sc": "最近不知道是不是视力变差了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 78051,
          "spk": "六角 (ロッカク)",
          "ja": "ウキがよく見えないんスよ……年かな",
          "tc": "開始有點看不清楚浮標……可能是年紀到了吧。",
          "sc": "开始有点看不清楚浮标……可能是年纪到了吧。"
        }
      ]
    },
    {
