      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 78082,
          "spk": "六角 (ロッカク)",
          "ja": "今日はずいぶんとに食いつきがいいな",
          "tc": "今天釣得還不錯，",
          "sc": "今天钓得还不错，"
