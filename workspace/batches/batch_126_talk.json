          "pidx_tc": 78138,
          "spk": "六角 (ロッカク)",
          "ja": "雨の時って妙に山菜が見つかる気がするんスよ",
          "tc": "不過在下雨天好像都能莫名地發現一些山菜呢。",
          "sc": "不过在下雨天好像都能莫名地发现一些山菜呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 78156,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、気のせいかもしれないっス",
          "tc": "也有可能是我的錯覺吧。",
          "sc": "也有可能是我的错觉呐。"
        }
      ]
