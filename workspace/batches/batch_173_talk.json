      "rec_id": "TALK_ID_10_0102_040_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212313,
          "spk": "洋 (ヨウ)",
          "ja": "でも、<player>がワンちゃんを呼んで、",
          "tc": "不過，是<player>他呼喚了狗狗，",
          "sc": "不过，是<player>他呼唤了狗狗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212320,
          "spk": "洋 (ヨウ)",
          "ja": "この場所をシロージさんに知らせてくれたの",
          "tc": "才讓四郎治哥哥找到這個地方的。",
          "sc": "才让四郎治哥哥找到这个地方的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 212340,
          "spk": "林 (リン)",
          "ja": "そんなことより！！",
          "tc": "先別說那麼多！！",
          "sc": "先别说那么多！！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 212347,
          "spk": "林 (リン)",
          "ja": "深夜まで時間がないわ！",
          "tc": "離深夜沒多少時間了！",
          "sc": "离深夜没多少时间了！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 212354,
          "spk": "林 (リン)",
          "ja": "急いで帰りましょう！",
          "tc": "我們趕快回去吧！",
          "sc": "我们赶快回去吧！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 212363,
          "spk": "林 (リン)",
          "ja": "探しに出てくれたみんなにも",
          "tc": "還得把找到人的事",
          "sc": "还得把找到人的事"
        },
        {
          "f_idx": 7,
          "pidx_tc": 212370,
          "spk": "林 (リン)",
          "ja": "伝えてこなくちゃ！",
          "tc": "通知來幫忙找的大家才行！",
          "sc": "通知来帮忙找的大家才行！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3767,
      "rec_id": "TALK_ID_10_0102_040_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212428,
          "spk": "洋 (ヨウ)",
          "ja": "……？",
          "tc": "……？",
          "sc": "……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212435,
          "spk": "洋 (ヨウ)",
          "ja": "なんのこと？",
          "tc": "什麼意思？",
          "sc": "什么意思？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212446,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはスミレくんとユータさんに、",
          "tc": "我只是擔心",
          "sc": "我只是担心"
        },
        {
          "f_idx": 3,
          "pidx_tc": 212453,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃんが見つからないか",
          "tc": "堇怜哥哥和裕太哥哥",
          "sc": "堇怜哥哥和裕太哥哥"
        },
        {
          "f_idx": 4,
          "pidx_tc": 212460,
          "spk": "洋 (ヨウ)",
          "ja": "心配だっただけで……",
          "tc": "會不會找到嗶羅而已……",
          "sc": "会不会找到哔罗而已……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3768,
      "rec_id": "TALK_ID_10_0102_040_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212478,
          "spk": "四郎治 (シロージ)",
          "ja": "……そうか",
          "tc": "……這樣啊。",
          "sc": "……这样啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3769,
      "rec_id": "TALK_ID_10_0102_040_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212502,
          "spk": "林 (リン)",
          "ja": "ちょっと！",
          "tc": "喂！",
          "sc": "喂！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212509,
          "spk": "林 (リン)",
          "ja": "反省する気ある！？",
          "tc": "妳真的有在反省嗎！？",
          "sc": "你真的有在反省吗！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212516,
          "spk": "林 (リン)",
          "ja": "早く来なさい！",
          "tc": "快點過來！",
          "sc": "快点过来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3770,
      "rec_id": "TALK_ID_10_0102_040_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212534,
          "spk": "洋 (ヨウ)",
          "ja": "は……はい！！",
          "tc": "好……好的！！",
          "sc": "好……好的！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3771,
      "rec_id": "TALK_ID_10_0102_040_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212560,
          "spk": "四郎治 (シロージ)",
          "ja": "お前……指笛、練習しておいて",
          "tc": "還好你有",
          "sc": "还好你有"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212567,
          "spk": "四郎治 (シロージ)",
          "ja": "よかったな",
          "tc": "先練好手哨。",
          "sc": "先练好手哨。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212578,
          "spk": "四郎治 (シロージ)",
          "ja": "俺は、木こりのシロージだ",
          "tc": "我是樵夫四郎治。",
          "sc": "我是樵夫四郎治。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 212585,
          "spk": "四郎治 (シロージ)",
          "ja": "山に居るから、用事があったら会いに来てくれ",
          "tc": "我平常都在山裡，有事的話可以來找我。",
          "sc": "我平常都在山里，有事的话可以来找我。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 212603,
          "spk": "四郎治 (シロージ)",
          "ja": "さあ、午後１１時になる前に帰ろうか",
          "tc": "好了，得在晚上11點前回去。",
          "sc": "好了，得在晚上11点前回去。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 212610,
          "spk": "四郎治 (シロージ)",
          "ja": "掟は守らないとな",
          "tc": "必須遵守規矩。",
          "sc": "必须遵守规矩。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3772,
      "rec_id": "TALK_ID_10_0102_041_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212684,
          "spk": "？？？ (未知角色)",
          "ja": "鶏小屋はウチじゃなくて、",
          "tc": "雞舍的事別找我，",
          "sc": "鸡舍的事别找我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212691,
          "spk": "？？？ (未知角色)",
          "ja": "キスケに言わないとだよ",
          "tc": "要去問木助才對啊。",
          "sc": "要去问木助才对啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3773,
      "rec_id": "TALK_ID_10_0102_041_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212707,
          "spk": "洋 (ヨウ)",
          "ja": "キスケさんはイジワルだから、",
          "tc": "木助叔叔愛欺負人，",
          "sc": "木助叔叔爱欺负人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212714,
          "spk": "洋 (ヨウ)",
          "ja": "相手にしてくれなかったんだもん",
          "tc": "他才不會理我呢。",
          "sc": "他才不会理我呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212725,
          "spk": "？？？ (未知角色)",
          "ja": "ヨウ……それは……",
          "tc": "洋……那是因為……",
          "sc": "洋……那是因为……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 212732,
          "spk": "？？？ (未知角色)",
          "ja": "その石じゃ全然足りないからだよ",
          "tc": "那點石頭完全不夠啊。",
          "sc": "那点石头完全不够啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 212750,
          "spk": "洋 (ヨウ)",
          "ja": "じ、じゃあ、",
          "tc": "那、那麼，",
          "sc": "那、那么，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 212757,
          "spk": "洋 (ヨウ)",
          "ja": "この石をお金にして……",
          "tc": "先把這石頭換成錢……",
          "sc": "先把这石头换成钱……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 212768,
          "spk": "？？？ (未知角色)",
          "ja": "それじゃニワトリのエサ",
          "tc": "那也只能抵上",
          "sc": "那也只能抵上"
        },
        {
          "f_idx": 8,
          "pidx_tc": 212775,
          "spk": "？？？ (未知角色)",
          "ja": "三日分くらいにしかならないよ",
          "tc": "三天份的雞飼料錢而已。",
          "sc": "三天份的鸡饲料钱而已。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 212786,
          "spk": "洋 (ヨウ)",
          "ja": "なら、どこで飼えばいいの……",
          "tc": "那我該在哪裡養牠……",
          "sc": "那我该在哪里养它……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 212793,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんにお肉にされちゃうよ",
          "tc": "叔叔會把牠變成肉吃掉的！",
          "sc": "叔叔会把它变成肉吃掉的！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 212804,
          "spk": "？？？ (未知角色)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3774,
      "rec_id": "TALK_ID_10_0102_041_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212820,
          "spk": "？？？ (未知角色)",
          "ja": "あ、キミ、やっと来てくれたね",
          "tc": "啊，你終於來了。",
          "sc": "啊，你终于来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212827,
          "spk": "？？？ (未知角色)",
          "ja": "ちょっとおいでよ",
          "tc": "過來一下。",
          "sc": "过来一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3775,
      "rec_id": "TALK_ID_10_0102_041_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212849,
          "spk": "？？？ (未知角色)",
          "ja": "キミ、例の新しく来た子どもでしょ",
          "tc": "你就是那個新來的孩子吧。",
          "sc": "你就是那个新来的孩子吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212865,
          "spk": "？？？ (未知角色)",
          "ja": "あの庭のほったて小屋にすんでるっていう",
          "tc": "聽說你住在那座庭院裡的簡陋小屋啊。",
          "sc": "听说你住在那座庭院里的简陋小屋啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 212883,
          "spk": "？？？ (未知角色)",
          "ja": "確かキミのお庭にさ、",
          "tc": "我記得你那個庭院裡，",
          "sc": "我记得你那个庭院里，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 212890,
          "spk": "？？？ (未知角色)",
          "ja": "古い鶏小屋があったよね？",
          "tc": "有個老舊的雞舍？",
          "sc": "有个老旧的鸡舍？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3777,
      "rec_id": "TALK_ID_10_0102_041_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213212,
          "spk": "？？？ (未知角色)",
          "ja": "ふう……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213219,
          "spk": "？？？ (未知角色)",
          "ja": "丸く収まって、よかったよかった",
          "tc": "一切都圓滿收場，真是太好了。",
          "sc": "一切都圆满收场，真是太好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3778,
      "rec_id": "TALK_ID_10_0102_042_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214372,
          "spk": "洋 (ヨウ)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214379,
          "spk": "洋 (ヨウ)",
          "ja": "チナナさんと",
          "tc": "我把琪娜娜姐姐，",
          "sc": "我把琪娜娜姐姐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214386,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃんをつれてきたよ",
          "tc": "還有嗶羅都帶過來了。",
          "sc": "还有哔罗都带过来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ピロちゃんは約束通り、",
          "tc": "照之前說好的，",
          "sc": "照之前说好的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214406,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あそこの鶏小屋に入れておいたよ",
          "tc": "我把嗶羅放進那邊的雞舍了。",
          "sc": "我把哔罗放进那边的鸡舍了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3779,
      "rec_id": "TALK_ID_10_0102_042_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214422,
          "spk": "洋 (ヨウ)",
          "ja": "チナナさん、見てきてもいい？",
          "tc": "琪娜娜姐姐，我可以去看看嗎？",
          "sc": "琪娜娜姐姐，我可以去看看吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3780,
      "rec_id": "TALK_ID_10_0102_042_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214440,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうぞ～",
          "tc": "請～",
          "sc": "请～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3781,
      "rec_id": "TALK_ID_10_0102_042_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214466,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、キミのヒヨコでもあるんだよ",
          "tc": "<player>，牠也算是你的小雞了。",
          "sc": "<player>，它也算是你的小鸡了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214473,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミも一緒に見に行こう",
          "tc": "你也一起去看看吧。",
          "sc": "你也一起去看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3782,
      "rec_id": "TALK_ID_10_0102_042_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214497,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、ここが鶏小屋だ",
          "tc": "看，這裡就是雞舍。",
          "sc": "看，这里就是鸡舍。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214504,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大きい扉はキミ用で……",
          "tc": "大的門是給你用的……",
          "sc": "大的门是给你用的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小さい方は家畜用の出入り口だよ",
          "tc": "而小的門就是家畜專用的進出口。",
          "sc": "而小的门就是家畜专用的进出口。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3783,
      "rec_id": "TALK_ID_10_0102_042_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214529,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、中に入ってみよう",
          "tc": "好了，進去看看。",
          "sc": "好了，进去看看。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214536,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ヒヨコの様子を見てみなよ",
          "tc": "觀察一下小雞吧。",
          "sc": "观察一下小鸡吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3784,
      "rec_id": "TALK_ID_10_0102_042_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214560,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん、よかったね",
          "tc": "真是太好了呢，嗶羅，",
          "sc": "真是太好了呢，哔罗，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214567,
          "spk": "洋 (ヨウ)",
          "ja": "暖かいお家ができて",
          "tc": "你有了個溫暖的家。",
          "sc": "你有了个温暖的家。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3785,
      "rec_id": "TALK_ID_10_0102_042_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214591,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ピロちゃんもヨウも、",
          "tc": "太好了，嗶羅跟洋",
          "sc": "太好了，哔罗跟洋"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214598,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嬉しそうでよかったよかった",
          "tc": "看起來都很開心的樣子。",
          "sc": "看起来都很开心的样子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3786,
      "rec_id": "TALK_ID_10_0102_042_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あ、そうだ",
          "tc": "啊，對了。",
          "sc": "啊，对了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ヒヨコの育て方のチラシがあるんだった",
          "tc": "我這裡有份關於養育小雞的傳單。",
          "sc": "我这里有份关于养育小鸡的传单。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214630,
          "spk": "琪娜娜 (チナナ)",
          "ja": "コレ、読んでみて",
          "tc": "你可以看看這個。",
          "sc": "你可以看看这个。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3787,
      "rec_id": "TALK_ID_10_0102_042_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214654,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>も、ちゃんとお世話してあげてね",
          "tc": "<player>也要用心照顧牠喔。",
          "sc": "<player>也要用心照顾它哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214661,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのうちニワトリになって、",
          "tc": "之後牠會長大成雞，",
          "sc": "之后它会长大成鸡，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214668,
          "spk": "琪娜娜 (チナナ)",
          "ja": "タマゴを産んでくれるだろうから",
          "tc": "接著開始下蛋吧。",
          "sc": "接着开始下蛋吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3788,
      "rec_id": "TALK_ID_10_0102_042_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214692,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あそこに見えるのは「ホッパー」だよ",
          "tc": "而那邊的東西就是「儲料斗」。",
          "sc": "而那边的东西就是“储料斗”。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214699,
          "spk": "琪娜娜 (チナナ)",
          "ja": "家畜の飼料を貯めておけるんだ",
          "tc": "可以把家畜的飼料存放在裡面。",
          "sc": "可以把家畜的饲料存放在里面。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214708,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今回は、飼料を無料でつけてあげるよ",
          "tc": "這次就先免費送你飼料吧。",
          "sc": "这次就先免费送你饲料吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214715,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ホッパーに入れておいたから、",
          "tc": "我放在儲料斗裡了，",
          "sc": "我放在储料斗里了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214722,
          "spk": "琪娜娜 (チナナ)",
          "ja": "取り出して、鶏小屋のエサ箱に置いてあげてね",
          "tc": "你可以拿出來，放進雞舍的飼料箱裡面。",
          "sc": "你可以拿出来，放进鸡舍的饲料箱里面。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3789,
      "rec_id": "TALK_ID_10_0102_042_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214740,
          "spk": "琪娜娜 (チナナ)",
          "ja": "エサが足りなくなったら、",
          "tc": "要是飼料不夠了，",
          "sc": "要是饲料不够了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214747,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミの<strong>庭に生えている牧草を刈って</strong>",
          "tc": "你可以<strong>割下庭院生長的牧草</strong>",
          "sc": "你可以<strong>割下庭院生长的牧草</strong>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214754,
          "spk": "琪娜娜 (チナナ)",
          "ja": "飼料にするといい",
          "tc": "用來當飼料。",
          "sc": "用来当饲料。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 214763,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<strong>牧草</strong>ってのは、足の長い草だよ",
          "tc": "所謂的<strong>牧草</strong>，是那些長得比較高的草，",
          "sc": "所谓的<strong>牧草</strong>，是那些长得比较高的草，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 214770,
          "spk": "琪娜娜 (チナナ)",
          "ja": "覚えておいて",
          "tc": "要記得喔。",
          "sc": "要记得哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 214781,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、でも、牧草を刈るには<strong>カマ</strong>が要るね……",
          "tc": "啊，不過要割牧草的話，你還需要<strong>鐮刀</strong>……",
          "sc": "啊，不过要割牧草的话，你还需要<strong>镰刀</strong>……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 214788,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<strong>雑貨店でも売ってる</strong>から、",
          "tc": "<strong>雜貨店有賣</strong>，",
          "sc": "<strong>杂货店有卖</strong>，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 214795,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そっちは自分でお金を貯めて、買うといい",
          "tc": "你就自己存錢去買吧。",
          "sc": "你就自己存钱去买吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 214806,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、キミも動物を飼いたかったら",
          "tc": "<player>，如果你還想養其他動物，",
          "sc": "<player>，如果你还想养其他动物，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 214813,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチに言っておくれ",
          "tc": "可以跟我說。",
          "sc": "可以跟我说。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 214824,
          "spk": "琪娜娜 (チナナ)",
          "ja": "月、水、金、日曜日に",
          "tc": "每個星期一、三、五、日，",
          "sc": "每个星期一、三、五、日，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 214831,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雑貨店の隣で開いているウチの露店で",
          "tc": "我會在雜貨店旁邊擺攤，",
          "sc": "我会在杂货店旁边摆摊，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 214838,
          "spk": "琪娜娜 (チナナ)",
          "ja": "買えるからね",
          "tc": "攤位上就可以買到動物。",
          "sc": "摊位上就可以买到动物。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 214851,
          "spk": "琪娜娜 (チナナ)",
          "ja": "買った動物はすぐに",
          "tc": "你買下的動物，",
          "sc": "你买下的动物，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 214858,
          "spk": "琪娜娜 (チナナ)",
          "ja": "このお庭まで連れてきてあげるよ",
          "tc": "我會馬上帶到這片庭院來。",
          "sc": "我会马上带到这片庭院来。"
        }
      ]
    },
    {
      "file": "talk.dat",
