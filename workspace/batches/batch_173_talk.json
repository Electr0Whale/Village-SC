        {
          "f_idx": 0,
          "pidx_tc": 197628,
          "spk": "？？？ (未知角色)",
          "ja": "聞いたわよ、コマコ",
          "tc": "我都聽說囉，駒子。",
          "sc": "我都听说了，驹子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 197635,
          "spk": "？？？ (未知角色)",
          "ja": "また拾い物をしたんだって",
          "tc": "妳又撿東西回來了吧。",
          "sc": "你又捡东西回来了吧。"
        }
      ]
    },
    {
