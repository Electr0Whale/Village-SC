      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214949,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、ありがとう",
          "tc": "<player>，謝謝你。",
          "sc": "<player>，谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214958,
          "spk": "洋 (ヨウ)",
          "ja": "わたしを探してくれて、",
          "tc": "不只是找到了我，",
          "sc": "不只是找到了我，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214965,
