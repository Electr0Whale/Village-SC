    },
    {
      "file": "talk.dat",
      "rec_idx": 3796,
      "rec_id": "TALK_ID_10_0102_043_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 215091,
          "spk": "六角 (ロッカク)",
          "ja": "サザンカさん",
          "tc": "茶梅，",
          "sc": "茶梅，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 215098,
          "spk": "六角 (ロッカク)",
          "ja": "おはようございますっス",
          "tc": "早安啊。",
          "sc": "早安呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 215107,
          "spk": "六角 (ロッカク)",
          "ja": "こんな早い時間に珍しいっスね",
          "tc": "這麼早能看到妳，還真稀奇。",
          "sc": "这么早能看到你，还真稀奇呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 215114,
          "spk": "六角 (ロッカク)",
          "ja": "どちらへお出かけで？",
          "tc": "妳要出門嗎？",
          "sc": "你要出门吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 215127,
          "spk": "茶梅 (サザンカ)",
          "ja": "シロージとコマコと、",
          "tc": "我要和四郎治還有駒子",
          "sc": "我要和四郎治还有驹子"
        },
        {
          "f_idx": 5,
          "pidx_tc": 215134,
          "spk": "茶梅 (サザンカ)",
          "ja": "父ちゃんたちの墓参りにね",
          "tc": "去幫爸爸他們掃墓。",
          "sc": "去帮爸爸他们扫墓。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 215145,
          "spk": "茶梅 (サザンカ)",
          "ja": "今年であれから十年だしさ",
          "tc": "畢竟今年距離那件事已經十年了。",
          "sc": "毕竟今年距离那件事已经十年了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 215158,
          "spk": "六角 (ロッカク)",
          "ja": "ああ……あの事件から",
          "tc": "啊……那事件之後，",
          "sc": "啊……那事件之后，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 215165,
          "spk": "六角 (ロッカク)",
          "ja": "もうそんなに……",
          "tc": "已經過了這麼久了……",
          "sc": "已经过了这么久了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 215178,
          "spk": "茶梅 (サザンカ)",
          "ja": "……オッサンまでそんなに",
          "tc": "……不用連大叔你都",
          "sc": "……不用连大叔你都"
        },
        {
          "f_idx": 10,
          "pidx_tc": 215185,
          "spk": "茶梅 (サザンカ)",
          "ja": "気落ちする必要ないってえ",
          "tc": "這麼感傷啦。",
          "sc": "这么感伤啦。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 215198,
          "spk": "六角 (ロッカク)",
          "ja": "……スね",
          "tc": "……也是。",
          "sc": "……也是。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 215211,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、アタシは行くから",
          "tc": "好，那我要出發了。",
          "sc": "好，那我要出发了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 215218,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃーね",
          "tc": "下次見。",
          "sc": "下次见。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 215231,
          "spk": "六角 (ロッカク)",
          "ja": "ハイ、お気をつけて～",
          "tc": "好，路上小心～",
          "sc": "好，路上小心～"
        }
      ]
    },
