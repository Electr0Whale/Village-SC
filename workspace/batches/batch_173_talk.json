      "rec_id": "TALK_ID_10_0101_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 197655,
          "spk": "驹子 (コマコ)",
          "ja": "あの……リン、その……",
          "tc": "呃……林，那個……",
