      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3793,
      "rec_id": "TALK_ID_10_0102_042_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 214983,
          "spk": "洋 (ヨウ)",
          "ja": "実はわたし、キミのこと、",
          "tc": "其實我原本",
          "sc": "其实我原本"
        },
        {
          "f_idx": 1,
          "pidx_tc": 214990,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっと怖かったの",
          "tc": "覺得你有點可怕。",
          "sc": "觉得你有点可怕。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 214997,
          "spk": "洋 (ヨウ)",
          "ja": "村の外の人って、あんまり知らないから……",
          "tc": "因為我對村子外面的人不太了解……",
          "sc": "因为我对村子外面的人不太了解……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 215008,
          "spk": "洋 (ヨウ)",
          "ja": "これからは……",
          "tc": "希望你以後……",
          "sc": "希望你以后……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 215015,
          "spk": "洋 (ヨウ)",
          "ja": "仲良くしてくれると嬉しいな",
          "tc": "也能跟我當朋友。",
          "sc": "也能跟我当朋友。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3794,
      "rec_id": "TALK_ID_10_0102_042_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 215033,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ……また、来るね",
          "tc": "那……我還會再來的，",
