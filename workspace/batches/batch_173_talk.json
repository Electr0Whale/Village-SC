      "rec_id": "TALK_ID_10_0101_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 197741,
          "spk": "林 (リン)",
          "ja": "ようこそ<strong>彼ヶ津（カガツ）村</strong>へ！",
          "tc": "這裡就是<strong>彼津村</strong>！",
          "sc": "这里就是<strong>彼津村</strong>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 197748,
          "spk": "林 (リン)",
          "ja": "歓迎しますわ！",
          "tc": "歡迎你的到來！",
          "sc": "欢迎你的到来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3575,
      "rec_id": "TALK_ID_10_0101_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 197766,
          "spk": "林 (リン)",
          "ja": "聞いたわよ！",
          "tc": "我聽說了！",
          "sc": "我听说了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 197773,
          "spk": "林 (リン)",
          "ja": "帰る場所がわからなくて、",
          "tc": "你不知道該回哪裡去，",
          "sc": "你不知道该回哪里去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 197780,
          "spk": "林 (リン)",
          "ja": "困っているんでしょう？",
          "tc": "正在傷腦筋吧？",
          "sc": "正在伤脑筋吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 197791,
          "spk": "林 (リン)",
          "ja": "たどり着いたのが、この村でよかったわね！",
          "tc": "你來到的是這個村子，真是太好了！",
          "sc": "你来到的是这个村子，真是太好了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 197798,
          "spk": "林 (リン)",
          "ja": "もう、何も心配しなくていいのだから！",
          "tc": "在這裡你什麼都不用擔心了！",
          "sc": "在这里你什么都不用担心了！"
        }
      ]
    },
    {
      "file": "talk.dat",
