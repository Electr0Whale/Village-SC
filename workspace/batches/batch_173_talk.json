    {
      "file": "talk.dat",
      "rec_idx": 3578,
      "rec_id": "TALK_ID_10_0101_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 197863,
          "spk": "林 (リン)",
          "ja": "まずは自己紹介ね！",
          "tc": "首先來自我介紹吧！",
          "sc": "首先来自我介绍吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 197870,
          "spk": "林 (リン)",
          "ja": "私の名前はリンよ！",
          "tc": "我叫做林！",
          "sc": "我叫做林！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 197877,
          "spk": "林 (リン)",
          "ja": "この<strong>彼ヶ津村</strong>の村長なの",
          "tc": "是這個<strong>彼津村</strong>的村長。",
          "sc": "是这个<strong>彼津村</strong>的村长。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 197890,
          "spk": "驹子 (コマコ)",
          "ja": "リン、あの……",
          "tc": "林，那個……",
          "sc": "林，那个……"
        },
