        },
        {
          "f_idx": 5,
          "pidx_tc": 197904,
          "spk": "驹子 (コマコ)",
          "ja": "わからなくて困っていて……",
          "tc": "都不清楚，不知道該怎麼辦……",
          "sc": "都不清楚，不知道该怎么办……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 197913,
          "spk": "驹子 (コマコ)",
          "ja": "だから私たちで、",
          "tc": "所以說，我們能不能想辦法",
          "sc": "所以说，我们能不能想办法"
        },
        {
          "f_idx": 7,
          "pidx_tc": 197920,
          "spk": "驹子 (コマコ)",
          "ja": "<player>の帰る場所を",
          "tc": "幫忙<player>尋找",
          "sc": "帮忙<player>寻找"
        },
        {
          "f_idx": 8,
          "pidx_tc": 197927,
          "spk": "驹子 (コマコ)",
          "ja": "探してあげられないかな？",
          "tc": "他該回去的地方呢？",
          "sc": "他该回去的地方呢？"
        }
      ]
    },
    {
