      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 197536,
          "spk": "？？？ (未知角色)",
          "ja": "キスケさんが言ってた神隠しの……？",
          "tc": "就是木助哥說過被神隱的……？",
          "sc": "就是木助哥说过被神隐的……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 197543,
          "spk": "？？？ (未知角色)",
          "ja": "まさか……本当に……？",
          "tc": "難道說……是真的……？",
          "sc": "难道说……是真的……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 197556,
          "spk": "木助 (キスケ)",
          "ja": "だから言い伝え通りに",
          "tc": "所以要遵照傳說，",
          "sc": "所以要遵照传说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 197563,
          "spk": "木助 (キスケ)",
          "ja": "あの土地を……",
          "tc": "把那片土地……",
          "sc": "把那片土地……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 197570,
          "spk": "木助 (キスケ)",
          "ja": "その後はてめぇの良きように",
          "tc": "之後就隨妳處置吧。",
          "sc": "之后就随你处置吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 197583,
          "spk": "？？？ (未知角色)",
          "ja": "なるほどね……",
          "tc": "原來如此……",
          "sc": "原来如此……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 197590,
          "spk": "？？？ (未知角色)",
          "ja": "……悪くないわ",
          "tc": "……應該可行。",
          "sc": "……应该可行。"
        }
      ]
    },
    {
