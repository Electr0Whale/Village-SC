          "ja": "ついに人まで拾ってくるなんてね……",
          "tc": "這次居然連人都撿回來了……",
          "sc": "这次居然连人都捡回来了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 197688,
          "spk": "驹子 (コマコ)",
          "ja": "う……うう……",
          "tc": "唔……唔唔……",
          "sc": "唔……唔唔……"
        }
      ]
    },
    {
