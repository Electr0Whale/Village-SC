          "f_idx": 2,
          "pidx_tc": 53253,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、ここでぼ～っとして",
          "tc": "所以我在這裡放空，",
          "sc": "所以我在这里放空，"
