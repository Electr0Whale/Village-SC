          "f_idx": 1,
          "pidx_tc": 53298,
          "spk": "茶梅 (サザンカ)",
          "ja": "つい食べ過ぎちゃうんだよね～",
          "tc": "總是會忍不住吃太多呢～",
          "sc": "总是会忍不住吃太多呢～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 53316,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、油断するとすぐ太るんだ……",
          "tc": "所以一個不小心就會發福……",
          "sc": "所以一个不小心就会发福……"
        }
      ]
    },
    {
