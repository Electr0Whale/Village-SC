        {
          "f_idx": 3,
          "pidx_tc": 53260,
          "spk": "茶梅 (サザンカ)",
          "ja": "現実逃避中なんよね",
          "tc": "逃避現實。",
          "sc": "逃避现实。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 53267,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタも一緒にサボる？",
          "tc": "你要一起偷懶嗎？",
          "sc": "你要一起偷懒吗？"
        }
      ]
    },
    {
