          "spk": "林 (リン)",
          "ja": "対価は払ったわよ",
          "tc": "我可是付出代價了喔！",
          "sc": "我可是付出代价了哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 295152,
          "spk": "林 (リン)",
          "ja": "お願い、鵺の皮を使って見せて",
          "tc": "拜託你，使用鵺皮給我看看。",
          "sc": "拜托你，使用鵺皮给我看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5081,
      "rec_id": "TALK_ID_10_0500_030_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295187,
          "spk": "林 (リン)",
          "ja": "……なるほど",
          "tc": "……原來如此，",
          "sc": "……原来如此，"
