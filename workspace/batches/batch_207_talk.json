    },
    {
      "file": "talk.dat",
      "rec_idx": 5080,
      "rec_id": "TALK_ID_10_0500_030_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295127,
          "spk": "林 (リン)",
          "ja": "働かないと、対価を得られない……でしょう？",
          "tc": "畢竟無功不受祿……對吧？",
