        {
          "f_idx": 9,
          "pidx_tc": 294637,
          "spk": "帷 (トバリ)",
          "ja": "……頼りにしてる",
          "tc": "……拜託了。",
          "sc": "……拜托了。"
        }
      ]
    },
    {
      "file": "talk.dat",
