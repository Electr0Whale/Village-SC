          "sc": "……抱歉一大早就来找你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 294685,
          "spk": "帷 (トバリ)",
          "ja": "神器を全て集めたって聞いて、リンが……",
          "tc": "聽到你已經湊齊神器了，林就……",
          "sc": "听到你已经凑齐神器了，林就……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5073,
      "rec_id": "TALK_ID_10_0500_030_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294710,
          "spk": "林 (リン)",
          "ja": "聞いたわよ、<player>",
          "tc": "我都聽說囉，<player>。",
          "sc": "我都听说了，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 294717,
          "spk": "林 (リン)",
          "ja": "神器を三つ集めたんですって？",
          "tc": "你收集到了三件神器啊？",
          "sc": "你收集到了三件神器啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 294724,
          "spk": "林 (リン)",
          "ja": "どんなものなのか確認させて欲しいのよ",
          "tc": "我想看看是什麼樣的東西。",
          "sc": "我想看看是什么样的东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5074,
      "rec_id": "TALK_ID_10_0500_030_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294742,
          "spk": "帷 (トバリ)",
          "ja": "<player>、リンにも見せてあげて",
          "tc": "<player>，你拿出來讓林看吧。",
