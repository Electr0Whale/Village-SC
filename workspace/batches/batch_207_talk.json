      "rec_id": "TALK_ID_10_0500_029_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294548,
          "spk": "帷 (トバリ)",
          "ja": "……でも",
          "tc": "……可是，",
          "sc": "……可是，"
