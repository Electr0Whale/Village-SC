        {
          "f_idx": 1,
          "pidx_tc": 294555,
          "spk": "帷 (トバリ)",
          "ja": "少しだけ、考えてみる",
          "tc": "我會考慮看看的。",
          "sc": "我会考虑看看的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 294566,
          "spk": "帷 (トバリ)",
          "ja": "私に何ができるのか、",
          "tc": "想想自己能做些什麼，",
          "sc": "想想自己能做些什么，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 294573,
          "spk": "帷 (トバリ)",
          "ja": "どうすればいいのかを……",
          "tc": "該怎麼做……",
          "sc": "该怎么做……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 294584,
          "spk": "帷 (トバリ)",
          "ja": "……ありがと",
          "tc": "……謝謝。",
          "sc": "……谢谢。"
