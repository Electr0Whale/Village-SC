        {
          "f_idx": 3,
          "pidx_tc": 295257,
          "spk": "林 (リン)",
          "ja": "じゃあ……そうね……",
          "tc": "那麼……我想想……",
          "sc": "那么……我想想……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5083,
      "rec_id": "TALK_ID_10_0500_030_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295275,
          "spk": "林 (リン)",
          "ja": "壊れたら私が弁償してあげる",
          "tc": "要是壞了就由我來賠，",
