          "pidx_tc": 294910,
          "spk": "帷 (トバリ)",
          "ja": "今は伝説を信じて、これに縋るしか……",
          "tc": "現在只能相信傳說，靠它們了……",
          "sc": "现在只能相信传说，靠它们了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 294930,
          "spk": "林 (リン)",
          "ja": "あなたが大嫌いな、",
          "tc": "意思是妳要相信那種老掉牙的傳說嗎？",
          "sc": "意思是你要相信那种老掉牙的传说吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 294937,
          "spk": "林 (リン)",
          "ja": "埃被った昔話を信じるって言うの？",
          "tc": "妳不是最討厭那些了？",
          "sc": "你不是最讨厌那些了？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 294946,
          "spk": "林 (リン)",
          "ja": "神器を持って土地神の元へ行っても、",
          "tc": "要是帶著神器去找土地神，",
          "sc": "要是带着神器去找土地神，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 294953,
          "spk": "林 (リン)",
          "ja": "なんの役にも立たなかったら",
          "tc": "卻一點用也沒有的話，",
          "sc": "却一点用也没有的话，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 294960,
          "spk": "林 (リン)",
          "ja": "どうなるかわかっているでしょう？",
          "tc": "妳應該曉得下場會怎麼樣吧？",
          "sc": "你应该晓得下场会怎么样吧？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 294971,
          "spk": "林 (リン)",
          "ja": "土地神を倒すどころか、",
          "tc": "別說打倒土地神了，",
          "sc": "别说打倒土地神了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 294978,
          "spk": "林 (リン)",
          "ja": "命を危険に晒すことになるのよ",
          "tc": "反而會有生命危險耶！",
          "sc": "反而会有生命危险呢！"
        },
        {
          "f_idx": 13,
          "pidx_tc": 294991,
          "spk": "帷 (トバリ)",
          "ja": "……それは",
          "tc": "……那是……",
          "sc": "……那是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5078,
      "rec_id": "TALK_ID_10_0500_030_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 295009,
          "spk": "林 (リン)",
          "ja": "早速、効果を見せて貰おうかしら",
          "tc": "不如現在就讓我看看效果吧。",
