        {
          "f_idx": 1,
          "pidx_tc": 295282,
          "spk": "林 (リン)",
          "ja": "だから、このポストを切ってみなさい",
          "tc": "你試著把這個郵筒劈開吧。",
          "sc": "你试着把这个邮筒劈开吧。"
