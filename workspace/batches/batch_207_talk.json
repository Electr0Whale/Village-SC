          "f_idx": 7,
          "pidx_tc": 294473,
          "spk": "裕太 (ユータ)",
          "ja": "どんなことでも、恐れない……",
          "tc": "不畏懼任何事……",
          "sc": "不畏惧任何事……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 294480,
          "spk": "裕太 (ユータ)",
          "ja": "立ち向かうのがキミじゃないかい？",
          "tc": "挺身而出的人不是妳嗎？",
          "sc": "挺身而出的人不是你吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5070,
      "rec_id": "TALK_ID_10_0500_029_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294505,
          "spk": "帷 (トバリ)",
          "ja": "……っ、うるさいな",
