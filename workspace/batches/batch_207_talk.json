  ],
  "record_count": 36,
  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5049,
      "rec_id": "TALK_ID_10_0500_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292856,
          "spk": "帷 (トバリ)",
          "ja": "コダマは……",
          "tc": "木珠……",
          "sc": "木珠……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 292863,
          "spk": "帷 (トバリ)",
          "ja": "アンタの代わりに死んだんじゃないの",
          "tc": "其實是代替你而死的吧？",
          "sc": "其实是代替你而死的吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292870,
          "spk": "帷 (トバリ)",
          "ja": "土地神を封じるための生贄になって……",
          "tc": "為了封印土地神，才成了你的替死鬼……",
          "sc": "为了封印土地神，才成了你的替死鬼……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 292881,
          "spk": "帷 (トバリ)",
          "ja": "アンタとコダマと、リンの苗字は一緒だった",
          "tc": "你、木珠還有林的姓氏都一樣。",
          "sc": "你、木珠还有林的姓氏都一样。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 292888,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちは、親族なんでしょ",
          "tc": "你們是親戚吧？",
          "sc": "你们是亲戚吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 292897,
          "spk": "帷 (トバリ)",
          "ja": "だからアンタは、",
          "tc": "所以你是因為親人被殺，",
          "sc": "所以你是因为亲人被杀，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 292904,
          "spk": "帷 (トバリ)",
          "ja": "親族を殺された恨みから、",
          "tc": "才會因恨……",
          "sc": "才会因恨……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 292911,
          "spk": "帷 (トバリ)",
          "ja": "あの事件を起こしたんじゃない？",
          "tc": "引發那起事件的不是嗎？",
          "sc": "引发那起事件的不是吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 292922,
          "spk": "帷 (トバリ)",
          "ja": "十年前の事件があって、",
          "tc": "自從十年前的事件發生後，",
          "sc": "自从十年前的事件发生后，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 292929,
          "spk": "帷 (トバリ)",
          "ja": "生贄の儀式は行われていなかった",
          "tc": "就再也沒有舉行過活祭品儀式了。",
          "sc": "就再也没有举行过活祭品仪式了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 292947,
          "spk": "帷 (トバリ)",
          "ja": "事件で殺されたのは、大人ばかり",
          "tc": "在事件中被殺的全是大人，",
          "sc": "在事件中被杀的全是大人，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 292954,
          "spk": "帷 (トバリ)",
          "ja": "子どもや関係のない人を残している",
          "tc": "唯獨留下了小孩和無關的人。",
          "sc": "唯独留下了小孩和无关的人。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 292972,
          "spk": "帷 (トバリ)",
          "ja": "でも本当は、生贄の儀式の代わりとして、",
          "tc": "但真相是，為了代替原本的活祭品儀式，",
          "sc": "但真相是，为了代替原本的活祭品仪式，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 292979,
          "spk": "帷 (トバリ)",
          "ja": "新しい生贄として殺したんでしょ",
          "tc": "你把他們當成「新的活祭品」殺掉了吧？",
          "sc": "你把他们当成“新的活祭品”杀掉了吧？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 292995,
          "spk": "帷 (トバリ)",
          "ja": "リンやアンタ自身を守るために",
          "tc": "為了保護林，也為了保護你自己……",
          "sc": "为了保护林，也为了保护你自己……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 293002,
          "spk": "帷 (トバリ)",
          "ja": "そして、コダマの恨みを晴らすために……",
          "tc": "更是為了幫木珠報仇……",
          "sc": "更是为了帮木珠报仇……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 293015,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは、あの事件の全貌を",
          "tc": "那起事件的全貌，",
          "sc": "那起事件的全貌，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 293022,
          "spk": "木助 (キスケ)",
          "ja": "よく知らねぇだろ",
          "tc": "妳根本就一無所知吧！",
          "sc": "你根本就一无所知吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5050,
      "rec_id": "TALK_ID_10_0500_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293040,
          "spk": "木助 (キスケ)",
          "ja": "殺人を犯したのは単独犯じゃねぇよ",
          "tc": "殺人的，可不只有一個人。",
          "sc": "杀人的，可不只有一个人。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293060,
          "spk": "帷 (トバリ)",
          "ja": "じゃあアンタも犯罪の",
          "tc": "那麼，你也是",
          "sc": "那么，你也是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293067,
          "spk": "帷 (トバリ)",
          "ja": "一因になっていたんじゃないの",
          "tc": "造成那場犯罪的原因之一嗎？",
          "sc": "造成那场犯罪的原因之一吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293080,
          "spk": "木助 (キスケ)",
          "ja": "俺に人を操る力なんてねぇ",
          "tc": "我可沒有操控他人的力量。",
          "sc": "我可没有操控他人的力量。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 293100,
          "spk": "帷 (トバリ)",
          "ja": "どうかな",
          "tc": "那就難說了，",
          "sc": "那就难说了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 293107,
          "spk": "帷 (トバリ)",
          "ja": "この村のことだもの",
          "tc": "畢竟是在這座村子裡發生的事。",
          "sc": "毕竟是在这座村子里发生的事。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 293120,
          "spk": "木助 (キスケ)",
          "ja": "それで？",
          "tc": "所以呢？",
          "sc": "所以呢？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 293127,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはそれを俺に言って、",
          "tc": "妳特地跑來跟我說這些，",
          "sc": "你特地跑来跟我说这些，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 293134,
          "spk": "木助 (キスケ)",
          "ja": "一体どうするっていうんだ？",
          "tc": "到底是怎麼了？",
          "sc": "到底是怎么了？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 293145,
          "spk": "木助 (キスケ)",
          "ja": "ここに警察でも呼ぶのか？",
          "tc": "妳打算找警察來嗎？",
          "sc": "你打算找警察来吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 293152,
          "spk": "木助 (キスケ)",
          "ja": "それとも、村の連中に暴露でもするのか？",
          "tc": "還是想向村裡的人揭發這一切？",
          "sc": "还是想向村里的人揭发这一切？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 293165,
          "spk": "帷 (トバリ)",
          "ja": "本当のことが、知りたいだけ",
          "tc": "我只是想知道真相。",
          "sc": "我只是想知道真相。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 293172,
          "spk": "帷 (トバリ)",
          "ja": "そうじゃないと……私は、この村で暮らせない",
          "tc": "否則……我沒辦法住在這座村子裡。",
          "sc": "否则……我没办法住在这座村子里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5051,
      "rec_id": "TALK_ID_10_0500_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293190,
          "spk": "木助 (キスケ)",
          "ja": "ハッ……大した心変わりだぜ",
          "tc": "哼……心境變化還真大呢。",
          "sc": "哼……心境变化还真大呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293197,
          "spk": "木助 (キスケ)",
          "ja": "この間まで、嫌だってボヤいてたくせに",
          "tc": "明明前陣子還在抱怨說討厭這裡。",
          "sc": "明明前阵子还在抱怨说讨厌这里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5052,
      "rec_id": "TALK_ID_10_0500_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293222,
          "spk": "木助 (キスケ)",
          "ja": "嫌ならこの村で暮らさずに、",
          "tc": "討厭的話就別在村子裡住了，",
          "sc": "讨厌的话就别在村子里住了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293229,
          "spk": "木助 (キスケ)",
          "ja": "さっさと出ていけばいいんだ",
          "tc": "趕快滾出去就好。",
          "sc": "赶快滚出去就好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293240,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも気づいてるだろうが、",
          "tc": "妳也注意到了吧？",
          "sc": "你也注意到了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293247,
          "spk": "木助 (キスケ)",
          "ja": "俺やリンは、最初から知ってるぜ",
          "tc": "我和林從一開始就知道了，",
          "sc": "我和林从一开始就知道了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293254,
          "spk": "木助 (キスケ)",
          "ja": "村から出る手段があるってことを……",
          "tc": "離開這個村子的方法……",
          "sc": "离开这个村子的方法……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5053,
      "rec_id": "TALK_ID_10_0500_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293272,
          "spk": "木助 (キスケ)",
          "ja": "早くしねぇと、",
          "tc": "再不快點離開，",
          "sc": "再不快点离开，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293279,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも俺が殺しちまうかもしれねえよ",
          "tc": "妳搞不好也會被我殺掉喔！",
          "sc": "你说不定也会被我杀掉啊！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293290,
          "spk": "木助 (キスケ)",
          "ja": "いや、俺じゃなくて、",
          "tc": "不，說不定在我動手前，",
          "sc": "不，说不定在我动手前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293297,
          "spk": "木助 (キスケ)",
          "ja": "土地神に祟り殺される方が先かもな",
          "tc": "妳就會死於土地神作祟了。",
          "sc": "你就会死于土地神作祟了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293310,
          "spk": "帷 (トバリ)",
          "ja": "私を知ってるでしょ",
          "tc": "你應該知道，",
          "sc": "你应该知道，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 293317,
          "spk": "帷 (トバリ)",
          "ja": "脅しは効かないから",
          "tc": "威脅對我來說是沒用的吧？",
          "sc": "威胁对我来说是没用的吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 293328,
          "spk": "帷 (トバリ)",
          "ja": "今年もまた、",
          "tc": "今年也同樣",
          "sc": "今年也同样"
        },
        {
          "f_idx": 7,
          "pidx_tc": 293335,
          "spk": "帷 (トバリ)",
          "ja": "生贄の儀式はできなかった",
          "tc": "沒能舉行活祭品儀式。",
          "sc": "没能举行活祭品仪式。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5054,
      "rec_id": "TALK_ID_10_0500_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293353,
          "spk": "帷 (トバリ)",
          "ja": "私は、見張ってるから",
          "tc": "我會好好看著的。",
          "sc": "我会好好看着的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5055,
      "rec_id": "TALK_ID_10_0500_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293375,
          "spk": "木助 (キスケ)",
          "ja": "……チッ",
          "tc": "……嘖。",
          "sc": "……啧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293382,
          "spk": "木助 (キスケ)",
          "ja": "なまいきだな",
          "tc": "囂張什麼，",
          "sc": "嚣张什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293389,
          "spk": "木助 (キスケ)",
          "ja": "探偵気取りしやがって",
          "tc": "以為自己是偵探啊。",
          "sc": "以为自己是侦探啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5056,
      "rec_id": "TALK_ID_10_0500_020_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293413,
          "spk": "木助 (キスケ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293420,
          "spk": "木助 (キスケ)",
          "ja": "いつも急に来て悪りぃな",
          "tc": "抱歉又突然來打擾。",
          "sc": "抱歉又突然来打扰。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5057,
      "rec_id": "TALK_ID_10_0500_020_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293438,
          "spk": "木助 (キスケ)",
          "ja": "だけど……俺は忠告したはずだ",
          "tc": "但是……我應該有提醒過你，",
          "sc": "但是……我应该有提醒过你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293445,
          "spk": "木助 (キスケ)",
          "ja": "神器は集めるのをやめろってな",
          "tc": "叫你別繼續收集神器了。",
          "sc": "叫你别继续收集神器了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293463,
          "spk": "木助 (キスケ)",
          "ja": "秘密を暴くのは、",
          "tc": "揭穿別人的祕密，",
          "sc": "揭穿别人的秘密，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293470,
          "spk": "木助 (キスケ)",
          "ja": "さぞ楽しかったことだろう",
          "tc": "想必讓你覺得很有趣吧？",
          "sc": "想必让你觉得很有趣吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 293481,
          "spk": "木助 (キスケ)",
          "ja": "でも、この辺にしておけ",
          "tc": "但是該到此為止了。",
          "sc": "但是该到此为止了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5058,
      "rec_id": "TALK_ID_10_0500_020_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293499,
          "spk": "木助 (キスケ)",
          "ja": "それより……もうそろそろ、",
          "tc": "還有……你也差不多",
          "sc": "还有……你也差不多"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293506,
          "spk": "木助 (キスケ)",
          "ja": "この村から出て行ってくれねぇかな",
          "tc": "該離開這座村子了吧。",
          "sc": "该离开这座村子了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5059,
      "rec_id": "TALK_ID_10_0500_020_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293524,
          "spk": "木助 (キスケ)",
          "ja": "村の誰と、どんな約束したかは知らねえが、",
          "tc": "我不曉得你跟村裡的誰做了什麼約定，",
          "sc": "我不晓得你跟村里的谁做了什么约定，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293531,
          "spk": "木助 (キスケ)",
          "ja": "そんなもんは忘れちまってもいい",
          "tc": "那種事就算忘掉也無所謂，",
          "sc": "那种事就算忘掉也无所谓，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293538,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは自由なんだよ",
          "tc": "你是自由的。",
          "sc": "你是自由的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5060,
      "rec_id": "TALK_ID_10_0500_020_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293556,
          "spk": "木助 (キスケ)",
          "ja": "ここんとこずっと、嫌な予感がするんだよ",
          "tc": "我最近一直有種不祥的預感。",
          "sc": "我最近一直有种不祥的预感。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293563,
          "spk": "木助 (キスケ)",
          "ja": "だからこれは、てめぇのために言ってるんだ",
          "tc": "所以我說這些是為了你好。",
          "sc": "所以我说这些是为了你好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293581,
          "spk": "木助 (キスケ)",
          "ja": "これ以上進んだら俺は……",
          "tc": "你再繼續這樣下去……",
          "sc": "你再继续这样下去……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293588,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの味方にはなってやれねぇよ",
          "tc": "我就沒辦法站在你那邊了。",
