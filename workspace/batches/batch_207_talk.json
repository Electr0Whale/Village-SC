        {
          "f_idx": 1,
          "pidx_tc": 294749,
          "spk": "帷 (トバリ)",
          "ja": "私も見たいし",
          "tc": "我也想看看。",
          "sc": "我也想看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5075,
      "rec_id": "TALK_ID_10_0500_030_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294777,
          "spk": "林 (リン)",
          "ja": "……二つしかないじゃない",
          "tc": "……這樣只有兩件吧？",
          "sc": "……这样只有两件吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 294790,
          "spk": "帷 (トバリ)",
          "ja": "もう一つは奇跡の呼笛だからね",
          "tc": "因為還有一件是「奇蹟的呼笛」。",
          "sc": "因为还有一件是“奇迹的呼笛”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 294810,
          "spk": "林 (リン)",
          "ja": "ハァ？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 294817,
          "spk": "林 (リン)",
          "ja": "そんな形の無いものが神器なの？",
          "tc": "那種沒有實體的東西是神器嗎？",
          "sc": "那种没有实体的东西是神器吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5076,
      "rec_id": "TALK_ID_10_0500_030_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294842,
          "spk": "帷 (トバリ)",
          "ja": "……さっきから何？",
          "tc": "……從剛才就那個態度是怎樣？",
          "sc": "……从刚才就那个态度是怎样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 294849,
          "spk": "帷 (トバリ)",
          "ja": "なんでそんな喧嘩腰なの？",
          "tc": "為什麼一直咄咄逼人？",
          "sc": "为什么一直咄咄逼人？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 294856,
          "spk": "帷 (トバリ)",
          "ja": "一体何が言いたいのか、はっきりしたら？",
          "tc": "妳到底想說什麼，有話就直說吧？",
          "sc": "你到底想说什么，有话就直说吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5077,
      "rec_id": "TALK_ID_10_0500_030_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 294874,
          "spk": "林 (リン)",
          "ja": "これらを使ったって、",
          "tc": "我想說的是，就算用這些東西，",
