        {
          "f_idx": 6,
          "pidx_tc": 294598,
          "spk": "帷 (トバリ)",
          "ja": "エールとして受け取っておく",
          "tc": "而不是說教的。",
          "sc": "而不是说教的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 294611,
          "spk": "裕太 (ユータ)",
          "ja": "おや、珍しく素直だね？",
          "tc": "喔？難得妳這麼坦率？",
          "sc": "喔？难得你这么坦率？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 294624,
          "spk": "驹子 (コマコ)",
          "ja": "私たちも、ちゃんと力になるからね！",
          "tc": "我們也會努力幫上忙的！",
          "sc": "我们也会努力帮上忙的！"
