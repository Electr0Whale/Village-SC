  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3910,
      "rec_id": "TALK_ID_10_0104_090_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223027,
          "spk": "裕太 (ユータ)",
          "ja": "<player>は、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223034,
          "spk": "裕太 (ユータ)",
          "ja": "ここに入ったことがあるんだよね？",
          "tc": "你有進去過這裡吧？",
          "sc": "你有进去过这里吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223043,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、ちょっと入って見てきてよ",
          "tc": "那，你先進去稍微探個路吧。",
          "sc": "那，你先进去稍微探个路吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223050,
          "spk": "裕太 (ユータ)",
          "ja": "何もいなかったら俺達も行くからさ……",
          "tc": "沒有什麼東西的話，我們也會跟上的……",
          "sc": "没有什么东西的话，我们也会跟上的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223059,
          "spk": "裕太 (ユータ)",
          "ja": "お、おねがい、<player>",
          "tc": "拜、拜託你了，<player>。",
          "sc": "拜、拜托你了，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3911,
      "rec_id": "TALK_ID_10_0104_090_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223081,
          "spk": "四郎治 (シロージ)",
          "ja": "……誰だ",
          "tc": "……是誰？",
          "sc": "……是谁？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3912,
      "rec_id": "TALK_ID_10_0104_090_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223101,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ……お前かよ",
          "tc": "哦……是你啊。",
          "sc": "哦……是你啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223108,
          "spk": "四郎治 (シロージ)",
          "ja": "驚かせんな",
          "tc": "不要嚇人啦。",
          "sc": "不要吓人啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3913,
      "rec_id": "TALK_ID_10_0104_090_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223126,
          "spk": "四郎治 (シロージ)",
          "ja": "お前もここに興味があるのか？",
          "tc": "你也對這裡有興趣嗎？",
          "sc": "你也对这里有兴趣吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223144,
          "spk": "四郎治 (シロージ)",
          "ja": "ここは、大昔に使われていた石切場だ",
          "tc": "很久以前使用過的採石場。",
          "sc": "很久以前使用过的采石场。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223162,
          "spk": "四郎治 (シロージ)",
          "ja": "俺のじいさんも",
          "tc": "就連我爺爺都說",
          "sc": "就连我爷爷都说"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223169,
          "spk": "四郎治 (シロージ)",
          "ja": "昔に閉鎖されたって言っていたから、",
          "tc": "這裡以前就被封鎖起來了，",
          "sc": "这里以前就被封锁起来了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 223176,
          "spk": "四郎治 (シロージ)",
          "ja": "相当古いだろうな",
          "tc": "所以應該很有年代了吧。",
          "sc": "所以应该很有年代了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3915,
      "rec_id": "TALK_ID_10_0104_090_26",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223199,
          "spk": "四郎治 (シロージ)",
          "ja": "どうやらこの先は",
          "tc": "看來這前面",
          "sc": "看来这前面"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223206,
          "spk": "四郎治 (シロージ)",
          "ja": "複雑な迷路になっているらしい",
          "tc": "似乎變成了相當複雜的迷宮。",
          "sc": "似乎变成了相当复杂的迷宫。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223215,
          "spk": "四郎治 (シロージ)",
          "ja": "俺もさっき入って来たが、",
          "tc": "我也是剛剛才進來的，",
          "sc": "我也是刚刚才进来的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223222,
          "spk": "四郎治 (シロージ)",
          "ja": "もう石は掘り尽くされていた",
          "tc": "值錢的東西老早就被人挖光了，",
          "sc": "值钱的东西老早就被人挖光了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223229,
          "spk": "四郎治 (シロージ)",
          "ja": "見つかるとしても金にならないクズ鉄ばかりだ",
          "tc": "剩下的都是不值錢的廢鐵。",
          "sc": "剩下的都是不值钱的废铁。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3916,
      "rec_id": "TALK_ID_10_0104_090_27",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223247,
          "spk": "四郎治 (シロージ)",
          "ja": "それでもここに用があるのか？",
          "tc": "即使如此，你還是要來這裡嗎？",
          "sc": "即使如此，你还是要来这里吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3917,
      "rec_id": "TALK_ID_10_0104_090_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223265,
          "spk": "四郎治 (シロージ)",
          "ja": "……ん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3918,
      "rec_id": "TALK_ID_10_0104_090_29",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223289,
          "spk": "四郎治 (シロージ)",
          "ja": "それ、やるよ",
          "tc": "這個給你吧。",
          "sc": "这个给你吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223300,
          "spk": "四郎治 (シロージ)",
          "ja": "クズ鉄じゃ、なんの役にも立たねえからな",
          "tc": "畢竟只是廢鐵，什麼用都沒有。",
          "sc": "毕竟只是废铁，什么用都没有。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223307,
          "spk": "四郎治 (シロージ)",
          "ja": "拾い集めて延べ棒にすれば、",
          "tc": "不過如果能收集起來鑄成鐵塊，",
          "sc": "不过如果能收集起来铸成铁块，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223314,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっとは役に立つかもしれん",
          "tc": "或許還能派上用場。",
          "sc": "或许还能派上用场。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223323,
          "spk": "四郎治 (シロージ)",
          "ja": "あのフェンスの鍵は開けっ放しにしといてやる",
          "tc": "那個圍籬我就先開著不關了。",
          "sc": "那个围篱我就先开着不关了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223330,
          "spk": "四郎治 (シロージ)",
          "ja": "だが、探検は程々にしておけ",
          "tc": "不過，探險要自己注意適可而止。",
          "sc": "不过，探险要自己注意适可而止。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3919,
      "rec_id": "TALK_ID_10_0104_090_30",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223348,
          "spk": "四郎治 (シロージ)",
          "ja": "……まあ、止めはしないが",
          "tc": "……我不會制止你，",
          "sc": "……我不会制止你，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223355,
          "spk": "四郎治 (シロージ)",
          "ja": "深入りもやめとくことだ",
          "tc": "但也別太過深入了。",
          "sc": "但也别太过深入了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3920,
      "rec_id": "TALK_ID_10_0104_090_31",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223379,
          "spk": "四郎治 (シロージ)",
          "ja": "ほら、お前も戻るだろ",
          "tc": "好了，你也要回去了吧。",
          "sc": "好了，你也要回去了吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223386,
          "spk": "四郎治 (シロージ)",
          "ja": "外に人を待たせてるんじゃねえのか？",
          "tc": "外面不是有人在等你嗎？",
          "sc": "外面不是有人在等你吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3921,
      "rec_id": "TALK_ID_10_0104_090_32",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223406,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>戻ってきた……",
          "tc": "啊，<player>回來了……",
          "sc": "啊，<player>回来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3922,
      "rec_id": "TALK_ID_10_0104_090_33",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223430,
          "spk": "驹子 (コマコ)",
          "ja": "お、お兄ちゃん！？",
          "tc": "哥、哥哥！？",
          "sc": "哥、哥哥！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223443,
          "spk": "裕太 (ユータ)",
          "ja": "なんだ！",
          "tc": "什麼嘛！",
          "sc": "什么嘛！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223450,
          "spk": "裕太 (ユータ)",
          "ja": "足音はシロージだったのか",
          "tc": "原來是四郎治的腳步聲啊。",
          "sc": "原来是四郎治的脚步声啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223457,
          "spk": "裕太 (ユータ)",
          "ja": "ビビって損した",
          "tc": "真是白白嚇自己了。",
          "sc": "真是白白吓自己了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223468,
          "spk": "裕太 (ユータ)",
          "ja": "いや、バレちゃったから",
          "tc": "不對，這樣是被發現了，",
          "sc": "不对，这样是被发现了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223475,
          "spk": "裕太 (ユータ)",
          "ja": "焦るべきなのか……？",
          "tc": "我是不是該緊張才對……？",
          "sc": "我是不是该紧张才对……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 223488,
          "spk": "四郎治 (シロージ)",
          "ja": "なんだ、コマコか",
          "tc": "原來是駒子啊。",
          "sc": "原来是驹子啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 223495,
          "spk": "四郎治 (シロージ)",
          "ja": "ユータも……なにしてんだよ",
          "tc": "還有裕太……你們在搞什麼？",
          "sc": "还有裕太……你们在搞什么？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 223502,
          "spk": "四郎治 (シロージ)",
          "ja": "用もなく来る場所じゃねえぞ",
          "tc": "這裡可不是沒事能來的地方。",
          "sc": "这里可不是没事能来的地方。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3923,
      "rec_id": "TALK_ID_10_0104_090_34",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223520,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、この人、私のお兄ちゃんなの",
          "tc": "<player>，這個人是我的親哥哥。",
          "sc": "<player>，这个人是我的亲哥哥。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223527,
          "spk": "驹子 (コマコ)",
          "ja": "山で木こりをしててね……",
          "tc": "他在山裡當樵夫……",
          "sc": "他在山里当樵夫……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223534,
          "spk": "驹子 (コマコ)",
          "ja": "困った時は相談するといいよ",
          "tc": "遇到什麼麻煩的話，可以找他商量喔。",
          "sc": "遇到什么麻烦的话，可以找他商量哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223547,
          "spk": "裕太 (ユータ)",
          "ja": "シロージ、用ならあるよ！",
          "tc": "四郎治，我們當然有事了！",
          "sc": "四郎治，我们当然有事了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223554,
          "spk": "裕太 (ユータ)",
          "ja": "この石切場でお宝を探すっていう",
          "tc": "我才剛立下目標，",
          "sc": "我才刚立下目标，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223561,
          "spk": "裕太 (ユータ)",
          "ja": "目的が今できたんだから！",
          "tc": "要在這個採石場找到寶物！",
          "sc": "要在这个采石场找到宝物！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3924,
      "rec_id": "TALK_ID_10_0104_090_35",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223579,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、コマコちゃん",
          "tc": "那麼，駒子，",
          "sc": "那么，驹子，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223586,
          "spk": "裕太 (ユータ)",
          "ja": "この先も一緒に……",
          "tc": "繼續跟我一起……",
          "sc": "继续跟我一起……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3925,
      "rec_id": "TALK_ID_10_0104_090_36",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223604,
          "spk": "四郎治 (シロージ)",
          "ja": "おい待て",
          "tc": "給我等一下。",
          "sc": "给我等一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3926,
      "rec_id": "TALK_ID_10_0104_090_37",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223624,
          "spk": "裕太 (ユータ)",
          "ja": "な、なにかな……",
          "tc": "有、有什麼事嗎……？",
          "sc": "有、有什么事吗……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223631,
          "spk": "裕太 (ユータ)",
          "ja": "キミも勝手に入っていたんだから、",
          "tc": "你自己不也是擅自進來的嗎？",
          "sc": "你自己不也是擅自进来的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 223638,
          "spk": "裕太 (ユータ)",
          "ja": "コマコちゃんを怒るのはやめてあげて……",
          "tc": "就別罵駒子了……",
          "sc": "就别骂驹子了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 223651,
          "spk": "四郎治 (シロージ)",
          "ja": "いや、なんかよくわからねぇけど、",
          "tc": "我是不知道你想做什麼，",
          "sc": "我是不知道你想做什么，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 223658,
          "spk": "四郎治 (シロージ)",
          "ja": "気軽に入るのはやめておいた方がいいぜ",
          "tc": "但最好不要隨隨便便就往深處走。",
          "sc": "但最好不要随随便便就往深处走。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 223669,
          "spk": "四郎治 (シロージ)",
          "ja": "洞窟の中では外の光がないから、",
          "tc": "洞窟裡面沒有外面的光線，",
          "sc": "洞窟里面没有外面的光线，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 223676,
          "spk": "四郎治 (シロージ)",
          "ja": "時間の感覚が曖昧になるんだ……",
          "tc": "所以對時間的感覺會變得遲鈍……",
          "sc": "所以对时间的感觉会变得迟钝……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 223683,
          "spk": "四郎治 (シロージ)",
          "ja": "掟の時間までに必ず戻るよう注意しろよ",
          "tc": "注意一定要在規矩限制的時間前回來。",
          "sc": "注意一定要在规矩限制的时间前回来。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 223696,
          "spk": "裕太 (ユータ)",
          "ja": "それは確かにね……",
          "tc": "這倒是沒錯……",
          "sc": "这倒是没错……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 223703,
          "spk": "裕太 (ユータ)",
          "ja": "掟を守れるように準備するのも",
          "tc": "為了守住規矩而做足準備，",
          "sc": "为了守住规矩而做足准备，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 223710,
          "spk": "裕太 (ユータ)",
          "ja": "一つの楽しい時間かもしれない",
          "tc": "或許也會是一段有趣的時光呢。",
          "sc": "或许也会是一段有趣的时光呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3927,
      "rec_id": "TALK_ID_10_0104_090_38",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 223728,
          "spk": "裕太 (ユータ)",
          "ja": "コマコちゃん、石切場の探検は",
          "tc": "駒子，等我們做好準備，",
          "sc": "驹子，等我们做好准备，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 223735,
          "spk": "裕太 (ユータ)",
          "ja": "準備を整えてからにしよう！",
          "tc": "再繼續探索採石場吧！",
