      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 17171,
          "spk": "帷 (トバリ)",
          "ja": "小さかった時は夏に外で遊ぶのも",
          "tc": "小時候夏天在外面玩好像都沒事，",
