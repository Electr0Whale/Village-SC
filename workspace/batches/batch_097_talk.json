      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15366,
          "spk": "帷 (トバリ)",
          "ja": "みんな、忙しそうにどこ行くんだろ",
          "tc": "大家看起來都這麼忙碌，不知道都是要去哪裡？",
          "sc": "大家看起来都这么忙碌，不知道都是要去哪里？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15373,
          "spk": "帷 (トバリ)",
          "ja": "この村ですることなんて、",
          "tc": "明明在這村裡能做的事",
          "sc": "明明在这村里能做的事"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15380,
          "spk": "帷 (トバリ)",
          "ja": "大してないでしょうに……",
          "tc": "都沒什麼大不了的……",
          "sc": "都没什么大不了的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 105,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15404,
          "spk": "帷 (トバリ)",
          "ja": "……私にも目的地、できたらいいのに",
          "tc": "……真希望我也能夠有我的目的地。",
          "sc": "……真希望我也能够有我的目的地。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 106,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15435,
          "spk": "帷 (トバリ)",
          "ja": "たまには買い物にでも行こうかな？",
          "tc": "偶爾去買點東西好了。",
          "sc": "偶尔去买点东西好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15446,
          "spk": "帷 (トバリ)",
          "ja": "けど、別にほしいものもないし……",
          "tc": "但我又沒有什麼想要的……",
          "sc": "但我又没有什么想要的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 107,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15470,
          "spk": "帷 (トバリ)",
          "ja": "雨水で靴が汚れちゃった……",
          "tc": "雨水把鞋子弄髒了……",
          "sc": "雨水把鞋子弄脏了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15477,
          "spk": "帷 (トバリ)",
          "ja": "まあ……晴れていたとしても、",
          "tc": "……不過，即使天氣放晴，",
          "sc": "……不过，即使天气放晴，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15484,
          "spk": "帷 (トバリ)",
          "ja": "この村を歩けば結局泥まみれになるか……",
          "tc": "走在這個村子裡最後還是會滿是泥濘……",
          "sc": "走在这个村子里最后还是会满是泥泞……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 108,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15508,
          "spk": "帷 (トバリ)",
          "ja": "この村のこの時間は、",
          "tc": "這個村子，在這個時間",
          "sc": "这个村子，在这个时间"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15515,
          "spk": "帷 (トバリ)",
          "ja": "いかにも何か出そうな空気があるわね……",
          "tc": "總是有種好像會有什麼東西跑出來的感覺……",
          "sc": "总是有种好像会有什么东西跑出来的感觉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15522,
          "spk": "帷 (トバリ)",
          "ja": "退屈しのぎになるから、出てくれて構わないけど",
          "tc": "不過我無所謂，因為這樣可以消磨時間了。",
          "sc": "不过我无所谓，因为这样可以消磨时间了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 109,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15546,
          "spk": "帷 (トバリ)",
          "ja": "さっきまで暖かかったのに、急に冷えてきた……",
          "tc": "剛剛明明還很溫暖的，突然就變冷了……",
          "sc": "刚刚明明还很温暖的，突然就变冷了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15553,
          "spk": "帷 (トバリ)",
          "ja": "この村は急に温度が変わるのよ……",
          "tc": "這個村子的氣溫會突然變化呢……",
          "sc": "这个村子的气温会突然变化呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15560,
          "spk": "帷 (トバリ)",
          "ja": "ほんと……過ごしにくい……",
          "tc": "真的是……對生活很不便……",
          "sc": "真的是……对生活很不便……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 110,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_1823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15584,
          "spk": "帷 (トバリ)",
          "ja": "……アンタ、帰らなくていいわけ？",
          "tc": "……你，不回家好嗎？",
          "sc": "……你，不回家好吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15591,
          "spk": "帷 (トバリ)",
          "ja": "遅くまで出歩いてるとこをリンに見られたら",
          "tc": "這麼晚的時間還在外面晃，",
          "sc": "这么晚的时间还在外面晃，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15598,
          "spk": "帷 (トバリ)",
          "ja": "面倒なことになるんじゃない？",
          "tc": "被林看到的話，事情會變得很麻煩吧？",
          "sc": "被林看到的话，事情会变得很麻烦吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 111,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15622,
          "spk": "帷 (トバリ)",
          "ja": "都会にいた頃は、この時期になると",
          "tc": "我住在城市的時候，每年到了這個時期，",
          "sc": "我住在城市的时候，每年到了这个时期，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15629,
          "spk": "帷 (トバリ)",
          "ja": "毎年、浴衣を着せてもらってたな……",
          "tc": "都會被穿上浴衣……",
          "sc": "都会被穿上浴衣……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15640,
          "spk": "帷 (トバリ)",
          "ja": "でも、この村じゃ着ることもなさそうね",
          "tc": "不過，在這個村子似乎不會穿到。",
          "sc": "不过，在这个村子似乎不会穿到。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 15647,
          "spk": "帷 (トバリ)",
          "ja": "まあ、面倒だからいいんだけど",
          "tc": "反正很麻煩，不穿也罷。",
          "sc": "反正很麻烦，不穿也罢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 112,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15678,
          "spk": "帷 (トバリ)",
          "ja": "……猛暑の中、出歩きたくないし",
          "tc": "……我不想要在大熱天的出去外面走動。",
          "sc": "……我不想要在大热天的出去外面走动。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15685,
          "spk": "帷 (トバリ)",
          "ja": "どうにか一日家にいる方法は……",
          "tc": "有沒有整天待在家裡的方法呢……",
          "sc": "有没有整天待在家里的方法呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 113,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15716,
          "spk": "帷 (トバリ)",
          "ja": "……駄目だ",
          "tc": "……不行，",
          "sc": "……不行，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15723,
          "spk": "帷 (トバリ)",
          "ja": "今日の予定を整理しようにも",
          "tc": "就算想整理今天的行程，",
          "sc": "就算想整理今天的行程，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15730,
          "spk": "帷 (トバリ)",
          "ja": "暑くて考えがまとまらないわ……",
          "tc": "我也熱到無法思考了……",
          "sc": "我也热到无法思考了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 114,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15754,
          "spk": "帷 (トバリ)",
          "ja": "……セミがやたらうるさい以外は",
          "tc": "……除了蟬鳴特別吵之外，",
          "sc": "……除了蝉鸣特别吵之外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15761,
          "spk": "帷 (トバリ)",
          "ja": "ここも割と過ごしやすいかもね",
          "tc": "這裡可以說意外地舒適呢。",
          "sc": "这里可以说意外地舒适呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 115,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15792,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15799,
          "spk": "帷 (トバリ)",
          "ja": "暑くて食欲出ない……",
          "tc": "熱到沒有食欲啊……",
          "sc": "热到没有食欲啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 15810,
          "spk": "帷 (トバリ)",
          "ja": "何かサッパリした物が食べたいな",
          "tc": "真想吃一些清爽的食物。",
          "sc": "真想吃一些清爽的食物。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 116,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15834,
          "spk": "帷 (トバリ)",
          "ja": "夏の定番といったら、",
          "tc": "說到夏天的經典食物，",
          "sc": "说到夏天的经典食物，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15841,
          "spk": "帷 (トバリ)",
          "ja": "やっぱり水ようかんか、くずきりかな",
          "tc": "就是水羊羹或葛切之類的吧。",
          "sc": "就是水羊羹或葛切之类的吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 15859,
          "spk": "帷 (トバリ)",
          "ja": "この村じゃ手に入らないけど……",
          "tc": "雖然在這個村子裡是買不到啦……",
          "sc": "虽然在这个村子里是买不到啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 117,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15890,
          "spk": "帷 (トバリ)",
          "ja": "舗装されてない道があるのは不便だけど",
          "tc": "有些道路沒有鋪裝很不方便，",
          "sc": "有些道路没有铺装很不方便，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15897,
          "spk": "帷 (トバリ)",
          "ja": "照り返しがないだけマシか……",
          "tc": "但不會反射陽光也已經不錯了……",
          "sc": "但不会反射阳光也已经不错了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 15915,
          "spk": "帷 (トバリ)",
          "ja": "何がベストなのか、考えものね",
          "tc": "到底哪樣是才最好的呢？",
          "sc": "到底哪样是才最好的呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 118,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 15946,
          "spk": "帷 (トバリ)",
          "ja": "リンが、村の端から端まで",
          "tc": "林擬訂了計畫，",
          "sc": "林拟订了计划，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 15953,
          "spk": "帷 (トバリ)",
          "ja": "流しそうめんするとかいう計画立ててたの",
          "tc": "打算建造貫穿整個村子的流水麵線。",
          "sc": "打算建造贯穿整个村子的流水面线。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 15971,
          "spk": "帷 (トバリ)",
          "ja": "馬鹿げた思いつきだけど……",
          "tc": "這個想法雖然很蠢……",
          "sc": "这个想法虽然很蠢……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 15978,
          "spk": "帷 (トバリ)",
          "ja": "反対はしないでおくことにしたわ",
          "tc": "但我決定不加以反對。",
          "sc": "但我决定不加以反对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 119,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 16002,
          "spk": "帷 (トバリ)",
          "ja": "もし今、夏休みの自由研究をしろって言われたら",
          "tc": "如果現在叫我寫暑假的自由研究作業，",
          "sc": "如果现在叫我写暑假的自由研究作业，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 16009,
          "spk": "帷 (トバリ)",
          "ja": "この村の調査結果をまとめてみるかな",
          "tc": "我應該會統整出我對於這個村子的調查結果吧。",
          "sc": "我应该会统整出我对于这个村子的调查结果吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 16027,
          "spk": "帷 (トバリ)",
          "ja": "……誰も興味ないか",
          "tc": "……大概沒人有興趣吧。",
          "sc": "……大概没人有兴趣吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 120,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 16051,
          "spk": "帷 (トバリ)",
          "ja": "暇ね、何か大きなイベントでも起きないかな……",
          "tc": "真閒，不知道村子能不能舉辦什麼大活動……",
          "sc": "真闲，不知道村子能不能举办什么大活动……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 16069,
          "spk": "帷 (トバリ)",
          "ja": "肝試しとか、花火大会とか……",
          "tc": "像是試膽大會、煙火大會之類的……",
          "sc": "像是试胆大会、烟火大会之类的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 16076,
          "spk": "帷 (トバリ)",
          "ja": "夏の思い出が何もなしは、虚しすぎる……",
          "tc": "夏天沒有留下任何回憶也太空虛了。",
          "sc": "夏天没有留下任何回忆也太空虚了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 121,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 16107,
          "spk": "帷 (トバリ)",
          "ja": "どの辺りにどの虫が生息してるのか",
          "tc": "我已經漸漸掌握什麼昆蟲",
          "sc": "我已经渐渐掌握什么昆虫"
        },
        {
          "f_idx": 1,
          "pidx_tc": 16114,
          "spk": "帷 (トバリ)",
          "ja": "把握できるようになってきたけど……",
          "tc": "都會在什麼地方棲息了……",
          "sc": "都会在什么地方栖息了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 16125,
          "spk": "帷 (トバリ)",
          "ja": "虫に詳しくなっても嬉しくないな……",
          "tc": "但熟悉了昆蟲，也讓人開心不起來啊……",
          "sc": "但熟悉了昆虫，也让人开心不起来啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 122,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 16156,
          "spk": "帷 (トバリ)",
          "ja": "夏場は活動的になるのか、",
          "tc": "不知道是不是夏天讓祂們比較有活動力，",
          "sc": "不知道是不是夏天让他们比较有活动力，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 16163,
          "spk": "帷 (トバリ)",
          "ja": "よく幽霊や妖怪を見かける気がするの",
          "tc": "總覺得我最近經常看到幽靈跟妖怪，",
          "sc": "总觉得我最近经常看到幽灵跟妖怪，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 16181,
          "spk": "帷 (トバリ)",
          "ja": "……まぁ、出たところで何？って感じだけど",
          "tc": "……不過即便看到祂們我也不覺得怎麼樣啦。",
          "sc": "……不过即便看到他们我也不觉得怎么样啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 123,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_2100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 16212,
          "spk": "帷 (トバリ)",
          "ja": "梅雨も明けたのに、ジトジトジトジト……",
          "tc": "明明梅雨季都結束了，卻還是滴滴答答下不停……",
          "sc": "明明梅雨季都结束了，却还是滴滴答答下不停……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 16219,
          "spk": "帷 (トバリ)",
          "ja": "こっちの気分まで沈みそう",
