        {
          "f_idx": 2,
          "pidx_tc": 17223,
          "spk": "帷 (トバリ)",
          "ja": "はぁ、憂鬱……",
          "tc": "唉，真讓人鬱悶……",
          "sc": "唉，真让人郁闷……"
        }
      ]
    },
    {
      "file": "talk.dat",
