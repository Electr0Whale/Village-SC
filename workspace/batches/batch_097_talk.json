      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 17990,
          "spk": "帷 (トバリ)",
          "ja": "雨、止まないね……",
          "tc": "雨一直下不停……",
          "sc": "雨一直下不停……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 17997,
          "spk": "帷 (トバリ)",
          "ja": "今日は一日中降るのかな……",
          "tc": "會下一整天嗎……",
          "sc": "会下一整天吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 18008,
          "spk": "帷 (トバリ)",
          "ja": "このままだと帰るころには",
          "tc": "再這樣下去，",
          "sc": "再这样下去，"
