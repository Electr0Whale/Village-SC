      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 18046,
          "spk": "帷 (トバリ)",
          "ja": "なんか、どこからかいい匂いしてこない？",
          "tc": "不覺得好像從哪裡飄來香味嗎？",
