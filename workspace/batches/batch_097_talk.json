          "f_idx": 2,
          "pidx_tc": 18064,
          "spk": "帷 (トバリ)",
          "ja": "余計にお腹すくんだよね",
          "tc": "肚子總是特別餓呢。",
          "sc": "肚子总是特别饿呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 169,
      "rec_id": "TALK_ID_ORPHAN_ROUTINE_20_101_3022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 18088,
          "spk": "帷 (トバリ)",
          "ja": "寒い……昼は温かかったのに、",
          "tc": "好冷……白天明明很溫暖的，",
          "sc": "好冷……白天明明很温暖的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 18095,
          "spk": "帷 (トバリ)",
          "ja": "この時間になると急に冷えるわね……",
          "tc": "到了這個時間就會急速變冷……",
          "sc": "到了这个时间就会急速变冷……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 18113,
          "spk": "帷 (トバリ)",
          "ja": "秋は日が落ちると一気に気温が下がるの",
          "tc": "秋天只要太陽一下山，氣溫就會一口氣降下來。",
          "sc": "秋天只要太阳一下山，气温就会一口气降下来。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 18120,
          "spk": "帷 (トバリ)",
          "ja": "油断をしたら風邪をひきそう……",
          "tc": "不小心一點好像會感冒……",
          "sc": "不小心一点好像会感冒……"
        }
      ]
    },
