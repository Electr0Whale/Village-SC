      "rec_id": "TALK_ID_ORPHAN_ROUTINE_WALK_20_101_2803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 17247,
          "spk": "帷 (トバリ)",
          "ja": "夏といえば、夏休みの宿題だけど……",
