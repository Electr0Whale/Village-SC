          "f_idx": 4,
          "pidx_tc": 18022,
          "spk": "帷 (トバリ)",
          "ja": "……帰るの、億劫だな",
          "tc": "…………真不想回去啊。",
          "sc": "……真不想回去啊。"
        }
      ]
