  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5286,
      "rec_id": "TALK_ID_10_0501_127_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 306933,
          "spk": "六角 (ロッカク)",
          "ja": "……なるほど",
          "tc": "……原來如此，",
          "sc": "……原来如此，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 306940,
          "spk": "六角 (ロッカク)",
          "ja": "お二人の事情はよくわかったっス",
          "tc": "我明白你們的理由了。",
          "sc": "我明白你们的理由呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 306951,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの忠告をまるっと無視されたことには",
          "tc": "雖然完全把我的忠告當耳邊風這點，",
          "sc": "虽然完全把我的忠告当耳边风这点，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 306958,
          "spk": "六角 (ロッカク)",
          "ja": "思うところもありますが……",
          "tc": "我不太能認同就是了……",
          "sc": "我不太能认同就是了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 306976,
          "spk": "六角 (ロッカク)",
          "ja": "お二人の視点じゃ、",
          "tc": "但是從你們的角度來看，",
          "sc": "但是从你们的角度来看，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 306983,
          "spk": "六角 (ロッカク)",
          "ja": "ワシはどう見てもアヤシイ大人だ",
          "tc": "我怎麼看都是個可疑的大人。",
          "sc": "我怎么看都是个可疑的大人。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 306990,
          "spk": "六角 (ロッカク)",
          "ja": "それも仕方のないことっスかねえ",
          "tc": "所以那也是沒辦法的吧。",
          "sc": "所以那也是没办法的吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 307003,
          "spk": "裕太 (ユータ)",
          "ja": "そういうのは、もういいです",
          "tc": "那些話就省省吧，",
          "sc": "那些话就省省吧，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 307010,
          "spk": "裕太 (ユータ)",
          "ja": "はぐらかしはもう止めて、",
          "tc": "別顧左右而言他了，",
          "sc": "别顾左右而言他了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 307017,
          "spk": "裕太 (ユータ)",
          "ja": "本当のことを話してください",
          "tc": "請告訴我們真相。",
          "sc": "请告诉我们真相。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 307030,
          "spk": "六角 (ロッカク)",
          "ja": "……わかりました",
          "tc": "……我知道了。",
          "sc": "……我知道了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 307037,
          "spk": "六角 (ロッカク)",
          "ja": "十年前の事件のことっスね",
          "tc": "你是指十年前的事件對吧。",
          "sc": "你是指十年前的事件对呐。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 307050,
          "spk": "裕太 (ユータ)",
          "ja": "十年前って、つまり……",
          "tc": "你說十年前，意思是……",
          "sc": "你说十年前，意思是……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 307063,
          "spk": "六角 (ロッカク)",
          "ja": "ええ",
          "tc": "沒錯。",
          "sc": "没错。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 307070,
          "spk": "六角 (ロッカク)",
          "ja": "ワシがヨウさんの生家に盗みに入って",
          "tc": "就是我潛入洋妹妹的老家行竊，",
          "sc": "就是我潜入洋妹妹的老家行窃，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 307081,
          "spk": "六角 (ロッカク)",
          "ja": "あの子の母親を殺しちまった、",
          "tc": "卻意外殺死她母親……",
          "sc": "却意外杀死她母亲……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 307088,
          "spk": "六角 (ロッカク)",
          "ja": "あの時のことっス――",
          "tc": "那個時候的事──",
          "sc": "那个时候的事——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5287,
      "rec_id": "TALK_ID_10_0501_129_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 307116,
          "spk": "六角 (ロッカク)",
          "ja": "これが、ワシの知ってる全部っス",
          "tc": "這就是我所知道的一切。",
          "sc": "这就是我所知道的一切呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 307127,
          "spk": "裕太 (ユータ)",
          "ja": "そんなことが……",
          "tc": "原來發生了這種事……",
          "sc": "原来发生了这种事……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 307134,
          "spk": "裕太 (ユータ)",
          "ja": "このこと、ヨウちゃんには伝えないんですか",
          "tc": "你不把這件事告訴小洋嗎？",
          "sc": "你不把这件事告诉小洋吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 307147,
          "spk": "六角 (ロッカク)",
          "ja": "……言えるわけ、ないでしょう",
          "tc": "……我怎麼說得出口呢。",
          "sc": "……我怎么说得出口呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 307158,
          "spk": "六角 (ロッカク)",
          "ja": "言えるわけがない",
          "tc": "根本不可能說。",
          "sc": "根本不可能说。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 307171,
          "spk": "六角 (ロッカク)",
          "ja": "ワシは、あの子の優しさを知っている",
          "tc": "我曉得那孩子有多麼溫柔，",
          "sc": "我晓得那孩子有多么温柔，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 307178,
          "spk": "六角 (ロッカク)",
          "ja": "孤独を知っている",
          "tc": "也明白她的孤獨。",
          "sc": "也明白她的孤独。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 307185,
          "spk": "六角 (ロッカク)",
          "ja": "今話せば受け入れてしまうと、嫌でもわかる",
          "tc": "我心知肚明，現在說了她一定會選擇接受我。",
          "sc": "我心知肚明，现在说了她一定会选择接受我。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 307196,
          "spk": "六角 (ロッカク)",
          "ja": "罪を糾弾されるより、",
          "tc": "比起罪行受到譴責，",
          "sc": "比起罪行受到谴责，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 307203,
          "spk": "六角 (ロッカク)",
          "ja": "親殺しと罵られてしまうより……",
          "tc": "或是被唾罵是殺親仇人……",
          "sc": "或是被唾骂是杀亲仇人……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 307212,
          "spk": "六角 (ロッカク)",
          "ja": "仕方ないと、あの子にそう",
          "tc": "我最無法承受的，",
          "sc": "我最无法承受的，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 307219,
          "spk": "六角 (ロッカク)",
          "ja": "許されてしまうことがなにより辛い……",
          "tc": "是那孩子說一句「這也沒辦法」就原諒我……",
          "sc": "是那孩子说一句“这也没办法”就原谅我……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 307237,
          "spk": "六角 (ロッカク)",
          "ja": "ワシは罪人だ",
          "tc": "我是罪人。",
          "sc": "我是罪人。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 307244,
          "spk": "六角 (ロッカク)",
          "ja": "許されちゃいけない、人間なんだ……",
          "tc": "是個不該被原諒的人……",
          "sc": "是个不该被原谅的人……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 307257,
          "spk": "裕太 (ユータ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5288,
      "rec_id": "TALK_ID_10_0501_129_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 307283,
          "spk": "裕太 (ユータ)",
          "ja": "……山からの声は、",
          "tc": "……山裡傳來的聲音，",
          "sc": "……山里传来的声音，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 307290,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんの両親の呼び声だった",
          "tc": "原來是小洋的爸媽的呼喚聲。",
          "sc": "原来是小洋的爸妈的呼唤声。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 307301,
          "spk": "裕太 (ユータ)",
          "ja": "本当に、そうなのかな",
          "tc": "但真的是這樣嗎？",
          "sc": "但真的是这样吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 307308,
          "spk": "裕太 (ユータ)",
          "ja": "俺が聞いたあの歌声は",
          "tc": "雖然我聽到的那個歌聲，",
          "sc": "虽然我听到的那个歌声，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 307315,
          "spk": "裕太 (ユータ)",
          "ja": "たしかに悲しげな響きだったけど……",
          "tc": "嗓音的確相當哀傷……",
          "sc": "嗓音的确相当哀伤……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 307326,
          "spk": "裕太 (ユータ)",
          "ja": "う～ん、いったい",
          "tc": "唔～",
          "sc": "唔～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 307333,
          "spk": "裕太 (ユータ)",
          "ja": "どうすればいいんだろ……？",
          "tc": "到底該怎麼辦才好……？",
          "sc": "到底该怎么办才好……？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 307342,
          "spk": "裕太 (ユータ)",
          "ja": "このまま放っておいて良い",
          "tc": "我覺得這件事，",
          "sc": "我觉得这件事，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 307349,
          "spk": "裕太 (ユータ)",
          "ja": "話じゃないと思うんだけど……",
          "tc": "好像也不能就這樣放著不管……",
          "sc": "好像也不能就这样放着不管……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 307360,
          "spk": "裕太 (ユータ)",
          "ja": "考えていても仕方ない……",
          "tc": "但是繼續想也沒有用……",
          "sc": "但是继续想也没有用……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 307367,
          "spk": "裕太 (ユータ)",
          "ja": "今日はもう解散かなァ……",
          "tc": "今天還是先解散吧……",
          "sc": "今天还是先解散吧……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 307385,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、今日は",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 307392,
          "spk": "裕太 (ユータ)",
          "ja": "付き合ってくれてありがとうね",
          "tc": "謝謝你今天陪我走這一趟。",
          "sc": "谢谢你今天陪我走这一趟。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 307399,
          "spk": "裕太 (ユータ)",
          "ja": "また、なにか思いついたら相談するよ",
          "tc": "之後要是我有想到什麼，會再找你商量的。",
          "sc": "之后要是我有想到什么，会再找你商量的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5289,
      "rec_id": "TALK_ID_10_0501_130_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 307421,
          "spk": "洋 (ヨウ)",
          "ja": "……あっ",
          "tc": "……啊。",
          "sc": "……啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 307432,
          "spk": "洋 (ヨウ)",
          "ja": "ごめんなさい……",
          "tc": "對不起……",
          "sc": "对不起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 307439,
          "spk": "洋 (ヨウ)",
          "ja": "全部聞いちゃった",
          "tc": "我全都聽見了。",
          "sc": "我全都听见了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5290,
      "rec_id": "TALK_ID_10_0501_130_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 307457,
          "spk": "洋 (ヨウ)",
          "ja": "……でもね、わたし、ずっと前から知ってたよ",
          "tc": "……不過，其實我很久以前就知道了喔。",
          "sc": "……不过，其实我很久以前就知道了哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 307464,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが、何かを隠していることを……",
          "tc": "知道叔叔一直有事瞞著我……",
          "sc": "知道叔叔一直有事瞒着我……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 307471,
          "spk": "洋 (ヨウ)",
          "ja": "わたしを見て、辛そうな顔をするから……",
          "tc": "因為他看著我時，總是會露出難過的表情……",
          "sc": "因为他看着我时，总是会露出难过的表情……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 307482,
          "spk": "洋 (ヨウ)",
          "ja": "秘密があっても、本当のおとうさんでなくても、",
          "tc": "明明就算叔叔有祕密不跟我說，",
          "sc": "明明就算叔叔有秘密不跟我说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 307489,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはおじちゃんのことを",
          "tc": "就算他不是我真正的爸爸，",
          "sc": "就算他不是我真正的爸爸，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 307496,
          "spk": "洋 (ヨウ)",
          "ja": "キライになんかならないのにね……",
          "tc": "我也絕對不會討厭他的啊……",
          "sc": "我也绝对不会讨厌他的啊……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 307507,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんはね",
          "tc": "叔叔他啊，",
          "sc": "叔叔他啊，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 307514,
          "spk": "洋 (ヨウ)",
          "ja": "わたしがお洋服をよごすと",
          "tc": "每當我把衣服弄髒時，",
          "sc": "每当我把衣服弄脏时，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 307521,
          "spk": "洋 (ヨウ)",
          "ja": "なきそうな顔してしんぱいするの",
          "tc": "都會露出快哭出來的表情關心我。",
          "sc": "都会露出快哭出来的表情关心我。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 307530,
          "spk": "洋 (ヨウ)",
          "ja": "わたしが風邪をひいて寝こむと",
          "tc": "在我感冒躺在床上時，",
          "sc": "在我感冒躺在床上时，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 307537,
          "spk": "洋 (ヨウ)",
          "ja": "いつも牛乳寒天つくってくれるの",
          "tc": "總是會做牛奶寒天凍給我吃。",
          "sc": "总是会做牛奶寒天冻给我吃。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 307555,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが本当はやさしいこと、",
          "tc": "我都知道，",
          "sc": "我都知道，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 307562,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはよく知ってるから……",
          "tc": "叔叔其實是個很溫柔的人……",
          "sc": "叔叔其实是个很温柔的人……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 307573,
          "spk": "洋 (ヨウ)",
          "ja": "だからわたし、おじちゃんを助けたい",
          "tc": "所以我想幫助叔叔。",
          "sc": "所以我想帮助叔叔。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 307580,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんはなんにも悪くないんだよって",
          "tc": "我想讓他知道，",
          "sc": "我想让他知道，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 307587,
          "spk": "洋 (ヨウ)",
          "ja": "わかってほしいのに……",
          "tc": "他並沒有任何錯……",
          "sc": "他并没有任何错……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 307596,
          "spk": "洋 (ヨウ)",
          "ja": "それに……",
          "tc": "而且……",
          "sc": "而且……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5291,
      "rec_id": "TALK_ID_10_0501_130_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 307614,
          "spk": "洋 (ヨウ)",
          "ja": "山の奥の方から……",
          "tc": "從深山那邊……",
          "sc": "从深山那边……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 307621,
          "spk": "洋 (ヨウ)",
          "ja": "たぶん、あのお家から",
          "tc": "應該是從那間房子，",
          "sc": "应该是从那间房子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 307628,
          "spk": "洋 (ヨウ)",
          "ja": "まだ、聞こえる……",
          "tc": "我還是有聽到聲音傳來……",
          "sc": "我还是能听见有声音传来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 307639,
          "spk": "洋 (ヨウ)",
          "ja": "タスケテ、タスケテ、って",
          "tc": "一直在說，救命、救命，",
          "sc": "一直在说，救命、救命，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 307646,
          "spk": "洋 (ヨウ)",
