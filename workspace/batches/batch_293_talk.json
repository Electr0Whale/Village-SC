          "spk": "林 (リン)",
          "ja": "私は必ず、村長としての役目を果たします……",
          "tc": "我一定會善盡身為村長的職責……",
          "sc": "我一定会善尽身为村长的职责……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236217,
          "spk": "木助 (キスケ)",
          "ja": "……あれから十年も経ったのか",
          "tc": "……從那一天之後已經過了十年了嗎。",
          "sc": "……从那一天之后已经过了十年了吗。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 236224,
          "spk": "木助 (キスケ)",
          "ja": "早いもんだぜ",
          "tc": "時間過得真快。",
          "sc": "时间过得真快。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 236235,
          "spk": "木助 (キスケ)",
          "ja": "こんな区切りの年に、",
          "tc": "而就在這麼特別的年分，",
          "sc": "而就在这么特别的年分，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 236242,
          "spk": "木助 (キスケ)",
          "ja": "<player>が村に現れるなんてな……",
          "tc": "<player>出現在了村子裡……",
          "sc": "<player>出现在了村子里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8558,
      "rec_id": "TALK_ID_10_0202_051_04_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236260,
          "spk": "林 (リン)",
          "ja": "……キスケさん、",
          "tc": "……木助哥，",
          "sc": "……木助哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236267,
          "spk": "林 (リン)",
          "ja": "そんなこと言ってはいけないわ",
          "tc": "你不該這麼說。",
          "sc": "你不该这么说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236276,
          "spk": "林 (リン)",
          "ja": "<player>が現れたことは、",
          "tc": "<player>的出現，",
          "sc": "<player>的出现，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236283,
          "spk": "林 (リン)",
          "ja": "祝うべきことよ",
          "tc": "是一件值得慶祝的事。",
          "sc": "是一件值得庆祝的事。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236296,
          "spk": "木助 (キスケ)",
          "ja": "……どうだか",
          "tc": "……誰知道呢。",
          "sc": "……谁知道呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8559,
      "rec_id": "TALK_ID_10_0202_051_04_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236326,
          "spk": "林 (リン)",
          "ja": "あんな事件は、",
          "tc": "絕不能讓那種事件",
          "sc": "绝不能让那种事件"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236333,
          "spk": "林 (リン)",
          "ja": "もう二度と起こしてはいけないわ……",
          "tc": "再一次發生……",
          "sc": "再一次发生……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236344,
          "spk": "林 (リン)",
          "ja": "だからこそ掟は、誰もが守らなければならない",
          "tc": "也因此，所有人都必須要遵守規矩。",
          "sc": "也因此，所有人都必须要遵守规矩。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236351,
          "spk": "林 (リン)",
          "ja": "今年こそ、贄の儀式も成し遂げなければ……",
          "tc": "今年，一定要順利完成祭品儀式……",
          "sc": "今年，一定要顺利完成祭品仪式……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8560,
      "rec_id": "TALK_ID_10_0202_051_04_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236376,
          "spk": "木助 (キスケ)",
          "ja": "……それだけで防げるのかよ",
          "tc": "……光是那樣就能防範了嗎？",
          "sc": "……光是那样就能防范了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8561,
      "rec_id": "TALK_ID_10_0202_051_04_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236394,
          "spk": "林 (リン)",
          "ja": "十年前、儀式をきちんと行っていれば、",
          "tc": "十年前，如果可以好好完成儀式，",
          "sc": "十年前，如果可以好好完成仪式，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236401,
          "spk": "林 (リン)",
          "ja": "あんなことは起きなかったのよ",
          "tc": "就不會發生那樣的事情了。",
          "sc": "就不会发生那样的事情了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236421,
          "spk": "木助 (キスケ)",
          "ja": "……ふん",
          "tc": "……哼。",
          "sc": "……哼。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236428,
          "spk": "木助 (キスケ)",
          "ja": "それも、てめぇのオヤジからの遺言か?",
          "tc": "這也是妳爸的遺言嗎？",
          "sc": "这也是你爸的遗言吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 236448,
          "spk": "林 (リン)",
          "ja": "そうよ、村を守るために受け継がれた、",
          "tc": "沒錯，這是為了守護村子",
          "sc": "没错，这是为了守护村子"
        },
        {
          "f_idx": 7,
          "pidx_tc": 236455,
          "spk": "林 (リン)",
          "ja": "大切な教えよ",
          "tc": "而代代流傳下來的重要教誨。",
          "sc": "而代代流传下来的重要教诲。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8562,
      "rec_id": "TALK_ID_10_0202_051_04_02_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236478,
          "spk": "林 (リン)",
          "ja": "私に迷いはないわ",
          "tc": "我不會有任何迷惘。",
          "sc": "我不会有任何迷惘。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236491,
          "spk": "木助 (キスケ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8563,
      "rec_id": "TALK_ID_10_0202_051_04_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236521,
          "spk": "林 (リン)",
          "ja": "私も、気を引き締めないといけないわ……",
          "tc": "我也必須要提高警覺才行……",
          "sc": "我也必须要提高警觉才行……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236528,
          "spk": "林 (リン)",
          "ja": "最近よそ者も増えたから、",
          "tc": "最近外來者越來越多，",
          "sc": "最近外来者越来越多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236535,
          "spk": "林 (リン)",
          "ja": "改めて守るべきものを守らないと……",
          "tc": "我必須守護好該守護的東西……",
          "sc": "我必须守护好该守护的东西……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236548,
          "spk": "木助 (キスケ)",
          "ja": "……そんな上手くいくかねぇ",
          "tc": "……事情會那麼順利嗎？",
          "sc": "……事情会那么顺利吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8564,
      "rec_id": "TALK_ID_10_0202_051_04_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236566,
          "spk": "林 (リン)",
          "ja": "ところで……<player>",
          "tc": "話說回來……<player>，",
          "sc": "话说回来……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236573,
          "spk": "林 (リン)",
          "ja": "サボって盗み聞きしてる時間が、",
          "tc": "你還有時間偷懶，",
          "sc": "你还有时间偷懒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236580,
          "spk": "林 (リン)",
          "ja": "あなたにあるのかしら？",
          "tc": "偷聽我們講話嗎？",
          "sc": "偷听我们讲话吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236591,
          "spk": "林 (リン)",
          "ja": "早く、墓地の草を全て刈って",
          "tc": "快去把墓地的草都割完，",
          "sc": "快去把墓地的草都割完，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236598,
          "spk": "林 (リン)",
          "ja": "キレイにしなさい",
          "tc": "把這裡弄乾淨。",
          "sc": "把这里弄干净。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8565,
      "rec_id": "TALK_ID_10_0202_051_05_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236626,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、ここに、",
          "tc": "叔叔，這裡就是",
          "sc": "叔叔，这里就是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236633,
          "spk": "洋 (ヨウ)",
          "ja": "わたしの、おとうさんとおかあさんが",
          "tc": "我的爸爸、媽媽",
          "sc": "我的爸爸、妈妈"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236640,
          "spk": "洋 (ヨウ)",
          "ja": "眠っているの？",
          "tc": "沉睡的地方嗎？",
          "sc": "沉睡的地方吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236653,
          "spk": "六角 (ロッカク)",
          "ja": "そうっスよ……",
          "tc": "是啊……",
          "sc": "是啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236660,
          "spk": "六角 (ロッカク)",
          "ja": "お二人にヨウさんが元気だということ、",
          "tc": "告訴他們兩位，",
          "sc": "告诉他们两位，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 236667,
          "spk": "六角 (ロッカク)",
          "ja": "伝えてあげてくださいな",
          "tc": "洋妹妹現在過得很健康吧。",
          "sc": "洋妹妹现在过得很健康吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8566,
      "rec_id": "TALK_ID_10_0202_051_05_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236685,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんの眠る場所に、",
          "tc": "那嗶羅也跟爸爸、媽媽",
          "sc": "那哔罗也跟爸爸、妈妈"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236692,
          "spk": "洋 (ヨウ)",
          "ja": "あの子も眠ってるのかな……？",
          "tc": "一起沉睡著嗎？",
          "sc": "一起沉睡着吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8567,
      "rec_id": "TALK_ID_10_0202_051_05_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236710,
          "spk": "六角 (ロッカク)",
          "ja": "大丈夫、きっと一緒に眠ってるっス",
          "tc": "別擔心，他們一定是一起沉睡。",
          "sc": "别担心，他们一定是一起沉睡呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8568,
      "rec_id": "TALK_ID_10_0202_051_05_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236735,
          "spk": "洋 (ヨウ)",
          "ja": "そうなのかな……",
          "tc": "是嗎……",
          "sc": "是吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8569,
      "rec_id": "TALK_ID_10_0202_051_05_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236765,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、あの子はたぶんまだ、",
          "tc": "叔叔，我覺得嗶羅好像",
          "sc": "叔叔，我觉得哔罗好像"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236772,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんの側には",
          "tc": "沒有到爸爸、媽媽",
          "sc": "没有到爸爸、妈妈"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236779,
          "spk": "洋 (ヨウ)",
          "ja": "行ってないんじゃないかな……",
          "tc": "他們身邊……",
          "sc": "他们身边……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236790,
          "spk": "洋 (ヨウ)",
          "ja": "だって、夜になると",
          "tc": "因為到了晚上……",
          "sc": "因为到了晚上……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236797,
          "spk": "洋 (ヨウ)",
          "ja": "鳴き声が聞こえるから……",
          "tc": "我可以聽到嗶羅的叫聲……",
          "sc": "我可以听到哔罗的叫声……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 236808,
          "spk": "洋 (ヨウ)",
          "ja": "きっとまだ、わたしの側にいると思う……",
          "tc": "牠一定還在我身邊……",
          "sc": "它一定还在我身边……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8570,
      "rec_id": "TALK_ID_10_0202_051_05_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236826,
          "spk": "六角 (ロッカク)",
          "ja": "だ、大丈夫っスよ、ヨウさん……",
          "tc": "沒、沒事的，洋妹妹……",
          "sc": "没、没事的，洋妹妹……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236835,
          "spk": "六角 (ロッカク)",
          "ja": "きっと、大丈夫だから……",
          "tc": "一定會沒事的……",
          "sc": "一定会没事的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236842,
          "spk": "六角 (ロッカク)",
          "ja": "それよりも今日はご両親にご挨拶を……",
          "tc": "現在更重要的，是向妳父母打招呼……",
          "sc": "现在更重要的，是向你父母打招呼……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8571,
      "rec_id": "TALK_ID_10_0202_051_05_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236860,
          "spk": "洋 (ヨウ)",
          "ja": "うん……でも、わたし、",
          "tc": "嗯……可是我根本沒見過",
          "sc": "嗯……可是我根本没见过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236867,
          "spk": "洋 (ヨウ)",
          "ja": "おとうさんと、おかあさんのこと知らないし……",
          "tc": "爸爸媽媽……",
          "sc": "爸爸妈妈……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236880,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさん、それでもあなたのご両親っス……",
          "tc": "洋妹妹，即使如此，他們還是妳的父母……",
          "sc": "洋妹妹，即使如此，他们还是你的父母……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236887,
          "spk": "六角 (ロッカク)",
          "ja": "きっと、ヨウさんに祈って欲しがってるから、",
          "tc": "他們一定希望洋妹妹能為他們祈禱，",
          "sc": "他们一定希望洋妹妹能为他们祈祷，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 236894,
          "spk": "六角 (ロッカク)",
          "ja": "今日はお二人に、お参りしてあげてほしいっス",
          "tc": "今天就好好為他們祭拜一下吧。",
          "sc": "今天就好好为他们祭拜一下呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8572,
      "rec_id": "TALK_ID_10_0202_051_06_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236924,
          "spk": "堇怜 (スミレ)",
          "ja": "今年も来られて良かったね",
          "tc": "今年也能來掃墓，真是太好了。",
          "sc": "今年也能来扫墓，真是太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236931,
          "spk": "堇怜 (スミレ)",
          "ja": "何も変わらず、二人で……",
          "tc": "我們兩個都沒什麼變，平安無事……",
          "sc": "我们两个都没什么变，平安无事……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 236951,
          "spk": "莲实 (ハスミ)",
          "ja": "本当にね……",
          "tc": "就是說啊……",
          "sc": "就是说啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8573,
      "rec_id": "TALK_ID_10_0202_051_06_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 236969,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが忙しいとか言い出して、",
          "tc": "我本來還很擔心",
          "sc": "我本来还很担心"
        },
        {
          "f_idx": 1,
          "pidx_tc": 236976,
          "spk": "堇怜 (スミレ)",
          "ja": "僕一人で来る羽目になるんじゃないかって",
          "tc": "姊姊會不會說自己很忙，",
          "sc": "姐姐会不会说自己很忙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 236983,
          "spk": "堇怜 (スミレ)",
          "ja": "心配したよ",
          "tc": "讓我只能一個人過來這裡呢。",
          "sc": "让我只能一个人过来这里呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8574,
      "rec_id": "TALK_ID_10_0202_051_06_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237001,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふ……そんな理由で来なかったら、",
          "tc": "呵呵……如果因為那種理由沒來，",
          "sc": "呵呵……如果因为那种理由没来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237008,
          "spk": "莲实 (ハスミ)",
          "ja": "父さんと母さんに怒られてしまうわ",
          "tc": "我可是會被爸爸、媽媽罵的。",
          "sc": "我可是会被爸爸、妈妈骂的。"
        },
        {
