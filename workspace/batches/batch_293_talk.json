      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 217674,
          "spk": "琪娜娜 (チナナ)",
          "ja": "元気なことは、素晴らしいじゃないか",
          "tc": "精神奕奕不是很好嗎。",
          "sc": "精神奕奕不是很好吗。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 217681,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい加減、そのブラコンも直すべきだね",
          "tc": "妳也該改掉妳的戀弟情結了。",
          "sc": "你也该改掉你的恋弟情结了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8523,
      "rec_id": "TALK_ID_10_0102_030_03_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212905,
          "spk": "驹子 (コマコ)",
          "ja": "あ……あれ？",
          "tc": "咦……奇怪了？",
          "sc": "咦……奇怪了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212912,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさん、いないのかな……",
          "tc": "木助哥不在嗎……",
          "sc": "木助哥不在吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8524,
      "rec_id": "TALK_ID_10_0102_030_03_01_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212930,
          "spk": "驹子 (コマコ)",
          "ja": "約束してたのに、",
          "tc": "明明約好了，",
          "sc": "明明约好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212937,
          "spk": "驹子 (コマコ)",
          "ja": "どこ行っちゃったんだろ……",
          "tc": "是跑到哪裡去了……",
          "sc": "是跑到哪里去了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 212946,
          "spk": "驹子 (コマコ)",
          "ja": "お腹が減ってきたから、早く済ませて",
          "tc": "我已經開始餓了，想趕快完成",
          "sc": "我已经开始饿了，想赶快完成"
        },
        {
          "f_idx": 3,
          "pidx_tc": 212953,
          "spk": "驹子 (コマコ)",
          "ja": "朝ご飯、食べに行きたいんだけどな……",
          "tc": "去吃早餐呢……",
          "sc": "去吃早餐呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 212969,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8525,
      "rec_id": "TALK_ID_10_0102_030_03_01_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 212987,
          "spk": "驹子 (コマコ)",
          "ja": "作業場に資材、置かせてもらおうかな……",
          "tc": "把材料放在工作室裡好了……",
          "sc": "把材料放在工作室里好了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 212994,
          "spk": "驹子 (コマコ)",
          "ja": "きっとキスケさんなら、私が持ってきたことに",
          "tc": "相信木助哥應該會發現",
          "sc": "相信木助哥应该会发现"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213001,
          "spk": "驹子 (コマコ)",
          "ja": "気づいてくれると思うから……",
          "tc": "我把東西拿過來了……",
          "sc": "我把东西拿过来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8527,
      "rec_id": "TALK_ID_10_0102_030_03_01_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213024,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、ちょっとだけ中に入らせてもらおう",
          "tc": "那我們進去吧。",
          "sc": "那我们进去吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213031,
          "spk": "驹子 (コマコ)",
          "ja": "私についてきて",
          "tc": "跟我來。",
          "sc": "跟我来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8528,
      "rec_id": "TALK_ID_10_0102_030_03_01_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213055,
          "spk": "驹子 (コマコ)",
          "ja": "資材を届けたこと、",
          "tc": "為了讓木助哥知道",
          "sc": "为了让木助哥知道"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213062,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんがわかるように",
          "tc": "我已經把材料送來了，",
          "sc": "我已经把材料送来了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213069,
          "spk": "驹子 (コマコ)",
          "ja": "置き手紙と領収書を書いておかなきゃ",
          "tc": "得寫張留言跟收據才行。",
          "sc": "得写张留言跟收据才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8529,
      "rec_id": "TALK_ID_10_0102_030_03_01_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213087,
          "spk": "驹子 (コマコ)",
          "ja": "だから、しばらくキスケさんの仕事場を見て",
          "tc": "所以你先在木助哥的工作場所看看，",
          "sc": "所以你先在木助哥的工作场所看看，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213094,
          "spk": "驹子 (コマコ)",
          "ja": "待っててくれるとうれしいな",
          "tc": "順便等我一下吧。",
          "sc": "顺便等我一下吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213112,
          "spk": "驹子 (コマコ)",
          "ja": "……あ、でも",
          "tc": "……啊，不過，",
          "sc": "……啊，不过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213119,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんのものは触っちゃダメだよ",
          "tc": "不可以亂碰木助哥的東西喔。",
          "sc": "不可以乱碰木助哥的东西哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213126,
          "spk": "驹子 (コマコ)",
          "ja": "バレたらきっと怒られちゃうから……",
          "tc": "被發現的話一定會挨罵的……",
          "sc": "被发现的话一定会挨骂的……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 213137,
          "spk": "驹子 (コマコ)",
          "ja": "絶対に触っちゃダメだからね",
          "tc": "絕對不可以碰喔。",
          "sc": "绝对不可以碰哦。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 213144,
          "spk": "驹子 (コマコ)",
          "ja": "絶対に、だから！",
          "tc": "我說絕對！",
          "sc": "我说绝对！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8530,
      "rec_id": "TALK_ID_10_0102_030_03_01_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213168,
          "spk": "驹子 (コマコ)",
          "ja": "あ……<player>！",
          "tc": "啊……<player>！",
          "sc": "啊……<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213175,
          "spk": "驹子 (コマコ)",
          "ja": "もうすぐ書き終わるから、",
          "tc": "我就快寫好了，",
          "sc": "我就快写好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213182,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさんの仕事場を見て待っててね",
          "tc": "你邊看看木助哥的工作場所邊等我吧。",
          "sc": "你边看看木助哥的工作场所边等我吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8531,
      "rec_id": "TALK_ID_10_0102_030_03_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213208,
          "spk": "木助 (キスケ)",
          "ja": "それは俺の大事な仕事道具なんだ！",
          "tc": "那可是我重要的工作工具！",
          "sc": "那可是我重要的工作工具！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213215,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには関係ないモンを触るんじゃねえ",
          "tc": "不要亂碰跟你無關的東西。",
          "sc": "不要乱碰跟你无关的东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8532,
      "rec_id": "TALK_ID_10_0102_030_03_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213233,
          "spk": "驹子 (コマコ)",
          "ja": "き、キスケさん！　ごめんなさい……！",
          "tc": "木、木助哥！對不起……！",
          "sc": "木、木助哥！对不起……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213240,
          "spk": "驹子 (コマコ)",
          "ja": "私が勝手に……",
          "tc": "我擅自……",
          "sc": "我擅自……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8533,
      "rec_id": "TALK_ID_10_0102_030_03_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213265,
          "spk": "木助 (キスケ)",
          "ja": "ああ？",
          "tc": "講什麼啊？",
          "sc": "讲什么啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213272,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは仕事だろうが",
          "tc": "妳那是在工作，",
          "sc": "你那是在工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213279,
          "spk": "木助 (キスケ)",
          "ja": "俺はコイツに怒ってんだ",
          "tc": "我是在罵這傢伙。",
          "sc": "我是在骂这家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8534,
      "rec_id": "TALK_ID_10_0102_030_03_02_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213297,
          "spk": "木助 (キスケ)",
          "ja": "今回は大目に見てやる",
          "tc": "這次我就睜一隻眼閉一隻眼，",
          "sc": "这次我就睁一只眼闭一只眼，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213304,
          "spk": "木助 (キスケ)",
          "ja": "だが二度目はねえぞ、",
          "tc": "但沒有下次了。",
          "sc": "但没有下次了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213311,
          "spk": "木助 (キスケ)",
          "ja": "次、勝手しやがったらぶん殴ってやるからな",
          "tc": "要是再給我逮到，我會狠狠揍你一頓。",
          "sc": "要是再给我逮到，我会狠狠揍你一顿。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213324,
          "spk": "驹子 (コマコ)",
          "ja": "ご、ごめん、ごめんなさい……！",
          "tc": "對、對不起……！",
          "sc": "对、对不起……！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213331,
          "spk": "驹子 (コマコ)",
          "ja": "私からも言っておくから……",
          "tc": "我也會好好說他的……",
          "sc": "我也会好好说他的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213344,
          "spk": "木助 (キスケ)",
          "ja": "ここはガキの来る所じゃねえんだよ",
          "tc": "這裡不是小鬼該來的地方，",
          "sc": "这里不是小鬼该来的地方，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 213351,
          "spk": "木助 (キスケ)",
          "ja": "さっさと帰りやがれ",
          "tc": "快給我回去。",
          "sc": "快给我回去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8535,
      "rec_id": "TALK_ID_10_0102_030_03_02_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213377,
          "spk": "驹子 (コマコ)",
          "ja": "……ば、バレちゃったね",
          "tc": "……被、被發現了……",
          "sc": "……被、被发现了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213384,
          "spk": "驹子 (コマコ)",
          "ja": "ごめん、私のせいだね……",
          "tc": "……對不起，都是我的錯……",
          "sc": "……对不起，都是我的错……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8536,
      "rec_id": "TALK_ID_10_0102_030_03_02_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213402,
          "spk": "驹子 (コマコ)",
          "ja": "キスケさん、お仕事にプライドがあるから、",
          "tc": "木助哥對工作很自豪，",
          "sc": "木助哥对工作很自豪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213409,
          "spk": "驹子 (コマコ)",
          "ja": "仕事場に勝手に入って",
          "tc": "所以擅自闖進他的工作場所，",
          "sc": "所以擅自闯进他的工作场所，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213416,
          "spk": "驹子 (コマコ)",
          "ja": "置いてある物を触ると怒るんだけど……",
          "tc": "還亂碰放在那裡的東西，他會很生氣……",
          "sc": "还乱碰放在那里的东西，他会很生气……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213427,
          "spk": "驹子 (コマコ)",
          "ja": "でも今日は、いつもより怖かったな……",
          "tc": "不過他今天比以往都還要兇……",
          "sc": "不过他今天比以往都还要凶……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213434,
          "spk": "驹子 (コマコ)",
          "ja": "まさか、あんなに怒鳴るだなんて……",
          "tc": "沒想到他會罵得那麼大聲……",
          "sc": "没想到他会骂得那么大声……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8537,
      "rec_id": "TALK_ID_10_0102_030_03_02_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213459,
          "spk": "驹子 (コマコ)",
          "ja": "……ほんと、ごめんね、<player>",
          "tc": "……真的很抱歉，<player>。",
          "sc": "……真的很抱歉，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213466,
          "spk": "驹子 (コマコ)",
          "ja": "お詫びも兼ねて、ご飯奢らせてね",
          "tc": "就當作是賠罪，讓我請你這頓飯吧。",
          "sc": "就当作是赔罪，让我请你这顿饭吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213484,
          "spk": "驹子 (コマコ)",
          "ja": "じゃ、気を取り直して",
          "tc": "好了，重新打起精神，",
          "sc": "好了，重新打起精神，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213491,
          "spk": "驹子 (コマコ)",
          "ja": "ロッカクさんのお店に行こ",
          "tc": "出發前往六角叔的店吧。",
          "sc": "出发前往六角叔的店吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8538,
      "rec_id": "TALK_ID_10_0102_030_03_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213515,
          "spk": "驹子 (コマコ)",
          "ja": "到着だね",
          "tc": "我們到了。",
          "sc": "我们到了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213522,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も知ってるかもしれないけど、",
          "tc": "<player>可能已經知道了，",
          "sc": "<player>可能已经知道了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213529,
          "spk": "驹子 (コマコ)",
          "ja": "ここはロッカクさんが営む食堂だよ",
          "tc": "這裡就是六角叔開的餐廳。",
          "sc": "这里就是六角叔开的餐厅。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8539,
      "rec_id": "TALK_ID_10_0102_030_03_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213549,
          "spk": "六角 (ロッカク)",
          "ja": "おや、いらっしゃい",
          "tc": "哎呀，歡迎光臨，",
          "sc": "哎呀，欢迎光临，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213556,
          "spk": "六角 (ロッカク)",
          "ja": "コマコさん、<player>さん",
          "tc": "駒子妹妹，<player>。",
          "sc": "驹子妹妹，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8540,
      "rec_id": "TALK_ID_10_0102_030_03_03_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 213578,
          "spk": "六角 (ロッカク)",
          "ja": "一体どうしたんスか？",
          "tc": "發生了什麼事嗎？",
          "sc": "发生了什么事吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 213585,
          "spk": "六角 (ロッカク)",
          "ja": "二人してそんな暗い顔をして",
          "tc": "兩個人都愁眉苦臉的樣子。",
          "sc": "两个人都愁眉苦脸的样子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 213598,
          "spk": "驹子 (コマコ)",
          "ja": "さっき、キスケさんに",
          "tc": "因為我們剛剛被木助哥",
          "sc": "因为我们刚刚被木助哥"
        },
        {
          "f_idx": 3,
          "pidx_tc": 213605,
          "spk": "驹子 (コマコ)",
          "ja": "怒鳴られちゃったから……",
          "tc": "大罵了一頓……",
          "sc": "大骂了一顿……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 213618,
          "spk": "六角 (ロッカク)",
          "ja": "ありゃ……怒られちまったんスか……",
          "tc": "哎呀……被罵了啊……",
          "sc": "哎呀……被骂了啊……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 213625,
