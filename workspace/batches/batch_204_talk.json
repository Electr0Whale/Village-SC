          "ja": "本当にごめんなさい……",
          "tc": "真的很對不起……",
          "sc": "真的很对不起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 287243,
          "spk": "林 (リン)",
          "ja": "ふふ……",
