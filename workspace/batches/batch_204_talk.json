  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4924,
      "rec_id": "TALK_ID_10_0403_051_27",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285476,
          "spk": "帷 (トバリ)",
          "ja": "またそれ……？",
          "tc": "你還在說這種話……？",
          "sc": "你还在说这种话……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285483,
          "spk": "帷 (トバリ)",
          "ja": "私もこの村に住んでいるのに！",
          "tc": "我也住在這座村子裡啊！",
          "sc": "我也住在这座村子里啊！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 285496,
          "spk": "木助 (キスケ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 285507,
          "spk": "木助 (キスケ)",
          "ja": "俺は、リンの蔵を漁って",
          "tc": "我去翻翻林的倉庫，",
          "sc": "我去翻翻林的仓库，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 285514,
          "spk": "木助 (キスケ)",
          "ja": "ヅ主を呼ぶ手順を確認してくる",
          "tc": "確認一下召喚津主的步驟。",
          "sc": "确认一下召唤津主的步骤。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 285527,
          "spk": "帷 (トバリ)",
          "ja": "ヅ主を呼ぶって……",
          "tc": "要召喚津主……",
          "sc": "要召唤津主……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 285534,
          "spk": "帷 (トバリ)",
          "ja": "村人と村長の血が必要なんじゃないの？",
          "tc": "不是需要村民和村長的血嗎？",
          "sc": "不是需要村民和村长的血吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 285541,
          "spk": "帷 (トバリ)",
          "ja": "リンの血じゃなくても、ヅ主を呼べるの？",
          "tc": "就算不用林的血，也可以召喚津主嗎？",
          "sc": "就算不用林的血，也可以召唤津主吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 285554,
          "spk": "木助 (キスケ)",
          "ja": "樹木家の血は俺にも流れてる",
          "tc": "我身上也流著樹木家的血。",
          "sc": "我身上也流着树木家的血。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 285561,
          "spk": "木助 (キスケ)",
          "ja": "村長の役目だからやったことはねぇが、",
          "tc": "因為這是村長的職責，所以我是沒試過，",
          "sc": "因为这是村长的职责，所以我是没试过，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 285568,
          "spk": "木助 (キスケ)",
          "ja": "試してみる価値はある",
          "tc": "但還是值得試試看。",
          "sc": "但还是值得试试看。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 285579,
          "spk": "木助 (キスケ)",
          "ja": "俺の血も特別なのは、",
          "tc": "既然我現在還醒著，",
          "sc": "既然我现在还醒着，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 285586,
          "spk": "木助 (キスケ)",
          "ja": "今、眠ってねぇのが何よりの証拠だからな",
          "tc": "就是我也流著特殊血液的最好證明。",
          "sc": "就是我也流着特殊血液的最好证明。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4925,
      "rec_id": "TALK_ID_10_0403_051_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285613,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "那我先走啦。",
          "sc": "那我先走啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285620,
          "spk": "木助 (キスケ)",
          "ja": "てめぇらは、リンの傍にいてやれ",
          "tc": "你們就去陪在林的身邊吧。",
          "sc": "你们就去陪在林的身边吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 285627,
          "spk": "木助 (キスケ)",
          "ja": "今日はまだ診療所で寝てるだろうからな",
          "tc": "她今天應該還在診所躺著才對。",
          "sc": "她今天应该还在诊所躺着才对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4926,
      "rec_id": "TALK_ID_10_0403_051_29",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285653,
          "spk": "帷 (トバリ)",
          "ja": "……私はもう、動くなってことね",
          "tc": "……意思是叫我不要輕舉妄動是吧。",
          "sc": "……意思是叫我不要轻举妄动是吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285664,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4927,
      "rec_id": "TALK_ID_10_0403_052_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285688,
          "spk": "木助 (キスケ)",
          "ja": "てめぇ……",
          "tc": "好傢伙……",
          "sc": "好家伙……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285695,
          "spk": "木助 (キスケ)",
          "ja": "リンの傍にいろって言っただろ",
          "tc": "我不是要你待在林的身邊嗎。",
          "sc": "我不是要你待在林的身边吗。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 285706,
          "spk": "木助 (キスケ)",
          "ja": "ここで、てめぇにできるのは、",
          "tc": "你在這裡唯一能做的，",
          "sc": "你在这里唯一能做的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 285713,
          "spk": "木助 (キスケ)",
          "ja": "せいぜい俺の邪魔をしないことくらいだ",
          "tc": "就是不要妨礙我。",
          "sc": "就是不要妨碍我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4928,
      "rec_id": "TALK_ID_10_0403_052_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285739,
          "spk": "木助 (キスケ)",
          "ja": "この蔵にある資料は、",
          "tc": "這個倉庫裡的資料",
          "sc": "这个仓库里的资料"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285746,
          "spk": "木助 (キスケ)",
          "ja": "図書館には置けないモノなんだ",
          "tc": "都是無法放進圖書館裡的。",
          "sc": "都是无法放进图书馆里的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 285764,
          "spk": "木助 (キスケ)",
          "ja": "歴代の村長たちが過去の出来事やら、",
          "tc": "像是記錄了歷代村長們過去做過的事情，",
          "sc": "像是记录了历代村长们过去做过的事情，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 285771,
          "spk": "木助 (キスケ)",
          "ja": "その対処を記した手記やら……",
          "tc": "與處理方法的筆記之類的……",
          "sc": "与处理方法的笔记之类的……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 285789,
          "spk": "木助 (キスケ)",
          "ja": "つまり、村長が隠しておきたい",
          "tc": "也就是說，這裡保管著",
          "sc": "也就是说，这里保管着"
        },
        {
          "f_idx": 7,
          "pidx_tc": 285796,
          "spk": "木助 (キスケ)",
          "ja": "この土地の闇を保管してるんだよ",
          "tc": "村長想要隱藏的這片土地的黑暗。",
          "sc": "村长想要隐藏的这片土地的黑暗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4929,
      "rec_id": "TALK_ID_10_0403_052_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285829,
          "spk": "木助 (キスケ)",
          "ja": "昔、調べ物でここをひっくり返して",
          "tc": "以前，我為了查東西，把這裡的資料與文獻",
          "sc": "以前，我为了查东西，把这里的资料与文献"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285836,
          "spk": "木助 (キスケ)",
          "ja": "資料や文献を読み漁ったんだが……",
          "tc": "整個從頭到尾都翻過了一遍……",
          "sc": "整个从头到尾都翻过了一遍……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 285854,
          "spk": "木助 (キスケ)",
          "ja": "今となっては、",
          "tc": "時至今日，",
          "sc": "时至今日，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 285861,
          "spk": "木助 (キスケ)",
          "ja": "どれがどれだかわからなくなってるな……",
          "tc": "我已經搞不清楚哪個是哪個了……",
          "sc": "我已经搞不清楚哪个是哪个了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4930,
      "rec_id": "TALK_ID_10_0403_053_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285881,
          "spk": "木助 (キスケ)",
          "ja": "おい、リンはまだ……",
          "tc": "喂，林還沒……",
          "sc": "喂，林还没……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4931,
      "rec_id": "TALK_ID_10_0403_053_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285901,
          "spk": "木助 (キスケ)",
          "ja": "……リンはどこだ",
          "tc": "……林去哪了？",
          "sc": "……林去哪了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4932,
      "rec_id": "TALK_ID_10_0403_053_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 285919,
          "spk": "木助 (キスケ)",
          "ja": "あのバカ……！",
          "tc": "那個笨蛋……！",
          "sc": "那个笨蛋……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 285926,
          "spk": "木助 (キスケ)",
          "ja": "まさかヅ主を呼びに……！？",
          "tc": "該不會是去召喚津主了……！？",
          "sc": "该不会是去召唤津主了……！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 285935,
          "spk": "木助 (キスケ)",
          "ja": "あれ以上、血を流したら",
          "tc": "林要是再繼續失血，",
          "sc": "林要是再继续失血，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 285942,
          "spk": "木助 (キスケ)",
          "ja": "リンは持たない！",
          "tc": "身體會撐不住的！",
          "sc": "身体会撑不住的！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 285953,
          "spk": "木助 (キスケ)",
          "ja": "いや、それどころじゃねえ",
          "tc": "不對，不僅僅是這樣，",
          "sc": "不对，不仅仅是这样，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 285960,
          "spk": "木助 (キスケ)",
          "ja": "あいつ……今度こそしでかす気だ……！",
          "tc": "那傢伙……這次是打算豁出去了吧……！",
          "sc": "那家伙……这次是打算豁出去了吧……！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 285971,
          "spk": "木助 (キスケ)",
          "ja": "きっと次はヅ主じゃなくて、",
          "tc": "她這次八成不是要找津主，",
          "sc": "她这次八成不是要找津主，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 285978,
          "spk": "木助 (キスケ)",
          "ja": "土地神に捧げるつもりだぞ！",
          "tc": "而是要直接向土地神獻祭啊！",
          "sc": "而是要直接向土地神献祭啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4933,
      "rec_id": "TALK_ID_10_0403_053_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 286003,
          "spk": "木助 (キスケ)",
          "ja": "急ごう！",
          "tc": "動作快！",
          "sc": "动作快！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 286010,
          "spk": "木助 (キスケ)",
          "ja": "止めに行くぜ！！",
          "tc": "我們得去阻止她！！",
          "sc": "我们得去阻止她！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4934,
      "rec_id": "TALK_ID_10_0403_054_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 286036,
          "spk": "木助 (キスケ)",
          "ja": "……まじでいやがった",
          "tc": "……還真的在這裡。",
          "sc": "……还真的在这里。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 286047,
          "spk": "木助 (キスケ)",
          "ja": "早まるなよリン！　やめろ！",
          "tc": "林，別衝動！快停下！",
          "sc": "林，别冲动！快停下！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 286060,
          "spk": "林 (リン)",
          "ja": "キスケさん……",
          "tc": "木助哥……",
          "sc": "木助哥……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 286067,
          "spk": "林 (リン)",
          "ja": "<player>もいるのね……",
          "tc": "<player>也在啊……",
          "sc": "<player>也在啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 286078,
          "spk": "林 (リン)",
          "ja": "やっぱりダメだった……",
          "tc": "果然不行……",
          "sc": "果然不行……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 286085,
          "spk": "林 (リン)",
          "ja": "腕を切ってみたけれど、",
          "tc": "就算我劃破手臂，",
          "sc": "就算我划破手臂，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 286092,
          "spk": "林 (リン)",
          "ja": "ヅ主は答えてくれなかったわ",
          "tc": "津主也不願意回應我。",
          "sc": "津主也不愿意回应我。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 286105,
          "spk": "木助 (キスケ)",
          "ja": "当たり前だ！",
          "tc": "那是當然的啊！",
          "sc": "那是当然的啊！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 286112,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの血だけでヅ主が土地神の封印なんて、",
          "tc": "哪有可能光憑妳這傢伙的血，",
          "sc": "哪有可能光凭你这家伙的血，就让津主封印土地神，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 286119,
          "spk": "木助 (キスケ)",
          "ja": "とんでもない願いを叶えてくれるわけねぇだろ",
          "tc": "就讓津主實現「封印土地神」這種不得了的願望。",
          "sc": "就让津主实现“封印土地神”这种不得了的愿望。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 286132,
          "spk": "林 (リン)",
          "ja": "ごめんなさい、キスケさん",
          "tc": "對不起，木助哥。",
          "sc": "对不起，木助哥。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 286139,
          "spk": "林 (リン)",
          "ja": "私、こんなことになるまで、",
          "tc": "一直到事情落到這般田地之前，",
          "sc": "一直到事情落到这般田地之前，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 286146,
          "spk": "林 (リン)",
          "ja": "勇気が出なかったの",
          "tc": "我都沒辦法鼓起勇氣……",
          "sc": "我都没办法鼓起勇气……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4935,
      "rec_id": "TALK_ID_10_0403_054_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 286164,
          "spk": "木助 (キスケ)",
          "ja": "やめろ、やめろよ……",
          "tc": "快停下、快停下來啊……",
          "sc": "快停下、快停下来啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 286171,
          "spk": "木助 (キスケ)",
          "ja": "リン、こっちに戻ってこい",
          "tc": "林，快回來這裡！",
          "sc": "林，快回来这里！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 286184,
          "spk": "林 (リン)",
          "ja": "ダメよ、だってこれが",
          "tc": "不行的，",
          "sc": "不行的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 286191,
          "spk": "林 (リン)",
          "ja": "彼ヶ津村の村長の役目ですもの",
          "tc": "畢竟這是彼津村村長的職責啊。",
          "sc": "毕竟这是彼津村村长的职责啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 286209,
          "spk": "林 (リン)",
          "ja": "<player>、私の本当の秘密はね……",
          "tc": "<player>，其實我真正的祕密……",
          "sc": "<player>，其实我真正的秘密……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 286218,
          "spk": "林 (リン)",
          "ja": "私が……私自身が、土地神さまの",
          "tc": "是讓我自己……",
          "sc": "是让我自己……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 286225,
          "spk": "林 (リン)",
          "ja": "生贄になるということ",
          "tc": "成為土地神大人的活祭品。",
          "sc": "成为土地神大人的活祭品。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 286236,
          "spk": "林 (リン)",
          "ja": "迷って、怖くて、",
          "tc": "但我既猶豫又害怕，",
          "sc": "但我既犹豫又害怕，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 286243,
          "spk": "林 (リン)",
          "ja": "今まで誰にも言えなかった",
