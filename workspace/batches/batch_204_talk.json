    {
      "file": "talk.dat",
      "rec_idx": 4960,
      "rec_id": "TALK_ID_10_0403_055_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 287536,
          "spk": "木助 (キスケ)",
          "ja": "すまねえな",
          "tc": "抱歉啊，",
          "sc": "抱歉啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 287545,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの力を貸りる予定じゃなかったんだ",
          "tc": "原本是沒打算借用你的力量。",
          "sc": "原本是没打算借用你的力量。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 287556,
          "spk": "木助 (キスケ)",
          "ja": "悪い……勢いでよ",
          "tc": "抱歉……情急之下……",
          "sc": "抱歉……情急之下……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 287567,
          "spk": "木助 (キスケ)",
          "ja": "でも、てめぇもよくわかったろ",
          "tc": "不過你不是也很清楚嗎？",
          "sc": "不过你不是也很清楚吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 287574,
          "spk": "木助 (キスケ)",
          "ja": "この村の秘密ってのは、暴いてしまうと",
          "tc": "這座村子的祕密啊，",
          "sc": "这座村子的秘密啊，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 287581,
          "spk": "木助 (キスケ)",
          "ja": "とんでもないことが起きちまう",
          "tc": "一旦被揭發了，可是會出大事的啊。",
          "sc": "一旦被揭发了，可是会出大事的啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 287592,
          "spk": "木助 (キスケ)",
          "ja": "掟にあるだろう？",
          "tc": "規矩裡也有寫吧？",
          "sc": "规矩里也有写吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 287599,
          "spk": "木助 (キスケ)",
          "ja": "<strong>掟の四「他人の秘密を暴くな」</strong>",
          "tc": "<strong>規矩之肆「別揭露他人祕密」</strong>。",
          "sc": "<strong>规矩之肆“别揭露他人秘密”</strong>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4961,
      "rec_id": "TALK_ID_10_0403_055_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 287623,
          "spk": "木助 (キスケ)",
          "ja": "掟とは、土地神を怒らせないための、",
          "tc": "所謂的規矩，",
          "sc": "所谓的规矩，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 287630,
          "spk": "木助 (キスケ)",
          "ja": "今まで村で生きてきた人間の、",
          "tc": "是為了不觸怒土地神，",
          "sc": "是为了不触怒土地神，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 287637,
          "spk": "木助 (キスケ)",
          "ja": "知恵の結晶なんだよ",
          "tc": "由村子的先人們所留下的智慧結晶喔！",
          "sc": "由村子的先人们所留下的智慧结晶啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 287648,
          "spk": "木助 (キスケ)",
          "ja": "だから、秘密に触れてはいけない",
          "tc": "所以說，不可觸及祕密。",
          "sc": "所以说，不可触及秘密。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 287655,
          "spk": "木助 (キスケ)",
          "ja": "身を守るために……",
          "tc": "這是為了自保……",
          "sc": "这是为了自保……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 287662,
          "spk": "木助 (キスケ)",
          "ja": "取り返しがつかないことが起きないように……な",
          "tc": "也是為了避免發生無法挽回的事……懂嗎？",
          "sc": "也是为了避免发生无法挽回的事……懂吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4962,
      "rec_id": "TALK_ID_10_0403_055_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 287686,
          "spk": "木助 (キスケ)",
          "ja": "今回は偶然、リンを救った上に",
          "tc": "這次是偶然，不只救了林，",
          "sc": "这次是偶然，不只救了林，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 287693,
          "spk": "木助 (キスケ)",
          "ja": "村を元に戻すことができたが……",
          "tc": "甚至還成功讓村子恢復了原狀……",
          "sc": "甚至还成功让村子恢复了原状……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 287704,
          "spk": "木助 (キスケ)",
          "ja": "こんな奇跡、てめぇとはいえ",
          "tc": "但就算是你這傢伙，",
          "sc": "但就算是你这家伙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 287711,
          "spk": "木助 (キスケ)",
          "ja": "何度も起こせるもんじゃねぇ",
          "tc": "也不可能每次都能引發這種奇蹟。",
          "sc": "也不可能每次都能引发这种奇迹。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 287722,
          "spk": "木助 (キスケ)",
          "ja": "よく胸に刻むことだ",
          "tc": "正所謂「不招惹神明，就不會被作祟」，",
          "sc": "正所谓“不招惹神明，就不会被作祟”，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 287729,
          "spk": "木助 (キスケ)",
          "ja": "「触らぬ神に、祟りなし」ってな",
          "tc": "你可要好好銘記在心啊。",
          "sc": "你可要好好铭记在心啊。"
        }
      ]
    },
    {
