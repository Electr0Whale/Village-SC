          "f_idx": 7,
          "pidx_tc": 287284,
          "spk": "林 (リン)",
          "ja": "あなたたちのおかげで、",
          "tc": "多虧了你們，",
          "sc": "多亏了你们，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 287291,
          "spk": "林 (リン)",
          "ja": "全部をもとに戻すことができた",
          "tc": "才能讓一切都恢復原狀。",
