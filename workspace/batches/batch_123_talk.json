    {
      "file": "talk.dat",
      "rec_idx": 1417,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69921,
          "spk": "六角 (ロッカク)",
          "ja": "そうなんっスね",
          "tc": "這樣啊，",
          "sc": "这样啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69928,
          "spk": "六角 (ロッカク)",
          "ja": "いや～わざわざどうもっス",
          "tc": "哎呀～謝謝你特地拿過來。",
          "sc": "哎呀～谢谢你特地拿过来呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69939,
          "spk": "六角 (ロッカク)",
          "ja": "これ少ないけどお礼っス",
          "tc": "這是微薄的謝禮，",
          "sc": "这是微薄的谢礼，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69946,
          "spk": "六角 (ロッカク)",
          "ja": "受け取ってください",
          "tc": "請你收下吧。",
          "sc": "请你收下吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 69964,
          "spk": "六角 (ロッカク)",
          "ja": "よかったら、またお使い頼んでいいっスか？",
          "tc": "如果可以，我以後還能再請你幫忙跑腿嗎？",
          "sc": "如果可以，我以后还能再请你帮忙跑腿不？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 69971,
          "spk": "六角 (ロッカク)",
          "ja": "よろしくお願いするっス",
          "tc": "就拜託你了。",
          "sc": "就拜托你呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1418,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 70000,
          "spk": "六角 (ロッカク)",
          "ja": "あーすみません",
          "tc": "啊～不好意思，",
          "sc": "啊～不好意思，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 70007,
          "spk": "六角 (ロッカク)",
          "ja": "ちょっと勘違いしちまいましたね",
          "tc": "是我誤會了。",
          "sc": "是我误会了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 70018,
          "spk": "六角 (ロッカク)",
          "ja": "できたらいいので、",
          "tc": "如果是在你能力範圍之內，",
          "sc": "如果是在你能力范围之内，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 70025,
          "spk": "六角 (ロッカク)",
          "ja": "暇があったらよろしくっス",
          "tc": "有空的話就再麻煩你了。",
          "sc": "有空的话就再麻烦你呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1419,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 70049,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さん",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 70056,
          "spk": "六角 (ロッカク)",
          "ja": "ちゃんと自炊はしてるっスか？",
          "tc": "你都有在自己煮飯嗎？",
          "sc": "你都有在自己煮饭不？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 70067,
          "spk": "六角 (ロッカク)",
          "ja": "料理において、焼きってのは",
          "tc": "料理中的「烤」",
          "sc": "料理中的“烤”"
        },
        {
          "f_idx": 3,
          "pidx_tc": 70074,
          "spk": "六角 (ロッカク)",
          "ja": "やっぱり大事な技術なんです",
          "tc": "是一門重要的技術。",
          "sc": "是一门重要的技术。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 70085,
          "spk": "六角 (ロッカク)",
          "ja": "例えば、高級食材のマツタケなんかは",
          "tc": "比方說像是高級食材松茸，",
          "sc": "比方说像是高级食材松茸，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 70092,
          "spk": "六角 (ロッカク)",
          "ja": "香りを楽しむためにも",
          "tc": "如果想品嘗到它的香氣，",
          "sc": "如果想品尝到它的香气，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 70099,
          "spk": "六角 (ロッカク)",
          "ja": "下拵えのカットは最小限にして……",
          "tc": "備料時切片就不要切得太細……",
          "sc": "备料时切片就不要切得太细……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 70108,
          "spk": "六角 (ロッカク)",
          "ja": "あとはオーブンなんかでじっくりと",
          "tc": "接下來再用烤箱之類的耐心地烤，",
