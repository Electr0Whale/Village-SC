  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 1410,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_BIRTHDAY_20_106_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 56127,
          "spk": "茶梅 (サザンカ)",
          "ja": "ゼブラ柄のクッション！",
          "tc": "是斑馬紋抱枕喔！",
          "sc": "是斑马纹抱枕哦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 56134,
          "spk": "茶梅 (サザンカ)",
          "ja": "どう、めっちゃカッコよくない？",
          "tc": "怎麼樣，是不是帥翻了？",
          "sc": "怎么样，是不是超帅的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 56141,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシ、この柄大好きなんだよね～",
          "tc": "我超喜歡這個花紋的呢～",
          "sc": "我超喜欢这个花纹的呢～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 56152,
          "spk": "茶梅 (サザンカ)",
          "ja": "疲れた時はクッションにダイブして",
          "tc": "覺得很累的時候，推薦你撲到抱枕上，",
          "sc": "觉得很累的时候，推荐你扑到抱枕上，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 56159,
          "spk": "茶梅 (サザンカ)",
          "ja": "ごろごろするのがオススメだよ",
          "tc": "懶洋洋地滾來滾去最棒了。",
          "sc": "懒洋洋地滚来滚去最棒了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 56166,
          "spk": "茶梅 (サザンカ)",
          "ja": "昼寝にも最適だかんね",
          "tc": "想睡個午覺時，用它也很讚。",
          "sc": "想睡个午觉时，用它也超棒的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 56177,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちなみにこれ、アタシの手作りだから",
          "tc": "順帶一提，這是我親手做的，",
          "sc": "顺带一提，这是我亲手做的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 56184,
          "spk": "茶梅 (サザンカ)",
          "ja": "綿の詰め具合にこだわって、",
          "tc": "我特別講究棉花填充的份量，",
          "sc": "我特别讲究棉花填充的分量，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 56191,
          "spk": "茶梅 (サザンカ)",
          "ja": "ヤミツキのもちもち触感に仕上げといたよ",
          "tc": "調整成讓人一摸就上癮的軟綿綿觸感喔。",
          "sc": "调整成让人一摸就上瘾的软绵绵触感哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 56202,
          "spk": "茶梅 (サザンカ)",
          "ja": "綿がへたったら詰め直してあげるから",
          "tc": "要是棉花被壓塌，我還可以幫你重新填充，",
          "sc": "要是棉花被压塌，我还可以帮你重新填充，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 56209,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシんとこ持ってきな",
          "tc": "到時拿來我這邊就可以了。",
          "sc": "到时拿来我这边就可以了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 56216,
          "spk": "茶梅 (サザンカ)",
          "ja": "ふふ、充実のアフターサービスっしょ？",
          "tc": "呵呵，售後服務很周到吧？",
          "sc": "呵呵，售后服务很周到吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 56227,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>にはなんだかんだで",
          "tc": "畢竟平時受了",
          "sc": "毕竟平时受了"
        },
        {
          "f_idx": 13,
          "pidx_tc": 56234,
          "spk": "茶梅 (サザンカ)",
          "ja": "お世話になってるからね",
          "tc": "<player>不少關照，",
          "sc": "<player>不少关照，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 56241,
          "spk": "茶梅 (サザンカ)",
          "ja": "そんくらいはお安いご用よ",
          "tc": "這點小事不算什麼啦。",
          "sc": "这点小事不算什么啦。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 56252,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、これからも仲良くしてよね",
          "tc": "那我們以後也要繼續好好相處喔。",
          "sc": "那我们以后也要继续好好相处哦。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 56259,
          "spk": "茶梅 (サザンカ)",
          "ja": "最高の誕生日を過ごすんだよ",
          "tc": "祝你度過一個最棒的生日，",
          "sc": "祝你度过一个最棒的生日，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 56266,
          "spk": "茶梅 (サザンカ)",
          "ja": "またね～",
          "tc": "下次見～",
          "sc": "下次见～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1411,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69562,
          "spk": "六角 (ロッカク)",
          "ja": "ようやく、きちんとご挨拶できそうっスね",
          "tc": "終於能和你好好打聲招呼了。",
          "sc": "终于能和你好好打声招呼呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69569,
          "spk": "六角 (ロッカク)",
          "ja": "ワシはこの村で飯屋を営んでる者です",
          "tc": "我是在這個村子裡經營飯館的人。",
          "sc": "我是在这个村子里经营饭馆的人。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69587,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、色々言いたいことはあるでしょうが……",
          "tc": "我想你應該有很多話想說吧……",
          "sc": "我想你应该有很多话想说吧……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 69594,
          "spk": "六角 (ロッカク)",
          "ja": "腹が減ったらとりあえずウチに来るといいっスよ",
          "tc": "不過如果你肚子餓了的話，總之就先來我店裡吧。",
          "sc": "不过如果你肚子饿了的话，总之就先来我店里哟。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1412,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69627,
          "spk": "六角 (ロッカク)",
          "ja": "はーい、そろそろ我が家も店仕舞いっスよ～",
          "tc": "好啦～我們店裡差不多要打烊囉。",
          "sc": "好啦～我们店里差不多要打烊哟。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69634,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、<player>さん、行った行った",
          "tc": "好了，<player>，你也快回去吧。",
          "sc": "好了，<player>，你也快回去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1413,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0040",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69665,
          "spk": "六角 (ロッカク)",
          "ja": "おっと……",
          "tc": "哎呀……",
          "sc": "哎呀……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69672,
          "spk": "六角 (ロッカク)",
          "ja": "こりゃどうにも、困ったっスねぇ……",
          "tc": "這下傷腦筋了啊……",
          "sc": "这下伤脑筋了啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69683,
          "spk": "六角 (ロッカク)",
          "ja": "申し訳ないんスけど、",
          "tc": "雖然對你不太好意思，",
          "sc": "虽然对你不太好意思，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69690,
          "spk": "六角 (ロッカク)",
          "ja": "今ちょっと、手が離せないもんで",
          "tc": "但我現在有點抽不出時間。",
          "sc": "但我现在有点抽不出时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1414,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0041",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69714,
          "spk": "六角 (ロッカク)",
          "ja": "すみません、ワシには今",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69721,
          "spk": "六角 (ロッカク)",
          "ja": "あなたと話す口がないんスよ",
          "tc": "我現在不能跟你說話。",
          "sc": "我现在不能跟你说话。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69732,
          "spk": "六角 (ロッカク)",
          "ja": "いわゆる掟ってやつなんスけど……",
          "tc": "村裡有所謂的規矩……",
          "sc": "村里有所谓的规矩……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69739,
          "spk": "六角 (ロッカク)",
          "ja": "なので、お話はまたの機会ってことで",
          "tc": "所以下次有機會再聊吧。",
          "sc": "所以下次有机会再聊吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1415,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 69763,
          "spk": "六角 (ロッカク)",
          "ja": "ううむ……こいつは困った",
          "tc": "嗯……這下傷腦筋了。",
          "sc": "嗯……这下伤脑筋了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 69774,
          "spk": "六角 (ロッカク)",
          "ja": "おっと、<player>さん",
          "tc": "哦，<player>，",
          "sc": "哦，<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 69781,
          "spk": "六角 (ロッカク)",
          "ja": "良いところで会ったっスねえ",
          "tc": "你來得正好。",
          "sc": "你来得正好呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 69792,
          "spk": "六角 (ロッカク)",
          "ja": "そんな警戒しないでくださいよ",
          "tc": "你別那麼警戒嘛，",
          "sc": "你别那么警戒嘛，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 69799,
          "spk": "六角 (ロッカク)",
          "ja": "オジサンでもさすがに傷つくんで",
          "tc": "你這樣大叔我也是會傷心的。",
          "sc": "你这样大叔我也是会伤心的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 69817,
          "spk": "六角 (ロッカク)",
          "ja": "実は今、ちょいと足りないものがありまして",
          "tc": "其實我現在手邊少了一樣東西，",
          "sc": "其实我现在手边少了一样东西，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 69824,
          "spk": "六角 (ロッカク)",
          "ja": "<tmpstr>って、余ってたりします？",
          "tc": "不知道你有沒有多的<tmpstr>？",
          "sc": "不知道你有没有多的<tmpstr>？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 69842,
          "spk": "六角 (ロッカク)",
          "ja": "できれば<gamevalue GAME_VALUE_TALK_NUM>日以内に持ってきてもらえると、",
          "tc": "如果你能在<gamevalue GAME_VALUE_TALK_NUM>天之內拿來的話，",
          "sc": "如果你能在<gamevalue GAME_VALUE_TALK_NUM>天之内拿来的话，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 69849,
          "spk": "六角 (ロッカク)",
          "ja": "とても助かるんっスけどねえ",
          "tc": "我會很感激的。",
          "sc": "我会很感激呐。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 69856,
          "spk": "六角 (ロッカク)",
          "ja": "……お願い、できますかね？",
          "tc": "……能夠麻煩你嗎？",
          "sc": "……能够麻烦你吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1416,
      "rec_id": "TALK_ID_OLD_MAN_SPECIAL_20_107_0051",
      "lines": [
        {
