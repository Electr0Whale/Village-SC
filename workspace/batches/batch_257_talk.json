        {
          "f_idx": 6,
          "pidx_tc": 407901,
          "spk": "驹子 (コマコ)",
          "ja": "これは食べてくれるんだ",
          "tc": "但卻會吃這個。",
          "sc": "但却会吃这个。"
        }
      ]
    },
    {
      "file": "talk.dat",
