      "rec_id": "TALK_ID_70_2080_005_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 454400,
          "spk": "六角 (ロッカク)",
          "ja": "いえね？",
          "tc": "其實也沒什麼，",
