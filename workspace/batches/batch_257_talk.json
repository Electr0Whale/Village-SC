  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7253,
      "rec_id": "TALK_ID_70_2080_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453192,
          "spk": "六角 (ロッカク)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453199,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、<player>さんじゃないっスか",
          "tc": "啊，這不是<player>嗎？",
          "sc": "啊，这不是<player>不？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453206,
          "spk": "六角 (ロッカク)",
          "ja": "飯、食いに来たんスか？",
          "tc": "你是來吃飯的嗎？",
          "sc": "你是来吃饭的吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453217,
          "spk": "六角 (ロッカク)",
          "ja": "すみません、ちょっと手が空いてたもんで",
          "tc": "不好意思啊，我剛剛正好有點空閒，",
          "sc": "不好意思啊，我刚刚正好有点空闲，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453224,
          "spk": "六角 (ロッカク)",
          "ja": "店の帳簿とかつけてたんスよ",
          "tc": "所以在記店裡的帳。",
          "sc": "所以在记店里的帐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453231,
          "spk": "六角 (ロッカク)",
          "ja": "注文はなんスか？　腕によりをかけて作りますよ",
          "tc": "你要點什麼？我會使出渾身解數來下廚的。",
          "sc": "你要点什么？我会使出浑身解数来下厨的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7254,
      "rec_id": "TALK_ID_70_2080_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453249,
          "spk": "六角 (ロッカク)",
          "ja": "表情が険しかったっスか？",
          "tc": "你說我的表情看起來很凝重？",
          "sc": "你说我的表情看起来很凝重？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453256,
          "spk": "六角 (ロッカク)",
          "ja": "そりゃあ、まあ……",
          "tc": "可不是嘛……",
          "sc": "可不是嘛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453267,
          "spk": "六角 (ロッカク)",
          "ja": "可愛いヨウさんにあまり物を買ってやれない",
          "tc": "因為生活上沒辦法",
          "sc": "因为生活上没办法"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453274,
          "spk": "六角 (ロッカク)",
          "ja": "生活ではありますからねぇ……",
          "tc": "常常給可愛的洋買東西啊……",
          "sc": "常常给可爱的洋买东西啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453285,
          "spk": "六角 (ロッカク)",
          "ja": "なにせウチは小さな村の小さな食堂なもんで",
          "tc": "畢竟我們只是間小村子裡的小餐廳，",
          "sc": "毕竟我们只是间小村子里的小餐厅，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453292,
          "spk": "六角 (ロッカク)",
          "ja": "もうちょっと、稼げればいいんスけどねえ",
          "tc": "真希望能夠再賺多一點啊。",
          "sc": "真希望能够再赚多一点啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7255,
      "rec_id": "TALK_ID_70_2080_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453323,
          "spk": "六角 (ロッカク)",
          "ja": "どうぞ、おまちどうさま",
          "tc": "久等了，請用。",
          "sc": "久等了，请用。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453330,
          "spk": "六角 (ロッカク)",
          "ja": "いつも大変でしょうから、こいつは奢りっス",
          "tc": "感覺你也很辛苦，這我請你吃。",
          "sc": "感觉你也很辛苦，这我请你吃呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453337,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの好意、受け取ってくれますよね？",
          "tc": "這是我的好意，你就收下吧？",
          "sc": "这是我的好意，你就收下吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453346,
          "spk": "主角心声/旁白/选项",
          "ja": "ありがと",
          "tc": "謝啦",
          "sc": "谢啦"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453353,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7256,
      "rec_id": "TALK_ID_70_2080_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453564,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんも",
          "tc": "<player>你也是",
          "sc": "<player>你也是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453571,
          "spk": "六角 (ロッカク)",
          "ja": "一人暮らしってのは",
          "tc": "自己一個人生活，",
          "sc": "自己一个人生活，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453578,
          "spk": "六角 (ロッカク)",
          "ja": "なにかと大変でしょう",
          "tc": "想必有很多辛苦的地方。",
          "sc": "想必有很多辛苦的地方。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453589,
          "spk": "六角 (ロッカク)",
          "ja": "この村の連中は",
          "tc": "這村子裡的傢伙",
          "sc": "这村子里的家伙"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453596,
          "spk": "六角 (ロッカク)",
          "ja": "基本的にはみんな、人が良い",
          "tc": "基本上都是好人，",
          "sc": "基本上都是好人，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453603,
          "spk": "六角 (ロッカク)",
          "ja": "いざという時は頼るといいっスよ",
          "tc": "所以有什麼萬一的話，都可以去找他們幫忙。",
          "sc": "所以有什么万一的话，都可以去找他们帮忙哟。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 453614,
          "spk": "六角 (ロッカク)",
          "ja": "もちろん、ワシも",
          "tc": "當然了，",
          "sc": "当然了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 453621,
          "spk": "六角 (ロッカク)",
          "ja": "相談があればなんでも聞くし、",
          "tc": "你如果有什麼困擾，也都可以來找我商量，",
          "sc": "你如果有什么困扰，也都可以来找我商量，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 453628,
          "spk": "六角 (ロッカク)",
          "ja": "できる限りの手助けもできるっス",
          "tc": "我會盡量幫你的。",
          "sc": "我会尽量帮你呐。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 453639,
          "spk": "六角 (ロッカク)",
          "ja": "だから、いつでも",
          "tc": "所以歡迎你",
          "sc": "所以欢迎你"
        },
        {
          "f_idx": 10,
          "pidx_tc": 453646,
          "spk": "六角 (ロッカク)",
          "ja": "訪ねてきてくださいね",
          "tc": "隨時來找我喔。",
          "sc": "随时来找我呐。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 453657,
          "spk": "六角 (ロッカク)",
          "ja": "たとえば、家の屋根が雨漏りして困るってんなら",
          "tc": "比方說，要是你家屋頂漏雨了，",
          "sc": "比方说，要是你家屋顶漏雨了，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 453664,
          "spk": "六角 (ロッカク)",
          "ja": "部屋くらい貸しますし、",
          "tc": "我可以把房間借給你住，",
          "sc": "我可以把房间借给你住，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 453671,
          "spk": "六角 (ロッカク)",
          "ja": "キスケさんの説得にも協力しますよ",
          "tc": "也會幫你說服木助，叫他幫你補屋頂。",
          "sc": "也会帮你说服木助，叫他帮你补屋顶。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 453682,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、あの人は絶対",
          "tc": "雖然那個人是絕對不會",
          "sc": "虽然那个人是绝对不会"
        },
        {
          "f_idx": 15,
          "pidx_tc": 453689,
          "spk": "六角 (ロッカク)",
          "ja": "タダでは仕事しない人なんスけど……",
          "tc": "做白工就是了……",
          "sc": "做白工就是了……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 453700,
          "spk": "六角 (ロッカク)",
          "ja": "そこはほら、",
          "tc": "不過他在我這裡積欠了一些飯錢，",
          "sc": "不过他在我这里积欠了一些饭钱，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 453707,
          "spk": "六角 (ロッカク)",
          "ja": "こっちにも溜まったツケがあるんでね",
          "tc": "到時候我就拿這點出來說服他就行了。",
          "sc": "到时候我就拿这点出来说服他就行了。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 453725,
          "spk": "六角 (ロッカク)",
          "ja": "困ったことがあったら、",
          "tc": "如果你以後遇到困難了，",
          "sc": "如果你以后遇到困难了，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 453732,
          "spk": "六角 (ロッカク)",
          "ja": "いつでも頼って欲しいっス",
          "tc": "希望你能隨時過來找我。",
          "sc": "希望你能随时过来找我呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7257,
      "rec_id": "TALK_ID_70_2080_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453750,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、メシが冷めちまうっスね",
          "tc": "唉呀，飯都要涼掉了。",
          "sc": "唉呀，饭都要凉掉呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453757,
          "spk": "六角 (ロッカク)",
          "ja": "すいません、年をとると話が長くなっていけねぇ",
          "tc": "不好意思，人越老話就越多，真是不行啊。",
          "sc": "不好意思，人越老话就越多，真是不行啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453775,
          "spk": "六角 (ロッカク)",
          "ja": "ただ、応援してるってことだけ、",
          "tc": "我希望你記得，",
          "sc": "我希望你记得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453782,
          "spk": "六角 (ロッカク)",
          "ja": "覚えといてほしいっス",
          "tc": "我只是想要為你加油而已。",
          "sc": "我只是想要为你加油而已呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453789,
          "spk": "六角 (ロッカク)",
          "ja": "あなたと同じ、元よそ者としてね",
          "tc": "畢竟我們都是前外地人嘛。",
          "sc": "毕竟我们都是前外地人嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7258,
      "rec_id": "TALK_ID_70_2080_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453813,
          "spk": "洋 (ヨウ)",
          "ja": "だったら村のお金は",
          "tc": "這樣的話，",
          "sc": "这样的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453820,
          "spk": "洋 (ヨウ)",
          "ja": "ちゃんと払ったほうがいいと思う",
          "tc": "我覺得還是把欠村裡的錢付一付比較好。",
          "sc": "我觉得还是把欠村里的钱付一付比较好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7259,
      "rec_id": "TALK_ID_70_2080_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453846,
          "spk": "六角 (ロッカク)",
          "ja": "そりゃまあ、そうなんスけど……",
          "tc": "話是那樣說沒錯啦……",
          "sc": "话是那样说没错啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453853,
          "spk": "六角 (ロッカク)",
          "ja": "リンさんはもう少しくらいなら",
          "tc": "但林也說了，",
          "sc": "但林也说了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453860,
          "spk": "六角 (ロッカク)",
          "ja": "待ってくれるって言ってたんスよ？",
          "tc": "她願意再等我們一下。",
          "sc": "她愿意再等我们一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 453873,
          "spk": "洋 (ヨウ)",
          "ja": "でも、余裕はあるんでしょ？",
          "tc": "但我們是有錢的對吧？",
          "sc": "但我们是有钱的对吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 453886,
          "spk": "六角 (ロッカク)",
          "ja": "……はい",
          "tc": "……嗯。",
          "sc": "……嗯。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 453899,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、わたし",
          "tc": "那我現在就去",
          "sc": "那我现在就去"
        },
        {
          "f_idx": 6,
          "pidx_tc": 453906,
          "spk": "洋 (ヨウ)",
          "ja": "リンさん呼んでくるね",
          "tc": "請林姐姐過來。",
          "sc": "请林姐姐过来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7260,
      "rec_id": "TALK_ID_70_2080_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453932,
          "spk": "六角 (ロッカク)",
          "ja": "参ったっスねえ……",
          "tc": "真是傷腦筋……",
          "sc": "真是伤脑筋……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7261,
      "rec_id": "TALK_ID_70_2080_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453950,
          "spk": "六角 (ロッカク)",
          "ja": "おや、<player>さん",
          "tc": "哎呀，<player>，",
          "sc": "哎呀，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453957,
          "spk": "六角 (ロッカク)",
          "ja": "来てたんスね",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 453964,
          "spk": "六角 (ロッカク)",
          "ja": "気づかなくてすみません",
          "tc": "抱歉啊，我沒注意到你。",
          "sc": "抱歉啊，我没注意到你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7262,
      "rec_id": "TALK_ID_70_2080_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 453982,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、今の話っスか？",
          "tc": "喔，你是問我們剛才的對話嗎？",
          "sc": "喔，你是问我们刚才的对话不？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 453989,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、ほとんど見ての通りなんスけど",
          "tc": "基本上就跟你聽到的一樣。",
          "sc": "基本上就跟你听到的一样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 454007,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、前にワシが村の税的なものを",
          "tc": "我之前不是跟你說過，",
          "sc": "我之前不是跟你说过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 454014,
          "spk": "六角 (ロッカク)",
          "ja": "滞納しているって話、したじゃないっスか",
          "tc": "我欠村裡的稅金還沒繳完嗎？",
          "sc": "我欠村里的税金还没缴完不？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 454025,
          "spk": "六角 (ロッカク)",
          "ja": "その辺の事情がヨウさんにバレて、",
          "tc": "除了這件事以外，",
          "sc": "除了这件事以外，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 454032,
          "spk": "六角 (ロッカク)",
          "ja": "ついでに貯金のこともバレて",
          "tc": "存款的事也被洋妹妹發現了。",
          "sc": "存款的事也被洋妹妹发现了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 454043,
          "spk": "六角 (ロッカク)",
          "ja": "村の決まりにはちゃんと従うようにって、",
          "tc": "於是她剛剛就罵我，",
          "sc": "于是她刚刚就骂我，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 454050,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんに叱られてたところっス",
          "tc": "要我乖乖遵守村裡的規範。",
          "sc": "要我乖乖遵守村里的规范呐。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 454068,
          "spk": "六角 (ロッカク)",
          "ja": "いやあ、例の迷い家の一件以来",
          "tc": "唉，自從之前那個迷途之家的事件過後，",
          "sc": "唉，自从之前那个迷途之家的事件过后，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 454075,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが頼もしくって本当に嬉しいっス",
          "tc": "洋妹妹就越來越可靠了，我是真心替她開心。",
          "sc": "洋妹妹就越来越可靠了，我是真心替她开心呐。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 454093,
          "spk": "六角 (ロッカク)",
          "ja": "……その分、ワシのズボラさに",
          "tc": "……但她也變得更常看不慣",
          "sc": "……但她也变得更常看不惯"
        },
        {
          "f_idx": 14,
          "pidx_tc": 454100,
          "spk": "六角 (ロッカク)",
          "ja": "呆れさせることも増えちまったっスけど",
          "tc": "我做事散漫的態度了。",
          "sc": "我做事散漫的态度呐。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 454111,
          "spk": "六角 (ロッカク)",
          "ja": "これからは、過去の罪に怯えるばかりじゃなく",
          "tc": "看來從今以後，",
          "sc": "看来从今以后，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 454118,
          "spk": "六角 (ロッカク)",
          "ja": "もう少ししっかり、村のみんなと",
          "tc": "我也不能一直畏懼著自己過去的罪行，",
          "sc": "我也不能一直畏惧着自己过去的罪行，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 454125,
          "spk": "六角 (ロッカク)",
          "ja": "交流を持つべきなのかもしれないっスね",
          "tc": "而是該好好地跟村裡的其他人交流才行了。",
          "sc": "而是该好好地跟村里的其他人交流才行呐。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 454136,
          "spk": "六角 (ロッカク)",
          "ja": "まあ、それにはまず",
          "tc": "不過首先，",
          "sc": "不过首先，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 454143,
          "spk": "六角 (ロッカク)",
          "ja": "我が村で一番頼りになる<player>さんと",
          "tc": "我要先跟全村莊最可靠的<player>",
          "sc": "我要先跟全村庄最可靠的<player>"
        },
        {
          "f_idx": 20,
          "pidx_tc": 454150,
          "spk": "六角 (ロッカク)",
          "ja": "仲良くなるのが、一番っスかねえ",
          "tc": "好好交朋友才是。",
          "sc": "好好交朋友才是。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 454161,
          "spk": "六角 (ロッカク)",
          "ja": "どうかこれからも、",
          "tc": "希望從今以後，",
          "sc": "希望从今以后，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 454168,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの食堂を贔屓にしてくれると嬉しいっス",
          "tc": "你也能多多關照我們餐廳喔。",
          "sc": "你也能多多关照我们餐厅呐。"
        }
      ]
    },
