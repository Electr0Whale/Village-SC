      "rec_id": "TALK_ID_70_2060_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407851,
          "spk": "驹子 (コマコ)",
          "ja": "このメンチカツね、",
          "tc": "這個炸肉餅，",
          "sc": "这个炸肉饼，"
