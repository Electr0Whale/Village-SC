      "rec_id": "TALK_ID_70_2080_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 454219,
          "spk": "六角 (ロッカク)",
          "ja": "お、おや、リンさん……",
          "tc": "哎呀，林小姐……",
          "sc": "哎呀，林小姐……"
