  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7135,
      "rec_id": "TALK_ID_70_2060_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406776,
          "spk": "驹子 (コマコ)",
          "ja": "……ねえ、お兄ちゃん",
          "tc": "……那個，哥哥。",
          "sc": "……那个，哥哥。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406789,
          "spk": "驹子 (コマコ)",
          "ja": "ずっと……ごめんね",
          "tc": "一直以來……我都很對不起你。",
          "sc": "一直以来……我都很对不起你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406796,
          "spk": "驹子 (コマコ)",
          "ja": "私のことで……",
          "tc": "都是因為我，你才……",
          "sc": "都是因为我，你才……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406809,
          "spk": "四郎治 (シロージ)",
          "ja": "……いいんだ、気にするなよ",
          "tc": "……沒事，妳不必在意。",
          "sc": "……没事，你不必在意。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406816,
          "spk": "四郎治 (シロージ)",
          "ja": "俺こそ、隠し続けるなんて",
          "tc": "我才要跟妳說抱歉，一直瞞著妳，",
          "sc": "我才要跟你说抱歉，一直瞒着你，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406823,
          "spk": "四郎治 (シロージ)",
          "ja": "間違っていたんだから……",
          "tc": "是我錯了……",
          "sc": "是我错了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406836,
          "spk": "四郎治 (シロージ)",
          "ja": "そういうお前こそ、大丈夫か？",
          "tc": "話說回來，妳沒事嗎？",
          "sc": "话说回来，你没事吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406843,
          "spk": "四郎治 (シロージ)",
          "ja": "記憶が戻って……苦しんでないか？",
          "tc": "恢復記憶……會不會很痛苦？",
          "sc": "恢复记忆……会不会很痛苦？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406863,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 406876,
          "spk": "驹子 (コマコ)",
          "ja": "……まだ、全部は整理できてないかな",
          "tc": "……可能是心情上還沒有全部整理好。",
          "sc": "……可能是心情上还没有全部整理好。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 406883,
          "spk": "驹子 (コマコ)",
          "ja": "思い出すと、やっぱり苦しいし、",
          "tc": "一想起來，就會覺得很痛苦，",
          "sc": "一想起来，就会觉得很痛苦，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 406890,
          "spk": "驹子 (コマコ)",
          "ja": "目を背けたくもなる……",
          "tc": "進而想要逃避……",
          "sc": "进而想要逃避……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7136,
      "rec_id": "TALK_ID_70_2060_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 406910,
          "spk": "驹子 (コマコ)",
          "ja": "でも、私、もう逃げないよ",
          "tc": "可是，我不會再逃了。",
          "sc": "可是，我不会再逃了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 406923,
          "spk": "驹子 (コマコ)",
          "ja": "私がしたことも、それが消えないってことも、",
          "tc": "我深刻地體會到，",
          "sc": "我深刻地体会到，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 406930,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんとわかってる",
          "tc": "我所做過的事情是不會被抹去的。",
          "sc": "我所做过的事情是不会被抹去的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 406937,
          "spk": "驹子 (コマコ)",
          "ja": "だから……これからは、自分で背負うよ",
          "tc": "所以……從今以後我會自己背負這一切。",
          "sc": "所以……从今以后我会自己背负这一切。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 406948,
          "spk": "四郎治 (シロージ)",
          "ja": "……コマコ",
          "tc": "……駒子。",
          "sc": "……驹子。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 406961,
          "spk": "四郎治 (シロージ)",
          "ja": "……ああ、そうだな",
          "tc": "……沒錯，妳說的對。",
          "sc": "……没错，你说的对。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 406968,
          "spk": "四郎治 (シロージ)",
          "ja": "あの時、逃げたのは俺も同じだ",
          "tc": "那個時候，我也逃走了。",
          "sc": "那个时候，我也逃走了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 406975,
          "spk": "四郎治 (シロージ)",
          "ja": "だから、これは二人の責任だ",
          "tc": "所以這是我們兩個的責任。",
          "sc": "所以这是我们两个的责任。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 406988,
          "spk": "驹子 (コマコ)",
          "ja": "……そっか",
          "tc": "……這樣啊。",
          "sc": "……这样啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 406995,
          "spk": "驹子 (コマコ)",
          "ja": "じゃあ、二人で背負おう",
          "tc": "那我們就一起背負吧。",
          "sc": "那我们就一起背负吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 407002,
          "spk": "驹子 (コマコ)",
          "ja": "一人で抱えるのは、もうやめようね",
          "tc": "不要再一個人承擔囉。",
          "sc": "可别再一个人硬扛了哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7137,
      "rec_id": "TALK_ID_70_2060_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407022,
          "spk": "驹子 (コマコ)",
          "ja": "……ねえ",
          "tc": "……那個，",
          "sc": "……那个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407029,
          "spk": "驹子 (コマコ)",
          "ja": "<player>も、見ていて",
          "tc": "<player>也要好好看著我，",
          "sc": "<player>也要好好看着我，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407036,
          "spk": "驹子 (コマコ)",
          "ja": "私、ちゃんと変わるから……",
          "tc": "我一定會改變的……",
          "sc": "我一定会改变的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407049,
          "spk": "驹子 (コマコ)",
          "ja": "これまでの私は、",
          "tc": "我一直以來，",
          "sc": "我一直以来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407056,
          "spk": "驹子 (コマコ)",
          "ja": "人にどう思われるかとか、",
          "tc": "都只想著別人是怎麼看我，",
          "sc": "都只想着别人是怎么看我，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 407063,
          "spk": "驹子 (コマコ)",
          "ja": "何をしたら怒られるかばかり気にしてた",
          "tc": "怎麼做才不會被罵。",
          "sc": "怎么做才不会被骂。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 407076,
          "spk": "驹子 (コマコ)",
          "ja": "言われたとおりに動いていればいいって……",
          "tc": "別人怎麼說，我就怎麼做……",
          "sc": "别人怎么说，我就怎么做……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 407083,
          "spk": "驹子 (コマコ)",
          "ja": "自分で考えることから、ずっと逃げてたの",
          "tc": "一直逃避去自己思考。",
          "sc": "一直逃避去自己思考。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 407090,
          "spk": "驹子 (コマコ)",
          "ja": "……楽だったから",
          "tc": "……畢竟那樣做很輕鬆。",
          "sc": "……毕竟那样做很轻松。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 407103,
          "spk": "驹子 (コマコ)",
          "ja": "でも、それじゃダメだって、やっとわかった",
          "tc": "可是我終於知道，那是不行的。",
          "sc": "可是我终于知道，那是不行的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 407110,
          "spk": "驹子 (コマコ)",
          "ja": "だから、決めたんだ",
          "tc": "所以我決定了。",
          "sc": "所以我决定了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 407123,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコ……",
          "tc": "駒子……",
          "sc": "驹子……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 407136,
          "spk": "驹子 (コマコ)",
          "ja": "これからは守られるだけじゃなくて",
          "tc": "從今以後，我不要再只是被保護，",
          "sc": "从今以后，我不要再只是被保护，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 407143,
          "spk": "驹子 (コマコ)",
          "ja": "私も、守る側になる",
          "tc": "我也要去守護他人。",
          "sc": "我也要去守护他人。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 407161,
          "spk": "驹子 (コマコ)",
          "ja": "そのためにも自分で考えて、選んで……",
          "tc": "為此，我要自己思考、自己選擇……",
          "sc": "为此，我要自己思考、自己选择……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 407168,
          "spk": "驹子 (コマコ)",
          "ja": "どうやって償うのか、ちゃんと決めて行動するよ",
          "tc": "要如何補償，我會好好決定再行動。",
          "sc": "要如何补偿，我会好好决定再行动。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7138,
      "rec_id": "TALK_ID_70_2060_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407195,
          "spk": "驹子 (コマコ)",
          "ja": "だから……お兄ちゃん",
          "tc": "所以……哥哥，",
          "sc": "所以……哥哥，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407202,
          "spk": "驹子 (コマコ)",
          "ja": "これからも、狩りを教えて",
          "tc": "你以後也要繼續教我打獵喔。",
          "sc": "你以后也要继续教我打猎哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407222,
          "spk": "四郎治 (シロージ)",
          "ja": "そりゃダメとは言わねぇけど……",
          "tc": "我是不會拒絕……",
          "sc": "我是不会拒绝……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407229,
          "spk": "四郎治 (シロージ)",
          "ja": "もう契約はないんだから、",
          "tc": "但已經沒有契約了，",
          "sc": "但已经没有契约了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 407236,
          "spk": "四郎治 (シロージ)",
          "ja": "俺がやってもいいんだぜ？",
          "tc": "不如交給我吧。",
          "sc": "不如交给我吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 407249,
          "spk": "驹子 (コマコ)",
          "ja": "ううん……私がやりたい",
          "tc": "不……我想要打獵。",
          "sc": "不……我想要打猎。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 407256,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんと自分の足で立って、",
          "tc": "我想要靠我自己站穩腳步，",
          "sc": "我想要靠我自己站稳脚步，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 407263,
          "spk": "驹子 (コマコ)",
          "ja": "自分の力で償っていけるように……",
          "tc": "靠自己的力量償還……",
          "sc": "靠自己的力量偿还……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 407274,
          "spk": "驹子 (コマコ)",
          "ja": "……その先で、",
          "tc": "……未來，",
          "sc": "……未来，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 407281,
          "spk": "驹子 (コマコ)",
          "ja": "誰かを守れる人になりたいの",
          "tc": "成為一個能夠守護他人的人。",
          "sc": "成为一个能够守护他人的人。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 407294,
          "spk": "四郎治 (シロージ)",
          "ja": "……！",
          "tc": "……！",
          "sc": "……！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 407305,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、わかった",
          "tc": "嗯，我知道了。",
          "sc": "嗯，我知道了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 407312,
          "spk": "四郎治 (シロージ)",
          "ja": "頼んだぞ、コマコ",
          "tc": "那就交給妳了，駒子。",
          "sc": "那就交给你了，驹子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7139,
      "rec_id": "TALK_ID_70_2060_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407338,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407345,
          "spk": "驹子 (コマコ)",
          "ja": "ちょうどよかった",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407356,
          "spk": "驹子 (コマコ)",
          "ja": "<player>に頼みたいことがあって",
          "tc": "我有事情想拜託<player>，",
          "sc": "我有事情想拜托<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407363,
          "spk": "驹子 (コマコ)",
          "ja": "ちょっとだけ、時間もらえるかな？",
          "tc": "不知道方不方便占用你一點時間？",
          "sc": "不知道方不方便占用你一点时间？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7140,
      "rec_id": "TALK_ID_70_2060_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407387,
          "spk": "驹子 (コマコ)",
          "ja": "私……この祠の神さまに、",
          "tc": "我……想向這個祠堂的神明大人",
          "sc": "我……想向这个祠堂的神明大人"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407394,
          "spk": "驹子 (コマコ)",
          "ja": "誓いを立てようと思ってるんだ",
          "tc": "立下誓言。",
          "sc": "立下誓言。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407405,
          "spk": "驹子 (コマコ)",
          "ja": "だから……よかったら、",
          "tc": "所以……如果你不介意的話，",
          "sc": "所以……如果你不介意的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407412,
          "spk": "驹子 (コマコ)",
          "ja": "見守っていてくれないかな？",
          "tc": "可以在旁邊見證嗎？",
          "sc": "可以在旁边见证吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7141,
      "rec_id": "TALK_ID_70_2060_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407436,
          "spk": "驹子 (コマコ)",
          "ja": "神さま、神さま、聞いてください……",
          "tc": "神明大人、神明大人，請祢傾聽我的請求……",
          "sc": "神明大人、神明大人，请你倾听我的请求……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407443,
          "spk": "驹子 (コマコ)",
          "ja": "十年前、お兄ちゃんは狐と契約して、",
          "tc": "十年前，哥哥與狐狸訂下契約，",
          "sc": "十年前，哥哥与狐狸订下契约，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 407450,
          "spk": "驹子 (コマコ)",
          "ja": "私の殺人の記憶を封じていました……",
          "tc": "封印了我殺人的記憶……",
          "sc": "封印了我杀人的记忆……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 407459,
          "spk": "驹子 (コマコ)",
          "ja": "もう契約は破棄されたけど……",
          "tc": "雖然契約已經不算數了……",
          "sc": "虽然契约已经不算数了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 407466,
          "spk": "驹子 (コマコ)",
          "ja": "お兄ちゃんは十年間もの間、私のために",
          "tc": "但哥哥在這十年來，為了我，",
          "sc": "但哥哥在这十年来，为了我，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 407473,
          "spk": "驹子 (コマコ)",
          "ja": "ずっと約束を守りつづけてくれました……",
          "tc": "一直都在遵守著約定……",
          "sc": "一直都在遵守着约定……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 407484,
          "spk": "驹子 (コマコ)",
          "ja": "誰にも言わず、秘密を抱えて……",
          "tc": "獨自守著祕密，沒有對任何人說……",
          "sc": "独自守着秘密，没有对任何人说……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 407491,
          "spk": "驹子 (コマコ)",
          "ja": "罪を犯した、私を思って……",
          "tc": "為了犯下罪過的我……",
          "sc": "为了犯下罪过的我……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 407500,
          "spk": "驹子 (コマコ)",
          "ja": "事件を起こしたのは、私の意思じゃない……",
          "tc": "即使發生那件事，並不是出自於我的意志……",
          "sc": "即使发生那件事，并不是出自于我的意志……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 407507,
          "spk": "驹子 (コマコ)",
          "ja": "それでも、起きたことに変わりはない……",
          "tc": "但是已經發生過的事情無法改變……",
          "sc": "但是已经发生过的事情无法改变……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 407525,
          "spk": "驹子 (コマコ)",
          "ja": "そしてなにより、私は罪を償わずに",
          "tc": "而且，我就這樣活到現在，",
          "sc": "而且，我就这样活到现在，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 407532,
          "spk": "驹子 (コマコ)",
          "ja": "今まで生きてきてしまいました……",
          "tc": "從沒有償還我的罪過……",
          "sc": "从没有偿还我的罪过……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 407543,
          "spk": "驹子 (コマコ)",
          "ja": "真実を知った以上、",
          "tc": "既然現在知道了真相，",
          "sc": "既然现在知道了真相，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 407550,
          "spk": "驹子 (コマコ)",
          "ja": "今までのようには暮らせない……",
          "tc": "我已經沒辦法繼續當作不知道……",
          "sc": "我已经没办法继续当作不知道……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 407559,
          "spk": "驹子 (コマコ)",
          "ja": "今までのように、",
          "tc": "一直以來，",
          "sc": "一直以来，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 407566,
          "spk": "驹子 (コマコ)",
          "ja": "人の意見を聞いているだけじゃ、だめなの……",
          "tc": "我都只是接受大家的意見，那是不行的……",
          "sc": "我都只是接受大家的意见，那是不行的……"
        },
        {
          "f_idx": 17,
          "pidx_tc": 407577,
          "spk": "驹子 (コマコ)",
          "ja": "だから、私、変わります",
          "tc": "所以，我要做出改變。",
          "sc": "所以，我要做出改变。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 407584,
          "spk": "驹子 (コマコ)",
          "ja": "これから、ちゃんと罪を償って、",
          "tc": "今後會好好償還我的罪過……",
          "sc": "今后会好好偿还我的罪过……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 407591,
          "spk": "驹子 (コマコ)",
          "ja": "守ってくれた人たちに、恩返しをしたいから……",
          "tc": "報答那些一直以來守護著我的人們……",
          "sc": "报答那些一直以来守护着我的人们……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 407600,
          "spk": "驹子 (コマコ)",
          "ja": "過去に目をそらさずに、",
          "tc": "去正視過去，",
          "sc": "去正视过去，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 407607,
          "spk": "驹子 (コマコ)",
          "ja": "何をすればいいのか",
          "tc": "該做些什麼。",
          "sc": "该做些什么。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 407614,
          "spk": "驹子 (コマコ)",
          "ja": "自分で考えて、ちゃんと行動します",
          "tc": "這些我都會自己思考，確實地去行動。",
          "sc": "这些我都会自己思考，确实地去行动。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 407625,
          "spk": "驹子 (コマコ)",
          "ja": "私の周りにいてくれた、",
          "tc": "為了那些在我身邊的",
          "sc": "为了那些在我身边的"
        },
        {
          "f_idx": 24,
          "pidx_tc": 407632,
          "spk": "驹子 (コマコ)",
          "ja": "優しい人たちのために……",
          "tc": "溫柔的人們……",
          "sc": "温柔的人们……"
        },
        {
          "f_idx": 25,
          "pidx_tc": 407641,
          "spk": "驹子 (コマコ)",
          "ja": "私が奪った時間や、命や、優しさを、",
          "tc": "那些我所奪走的時間、生命與溫柔，",
          "sc": "那些我所夺走的时间、生命与温柔，"
        },
        {
          "f_idx": 26,
          "pidx_tc": 407648,
          "spk": "驹子 (コマコ)",
          "ja": "ちゃんと返していけるように……",
          "tc": "我會好好償還……",
          "sc": "我会好好偿还……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 407666,
          "spk": "驹子 (コマコ)",
          "ja": "…‥誓います",
          "tc": "……我發誓。",
          "sc": "……我发誓。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 407673,
          "spk": "驹子 (コマコ)",
          "ja": "私、しっかりがんばります……",
          "tc": "我會努力去做……",
          "sc": "我会努力去做……"
        },
        {
          "f_idx": 30,
          "pidx_tc": 407684,
          "spk": "驹子 (コマコ)",
          "ja": "だから、神さま……",
          "tc": "所以，神明大人……",
          "sc": "所以，神明大人……"
        },
        {
          "f_idx": 31,
          "pidx_tc": 407691,
          "spk": "驹子 (コマコ)",
          "ja": "どうか見守っていてください……",
          "tc": "請守護我",
          "sc": "请守护我"
        }
      ]
    },
