        },
        {
          "f_idx": 4,
          "pidx_tc": 454253,
          "spk": "林 (リン)",
          "ja": "覚悟を決めたって聞いたんだもの",
          "tc": "終於下定決心要還債了嘛。",
          "sc": "终于下定决心要还债了嘛。"
