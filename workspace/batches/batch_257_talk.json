        {
          "f_idx": 4,
          "pidx_tc": 407958,
          "spk": "驹子 (コマコ)",
          "ja": "思いつくんだけど……",
          "tc": "哥哥和其他人喜歡吃的……",
          "sc": "哥哥和其他人喜欢吃的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 407969,
          "spk": "驹子 (コマコ)",
          "ja": "<player>は、自分が好きなもの",
          "tc": "<player>，你能馬上想到",
          "sc": "<player>，你能马上想到"
        },
        {
          "f_idx": 6,
          "pidx_tc": 407976,
          "spk": "驹子 (コマコ)",
          "ja": "すぐに思いつく……？",
          "tc": "自己喜歡什麼東西嗎……？",
          "sc": "自己喜欢什么东西吗……？"
        },
        {
