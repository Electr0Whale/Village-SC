        {
          "f_idx": 1,
          "pidx_tc": 408197,
          "spk": "驹子 (コマコ)",
          "ja": "大事な思い出があるの",
          "tc": "有著我很重要的回憶。",
          "sc": "有着我很重要的回忆。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408208,
          "spk": "驹子 (コマコ)",
          "ja": "昔、お兄ちゃんから",
          "tc": "那是以前哥哥他",
          "sc": "那是以前哥哥他"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408215,
          "spk": "驹子 (コマコ)",
          "ja": "狩りのやり方を教えてもらって……",
          "tc": "在教我怎麼打獵的時候……",
          "sc": "在教我怎么打猎的时候……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408224,
          "spk": "驹子 (コマコ)",
          "ja": "やっと慣れてきたなって頃に、",
          "tc": "在我終於學會的時候，",
          "sc": "在我终于学会的时候，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408231,
          "spk": "驹子 (コマコ)",
          "ja": "ご褒美で作ってもらったんだ",
          "tc": "他做了這個火鍋獎勵我。",
          "sc": "他做了这个火锅奖励我。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408242,
          "spk": "驹子 (コマコ)",
          "ja": "おいしかったなぁ……",
          "tc": "當時那個火鍋真的是非常好吃……",
          "sc": "当时那个火锅真的是非常好吃……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 408249,
          "spk": "驹子 (コマコ)",
          "ja": "今でも思い出すよ",
          "tc": "我到現在也能回想起那個滋味。",
          "sc": "我到现在也能回想起那个滋味。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7150,
      "rec_id": "TALK_ID_70_2060_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408267,
          "spk": "驹子 (コマコ)",
          "ja": "どう？",
