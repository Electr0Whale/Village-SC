        {
          "f_idx": 1,
          "pidx_tc": 454226,
          "spk": "六角 (ロッカク)",
          "ja": "お早いお着きっスね",
          "tc": "妳來得真快啊……",
          "sc": "你来得真快啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 454239,
          "spk": "林 (リン)",
          "ja": "それはもちろん",
          "tc": "那當然，",
          "sc": "那当然，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 454246,
          "spk": "林 (リン)",
