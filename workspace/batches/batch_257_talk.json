    {
      "file": "talk.dat",
      "rec_idx": 7267,
      "rec_id": "TALK_ID_70_2080_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 454457,
          "spk": "六角 (ロッカク)",
          "ja": "話、聞いてくれるんスか？",
          "tc": "你願意聽我訴苦嗎？",
          "sc": "你愿意听我诉苦吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 454464,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんは本当に優しいっスねえ",
          "tc": "<player>你真的很溫柔呢。",
          "sc": "<player>你真的很温柔呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 454475,
          "spk": "六角 (ロッカク)",
          "ja": "……実は最近、",
          "tc": "……其實最近，",
          "sc": "……其实最近，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 454482,
          "spk": "六角 (ロッカク)",
          "ja": "村の若い衆に避けられてる気がするんスよ",
          "tc": "我總覺得村裡的年輕人都在躲著我。",
          "sc": "我总觉得村里的年轻人都在躲着我。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 454493,
          "spk": "六角 (ロッカク)",
          "ja": "特に、トバリさんとスミレさんっスね",
          "tc": "尤其是帷妹妹和堇怜弟弟，",
          "sc": "尤其是帷妹妹和堇怜弟弟，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 454500,
          "spk": "六角 (ロッカク)",
          "ja": "さっき声をかけた時も、",
          "tc": "我剛剛跟他們打招呼的時候，",
          "sc": "我刚刚跟他们打招呼的时候，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 454507,
          "spk": "六角 (ロッカク)",
          "ja": "蜘蛛の子散らすようにさっと行っちまって",
          "tc": "他們也是馬上就如鳥獸散地跑走了。",
          "sc": "他们也是马上就如鸟兽散地跑走了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 454518,
          "spk": "六角 (ロッカク)",
          "ja": "十年前のあの日以来、",
          "tc": "自十年前的那天起，",
          "sc": "自十年前的那天起，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 454525,
          "spk": "六角 (ロッカク)",
          "ja": "ちっとは「良い人」になろうと",
          "tc": "我好歹也做了一些掙扎，",
