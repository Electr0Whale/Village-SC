      "rec_id": "TALK_ID_70_2060_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408190,
          "spk": "驹子 (コマコ)",
          "ja": "この料理にはね……",
          "tc": "這道料理啊……",
          "sc": "这道料理啊……"
