          "pidx_tc": 454284,
          "spk": "六角 (ロッカク)",
          "ja": "あの、えっと、お手柔らかに……",
          "tc": "呃、那個，還請妳手下留情啊……",
          "sc": "呃、那个，还请你手下留情啊……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 454291,
          "spk": "六角 (ロッカク)",
          "ja": "いくら覚悟を決めたって、",
          "tc": "畢竟不管我的決心有多麼堅定，",
          "sc": "毕竟不管我的决心有多么坚定，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 454298,
          "spk": "六角 (ロッカク)",
          "ja": "ない袖は振れやしないんスからね！？",
          "tc": "我的口袋也不會變得更深嘛！",
          "sc": "我的口袋也不会变得更深嘛！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 454311,
          "spk": "林 (リン)",
          "ja": "それはあなたの態度次第よ",
          "tc": "這就要看你的態度了。",
          "sc": "这就要看你的态度了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 454322,
          "spk": "林 (リン)",
          "ja": "ふふっ、まずはどの話から始めましょうか",
          "tc": "呵呵，我們該先從哪裡開始談起呢？",
          "sc": "呵呵，我们该先从哪里开始谈起呢？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 454329,
          "spk": "林 (リン)",
          "ja": "土地代？　住民税？　それとも……",
          "tc": "土地的費用？居民稅？還是……",
          "sc": "土地的费用？居民税？还是……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 454336,
          "spk": "林 (リン)",
          "ja": "結局逃げた、健康診断の話からにしましょうか？",
          "tc": "被你逃掉的健康檢查？",
          "sc": "被你逃掉的健康检查？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 454349,
          "spk": "六角 (ロッカク)",
          "ja": "ひぇぇ……っ",
          "tc": "嗚嗚……",
          "sc": "呜呜……"
        }
      ]
    },
