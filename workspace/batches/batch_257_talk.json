        {
          "f_idx": 4,
          "pidx_tc": 454432,
          "spk": "六角 (ロッカク)",
          "ja": "ハハ……",
          "tc": "哈哈……",
          "sc": "哈哈……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 454439,
