        {
          "f_idx": 11,
          "pidx_tc": 454550,
          "spk": "六角 (ロッカク)",
          "ja": "困ってたら手助けしたり……",
          "tc": "或是幫助遇到困難的孩子……",
          "sc": "或是帮助遇到困难的孩子……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 454561,
          "spk": "六角 (ロッカク)",
          "ja": "思いつくことはなんでもやって来たんですが",
          "tc": "能做的我都做了，",
          "sc": "能做的我都做了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 454568,
          "spk": "六角 (ロッカク)",
          "ja": "ありがた迷惑だったんスかねえ、やっぱり",
          "tc": "但我這果然是好心辦了壞事吧。",
          "sc": "但我这果然是好心办了坏事吧。"
        }
      ]
    },
