      "rec_id": "TALK_ID_70_2060_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 407788,
          "spk": "驹子 (コマコ)",
          "ja": "あ、<player>！",
          "tc": "啊，<player>！",
          "sc": "啊，<player>！"
