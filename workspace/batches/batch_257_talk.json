          "spk": "驹子 (コマコ)",
          "ja": "……えっ？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 407933,
          "spk": "驹子 (コマコ)",
          "ja": "私の好物は……えーっと……？",
          "tc": "你問我喜歡吃什麼……呃……？",
