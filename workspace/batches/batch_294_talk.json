      "rec_id": "TALK_ID_10_0202_051_06_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237117,
          "spk": "堇怜 (スミレ)",
          "ja": "そういえば姉さん、父さんが死んだのって",
          "tc": "姊姊，爸爸過世的時候，",
          "sc": "姐姐，爸爸过世的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237124,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が小さいころだよね？",
          "tc": "我還很小對吧？",
          "sc": "我还很小对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237135,
          "spk": "堇怜 (スミレ)",
          "ja": "父さんが死んだから、",
          "tc": "聽說自從爸爸去世之後，",
          "sc": "听说自从爸爸去世之后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237142,
          "spk": "堇怜 (スミレ)",
          "ja": "母さんは医者をやめたんだって聞いたけど……",
          "tc": "媽媽就不當醫生了……",
          "sc": "妈妈就不当医生了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 237160,
          "spk": "堇怜 (スミレ)",
          "ja": "二人とも、どうして急に死んじゃったのか",
          "tc": "差不多可以告訴我",
          "sc": "差不多可以告诉我"
        },
        {
          "f_idx": 6,
          "pidx_tc": 237167,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ僕にも、教えてくれない？",
          "tc": "他們兩個突然去世的原因了吧？",
          "sc": "他们两个突然去世的原因了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8576,
      "rec_id": "TALK_ID_10_0202_051_06_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237192,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレ……",
          "tc": "堇怜……",
          "sc": "堇怜……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237203,
          "spk": "莲实 (ハスミ)",
          "ja": "……ごめんなさい",
          "tc": "……對不起。",
          "sc": "……对不起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237216,
          "spk": "堇怜 (スミレ)",
          "ja": "またそれかよ……",
          "tc": "又來了……",
          "sc": "又来了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237223,
          "spk": "堇怜 (スミレ)",
          "ja": "僕には、まだ早いってやつだね？",
          "tc": "又要說對我來說還太早了嗎？",
          "sc": "又要说对我来说还太早了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8577,
      "rec_id": "TALK_ID_10_0202_051_06_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237241,
          "spk": "莲实 (ハスミ)",
          "ja": "……ごめん、なさい",
          "tc": "……對不起。",
          "sc": "……对不起。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8578,
      "rec_id": "TALK_ID_10_0202_051_07_01_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237269,
          "spk": "今野 (コンノ)",
          "ja": "アナタも駆り出されたんですか……",
          "tc": "連您都被叫來了呀。",
          "sc": "连您都被叫来了呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237276,
          "spk": "今野 (コンノ)",
          "ja": "我々には関係ないのに……お互い大変ですねェ",
          "tc": "明明跟我們毫無關係……彼此都辛苦了呢。",
          "sc": "明明跟我们毫无关系……彼此都辛苦呐～。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8579,
      "rec_id": "TALK_ID_10_0202_051_07_01_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237301,
          "spk": "今野 (コンノ)",
          "ja": "それにしても……",
          "tc": "話說回來……",
          "sc": "话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237308,
          "spk": "今野 (コンノ)",
          "ja": "墓参りの合図が狼煙だなんて、",
          "tc": "掃墓的信號竟然是狼煙，",
          "sc": "扫墓的信号竟然是狼烟，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237315,
          "spk": "今野 (コンノ)",
          "ja": "時代錯誤も甚だしいと思いませんかァ？",
          "tc": "不覺得這實在太不符合時代了嗎？",
          "sc": "不觉得这实在太不符合时代了吗～？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237328,
          "spk": "今野 (コンノ)",
          "ja": "はァ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 237335,
          "spk": "今野 (コンノ)",
          "ja": "これだから田舎はキライなんですよねェ……",
          "tc": "就是這樣我才討厭鄉下……",
          "sc": "就是这样我才讨厌乡下……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8580,
      "rec_id": "TALK_ID_10_0202_051_07_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237361,
          "spk": "今野 (コンノ)",
          "ja": "この村の墓地は、初めてですか？",
          "tc": "您是第一次來到村子的墓地嗎？",
          "sc": "您是第一次来到村子的墓地吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237381,
          "spk": "今野 (コンノ)",
          "ja": "ふふふ、村の規模に比べて墓が多すぎる……",
          "tc": "呵呵呵，以村子的規模來說，墳墓實在太多了……",
          "sc": "呵呵呵，以村子的规模来说，坟墓实在太多了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 237388,
          "spk": "今野 (コンノ)",
          "ja": "気味の悪い場所でしょう？",
          "tc": "讓人感覺氣氛詭異，是吧？",
          "sc": "让人感觉气氛诡异，是吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8581,
      "rec_id": "TALK_ID_10_0202_051_07_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 237413,
          "spk": "今野 (コンノ)",
          "ja": "それでもリンさんにとっては、",
          "tc": "即使如此，對林小姐來說，",
          "sc": "即使如此，对林小姐来说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 237420,
          "spk": "今野 (コンノ)",
          "ja": "村の歴史を感じる大切な場所なんですって",
          "tc": "這裡是能感受到村子歷史的重要場所。",
          "sc": "这里是能感受到村子历史的重要场所。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 237427,
          "spk": "今野 (コンノ)",
          "ja": "本当に、愚かな娘ですよねェ",
          "tc": "實在是個愚蠢的姑娘呢。",
          "sc": "实在是个愚蠢的姑娘呐～。"
        }
      ]
    }
  ]
