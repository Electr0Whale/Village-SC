      "rec_id": "TALK_ID_70_0110_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 377862,
          "spk": "堇怜 (スミレ)",
          "ja": "あれ、こんなところで何してるの？",
          "tc": "咦？你們在這種地方做什麼啊？",
          "sc": "咦？你们在这种地方做什么啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6407,
      "rec_id": "TALK_ID_70_0110_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 377891,
          "spk": "堇怜 (スミレ)",
          "ja": "子どもだけで川遊びなんて危ないよ",
          "tc": "小孩子單獨在河邊玩水是很危險的喔。",
          "sc": "小孩子单独在河边玩水是很危险的哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 377916,
          "spk": "洋 (ヨウ)",
          "ja": "あ、スミレくん",
          "tc": "啊，堇怜哥哥。",
          "sc": "啊，堇怜哥哥。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 377923,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、その……お魚を……",
          "tc": "我……那個……想要釣魚……",
          "sc": "我……那个……想要钓鱼……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 377936,
          "spk": "堇怜 (スミレ)",
          "ja": "……ああ、釣り方がわからないんだ",
          "tc": "……哦，原來是不知道怎麼釣魚啊。",
          "sc": "……哦，原来是不知道怎么钓鱼啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 377943,
          "spk": "堇怜 (スミレ)",
          "ja": "なら、僕が教えようか？",
          "tc": "那我來教妳吧？",
          "sc": "那我来教你吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 377956,
          "spk": "洋 (ヨウ)",
          "ja": "いいの？",
          "tc": "可以嗎？",
          "sc": "可以吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 377969,
          "spk": "堇怜 (スミレ)",
          "ja": "それくらいお安い御用だよ",
          "tc": "這點小事，包在我身上。",
          "sc": "这点小事，包在我身上。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 377976,
