          "f_idx": 6,
          "pidx_tc": 378362,
          "spk": "洋 (ヨウ)",
          "ja": "１匹でいいや",
          "tc": "還是先1條就好了。",
          "sc": "还是先1条就好了。"
        }
      ]
    },
