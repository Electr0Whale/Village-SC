        {
          "f_idx": 1,
          "pidx_tc": 378009,
          "spk": "堇怜 (スミレ)",
          "ja": "魚が居そうな場所を探すのが重要なんだ",
          "tc": "就是要找到有魚棲息的地方。",
          "sc": "就是要找到有鱼栖息的地方。"
        }
      ]
    },
    {
      "file": "talk.dat",
