  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6382,
      "rec_id": "TALK_ID_70_0090_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364655,
          "spk": "今野 (コンノ)",
          "ja": "アナタのお喋りに付き合っている",
          "tc": "我沒空在這邊",
          "sc": "我没空在这边"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364662,
          "spk": "今野 (コンノ)",
          "ja": "暇はありません",
          "tc": "陪您閒聊了，",
          "sc": "陪您闲聊了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364669,
          "spk": "今野 (コンノ)",
          "ja": "ワタシは忙しいんですヨ",
          "tc": "我可是很忙的。",
          "sc": "我可是很忙哟～。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364680,
          "spk": "今野 (コンノ)",
          "ja": "……ところでアナタ、",
          "tc": "……對了，",
          "sc": "……对了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364687,
          "spk": "今野 (コンノ)",
          "ja": "何か用だったんです？",
          "tc": "您找我有什麼事嗎？",
          "sc": "您找我有什么事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6383,
      "rec_id": "TALK_ID_70_0090_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364705,
          "spk": "今野 (コンノ)",
          "ja": "ああ、薪の束……薪の束ね",
          "tc": "哦，木柴捆……木柴捆啊。",
          "sc": "哦，木柴捆……木柴捆啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364712,
          "spk": "今野 (コンノ)",
          "ja": "まァ、そこらへんに置いといてください",
          "tc": "您隨便放在那邊就好了。",
          "sc": "您随便放在那边就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6384,
      "rec_id": "TALK_ID_70_0090_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364732,
          "spk": "今野 (コンノ)",
          "ja": "……なんです？",
          "tc": "……怎麼了？",
          "sc": "……怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364739,
          "spk": "今野 (コンノ)",
          "ja": "まだなんか用ですか？",
          "tc": "還有什麼事嗎？",
          "sc": "还有什么事吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364750,
          "spk": "今野 (コンノ)",
          "ja": "もしかして……",
          "tc": "難道說……",
          "sc": "难道说……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364757,
          "spk": "今野 (コンノ)",
          "ja": "厚かましくもこのワタシに",
          "tc": "您居然臉皮厚到",
          "sc": "您居然脸皮厚到"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364764,
          "spk": "今野 (コンノ)",
          "ja": "お手伝いのお礼を求めているとか……？",
          "tc": "想要跟我討謝禮嗎……？",
          "sc": "想要跟我讨谢礼吗……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 364775,
          "spk": "今野 (コンノ)",
          "ja": "あいにく今日は忙しいんです",
          "tc": "不巧的是我今天很忙，",
          "sc": "不巧的是我今天很忙，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 364782,
          "spk": "今野 (コンノ)",
          "ja": "<strong>日にちを改めて",
          "tc": "<strong>請您改天",
          "sc": "<strong>请您改天"
        },
        {
          "f_idx": 7,
          "pidx_tc": 364789,
          "spk": "今野 (コンノ)",
          "ja": "ワタシの部屋に来てください</strong>",
          "tc": "再來我房間吧。</strong>",
          "sc": "再来我房间吧。</strong>"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6385,
      "rec_id": "TALK_ID_70_0090_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364813,
          "spk": "今野 (コンノ)",
          "ja": "おや、<player>さんじゃないですかァ",
          "tc": "哦，這不是<player>嗎？",
          "sc": "哦，这不是<player>吗～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6386,
      "rec_id": "TALK_ID_70_0090_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364837,
          "spk": "今野 (コンノ)",
          "ja": "そういえばワタシ、",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364844,
          "spk": "今野 (コンノ)",
          "ja": "アナタにお手伝いを頼んだはずですけど",
          "tc": "我之前應該有委託您幫忙，",
          "sc": "我之前应该有委托您帮忙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364851,
          "spk": "今野 (コンノ)",
          "ja": "アレ、どうなりましたァ？",
          "tc": "後來怎麼樣了？",
          "sc": "后来怎么样了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6387,
      "rec_id": "TALK_ID_70_0090_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364869,
          "spk": "今野 (コンノ)",
          "ja": "えっ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364876,
          "spk": "今野 (コンノ)",
          "ja": "もう終わってたんですか？",
          "tc": "您已經做完了嗎？",
          "sc": "您已经做完了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364887,
          "spk": "今野 (コンノ)",
          "ja": "ダメじゃないですかァ",
          "tc": "您這樣不行啊，",
          "sc": "您这样不行啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 364894,
          "spk": "今野 (コンノ)",
          "ja": "それならそうと、早く報告してもらわないと",
          "tc": "做完了就要早點向我報告啊。",
          "sc": "做完了就要早点向我报告啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 364905,
          "spk": "今野 (コンノ)",
          "ja": "報・連・相はしっかりと",
          "tc": "報告、聯絡、商量，",
          "sc": "报告、联络、商量，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 364912,
          "spk": "今野 (コンノ)",
          "ja": "それくらい、きちんと心得てくださいネ",
          "tc": "這三大技巧您可要牢記在心了。",
          "sc": "这三大技巧您可要牢记在心了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 364930,
          "spk": "今野 (コンノ)",
          "ja": "じゃあ、お手伝いの",
          "tc": "那我就給您",
          "sc": "那我就给您"
        },
        {
          "f_idx": 8,
          "pidx_tc": 364937,
          "spk": "今野 (コンノ)",
          "ja": "ご褒美をあげましょう",
          "tc": "幫忙的謝禮吧。",
          "sc": "帮忙的谢礼吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6388,
      "rec_id": "TALK_ID_70_0090_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364961,
          "spk": "今野 (コンノ)",
          "ja": "……何を突っ立ってるんです？",
          "tc": "……您還呆站著做什麼？",
          "sc": "……您还呆站着做什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 364968,
          "spk": "今野 (コンノ)",
          "ja": "ワタシが渡しに行くわけないでしょう",
          "tc": "我怎麼可能拿過去給您啊？",
          "sc": "我怎么可能拿过去给您啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 364975,
          "spk": "今野 (コンノ)",
          "ja": "早く受け取りに来てくださいヨ",
          "tc": "請您自己趕快過來拿吧。",
          "sc": "请您自己赶快过来拿吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6389,
      "rec_id": "TALK_ID_70_0090_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 364999,
          "spk": "今野 (コンノ)",
          "ja": "フフフ、なかなか良いモノでしょう？",
          "tc": "呵呵呵，是很不錯的好東西對吧？",
          "sc": "呵呵呵，是很不错的好东西对吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365006,
          "spk": "今野 (コンノ)",
          "ja": "良かったですねェ！",
          "tc": "真是太好了呢！",
          "sc": "真是太好呐～！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 365017,
          "spk": "今野 (コンノ)",
          "ja": "そう、掟を守らない悪い子のアナタには、",
          "tc": "沒錯，像您這樣不遵守規矩的壞孩子",
          "sc": "没错，像您这样不遵守规矩的坏孩子"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365024,
          "spk": "今野 (コンノ)",
          "ja": "きっと必要になると思いますからァ……",
          "tc": "一定會需要這個東西的……",
          "sc": "一定会需要这个东西的……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365042,
          "spk": "今野 (コンノ)",
          "ja": "そうだ！　今すぐ植えましょう！",
          "tc": "對了！您就馬上來種吧！",
          "sc": "对了！您就马上来种吧！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 365049,
          "spk": "今野 (コンノ)",
          "ja": "景観的にも良さそうな場所を",
          "tc": "我已經幫您選了一個",
          "sc": "我已经帮您选了一个"
        },
        {
          "f_idx": 7,
          "pidx_tc": 365056,
          "spk": "今野 (コンノ)",
          "ja": "見繕っておいたので！",
          "tc": "景觀看起來還不錯的地方了！",
          "sc": "景观看起来还不错的地方了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6390,
      "rec_id": "TALK_ID_70_0090_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365080,
          "spk": "今野 (コンノ)",
          "ja": "その苗は、<strong>魔除けナンテンの苗</strong>……",
          "tc": "這是<strong>除魔南天竹樹苗</strong>……",
          "sc": "这是<strong>除魔南天竹树苗</strong>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365087,
          "spk": "今野 (コンノ)",
          "ja": "どこでも植えられるものではありません",
          "tc": "可不是隨便什麼地方都能種起來的。",
          "sc": "可不是随便什么地方都能种起来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365103,
          "spk": "今野 (コンノ)",
          "ja": "こういう豊かな土でないと、木には育ちません",
          "tc": "一定要種在這種肥沃的土壤裡，才能長成樹木。",
          "sc": "一定要种在这种肥沃的土壤里，才能长成树木。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365110,
          "spk": "今野 (コンノ)",
          "ja": "間違っても、アナタの庭に植えないように",
          "tc": "所以千萬注意",
          "sc": "所以千万注意"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365117,
          "spk": "今野 (コンノ)",
          "ja": "注意してくださいねェ",
          "tc": "不要種在您的庭院裡了。",
          "sc": "不要种在您的庭院里呐～。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 365128,
          "spk": "今野 (コンノ)",
          "ja": "さあ、早速植えてくださいな",
          "tc": "來，快點種下去吧，",
          "sc": "来，快点种下去吧，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 365135,
          "spk": "今野 (コンノ)",
          "ja": "これはもうアナタの苗なのですから……",
          "tc": "這已經是您的樹苗了……",
          "sc": "这已经是您的树苗了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 365142,
          "spk": "今野 (コンノ)",
          "ja": "責任を持って、アナタ自身の手で",
          "tc": "您要負責親手種下去。",
          "sc": "您要负责亲手种下去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6391,
      "rec_id": "TALK_ID_70_0090_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365166,
          "spk": "今野 (コンノ)",
          "ja": "まだ小さな苗ですが、やがて大きく育つでしょう",
          "tc": "雖然現在還是小樹苗，不過之後就會長大的。",
          "sc": "虽然现在还是小树苗，不过之后就会长大的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365173,
          "spk": "今野 (コンノ)",
          "ja": "そうしたら、この木はアナタを救ってくれる……",
          "tc": "到時候這棵樹將會拯救您……",
          "sc": "到时候这棵树将会拯救您……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365191,
          "spk": "今野 (コンノ)",
          "ja": "アナタがまた掟を破って深夜に徘徊したとき、",
          "tc": "如果您又破壞了規矩，深夜在外徘徊，",
          "sc": "如果您又破坏了规矩，深夜在外徘徊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365198,
          "spk": "今野 (コンノ)",
          "ja": "<strong>危険な存在</strong>と出会ってしまったら、",
          "tc": "然後遇到了<strong>危險的存在</strong>，",
          "sc": "然后遇到了<strong>危险的存在</strong>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365205,
          "spk": "今野 (コンノ)",
          "ja": "この<strong>木に隠れてやり過ごす</strong>のです",
          "tc": "那麼就<strong>躲在這棵樹下，等待危險過去吧</strong>。",
          "sc": "那么就<strong>躲在这棵树下，等待危险过去吧</strong>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 365216,
          "spk": "今野 (コンノ)",
          "ja": "今の話、よく覚えておきなさい",
          "tc": "請您要記清楚這番話，",
          "sc": "请您要记清楚这番话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 365223,
          "spk": "今野 (コンノ)",
          "ja": "さもなくば……フフフフ……",
          "tc": "否則……呵呵呵呵……",
          "sc": "否则……呵呵呵呵……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6392,
      "rec_id": "TALK_ID_70_0090_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365254,
          "spk": "今野 (コンノ)",
          "ja": "では苗の代金を払ってください",
          "tc": "那麼，請您付我樹苗的費用吧，",
          "sc": "那么，请您付我树苗的费用吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365261,
          "spk": "今野 (コンノ)",
          "ja": "５０００円になりまァす",
          "tc": "總共是5000元。",
          "sc": "总共是5000元。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6393,
      "rec_id": "TALK_ID_70_0090_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365279,
          "spk": "今野 (コンノ)",
          "ja": "店よりも高い？",
          "tc": "比店裡賣得還貴？",
          "sc": "比店里卖得还贵？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365286,
          "spk": "今野 (コンノ)",
          "ja": "それはそうですヨ",
          "tc": "這還用說嗎？",
          "sc": "这还用说吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 365297,
          "spk": "今野 (コンノ)",
          "ja": "店で買った苗なんですから",
          "tc": "這可是我在店裡買的樹苗，",
          "sc": "这可是我在店里买的树苗，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365304,
          "spk": "今野 (コンノ)",
          "ja": "同じ額で売ったら",
          "tc": "如果同額售出，",
          "sc": "如果同额售出，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365311,
          "spk": "今野 (コンノ)",
          "ja": "ワタシが儲からないじゃないですかァ",
          "tc": "那我還賺什麼呢？",
          "sc": "那我还赚什么呢～？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6394,
      "rec_id": "TALK_ID_70_0090_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 365329,
          "spk": "今野 (コンノ)",
          "ja": "……ンフフフフ",
          "tc": "……呵呵呵呵呵，",
          "sc": "……呵呵呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 365336,
          "spk": "今野 (コンノ)",
          "ja": "なァんてネ、冗談ですヨ",
          "tc": "我是開玩笑的。",
          "sc": "我是开玩笑哟～。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 365347,
          "spk": "今野 (コンノ)",
          "ja": "今回だけは特別に、",
          "tc": "這次就破例",
          "sc": "这次就破例"
        },
        {
          "f_idx": 3,
          "pidx_tc": 365354,
          "spk": "今野 (コンノ)",
          "ja": "タダで差し上げます",
          "tc": "免費送給您吧。",
          "sc": "免费送给您吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 365365,
          "spk": "今野 (コンノ)",
          "ja": "どんくさい子どもだと思っていましたが、",
          "tc": "我本來想說您是個笨手笨腳的孩子，",
          "sc": "我本来想说您是个笨手笨脚的孩子，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 365372,
          "spk": "今野 (コンノ)",
          "ja": "クソ真面目に働くところは",
