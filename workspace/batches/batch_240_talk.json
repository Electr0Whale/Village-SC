          "sc": "这里的话……嗯，应该能钓得到。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6410,
      "rec_id": "TALK_ID_70_0110_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378052,
          "spk": "堇怜 (スミレ)",
          "ja": "次はこうして、魚が居そうな",
          "tc": "接著像這樣，",
          "sc": "接着像这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378059,
          "spk": "堇怜 (スミレ)",
          "ja": "岩陰に向けて、撒き餌をまく",
          "tc": "朝著感覺有魚的岩石陰影處撒些魚餌。",
          "sc": "朝着感觉有鱼的岩石阴影处撒些鱼饵。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6411,
      "rec_id": "TALK_ID_70_0110_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378084,
          "spk": "堇怜 (スミレ)",
          "ja": "針を投げ込んで",
          "tc": "然後把魚鉤丟進水裡，",
          "sc": "然后把鱼钩丢进水里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378091,
          "spk": "堇怜 (スミレ)",
          "ja": "魚に気づかれないように、",
          "tc": "一邊小心別被魚發現，",
          "sc": "一边小心别被鱼发现，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 378098,
          "spk": "堇怜 (スミレ)",
          "ja": "静かにじっと待つと――",
          "tc": "邊靜靜地等待──",
          "sc": "边静静地等待——"
        }
      ]
    },
    {
