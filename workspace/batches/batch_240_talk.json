        {
          "f_idx": 3,
          "pidx_tc": 377817,
          "spk": "洋 (ヨウ)",
          "ja": "<player>は釣りに詳しい？",
          "tc": "<player>很會釣魚嗎？",
          "sc": "<player>很会钓鱼吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
