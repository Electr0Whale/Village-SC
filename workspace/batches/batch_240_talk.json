      "rec_id": "TALK_ID_70_0150_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373426,
          "spk": "莲实 (ハスミ)",
          "ja": "……いいわね",
          "tc": "……聽起來很不錯。",
          "sc": "……听起来很不错。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373437,
          "spk": "莲实 (ハスミ)",
          "ja": "さっそく今夜",
          "tc": "剛好我今晚有空，",
          "sc": "刚好我今晚有空，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373444,
          "spk": "莲实 (ハスミ)",
          "ja": "空いてるけど、どうかしら？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373457,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ～……ごめんよ",
          "tc": "啊啊……抱歉，",
          "sc": "啊啊……抱歉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373464,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜はやめとく",
          "tc": "今晚不行。",
          "sc": "今晚不行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 373477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "明日は荷運びがあるからさ",
          "tc": "我明天要運貨，",
          "sc": "我明天要运货，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 373484,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酔っ払ってやるわけにはいかないんだ",
          "tc": "可不能喝醉了上工啊。",
          "sc": "可不能喝醉了上工啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 373495,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村と外を繋ぐ大切な役目だからね",
          "tc": "畢竟這是聯絡村裡與外界的重要任務。",
          "sc": "毕竟这是联络村里与外界的重要任务。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 373502,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……誰かが代われる仕事じゃない",
          "tc": "……沒有人能替我執行的。",
          "sc": "……没有人能替我执行的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 373522,
          "spk": "莲实 (ハスミ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 373529,
          "spk": "莲实 (ハスミ)",
          "ja": "……そうね",
          "tc": "……是啊。",
          "sc": "……是啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 373542,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あー……はは",
          "tc": "啊……哈哈，",
          "sc": "啊……哈哈，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 373549,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチから誘ったのに",
          "tc": "明明是我約妳的，",
          "sc": "明明是我约你的，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 373556,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いねえ",
          "tc": "不好意思啊。",
          "sc": "不好意思啊。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 373569,
          "spk": "莲实 (ハスミ)",
          "ja": "……いいのよ",
          "tc": "……沒關係，",
          "sc": "……没关系，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 373576,
          "spk": "莲实 (ハスミ)",
          "ja": "いつもご苦労様",
          "tc": "一直以來都辛苦妳了。",
          "sc": "一直以来都辛苦你了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 373587,
          "spk": "莲实 (ハスミ)",
          "ja": "……また都合のいい時に誘ってね",
          "tc": "……下次有空再約吧。",
          "sc": "……下次有空再约吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6555,
      "rec_id": "TALK_ID_70_0150_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "というわけで、また近いうちに",
          "tc": "總之，我近期會從外面",
          "sc": "总之，我近期会从外面"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外からいろいろと運んでくるよ",
          "tc": "載各種東西回來。",
          "sc": "载各种东西回来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373632,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの店が出てる時は",
          "tc": "所以等我出來擺攤的時候",
          "sc": "所以等我出来摆摊的时候"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373639,
          "spk": "琪娜娜 (チナナ)",
          "ja": "覗きにおいで",
          "tc": "你再過來瞧瞧吧。",
          "sc": "你再过来瞧瞧吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373650,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今後ともご贔屓に～",
          "tc": "今後也請多多關照喔～",
          "sc": "今后也请多多关照哦～"
        }
      ]
    },
    {
