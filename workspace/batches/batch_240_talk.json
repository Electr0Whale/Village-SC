      "rec_id": "TALK_ID_70_0110_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 378190,
          "spk": "堇怜 (スミレ)",
          "ja": "撒き餌は材料があれば、作業台で作れるよ",
          "tc": "只要有材料的話，就可以在工作台製作魚餌。",
          "sc": "只要有材料的话，就可以在工作台制作鱼饵。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 378197,
          "spk": "堇怜 (スミレ)",
          "ja": "足りなくなったら、自分で作ってね",
          "tc": "要是魚餌不夠了，就自己做做看吧。",
          "sc": "要是鱼饵不够了，就自己做做看吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 378213,
          "spk": "堇怜 (スミレ)",
          "ja": "慣れたら誰でも釣れるようになると思うから、",
          "tc": "習慣之後，我想應該誰都能釣到魚的。",
          "sc": "习惯之后，我想应该谁都能钓到鱼的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 378220,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>もやってごらん",
          "tc": "<player>也來試試看吧。",
          "sc": "<player>也来试试看吧。"
        }
      ]
    },
