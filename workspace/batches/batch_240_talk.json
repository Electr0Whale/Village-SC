      "rec_id": "TALK_ID_70_0110_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 377788,
          "spk": "洋 (ヨウ)",
          "ja": "えっと、お願いっていうのはね……",
