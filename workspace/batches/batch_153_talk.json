      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "石鹸の隣にようかんが置いてあったんだけど、",
          "tc": "看到羊羹放在肥皂的旁邊，",
          "sc": "看到羊羹放在肥皂的旁边，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どういうルールで並べてるのか気になるね",
          "tc": "真好奇這陳列商品的邏輯是什麼。",
          "sc": "真好奇这陈列商品的逻辑是什么。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32151,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、形は似てると言えなくもないかな……？",
          "tc": "不過這形狀好像的確是有點像……？",
          "sc": "不过这形状好像的确是有点像……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3253,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32182,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雪が大降りになってきた気がするね",
          "tc": "感覺雪越下越大了，",
          "sc": "感觉雪越下越大了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32189,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここで休憩してるうちに弱まってくれたら",
          "tc": "希望我在這裡休息的時候可以慢慢變小……",
          "sc": "希望我在这里休息的时候可以慢慢变小……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32196,
          "spk": "琪娜娜 (チナナ)",
          "ja": "嬉しいんだけど……望み薄だねえ",
          "tc": "但看起來希望渺茫啊。",
          "sc": "但看起来希望渺茫啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3254,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32220,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ふ～……のんびりしていて",
          "tc": "呼～在這邊悠哉悠哉的，",
          "sc": "呼～在这边悠哉悠哉的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32227,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい気持ちだねえ",
          "tc": "真是舒服。",
          "sc": "真是舒服。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32238,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これで熱いお茶でもあれば完璧だよ",
          "tc": "如果能再來一杯熱茶就完美了。",
          "sc": "如果能再来一杯热茶就完美了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3255,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32269,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この時間にここにいると、",
          "tc": "這個時段待在這裡啊，",
          "sc": "这个时段待在这里啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32276,
          "spk": "琪娜娜 (チナナ)",
          "ja": "みんなの夕飯を準備する、",
          "tc": "就能聞到空氣中傳來",
          "sc": "就能闻到空气中传来"
