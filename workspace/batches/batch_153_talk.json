        {
          "f_idx": 1,
          "pidx_tc": 31472,
          "spk": "琪娜娜 (チナナ)",
          "ja": "芯まで凍える冷たさだよ",
          "tc": "這種冰是冰到骨子裡的，",
          "sc": "这种冰是冰到骨子里的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31479,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カイロでも貼ってあげたいね",
          "tc": "真想幫它貼上暖暖包啊。",
          "sc": "真想帮它贴上暖暖包啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3239,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31503,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か用事があってここまで来たんだけど",
          "tc": "我是有事才來這裡的，",
          "sc": "我是有事才来这里的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31510,
          "spk": "琪娜娜 (チナナ)",
          "ja": "肝心の用事を忘れて思い出せないんだよ",
          "tc": "但是卻忘了是什麼事，想都想不起來。",
          "sc": "但是却忘了是什么事，想都想不起来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31521,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こういうことって、よくないかい？",
          "tc": "你會不會也常常這樣？",
          "sc": "你会不会也常常这样？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3240,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31545,
          "spk": "琪娜娜 (チナナ)",
          "ja": "立ち止まると、寒さが身に染みるね",
          "tc": "一停下腳步，身體就會開始冷起來啊。",
          "sc": "一停下脚步，身体就会开始冷起来啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31563,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミも鼻水が出てるんじゃないかい？",
          "tc": "你是不是也流鼻水了？",
          "sc": "你是不是也流鼻水了？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 31570,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちゃんとティッシュで鼻をかむんだよ",
          "tc": "記得要用衛生紙擤乾淨喔。",
          "sc": "记得要用卫生纸擤干净哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3241,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31594,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はあ～……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31605,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この部屋、あったかいねえ",
          "tc": "這房間好溫暖啊，",
          "sc": "这房间好温暖啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31612,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう一歩も外に出たくないよ",
          "tc": "我一步都不想走出去了。",
          "sc": "我一步都不想走出去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3242,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31636,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>はこれから、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31643,
          "spk": "琪娜娜 (チナナ)",
          "ja": "凍える外に出て家へ帰るんだろう？",
          "tc": "你待會要在這冰天雪地的走回家對吧？",
          "sc": "你待会要在这冰天雪地的走回家对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31654,
          "spk": "琪娜娜 (チナナ)",
          "ja": "可哀想にねえ……しっかり防寒するんだよ",
          "tc": "真可憐啊……記得要做好防寒措施喔。",
          "sc": "真可怜啊……记得要做好防寒措施哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3243,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31678,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そろそろ、まぶたが閉店準備に入ったよ",
          "tc": "我的眼皮差不多要下班了，",
          "sc": "我的眼皮差不多要下班了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31685,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはまだ眠くならないのかい？",
          "tc": "你還不睏嗎？",
          "sc": "你还不困吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31696,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どんだけ元気なのさ……ふわ～あ……",
          "tc": "到底是多有活力啊你……呼啊～",
          "sc": "到底是多有活力啊你……呼啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3244,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31727,
          "spk": "琪娜娜 (チナナ)",
          "ja": "朝からドカドカと降ってるねえ",
          "tc": "一早就下了好大的雪啊。",
          "sc": "一早就下了好大的雪啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 31738,
          "spk": "琪娜娜 (チナナ)",
          "ja": "積もり具合によっちゃ、雪がやむ前に",
          "tc": "如果雪積得太多，",
          "sc": "如果雪积得太多，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31745,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雪かきをする必要があるだろうね",
          "tc": "有可能會需要在雪停之前鏟雪。",
          "sc": "有可能会需要在雪停之前铲雪。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3245,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31776,
          "spk": "琪娜娜 (チナナ)",
          "ja": "雪景色は綺麗でいいね",
          "tc": "雪景真美啊，真好。",
          "sc": "雪景真美啊，真好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 31794,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どんどん白く染まってく景色を一人で",
          "tc": "我竟然能獨占這漸漸染白的景色，",
          "sc": "我竟然能独占这渐渐染白的景色，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 31801,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いくらでも眺められるなんて、贅沢な話だよ",
          "tc": "還能想看就看，真是奢侈啊。",
          "sc": "还能想看就看，真是奢侈啊。"
        }
      ]
    },
    {
