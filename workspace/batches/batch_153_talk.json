  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3203,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29685,
          "spk": "琪娜娜 (チナナ)",
          "ja": "街にはこういうカプセルトイが、",
          "tc": "市區不少地方",
          "sc": "市区不少地方"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29692,
          "spk": "琪娜娜 (チナナ)",
          "ja": "たくさん置いてあったりするんだよ",
          "tc": "都會成堆地設置這種轉蛋機。",
          "sc": "都会成堆地设置这种转蛋机。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29703,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ドールハウス用みたいなちっちゃい家具とか",
          "tc": "像是娃娃屋用的小家具之類的，",
          "sc": "像是娃娃屋用的小家具之类的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29710,
          "spk": "琪娜娜 (チナナ)",
          "ja": "可愛くてね、つい集めたくなるよ",
          "tc": "通通都很可愛，讓我很想收集。",
          "sc": "通通都很可爱，让我很想收集。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3204,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29741,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お、もしかして回すのかい？",
          "tc": "哦，你要轉嗎？",
          "sc": "哦，你要转吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29752,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいものが出たらウチにも見せてよ",
          "tc": "轉到好東西的話也要讓我看看喔。",
          "sc": "转到好东西的话也要让我看看哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3205,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29776,
          "spk": "琪娜娜 (チナナ)",
          "ja": "前にリンが、ここをうろうろしていてね",
          "tc": "之前我看到林在這裡走來走去的，",
          "sc": "之前我看到林在这里走来走去的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29783,
          "spk": "琪娜娜 (チナナ)",
          "ja": "コインを入れようか迷ってたんだろうな",
          "tc": "應該是在猶豫要不要投幣。",
          "sc": "应该是在犹豫要不要投币。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29801,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんとなく、見なかったことにしたよ",
          "tc": "當時我就想說我還是當作沒看到好了。",
          "sc": "当时我就想说我还是当作没看到好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3206,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3113",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29825,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ドングリでも拾って持ち帰ったら",
          "tc": "我本來想說撿些橡實回去，",
          "sc": "我本来想说捡些橡实回去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 29832,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ヨウがおままごとに使うかなと思ったんだけど",
          "tc": "可以給洋拿來扮家家酒。",
          "sc": "可以给洋拿来扮家家酒。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29850,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自分で拾ったほうが楽しいに決まってるよねえ",
          "tc": "但果然還是自己去撿會比較開心吧。",
          "sc": "但果然还是自己去捡会比较开心吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3207,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3114",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29881,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋は山歩きが楽しい季節だね",
          "tc": "秋天是能開心爬山的季節呢。",
          "sc": "秋天是能开心爬山的季节呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29899,
          "spk": "琪娜娜 (チナナ)",
          "ja": "紅葉狩りにキノコ狩り、",
          "tc": "像是可以賞楓、採蘑菇，",
          "sc": "像是可以赏枫、采蘑菇，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29906,
          "spk": "琪娜娜 (チナナ)",
          "ja": "クリ拾いにドングリ拾い",
          "tc": "還可以撿栗子跟橡實……",
          "sc": "还可以捡栗子跟橡实……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 29917,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミは何が好きなのかな",
          "tc": "你都喜歡做什麼呢？",
          "sc": "你都喜欢做什么呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3208,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3115",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29941,
          "spk": "琪娜娜 (チナナ)",
          "ja": "足元がちょっと柔らかいの、わかるかい？",
          "tc": "你有感覺腳邊踩起來有點軟軟的嗎？",
          "sc": "你有感觉脚边踩起来有点软软的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 29959,
          "spk": "琪娜娜 (チナナ)",
          "ja": "枯れ葉が重なってふかふかしてるんだよ",
          "tc": "這是因為枯葉一層層疊了起來，地上才會軟軟的。",
          "sc": "这是因为枯叶一层层叠了起来，地上才会软软的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 29966,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こうなると冬もすぐそこだ",
          "tc": "所以可以由此得知，冬天就快到了。",
          "sc": "所以可以由此得知，冬天就快到了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3209,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 29997,
          "spk": "琪娜娜 (チナナ)",
          "ja": "コマコに用事かい？",
          "tc": "你有事找駒子嗎？",
          "sc": "你有事找驹子吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30008,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今は留守にしてるみたいだよ",
          "tc": "她現在好像不在，",
          "sc": "她现在好像不在，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30015,
          "spk": "琪娜娜 (チナナ)",
          "ja": "他を探してみたらどうかな",
          "tc": "你要不要去其他地方找找？",
          "sc": "你要不要去其他地方找找？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3210,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30039,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そこの小屋には無闇に入らないようにしな",
          "tc": "你可不要隨便闖進那間小屋喔。",
          "sc": "你可不要随便闯进那间小屋哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30057,
          "spk": "琪娜娜 (チナナ)",
          "ja": "危ないものが色々とあるからね",
          "tc": "那裡面有各式各樣的危險物品。",
          "sc": "那里面有各式各样的危险物品。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 30068,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……まあ、キミは止めても無駄そうだけど",
          "tc": "……不過勸你大概也沒用吧。",
          "sc": "……不过劝你大概也没用吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3211,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30099,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、あそこをリスが走ってったよ",
          "tc": "剛剛有一隻松鼠跑過去了，",
          "sc": "刚刚有一只松鼠跑过去了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30106,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まんまると太ってたね",
          "tc": "圓滾滾的好胖一隻。",
          "sc": "圆滚滚的好胖一只。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30117,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう冬に備えてるんだろうなあ",
          "tc": "應該是已經在準備過冬了吧。",
          "sc": "应该是已经在准备过冬了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3212,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30148,
          "spk": "琪娜娜 (チナナ)",
          "ja": "夜に口笛を吹くとヘビが出る、",
          "tc": "雖然俗話說",
          "sc": "虽然俗话说"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30155,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんて言うけどね",
          "tc": "晚上吹口哨會引蛇出洞，",
          "sc": "晚上吹口哨会引蛇出洞，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30166,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この村なら何が出るだろうねえ",
          "tc": "但在這村裡不知道會引出什麼東西來呢。",
          "sc": "但在这村里不知道会引出什么东西来呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3213,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30197,
          "spk": "琪娜娜 (チナナ)",
          "ja": "は……っくしょん！",
          "tc": "哈……啾！",
          "sc": "哈……啾！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30208,
          "spk": "琪娜娜 (チナナ)",
          "ja": "う～……夜はけっこう",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30215,
          "spk": "琪娜娜 (チナナ)",
          "ja": "冷えるようになってきたねえ……",
          "tc": "晚上開始會冷了……",
          "sc": "晚上开始会冷了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3214,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30239,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小腹が空いちゃったな……",
          "tc": "肚子有點餓了……",
          "sc": "肚子有点饿了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30250,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ラーメンでも食べたい気分だけど",
          "tc": "我想吃拉麵，",
          "sc": "我想吃拉面，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30257,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この時間に食べるのは勇気がいるよ",
          "tc": "但要在這種時間吃拉麵需要一點勇氣啊。",
          "sc": "但要在这种时间吃拉面需要一点勇气啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3215,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30288,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おお……これは子どもの心を",
          "tc": "哦哦……",
          "sc": "哦哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30295,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鷲掴みにする品揃え……",
          "tc": "這些品項夠緊緊抓住孩子們的心啊……",
          "sc": "这些品项够紧紧抓住孩子们的心啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30306,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スミレが回したがるだろうねえ",
          "tc": "堇怜應該會想轉吧。",
          "sc": "堇怜应该会想转吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3216,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30337,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういえば、この中身を交換したり補充したり",
          "tc": "話說回來，我從來沒看過",
          "sc": "话说回来，我从来没看过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30344,
          "spk": "琪娜娜 (チナナ)",
          "ja": "してるところを一度も見たことがないんだよ",
          "tc": "茶梅幫這台轉蛋機進行交換或補充的樣子。",
          "sc": "茶梅帮这台转蛋机进行交换或补充的样子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30355,
          "spk": "琪娜娜 (チナナ)",
          "ja": "サザンカはいつ中身を入れ替えてるんだろうね",
          "tc": "她都是什麼時候替換轉蛋的啊？",
          "sc": "她都是什么时候替换转蛋的啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3217,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30386,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや……このカプセルトイ、",
          "tc": "哦……這台轉蛋機",
          "sc": "哦……这台转蛋机"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30393,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あと少しで空っぽになりそうだよ",
          "tc": "裡面的玩具感覺快被轉完了呢。",
          "sc": "里面的玩具感觉快被转完了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30404,
          "spk": "琪娜娜 (チナナ)",
          "ja": "回しておいたほうがいいんじゃないかい？",
          "tc": "你要不要來轉一顆看看？",
          "sc": "你要不要来转一颗看看？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3218,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30435,
          "spk": "琪娜娜 (チナナ)",
          "ja": "この季節は、食欲が止まらないんだよねぇ……",
          "tc": "到了這個季節，總是讓人胃口大開……",
          "sc": "到了这个季节，总是让人胃口大开……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30442,
          "spk": "琪娜娜 (チナナ)",
          "ja": "涼しくなった途端、",
          "tc": "為什麼天氣一變涼爽，",
          "sc": "为什么天气一变凉爽，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30449,
          "spk": "琪娜娜 (チナナ)",
          "ja": "急に元気になるのはなんでだろ",
          "tc": "精神就會突然好起來呢。",
          "sc": "精神就会突然好起来呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 30460,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ついでに甘いものも置いてくれないかな～",
          "tc": "要是能準備一些甜食就好了～",
          "sc": "要是能准备一些甜食就好了～"
        },
        {
          "f_idx": 4,
          "pidx_tc": 30467,
          "spk": "琪娜娜 (チナナ)",
          "ja": "秋って、そういうのが許される季節だろう？",
          "tc": "秋天就是可以放縱一下的季節吧？",
          "sc": "秋天就是可以放纵一下的季节吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3219,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_3320",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30498,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はちょっと奮発して、",
          "tc": "我今天稍微奢侈了一下，",
          "sc": "我今天稍微奢侈了一下，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 30505,
          "spk": "琪娜娜 (チナナ)",
          "ja": "小鉢を追加してもらったんだ",
          "tc": "加點了一些小菜。",
          "sc": "加点了一些小菜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 30516,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ささやかだけど贅沢な気分だよ",
          "tc": "雖然只是一些小菜，但感覺很奢侈啊。",
          "sc": "虽然只是一些小菜，但感觉很奢侈啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3220,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_3800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 30547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おてんとさんが泣いてるけど",
          "tc": "雖然在下雨，",
