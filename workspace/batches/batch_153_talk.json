      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31979,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっき、そこの椅子に座ってみたけど",
          "tc": "我剛剛坐了一下那邊的椅子，",
