          "ja": "……ウチもお腹減ったな",
          "tc": "……我也餓了。",
          "sc": "……我也饿了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 32301,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今晩は何を食べようか……",
          "tc": "今天晚上要吃什麼好呢……",
          "sc": "今天晚上要吃什么好呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3256,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32325,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こうやって、何をするでもなくぼーっとしてると",
          "tc": "像這樣無所事事地發呆，",
          "sc": "像这样无所事事地发呆，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32332,
          "spk": "琪娜娜 (チナナ)",
          "ja": "体中のネジがゆっくり緩んでいくような",
          "tc": "會感覺全身緊繃的神經",
          "sc": "会感觉全身紧绷的神经"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32339,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気がするんだよ",
          "tc": "都慢慢變鬆了。",
          "sc": "都慢慢变松了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32350,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミにはまだ、この感覚わからないかな？",
          "tc": "……你應該還不懂這種感覺吧？",
          "sc": "……你应该还不懂这种感觉吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3257,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32381,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝る前にあったかいスープが飲みたいねえ",
          "tc": "睡前真想喝點熱湯啊。",
          "sc": "睡前真想喝点热汤啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "コーンポタージュ……ミネストローネ……",
          "tc": "玉米濃湯……義式蔬菜湯……",
          "sc": "玉米浓汤……义式蔬菜汤……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32406,
          "spk": "琪娜娜 (チナナ)",
          "ja": "クラムチャウダー……ああ、夢に見そうだよ",
          "tc": "蛤蜊巧達湯……啊啊，感覺會出現在夢裡呢。",
          "sc": "蛤蜊巧达汤……啊啊，感觉会出现在梦里呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3258,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32437,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミの家にいることが多くなったから",
          "tc": "我現在常常待在蓮實家，",
          "sc": "我现在常常待在莲实家，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32444,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スミレと顔を合わせる機会も増えてね",
          "tc": "所以碰到堇怜的機會也變多了。",
          "sc": "所以碰到堇怜的机会也变多了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32462,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これを機に「お姉ちゃん」なんて",
          "tc": "不知道他會不會因為這樣，",
          "sc": "不知道他会不会因为这样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 32469,
          "spk": "琪娜娜 (チナナ)",
          "ja": "呼んでくれないものかねえ",
          "tc": "開始叫我姐姐呢？",
          "sc": "开始叫我姐姐呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3259,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32500,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹があったまると、途端に体の",
          "tc": "肚子暖起來之後，",
          "sc": "肚子暖起来之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32507,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スイッチが切れちゃうねえ",
          "tc": "整個人就會沒電啊。",
          "sc": "整个人就会没电啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32525,
          "spk": "琪娜娜 (チナナ)",
          "ja": "帰る気になれるかどうか不安だよ",
          "tc": "真擔心自己會不會就這樣不想回家了。",
          "sc": "真担心自己会不会就这样不想回家了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3260,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_20_114_4320",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32556,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>もご飯かな？",
          "tc": "嗨，<player>，你也是來吃飯的嗎？",
          "sc": "嗨，<player>，你也是来吃饭的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32563,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よかったら隣で一緒にどうだい？",
          "tc": "那要不要坐我旁邊一起吃啊？",
          "sc": "那要不要坐我旁边一起吃啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32574,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ロッカクさんの料理は今日も美味しいよ",
          "tc": "六角叔今天的料理也很美味喔。",
          "sc": "六角叔今天的料理也很美味哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3261,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32605,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやおや、キミほっぺが赤くなってるよ",
          "tc": "哎呀呀，你臉頰都變紅了。",
          "sc": "哎呀呀，你脸颊都变红了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンゴみたいで美味しそうだねえ",
          "tc": "像是蘋果一樣，感覺好像很好吃呢。",
          "sc": "像是苹果一样，感觉好像很好吃呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しもやけにならないよう、気をつけな",
          "tc": "小心不要長凍瘡了喔。",
          "sc": "小心不要长冻疮了哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3262,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32654,
          "spk": "琪娜娜 (チナナ)",
          "ja": "う～寒い……",
          "tc": "嗚～好冷……",
          "sc": "呜～好冷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32661,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寒すぎて、顔のパーツが落っこちそうだよ",
          "tc": "冷到感覺我的五官都要從臉上掉下去了。",
          "sc": "冷到感觉我的五官都要从脸上掉下去了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32679,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの耳と鼻は、ちゃんとついてるかい？",
          "tc": "我的耳朵和鼻子應該都還在吧？",
          "sc": "我的耳朵和鼻子应该都还在吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3263,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32710,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹がすいたねえ",
          "tc": "肚子餓了啊。",
          "sc": "肚子饿了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32717,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>は今夜、何を食べるんだい？",
          "tc": "<player>，你今晚要吃什麼啊？",
          "sc": "<player>，你今晚要吃什么啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32728,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんて、さすがに気が早いかな？",
          "tc": "我這樣是不是問得太早了？",
          "sc": "我这样是不是问得太早了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3264,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32759,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カチコチに凍った道を歩くと、",
          "tc": "走在這硬邦邦結冰的道路上，",
          "sc": "走在这硬邦邦结冰的道路上，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32766,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミの肩を揉んだ時の衝撃を思いだすよ",
          "tc": "就會想起幫蓮實按摩肩膀時受到的震撼。",
          "sc": "就会想起帮莲实按摩肩膀时受到的震撼。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32784,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれはこの道といい勝負の固さだったねえ",
          "tc": "她肩膀的僵硬程度，足以跟這條路一較高下了。",
          "sc": "她肩膀的僵硬程度，足以跟这条路一较高下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3265,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32815,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこを見ても真っ白だねえ",
          "tc": "放眼過去都是一片雪白。",
          "sc": "放眼过去都是一片雪白。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32826,
          "spk": "琪娜娜 (チナナ)",
          "ja": "カエルもヘビも雪の下で眠ってる",
          "tc": "青蛙和蛇也都在積雪下冬眠。",
          "sc": "青蛙和蛇也都在积雪下冬眠。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 32844,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……そのうち村ごと覆い隠されたりしてね",
          "tc": "……搞不好不久後全村就要被雪淹沒了。",
          "sc": "……说不定不久后全村就要被雪淹没了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3266,
      "rec_id": "TALK_ID_STREET_VENDOR_ROUTINE_WALK_20_114_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 32875,
          "spk": "琪娜娜 (チナナ)",
          "ja": "虫の気配もないし、",
          "tc": "既感受不到昆蟲的氣息，",
          "sc": "既感受不到昆虫的气息，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 32882,
          "spk": "琪娜娜 (チナナ)",
          "ja": "鳥の鳴き声も聞こえないね",
          "tc": "也聽不到鳥叫聲。",
          "sc": "也听不到鸟叫声。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 32893,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも冬ごもりしたいよ",
          "tc": "我也好想冬眠啊。",
          "sc": "我也好想冬眠啊。"
        }
      ]
    }
  ]
