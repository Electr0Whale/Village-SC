      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 31881,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今朝もずいぶんと冷えるねえ",
          "tc": "今天早上也好冷啊，",
          "sc": "今天早上也好冷啊，"
        },
        {
          "f_idx": 1,
