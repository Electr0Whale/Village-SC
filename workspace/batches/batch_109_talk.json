    },
    {
      "file": "talk.dat",
      "rec_idx": 673,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127208,
          "spk": "四郎治 (シロージ)",
          "ja": "雪が降ってる日は一段と冷え込む",
          "tc": "一下雪感覺就更冷了，",
          "sc": "一下雪感觉就更冷了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127226,
          "spk": "四郎治 (シロージ)",
          "ja": "暖房をつけて部屋を暖かくしないと",
          "tc": "不開暖氣讓房間暖起來，",
          "sc": "不开暖气让房间暖起来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127233,
          "spk": "四郎治 (シロージ)",
          "ja": "凍っちまうかもしれねぇ",
          "tc": "是有可能會凍僵的。",
          "sc": "是有可能会冻僵的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 674,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127257,
          "spk": "四郎治 (シロージ)",
          "ja": "リンのやつがケチって薪を",
          "tc": "林那傢伙省東省西的，",
          "sc": "林那家伙省东省西的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127264,
          "spk": "四郎治 (シロージ)",
          "ja": "節約しようとするんだよ",
          "tc": "就連木柴也想要省。",
          "sc": "就连木柴也想要省。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127275,
          "spk": "四郎治 (シロージ)",
          "ja": "お前からも止めるように言っといてくれ",
          "tc": "你也去講幾句勸勸她吧。",
          "sc": "你也去讲几句劝劝她吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 675,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127306,
          "spk": "四郎治 (シロージ)",
          "ja": "リンとか他の家の分だけじゃなくて",
          "tc": "除了林和其他人家的之外，",
          "sc": "除了林和其他人家的之外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127313,
          "spk": "四郎治 (シロージ)",
          "ja": "自分ちの薪もちゃんと用意しないとな",
          "tc": "也得準備我們自己用的木柴才行。",
          "sc": "也得准备我们自己用的木柴才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 676,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127344,
          "spk": "四郎治 (シロージ)",
          "ja": "小さい頃、コマコとかまくらを作って",
          "tc": "我小時候好像和駒子蓋過雪屋，",
          "sc": "我小时候好像和驹子盖过雪屋，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127351,
          "spk": "四郎治 (シロージ)",
          "ja": "秘密基地代わりにしたことがあったっけな",
          "tc": "然後當作是我們的祕密基地。",
          "sc": "然后当作是我们的秘密基地。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127369,
          "spk": "四郎治 (シロージ)",
          "ja": "もう覚えてないだろうけどさ",
          "tc": "不過她應該不記得了吧。",
          "sc": "不过她应该不记得了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 677,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127393,
          "spk": "四郎治 (シロージ)",
          "ja": "雪が積もってるのを見ると",
          "tc": "看到這片積雪，",
          "sc": "看到这片积雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127400,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと雪合戦したくなるんだよな",
          "tc": "就讓人有點想打雪仗。",
          "sc": "就让人有点想打雪仗。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127411,
          "spk": "四郎治 (シロージ)",
          "ja": "スミレあたりなら付き合ってくれるか……？",
          "tc": "堇怜他們應該會願意陪我吧……？",
          "sc": "堇怜他们应该会愿意陪我吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 678,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127435,
          "spk": "四郎治 (シロージ)",
          "ja": "俺そっくりな雪だるまを作ったら",
          "tc": "如果做出了跟我一模一樣的雪人，",
          "sc": "如果做出了跟我一模一样的雪人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127442,
          "spk": "四郎治 (シロージ)",
          "ja": "動き出して俺の代わりに仕事を……",
          "tc": "它就會代替我去工作……",
          "sc": "它就会代替我去工作……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127460,
          "spk": "四郎治 (シロージ)",
          "ja": "してくれるわけねぇよな",
          "tc": "沒這可能嗎。",
          "sc": "没这可能吗。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 679,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4023",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127484,
          "spk": "四郎治 (シロージ)",
          "ja": "冬の時期は寒さもそうだが",
          "tc": "冬天除了寒冷的問題，",
          "sc": "冬天除了寒冷的问题，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127491,
          "spk": "四郎治 (シロージ)",
          "ja": "空気が乾燥するのも厄介だな",
          "tc": "空氣乾燥也很讓人困擾。",
          "sc": "空气干燥也很让人困扰。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127498,
          "spk": "四郎治 (シロージ)",
          "ja": "喉が痛くなって困るぜ",
          "tc": "喉嚨好痛啊，真傷腦筋。",
          "sc": "喉咙好痛啊，真伤脑筋。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 680,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4024",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127522,
          "spk": "四郎治 (シロージ)",
          "ja": "そんな驚いた顔してどうした",
          "tc": "你怎麼一臉驚訝的？",
          "sc": "你怎么一脸惊讶的？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127533,
          "spk": "四郎治 (シロージ)",
          "ja": "冬ごもりから起きたクマでも見たのか？",
          "tc": "你是看到結束冬眠的熊了嗎？",
          "sc": "你是看到结束冬眠的熊了吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127551,
          "spk": "四郎治 (シロージ)",
          "ja": "……ん？　俺をクマと見間違えた？",
          "tc": "……嗯？所以你把我看成熊了？",
          "sc": "……嗯？所以你把我看成熊了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 681,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4025",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127575,
          "spk": "四郎治 (シロージ)",
          "ja": "この季節は空気が澄んでる",
          "tc": "這個季節的空氣很清新。",
          "sc": "这个季节的空气很清新。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127586,
          "spk": "四郎治 (シロージ)",
          "ja": "空がいつも以上に透き通って見えるのは",
          "tc": "天空看起來比平常更純淨，",
          "sc": "天空看起来比平常更纯净，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127593,
          "spk": "四郎治 (シロージ)",
          "ja": "気のせいじゃないんだろうな",
          "tc": "這應該不是我的錯覺吧？",
          "sc": "这应该不是我的错觉吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 682,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127617,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>にとっての冬の幸せってなんだ？",
          "tc": "對<player>你來說，冬天最幸福的是什麼？",
          "sc": "对<player>你来说，冬天最幸福的是什么？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127635,
          "spk": "四郎治 (シロージ)",
          "ja": "俺はこうしてあったかい部屋で",
          "tc": "我大概就是在溫暖的房間裡，",
          "sc": "我大概就是在温暖的房间里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127642,
          "spk": "四郎治 (シロージ)",
          "ja": "スニーカーの手入れをしてる時かもしれねぇ",
          "tc": "保養球鞋的時候最幸福吧。",
          "sc": "保养球鞋的时候最幸福吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 683,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127673,
          "spk": "四郎治 (シロージ)",
          "ja": "このスニーカーは水に強いから",
          "tc": "這雙球鞋的防水力很強，",
          "sc": "这双球鞋的防水力很强，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127680,
          "spk": "四郎治 (シロージ)",
          "ja": "雪の中でも履けるんだよな",
          "tc": "所以在雪地裡也可以穿。",
          "sc": "所以在雪地里也可以穿。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127698,
          "spk": "四郎治 (シロージ)",
          "ja": "もったいないから履かないけどさ",
          "tc": "但這樣穿太糟蹋了，所以我是不會穿的。",
          "sc": "但这样穿太糟蹋了，所以我是不会穿的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 684,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127722,
          "spk": "四郎治 (シロージ)",
          "ja": "冬は雪と土が混じって靴が汚れやすいから",
          "tc": "冬天的地面混雜著雪和泥土，所以鞋子很容易髒，",
          "sc": "冬天的地面混杂着雪和泥土，所以鞋子很容易脏，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127729,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も定期的に手入れしたほうがいいぞ",
          "tc": "<player>你最好也要定期保養鞋子喔。",
          "sc": "<player>你最好也要定期保养鞋子啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127747,
          "spk": "四郎治 (シロージ)",
          "ja": "なんなら道具も貸してやる",
          "tc": "我還可以把工具借給你。",
          "sc": "我还可以把工具借给你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 685,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127778,
          "spk": "四郎治 (シロージ)",
          "ja": "寒くても身体を動かしてると",
          "tc": "天氣冷的時候，",
          "sc": "天气冷的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127785,
          "spk": "四郎治 (シロージ)",
          "ja": "だいぶマシになるもんだ",
          "tc": "動動身體感覺就會好很多。",
          "sc": "动动身体感觉就会好很多。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127796,
          "spk": "四郎治 (シロージ)",
          "ja": "汗まで掻いてきちまった",
          "tc": "我甚至出汗了呢。",
          "sc": "我甚至出汗了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 686,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127820,
          "spk": "四郎治 (シロージ)",
          "ja": "さっきは通りかかったウサギを",
          "tc": "剛剛嚇到了一隻",
          "sc": "刚刚吓到了一只"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127827,
          "spk": "四郎治 (シロージ)",
          "ja": "びびらせちまった……",
          "tc": "路過的兔子……",
          "sc": "路过的兔子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127838,
          "spk": "四郎治 (シロージ)",
          "ja": "そんなつもりはなかったんだけどな",
          "tc": "但我沒有想要嚇牠的意思啊。",
          "sc": "但我没有想要吓它的意思啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 687,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127862,
          "spk": "四郎治 (シロージ)",
          "ja": "ふう……息を吸い込むとたまに",
          "tc": "呼……有時呼吸的時候，",
          "sc": "呼……有时呼吸的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127869,
          "spk": "四郎治 (シロージ)",
          "ja": "すげぇ冷たい空気が入ってくるから",
          "tc": "會吸到很冷的空氣，",
          "sc": "会吸到很冷的空气，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127876,
          "spk": "四郎治 (シロージ)",
          "ja": "びっくりするんだよな……",
          "tc": "我都會嚇到……",
          "sc": "我都会吓到……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 688,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127900,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろコンノに上等な",
          "tc": "今野差不多也該把",
          "sc": "今野差不多也该把"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127907,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかい上着を譲ってもらえねぇかな",
          "tc": "高級的溫暖外套讓給我了吧。",
          "sc": "高级的温暖外套让给我了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 127925,
          "spk": "四郎治 (シロージ)",
          "ja": "今度様子を窺ってみるか",
          "tc": "下次看看他怎麼想的好了。",
          "sc": "下次看看他怎么想的好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 689,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127949,
          "spk": "四郎治 (シロージ)",
          "ja": "さみぃ……",
          "tc": "好冷……",
          "sc": "好冷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 127956,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかいもんでも飲みてぇけど",
          "tc": "好想喝點熱的。",
          "sc": "好想喝点热的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 127967,
          "spk": "四郎治 (シロージ)",
          "ja": "自分のために用意するのはめんどくせぇな",
          "tc": "但要幫自己準備好麻煩啊。",
          "sc": "但要帮自己准备好麻烦啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 690,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 127998,
          "spk": "四郎治 (シロージ)",
          "ja": "こう地面が綺麗だと",
          "tc": "看地面這麼乾淨漂亮，",
          "sc": "看地面这么干净漂亮，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128005,
          "spk": "四郎治 (シロージ)",
          "ja": "自分の足跡をつけたくなっちまう",
          "tc": "反而會想留下自己的腳印。",
          "sc": "反而会想留下自己的脚印。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128012,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>もこの気持ちわかるか？",
          "tc": "<player>能明白這種心情嗎？",
          "sc": "<player>能明白这种心情吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 691,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128036,
          "spk": "四郎治 (シロージ)",
          "ja": "俺たちの家系は、大昔から猟師をやってるんだ",
          "tc": "我的家族從很久以前就是獵人，",
          "sc": "我的家族从很久以前就是猎人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128043,
          "spk": "四郎治 (シロージ)",
          "ja": "じいさんに聞いた話だと、先祖は北の方から",
          "tc": "聽爺爺說，祖先是從北方",
          "sc": "听爷爷说，祖先是从北方"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128050,
          "spk": "四郎治 (シロージ)",
          "ja": "この土地に流れてきたらしい",
          "tc": "輾轉來到這片土地上。",
          "sc": "辗转来到这片土地上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 128061,
          "spk": "四郎治 (シロージ)",
          "ja": "先祖から受け継がれてきた狩りの知恵が、",
