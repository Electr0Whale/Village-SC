        {
          "f_idx": 0,
          "pidx_tc": 125511,
          "spk": "四郎治 (シロージ)",
          "ja": "こういうぼうっとできる時間が",
          "tc": "像這種能發呆的時光",
          "sc": "像这种能发呆的时光"
