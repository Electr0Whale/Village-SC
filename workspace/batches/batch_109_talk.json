        {
          "f_idx": 1,
          "pidx_tc": 125518,
          "spk": "四郎治 (シロージ)",
          "ja": "一番幸せなのかもしれねぇな",
          "tc": "可能是最幸福的吧。",
          "sc": "可能是最幸福的吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125536,
          "spk": "四郎治 (シロージ)",
          "ja": "仕事は仕事で嫌いじゃねぇけど",
          "tc": "不過我也不討厭工作就是了。",
          "sc": "不过我也不讨厌工作就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
