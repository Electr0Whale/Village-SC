      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125567,
          "spk": "四郎治 (シロージ)",
          "ja": "このデザイン、いいよな",
          "tc": "這設計真的很好看。",
          "sc": "这设计真的很好看。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125578,
          "spk": "四郎治 (シロージ)",
          "ja": "何回見ても惚れ惚れするくらい",
          "tc": "不管看幾次都令人陶醉，",
          "sc": "不管看几次都令人陶醉，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125585,
          "spk": "四郎治 (シロージ)",
          "ja": "気に入ってるんだ",
          "tc": "我很喜歡。",
          "sc": "我很喜欢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 633,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125609,
          "spk": "四郎治 (シロージ)",
          "ja": "……腹減った",
          "tc": "肚子好餓……",
          "sc": "肚子好饿……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125616,
          "spk": "四郎治 (シロージ)",
          "ja": "何か食えるもんあったっけな",
          "tc": "不知道有沒有什麼可以吃的。",
          "sc": "不知道有没有什么可以吃的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 634,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125640,
          "spk": "四郎治 (シロージ)",
          "ja": "暑くて寝苦しいのも困りもんだが",
          "tc": "雖然熱到睡不著令人很困擾，",
          "sc": "虽然热到睡不着令人很困扰，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125647,
          "spk": "四郎治 (シロージ)",
          "ja": "涼しいといくらでも眠れちまうのも",
          "tc": "但天氣涼爽又會讓人不小心就睡到天荒地老，",
          "sc": "但天气凉爽又会让人不小心就睡到天荒地老，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125654,
          "spk": "四郎治 (シロージ)",
          "ja": "困ったもんなんだよな……",
          "tc": "真是傷腦筋啊……",
          "sc": "真是伤脑筋啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 635,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125678,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコとキノコ狩りする夢を見た……",
          "tc": "夢見跟駒子一起去採蘑菇……",
          "sc": "梦见跟驹子一起去采蘑菇……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125685,
          "spk": "四郎治 (シロージ)",
          "ja": "ずいぶんと毒々しい色をしてたんだが、",
          "tc": "那蘑菇顏色看起來很毒，",
          "sc": "那蘑菇颜色看起来很毒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125692,
          "spk": "四郎治 (シロージ)",
          "ja": "あれは何キノコだったんだ？",
          "tc": "到底是什麼菇啊？",
          "sc": "到底是什么菇啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 636,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125716,
          "spk": "四郎治 (シロージ)",
          "ja": "今日の薪はいい薪だぜ",
          "tc": "今天木柴的品質都很不錯。",
          "sc": "今天木柴的品质都很不错。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125723,
          "spk": "四郎治 (シロージ)",
          "ja": "ま、悪い薪を誰かに渡すわけが",
          "tc": "不過我也不會把品質不好的木柴",
          "sc": "不过我也不会把品质不好的木柴"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125730,
          "spk": "四郎治 (シロージ)",
          "ja": "ないんだけどな",
          "tc": "交給別人就是了。",
          "sc": "交给别人就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 637,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125754,
          "spk": "四郎治 (シロージ)",
          "ja": "冬が近づいてくると",
          "tc": "冬天快要到了，",
          "sc": "冬天快要到了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125761,
          "spk": "四郎治 (シロージ)",
          "ja": "薪の需要は増えてくるんだ",
          "tc": "木柴的需求也會增加。",
          "sc": "木柴的需求也会增加。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125772,
          "spk": "四郎治 (シロージ)",
          "ja": "またたくさん用意しておかねぇとな",
          "tc": "得再準備更多木柴才行。",
          "sc": "得再准备更多木柴才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 638,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3112",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125796,
          "spk": "四郎治 (シロージ)",
          "ja": "俺は、リンやコンノから依頼を受けて",
          "tc": "我接受林或今野的委託",
          "sc": "我接受林或今野的委托"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125803,
          "spk": "四郎治 (シロージ)",
          "ja": "木を切ったり、材木にしたりしてんだよ",
          "tc": "砍樹或把樹木加工成木材。",
          "sc": "砍树或把树木加工成木材。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125821,
          "spk": "四郎治 (シロージ)",
          "ja": "……まあ正直、",
          "tc": "……不過老實說，",
          "sc": "……不过老实说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 125828,
          "spk": "四郎治 (シロージ)",
          "ja": "木より依頼主の機嫌のほうが扱いづらいな",
          "tc": "比起處理樹，處理委託人的情緒還比較難。",
          "sc": "比起处理树，处理委托人的情绪还比较难。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 639,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125859,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと寒くなってきたな……",
          "tc": "天氣開始變得有點冷了啊……",
          "sc": "天气开始变得有点冷了啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125870,
          "spk": "四郎治 (シロージ)",
          "ja": "今夜の夕飯は身体が",
          "tc": "今天晚餐就吃點",
          "sc": "今天晚餐就吃点"
        },
        {
          "f_idx": 2,
          "pidx_tc": 125877,
          "spk": "四郎治 (シロージ)",
          "ja": "あったまるもんにするか",
          "tc": "能讓身體暖起來的料理吧。",
          "sc": "能让身体暖起来的料理吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 640,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125901,
          "spk": "四郎治 (シロージ)",
          "ja": "紅葉は目に鮮やかだよな",
          "tc": "楓葉好鮮豔啊。",
          "sc": "枫叶好鲜艳啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125908,
          "spk": "四郎治 (シロージ)",
          "ja": "花とは違う良さが……なんて",
          "tc": "跟花不一樣，各有各的好……",
          "sc": "跟花不一样，各有各的好……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 125926,
          "spk": "四郎治 (シロージ)",
          "ja": "花を愛でる趣味はねぇけどな",
          "tc": "但其實我對賞花也沒什麼興趣就是了。",
          "sc": "但其实我对赏花也没什么兴趣就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 641,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3122",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125957,
          "spk": "四郎治 (シロージ)",
          "ja": "キスケに呑みに誘われてるんだよな……",
          "tc": "木助約我一起去喝酒……",
          "sc": "木助约我一起去喝酒……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125964,
          "spk": "四郎治 (シロージ)",
          "ja": "近いうちに時間を空けねぇと",
          "tc": "最近得找個時間空下來才行。",
          "sc": "最近得找个时间空下来才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 642,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3123",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 125988,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はずいぶん仕事が捗っててな",
          "tc": "今天工作進展還挺不錯的。",
          "sc": "今天工作进展还挺不错的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 125999,
          "spk": "四郎治 (シロージ)",
          "ja": "この調子なら早めに帰れそうだ",
          "tc": "這樣下去應該能提早回家。",
          "sc": "这样下去应该能提早回家。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 643,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3124",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126023,
          "spk": "四郎治 (シロージ)",
          "ja": "肌寒くなってきたし",
          "tc": "天氣漸漸變冷了，",
          "sc": "天气渐渐变冷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126030,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコの分も含めて",
          "tc": "差不多該來準備",
          "sc": "差不多该来准备"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126037,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろ防寒具を準備しねぇとな",
          "tc": "我和駒子的防寒用具了。",
          "sc": "我和驹子的防寒用具了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 644,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3125",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126061,
          "spk": "四郎治 (シロージ)",
          "ja": "山に美味そうなきのみが",
          "tc": "山上掉了滿地的果實，",
          "sc": "山上掉了满地的果实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126068,
          "spk": "四郎治 (シロージ)",
          "ja": "たくさん落ちてたんだよな",
          "tc": "看起來都很好吃。",
          "sc": "看起来都很好吃。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126079,
          "spk": "四郎治 (シロージ)",
          "ja": "時間を見つけて採って行くか",
          "tc": "我再找時間去採集好了。",
          "sc": "我再找时间去采集好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 645,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126103,
          "spk": "四郎治 (シロージ)",
          "ja": "へぇ、この秋服のデザイン",
          "tc": "哦，這件秋裝的設計",
          "sc": "哦，这件秋装的设计"
