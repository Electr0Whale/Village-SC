        {
          "f_idx": 1,
          "pidx_tc": 126110,
          "spk": "四郎治 (シロージ)",
          "ja": "かっこいいじゃねぇか",
          "tc": "還滿帥的嘛。",
          "sc": "还满帅的嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126117,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと着てみてぇな……",
          "tc": "有點想穿穿看……",
          "sc": "有点想穿穿看……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 646,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126141,
          "spk": "四郎治 (シロージ)",
          "ja": "今夜はどんな夢を見るかな",
          "tc": "不知道今晚會作什麼夢，",
          "sc": "不知道今晚会作什么梦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126152,
          "spk": "四郎治 (シロージ)",
          "ja": "コンノがファッションショーに挑む夢は",
          "tc": "之前我夢到了今野在挑戰時裝秀，",
          "sc": "之前我梦到了今野在挑战时装秀，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126159,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと面白かったんだよな……",
          "tc": "還挺有趣的……",
          "sc": "还挺有趣的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 647,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126190,
          "spk": "四郎治 (シロージ)",
          "ja": "秋はハイキングに行くやつが多いのか",
          "tc": "秋天好像有很多人都會去健行。",
          "sc": "秋天好像有很多人都会去健行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126208,
          "spk": "四郎治 (シロージ)",
          "ja": "山に慣れてないと危険が多いから",
          "tc": "但不習慣的人上山會很危險，",
          "sc": "但不习惯的人上山会很危险，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 126215,
          "spk": "四郎治 (シロージ)",
          "ja": "おすすめはしねぇけどな",
          "tc": "所以我不太建議。",
          "sc": "所以我不太建议。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 648,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126246,
          "spk": "四郎治 (シロージ)",
          "ja": "ふう……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126257,
          "spk": "四郎治 (シロージ)",
          "ja": "キレイに薪が割れると",
          "tc": "如果劈柴能劈得很漂亮，",
          "sc": "如果劈柴能劈得很漂亮，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126264,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと気持ちいいんだよな",
          "tc": "心情也會有點爽快。",
          "sc": "心情也会有点爽快。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 649,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126288,
          "spk": "四郎治 (シロージ)",
          "ja": "カエデの木は家具をつくるのに",
          "tc": "楓樹好像很適合拿來",
          "sc": "枫树好像很适合拿来"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126295,
          "spk": "四郎治 (シロージ)",
          "ja": "向いてるらしくてな",
          "tc": "製作家具，",
          "sc": "制作家具，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 126302,
          "spk": "四郎治 (シロージ)",
          "ja": "持ってくとキスケが喜ぶんだ",
          "tc": "所以拿去給木助的話他都會很高興。",
          "sc": "所以拿去给木助的话他都会很高兴。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 650,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_3202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 126326,
          "spk": "四郎治 (シロージ)",
          "ja": "早めに薪割りが終わったら",
          "tc": "如果砍柴能提早結束，",
          "sc": "如果砍柴能提早结束，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 126333,
          "spk": "四郎治 (シロージ)",
          "ja": "夜、趣味に時間を割ける",
          "tc": "晚上應該就能把時間",
          "sc": "晚上应该就能把时间"
        },
        {
