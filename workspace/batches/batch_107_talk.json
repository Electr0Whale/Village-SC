      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103874,
          "spk": "林 (リン)",
          "ja": "どうかしら、<player>",
          "tc": "怎麼樣？<player>。",
          "sc": "怎么样？<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103881,
          "spk": "林 (リン)",
          "ja": "村の一員になれた感想は？",
          "tc": "成為村子的一員後感想如何？",
          "sc": "成为村子的一员后感想如何？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103888,
          "spk": "林 (リン)",
          "ja": "きっと嬉しいはずよね",
          "tc": "你一定很高興吧。",
          "sc": "你一定很高兴吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103899,
          "spk": "林 (リン)",
          "ja": "でも嬉しいからって、手を緩めちゃダメよ",
          "tc": "但可不能因為高興就懈怠喔。",
          "sc": "但可不能因为高兴就懈怠。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 103906,
          "spk": "林 (リン)",
          "ja": "村のみんなと仲を深めながら",
          "tc": "跟村裡的大家加深感情的同時，",
          "sc": "跟村里的大家加深感情的同时，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 103913,
          "spk": "林 (リン)",
          "ja": "今まで以上に働くのよ！　いいわね？",
          "tc": "要比現在更努力工作喔，知道嗎？",
          "sc": "要比以往更加卖力干活！明白了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 717,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103939,
          "spk": "林 (リン)",
          "ja": "……あら、まだいたのね",
          "tc": "……哎呀，你還在啊。",
          "sc": "……哎呀，你还在啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103950,
          "spk": "林 (リン)",
          "ja": "私はもう寝るから、",
          "tc": "我要睡了，",
          "sc": "我要睡了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103957,
          "spk": "林 (リン)",
          "ja": "あなたはそろそろ帰りなさい",
          "tc": "你也差不多該回去了。",
          "sc": "你也差不多该回去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 718,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0040",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103988,
          "spk": "林 (リン)",
          "ja": "なに？",
          "tc": "怎麼了？",
          "sc": "怎么了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103995,
          "spk": "林 (リン)",
          "ja": "私に相談？",
          "tc": "有事想找我商量？",
          "sc": "有事想找我商量？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104006,
          "spk": "林 (リン)",
          "ja": "何もないなら声をかけないで",
          "tc": "如果沒什麼事就別叫我。",
          "sc": "如果没什么事就别叫我。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104013,
          "spk": "林 (リン)",
          "ja": "やるべきことをやりなさい",
          "tc": "去做你該做的事。",
          "sc": "去做你该做的事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 719,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0041",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104037,
          "spk": "林 (リン)",
          "ja": "仕事はもう終わったのかしら？",
          "tc": "工作已經做完了嗎？",
          "sc": "工作已经做完了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104048,
          "spk": "林 (リン)",
          "ja": "まだなら働くこと！",
          "tc": "還沒的話就好好工作！",
          "sc": "还没的话就好好工作！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104055,
          "spk": "林 (リン)",
          "ja": "おしゃべりしてる時間はないわよ",
          "tc": "可沒時間閒聊啊。",
          "sc": "可没时间闲聊啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 720,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0050",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104079,
          "spk": "林 (リン)",
          "ja": "喜びなさい、<player>",
          "tc": "你要感到高興喔，<player>。",
          "sc": "高兴吧，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104086,
          "spk": "林 (リン)",
          "ja": "あなたに新しい仕事があるの",
          "tc": "有一項新工作要交給你。",
          "sc": "有一项新工作要交给你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104097,
          "spk": "林 (リン)",
          "ja": "……今ちょっとイヤそうな顔しなかった？",
          "tc": "……你剛剛是不是露出了有點不情願的表情？",
          "sc": "……你刚刚是不是露出了有点不情愿的表情？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104104,
          "spk": "林 (リン)",
          "ja": "気のせいかしら……まぁいいわ",
          "tc": "是我的錯覺嗎……算了。",
          "sc": "是我的错觉吗……算了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 104115,
          "spk": "林 (リン)",
          "ja": "ちょっと足りないものがあってね",
          "tc": "有些東西不太夠。",
          "sc": "有些东西不太够。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 104122,
          "spk": "林 (リン)",
          "ja": "<tmpstr>なんだけど",
          "tc": "就是<tmpstr>。",
          "sc": "就是<tmpstr>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 104129,
          "spk": "林 (リン)",
          "ja": "あなたにいくつか揃えてほしいのよ",
          "tc": "我想請你準備一些。",
          "sc": "我想请你准备一些。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 104140,
          "spk": "林 (リン)",
          "ja": "当然、報酬は用意してるわ",
          "tc": "當然，我會準備報酬的。",
          "sc": "当然，我会准备报酬的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 104147,
          "spk": "林 (リン)",
          "ja": "相応のお礼はさせてもらうから",
          "tc": "會給你相對應的謝禮，",
          "sc": "会给你相对应的谢礼，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 104165,
          "spk": "林 (リン)",
          "ja": "期限は<gamevalue GAME_VALUE_TALK_NUM>日以内よ",
          "tc": "期限是<gamevalue GAME_VALUE_TALK_NUM>天以內喔。",
          "sc": "期限是<gamevalue GAME_VALUE_TALK_NUM>天以内哦。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 104172,
          "spk": "林 (リン)",
          "ja": "あなたの働き、期待してるからね",
          "tc": "我很期待你的表現。",
          "sc": "我很期待你的表现。"
        }
      ]
    },
    {
