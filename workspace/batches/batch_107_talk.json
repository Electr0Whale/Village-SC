        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 517,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120579,
          "spk": "四郎治 (シロージ)",
          "ja": "お疲れ、<player>",
          "tc": "辛苦了，<player>，",
          "sc": "辛苦了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120586,
          "spk": "四郎治 (シロージ)",
          "ja": "ずっと見てたけど悪くなかったぞ",
          "tc": "我剛剛一直在看你，你表現還滿不錯的。",
          "sc": "我刚刚一直在看你，你表现还满不错的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120602,
          "spk": "四郎治 (シロージ)",
          "ja": "次があればいい評価になる気がしてる",
          "tc": "如果有下次，我想你會得到更好的評價，",
          "sc": "如果有下次，我想你会得到更好的评价，"
