        },
        {
          "f_idx": 4,
          "pidx_tc": 120418,
          "spk": "四郎治 (シロージ)",
          "ja": "動物たちと一緒にがんばってみろよ",
          "tc": "你就跟動物們一起努力看看吧。",
          "sc": "你就跟动物们一起努力看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 515,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120442,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、出なくてよかったのか？",
          "tc": "<player>，你真的不參加嗎？",
          "sc": "<player>，你真的不参加吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120449,
          "spk": "四郎治 (シロージ)",
          "ja": "勝手にちょっと期待してたんだけどな",
          "tc": "我還有點期待你會參加的。",
          "sc": "我还有点期待你会参加的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120460,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、チャンスはいくらでもあるしな",
          "tc": "不過反正機會多的是，",
          "sc": "不过反正机会多的是，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120467,
          "spk": "四郎治 (シロージ)",
          "ja": "今回は状態が整ってなくても",
          "tc": "這次狀態沒調整好的話，",
          "sc": "这次状态没调整好的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120474,
          "spk": "四郎治 (シロージ)",
          "ja": "次の機会に出ればいいと思うぜ",
          "tc": "那就等下次再參加就行了。",
          "sc": "那就等下次再参加就行了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 120485,
          "spk": "四郎治 (シロージ)",
          "ja": "その時には、自慢の馬を見せてくれよ",
          "tc": "到時候要給我看看你引以為傲的馬喔，",
          "sc": "到时候让我看看你引以为傲的马吧，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 120492,
          "spk": "四郎治 (シロージ)",
          "ja": "楽しみにしてる",
          "tc": "我會好好期待的。",
          "sc": "我会好好期待的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 516,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120523,
          "spk": "四郎治 (シロージ)",
          "ja": "お疲れ、<player>",
          "tc": "辛苦了，<player>，",
          "sc": "辛苦了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120530,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はかなりがんばってたな",
          "tc": "你今天非常努力啊。",
          "sc": "你今天非常努力啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120541,
          "spk": "四郎治 (シロージ)",
          "ja": "お前も馬もいい表情してたから",
          "tc": "你和馬的神情都很棒，",
          "sc": "你和马的神情都很棒，"
