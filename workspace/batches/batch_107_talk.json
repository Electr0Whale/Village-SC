        {
          "f_idx": 4,
          "pidx_tc": 120609,
          "spk": "四郎治 (シロージ)",
          "ja": "お前の馬と一緒に気張っていけよ",
          "tc": "你就跟你的馬一起繼續加油吧。",
          "sc": "你就跟你的马一起继续加油吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 518,
      "rec_id": "TALK_ID_LUMBERJACK_PRESENT_20_103_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120640,
          "spk": "四郎治 (シロージ)",
