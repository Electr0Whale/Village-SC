    {
      "file": "talk.dat",
      "rec_idx": 722,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0052",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104237,
          "spk": "林 (リン)",
          "ja": "思ってたより早かったじゃない",
          "tc": "比我想得還快呢。",
          "sc": "比我想得还快呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104244,
          "spk": "林 (リン)",
          "ja": "ありがとう、助かったわ",
          "tc": "謝謝你，幫大忙了。",
          "sc": "谢谢你，帮大忙了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104255,
          "spk": "林 (リン)",
          "ja": "じゃあこれ",
          "tc": "那這個給你。",
          "sc": "那这个给你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104262,
          "spk": "林 (リン)",
          "ja": "約束の報酬よ",
          "tc": "這是之前說好的謝禮。",
          "sc": "这是之前说好的谢礼。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 104273,
          "spk": "林 (リン)",
          "ja": "またなにか必要になったらお願いするわ",
          "tc": "如果之後還有什麼需要，我會再拜託你的。",
          "sc": "如果之后还有什么需要，我会再拜托你的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 104280,
          "spk": "林 (リン)",
          "ja": "楽しみにしてなさい",
          "tc": "你就好好期待吧。",
          "sc": "你就好好期待吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 723,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104302,
          "spk": "林 (リン)",
          "ja": "……なにしに来たのよ",
          "tc": "……那你來幹嘛？",
          "sc": "……那你来干嘛？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104309,
          "spk": "林 (リン)",
          "ja": "見せびらかしにきただけ？",
          "tc": "你只是來炫耀的嗎？",
          "sc": "你只是来炫耀的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104320,
          "spk": "林 (リン)",
          "ja": "いい？　これは仕事なんだから",
          "tc": "聽好囉，這可是工作，",
          "sc": "听好了，这可是工作，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104327,
          "spk": "林 (リン)",
          "ja": "ちゃんと期限までに持ってくるのよ！",
          "tc": "你要在期限內好好帶過來喔！",
          "sc": "你要在期限内好好带过来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 724,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104351,
          "spk": "林 (リン)",
          "ja": "ねえ、<player>",
          "tc": "我說，<player>。",
          "sc": "我说，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104358,
          "spk": "林 (リン)",
          "ja": "「ロールキャベツ」って作ったことある？",
          "tc": "你有做過「高麗菜捲」嗎？",
          "sc": "你做过“卷心菜卷”吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104369,
          "spk": "林 (リン)",
          "ja": "けっこう好きなんだけど",
          "tc": "雖然我挺喜歡的，",
          "sc": "虽然我挺喜欢的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104376,
          "spk": "林 (リン)",
          "ja": "自分で作ろうとすると",
          "tc": "但如果要自己做，",
          "sc": "但如果要自己做，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 104383,
          "spk": "林 (リン)",
          "ja": "地味に手間なのよね……",
          "tc": "其實還滿費工的呢……",
          "sc": "其实还满费工的呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 104394,
          "spk": "林 (リン)",
          "ja": "でも、冬の寒い日だったり",
          "tc": "不過，若是在寒冷的冬日，",
          "sc": "不过，若是在寒冷的冬日，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 104401,
          "spk": "林 (リン)",
          "ja": "温まりたい時に食べると",
          "tc": "或是想讓身體暖起來的時候吃，",
          "sc": "或是想让身体暖起来的时候吃，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 104408,
          "spk": "林 (リン)",
          "ja": "すごくおいしいのよ！",
          "tc": "真的會覺得很美味喔！",
          "sc": "真的会觉得很美味！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 104419,
          "spk": "林 (リン)",
          "ja": "あなたも食べたくなってきたでしょう？",
          "tc": "你也開始想吃了吧？",
          "sc": "你也开始想吃了吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 104426,
          "spk": "林 (リン)",
          "ja": "仕方ないわね、レシピを教えてあげる",
          "tc": "真拿你沒辦法，我就告訴你食譜吧。",
          "sc": "真拿你没办法，我就告诉你食谱吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 104444,
          "spk": "林 (リン)",
          "ja": "その代わり、今度作ったら",
          "tc": "相對地，你下次做的時候，",
          "sc": "相对地，你下次做的时候，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 104451,
          "spk": "林 (リン)",
          "ja": "私にもおすそ分けすること",
          "tc": "也要分一點給我。",
          "sc": "也要分一点给我。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 104458,
          "spk": "林 (リン)",
          "ja": "いいわね？",
          "tc": "知道嗎？",
          "sc": "知道吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 725,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104482,
          "spk": "林 (リン)",
          "ja": "……ねえ、<player>",
          "tc": "……我說，<player>。",
          "sc": "……我说，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104489,
          "spk": "林 (リン)",
          "ja": "変なこと聞いて申し訳ないんだけど",
          "tc": "不好意思，問你個奇怪的問題，",
          "sc": "不好意思，问你个奇怪的问题，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 104500,
          "spk": "林 (リン)",
          "ja": "最近の私って、なんていうか……",
          "tc": "最近的我，怎麼說呢……",
          "sc": "最近的我，怎么说呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 104507,
          "spk": "林 (リン)",
          "ja": "ふっくらしてきてる気がしない？",
          "tc": "是不是變得有點圓潤了？",
          "sc": "是不是变得有点圆润了？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 104516,
          "spk": "林 (リン)",
          "ja": "最近、村のあれこれで",
          "tc": "最近，我因為村裡的各種事情",
          "sc": "最近，我因为村里的各种事情"
        },
        {
          "f_idx": 5,
          "pidx_tc": 104523,
          "spk": "林 (リン)",
          "ja": "ストレスが溜まっててね……",
          "tc": "累積了一些壓力……",
          "sc": "累积了一些压力……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 104530,
          "spk": "林 (リン)",
          "ja": "それが食欲を刺激したせいだわ",
          "tc": "一定是壓力刺激了食慾。",
          "sc": "一定是压力刺激了食欲。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 104541,
          "spk": "林 (リン)",
          "ja": "それで最近は、カロリーを意識して",
          "tc": "因此，我最近開始注意熱量，",
          "sc": "因此，我最近开始注意热量，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 104548,
          "spk": "林 (リン)",
          "ja": "毎日「シーザーサラダ」を食べるようにしてるの",
          "tc": "每天都會吃「凱撒沙拉」。",
          "sc": "每天都会吃“凯撒沙拉”。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 104566,
          "spk": "林 (リン)",
          "ja": "<player>も興味ある？",
          "tc": "<player>也有興趣嗎？",
          "sc": "<player>也有兴趣吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 104573,
          "spk": "林 (リン)",
          "ja": "それなら作り方教えてあげるわね",
          "tc": "那我就教你怎麼做吧。",
          "sc": "那我就教你怎么做吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 104584,
          "spk": "林 (リン)",
          "ja": "はぁ……食事だけじゃなくて",
          "tc": "唉……除了飲食以外，",
          "sc": "唉……除了饮食以外，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 104591,
          "spk": "林 (リン)",
          "ja": "ストレスの原因をなんとかしなくちゃ……",
          "tc": "也得想辦法解決壓力的來源呢……",
          "sc": "也得想办法解决压力的来源呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 726,
      "rec_id": "TALK_ID_VILLAGE_HEAD_SPECIAL_20_104_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 104622,
          "spk": "林 (リン)",
          "ja": "<player>は最近",
          "tc": "<player>，你最近",
          "sc": "<player>，你最近"
        },
        {
          "f_idx": 1,
          "pidx_tc": 104629,
          "spk": "林 (リン)",
