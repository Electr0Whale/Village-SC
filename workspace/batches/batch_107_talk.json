      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0140",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 119926,
          "spk": "四郎治 (シロージ)",
          "ja": "ん、<player>か",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 119933,
          "spk": "四郎治 (シロージ)",
          "ja": "今日も元気そうだな",
          "tc": "你今天看起來也很有活力。",
          "sc": "你今天看起来也很有活力。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 119944,
          "spk": "四郎治 (シロージ)",
          "ja": "あぁ、もうすぐ始まるだろうから",
          "tc": "啊，已經要開始了，",
          "sc": "啊，已经要开始了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 119951,
          "spk": "四郎治 (シロージ)",
          "ja": "食べたいものを決めておくと良い",
          "tc": "先選好想吃的東西比較好。",
          "sc": "先选好想吃的东西比较好。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 119962,
          "spk": "四郎治 (シロージ)",
          "ja": "年越しそばも、つきたての餅も",
          "tc": "過年蕎麥麵和剛搗好的麻糬",
          "sc": "过年荞麦面和刚捣好的年糕"
        },
        {
          "f_idx": 5,
          "pidx_tc": 119969,
          "spk": "四郎治 (シロージ)",
          "ja": "どっちもうまいからな",
          "tc": "都很好吃。",
          "sc": "都很好吃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 508,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 119993,
          "spk": "四郎治 (シロージ)",
          "ja": "こうちまちました作業は",
          "tc": "我不喜歡做這種",
          "sc": "我不喜欢做这种"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120000,
          "spk": "四郎治 (シロージ)",
          "ja": "好きじゃねぇんだよな",
          "tc": "細膩又瑣碎的工作。",
          "sc": "细腻又琐碎的工作。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120011,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、<player>か",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120018,
          "spk": "四郎治 (シロージ)",
          "ja": "この飾り、どう思う？",
          "tc": "你覺得這個裝飾如何？",
          "sc": "你觉得这个装饰如何？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120025,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が作ったんだが変じゃないか？",
          "tc": "這是我做的，會很怪嗎？",
          "sc": "这是我做的，会很怪吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 120036,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱりちょっと歪んでるか……",
          "tc": "果然有點歪了嗎……",
          "sc": "果然有点歪了吗……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 120043,
          "spk": "四郎治 (シロージ)",
          "ja": "もう少し綺麗に見えるように直さないとな",
          "tc": "那我得再把它調整得漂亮一點。",
          "sc": "那我得再把它调整得漂亮一点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 509,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120067,
          "spk": "四郎治 (シロージ)",
          "ja": "ふーん",
          "tc": "哦～",
          "sc": "哦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120074,
          "spk": "四郎治 (シロージ)",
          "ja": "かなり見ごたえのある品評会だったな……",
          "tc": "這場評鑑會還滿多看點的嘛……",
          "sc": "这场评鉴会还满多看点的嘛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120085,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、そういえば<player>は",
          "tc": "啊，對了，",
          "sc": "啊，对了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120092,
          "spk": "四郎治 (シロージ)",
          "ja": "エントリーしなかったのか",
          "tc": "<player>你沒有報名喔。",
          "sc": "<player>你没报名啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120099,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、こういうのはその時々の気分次第だよな",
          "tc": "反正報不報名本來就是看當下心情。",
          "sc": "反正报不报名本来就是看当下心情。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 120110,
          "spk": "四郎治 (シロージ)",
          "ja": "でも、結構いい作物を育ててるみたいだし",
          "tc": "不過你好像也有栽培出很好的作物，",
          "sc": "不过你好像也有栽培出很好的作物，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 120117,
          "spk": "四郎治 (シロージ)",
          "ja": "次は挑戦してみてもいいんじゃないか？",
          "tc": "下次應該也可以來挑戰看看吧？",
          "sc": "下次应该也可以来挑战看看吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 510,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120148,
          "spk": "四郎治 (シロージ)",
          "ja": "Sランクか、すごいじゃん",
          "tc": "S級嗎？你很厲害嘛。",
          "sc": "S级吗？你很厉害嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120155,
          "spk": "四郎治 (シロージ)",
          "ja": "一生懸命いい作物を育ててるってことだな",
          "tc": "可見作物是你千辛萬苦栽培出來的。",
          "sc": "可见作物是你千辛万苦栽培出来的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120173,
          "spk": "四郎治 (シロージ)",
          "ja": "今日くらいは自分への褒美として",
          "tc": "至少今天就犒賞自己，",
          "sc": "至少今天就犒赏自己，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120180,
          "spk": "四郎治 (シロージ)",
          "ja": "美味いもんでも食ったらいいと思うぜ",
          "tc": "去吃點美味的東西吧。",
          "sc": "去吃点美味的东西吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 511,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120204,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、お疲れ",
          "tc": "<player>，辛苦了。",
          "sc": "<player>，辛苦了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120211,
          "spk": "四郎治 (シロージ)",
          "ja": "お前的に納得のいく評価かはわからないが",
          "tc": "雖然我不知道你能不能接受這個評價，",
          "sc": "虽然我不知道你能不能接受这个评价，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120218,
          "spk": "四郎治 (シロージ)",
          "ja": "がんばってたんじゃないか？",
          "tc": "但你也很努力了。",
          "sc": "但你也很努力了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120227,
          "spk": "四郎治 (シロージ)",
          "ja": "とりあえず今日は頑張った自分を労って",
          "tc": "總之你今天就先慰勞一下一路努力過來的自己，",
          "sc": "总之你今天就先慰劳一下一路努力过来的自己，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120234,
          "spk": "四郎治 (シロージ)",
          "ja": "ゆっくり休めよ",
          "tc": "好好休息吧。",
          "sc": "好好休息吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 512,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120258,
          "spk": "四郎治 (シロージ)",
          "ja": "どの動物たちも活き活きしてて",
          "tc": "每個動物都很有活力，",
          "sc": "每个动物都很有活力，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120265,
          "spk": "四郎治 (シロージ)",
          "ja": "見てて面白かったな……",
          "tc": "看著真是有趣啊……",
          "sc": "看着真是有趣啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120276,
          "spk": "四郎治 (シロージ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120283,
          "spk": "四郎治 (シロージ)",
          "ja": "てっきりお前も参加するんだと思ってたぜ",
          "tc": "我還以為你一定會參加的。",
          "sc": "我还以为你一定会参加的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120294,
          "spk": "四郎治 (シロージ)",
          "ja": "次はお前の自慢の家畜たちを見たいもんだな",
          "tc": "下次我也想看看你引以為傲的家畜們，",
          "sc": "下次我也想看看你引以为傲的家畜们，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 120301,
          "spk": "四郎治 (シロージ)",
          "ja": "またの機会に向けて考えておいてくれ",
          "tc": "你就考慮一下，掌握下次機會吧。",
          "sc": "你就考虑一下，掌握下次机会吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 513,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120325,
          "spk": "四郎治 (シロージ)",
          "ja": "最高評価をもらったんだな",
          "tc": "你獲得了最高評價啊，",
          "sc": "你获得了最高评价啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120332,
          "spk": "四郎治 (シロージ)",
          "ja": "俺に褒められるまでもないだろうけど",
          "tc": "雖然你應該也不需要我稱讚了，",
          "sc": "虽然你应该也不需要我称赞了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120339,
          "spk": "四郎治 (シロージ)",
          "ja": "やるな、<player>",
          "tc": "不過我還是要說，幹得好，<player>。",
          "sc": "不过我还是要说，干得好，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120350,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>が欠かさず動物たちの",
          "tc": "這都要多虧<player>你無微不至地",
          "sc": "这都要多亏<player>你无微不至地"
        },
        {
          "f_idx": 4,
          "pidx_tc": 120357,
          "spk": "四郎治 (シロージ)",
          "ja": "世話してたおかげだろ",
          "tc": "在照顧這些動物們吧，",
          "sc": "在照顾这些动物们吧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 120364,
          "spk": "四郎治 (シロージ)",
          "ja": "そういうところわりと尊敬してるぜ",
          "tc": "我其實很尊敬你這點喔。",
          "sc": "我其实挺佩服你这点的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 514,
      "rec_id": "TALK_ID_LUMBERJACK_HOLIDAY_20_103_0155",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120388,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120395,
          "spk": "四郎治 (シロージ)",
          "ja": "お前ががんばってるとこ見てたぜ",
          "tc": "我看到你努力的模樣了。",
          "sc": "我看到你努力的模样了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120404,
          "spk": "四郎治 (シロージ)",
          "ja": "あんまりへこまずこれからもっと",
          "tc": "不必太灰心，",
          "sc": "不必太灰心，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120411,
          "spk": "四郎治 (シロージ)",
          "ja": "上を目指せるって考えたらいいんじゃないか",
          "tc": "你只要想說「我還有很多進步空間」就好了。",
