  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3337,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0064",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 180902,
          "spk": "琪娜娜 (チナナ)",
          "ja": "冬は、日が落ちるとますます静かになるよねえ",
          "tc": "冬天一旦太陽下山，就會變得更安靜呢。",
          "sc": "冬天一旦太阳下山，就会变得更安静呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 180909,
          "spk": "琪娜娜 (チナナ)",
          "ja": "たまに、日没と同時に",
          "tc": "日落時，偶爾會覺得，",
          "sc": "日落时，偶尔会觉得，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 180916,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一日が終わったんじゃないかって思うくらいだよ",
          "tc": "一天是不是就這樣跟著結束了。",
          "sc": "一天是不是就这样跟着结束了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 180929,
          "spk": "堇怜 (スミレ)",
          "ja": "え、そうですかね？",
          "tc": "咦，是這樣嗎？",
          "sc": "咦，是这样吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 180936,
          "spk": "堇怜 (スミレ)",
          "ja": "夜もけっこう色んな音がすると思うけど",
          "tc": "晚上還是會有許多聲音吧。",
          "sc": "晚上还是会有许多声音吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 180943,
          "spk": "堇怜 (スミレ)",
          "ja": "山のほうに行くとシカの鳴き声とか",
          "tc": "到山上的話還會聽見鹿的叫聲。",
          "sc": "到山上的话还会听见鹿的叫声。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 180956,
          "spk": "木助 (キスケ)",
          "ja": "静まり返ってるからこそ",
          "tc": "也有些聲音是在一片寂靜時",
          "sc": "也有些声音是在一片寂静时"
        },
        {
          "f_idx": 7,
          "pidx_tc": 180963,
          "spk": "木助 (キスケ)",
          "ja": "聞こえる音ってのもあるんだぜ",
          "tc": "才聽得見的喔。",
          "sc": "才听得见的啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 180974,
          "spk": "木助 (キスケ)",
          "ja": "家の木が軋む音なんかがそうだ",
          "tc": "比方說木造房子的嘎吱聲就是這樣。",
          "sc": "比方说木造房子的嘎吱声就是这样。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 180981,
          "spk": "木助 (キスケ)",
          "ja": "寒さで木が縮むからな……",
          "tc": "因為天氣冷會使木材收縮。",
          "sc": "因为天气冷会使木材收缩。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 180988,
          "spk": "木助 (キスケ)",
          "ja": "家も人間と一緒で、冬の夜は堪えるんだろう",
          "tc": "房子也跟人一樣，冬天的晚上很難熬吧。",
          "sc": "房子也跟人一样，冬天的晚上很难熬吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 181001,
          "spk": "琪娜娜 (チナナ)",
          "ja": "へえ、シカの声に家が軋む音か……",
          "tc": "哦，鹿的叫聲還有房子的嘎吱聲啊……",
          "sc": "哦，鹿的叫声还有房子的嘎吱声啊……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 181008,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは気にしたことなかったよ",
          "tc": "我從來沒注意過耶。",
          "sc": "我从来没注意过呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 181015,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミたち、耳がいいんだねえ",
          "tc": "你們的耳朵可真靈呢。",
          "sc": "你们的耳朵可真灵呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 181028,
          "spk": "堇怜 (スミレ)",
          "ja": "シカは、狩れたらご馳走になりますから",
          "tc": "畢竟要是抓到鹿就有一頓大餐了嘛。",
          "sc": "毕竟要是抓到鹿就有一顿大餐了嘛。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 181035,
          "spk": "堇怜 (スミレ)",
          "ja": "山に入ったら鳴き声は絶対に",
          "tc": "所以我進山的時候",
          "sc": "所以我进山的时候"
        },
        {
          "f_idx": 16,
          "pidx_tc": 181042,
          "spk": "堇怜 (スミレ)",
          "ja": "聞き逃さないようにしてるんです",
          "tc": "都會注意避免漏聽牠們的叫聲。",
          "sc": "都会注意避免漏听它们的叫声。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 181055,
          "spk": "木助 (キスケ)",
          "ja": "耳がいいってつもりはねえが、",
          "tc": "我是不覺得自己耳朵靈光，",
          "sc": "我是不觉得自己耳朵灵光，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 181062,
          "spk": "木助 (キスケ)",
          "ja": "家の声を聞いてやるのも",
          "tc": "但幫大家留意房子的聲音",
          "sc": "但帮大家留意房子的声音"
        },
        {
          "f_idx": 19,
          "pidx_tc": 181069,
          "spk": "木助 (キスケ)",
          "ja": "俺の仕事なんでね",
          "tc": "也是我的工作嘛。",
          "sc": "也是我的工作嘛。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 181082,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチはなんの音だったら",
          "tc": "有什麼聲音",
          "sc": "有什么声音"
        },
        {
          "f_idx": 21,
          "pidx_tc": 181089,
          "spk": "琪娜娜 (チナナ)",
          "ja": "聞き逃さないだろうな……",
          "tc": "是我不會聽漏的嗎……",
          "sc": "是我不会听漏的吗……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 181096,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、小銭が落ちる音とか？",
          "tc": "……啊，像是零錢掉在地上的聲音？",
          "sc": "……啊，像是零钱掉在地上的声音？"
        },
        {
          "f_idx": 23,
          "pidx_tc": 181109,
          "spk": "堇怜 (スミレ)",
          "ja": "それは僕も絶対に聞き逃さない",
          "tc": "那個我也絕對不會漏聽。",
          "sc": "那个我也绝对不会漏听。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 181122,
          "spk": "木助 (キスケ)",
          "ja": "右に同じだ",
          "tc": "我也是。",
          "sc": "我也是。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3338,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0065",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 181152,
          "spk": "六角 (ロッカク)",
          "ja": "この手に染みついた味も",
          "tc": "這雙手練就的料理口味，",
          "sc": "这双手练就的料理口味，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 181159,
          "spk": "六角 (ロッカク)",
          "ja": "ワシがくたばったら終わりっスねぇ",
          "tc": "等我掛掉後也會跟著消失呢。",
          "sc": "等我挂掉后也会跟着消失呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 181172,
          "spk": "今野 (コンノ)",
          "ja": "おやおやァ",
          "tc": "哎呀哎呀～",
          "sc": "哎呀哎呀～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 181179,
          "spk": "今野 (コンノ)",
          "ja": "寒さが厳しくなってくると",
          "tc": "天氣越冷，",
          "sc": "天气越冷，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 181186,
          "spk": "今野 (コンノ)",
          "ja": "感傷も深まるものなんですかねェ",
          "tc": "人也會變得更加多愁善感嗎～？",
          "sc": "人也会变得更加多愁善感吗～？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 181197,
          "spk": "今野 (コンノ)",
          "ja": "アナタにはヨウさんという",
          "tc": "您不是有洋小姐這個",
          "sc": "您不是有洋小姐这个"
        },
        {
          "f_idx": 6,
          "pidx_tc": 181204,
          "spk": "今野 (コンノ)",
          "ja": "立派な後継ぎがいらっしゃるじゃないですかァ",
          "tc": "出色的接班人嗎？",
          "sc": "出色的接班人吗～？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 181217,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんを後継ぎにとは考えてないっスよ",
          "tc": "我沒把洋妹妹當成是接班人啦。",
          "sc": "我没把洋妹妹当成是接班人哟。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 181224,
          "spk": "六角 (ロッカク)",
          "ja": "もちろん、料理が好きなら",
          "tc": "不過當然，如果她喜歡做菜，",
          "sc": "不过当然，如果她喜欢做菜，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 181231,
          "spk": "六角 (ロッカク)",
          "ja": "教えたっていいんスけどね……",
          "tc": "我也是可以教她……",
          "sc": "我也是可以教她……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 181244,
          "spk": "今野 (コンノ)",
          "ja": "好きになってもらうには",
          "tc": "如果希望她喜歡上做菜，",
          "sc": "如果希望她喜欢上做菜，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 181251,
          "spk": "今野 (コンノ)",
          "ja": "アナタからの働きかけも必要ですヨ？",
          "tc": "也需要您來主動引導吧？",
          "sc": "也需要您来主动引导吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 181258,
          "spk": "今野 (コンノ)",
          "ja": "子供は大人が導くものですからネ",
          "tc": "畢竟孩子本來就是由大人來帶領的。",
          "sc": "毕竟孩子本来就是由大人来带领的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 181269,
          "spk": "今野 (コンノ)",
          "ja": "ヨウさんでなくとも、案外スミレさんが",
          "tc": "就算不是洋小姐，",
          "sc": "就算不是洋小姐，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 181276,
          "spk": "今野 (コンノ)",
          "ja": "料理人を目指すということだって",
          "tc": "搞不好堇怜先生也有可能",
          "sc": "说不定堇怜先生也有可能"
        },
        {
          "f_idx": 15,
          "pidx_tc": 181283,
          "spk": "今野 (コンノ)",
          "ja": "有り得るかもしれませんよォ？",
          "tc": "會以廚師為志向喔～",
          "sc": "会以厨师为志向哟～～"
        },
        {
          "f_idx": 16,
          "pidx_tc": 181296,
          "spk": "六角 (ロッカク)",
          "ja": "そういやスミレさんの自炊の腕は、",
          "tc": "這麼說來，",
          "sc": "这么说来，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 181303,
          "spk": "六角 (ロッカク)",
          "ja": "なかなかのもんだって聞くっス",
          "tc": "我聽說堇怜弟弟很會自己煮飯呢。",
          "sc": "我听说堇怜弟弟很会自己煮饭呐。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 181316,
          "spk": "今野 (コンノ)",
          "ja": "なんにせよ、アナタの経験は",
          "tc": "不管怎麼說，",
          "sc": "不管怎么说，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 181323,
          "spk": "今野 (コンノ)",
          "ja": "ただ朽ちていくには惜しいですヨ",
          "tc": "要是您的經驗就這樣失傳，實在可惜。",
          "sc": "要是您的经验就这样失传，实在可惜哟～。"
        },
        {
          "f_idx": 20,
          "pidx_tc": 181330,
          "spk": "今野 (コンノ)",
          "ja": "すべてレシピにまとめてほしいものですネ",
          "tc": "真希望您可以把它們全部整理成食譜呢。",
          "sc": "真希望您可以把它们全部整理成食谱呢。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 181343,
          "spk": "六角 (ロッカク)",
          "ja": "全部っスか？",
          "tc": "全部嗎？",
          "sc": "全部不？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 181350,
          "spk": "六角 (ロッカク)",
          "ja": "そいつは大変な仕事っスねぇ",
          "tc": "那可是一件大工程呢。",
          "sc": "那可是一件大工程呐。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 181363,
          "spk": "今野 (コンノ)",
          "ja": "残さなければ、培ってきた経験も味も",
          "tc": "要是不先保存下來，您所累積的經驗和味道，",
          "sc": "要是不先保存下来，您所累积的经验和味道，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 181370,
          "spk": "今野 (コンノ)",
          "ja": "いずれすべてアナタと共に土に還るんですヨ",
          "tc": "終有一天會全部跟您一起歸於塵土的。",
          "sc": "终有一天会全部跟您一起归于尘土哟～。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 181388,
          "spk": "今野 (コンノ)",
          "ja": "アナタの味を、次の世代に",
          "tc": "難道您不想把自己的味道，",
          "sc": "难道您不想把自己的味道，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 181395,
          "spk": "今野 (コンノ)",
          "ja": "繋ぎたいとは思いませんかァ？",
          "tc": "傳承給下一代嗎～？",
          "sc": "传承给下一代吗～？"
        },
        {
          "f_idx": 28,
          "pidx_tc": 181408,
          "spk": "六角 (ロッカク)",
          "ja": "そうっスねぇ……",
          "tc": "說得也是……",
          "sc": "说得也是……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 181415,
          "spk": "六角 (ロッカク)",
          "ja": "……ま、考えてみるっス",
          "tc": "……好吧，我會考慮看看的。",
          "sc": "……好吧，我会考虑看看呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3339,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0066",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 181443,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと前に、この辺りの雪の上に",
          "tc": "前陣子，我在這附近的雪地上",
          "sc": "前阵子，我在这附近的雪地上"
        },
        {
          "f_idx": 1,
          "pidx_tc": 181450,
          "spk": "裕太 (ユータ)",
          "ja": "たくさんの足跡を見つけたよ",
          "tc": "發現了很多腳印喔。",
          "sc": "发现了很多脚印哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 181463,
          "spk": "驹子 (コマコ)",
          "ja": "あ、それなら私も見たと思う",
          "tc": "啊，那個我應該也有看到。",
          "sc": "啊，那个我应该也瞧见过。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 181476,
          "spk": "裕太 (ユータ)",
          "ja": "本当？ 二種類あったんだけど",
          "tc": "真的嗎？我看到的腳印有兩種，",
          "sc": "真的吗？我看到的脚印有两种，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 181483,
          "spk": "裕太 (ユータ)",
          "ja": "なんの足跡だったかわかる？",
          "tc": "妳知道那是什麼動物的腳印嗎？",
          "sc": "你知道那是什么动物的脚印吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 181496,
          "spk": "驹子 (コマコ)",
          "ja": "えっと……木の周りにたくさん",
          "tc": "我想想……在樹木周圍留下的大量腳印，",
          "sc": "我想想……在树木周围留下的大量脚印，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 181503,
          "spk": "驹子 (コマコ)",
          "ja": "残っていた足跡は、ウサギかな……？",
          "tc": "應該是兔子吧……？",
          "sc": "应该是兔子吧……？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 181510,
          "spk": "驹子 (コマコ)",
          "ja": "木の皮を食べに来てたんだと思う",
          "tc": "我想牠是來吃樹皮的吧。",
          "sc": "我想它是来吃树皮的吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 181521,
          "spk": "驹子 (コマコ)",
          "ja": "ウサギのより大きい足跡は",
          "tc": "然後腳印比兔子還大的",
          "sc": "然后脚印比兔子还大的"
        },
        {
          "f_idx": 9,
          "pidx_tc": 181528,
          "spk": "驹子 (コマコ)",
          "ja": "キツネで……もしかしたらウサギを",
          "tc": "則是狐狸……",
          "sc": "则是狐狸……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 181535,
          "spk": "驹子 (コマコ)",
          "ja": "狙ってたのかも……",
          "tc": "牠可能是來捕獵兔子的……",
          "sc": "它可能是来捕猎兔子的……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 181548,
          "spk": "裕太 (ユータ)",
          "ja": "そうだったのか！",
          "tc": "原來是這樣啊！",
          "sc": "原来是这样啊！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 181559,
          "spk": "裕太 (ユータ)",
