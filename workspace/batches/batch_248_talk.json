      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390257,
          "spk": "帷 (トバリ)",
          "ja": "タマゴはオッサンの店から",
          "tc": "雞蛋是我從大叔的店裡，",
          "sc": "鸡蛋是我从大叔的店里，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390264,
          "spk": "帷 (トバリ)",
          "ja": "こっそりくすねたものだから、",
          "tc": "偷偷拿來的，",
          "sc": "偷偷拿来的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390271,
          "spk": "帷 (トバリ)",
          "ja": "素材は問題ないと思うけど……",
          "tc": "所以材料方面應該不會有問題……",
          "sc": "所以材料方面应该不会有问题……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390282,
          "spk": "帷 (トバリ)",
          "ja": "シンプルな、こういう料理にこそ",
          "tc": "正是因為這種料理很簡單，",
          "sc": "正是因为这种料理很简单，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390289,
          "spk": "帷 (トバリ)",
          "ja": "腕の良し悪しが表れるものだから",
          "tc": "才最能夠看出一個人的手藝了。",
          "sc": "才最能够看出一个人的手艺了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 390307,
          "spk": "帷 (トバリ)",
          "ja": "個人的には好きな味に仕上がったと思う",
          "tc": "我是按照我喜歡的味道去調味，",
          "sc": "我是按照我喜欢的味道去调味，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 390314,
          "spk": "帷 (トバリ)",
          "ja": "アンタの舌にも合うといいな",
          "tc": "希望也合你的口味。",
          "sc": "希望也合你的口味。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 390332,
          "spk": "帷 (トバリ)",
          "ja": "どう？　<player>",
          "tc": "怎麼樣？<player>，",
          "sc": "怎么样？<player>，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 390339,
          "spk": "帷 (トバリ)",
          "ja": "美味しい？",
          "tc": "好吃嗎？",
          "sc": "好吃吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 390348,
          "spk": "主角心声/旁白/选项",
          "ja": "おいしい！",
          "tc": "好吃！",
          "sc": "好吃！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 390355,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6804,
      "rec_id": "TALK_ID_70_2020_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390441,
          "spk": "帷 (トバリ)",
          "ja": "実は私、料理を作るの、結構好きなの",
          "tc": "其實我很喜歡做料理。",
          "sc": "其实我很喜欢做料理。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390448,
          "spk": "帷 (トバリ)",
          "ja": "暇つぶしにもなるし、お腹も満たせるし……",
          "tc": "既可以打發時間，又可以填飽肚子……",
          "sc": "既可以打发时间，又可以填饱肚子……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390466,
          "spk": "帷 (トバリ)",
          "ja": "また気が向いたら、",
          "tc": "下次如果我又想做料理，",
          "sc": "下次如果我又想做料理，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390473,
          "spk": "帷 (トバリ)",
          "ja": "何か作ってアンタも誘ってあげる",
          "tc": "再找你來吃。",
          "sc": "再找你来吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 390480,
          "spk": "帷 (トバリ)",
          "ja": "楽しみにしてて",
          "tc": "好好期待吧。",
          "sc": "好好期待吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
