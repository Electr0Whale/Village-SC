        },
        {
          "f_idx": 3,
          "pidx_tc": 425854,
          "spk": "四郎治 (シロージ)",
          "ja": "「フライドポテト」を揚げたから",
          "tc": "所以就炸了一些「薯條」，",
          "sc": "所以就炸了一些“薯条”，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425861,
          "spk": "四郎治 (シロージ)",
          "ja": "食っていけよ",
          "tc": "你也來吃一點吧。",
          "sc": "你也来吃一点吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6956,
      "rec_id": "TALK_ID_70_2040_007_02",
      "lines": [
        {
