      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390192,
          "spk": "帷 (トバリ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎，<player>。",
          "sc": "欢迎，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390201,
          "spk": "帷 (トバリ)",
          "ja": "アンタのために、",
          "tc": "我為你，",
          "sc": "我为你，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390208,
          "spk": "帷 (トバリ)",
          "ja": "「だし巻き卵」を作ったの",
          "tc": "做了「高湯蛋捲」喔。",
          "sc": "做了“高汤蛋卷”。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390219,
          "spk": "帷 (トバリ)",
          "ja": "私の味付け……気に入るかわからないけど、",
          "tc": "雖然不知道你會不會喜歡我的調味，",
