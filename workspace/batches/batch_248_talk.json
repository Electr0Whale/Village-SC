      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426146,
          "spk": "四郎治 (シロージ)",
          "ja": "よお、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426153,
          "spk": "四郎治 (シロージ)",
          "ja": "待ってたぜ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426164,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は山にあるピザ窯で",
          "tc": "我今天用山裡的披薩窯爐",
          "sc": "我今天用山里的披萨窑炉"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426171,
          "spk": "四郎治 (シロージ)",
          "ja": "「マルゲリータピザ」を焼いてきた",
          "tc": "烤了「瑪格麗特披薩」，",
          "sc": "烤了“玛格丽特披萨”，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426178,
          "spk": "四郎治 (シロージ)",
          "ja": "いい匂いだろ？",
          "tc": "是不是很香？",
          "sc": "是不是很香？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6961,
      "rec_id": "TALK_ID_70_2040_008_02",
      "lines": [
        {
