          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425488,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>か？",
          "tc": "是<player>嗎？",
          "sc": "是<player>吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6950,
      "rec_id": "TALK_ID_70_2040_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425512,
          "spk": "四郎治 (シロージ)",
          "ja": "こんな時間に来たのか……",
          "tc": "你怎麼這種時間過來……",
          "sc": "你怎么这种时间过来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425519,
          "spk": "四郎治 (シロージ)",
          "ja": "夜は危ねぇんだぞ",
          "tc": "晚上可是很危險的。",
          "sc": "晚上可是很危险的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425530,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、来ちまったもんは仕方ねぇ",
          "tc": "不過既然你都來了，那也沒辦法。",
          "sc": "不过既然你都来了，那也没办法。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425541,
          "spk": "四郎治 (シロージ)",
          "ja": "夜、自然の中で寝転がるのは気持ちいい",
          "tc": "晚上躺在這大自然中可是很舒服的，",
          "sc": "晚上躺在这大自然中可是很舒服的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425548,
          "spk": "四郎治 (シロージ)",
          "ja": "一緒にどうだ？",
          "tc": "你要不要也一起啊？",
          "sc": "你要不要也一起啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6951,
      "rec_id": "TALK_ID_70_2040_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425572,
          "spk": "四郎治 (シロージ)",
          "ja": "この時間のこの場所は",
          "tc": "雖然這個時段的這個地方",
          "sc": "虽然这个时段的这个地方"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425579,
          "spk": "四郎治 (シロージ)",
          "ja": "俺だけのとっておきだったんだが……",
          "tc": "是只屬於我一個人的私房景點……",
          "sc": "是只属于我一个人的私房景点……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425590,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>にならいいか",
          "tc": "不過我不介意跟<player>你分享。",
          "sc": "不过我不介意跟<player>你分享。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6952,
      "rec_id": "TALK_ID_70_2040_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425621,
          "spk": "四郎治 (シロージ)",
          "ja": "……なぜか最近、空を見ることが多いんだ",
          "tc": "……不知道為何最近常常望著天空。",
          "sc": "……不知道为何最近常常望着天空。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425628,
          "spk": "四郎治 (シロージ)",
          "ja": "前より空が綺麗に見える気がして……",
          "tc": "總覺得天空看起來比以前更美了……",
          "sc": "总觉得天空看起来比以前更美了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425646,
          "spk": "四郎治 (シロージ)",
          "ja": "隠し事がなくなって",
          "tc": "或許是因為沒了需要隱藏的事，",
          "sc": "或许是因为没了需要隐藏的事，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425653,
          "spk": "四郎治 (シロージ)",
          "ja": "心が軽くなったからかもしれない",
          "tc": "內心輕鬆了許多，所以我才會這麼覺得吧。",
          "sc": "内心轻松了许多，所以我才会这么觉得吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 425671,
          "spk": "四郎治 (シロージ)",
          "ja": "この前コマコと一緒に",
          "tc": "我前陣子跟駒子",
          "sc": "我前阵子跟驹子"
        },
        {
          "f_idx": 7,
          "pidx_tc": 425678,
          "spk": "四郎治 (シロージ)",
          "ja": "ハナコの墓参りにも行けたんだ",
          "tc": "一起去幫花子掃了墓。",
          "sc": "一起去帮花子扫了墓。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 425687,
          "spk": "四郎治 (シロージ)",
          "ja": "抱え続けてきた罪悪感が、",
          "tc": "總感覺一直以來懷抱著的罪惡感，",
          "sc": "总感觉一直以来怀抱着的罪恶感，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 425694,
          "spk": "四郎治 (シロージ)",
          "ja": "ゆっくりと解けていくような感じがする",
          "tc": "好像也漸漸地消除了。",
          "sc": "好像也渐渐地消除了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6953,
      "rec_id": "TALK_ID_70_2040_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425712,
          "spk": "四郎治 (シロージ)",
          "ja": "ありがとうな、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425723,
          "spk": "四郎治 (シロージ)",
          "ja": "お前のおかげで、コマコも俺も……",
          "tc": "多虧有你，駒子和我……",
          "sc": "多亏有你，驹子和我……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425730,
          "spk": "四郎治 (シロージ)",
          "ja": "あの事件で止まっていた時間が、また動き出した",
          "tc": "因為那件事而停滯的時間又開始流動了。",
          "sc": "因为那件事而停滞的时间又开始流动了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425737,
          "spk": "四郎治 (シロージ)",
          "ja": "……やっと、前に進めるよ",
          "tc": "……終於，可以往前走了",
          "sc": "……终于，可以往前走了"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425748,
          "spk": "四郎治 (シロージ)",
          "ja": "……この借りは、簡単には返しきれねぇな",
          "tc": "……這份恩情，不是隨隨便便就能報答的。",
          "sc": "……这份恩情，不是随随便便就能报答的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 425755,
          "spk": "四郎治 (シロージ)",
          "ja": "でも、ちゃんと返していくよ",
          "tc": "可是，我會好好償還。",
          "sc": "可是，我会好好偿还。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6954,
      "rec_id": "TALK_ID_70_2040_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425780,
          "spk": "四郎治 (シロージ)",
          "ja": "……さて、もうこんな時間だ",
          "tc": "……好了，都這個時間了，",
          "sc": "……好了，都这个时间了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425787,
          "spk": "四郎治 (シロージ)",
          "ja": "俺はもうそろそろ引き上げる",
          "tc": "我也差不多該回去了。",
          "sc": "我也差不多该回去了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425798,
          "spk": "四郎治 (シロージ)",
          "ja": "お前は……一人で帰れるよな？",
          "tc": "你……自己一個人應該回得去吧？",
          "sc": "你……自己一个人应该回得去吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425805,
          "spk": "四郎治 (シロージ)",
          "ja": "じゃあ……おやすみ、<player>",
          "tc": "那就……晚安了，<player>。",
          "sc": "那就……晚安了，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6955,
      "rec_id": "TALK_ID_70_2040_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425829,
          "spk": "四郎治 (シロージ)",
          "ja": "よお、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425836,
          "spk": "四郎治 (シロージ)",
          "ja": "来たのか",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 425847,
          "spk": "四郎治 (シロージ)",
          "ja": "山盛りの芋を手に入れてな",
          "tc": "我拿到了一大堆馬鈴薯，",
