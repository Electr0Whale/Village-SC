      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390555,
          "spk": "帷 (トバリ)",
          "ja": "この料理、私の好物なの",
          "tc": "我很喜歡這道料理。",
          "sc": "我很喜欢这道料理。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390566,
          "spk": "帷 (トバリ)",
          "ja": "素材の味が活かされていて、",
          "tc": "它能發揮出食材原本的味道，",
          "sc": "它能发挥出食材原本的味道，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390573,
          "spk": "帷 (トバリ)",
          "ja": "素朴で、余計な飾り付けがない……",
          "tc": "簡單樸素、沒有多餘的裝飾……",
          "sc": "简单朴素、没有多余的装饰……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390582,
          "spk": "帷 (トバリ)",
          "ja": "ヘルシーで美味しいし、",
          "tc": "既健康又美味，",
          "sc": "既健康又美味，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390589,
          "spk": "帷 (トバリ)",
          "ja": "何より手軽に作れるし……",
          "tc": "而且製作方法非常簡單……",
          "sc": "而且制作方法非常简单……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 390600,
