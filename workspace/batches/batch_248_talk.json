      "rec_id": "TALK_ID_70_2040_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426220,
          "spk": "四郎治 (シロージ)",
          "ja": "いい焼き加減だ",
          "tc": "這披薩烤得剛剛好，",
          "sc": "这披萨烤得刚刚好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426227,
          "spk": "四郎治 (シロージ)",
          "ja": "トマトの酸味もいい塩梅だな",
          "tc": "番茄的酸味也恰到好處。",
          "sc": "西红柿的酸味也恰到好处。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6963,
      "rec_id": "TALK_ID_70_2040_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426245,
          "spk": "四郎治 (シロージ)",
          "ja": "俺、実は偏食なんだ",
          "tc": "其實我很挑食，",
          "sc": "其实我很挑食，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426252,
          "spk": "四郎治 (シロージ)",
          "ja": "食えねぇものが結構多くてな……",
          "tc": "不能吃的東西有很多……",
          "sc": "不能吃的东西有很多……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 426270,
          "spk": "四郎治 (シロージ)",
          "ja": "でも、初めてピザを食べた時は",
          "tc": "不過我第一次吃到披薩的時候",
          "sc": "不过我第一次吃到披萨的时候"
        },
        {
          "f_idx": 4,
          "pidx_tc": 426277,
          "spk": "四郎治 (シロージ)",
          "ja": "美味いって思ったよ",
          "tc": "也覺得很好吃。",
          "sc": "也觉得很好吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 426288,
          "spk": "四郎治 (シロージ)",
          "ja": "肉は未だにダメなんだが……",
          "tc": "雖然至今我都不太敢吃肉……",
          "sc": "虽然至今我都不太敢吃肉……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 426295,
          "spk": "四郎治 (シロージ)",
          "ja": "加工肉なら多少はいけるようになった",
          "tc": "但我現在比較敢吃加工過的肉了。",
          "sc": "但我现在比较敢吃加工过的肉了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 426313,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>は肉が食えるのか？",
          "tc": "<player>你敢吃肉嗎？",
          "sc": "<player>你敢吃肉吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 426322,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 426329,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6964,
      "rec_id": "TALK_ID_70_2040_008_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426404,
          "spk": "四郎治 (シロージ)",
          "ja": "それにしてもお前、美味そうに食うよな",
          "tc": "是說，看起來你很喜歡這道料理嘛。",
          "sc": "是说，看起来你很喜欢这道料理嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426411,
          "spk": "四郎治 (シロージ)",
