      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390504,
          "spk": "帷 (トバリ)",
          "ja": "来たのね、<player>",
          "tc": "你來啦，<player>。",
          "sc": "你来啦，<player>。"
        },
        {
