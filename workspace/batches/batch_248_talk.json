    {
      "file": "talk.dat",
      "rec_idx": 6957,
      "rec_id": "TALK_ID_70_2040_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 425903,
          "spk": "四郎治 (シロージ)",
          "ja": "楽に作れるから、ついいっぱい揚げちまった……",
          "tc": "因為作法很簡單，不知不覺就炸了很多……",
          "sc": "因为作法很简单，不知不觉就炸了很多……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 425910,
          "spk": "四郎治 (シロージ)",
          "ja": "お前もたくさん食ってくれ",
          "tc": "你也多吃點。",
          "sc": "你也多吃点。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 425928,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、こっちにあるのは、時間が経ってるやつだ",
          "tc": "啊，這邊是已經放了一段時間的。",
          "sc": "啊，这边是已经放了一段时间的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 425935,
          "spk": "四郎治 (シロージ)",
          "ja": "フニャフニャだが……こっちも食うか？",
          "tc": "雖然軟趴趴的……你要吃嗎？",
          "sc": "虽然软趴趴的……你要吃吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 425951,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 7,
          "pidx_tc": 425958,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6958,
      "rec_id": "TALK_ID_70_2040_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426083,
          "spk": "四郎治 (シロージ)",
          "ja": "チナナから聞いたんだが、",
          "tc": "我聽琪娜娜說，",
          "sc": "我听琪娜娜说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426090,
          "spk": "四郎治 (シロージ)",
          "ja": "街にはフライドポテトを食える店が",
          "tc": "城市裡有很多",
          "sc": "城市里有很多"
        },
        {
          "f_idx": 2,
          "pidx_tc": 426097,
          "spk": "四郎治 (シロージ)",
          "ja": "いっぱいあるんだとよ",
          "tc": "可以吃到炸薯條的店。",
          "sc": "可以吃到炸薯条的店。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6959,
      "rec_id": "TALK_ID_70_2040_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 426115,
          "spk": "四郎治 (シロージ)",
          "ja": "食ってみたいよな……",
          "tc": "真想吃吃看啊……",
          "sc": "真想吃吃看啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 426122,
          "spk": "四郎治 (シロージ)",
          "ja": "いつか、街に降りられるといいな",
          "tc": "希望有天能下山去城市看看。",
          "sc": "希望有天能下山去城市看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
