          "pidx_tc": 390226,
          "spk": "帷 (トバリ)",
          "ja": "冷めないうちに、食べてみて",
          "tc": "但趕快趁熱吃吧。",
          "sc": "但赶快趁热吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
