      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389803,
          "spk": "帷 (トバリ)",
          "ja": "……暇つぶしか",
          "tc": "……打發時間啊。",
          "sc": "……打发时间啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389810,
          "spk": "帷 (トバリ)",
          "ja": "なら、一緒に散歩でもしない？",
          "tc": "那要不要一起去散步？",
          "sc": "那要不要一起去散步？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6795,
      "rec_id": "TALK_ID_70_2020_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389834,
          "spk": "帷 (トバリ)",
          "ja": "私ね……",
          "tc": "我……",
          "sc": "我……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389841,
          "spk": "帷 (トバリ)",
          "ja": "ずっと抱えてた悩みを、少し整理できたの",
          "tc": "把一直背負著的煩惱，稍微整理了一下。",
          "sc": "把一直背负着的烦恼，稍微整理了一下。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6796,
      "rec_id": "TALK_ID_70_2020_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389866,
          "spk": "帷 (トバリ)",
          "ja": "一人で悩んでると、",
          "tc": "獨自煩惱的話，",
          "sc": "独自烦恼的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389873,
          "spk": "帷 (トバリ)",
          "ja": "同じことばっかりぐるぐる考えて、",
          "tc": "總是重複思考著同樣的事情，",
          "sc": "总是重复思考着同样的事情，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389880,
          "spk": "帷 (トバリ)",
          "ja": "どんどんネガティブになっていく……",
          "tc": "越想越消極……",
          "sc": "越想越消极……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389891,
          "spk": "帷 (トバリ)",
          "ja": "そのうち何を考えてたのかも分からなくなって、",
          "tc": "漸漸地連自己在想什麼都搞不懂了，",
          "sc": "渐渐地连自己在想什么都搞不懂了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 389898,
          "spk": "帷 (トバリ)",
          "ja": "頭の中が霧がかかったみたいに、",
          "tc": "腦袋裡就像蒙了一層霧，",
          "sc": "脑袋里就像蒙了一层雾，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 389905,
          "spk": "帷 (トバリ)",
          "ja": "ぼんやりしてくるの……",
          "tc": "變得模糊起來……",
          "sc": "变得模糊起来……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6797,
      "rec_id": "TALK_ID_70_2020_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389923,
          "spk": "帷 (トバリ)",
          "ja": "……私、ずっと不安だった",
          "tc": "……我一直很不安。",
          "sc": "……我一直很不安。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389930,
          "spk": "帷 (トバリ)",
          "ja": "どうしてここにいるのかも、",
          "tc": "不知道我為什麼要在這裡，",
          "sc": "不知道我为什么要在这里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389937,
          "spk": "帷 (トバリ)",
          "ja": "これからどう生きるのかも分からなくて……",
          "tc": "今後要怎麼活下去……",
          "sc": "今后要怎么活下去……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389946,
          "spk": "帷 (トバリ)",
          "ja": "私には役割もなくて、何者でもない……",
          "tc": "我沒有屬於自己的職責，誰也不是……",
          "sc": "我没有属于自己的职责，谁也不是……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 389953,
          "spk": "帷 (トバリ)",
          "ja": "だから、このままここで暮らす未来なんて、",
          "tc": "所以，我實在無法想像，",
          "sc": "所以，我实在无法想像，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 389960,
          "spk": "帷 (トバリ)",
          "ja": "想像できなかった",
          "tc": "未來就這樣在這裡生活下去。",
          "sc": "未来就这样在这里生活下去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6798,
      "rec_id": "TALK_ID_70_2020_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389978,
          "spk": "帷 (トバリ)",
          "ja": "でも……アンタと話して、気づいたの",
          "tc": "可是……跟你聊過以後，我發現，",
          "sc": "可是……跟你聊过以后，我发现，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389994,
          "spk": "帷 (トバリ)",
          "ja": "頭の中の思考って、誰かと話すことで",
          "tc": "只要跟人聊聊，腦中思考的事",
          "sc": "只要跟人聊聊，脑中思考的事"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390001,
          "spk": "帷 (トバリ)",
          "ja": "少しずつ整理されていくのね",
          "tc": "也會一點一滴地彙整起來。",
          "sc": "也会一点一滴地汇整起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6799,
      "rec_id": "TALK_ID_70_2020_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390026,
          "spk": "帷 (トバリ)",
          "ja": "それに……言葉にしてみると、",
          "tc": "而且……化成言語以後，",
          "sc": "而且……化成言语以后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390033,
          "spk": "帷 (トバリ)",
          "ja": "ちゃんと「自分」が見えてくる……",
          "tc": "就能更看清楚「自己」……",
          "sc": "就能更看清楚“自己”……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390049,
          "spk": "帷 (トバリ)",
          "ja": "……私が迷ってたのは、",
          "tc": "……我之所以迷惘，",
          "sc": "……我之所以迷惘，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390056,
          "spk": "帷 (トバリ)",
          "ja": "勝手に一人で閉じこもっていたからなのね",
          "tc": "都是因為我自己閉門不出。",
          "sc": "都是因为我自己闭门不出。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 390074,
          "spk": "帷 (トバリ)",
          "ja": "……リンとの生活はむかつくことも多いけど、",
          "tc": "……雖然和林一起生活常常有很多生氣的事……",
          "sc": "……虽然和林一起生活常常有很多生气的事……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 390081,
          "spk": "帷 (トバリ)",
          "ja": "でも……今の居場所も、退屈な毎日も……",
          "tc": "但……無論是現在的歸處，還是無聊的每一天……",
          "sc": "但……无论是现在的归处，还是无聊的每一天……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 390088,
          "spk": "帷 (トバリ)",
          "ja": "ほんの少しだけ、悪くないって思えてきた",
          "tc": "雖然只有一點點，也漸漸覺得不壞。",
          "sc": "虽然只有一点点，也渐渐觉得不坏。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6800,
      "rec_id": "TALK_ID_70_2020_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390106,
          "spk": "帷 (トバリ)",
          "ja": "……全部、アンタのおかげね",
          "tc": "……這全都是你的功勞。",
          "sc": "……这全都是你的功劳。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390122,
          "spk": "帷 (トバリ)",
          "ja": "だから、これからもたまに、",
          "tc": "所以從今以後，",
          "sc": "所以从今以后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390129,
          "spk": "帷 (トバリ)",
          "ja": "私のくだらない独り言に",
          "tc": "如果你偶爾能聽聽我無聊的自言自語，",
          "sc": "如果你偶尔能听听我无聊的自言自语，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390136,
          "spk": "帷 (トバリ)",
          "ja": "付き合ってくれると嬉しい",
          "tc": "我會很高興的。",
          "sc": "我会很高兴的。"
        }
      ]
    },
    {
