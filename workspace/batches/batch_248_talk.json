  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6927,
      "rec_id": "TALK_ID_70_2040_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 423902,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタの生活スタイルで",
          "tc": "從你的生活方式來看，",
          "sc": "从你的生活方式来看，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 423909,
          "spk": "茶梅 (サザンカ)",
          "ja": "車が好きとか意外でしかないっしょ",
          "tc": "會喜歡車真的讓人意外。",
          "sc": "会喜欢车真的让人意外。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 423927,
          "spk": "茶梅 (サザンカ)",
          "ja": "ここでの生活に不満もなさそうだし",
          "tc": "而且這傢伙對這裡的生活都沒有什麼不滿的，",
          "sc": "而且这家伙对这里的生活都没有什么不满的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 423934,
          "spk": "茶梅 (サザンカ)",
          "ja": "変わってるよね～",
          "tc": "很奇怪對吧～",
          "sc": "很奇怪对吧～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 423947,
          "spk": "四郎治 (シロージ)",
          "ja": "それはお前も同じだろ",
          "tc": "這點你不也是一樣嗎？",
          "sc": "这点你不也是一样吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 423960,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシは文句の一つや",
          "tc": "我好歹也會",
          "sc": "我好歹也会"
        },
        {
          "f_idx": 7,
          "pidx_tc": 423967,
          "spk": "茶梅 (サザンカ)",
          "ja": "二つくらいはあるって",
          "tc": "抱怨個一兩句好嗎。",
          "sc": "抱怨个一两句好吗。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 423974,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタはちょっと無欲すぎ",
          "tc": "你太過無欲無求了。",
          "sc": "你太过无欲无求了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 423987,
          "spk": "四郎治 (シロージ)",
          "ja": "妹と平和に暮らせて",
          "tc": "我能跟妹妹平安度日，",
          "sc": "我能跟妹妹平安度日，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 423994,
          "spk": "四郎治 (シロージ)",
          "ja": "趣味だって楽しめてる",
          "tc": "又能享受我的興趣，",
          "sc": "又能享受我的兴趣，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 424003,
          "spk": "四郎治 (シロージ)",
          "ja": "それで十分だろ",
          "tc": "這樣我就很足夠了。",
          "sc": "这样我就很足够了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 424016,
          "spk": "茶梅 (サザンカ)",
          "ja": "ふうん……？",
          "tc": "是喔……？",
          "sc": "是哦……？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 424023,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシにはその感覚わからないな～",
          "tc": "我是不太懂這種感覺啦～",
          "sc": "我是不太懂这种感觉啦～"
        },
        {
          "f_idx": 15,
          "pidx_tc": 424043,
          "spk": "四郎治 (シロージ)",
          "ja": "わかってもらわなくていいぜ",
          "tc": "妳不用懂也沒關係。",
          "sc": "你不用懂也没关系。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 424054,
          "spk": "四郎治 (シロージ)",
          "ja": "……じゃ、俺はそろそろ行くよ",
          "tc": "……那我差不多要走了。",
          "sc": "……那我差不多要走了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 424061,
          "spk": "四郎治 (シロージ)",
          "ja": "楽しかった、ありがとうな",
          "tc": "我玩得很開心，謝啦。",
          "sc": "我玩得很开心，谢啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6928,
      "rec_id": "TALK_ID_70_2040_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424089,
          "spk": "木助 (キスケ)",
          "ja": "おいこら、シロージてめぇ！",
          "tc": "喂，四郎治你這傢伙！",
          "sc": "喂，四郎治你这家伙！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424096,
          "spk": "木助 (キスケ)",
          "ja": "俺の肩にぶつかったぞ！",
          "tc": "你撞到了我的肩膀欸！",
          "sc": "你撞到了我的肩膀诶！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424103,
          "spk": "木助 (キスケ)",
          "ja": "なんか言うことはねぇのか！？",
          "tc": "難道不該說點什麼嗎！？",
          "sc": "难道不该说点什么吗！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424116,
          "spk": "四郎治 (シロージ)",
          "ja": "悪いな",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424123,
          "spk": "四郎治 (シロージ)",
          "ja": "小さくてよく見えなかったぜ",
          "tc": "你太矮了，我沒看到你。",
          "sc": "你太矮了，我没看到你。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 424136,
          "spk": "木助 (キスケ)",
          "ja": "あぁ！？",
          "tc": "什麼？",
          "sc": "什么？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 424143,
          "spk": "木助 (キスケ)",
          "ja": "この野郎、言いやがったな！！",
          "tc": "你這傢伙還真敢講啊！！",
          "sc": "你这家伙还真敢讲啊！！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 424152,
          "spk": "木助 (キスケ)",
          "ja": "でくの坊め！",
          "tc": "臭木頭！",
          "sc": "臭木头！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 424159,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはいつになったら",
          "tc": "你是要到什麼時候",
          "sc": "你是要到什么时候"
        },
        {
          "f_idx": 9,
          "pidx_tc": 424166,
          "spk": "木助 (キスケ)",
          "ja": "自分のサイズ感を理解すんだよ！",
          "tc": "才能搞清楚自己到底有多大隻啊！",
          "sc": "才能搞清楚自己到底有多大只啊！"
        },
        {
          "f_idx": 10,
          "pidx_tc": 424179,
          "spk": "四郎治 (シロージ)",
          "ja": "へえ、やるか？",
          "tc": "哦？想打架嗎？",
          "sc": "哦？想打架吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 424186,
          "spk": "四郎治 (シロージ)",
          "ja": "サイズ感がわかってねぇのは",
          "tc": "搞不清楚自己到底有多矮的",
          "sc": "搞不清楚自己到底有多矮的"
        },
        {
          "f_idx": 12,
          "pidx_tc": 424193,
          "spk": "四郎治 (シロージ)",
          "ja": "お前のほうじゃねえのか",
          "tc": "應該是你才對吧？",
          "sc": "应该是你才对吧？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 424206,
          "spk": "木助 (キスケ)",
          "ja": "なめやがって、この野郎……",
          "tc": "你這傢伙敢小看我……",
          "sc": "你这家伙敢小看我……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 424213,
          "spk": "木助 (キスケ)",
          "ja": "ったく、どんな教育を受けたんだよ",
          "tc": "到底都是受了什麼教育啊。",
          "sc": "到底都是受了什么教育啊。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 424220,
          "spk": "木助 (キスケ)",
          "ja": "これはもう一度、躾した方がいいかもな……",
          "tc": "看來應該要好好教育一番……",
          "sc": "看来应该要好好教育一番……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 424233,
          "spk": "四郎治 (シロージ)",
          "ja": "俺とコマコは村の大人を見て育ったんだ",
          "tc": "我和駒子是村裡的大人們看著長大的。",
          "sc": "我和驹子是村里的大人们看着长大的。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 424240,
          "spk": "四郎治 (シロージ)",
          "ja": "教育が悪いっていうなら、",
          "tc": "如果要說我們沒被教好，",
          "sc": "如果要说我们没被教好，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 424247,
          "spk": "四郎治 (シロージ)",
          "ja": "見本となる大人に問題があるんじゃねえか？",
          "tc": "那不就是說村裡的大人沒做好榜樣嗎？",
          "sc": "那不就是说村里的大人没做好榜样吗？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 424260,
          "spk": "木助 (キスケ)",
          "ja": "この野郎……",
          "tc": "你這傢伙……",
          "sc": "你这家伙……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 424267,
          "spk": "木助 (キスケ)",
          "ja": "口ばっかり達者になりやがって……",
          "tc": "光會耍那張嘴皮子……",
          "sc": "光会耍那张嘴皮子……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 424278,
          "spk": "木助 (キスケ)",
          "ja": "はぁ……俺はいくぜ",
          "tc": "呼……我要走了。",
          "sc": "呼……我要走了。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 424285,
          "spk": "木助 (キスケ)",
          "ja": "だが、次に会った時は覚悟しておけよ",
          "tc": "但下次遇見的時候就給我小心點。",
          "sc": "但下次遇见的时候就给我小心点。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 424292,
          "spk": "木助 (キスケ)",
          "ja": "二度と生意気な口きけねぇように教育してやる",
          "tc": "我會好好教你，讓你口氣沒辦法再那麼囂張。",
          "sc": "我会好好教你，让你口气没办法再那么嚣张。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6929,
      "rec_id": "TALK_ID_70_2040_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424318,
          "spk": "四郎治 (シロージ)",
          "ja": "……あいつをからかうのは",
          "tc": "……耍弄那個傢伙，",
          "sc": "……耍弄那个家伙，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424325,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱりおもしれーな",
          "tc": "真是太有趣了。",
          "sc": "真是太有趣了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6930,
      "rec_id": "TALK_ID_70_2040_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424343,
          "spk": "四郎治 (シロージ)",
          "ja": "ほったらかしにして悪かったよ",
          "tc": "抱歉，把你晾在一旁。",
          "sc": "抱歉，把你晾在一旁。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424350,
          "spk": "四郎治 (シロージ)",
          "ja": "心配すんな、昔からこうなんだ",
          "tc": "別擔心，一直以來都是這樣。",
          "sc": "别担心，一直以来都是这样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424368,
          "spk": "四郎治 (シロージ)",
          "ja": "あの人は、いい人だよ",
          "tc": "他是個好人。",
          "sc": "他是个好人。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424375,
          "spk": "四郎治 (シロージ)",
          "ja": "俺の悪ふざけを許してくれる",
          "tc": "會放任我惡作劇，",
          "sc": "会放任我恶作剧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 424382,
          "spk": "四郎治 (シロージ)",
          "ja": "商売相手としても信頼してるしな",
          "tc": "而我在生意往來上也很信任他。",
          "sc": "而我在生意往来上也很信任他。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6931,
      "rec_id": "TALK_ID_70_2040_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424400,
          "spk": "四郎治 (シロージ)",
          "ja": "……あ、いや",
          "tc": "……啊，沒事。",
          "sc": "……啊，没事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424407,
          "spk": "四郎治 (シロージ)",
          "ja": "すこし喋りすぎたぜ……",
          "tc": "我說得太多了……",
          "sc": "我说得太多了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424414,
          "spk": "四郎治 (シロージ)",
          "ja": "今のは忘れてくれ",
          "tc": "把剛才說的忘了吧。",
          "sc": "把刚才说的忘了吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424425,
          "spk": "四郎治 (シロージ)",
          "ja": "それにしても、お前は聞き上手だな……",
          "tc": "不過話說回來，你是個很棒的傾聽者……",
          "sc": "不过话说回来，你是个很棒的倾听者……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424432,
          "spk": "四郎治 (シロージ)",
          "ja": "キスケとは違う気安さがあって楽だ",
          "tc": "跟木助不同，但跟你在一起也很輕鬆。",
          "sc": "跟木助不同，但跟你在一起也很轻松。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 424443,
          "spk": "四郎治 (シロージ)",
          "ja": "これからはお前も、俺の部屋に",
          "tc": "你以後也可以隨時",
          "sc": "你以后也可以随时"
        },
        {
          "f_idx": 6,
          "pidx_tc": 424450,
          "spk": "四郎治 (シロージ)",
          "ja": "気軽に遊びに来ていいぜ",
          "tc": "來我的房間玩。",
          "sc": "来我的房间玩。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 424457,
          "spk": "四郎治 (シロージ)",
          "ja": "仲良くしてくれると嬉しいよ",
          "tc": "你願意跟我當朋友，我會很開心。",
          "sc": "你愿意跟我当朋友，我会很开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6932,
      "rec_id": "TALK_ID_70_2040_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424483,
          "spk": "四郎治 (シロージ)",
          "ja": "ああ、<player>",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6933,
      "rec_id": "TALK_ID_70_2040_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424503,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさんと一緒に",
          "tc": "我剛剛在跟四郎治哥",
          "sc": "我刚刚在跟四郎治哥"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424510,
          "spk": "堇怜 (スミレ)",
          "ja": "釣りをしてたんだ",
          "tc": "一起釣魚。",
          "sc": "一起钓鱼。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424521,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさんが大物を釣り上げて",
          "tc": "然後四郎治哥釣到了大條的，",
          "sc": "然后四郎治哥钓到了大条的，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424528,
          "spk": "堇怜 (スミレ)",
          "ja": "一匹譲ってもらったよ",
          "tc": "就讓了一條給我。",
          "sc": "就让了一条给我。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 424535,
          "spk": "堇怜 (スミレ)",
          "ja": "いいだろ？",
          "tc": "很棒對吧？",
          "sc": "很棒对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6934,
      "rec_id": "TALK_ID_70_2040_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424553,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、僕のほうが",
          "tc": "但其實要說起來，",
          "sc": "但其实要说起来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424560,
          "spk": "堇怜 (スミレ)",
          "ja": "よく釣りをしてるんだけどな",
          "tc": "我還比四郎治哥更常在釣魚。",
          "sc": "我还比四郎治哥更常在钓鱼。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6935,
      "rec_id": "TALK_ID_70_2040_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 424578,
          "spk": "堇怜 (スミレ)",
          "ja": "元狩人だから",
          "tc": "是因為他以前是獵人，",
          "sc": "是因为他以前是猎人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 424585,
          "spk": "堇怜 (スミレ)",
          "ja": "勘が鋭いんですかね……？",
          "tc": "所以直覺很敏銳嗎……？",
          "sc": "所以直觉很敏锐吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 424598,
          "spk": "四郎治 (シロージ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 424611,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさん？",
          "tc": "四郎治哥？",
          "sc": "四郎治哥？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6936,
      "rec_id": "TALK_ID_70_2040_004_05",
      "lines": [
        {
          "f_idx": 0,
