  "record_count": 47,
  "line_count": 199,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3090,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24041,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、今日の品評会は",
          "tc": "<player>，今天的評鑑會",
          "sc": "<player>，今天的评鉴会"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24048,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何も出さなかったんだねえ",
          "tc": "你都沒有報名參加啊。",
          "sc": "你都没有报名参加啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24059,
          "spk": "琪娜娜 (チナナ)",
          "ja": "残念だけど、仕方ないか",
          "tc": "真可惜，但也沒辦法。",
          "sc": "真可惜，但也没办法。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24066,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でも次こそは参加するんだろう？",
          "tc": "不過下次你一定會參加的吧？",
          "sc": "不过下次你一定会参加的吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24077,
          "spk": "琪娜娜 (チナナ)",
          "ja": "畑にうんと肥料を撒いて",
          "tc": "要在田裡多施肥，",
          "sc": "要在田里多施肥，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24084,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい作物を育てておくれよ",
          "tc": "種出優良的作物喔。",
          "sc": "种出优良的作物哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3091,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24108,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大したもんだね、<player>",
          "tc": "太厲害了，<player>，",
          "sc": "太厉害了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24115,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まさかSランクを取るなんてねえ",
          "tc": "你竟然獲得了S級的評價。",
          "sc": "你竟然获得了S级的评价。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、キミならそのうち",
          "tc": "不過我本來就知道",
          "sc": "不过我本来就知道"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やると思ってたよ",
          "tc": "你總有一天辦得到的。",
          "sc": "你总有一天办得到的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24140,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今夜はご馳走でも食べるといいよ",
          "tc": "今晚你就好好吃點美食吧。",
          "sc": "今晚你就好好吃点美食吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3092,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24164,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今回は残念だったねぇ",
          "tc": "這次真是遺憾呢。",
          "sc": "这次真是遗憾呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24171,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミが出品した作物も",
          "tc": "我覺得你拿去參賽的作物",
          "sc": "我觉得你拿去参赛的作物"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24178,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい線いってたと思うんだけど……",
          "tc": "已經很不錯了……",
          "sc": "已经很不错了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24189,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、次に期待だね！",
          "tc": "總之下一次再加油吧！",
          "sc": "总之下一次再加油吧！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24196,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あとちょっと改良すれば",
          "tc": "所以我想應該只要再稍微改良一下，",
          "sc": "所以我想应该只要再稍微改良一下，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24203,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっという間にSランクだよ",
          "tc": "一定馬上就能拿到S級了。",
          "sc": "一定马上就能拿到S级了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3093,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24227,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ？　ウチから買ってくれた家畜、",
          "tc": "咦？我本來很期待",
          "sc": "咦？我本来很期待"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24234,
          "spk": "琪娜娜 (チナナ)",
          "ja": "品評に出るのを楽しみにしていたんだけど……",
          "tc": "你會用跟我買的家畜參賽……",
          "sc": "你会用跟我买的家畜参赛……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24241,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今回はエントリーしなかったんだね",
          "tc": "原來你這次沒報名啊。",
          "sc": "原来你这次没报名啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24252,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>の晴れ舞台、",
          "tc": "那下次一定要好好讓我見識一下",
          "sc": "那下次一定要好好让我见识一下"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24259,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次こそは見せてほしいものだね",
          "tc": "<player>你的精彩表現喔。",
          "sc": "<player>你的精彩表现哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24266,
          "spk": "琪娜娜 (チナナ)",
          "ja": "期待してるよ",
          "tc": "我會好好期待的。",
          "sc": "我会好好期待的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3094,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24290,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お疲れ、<player>",
          "tc": "辛苦了，<player>。",
          "sc": "辛苦了，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミのおかげで、今日の品評会は",
          "tc": "多虧有你，今天的評鑑會",
          "sc": "多亏有你，今天的评鉴会"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24304,
          "spk": "琪娜娜 (チナナ)",
          "ja": "過去イチ面白いものになったよ",
          "tc": "是有史以來最有趣的一次。",
          "sc": "是有史以来最有趣的一次。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は<player>が",
          "tc": "今天<player>",
          "sc": "今天<player>"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "Sランク取ったって話で",
          "tc": "獲得了S級評價的話題，",
          "sc": "获得了S级评价的话题，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24329,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村中が持ちきりになるかもねえ",
          "tc": "應該會在村裡不斷被討論吧。",
          "sc": "应该会在村里不断被讨论吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3095,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0155",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24353,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ、ちょっと残念そうな顔してるね",
          "tc": "咦？你的表情看起來好像有點遺憾。",
          "sc": "咦？你的表情看起来好像有点遗憾。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24360,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっぱりSランクが取れなかったのが",
          "tc": "沒有拿到S級，",
          "sc": "没有拿到S级，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24367,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悔しいのかい？",
          "tc": "你果然還是很不甘心嗎？",
          "sc": "你果然还是很不甘心吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24378,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でもねえ、最高評価を",
          "tc": "不過呢，",
          "sc": "不过呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24385,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もらえなかったからって、",
          "tc": "沒獲得最高評價，",
          "sc": "没获得最高评价，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24392,
          "spk": "琪娜娜 (チナナ)",
          "ja": "エサ代が倍になるわけでもないし",
          "tc": "也不代表飼料費就會因此翻倍嘛。",
          "sc": "也不代表饲料费就会因此翻倍嘛。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 24403,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気持ちを切り替えて",
          "tc": "所以你就整理一下心情，",
          "sc": "所以你就整理一下心情，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 24410,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次の品評会を目指すことだね",
          "tc": "準備參加下一次的評鑑會吧。",
          "sc": "准备参加下一次的评鉴会吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3096,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24441,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は<player>、",
          "tc": "今天<player>",
          "sc": "今天<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24448,
          "spk": "琪娜娜 (チナナ)",
          "ja": "エントリーを見送ったんだね",
          "tc": "沒有報名啊。",
          "sc": "没有报名啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24459,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、馬の大きな体を",
          "tc": "不過要把馬那麼龐大的身軀",
          "sc": "不过要把马那么庞大的身躯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24466,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ピカピカに磨くのは",
          "tc": "刷得乾乾淨淨的，",
          "sc": "刷得干干净净的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24473,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けっこうな重労働だろうしね",
          "tc": "的確會是一樁辛苦的差事。",
          "sc": "的确会是一桩辛苦的差事。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24484,
          "spk": "琪娜娜 (チナナ)",
          "ja": "エントリーするのは",
          "tc": "如果要報名，",
          "sc": "如果要报名，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 24491,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミと馬の体力がちゃんと",
          "tc": "或許還是等你和馬",
          "sc": "或许还是等你和马"
        },
        {
          "f_idx": 7,
          "pidx_tc": 24498,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ある時がいいかもしれないねえ",
          "tc": "都有體力的時候會比較好吧。",
          "sc": "都有体力的时候会比较好吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3097,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24522,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やったね、<player>",
          "tc": "太好了，<player>，",
          "sc": "太好了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24529,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見事にSランクを勝ち取ったじゃないか",
          "tc": "你贏得了S級評價了呢。",
          "sc": "你赢得了S级评价了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24540,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ここまで時間がかかっただろう？",
          "tc": "你是耗費了很多時間才走到這裡的對吧？",
          "sc": "你是耗费了很多时间才走到这里的对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは感動しちゃったよ",
          "tc": "我好感動啊，",
          "sc": "我好感动啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24554,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいもん見せてくれてありがとうね",
          "tc": "謝謝你讓我見證了這麼精彩的評鑑會。",
          "sc": "谢谢你让我见证了这么精彩的评鉴会。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3098,
      "rec_id": "TALK_ID_STREET_VENDOR_HOLIDAY_20_114_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24578,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お疲れさん、<player>",
          "tc": "辛苦了，<player>，",
          "sc": "辛苦了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24585,
          "spk": "琪娜娜 (チナナ)",
          "ja": "品評会ちゃんと見てたよ",
          "tc": "我看了評鑑會了喔。",
          "sc": "我看了评鉴会了哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24596,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミの馬、惜しかったねえ",
          "tc": "你的馬好可惜啊，",
          "sc": "你的马好可惜啊，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24603,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あとちょっとで評価が",
          "tc": "看起來只差一點",
          "sc": "看起来只差一点"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24610,
          "spk": "琪娜娜 (チナナ)",
          "ja": "上がりそうに見えたよ",
          "tc": "就能獲得更好的評價了。",
          "sc": "就能获得更好的评价了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24621,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ま、今日はゆっくりと",
          "tc": "今天就讓馬",
          "sc": "今天就让马"
        },
        {
          "f_idx": 6,
          "pidx_tc": 24628,
          "spk": "琪娜娜 (チナナ)",
          "ja": "馬を休ませてあげることだね",
          "tc": "好好地休息吧。",
          "sc": "好好地休息吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3099,
      "rec_id": "TALK_ID_STREET_VENDOR_PRESENT_20_114_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 24652,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……おお～？",
          "tc": "……哦～？",
          "sc": "……哦～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 24659,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これ、ウチにくれるの？",
          "tc": "這是要給我的嗎？",
          "sc": "这是要给我的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 24670,
          "spk": "琪娜娜 (チナナ)",
          "ja": "すごいね、<player>",
          "tc": "你太厲害了，<player>，",
          "sc": "你太厉害了，<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 24677,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こいつの価値がわかる人は",
          "tc": "能知道這東西價值的人",
          "sc": "能知道这东西价值的人"
        },
        {
          "f_idx": 4,
          "pidx_tc": 24684,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あまりいないんだよ",
          "tc": "可不多啊。",
          "sc": "可不多啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 24695,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しかも、ウチの大好物ときたもんだ",
          "tc": "而且這是我的最愛耶。",
          "sc": "而且这是我的最爱呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 24702,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……お？ その顔は、もしかしなくても",
          "tc": "……哦？看你的表情，",
          "sc": "……哦？看你的表情，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 24709,
          "spk": "琪娜娜 (チナナ)",
          "ja": "知ってて選んでくれたね？",
          "tc": "莫非你是知道這件事，才特地幫我選的？",
          "sc": "莫非你是知道这件事，才特地帮我选的？"
        },
        {
