          "pidx_tc": 25587,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……まあ、いいか、放っておいても",
          "tc": "……算了，反正放著不管，",
          "sc": "……算了，反正放着不管，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 25594,
          "spk": "琪娜娜 (チナナ)",
          "ja": "晴れたらまた乾くだろう",
          "tc": "等出太陽之後再曬過就會乾了吧。",
          "sc": "等出太阳之后再晒过就会干了吧。"
        }
      ]
    },
    {
