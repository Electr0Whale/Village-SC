        },
        {
          "f_idx": 2,
          "pidx_tc": 156028,
          "spk": "莲实 (ハスミ)",
          "ja": "急な話でしたし、気になさらないでください",
          "tc": "不過畢竟事出突然，所以還請你不要放在心上。",
