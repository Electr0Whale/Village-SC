    {
      "file": "talk.dat",
      "rec_idx": 2874,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_SPECIAL_20_113_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 155610,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さん",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 155617,
          "spk": "莲实 (ハスミ)",
          "ja": "少し気になっていたのでお尋ねしますけど",
          "tc": "因為我有點在意，所以想請教一下，",
          "sc": "因为我有点在意，所以想请教一下，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 155624,
          "spk": "莲实 (ハスミ)",
          "ja": "お野菜もちゃんと摂っていますか？",
          "tc": "請問你有好好在攝取蔬菜嗎？",
          "sc": "请问你有好好在摄取蔬菜吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 155635,
          "spk": "莲实 (ハスミ)",
          "ja": "不足しているようでしたら",
          "tc": "如果覺得攝取得不足的話，",
          "sc": "如果觉得摄取得不足的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 155642,
          "spk": "莲实 (ハスミ)",
          "ja": "「アスパラサラダ」のレシピをお渡ししますから",
          "tc": "我將這份「蘆筍沙拉」的食譜交給你，",
          "sc": "我将这份“芦笋沙拉”的食谱交给你，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 155649,
          "spk": "莲实 (ハスミ)",
          "ja": "活用してみてください",
          "tc": "請你要多加善用喔。",
          "sc": "请你要多加善用哦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 155660,
          "spk": "莲实 (ハスミ)",
          "ja": "簡単でありながらおいしいので",
          "tc": "這道料理雖然作法簡單卻很美味，",
          "sc": "这道料理虽然作法简单却很美味，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 155667,
          "spk": "莲实 (ハスミ)",
          "ja": "きっと気に入ってもらえると思いますよ",
          "tc": "相信你一定會喜歡的。",
          "sc": "相信你一定会喜欢的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 155678,
          "spk": "莲实 (ハスミ)",
          "ja": "アスパラガスは疲労回復効果や",
          "tc": "蘆筍擁有能夠恢復疲勞",
          "sc": "芦笋拥有能够恢复疲劳"
        },
        {
          "f_idx": 9,
          "pidx_tc": 155685,
          "spk": "莲实 (ハスミ)",
          "ja": "免疫力を高めてくれる効果もあって",
          "tc": "以及提高免疫力的效果，",
          "sc": "以及提高免疫力的效果，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 155692,
          "spk": "莲实 (ハスミ)",
          "ja": "体にもいい食材なんです",
          "tc": "是對身體很好的食材。",
          "sc": "是对身体很好的食材。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2875,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_SPECIAL_20_113_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 155734,
          "spk": "莲实 (ハスミ)",
          "ja": "あ、<player>さん",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 155741,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんって",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 155748,
          "spk": "莲实 (ハスミ)",
          "ja": "お茶に興味あったりしますか？",
          "tc": "請問你對茶有興趣嗎？",
          "sc": "请问你对茶有兴趣吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 155759,
          "spk": "莲实 (ハスミ)",
          "ja": "もしよければ「ほうじ茶セット」を",
          "tc": "如果不嫌棄的話，我把這「焙茶套組」送給你，",
          "sc": "如果不嫌弃的话，我把这“焙茶套组”送给你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 155766,
          "spk": "莲实 (ハスミ)",
          "ja": "お渡ししますから、試してください",
          "tc": "請你試著泡泡看吧。",
          "sc": "请你试着泡泡看吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 155777,
          "spk": "莲实 (ハスミ)",
          "ja": "ほうじ茶はいいです……",
          "tc": "焙茶是很棒的東西……",
          "sc": "焙茶是很棒的东西……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 155784,
          "spk": "莲实 (ハスミ)",
          "ja": "多くの健康効果が期待できますし",
          "tc": "不僅對身體各方面都非常健康，",
          "sc": "不仅对身体各方面都非常健康，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 155791,
          "spk": "莲实 (ハスミ)",
          "ja": "リラックス効果もある、とても優れた飲み物です",
          "tc": "也擁有放鬆身心的效果，是很優秀的飲品。",
          "sc": "也拥有放松身心的效果，是很优秀的饮品。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 155802,
          "spk": "莲实 (ハスミ)",
          "ja": "私も長年ほうじ茶を愛用していて",
          "tc": "我長年都在喝焙茶，",
          "sc": "我长年都在喝焙茶，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 155809,
          "spk": "莲实 (ハスミ)",
          "ja": "もはや生活の一部といっていいくらい……",
          "tc": "可以說是已經成為生活的一部分了……",
          "sc": "可以说是已经成为生活的一部分了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 155816,
          "spk": "莲实 (ハスミ)",
          "ja": "二日酔いの時にも、よくお世話になってます",
          "tc": "而且我宿醉的時候，也經常用焙茶來醒酒呢。",
          "sc": "而且我宿醉的时候，也经常用焙茶来醒酒呢。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 155827,
          "spk": "莲实 (ハスミ)",
          "ja": "とまあ、いいこと尽くめのお茶ですから",
          "tc": "總之，這種茶好處多多，",
          "sc": "总之，这种茶好处多多，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 155834,
          "spk": "莲实 (ハスミ)",
          "ja": "ぜひとも飲んでみてくださいね",
          "tc": "請你務必喝喝看喔。",
          "sc": "请你务必喝喝看哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2876,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_SPECIAL_20_113_0070",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 155865,
          "spk": "莲实 (ハスミ)",
          "ja": "あら、<player>さん",
          "tc": "哎呀，<player>，",
          "sc": "哎呀，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 155872,
          "spk": "莲实 (ハスミ)",
          "ja": "あなたの方から来てくださるなんて",
          "tc": "沒想到你會來拜訪。",
          "sc": "没想到你会来拜访。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 155883,
          "spk": "莲实 (ハスミ)",
          "ja": "おいしい食事を用意して",
          "tc": "我正好想著要準備點",
          "sc": "我正好想着要准备点"
        },
        {
          "f_idx": 3,
          "pidx_tc": 155890,
          "spk": "莲实 (ハスミ)",
          "ja": "おもてなしでも、と考えていたんです",
          "tc": "可口的食物招待你呢。",
          "sc": "可口的食物招待你呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 155908,
          "spk": "莲实 (ハスミ)",
          "ja": "時間はそうですね……",
          "tc": "時間的話……",
          "sc": "时间的话……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 155915,
          "spk": "莲实 (ハスミ)",
          "ja": "落ち着いた頃がいいので、午後６時とか？",
          "tc": "約比較沒那麼忙的晚上6點如何？",
          "sc": "约比较没那么忙的晚上6点如何？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 155922,
          "spk": "莲实 (ハスミ)",
          "ja": "ご都合よろしいでしょうか？",
          "tc": "請問這時間你還方便嗎？",
          "sc": "请问这时间你还方便吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 155931,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 155938,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
