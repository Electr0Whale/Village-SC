      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 155956,
          "spk": "莲实 (ハスミ)",
          "ja": "そうですか……よかったです",
          "tc": "是嗎……太好了。",
          "sc": "是吗……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 155963,
          "spk": "莲实 (ハスミ)",
          "ja": "いい返事をもらえて、ホッとしました",
          "tc": "你願意來，讓我鬆了一口氣呢。",
          "sc": "你愿意来，让我松了一口气呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 155974,
          "spk": "莲实 (ハスミ)",
          "ja": "それじゃあ、午後６時に私の部屋まで",
          "tc": "那麼就請你在晚上6點的時候到我的房間來吧，",
          "sc": "那么就请你在晚上6点的时候到我的房间来吧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 155981,
          "spk": "莲实 (ハスミ)",
          "ja": "いらしてください、楽しみに待ってます",
          "tc": "我會期待地等著你的到來的。",
          "sc": "我会期待地等着你的到来的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2878,
      "rec_id": "TALK_ID_FEMALE_DOCTOR_SPECIAL_20_113_0072",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 156010,
          "spk": "莲实 (ハスミ)",
          "ja": "ご都合があわないみたいですね",
          "tc": "看來你不太方便呢。",
