      "rec_id": "TALK_ID_FEMALE_DOCTOR_SPECIAL_20_113_0082",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 156204,
          "spk": "莲实 (ハスミ)",
          "ja": "……私の部屋に来るのが嫌とか",
