      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 156157,
          "spk": "莲实 (ハスミ)",
          "ja": "急なお誘いでしたが",
          "tc": "明明是很突然的邀約，",
          "sc": "明明是很突然的邀约，"
        },
        {
          "f_idx": 1,
