        {
          "f_idx": 11,
          "pidx_tc": 443582,
          "spk": "堇怜 (スミレ)",
          "ja": "手に職があって偉いよなあ",
          "tc": "真佩服她有一技之長呢。",
          "sc": "真佩服她有一技之长呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 443598,
          "spk": "堇怜 (スミレ)",
          "ja": "リンも……",
          "tc": "林也是……",
          "sc": "林也是……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 443605,
          "spk": "堇怜 (スミレ)",
          "ja": "どうかと思うところはあるけど",
          "tc": "雖然有讓人不敢恭維的地方，",
          "sc": "虽然有让人不敢恭维的地方，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 443612,
          "spk": "堇怜 (スミレ)",
          "ja": "村長をやってるなんて偉いと思うよ",
          "tc": "但能擔任村長還是很厲害。",
          "sc": "但能担任村长还是很厉害。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 443623,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も、将来はちゃんと、",
          "tc": "我將來是不是也能",
          "sc": "我将来是不是也能"
        },
        {
          "f_idx": 17,
          "pidx_tc": 443630,
          "spk": "堇怜 (スミレ)",
          "ja": "立派な大人になれるのかな？",
          "tc": "成為出色的大人呢？",
          "sc": "成为出色的大人呢？"
        },
        {
