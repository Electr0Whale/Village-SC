      "rec_id": "TALK_ID_70_2130_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442597,
          "spk": "堇怜 (スミレ)",
          "ja": "すごいよ、立派な魚だ！",
          "tc": "太棒了，好大的魚！",
          "sc": "太棒了，好大的鱼！"
