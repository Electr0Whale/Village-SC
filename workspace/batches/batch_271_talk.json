      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437213,
          "spk": "裕太 (ユータ)",
          "ja": "時間がいくらあっても足りないよ",
          "tc": "時間再多都不夠用啊，",
          "sc": "时间再多都不够用啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437220,
          "spk": "裕太 (ユータ)",
          "ja": "もちろん<player>と",
          "tc": "更不用說我也想找時間",
          "sc": "更不用说我也想找时间"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437227,
          "spk": "裕太 (ユータ)",
          "ja": "遊ぶ時間だって欲しいしね",
          "tc": "跟<player>一起玩了。",
          "sc": "跟<player>一起玩了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437238,
          "spk": "裕太 (ユータ)",
          "ja": "でも今日はバードウォッチングの",
          "tc": "不過今天是我賞鳥的日子，",
          "sc": "不过今天是我赏鸟的日子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437245,
          "spk": "裕太 (ユータ)",
          "ja": "日だから、また遊ぼうよ",
          "tc": "所以我們改天再一起玩吧。",
          "sc": "所以我们改天再一起玩吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7627,
      "rec_id": "TALK_ID_70_2120_001_12",
      "lines": [
        {
