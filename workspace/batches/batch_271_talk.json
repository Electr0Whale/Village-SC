      "rec_id": "TALK_ID_70_2120_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437347,
          "spk": "裕太 (ユータ)",
          "ja": "どう？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437354,
          "spk": "裕太 (ユータ)",
          "ja": "いい出来でしょ？",
          "tc": "做得很好吧？",
          "sc": "做得很好吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437367,
          "spk": "木助 (キスケ)",
          "ja": "どこがだ",
          "tc": "哪裡好？",
          "sc": "哪里好？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437378,
          "spk": "木助 (キスケ)",
          "ja": "水平器使わなくても",
          "tc": "就算不用水平儀，",
          "sc": "就算不用水平仪，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437385,
          "spk": "木助 (キスケ)",
          "ja": "ガタついてんのが",
          "tc": "我也一眼就看得出",
          "sc": "我也一眼就看得出"
        },
        {
          "f_idx": 5,
          "pidx_tc": 437392,
          "spk": "木助 (キスケ)",
          "ja": "丸わかりじゃねぇか",
          "tc": "它根本就不穩！",
          "sc": "它根本就不稳！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437405,
          "spk": "裕太 (ユータ)",
          "ja": "えっ……そうかな？",
          "tc": "咦……是這樣嗎？",
          "sc": "咦……是这样吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437418,
          "spk": "木助 (キスケ)",
          "ja": "わかったら帰れ",
          "tc": "知道了就快滾，",
          "sc": "知道了就快滚，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437425,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "先走啦。",
          "sc": "先走啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7630,
      "rec_id": "TALK_ID_70_2120_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437447,
          "spk": "裕太 (ユータ)",
          "ja": "そんな……",
          "tc": "怎麼這樣……",
          "sc": "怎么这样……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437454,
          "spk": "裕太 (ユータ)",
          "ja": "自信あったのにな……",
          "tc": "我明明很有自信的說……",
          "sc": "我明明很有自信的说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7631,
      "rec_id": "TALK_ID_70_2120_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437478,
          "spk": "裕太 (ユータ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>。",
          "sc": "啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437485,
