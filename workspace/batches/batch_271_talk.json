      "rec_id": "TALK_ID_70_2130_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441505,
          "spk": "莲实 (ハスミ)",
          "ja": "そんな危険よ……",
          "tc": "那樣太危險了……",
          "sc": "那样太危险了……"
