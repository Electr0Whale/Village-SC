        {
          "f_idx": 2,
          "pidx_tc": 441603,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ戻ろうか……",
          "tc": "差不多該回去……",
          "sc": "差不多该回去……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7705,
      "rec_id": "TALK_ID_70_2130_004_08",
      "lines": [
        {
