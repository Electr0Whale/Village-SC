    },
    {
      "file": "talk.dat",
      "rec_idx": 7638,
      "rec_id": "TALK_ID_70_2120_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437973,
          "spk": "裕太 (ユータ)",
          "ja": "あれ……<player>？",
          "tc": "咦……<player>？",
          "sc": "咦……<player>？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437984,
          "spk": "裕太 (ユータ)",
          "ja": "……もしかして",
          "tc": "……難道說",
          "sc": "……难道说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437991,
          "spk": "裕太 (ユータ)",
          "ja": "聞こえてた？",
          "tc": "你都聽到了？",
          "sc": "你都听到了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7639,
      "rec_id": "TALK_ID_70_2120_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438015,
          "spk": "裕太 (ユータ)",
          "ja": "そっか",
          "tc": "是喔。",
          "sc": "是哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438022,
          "spk": "裕太 (ユータ)",
          "ja": "聞こえてたか",
          "tc": "都被你聽到了啊。",
          "sc": "都被你听到了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438033,
          "spk": "裕太 (ユータ)",
          "ja": "今のは……生存報告だよ",
          "tc": "我剛剛……是在報告近況。",
          "sc": "我刚刚……是在报告近况。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438040,
          "spk": "裕太 (ユータ)",
          "ja": "行方不明届を出されると",
          "tc": "如果家人報警說我失蹤了，",
          "sc": "如果家人报警说我失踪了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438047,
          "spk": "裕太 (ユータ)",
          "ja": "さすがに困るからね",
          "tc": "我還是會有點困擾的。",
          "sc": "我还是会有点困扰的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7640,
      "rec_id": "TALK_ID_70_2120_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438065,
          "spk": "裕太 (ユータ)",
          "ja": "この村には、家とか仕事を",
          "tc": "畢竟我當初",
          "sc": "毕竟我当初"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438072,
          "spk": "裕太 (ユータ)",
          "ja": "ほとんど放り出して",
          "tc": "算是直接丟下了家人和工作，",
          "sc": "算是直接丢下了家人和工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438079,
          "spk": "裕太 (ユータ)",
          "ja": "転がり込んだようなものだから",
          "tc": "然後投奔到了這個村子裡來。",
          "sc": "然后投奔到了这个村子里来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438088,
          "spk": "裕太 (ユータ)",
          "ja": "生存報告だけは",
          "tc": "所以我才想說，",
          "sc": "所以我才想说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438095,
          "spk": "裕太 (ユータ)",
          "ja": "たまに家族に",
          "tc": "至少偶爾",
          "sc": "至少偶尔"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438102,
          "spk": "裕太 (ユータ)",
          "ja": "入れるようにしてるんだ",
          "tc": "要跟家人報個平安。",
          "sc": "要跟家人报个平安。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7641,
      "rec_id": "TALK_ID_70_2120_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438120,
          "spk": "裕太 (ユータ)",
          "ja": "うーん……どうして",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438127,
          "spk": "裕太 (ユータ)",
          "ja": "放り出したんだろうね",
          "tc": "我當初到底為什麼會拋下一切呢？",
          "sc": "我当初到底为什么会抛下一切呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438138,
          "spk": "裕太 (ユータ)",
          "ja": "多分、俺は",
          "tc": "我想，",
          "sc": "我想，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438145,
          "spk": "裕太 (ユータ)",
          "ja": "逃げたんだよ",
          "tc": "我大概是在逃避吧。",
          "sc": "我大概是在逃避吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438156,
          "spk": "裕太 (ユータ)",
          "ja": "……違うな",
          "tc": "……不對，",
          "sc": "……不对，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438163,
          "spk": "裕太 (ユータ)",
          "ja": "捨てたのかな",
          "tc": "應該是說我捨棄了一切吧。",
          "sc": "应该是说我舍弃了一切吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438174,
          "spk": "裕太 (ユータ)",
          "ja": "いや、嫌いに",
          "tc": "不，",
          "sc": "不，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438181,
          "spk": "裕太 (ユータ)",
          "ja": "なったのかもしれない",
          "tc": "或許是我對一切感到了厭煩？",
          "sc": "或许是我对一切感到了厌烦？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438192,
          "spk": "裕太 (ユータ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 438199,
          "spk": "裕太 (ユータ)",
          "ja": "……正直なところ",
          "tc": "……老實說，",
          "sc": "……老实说，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 438206,
          "spk": "裕太 (ユータ)",
          "ja": "よくわからないんだ",
          "tc": "我自己也不太清楚。",
          "sc": "我自己也不太清楚。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 438217,
          "spk": "裕太 (ユータ)",
          "ja": "……驚いたな",
          "tc": "……真是令我感到驚訝。",
          "sc": "……真是令我感到惊讶。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7642,
      "rec_id": "TALK_ID_70_2120_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438235,
          "spk": "裕太 (ユータ)",
          "ja": "こんな話、村に来てから",
          "tc": "自從我來到這個村子之後，",
          "sc": "自从我来到这个村子之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438242,
          "spk": "裕太 (ユータ)",
          "ja": "一度もしたことなかったのに",
          "tc": "從來也沒有跟任何人聊過這個話題。",
          "sc": "从来也没有跟任何人聊过这个话题。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438251,
          "spk": "裕太 (ユータ)",
          "ja": "特に隠してたつもりもないけど",
          "tc": "雖然我也沒有特意要隱瞞，",
          "sc": "虽然我也没有特意要隐瞒，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438258,
          "spk": "裕太 (ユータ)",
          "ja": "こんなに自然に話すことに",
          "tc": "但沒想到我竟然可以聊這個話題",
          "sc": "但没想到我竟然可以聊这个话题"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438265,
          "spk": "裕太 (ユータ)",
          "ja": "なるとは思わなかったよ",
          "tc": "聊得這麼自然。",
          "sc": "聊得这么自然。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438276,
          "spk": "裕太 (ユータ)",
          "ja": "……もしかしたら俺は",
          "tc": "……難道說，",
          "sc": "……难道说，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438283,
          "spk": "裕太 (ユータ)",
          "ja": "誰かに聞いてもらいたかったのかな",
          "tc": "我其實是想找人訴說的嗎？",
          "sc": "我其实是想找人诉说的吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438294,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっとスッキリしたよ",
          "tc": "謝謝你願意聽我說，",
          "sc": "谢谢你愿意听我说，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438301,
          "spk": "裕太 (ユータ)",
          "ja": "聞いてくれてありがとう",
          "tc": "我感覺好像輕鬆了點。",
          "sc": "我感觉好像轻松了点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7643,
      "rec_id": "TALK_ID_70_2120_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438319,
          "spk": "裕太 (ユータ)",
          "ja": "ねえ、こういう話をすると",
          "tc": "對了，我曾經聽說過，",
          "sc": "对了，我曾经听说过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438326,
          "spk": "裕太 (ユータ)",
          "ja": "相手に親近感が湧きやすいって",
          "tc": "聊這種話題，",
          "sc": "聊这种话题，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438333,
          "spk": "裕太 (ユータ)",
          "ja": "聞いたことがあるよ",
          "tc": "很容易就能跟對方拉近距離。",
          "sc": "很容易就能跟对方拉近距离。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438344,
          "spk": "裕太 (ユータ)",
          "ja": "せっかくだからさ",
          "tc": "機會難得，",
          "sc": "机会难得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438351,
          "spk": "裕太 (ユータ)",
          "ja": "俺、キミの話も",
          "tc": "我也想聽你說說",
          "sc": "我也想听你说说"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438358,
          "spk": "裕太 (ユータ)",
          "ja": "聞いてみたいな",
          "tc": "關於你自己的事。",
          "sc": "关于你自己的事。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438369,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も何か",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438376,
          "spk": "裕太 (ユータ)",
          "ja": "今まで誰にもしたことの",
          "tc": "你也跟我說一些",
          "sc": "你也跟我说一些"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438383,
          "spk": "裕太 (ユータ)",
          "ja": "ない話をしてみてよ",
          "tc": "你從來都沒有對別人提過的事情吧。",
          "sc": "你从来都没有对别人提过的事情吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 438392,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯。",
          "sc": "嗯。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 438399,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7644,
      "rec_id": "TALK_ID_70_2120_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438502,
          "spk": "裕太 (ユータ)",
          "ja": "あっ……ごめん",
          "tc": "啊……抱歉，",
          "sc": "啊……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438509,
          "spk": "裕太 (ユータ)",
          "ja": "悩ませちゃったか",
          "tc": "我是不是讓你很困擾？",
          "sc": "我是不是让你很困扰？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438520,
          "spk": "裕太 (ユータ)",
          "ja": "こういう話って",
          "tc": "這種話題，",
          "sc": "这种话题，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438527,
          "spk": "裕太 (ユータ)",
          "ja": "ねだるものじゃないよね",
          "tc": "的確不應該去要求別人說出口呢，",
          "sc": "的确不应该去要求别人说出口呢，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438534,
          "spk": "裕太 (ユータ)",
          "ja": "ごめんごめん",
          "tc": "抱歉抱歉。",
          "sc": "抱歉抱歉。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438545,
          "spk": "裕太 (ユータ)",
          "ja": "俺があんまり自然に話せたから",
          "tc": "都是因為我自己輕輕鬆鬆地就說出來了，",
          "sc": "都是因为我自己轻轻松松地就说出来了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438552,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっとテンション上がっちゃって",
          "tc": "所以才有點興奮。",
          "sc": "所以才有点兴奋。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 438561,
          "spk": "裕太 (ユータ)",
          "ja": "無理にひねり出さなくて",
          "tc": "你不用勉強你自己的，",
          "sc": "你不用勉强你自己的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438568,
          "spk": "裕太 (ユータ)",
          "ja": "いいからさ、気にしないでよ",
          "tc": "別放在心上喔。",
          "sc": "别放在心上哦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 438579,
          "spk": "裕太 (ユータ)",
          "ja": "とにかく、俺が言いたかったのは",
          "tc": "總之，我想表達的是，",
          "sc": "总之，我想表达的是，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 438586,
          "spk": "裕太 (ユータ)",
          "ja": "キミともっと仲良くしたいって",
          "tc": "我希望我可以",
          "sc": "我希望我可以"
        },
        {
          "f_idx": 11,
          "pidx_tc": 438593,
          "spk": "裕太 (ユータ)",
          "ja": "思ったってことなんだ",
          "tc": "跟你變得更要好。",
          "sc": "跟你变得更要好。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 438604,
          "spk": "裕太 (ユータ)",
          "ja": "俺の家なら、いつ来てくれてもいいからさ",
          "tc": "我家的大門隨時都會為你敞開，",
          "sc": "我家的大门随时都会为你敞开，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 438611,
          "spk": "裕太 (ユータ)",
          "ja": "これからは、もっと気軽に遊びにおいでよ",
          "tc": "以後記得要常常來找我玩喔。",
          "sc": "以后记得要常常来找我玩哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7645,
      "rec_id": "TALK_ID_70_2120_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438635,
          "spk": "裕太 (ユータ)",
          "ja": "あっ",
          "tc": "啊，",
          "sc": "啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438646,
          "spk": "裕太 (ユータ)",
          "ja": "……変なところ",
          "tc": "……被你看到",
          "sc": "……被你看到"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438653,
          "spk": "裕太 (ユータ)",
          "ja": "見られちゃったな",
          "tc": "我奇怪的樣子了。",
          "sc": "我奇怪的样子了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7646,
      "rec_id": "TALK_ID_70_2120_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 438677,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっとね……",
          "tc": "其實……",
          "sc": "其实……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 438684,
          "spk": "裕太 (ユータ)",
          "ja": "あの廃屋を探してたんだ",
          "tc": "我在找那間廢棄屋子。",
          "sc": "我在找那间废弃屋子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 438695,
          "spk": "裕太 (ユータ)",
          "ja": "あそこで見たことが、",
          "tc": "我有時候會想，",
          "sc": "我有时候会想，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 438702,
          "spk": "裕太 (ユータ)",
          "ja": "全部夢だったんじゃないかって",
          "tc": "自己在那間房子裡看到的，",
          "sc": "自己在那间房子里看到的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 438709,
          "spk": "裕太 (ユータ)",
          "ja": "思う時があってね",
          "tc": "會不會其實都是一場夢。",
          "sc": "会不会其实都是一场梦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 438720,
          "spk": "裕太 (ユータ)",
          "ja": "……いてもたってもいられなくて",
          "tc": "……所以我偶爾會感到坐立難安，",
          "sc": "……所以我偶尔会感到坐立难安，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 438727,
          "spk": "裕太 (ユータ)",
          "ja": "たまに、探してしまうんだ",
          "tc": "這種時候就會出來找那間房子。",
          "sc": "这种时候就会出来找那间房子。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 438743,
          "spk": "裕太 (ユータ)",
          "ja": "あれは夢なんかじゃないし、",
          "tc": "那並不是在作夢，",
          "sc": "那并不是在作梦，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 438750,
          "spk": "裕太 (ユータ)",
          "ja": "もう歌も鳴り止んだから、",
          "tc": "但歌聲已經停止了，",
          "sc": "但歌声已经停止了，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 438757,
          "spk": "裕太 (ユータ)",
          "ja": "俺一人じゃ見つけられない……",
          "tc": "我自己一個人是找不到的……",
