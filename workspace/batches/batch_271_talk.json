        {
          "f_idx": 1,
          "pidx_tc": 437270,
          "spk": "裕太 (ユータ)",
          "ja": "鳥を見つけるぞ",
          "tc": "來繼續找更多鳥吧！",
          "sc": "来继续找更多鸟吧！"
        }
      ]
    },
    {
