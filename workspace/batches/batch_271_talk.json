        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7635,
      "rec_id": "TALK_ID_70_2120_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437830,
          "spk": "木助 (キスケ)",
          "ja": "きっかけは確かに",
          "tc": "雖然契機",
          "sc": "虽然契机"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437837,
          "spk": "木助 (キスケ)",
          "ja": "俺だったかもしんねぇよ",
          "tc": "的確算是我給的。",
          "sc": "的确算是我给的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437846,
          "spk": "木助 (キスケ)",
          "ja": "けど、リスト作って",
          "tc": "但是寫了清單，",
          "sc": "但是写了清单，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437853,
          "spk": "木助 (キスケ)",
          "ja": "生き生きとしてんのは",
          "tc": "讓自己變得這樣活蹦亂跳的，",
          "sc": "让自己变得这样活蹦乱跳的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437860,
          "spk": "木助 (キスケ)",
          "ja": "あいつ自身の力だろ",
          "tc": "是那傢伙自己的功勞啊。",
          "sc": "是那家伙自己的功劳啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7636,
      "rec_id": "TALK_ID_70_2120_002_09",
      "lines": [
