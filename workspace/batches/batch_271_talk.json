      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441453,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんは休んでて……",
          "tc": "姊姊妳先好好休息……",
          "sc": "姐姐你先好好休息……"
