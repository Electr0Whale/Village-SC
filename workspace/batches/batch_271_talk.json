          "ja": "このブックシェルフ",
          "tc": "你覺得這個書架",
          "sc": "你觉得这个书架"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437492,
          "spk": "裕太 (ユータ)",
          "ja": "ガタついて見える？",
          "tc": "看起來很不穩嗎？",
          "sc": "看起来很不稳吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7632,
      "rec_id": "TALK_ID_70_2120_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437510,
          "spk": "裕太 (ユータ)",
          "ja": "はあ……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437517,
          "spk": "裕太 (ユータ)",
          "ja": "そうか……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437528,
          "spk": "裕太 (ユータ)",
          "ja": "先輩の役に立ちたいのに",
          "tc": "我很想幫學長的忙，",
          "sc": "我很想帮学长的忙，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437535,
          "spk": "裕太 (ユータ)",
          "ja": "上手くいかないな",
          "tc": "卻一直都做不好。",
          "sc": "却一直都做不好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7633,
      "rec_id": "TALK_ID_70_2120_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437560,
          "spk": "裕太 (ユータ)",
          "ja": "あ、そうか",
          "tc": "啊，對喔，",
          "sc": "啊，对哦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437567,
          "spk": "裕太 (ユータ)",
          "ja": "ちゃんと説明したことって",
          "tc": "我好像還沒跟你",
          "sc": "我好像还没跟你"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437574,
          "spk": "裕太 (ユータ)",
          "ja": "なかったかもね",
          "tc": "好好說明過呢。",
          "sc": "好好说明过呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437585,
          "spk": "裕太 (ユータ)",
          "ja": "キスケさんは",
          "tc": "木助學長",
          "sc": "木助学长"
        },
        {
          "f_idx": 4,
          "pidx_tc": 437592,
          "spk": "裕太 (ユータ)",
          "ja": "大学の先輩でね",
          "tc": "是我大學的學長，",
          "sc": "是我大学的学长，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 437601,
          "spk": "裕太 (ユータ)",
          "ja": "俺をこの村に",
          "tc": "也是邀請我",
          "sc": "也是邀请我"
        },
        {
          "f_idx": 6,
          "pidx_tc": 437608,
          "spk": "裕太 (ユータ)",
          "ja": "誘ってくれた人なんだ",
          "tc": "來這個村子裡住的人。",
          "sc": "来这个村子里住的人。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 437619,
          "spk": "裕太 (ユータ)",
          "ja": "俺としては、すごく",
          "tc": "我對他只有",
          "sc": "我对他只有"
        },
        {
          "f_idx": 8,
          "pidx_tc": 437626,
          "spk": "裕太 (ユータ)",
          "ja": "恩を感じてるんだよ",
          "tc": "無盡的感激。",
          "sc": "无尽的感激。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 437637,
          "spk": "裕太 (ユータ)",
          "ja": "だから仕事を手伝いたいんだけど",
          "tc": "所以我才會想協助他的工作。",
          "sc": "所以我才会想协助他的工作。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 437644,
          "spk": "裕太 (ユータ)",
          "ja": "村に来てすぐの頃、試用期間で",
          "tc": "但我在剛搬來村子的時候，",
          "sc": "但我在刚搬来村子的时候，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 437651,
          "spk": "裕太 (ユータ)",
          "ja": "いろいろと失敗しちゃって……",
          "tc": "在試用期間搞砸了很多事……",
          "sc": "在试用期间搞砸了很多事……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 437662,
          "spk": "裕太 (ユータ)",
          "ja": "もう手伝いはいらないって",
          "tc": "所以他就說",
          "sc": "所以他就说"
        },
        {
          "f_idx": 13,
          "pidx_tc": 437669,
          "spk": "裕太 (ユータ)",
          "ja": "言われちゃったんだよね",
          "tc": "不需要我幫忙了。",
          "sc": "不需要我帮忙了。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 437685,
          "spk": "裕太 (ユータ)",
          "ja": "それからは自分なりに",
          "tc": "從那之後，",
          "sc": "从那之后，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 437692,
          "spk": "裕太 (ユータ)",
          "ja": "ＤＩＹを頑張って、今なら",
          "tc": "我就開始試著用自己的方式DIY，",
          "sc": "我就开始试着用自己的方式DIY，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 437699,
          "spk": "裕太 (ユータ)",
          "ja": "役に立つアピールをしてるんだけど",
          "tc": "想讓他知道我現在可以幫得上忙。",
          "sc": "想让他知道我现在可以帮得上忙。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 437710,
          "spk": "裕太 (ユータ)",
          "ja": "毎回、却下されてる",
          "tc": "但他每次都會拒絕我。",
          "sc": "但他每次都会拒绝我。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 437717,
          "spk": "裕太 (ユータ)",
          "ja": "当時に比べればかなり",
          "tc": "雖然我覺得跟當初相比，",
          "sc": "虽然我觉得跟当初相比，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 437724,
          "spk": "裕太 (ユータ)",
          "ja": "上達したと思うんだけどな……",
          "tc": "我已經進步了很多了……",
          "sc": "我已经进步了很多了……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 437735,
          "spk": "裕太 (ユータ)",
          "ja": "でも、落ち込んでても仕方ないか",
          "tc": "不過光顧著沮喪也不是辦法，",
          "sc": "不过光顾着沮丧也不是办法，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 437742,
          "spk": "裕太 (ユータ)",
          "ja": "そんな暇があったら",
          "tc": "有那種時間的話，",
          "sc": "有那种时间的话，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 437749,
          "spk": "裕太 (ユータ)",
          "ja": "もっと腕を磨かないとね",
          "tc": "不如拿來磨練手藝還比較好。",
          "sc": "不如拿来磨练手艺还比较好。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 437760,
          "spk": "裕太 (ユータ)",
          "ja": "よし、次はどんなものを",
          "tc": "好，我就來好好想想",
          "sc": "好，我就来好好想想"
        },
        {
          "f_idx": 25,
          "pidx_tc": 437767,
          "spk": "裕太 (ユータ)",
          "ja": "作ろうか考えるよ",
          "tc": "下次要做什麼吧！",
          "sc": "下次要做什么吧！"
        },
        {
          "f_idx": 26,
          "pidx_tc": 437774,
          "spk": "裕太 (ユータ)",
          "ja": "またね、<player>",
          "tc": "下次見囉，<player>。",
          "sc": "下次见啦，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
