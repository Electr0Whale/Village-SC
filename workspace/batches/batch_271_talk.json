    {
      "file": "talk.dat",
      "rec_idx": 7743,
      "rec_id": "TALK_ID_70_2130_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443831,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が来るから、部屋、少し片付けたよ",
          "tc": "因為<player>要來，所以稍微打掃了房間喔。",
          "sc": "因为<player>要来，所以稍微打扫了房间哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443838,
          "spk": "堇怜 (スミレ)",
          "ja": "最近は前より、ちゃんとするようにしてるんだ",
          "tc": "最近，我比以前更認真過生活了。",
          "sc": "最近，我比以前更认真过生活了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7744,
      "rec_id": "TALK_ID_70_2130_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443863,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強しようと思ったら、",
          "tc": "我發現，就算我想要唸書，",
          "sc": "我发现，就算我想要念书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443870,
          "spk": "堇怜 (スミレ)",
          "ja": "散らかした楽しそうなものが見えると",
          "tc": "但要是房間裡亂糟糟的，",
          "sc": "但要是房间里乱糟糟的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443877,
          "spk": "堇怜 (スミレ)",
          "ja": "気が散っちゃうことに気づいてさ",
          "tc": "一看到有趣的東西就會讓我分心。",
          "sc": "一看到有趣的东西就会让我分心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443888,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんにも教えてもらうことが増えたよ",
          "tc": "也多了一些想請姊姊教我的事情。",
          "sc": "也多了一些想请姐姐教我的事情。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443895,
          "spk": "堇怜 (スミレ)",
          "ja": "医者になるって夢を叶えるためには、",
          "tc": "畢竟想要成為醫生，",
          "sc": "毕竟想要成为医生，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443902,
          "spk": "堇怜 (スミレ)",
          "ja": "足りないことばかりで恥ずかしいんだけどね……",
          "tc": "我還有很多不足的地方，總覺得很不好意思……",
          "sc": "我还有很多不足的地方，总觉得很不好意思……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443913,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、大きくなる前に",
          "tc": "但是，在長大之前，",
          "sc": "但是，在长大之前，"
        },
