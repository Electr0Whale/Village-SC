      "rec_id": "TALK_ID_70_2130_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441888,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、<player>も",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441895,
          "spk": "裕太 (ユータ)",
          "ja": "来てくれてたんだ",
          "tc": "你也來了啊。",
          "sc": "你也来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441902,
          "spk": "裕太 (ユータ)",
          "ja": "ちょうどよかったよ",
          "tc": "來得正好，",
          "sc": "来得正好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441915,
          "spk": "裕太 (ユータ)",
          "ja": "今日は水切りの成果を",
          "tc": "今天我要讓你們看看",
          "sc": "今天我要让你们看看"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441922,
          "spk": "裕太 (ユータ)",
          "ja": "見せようと思ってね！",
          "tc": "打水漂的練習成果！",
          "sc": "打水漂的练习成果！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 441933,
          "spk": "裕太 (ユータ)",
          "ja": "いくよ、見ててね……",
          "tc": "要開始囉，看好了……",
          "sc": "要开始喽，看好了……"
