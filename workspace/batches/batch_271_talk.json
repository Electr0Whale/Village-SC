    },
    {
      "file": "talk.dat",
      "rec_idx": 7728,
      "rec_id": "TALK_ID_70_2130_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442615,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も負けてられない！",
          "tc": "我也不能輸！",
          "sc": "我也不能输！"
