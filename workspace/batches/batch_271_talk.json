          "f_idx": 7,
          "pidx_tc": 443920,
          "spk": "堇怜 (スミレ)",
          "ja": "お金も貯めて、鵺の皮で村を出て",
          "tc": "我要存到錢，靠鵺皮離開村子，",
          "sc": "我要存到钱，靠鵺皮离开村子，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443927,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は、ちゃんと外で学びたい",
          "tc": "我想要好好地在外面念書。",
          "sc": "我想要好好地在外面念书。"
        }
      ]
    }
