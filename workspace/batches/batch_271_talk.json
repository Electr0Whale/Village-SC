    {
      "file": "talk.dat",
      "rec_idx": 7740,
      "rec_id": "TALK_ID_70_2130_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443489,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん……！",
          "tc": "嗯～！",
          "sc": "嗯～！"
        },
        {
