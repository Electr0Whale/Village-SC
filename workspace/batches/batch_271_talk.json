    {
      "file": "talk.dat",
      "rec_idx": 7707,
      "rec_id": "TALK_ID_70_2130_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441694,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、ありがとう、<player>",
          "tc": "謝、謝謝你，<player>。",
          "sc": "谢、谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441701,
          "spk": "堇怜 (スミレ)",
          "ja": "助かったよ……",
          "tc": "得救了……",
          "sc": "得救了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441712,
          "spk": "堇怜 (スミレ)",
          "ja": "もし一人で来てたらと思うと、",
          "tc": "要是只有我一個人來，",
          "sc": "要是只有我一个人来，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441719,
          "spk": "堇怜 (スミレ)",
          "ja": "ぞっとするよ",
          "tc": "光想就覺得恐怖。",
          "sc": "光想就觉得恐怖。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7708,
      "rec_id": "TALK_ID_70_2130_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441737,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が風邪の時に",
          "tc": "我感冒的時候，",
          "sc": "我感冒的时候，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441744,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんがこの薬草で",
          "tc": "姊姊都會用這種藥草",
          "sc": "姐姐都会用这种药草"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441751,
          "spk": "堇怜 (スミレ)",
          "ja": "薬草粥を作ってくれたんだ",
          "tc": "煮藥草粥給我吃。",
          "sc": "煮药草粥给我吃。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441762,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんは一人で",
          "tc": "姊姊獨自一個人",
          "sc": "姐姐独自一个人"
        },
        {
          "f_idx": 4,
          "pidx_tc": 441769,
          "spk": "堇怜 (スミレ)",
          "ja": "こんなところに……",
          "tc": "到這種地方來……",
          "sc": "到这种地方来……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7709,
      "rec_id": "TALK_ID_70_2130_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 441787,
          "spk": "堇怜 (スミレ)",
          "ja": "これからは僕が姉さんを",
          "tc": "從今以後就換我好好努力",
          "sc": "从今以后就换我好好努力"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441794,
          "spk": "堇怜 (スミレ)",
          "ja": "助けられるようにがんばらないと",
          "tc": "幫上姊姊的忙了。",
          "sc": "帮上姐姐的忙了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 441805,
          "spk": "堇怜 (スミレ)",
          "ja": "手伝ってくれてありがとう",
          "tc": "謝謝你的幫忙。",
          "sc": "谢谢你的帮忙。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 441812,
          "spk": "堇怜 (スミレ)",
          "ja": "それじゃ僕は家に戻るね",
          "tc": "那我先回家囉。",
          "sc": "那我先回家啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7710,
      "rec_id": "TALK_ID_70_2130_005_01",
      "lines": [
        {
