          "ja": "大きい魚を釣るぞ……！",
          "tc": "一定要釣到大魚……！",
          "sc": "一定要钓到大鱼……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7729,
      "rec_id": "TALK_ID_70_2130_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442647,
          "spk": "堇怜 (スミレ)",
          "ja": "僕、<player>を相棒に",
          "tc": "我很慶幸選擇了<player>",
          "sc": "我很庆幸选择了<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442654,
          "spk": "堇怜 (スミレ)",
          "ja": "選んでよかったよ",
          "tc": "當我的夥伴。",
          "sc": "当我的伙伴。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442665,
          "spk": "堇怜 (スミレ)",
          "ja": "これからの人生を",
          "tc": "為了讓往後的人生變得更好，",
          "sc": "为了让往后的人生变得更好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442672,
          "spk": "堇怜 (スミレ)",
          "ja": "より良くするために頑張るから",
          "tc": "我會加油的。",
          "sc": "我会加油的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442679,
          "spk": "堇怜 (スミレ)",
          "ja": "応援していてほしい",
          "tc": "希望你可以支持我。",
          "sc": "希望你可以支持我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7730,
      "rec_id": "TALK_ID_70_2130_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442697,
          "spk": "堇怜 (スミレ)",
          "ja": "ありがとう、<player>！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442708,
          "spk": "堇怜 (スミレ)",
          "ja": "また暇なときは、",
          "tc": "有空的時候，",
          "sc": "有空的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442715,
          "spk": "堇怜 (スミレ)",
          "ja": "こうして一緒に釣りしようぜ！",
          "tc": "我們再像這樣一起釣魚吧！",
          "sc": "我们再像这样一起钓鱼吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7731,
      "rec_id": "TALK_ID_70_2130_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442739,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442746,
          "spk": "堇怜 (スミレ)",
          "ja": "お腹空かせてきてくれた？",
          "tc": "你有餓著肚子來嗎？",
          "sc": "你有饿着肚子来吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442757,
          "spk": "堇怜 (スミレ)",
          "ja": "キスケさんとシロージさんと",
          "tc": "我和木助哥，還有四郎治哥",
          "sc": "我和木助哥，还有四郎治哥"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442764,
          "spk": "堇怜 (スミレ)",
          "ja": "一緒に釣りをしてたら、",
          "tc": "一起釣魚的時候，",
          "sc": "一起钓鱼的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442771,
          "spk": "堇怜 (スミレ)",
          "ja": "二人が大きなサケを釣ってさ",
          "tc": "他們釣到了很大的鮭魚，",
          "sc": "他们钓到了很大的三文鱼，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 442782,
          "spk": "堇怜 (スミレ)",
          "ja": "そのサケ、僕に譲ってくれたんだ！",
          "tc": "還把那隻鮭魚讓給我了！",
          "sc": "还把那只三文鱼让给我了！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442800,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょうど「焼き鮭定食」ができたんだ",
          "tc": "我剛好做好了「烤鮭魚定食」，",
          "sc": "我刚好做好了“烤三文鱼定食”，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 442807,
          "spk": "堇怜 (スミレ)",
          "ja": "一緒に食べようか",
          "tc": "一起來吃吧。",
          "sc": "一起来吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7732,
      "rec_id": "TALK_ID_70_2130_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442831,
          "spk": "堇怜 (スミレ)",
          "ja": "うん、脂が乗ってて美味い！",
          "tc": "嗯，油脂豐富，好吃！",
          "sc": "嗯，油脂丰富，好吃！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442838,
          "spk": "堇怜 (スミレ)",
          "ja": "腹ペコの身体に染みるよ",
          "tc": "餓壞的身體都被療癒了。",
          "sc": "饿坏的身体都被疗愈了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442849,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>も、美味い？",
          "tc": "<player>也覺得好吃嗎？",
          "sc": "<player>也觉得好吃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7733,
      "rec_id": "TALK_ID_70_2130_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442867,
          "spk": "堇怜 (スミレ)",
          "ja": "よかった！",
          "tc": "太好了！",
          "sc": "太好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 442878,
          "spk": "堇怜 (スミレ)",
          "ja": "魚を焼くときは",
          "tc": "烤魚的時候，",
          "sc": "烤鱼的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 442885,
          "spk": "堇怜 (スミレ)",
          "ja": "焼き加減にこだわってるんだ",
          "tc": "我對熟度可是很講究的。",
          "sc": "我对熟度可是很讲究的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 442896,
          "spk": "堇怜 (スミレ)",
          "ja": "この焼き鮭と普通の焼き鮭との",
          "tc": "這條烤鮭魚和普通的烤鮭魚，",
          "sc": "这条烤三文鱼和普通的烤三文鱼，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 442903,
          "spk": "堇怜 (スミレ)",
          "ja": "味の違い、<player>はわかる？",
          "tc": "<player>吃得出來味道不同嗎？",
          "sc": "<player>吃得出来味道不同吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 442919,
          "spk": "主角心声/旁白/选项",
          "ja": "わかる",
          "tc": "吃得出來",
          "sc": "吃得出来"
        },
        {
          "f_idx": 7,
          "pidx_tc": 442926,
          "spk": "主角心声/旁白/选项",
          "ja": "わからない",
          "tc": "吃不出來",
          "sc": "吃不出来"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7734,
      "rec_id": "TALK_ID_70_2130_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 442994,
          "spk": "堇怜 (スミレ)",
          "ja": "どんなに高級な料理よりも",
          "tc": "就算再高級的料理，",
          "sc": "就算再高级的料理，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443001,
          "spk": "堇怜 (スミレ)",
          "ja": "自分でこだわって作る料理のほうが",
          "tc": "我還是覺得比不上自己",
          "sc": "我还是觉得比不上自己"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443008,
          "spk": "堇怜 (スミレ)",
          "ja": "いいと思うし",
          "tc": "細心製作的料理。",
          "sc": "细心制作的料理。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443019,
          "spk": "堇怜 (スミレ)",
          "ja": "大切な人と食べる料理が",
          "tc": "而且和重要的人一起品嘗的料理",
          "sc": "而且和重要的人一起品尝的料理"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443026,
          "spk": "堇怜 (スミレ)",
          "ja": "一番美味しく感じるんだ",
          "tc": "才是最美味的。",
          "sc": "才是最美味的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443044,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんと食べる料理は",
          "tc": "和姊姊一起吃的料理",
          "sc": "和姐姐一起吃的料理"
        },
        {
          "f_idx": 7,
          "pidx_tc": 443051,
          "spk": "堇怜 (スミレ)",
          "ja": "もちろん美味いんだけどさ……",
          "tc": "當然也很美味……",
          "sc": "当然也很美味……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 443062,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>と食べる料理も",
          "tc": "但和<player>一起品嘗的料理",
          "sc": "但和<player>一起品尝的料理"
        },
        {
          "f_idx": 9,
          "pidx_tc": 443069,
          "spk": "堇怜 (スミレ)",
          "ja": "すごく美味く感じるんだ",
          "tc": "我也覺得非常好吃。",
          "sc": "我也觉得非常好吃。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 443080,
          "spk": "堇怜 (スミレ)",
          "ja": "また、ご飯食べに来てよ",
          "tc": "下次再來找我吃飯吧。",
          "sc": "下次再来找我吃饭吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7735,
      "rec_id": "TALK_ID_70_2130_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443111,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443118,
          "spk": "堇怜 (スミレ)",
          "ja": "いつ来るのかと思って待ってたよ",
          "tc": "我想說你怎麼還沒來，正在等你呢。",
          "sc": "我想说你怎么还没来，正在等你呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443129,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は僕が釣ったアユを",
          "tc": "今天讓你嘗嘗",
          "sc": "今天让你尝尝"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443136,
          "spk": "堇怜 (スミレ)",
          "ja": "ご馳走してあげる",
          "tc": "我釣到的香魚。",
          "sc": "我钓到的香鱼。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443147,
          "spk": "堇怜 (スミレ)",
          "ja": "大きいやつを釣り上げられたから",
          "tc": "剛好釣到了很大隻的香魚，",
          "sc": "刚好钓到了很大只的香鱼，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443154,
          "spk": "堇怜 (スミレ)",
          "ja": "きっと満足してくれると思うよ",
          "tc": "我想你一定會滿意的。",
          "sc": "我想你一定会满意的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443165,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、早く席に着いて！",
          "tc": "好了，快點就座吧。",
          "sc": "好了，快点就座吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7736,
      "rec_id": "TALK_ID_70_2130_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443189,
          "spk": "堇怜 (スミレ)",
          "ja": "うん、「鮎の塩焼き」は",
          "tc": "嗯，「鹽烤香魚」",
          "sc": "嗯，“盐烤香鱼”"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443196,
          "spk": "堇怜 (スミレ)",
          "ja": "やっぱり美味しいなあ……！",
          "tc": "果然很好吃……！",
          "sc": "果然很好吃……！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443207,
          "spk": "堇怜 (スミレ)",
          "ja": "アユは塩焼きにするのが",
          "tc": "我覺得香魚還是用鹽烤的",
          "sc": "我觉得香鱼还是用盐烤的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443214,
          "spk": "堇怜 (スミレ)",
          "ja": "一番美味いと思うんだよね",
          "tc": "最美味了。",
          "sc": "最美味了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 443221,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>もそう思うでしょ？",
          "tc": "<player>也有同感吧？",
          "sc": "<player>也有同感吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 443230,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 443237,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん",
          "tc": "唔……",
          "sc": "唔……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7737,
      "rec_id": "TALK_ID_70_2130_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443334,
          "spk": "堇怜 (スミレ)",
          "ja": "そういえば……",
          "tc": "說起來……",
          "sc": "说起来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443341,
          "spk": "堇怜 (スミレ)",
          "ja": "海の魚ってどんな味がするのかな？",
          "tc": "海魚吃起來是什麼味道啊？",
          "sc": "海鱼吃起来是什么味道啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7738,
      "rec_id": "TALK_ID_70_2130_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443359,
          "spk": "堇怜 (スミレ)",
          "ja": "まあ、僕は川の魚が好きだし",
          "tc": "不過我很喜歡淡水魚就是了，",
          "sc": "不过我很喜欢淡水鱼就是了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443366,
          "spk": "堇怜 (スミレ)",
          "ja": "別にいいんだけどね",
          "tc": "所以無所謂啦。",
          "sc": "所以无所谓啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 443377,
          "spk": "堇怜 (スミレ)",
          "ja": "いつか機会があれば",
          "tc": "但哪天有機會的話，",
          "sc": "但哪天有机会的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 443384,
          "spk": "堇怜 (スミレ)",
          "ja": "食べてみたいな……",
          "tc": "我會想吃吃看呢……",
          "sc": "我会想吃吃看呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7739,
      "rec_id": "TALK_ID_70_2130_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 443415,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 443422,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はご馳走を用意してるよ！",
          "tc": "今天準備了豐盛大餐喔！",
