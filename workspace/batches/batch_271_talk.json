          "pidx_tc": 441585,
          "spk": "堇怜 (スミレ)",
          "ja": "うん",
          "tc": "嗯，",
          "sc": "嗯，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 441592,
          "spk": "堇怜 (スミレ)",
          "ja": "これだけ採れればもう充分かな",
          "tc": "採到這麼多應該夠了。",
          "sc": "采到这么多应该够了。"
