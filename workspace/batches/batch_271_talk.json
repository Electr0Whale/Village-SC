          "f_idx": 1,
          "pidx_tc": 441518,
          "spk": "琪娜娜 (チナナ)",
          "ja": "動いちゃダメだってば",
          "tc": "都說了妳還不能亂動嘛！",
          "sc": "都说了你还不能乱动嘛！"
        }
      ]
    },
    {
      "file": "talk.dat",
