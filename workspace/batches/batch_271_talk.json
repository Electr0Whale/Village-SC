      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 437298,
          "spk": "木助 (キスケ)",
          "ja": "二度と敷居をまたぐなって言っただろ",
          "tc": "我不是跟你說過，不准你再踏入我職場半步了嗎？",
          "sc": "我不是跟你说过，不准你再踏入我职场半步了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 437311,
          "spk": "裕太 (ユータ)",
          "ja": "でも前より上達したと思うんだ",
          "tc": "但是我覺得我比以前進步了很多呢。",
          "sc": "但是我觉得我比以前进步了很多呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 437322,
          "spk": "裕太 (ユータ)",
          "ja": "見てよ、これ",
          "tc": "你看看這個，",
          "sc": "你看看这个，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 437329,
          "spk": "裕太 (ユータ)",
          "ja": "デスク用のブックシェルフ",
          "tc": "這是桌上型書架。",
          "sc": "这是桌上型书架。"
        }
      ]
    },
    {
      "file": "talk.dat",
