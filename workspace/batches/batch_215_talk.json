      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5372,
      "rec_id": "TALK_ID_10_0502_203_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311727,
          "spk": "名护 (ナゴ)",
          "ja": "ああ、<player>さんか",
          "tc": "哦～是<player>啊。",
          "sc": "哦～是<player>啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311734,
          "spk": "名护 (ナゴ)",
          "ja": "本を探しに来たのか？",
          "tc": "你來找書嗎？",
          "sc": "你来找书吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311745,
          "spk": "名护 (ナゴ)",
          "ja": "子ども向けの本なら、",
          "tc": "童書的話，",
          "sc": "童书的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311752,
          "spk": "名护 (ナゴ)",
          "ja": "あっちにまとめてあるよ",
          "tc": "都統一放在那邊喔。",
          "sc": "都统一放在那边哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5373,
      "rec_id": "TALK_ID_10_0502_203_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311770,
          "spk": "名护 (ナゴ)",
          "ja": "この本か？",
          "tc": "你問這本書？",
          "sc": "你问这本书？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311777,
          "spk": "名护 (ナゴ)",
          "ja": "本棚の隅で埃を被ってたんだ",
          "tc": "它放在書架的角落，上頭全是灰塵。",
          "sc": "它放在书架的角落，上头全是灰尘。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311795,
          "spk": "名护 (ナゴ)",
          "ja": "彼ヶ津村について",
          "tc": "我看它的內容好像是",
          "sc": "我看它的内容好像是"
        },
        {
          "f_idx": 4,
          "pidx_tc": 311802,
          "spk": "名护 (ナゴ)",
          "ja": "書かれているみたいだから、",
          "tc": "關於彼津村的，",
          "sc": "关于彼津村的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 311809,
          "spk": "名护 (ナゴ)",
          "ja": "何かわかるかと思ってね",
          "tc": "想說或許會有什麼發現。",
          "sc": "想说或许会有什么发现。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 311820,
          "spk": "名护 (ナゴ)",
          "ja": "さすがに、そんなに簡単には",
          "tc": "雖說應該也沒有那麼容易",
          "sc": "虽说应该也没有那么容易"
        },
        {
          "f_idx": 7,
          "pidx_tc": 311827,
          "spk": "名护 (ナゴ)",
          "ja": "見つからないだろうが……",
          "tc": "找到吧……",
          "sc": "找到吧……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 311834,
          "spk": "名护 (ナゴ)",
          "ja": "諦めるわけにはいかない",
          "tc": "但我不能放棄。",
          "sc": "但我不能放弃。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 311845,
          "spk": "名护 (ナゴ)",
          "ja": "なんでもいいから、",
          "tc": "什麼都可以，",
          "sc": "什么都可以，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 311852,
          "spk": "名护 (ナゴ)",
          "ja": "村から出る手がかりがほしいんだ",
          "tc": "我想找到離開這座村子的線索。",
          "sc": "我想找到离开这座村子的线索。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5374,
      "rec_id": "TALK_ID_10_0502_203_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311870,
          "spk": "名护 (ナゴ)",
          "ja": "外には、待たせている",
          "tc": "畢竟村外，",
          "sc": "毕竟村外，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311877,
          "spk": "名护 (ナゴ)",
          "ja": "人だっているし……",
          "tc": "還有人在等我……",
          "sc": "还有人在等我……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5375,
