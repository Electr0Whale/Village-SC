          "pidx_tc": 312471,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくんの今の話、",
          "tc": "堇怜，",
          "sc": "堇怜，"
        },
        {
          "f_idx": 44,
          "pidx_tc": 312478,
          "spk": "名护 (ナゴ)",
          "ja": "信じてみるよ",
          "tc": "我會試著相信你剛剛說的話。",
          "sc": "我会试着相信你刚刚说的话。"
        }
      ]
    },
