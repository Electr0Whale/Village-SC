          "sc": "嗯，没错啊。"
        },
        {
          "f_idx": 33,
          "pidx_tc": 312385,
          "spk": "堇怜 (スミレ)",
          "ja": "あの霧の先にたどり着く必要があるんです",
          "tc": "你必須抵達那片濃霧的另一頭才行。",
          "sc": "你必须抵达那片浓雾的另一头才行。"
        },
        {
          "f_idx": 35,
          "pidx_tc": 312403,
          "spk": "堇怜 (スミレ)",
          "ja": "村から出られない理由は、",
          "tc": "無法離開村子的原因，",
          "sc": "无法离开村子的原因，"
        },
        {
          "f_idx": 36,
          "pidx_tc": 312410,
          "spk": "堇怜 (スミレ)",
          "ja": "人それぞれなんです",
          "tc": "每個人各不相同，",
          "sc": "每个人各不相同，"
        },
        {
          "f_idx": 37,
          "pidx_tc": 312419,
          "spk": "堇怜 (スミレ)",
          "ja": "だから、ナゴさん自身で",
          "tc": "所以必須由名護哥，",
          "sc": "所以必须由名护哥，"
        },
        {
          "f_idx": 38,
          "pidx_tc": 312426,
          "spk": "堇怜 (スミレ)",
          "ja": "霧の先にたどり着かないといけないんです",
          "tc": "親自走到濃霧的另一頭才行。",
