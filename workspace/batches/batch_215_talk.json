        },
        {
          "f_idx": 41,
          "pidx_tc": 312453,
          "spk": "名护 (ナゴ)",
          "ja": "しかし、俺もこの村に慣れてきたんだ",
          "tc": "但我好歹也開始習慣這座村子了。",
          "sc": "但我好歹也开始习惯这座村子了。"
        },
