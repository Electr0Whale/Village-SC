        },
        {
          "f_idx": 39,
          "pidx_tc": 312433,
          "spk": "堇怜 (スミレ)",
          "ja": "……わかりました？",
          "tc": "……明白了嗎？",
          "sc": "……明白了吗？"
        },
        {
          "f_idx": 40,
          "pidx_tc": 312446,
          "spk": "名护 (ナゴ)",
