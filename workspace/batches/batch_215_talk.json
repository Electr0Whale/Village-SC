      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311577,
          "spk": "莲实 (ハスミ)",
          "ja": "ご、ごめんな……さい",
          "tc": "對、對不……起……",
          "sc": "对、对不……起……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311584,
          "spk": "莲实 (ハスミ)",
          "ja": "ご迷惑をぉ……おかけしたみたいで……",
          "tc": "我好像給你……添麻煩了……",
          "sc": "我好像给你……添麻烦了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311595,
          "spk": "莲实 (ハスミ)",
          "ja": "……あのぉ、本当にぃごめんなさい",
          "tc": "……那個，真的很抱歉。",
          "sc": "……那个，真的很抱歉。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311602,
          "spk": "莲实 (ハスミ)",
          "ja": "このことは……このことは……",
          "tc": "這件事……關於這件事……",
          "sc": "这件事……关于这件事……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 311609,
          "spk": "莲实 (ハスミ)",
          "ja": "絶対にぃ……スミレに言わないでください",
          "tc": "請你……絕對不要跟堇怜說。",
          "sc": "请你……绝对不要跟堇怜说。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 311618,
          "spk": "莲实 (ハスミ)",
          "ja": "あの子にはァ、これ以上……",
          "tc": "我不想再讓那孩子……",
          "sc": "我不想再让那孩子……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 311625,
          "spk": "莲实 (ハスミ)",
          "ja": "心配をぉ……かけたくないんですぅ……",
          "tc": "擔心……我了……",
          "sc": "担心……我了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 311632,
          "spk": "莲实 (ハスミ)",
          "ja": "お願いしますぅぅ……",
          "tc": "拜託你……",
          "sc": "拜托你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5370,
      "rec_id": "TALK_ID_10_0502_202_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311650,
          "spk": "莲实 (ハスミ)",
          "ja": "……よかったァ",
          "tc": "……太好了。",
          "sc": "……太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311657,
          "spk": "莲实 (ハスミ)",
          "ja": "あ、ありがとうございますぅ……",
          "tc": "謝、謝謝……",
          "sc": "谢、谢谢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311666,
          "spk": "莲实 (ハスミ)",
          "ja": "私なら……も、もぅ……大丈夫ですからァ……",
          "tc": "我……已、已經……沒事了……",
          "sc": "我……已、已经……没事了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311673,
          "spk": "莲实 (ハスミ)",
          "ja": "……帰りますねぇ",
          "tc": "……那我回家了。",
          "sc": "……那我回家了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 311680,
          "spk": "莲实 (ハスミ)",
          "ja": "さようなら……",
          "tc": "再見……",
          "sc": "再见……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5371,
      "rec_id": "TALK_ID_10_0502_203_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311700,
          "spk": "名护 (ナゴ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311707,
          "spk": "名护 (ナゴ)",
          "ja": "これは違うか……？",
          "tc": "不是這個嗎……？",
