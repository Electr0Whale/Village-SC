      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5377,
      "rec_id": "TALK_ID_10_0502_203_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 311935,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくんも本を探しに？",
          "tc": "堇怜，你也是來找書的嗎？",
          "sc": "堇怜，你也是来找书的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 311942,
          "spk": "名护 (ナゴ)",
          "ja": "こう言ってはなんだが、",
          "tc": "這麼說可能有些失禮，",
          "sc": "这么说可能有些失礼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 311949,
          "spk": "名护 (ナゴ)",
          "ja": "ちょっと意外だな",
          "tc": "但我有點意外呢。",
          "sc": "但我有点意外呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 311962,
          "spk": "堇怜 (スミレ)",
          "ja": "本なんか読まないですよ",
          "tc": "我才不看書呢。",
          "sc": "我才不看书呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 311969,
          "spk": "堇怜 (スミレ)",
          "ja": "眠くなるか、頭が痛くなるかの",
          "tc": "看了不是想睡就是頭痛，",
          "sc": "看了不是想睡就是头痛，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 311976,
          "spk": "堇怜 (スミレ)",
          "ja": "どっちかなんですから",
          "tc": "只有這兩種下場。",
          "sc": "只有这两种下场。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 311989,
          "spk": "名护 (ナゴ)",
          "ja": "読書は、そんなに苦痛を",
          "tc": "我想閱讀，",
          "sc": "我想阅读，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 311996,
          "spk": "名护 (ナゴ)",
          "ja": "伴うものじゃないはずなんだが……",
          "tc": "應該不是那麼痛苦的行為吧……",
          "sc": "应该不是那么痛苦的行为吧……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 312009,
          "spk": "堇怜 (スミレ)",
          "ja": "それより僕、ナゴさんに",
          "tc": "先不說這個了，名護哥，",
          "sc": "先不说这个了，名护哥，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312016,
          "spk": "堇怜 (スミレ)",
          "ja": "いい話を持ってきたんです",
          "tc": "我帶了好消息來給你。",
          "sc": "我带了好消息来给你。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 312027,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は、村から出る方法はわかりませんが……",
          "tc": "雖然我不知道離開村子的方法……",
          "sc": "虽然我不知道离开村子的方法……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 312034,
          "spk": "堇怜 (スミレ)",
          "ja": "村から出られない原因を知る方法なら",
          "tc": "但我曉得要怎麼找出",
          "sc": "但我晓得要怎么找出"
        },
        {
          "f_idx": 12,
          "pidx_tc": 312041,
          "spk": "堇怜 (スミレ)",
          "ja": "知っていますよ",
          "tc": "無法離開村子的原因喔。",
          "sc": "无法离开村子的原因哦。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 312054,
          "spk": "名护 (ナゴ)",
          "ja": "俺が村から出られない原因が、",
          "tc": "你的意思是，",
          "sc": "你的意思是，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 312061,
          "spk": "名护 (ナゴ)",
          "ja": "わかるっていうのかい！？",
          "tc": "可以找到我無法離開村子的原因嗎！？",
          "sc": "可以找到我无法离开村子的原因吗！？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 312074,
          "spk": "堇怜 (スミレ)",
          "ja": "はい",
          "tc": "是的。",
          "sc": "是的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5378,
      "rec_id": "TALK_ID_10_0502_203_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312092,
          "spk": "名护 (ナゴ)",
          "ja": "理由がわかれば、",
          "tc": "只要找到原因，",
          "sc": "只要找到原因，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312099,
          "spk": "名护 (ナゴ)",
          "ja": "村から出る方法もわかるかもしれない",
          "tc": "說不定就會知道離開村子的方法了。",
          "sc": "说不定就会知道离开村子的方法了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312106,
          "spk": "名护 (ナゴ)",
          "ja": "スミレくん、教えてくれ！",
          "tc": "堇怜，快告訴我！",
          "sc": "堇怜，快告诉我！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312119,
          "spk": "堇怜 (スミレ)",
          "ja": "いいですけど、",
          "tc": "可以是可以，",
          "sc": "可以是可以，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312126,
          "spk": "堇怜 (スミレ)",
          "ja": "度胸が試されますよ？",
          "tc": "不過需要考驗膽量喔～",
          "sc": "不过需要考验胆量哦～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 312133,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさんにできますかね……？",
          "tc": "名護哥辦得到嗎……？",
          "sc": "名护哥办得到吗……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 312146,
          "spk": "名护 (ナゴ)",
          "ja": "ぜ、善処するよ",
          "tc": "我、我會盡力而為。",
          "sc": "我、我会尽力而为。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 312159,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ……まずは確認ですが……",
          "tc": "那麼……先跟你確認一件事……",
          "sc": "那么……先跟你确认一件事……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 312168,
          "spk": "堇怜 (スミレ)",
          "ja": "トンネルの先の峠を歩いていると、",
          "tc": "穿過隧道後，走在那個隘口時，",
          "sc": "穿过隧道后，走在那个隘口时，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 312175,
          "spk": "堇怜 (スミレ)",
          "ja": "だんだん霧が濃くなってきて、",
          "tc": "霧會越來越濃，",
          "sc": "雾会越来越浓，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 312182,
          "spk": "堇怜 (スミレ)",
          "ja": "どこへ進んでいるかわからなくなりませんか？",
          "tc": "然後就搞不清楚自己正在往哪走對吧？",
          "sc": "然后就搞不清楚自己正在往哪走对吧？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 312195,
          "spk": "名护 (ナゴ)",
          "ja": "あ、ああ……",
          "tc": "是、是啊……",
          "sc": "是、是啊……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 312202,
          "spk": "名护 (ナゴ)",
          "ja": "それで気がついたら、",
          "tc": "接著等回過神來，",
          "sc": "接着等回过神来，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 312209,
          "spk": "名护 (ナゴ)",
          "ja": "トンネルの前に戻されてしまうんだ",
          "tc": "就又回到隧道前了。",
          "sc": "就又回到隧道前了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 312222,
          "spk": "堇怜 (スミレ)",
          "ja": "霧の中を真っ直ぐ進むには、",
          "tc": "如果想在濃霧中筆直前進，",
          "sc": "如果想在浓雾中笔直前进，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 312229,
          "spk": "堇怜 (スミレ)",
          "ja": "まず、<strong>「提灯」と「遠くまで水を撒ける物」</strong>を",
          "tc": "請先將<strong>「手提燈籠」和「能把水灑到遠處的器具」</strong>",
          "sc": "请先将<strong>“手提灯笼”和“能把水洒到远处的器具”</strong>"
        },
        {
          "f_idx": 16,
          "pidx_tc": 312236,
          "spk": "堇怜 (スミレ)",
          "ja": "用意してください",
          "tc": "這兩樣東西準備好。",
          "sc": "这两样东西准备好。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 312249,
          "spk": "名护 (ナゴ)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 312256,
          "spk": "名护 (ナゴ)",
          "ja": "提灯と……？",
          "tc": "手提燈籠跟……？",
          "sc": "手提灯笼跟……？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 312263,
          "spk": "名护 (ナゴ)",
          "ja": "な、なんだって？",
          "tc": "什、什麼東西？",
          "sc": "什、什么东西？"
        },
        {
          "f_idx": 20,
          "pidx_tc": 312276,
          "spk": "堇怜 (スミレ)",
          "ja": "ジョウロとかがいいですね",
          "tc": "像澆水壺就不錯呢。",
          "sc": "像浇水壶就不错呢。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 312283,
          "spk": "堇怜 (スミレ)",
          "ja": "<strong>水を汲んで、水をかけ続ける必要があるので</strong>",
          "tc": "<strong>因為必須裝水，然後一直不停灑水才行。</strong>",
          "sc": "<strong>因为必须装水，然后一直不停洒水才行。</strong>"
        },
        {
          "f_idx": 23,
          "pidx_tc": 312301,
          "spk": "堇怜 (スミレ)",
          "ja": "あそこには、提灯の光でしか",
          "tc": "那裡有很多東西，",
          "sc": "那里有很多东西，"
        },
        {
          "f_idx": 24,
          "pidx_tc": 312308,
          "spk": "堇怜 (スミレ)",
          "ja": "見えないものがたくさん居るんです",
          "tc": "只有用手提燈籠的光去照才看得見。",
          "sc": "只有用手提灯笼的光去照才看得见。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 312324,
          "spk": "堇怜 (スミレ)",
          "ja": "<strong>深夜</strong>になったら行ってみてください",
          "tc": "到了<strong>深夜</strong>請去走走看，",
          "sc": "到了<strong>深夜</strong>请去走走看，"
        },
        {
          "f_idx": 27,
          "pidx_tc": 312331,
          "spk": "堇怜 (スミレ)",
          "ja": "<strong>やつが消えるまで水をかけたら</strong>、",
          "tc": "<strong>要一直灑水直到祂們消失</strong>，",
          "sc": "<strong>要一直洒水直到他们消失</strong>，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 312338,
          "spk": "堇怜 (スミレ)",
          "ja": "霧が薄くなるはずですから",
          "tc": "霧應該也會跟著變淡。",
          "sc": "雾应该也会跟着变淡。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 312351,
          "spk": "名护 (ナゴ)",
          "ja": "今聞いているのは、",
          "tc": "你現在說的，",
          "sc": "你现在说的，"
        },
        {
          "f_idx": 30,
          "pidx_tc": 312358,
          "spk": "名护 (ナゴ)",
          "ja": "俺が村から出られない理由を",
          "tc": "應該是「找出原因的方法」沒錯吧……？",
          "sc": "应该是“找出原因的方法”没错吧……？"
        },
        {
          "f_idx": 31,
          "pidx_tc": 312365,
          "spk": "名护 (ナゴ)",
          "ja": "知る方法なんだよな……？",
          "tc": "用來找出我無法離開村子的原因……",
          "sc": "用来找出我无法离开村子的原因……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 312378,
          "spk": "堇怜 (スミレ)",
          "ja": "はい、そうですよ",
