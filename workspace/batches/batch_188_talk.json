      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247039,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ",
          "tc": "嗨。",
          "sc": "嗨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247046,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おはよう、<player>",
          "tc": "早安，<player>。",
          "sc": "早安，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4262,
      "rec_id": "TALK_ID_10_0301_014_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247066,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっきね、",
          "tc": "我剛才",
          "sc": "我刚才"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247073,
          "spk": "琪娜娜 (チナナ)",
          "ja": "怖い顔をした市役所の人に追いかけられて、",
          "tc": "被表情很可怕的市公所的人追趕，",
          "sc": "被表情很可怕的市政厅的人追赶，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247080,
          "spk": "琪娜娜 (チナナ)",
          "ja": "早足で逃げてきたんだけれど……",
          "tc": "就急忙逃來這裡……",
          "sc": "就急忙逃来这里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4263,
      "rec_id": "TALK_ID_10_0301_014_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247100,
          "spk": "名护 (ナゴ)",
          "ja": "ちょっと待って……",
          "tc": "等等……",
          "sc": "等等……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4264,
      "rec_id": "TALK_ID_10_0301_014_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247122,
          "spk": "名护 (ナゴ)",
          "ja": "チナナさん！",
          "tc": "琪娜娜小姐！",
          "sc": "琪娜娜小姐！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247129,
          "spk": "名护 (ナゴ)",
          "ja": "聞きたいことが！",
          "tc": "我有問題想問妳！",
          "sc": "我有问题想问你！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247140,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うわ、追いかけてきたのか",
          "tc": "嗚哇，追到這裡來了啊。",
          "sc": "呜哇，追到这里来了啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247147,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんか怒ってるのかい？",
          "tc": "你是不是在生氣啊？",
          "sc": "你是不是在生气啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247160,
          "spk": "名护 (ナゴ)",
          "ja": "いや……この顔はメガネを無くして",
          "tc": "不是的……我這表情是因為眼鏡不見了，",
          "sc": "不是的……我这表情是因为眼镜不见了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247167,
          "spk": "名护 (ナゴ)",
          "ja": "細目で見ているからで、",
          "tc": "只能瞇著眼睛看人的關係，",
          "sc": "只能眯着眼睛看人的关系，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247174,
          "spk": "名护 (ナゴ)",
          "ja": "怒ってるわけじゃないんだが……",
          "tc": "並不是在生氣……",
          "sc": "并不是在生气……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 247187,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだ、ただ目つきが悪いだけか",
          "tc": "什麼嘛，原來只是眼神可怕而已。",
          "sc": "什么嘛，原来只是眼神可怕而已。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 247194,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ところでキミは、市役所の人だよね？",
          "tc": "話說你應該是市公所的人吧？",
          "sc": "话说你应该是市政厅的人吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 247201,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうしてこんな時間にここに？",
          "tc": "怎麼這時間會在這裡？",
          "sc": "怎么这时间会在这里？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 247214,
          "spk": "名护 (ナゴ)",
          "ja": "それが……",
          "tc": "是因為……",
          "sc": "是因为……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 247221,
          "spk": "名护 (ナゴ)",
          "ja": "最近、村から出られなくなってしまって……",
          "tc": "前陣子我被困在村子裡出不去了……",
          "sc": "前阵子我被困在村子里出不去了……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 247228,
          "spk": "名护 (ナゴ)",
          "ja": "仕方なくここに住んでいるんだよ",
          "tc": "只好在這裡住下來。",
          "sc": "只好在这里住下来。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 247241,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ああ、それでウチに用があるんだね",
          "tc": "哦，所以才有事找我呀。",
          "sc": "哦，所以才有事找我呀。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 247248,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さしずめ、外に出る方法を",
          "tc": "我想，你應該是",
          "sc": "我想，你应该是"
        },
        {
          "f_idx": 15,
          "pidx_tc": 247255,
          "spk": "琪娜娜 (チナナ)",
          "ja": "聞きたいってところでしょ",
          "tc": "想問我出去的辦法吧？",
          "sc": "想问我出去的办法吧？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 247268,
          "spk": "名护 (ナゴ)",
          "ja": "トンネルの先に麓へと続く峠があるだろう？",
          "tc": "隧道另一頭是連接著通往山腳的隘口對吧？",
          "sc": "隧道另一头是连接着通往山脚的隘口对吧？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 247275,
          "spk": "名护 (ナゴ)",
          "ja": "あの峠を下っていると、",
          "tc": "穿過那個隘口繼續下山，",
          "sc": "穿过那个隘口继续下山，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 247282,
          "spk": "名护 (ナゴ)",
          "ja": "いつの間にか村の前に戻ってきてしまうんだ",
          "tc": "不知不覺間還是會回到村子口。",
          "sc": "不知不觉间还是会回到村子口。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 247293,
          "spk": "名护 (ナゴ)",
          "ja": "見たところ、キミは……キミだけが",
          "tc": "就我看來，妳……而且只有妳，",
          "sc": "就我看来，你……而且只有你，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 247300,
          "spk": "名护 (ナゴ)",
          "ja": "村と外を問題なく行き来できている……",
          "tc": "能夠毫無阻礙地來往村子與外界……",
          "sc": "能够毫无阻碍地来往村子与外界……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 247307,
          "spk": "名护 (ナゴ)",
          "ja": "どうやってこの現象を回避しているんだい？",
          "tc": "妳到底是怎麼避開這個現象的？",
          "sc": "你到底是怎么避开这个现象的？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4265,
      "rec_id": "TALK_ID_10_0301_014_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247325,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……ウチはそんな現象見たことないし",
          "tc": "嗯……我既沒看過這種現象，",
          "sc": "嗯……我既没看过这种现象，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247332,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困ってないから考えたこともないなぁ",
          "tc": "也沒為此困擾過，從來都沒想過耶。",
          "sc": "也没为此困扰过，从来都没想过呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247352,
          "spk": "名护 (ナゴ)",
          "ja": "で、でも、何かあるんじゃないのか？",
          "tc": "可、可是，總有什麼原因之類的吧？",
          "sc": "可、可是，总有什么原因之类的吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247359,
          "spk": "名护 (ナゴ)",
          "ja": "例えば、惑わされない……だったり……",
          "tc": "例如，不被迷惑……什麼的……",
          "sc": "例如，不被迷惑……什么的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4266,
      "rec_id": "TALK_ID_10_0301_014_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247384,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あはは、ナニそれ！",
          "tc": "啊哈哈，你在說什麼啦！",
          "sc": "啊哈哈，你在说什么啦！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247391,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いっぺん惑いを振り切るくらい、",
          "tc": "要不要試試看用衝的？",
          "sc": "要不要试试看用冲的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247398,
          "spk": "琪娜娜 (チナナ)",
          "ja": "速く走ってみればいいんじゃないかな？",
          "tc": "速度要快到連迷惘的餘地都沒有？",
          "sc": "速度要快到连迷惘的余地都没有？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247411,
          "spk": "名护 (ナゴ)",
          "ja": "そんなことで出られる気がしないぞ……",
          "tc": "我不覺得那樣就有辦法出去……",
          "sc": "我不觉得那样就有办法出去……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247418,
          "spk": "名护 (ナゴ)",
          "ja": "そもそも、俺とキミの違いは何なんだ？",
          "tc": "說起來，我跟妳的差異究竟是什麼？",
          "sc": "说起来，我跟你的差异究竟是什么？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247425,
          "spk": "名护 (ナゴ)",
          "ja": "村を出られる境界線は、どこにある？",
          "tc": "可以離開村子的分界線在哪裡？",
          "sc": "可以离开村子的分界线在哪里？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4267,
      "rec_id": "TALK_ID_10_0301_014_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247443,
          "spk": "名护 (ナゴ)",
          "ja": "惑わされないというのは一つの理由だが、",
          "tc": "不被迷惑只是其中一項因素，",
          "sc": "不被迷惑只是其中一项因素，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247450,
          "spk": "名护 (ナゴ)",
          "ja": "それ以外にも何か、特別な要因があるはずだ……",
          "tc": "一定還有其他的特殊條件才對……",
          "sc": "一定还有其他的特殊条件才对……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247457,
          "spk": "名护 (ナゴ)",
          "ja": "出られる手段はきっと、一つじゃないはず……",
          "tc": "能夠出去的方法，肯定不只一種……",
          "sc": "能够出去的方法，肯定不只一种……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247470,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それよりさ、ウチも",
          "tc": "先別說那個了，",
          "sc": "先别说那个了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ずっと気になってたことがあるんだけど……",
          "tc": "我也有件一直很好奇的事……",
          "sc": "我也有件一直很好奇的事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4268,
      "rec_id": "TALK_ID_10_0301_014_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247495,
          "spk": "名护 (ナゴ)",
          "ja": "ん？　なんだ？",
          "tc": "嗯？什麼？",
          "sc": "嗯？什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247508,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはどうして、あれほどまでに",
          "tc": "你為什麼",
          "sc": "你为什么"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247515,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ソーラーパネルの設置に",
          "tc": "要為了設置太陽能板",
          "sc": "要为了设置太阳能板"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247522,
          "spk": "琪娜娜 (チナナ)",
          "ja": "必死になっていたんだい？",
          "tc": "那麼拚命？",
          "sc": "那么拚命？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247533,
          "spk": "琪娜娜 (チナナ)",
          "ja": "聞いた話では、キミも村の美しさを褒めてたよね",
          "tc": "我聽說你也稱讚過這村子的美麗景色，",
          "sc": "我听说你也称赞过这村子的美丽景色，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247540,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なのに、なぜ景観を損なうソーラーパネルを",
          "tc": "既然如此，為什麼又會想要在這裡",
          "sc": "既然如此，为什么又会想要在这里"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "設置しようなんか……",
          "tc": "設置破壞景觀的太陽能板……？",
          "sc": "设置破坏景观的太阳能板……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4269,
      "rec_id": "TALK_ID_10_0301_014_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247565,
          "spk": "名护 (ナゴ)",
          "ja": "忘れていた！",
          "tc": "我都忘了這回事！",
          "sc": "我都忘了这回事！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247572,
          "spk": "名护 (ナゴ)",
          "ja": "そ、それもあって俺は……",
          "tc": "就、就因為這樣，我才……",
          "sc": "就、就因为这样，我才……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247585,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……なにか、理由があるんだね",
          "tc": "……看來，也有你的理由呢。",
          "sc": "……看来，也有你的理由呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247605,
          "spk": "名护 (ナゴ)",
          "ja": "……この彼ヶ津村は、",
          "tc": "……這彼津村，",
          "sc": "……这彼津村，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247612,
          "spk": "名护 (ナゴ)",
          "ja": "十年前に人口がガクッと減ったんだろう？",
          "tc": "十年前，人口突然少了很多對吧？",
          "sc": "十年前，人口突然少了很多对吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247625,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほう……よくご存知で",
          "tc": "哦……你居然知道這回事。",
          "sc": "哦……你居然知道这回事。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 247640,
          "spk": "名护 (ナゴ)",
          "ja": "以降も人口は減少を続け、",
          "tc": "從那時候開始人口持續減少，",
          "sc": "从那时候开始人口持续减少，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 247647,
          "spk": "名护 (ナゴ)",
          "ja": "今や住民は十数名程度になってしまっている",
          "tc": "到現在居民只剩十幾個人了。",
          "sc": "到现在居民只剩十几个人了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 247654,
          "spk": "名护 (ナゴ)",
          "ja": "……だから危険なんだ",
          "tc": "……所以很危險。",
          "sc": "……所以很危险。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 247665,
          "spk": "名护 (ナゴ)",
          "ja": "この集落は市から",
          "tc": "畢竟以市公所的角度來說，",
          "sc": "毕竟以市政厅的角度来说，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 247672,
          "spk": "名护 (ナゴ)",
          "ja": "「税金を生まない場所」だと",
          "tc": "這村子被列為",
          "sc": "这村子被列为"
        },
        {
          "f_idx": 12,
          "pidx_tc": 247679,
          "spk": "名护 (ナゴ)",
          "ja": "思われているんだからな",
          "tc": "「無法產生稅收的地方」。",
          "sc": "“无法产生税收的地方”。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4271,
      "rec_id": "TALK_ID_10_0301_014_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247702,
          "spk": "琪娜娜 (チナナ)",
          "ja": "へぇ……初耳だね",
          "tc": "哦……這我還是第一次聽說。",
          "sc": "哦……这我还是第一次听说。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247715,
          "spk": "名护 (ナゴ)",
          "ja": "村長さんは",
          "tc": "這裡的村長",
          "sc": "这里的村长"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247722,
          "spk": "名护 (ナゴ)",
          "ja": "そんな話に構ってられないと言って、",
          "tc": "只說不想理會這種事，",
          "sc": "只说不想理会这种事，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247729,
          "spk": "名护 (ナゴ)",
          "ja": "全く聞く耳を持たないからな……",
          "tc": "接著就完全不聽我說了……",
          "sc": "接着就完全不听我说了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247742,
          "spk": "名护 (ナゴ)",
          "ja": "道路も水道も、税金がなければ守れないんだ",
          "tc": "無論道路或是用水，都要有稅金才能維持。",
          "sc": "无论道路或是用水，都要有税金才能维持。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247749,
          "spk": "名护 (ナゴ)",
          "ja": "何もしなければ少しずつサービスが減って、",
          "tc": "如果不做點什麼，這裡的民生資源將會持續減少，",
          "sc": "如果不做点什么，这里的民生资源将会持续减少，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247756,
          "spk": "名护 (ナゴ)",
          "ja": "ここで暮らすのが、難しくなる可能性もある",
          "tc": "要在這裡生活也許會越來越困難。",
          "sc": "要在这里生活也许会越来越困难。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 247767,
          "spk": "名护 (ナゴ)",
          "ja": "ソーラーパネルは、景観を変えてでも",
          "tc": "設置太陽能板，能展現村民不惜改變景觀",
          "sc": "设置太阳能板，能展现村民不惜改变景观"
        },
        {
          "f_idx": 8,
          "pidx_tc": 247774,
          "spk": "名护 (ナゴ)",
          "ja": "「ここで生きていく」と示すための",
          "tc": "也要「繼續在這裡生活下去」的決心，",
          "sc": "也要“继续在这里生活下去”的决心，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 247781,
          "spk": "名护 (ナゴ)",
          "ja": "現実的な一歩なんだ",
          "tc": "是很務實的做法。",
          "sc": "是很务实的做法。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4272,
      "rec_id": "TALK_ID_10_0301_014_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247799,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なるほどね……",
          "tc": "原來如此……",
          "sc": "原来如此……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247806,
          "spk": "琪娜娜 (チナナ)",
          "ja": "彼ヶ津村の価値を上げて存続させるためにも、",
          "tc": "為了提昇彼津村的價值，進而維持這裡的生活，",
          "sc": "为了提升彼津村的价值，进而维持这里的生活，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247813,
          "spk": "琪娜娜 (チナナ)",
          "ja": "発電を提案していたというわけか",
          "tc": "所以你才提議發電啊。",
          "sc": "所以你才提议发电啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247824,
          "spk": "琪娜娜 (チナナ)",
          "ja": "でもキミは、どうして村を守りたかったんだい？",
          "tc": "不過，你為什麼會想要守護這個村子？",
          "sc": "不过，你为什么会想要守护这个村子？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247831,
          "spk": "琪娜娜 (チナナ)",
          "ja": "全く相手にされず、時には心無いことも",
          "tc": "明明都被冷眼相待，",
          "sc": "明明都被冷眼相待，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 247838,
          "spk": "琪娜娜 (チナナ)",
          "ja": "言われただろうに",
          "tc": "有時甚至被講得很難聽吧。",
          "sc": "有时甚至被讲得很难听吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247851,
          "spk": "名护 (ナゴ)",
          "ja": "明白だろ？　俺がこの村には、",
          "tc": "很明顯吧？",
          "sc": "很明显吧？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 247858,
          "spk": "名护 (ナゴ)",
          "ja": "保存する価値があると判断したからだ",
          "tc": "因為我判斷這個村子有保存的價值。",
          "sc": "因为我判断这个村子有保存的价值。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4273,
      "rec_id": "TALK_ID_10_0301_014_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247883,
          "spk": "名护 (ナゴ)",
          "ja": "こんなに美しくて、遺産や文化が残る土地は",
          "tc": "像這樣景色美麗，留有遺產、文化的土地，",
          "sc": "像这样景色美丽，留有遗产、文化的土地，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247890,
          "spk": "名护 (ナゴ)",
          "ja": "日本中探しても、",
          "tc": "放眼全日本，",
          "sc": "放眼全日本，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 247897,
          "spk": "名护 (ナゴ)",
          "ja": "そう簡単には見つからないんだぞ",
          "tc": "可能都沒辦法輕易找到啊。",
          "sc": "可能都没办法轻易找到啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247910,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……お人よしだねえ",
          "tc": "……你還真是濫好人。",
          "sc": "……你还真是滥好人。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247917,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見知らぬ土地のために動いてくれるなんて",
          "tc": "居然願意為這片陌生的土地奔走，",
          "sc": "居然愿意为这片陌生的土地奔走，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 247935,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よかったじゃないか、ここに住めて",
          "tc": "那現在不就很棒嗎？你都能住到這裡來了。",
          "sc": "那现在不就很棒吗？你都能住到这里来了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 247942,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だからこそ、この土地に縛られたのかもよ",
          "tc": "或許就是因為這樣，你才被這塊土地束縛喔。",
          "sc": "或许就是因为这样，你才被这块土地束缚哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4274,
      "rec_id": "TALK_ID_10_0301_014_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 247960,
          "spk": "名护 (ナゴ)",
          "ja": "出られなくなるのは話が別だろ！",
          "tc": "沒辦法離開村子又是另一回事吧！？",
          "sc": "没办法离开村子又是另一回事吧！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 247967,
          "spk": "名护 (ナゴ)",
          "ja": "俺には、街の暮らしがあるのだから！",
          "tc": "我在城市裡還有生活要過啊！",
          "sc": "我在城市里还有生活要过啊！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 247987,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ますます住人になってもらいたくなったよ",
          "tc": "我可是越來越希望你能成為村民呢。",
          "sc": "我可是越来越希望你能成为村民呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 247994,
          "spk": "琪娜娜 (チナナ)",
          "ja": "家電とか必要だろう？",
          "tc": "你需要家電之類的吧？",
          "sc": "你需要家电之类的吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248001,
          "spk": "琪娜娜 (チナナ)",
          "ja": "言ってくれたら、なんでも仕入れてくるからね",
          "tc": "只要跟我說一聲，我什麼都會幫你買回來的。",
          "sc": "只要跟我说一声，我什么都会帮你买回来的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248014,
          "spk": "名护 (ナゴ)",
          "ja": "やめてくれ！",
          "tc": "別這樣！",
          "sc": "别这样！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 248021,
          "spk": "名护 (ナゴ)",
          "ja": "絶対買わないぞ！",
          "tc": "我絕對不會買的！",
          "sc": "我绝对不会买的！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 248028,
          "spk": "名护 (ナゴ)",
          "ja": "俺は出る方法を見つけ出すんだから！",
          "tc": "我會找到離開這裡的辦法！",
          "sc": "我会找到离开这里的办法！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4275,
      "rec_id": "TALK_ID_10_0301_015_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248050,
          "spk": "驹子 (コマコ)",
          "ja": "え、そんな、ピロが？",
          "tc": "咦，嗶羅牠怎麼會？",
          "sc": "咦，哔罗它怎么会？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248057,
          "spk": "驹子 (コマコ)",
          "ja": "でも、本当に……？",
          "tc": "可是，是真的嗎……？",
          "sc": "可是，是真的吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4276,
      "rec_id": "TALK_ID_10_0301_015_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248079,
          "spk": "洋 (ヨウ)",
          "ja": "本当だよ",
          "tc": "是真的。",
          "sc": "是真的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248086,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん、夜中になると鳴いて、",
          "tc": "嗶羅都會在半夜叫，",
          "sc": "哔罗都会在半夜叫，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248093,
          "spk": "洋 (ヨウ)",
          "ja": "呼んでるみたいなの",
          "tc": "好像是在呼喚。",
          "sc": "好像是在呼唤。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248104,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはいいんだけど、",
          "tc": "我是還好，",
          "sc": "我是还好，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248111,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんが、鳴き声で目を覚まして",
          "tc": "但叔叔會被叫聲吵醒，",
          "sc": "但叔叔会被叫声吵醒，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248118,
          "spk": "洋 (ヨウ)",
          "ja": "眠れないみたいで……",
          "tc": "睡不著的樣子……",
          "sc": "睡不着的样子……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248131,
          "spk": "驹子 (コマコ)",
          "ja": "……じゃあ、ピロはまだあの日の夜から",
          "tc": "……那也許，嗶羅從那天晚上開始",
          "sc": "……那也许，哔罗从那天晚上开始"
        },
        {
          "f_idx": 7,
          "pidx_tc": 248138,
          "spk": "驹子 (コマコ)",
          "ja": "帰って来れていないのかもね",
          "tc": "就一直沒能回到家來。",
          "sc": "就一直没能回到家来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4277,
      "rec_id": "TALK_ID_10_0301_015_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248156,
          "spk": "洋 (ヨウ)",
          "ja": "ねえ、コマコちゃん",
          "tc": "聽我說，駒子姐姐。",
          "sc": "听我说，驹子姐姐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248163,
          "spk": "洋 (ヨウ)",
          "ja": "ピロちゃん、また見つけて",
          "tc": "妳可不可以幫我找到嗶羅，",
          "sc": "你可不可以帮我找到哔罗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248170,
          "spk": "洋 (ヨウ)",
          "ja": "連れて帰ってきてあげられないかな",
          "tc": "再把牠帶回來這裡呢？",
          "sc": "再把它带回来这里呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248183,
          "spk": "驹子 (コマコ)",
          "ja": "ど、どうだろ……",
          "tc": "這、這個嘛……",
          "sc": "这、这个嘛……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248196,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、寝ないでお外で",
          "tc": "或許我該不睡覺，",
          "sc": "或许我该不睡觉，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248203,
          "spk": "洋 (ヨウ)",
          "ja": "待ってみようかな",
          "tc": "在外面等等看？",
          "sc": "在外面等等看？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4278,
      "rec_id": "TALK_ID_10_0301_015_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248221,
          "spk": "驹子 (コマコ)",
          "ja": "だ、だめだよ！",
          "tc": "不、不行啊！",
          "sc": "不、不行啊！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248228,
          "spk": "驹子 (コマコ)",
          "ja": "掟は守らないと……",
          "tc": "必須遵守規矩……",
          "sc": "必须遵守规矩……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248235,
          "spk": "驹子 (コマコ)",
          "ja": "また危ない目にあうよ",
          "tc": "不然妳又會遇上危險的。",
          "sc": "不然你又会遇上危险的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4279,
      "rec_id": "TALK_ID_10_0301_015_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248253,
          "spk": "洋 (ヨウ)",
          "ja": "でも……ピロちゃん、泣いてる",
          "tc": "可是……嗶羅在哭呀。",
          "sc": "可是……哔罗在哭呀。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248260,
          "spk": "洋 (ヨウ)",
          "ja": "……かわいそうだよ",
          "tc": "……牠好可憐。",
          "sc": "……它好可怜。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248273,
          "spk": "驹子 (コマコ)",
          "ja": "わかった、じゃあ私がヨウちゃんの代わりに",
          "tc": "我知道了，",
          "sc": "我知道了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248280,
          "spk": "驹子 (コマコ)",
          "ja": "ピロを見つけるよ",
          "tc": "我會替小洋找到嗶羅的。",
          "sc": "我会替小洋找到哔罗的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 248291,
          "spk": "驹子 (コマコ)",
          "ja": "連れて帰ることは、",
          "tc": "雖然不知道",
          "sc": "虽然不知道"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248298,
          "spk": "驹子 (コマコ)",
          "ja": "できるかわからないけど……",
          "tc": "能不能把牠帶回來……",
          "sc": "能不能把它带回来……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 248305,
          "spk": "驹子 (コマコ)",
          "ja": "もしかしたら、慰めるくらいならできるかも……",
          "tc": "但或許能給牠一些慰藉……",
          "sc": "但或许能给它一些慰藉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4280,
      "rec_id": "TALK_ID_10_0301_015_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248323,
          "spk": "洋 (ヨウ)",
          "ja": "ほんとに？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248330,
          "spk": "洋 (ヨウ)",
          "ja": "コマコちゃん、助けてあげてくれるの？",
          "tc": "駒子姐姐願意去救嗶羅嗎？",
          "sc": "驹子姐姐愿意去救哔罗吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248343,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん、探してみるね",
          "tc": "呃、嗯，我會去找找看。",
          "sc": "呃、嗯，我会去找找看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4281,
      "rec_id": "TALK_ID_10_0301_015_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248365,
          "spk": "四郎治 (シロージ)",
          "ja": "おい、コマコ",
          "tc": "喂，駒子。",
          "sc": "喂，驹子。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4282,
      "rec_id": "TALK_ID_10_0301_015_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 248387,
          "spk": "驹子 (コマコ)",
          "ja": "ひゃっ……！",
          "tc": "哇……！？",
          "sc": "哇……！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 248394,
          "spk": "驹子 (コマコ)",
          "ja": "お、お兄ちゃん！",
          "tc": "哥、哥哥！",
          "sc": "哥、哥哥！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 248407,
          "spk": "四郎治 (シロージ)",
          "ja": "ヨウ、ニワトリの幽霊に悩まされてんのか？",
          "tc": "洋是因為雞的幽靈的事在煩惱嗎？",
          "sc": "洋是因为鸡的幽灵的事在烦恼吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 248414,
          "spk": "四郎治 (シロージ)",
          "ja": "困ったもんだな",
          "tc": "這還真是傷腦筋。",
          "sc": "这还真是伤脑筋。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 248434,
          "spk": "驹子 (コマコ)",
          "ja": "そうみたい……",
