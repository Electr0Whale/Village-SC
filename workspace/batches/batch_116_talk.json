      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45372,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45379,
          "spk": "茶梅 (サザンカ)",
          "ja": "なんか予定あんの？",
          "tc": "你有其他事嗎？",
          "sc": "你有其他事吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45390,
          "spk": "茶梅 (サザンカ)",
          "ja": "それか気分じゃない感じ？",
          "tc": "還是沒那個心情？",
          "sc": "还是没那个心情？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45397,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、そういう時もあるよね～",
          "tc": "的確也是有這種時候啦～",
          "sc": "的确也是有这种时候啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1189,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_SPECIAL_20_106_0080",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45428,
          "spk": "茶梅 (サザンカ)",
          "ja": "あのさ、今日はアタシ、",
          "tc": "那個啊，我今天",
          "sc": "那个啊，我今天"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45435,
          "spk": "茶梅 (サザンカ)",
          "ja": "誰かとお喋りしてたい気分なんよね～",
          "tc": "想要找人悠哉地聊聊天～",
          "sc": "想要找人悠哉地聊聊天～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45446,
          "spk": "茶梅 (サザンカ)",
          "ja": "ってことでさ、<player>",
          "tc": "所以說，<player>，",
          "sc": "所以说，<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45453,
          "spk": "茶梅 (サザンカ)",
          "ja": "今日はうちにお泊りとかどう？",
          "tc": "今天要不要來我家住一晚？",
          "sc": "今天要不要来我家住一晚？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45464,
          "spk": "茶梅 (サザンカ)",
          "ja": "新しい発明品とかさぁ、",
          "tc": "我這裡有不少",
          "sc": "我这里有不少"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45471,
          "spk": "茶梅 (サザンカ)",
          "ja": "そういうのいっぱいあるし",
          "tc": "新發明之類的東西，",
          "sc": "新发明之类的东西，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 45478,
          "spk": "茶梅 (サザンカ)",
          "ja": "楽しいと思うんだけどな～",
          "tc": "所以你來應該能玩得很開心喔～",
          "sc": "所以你来应该能玩得很开心哦～"
        },
        {
          "f_idx": 7,
          "pidx_tc": 45487,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 8,
          "pidx_tc": 45494,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1190,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_SPECIAL_20_106_0081",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45512,
          "spk": "茶梅 (サザンカ)",
          "ja": "おっ、いいね～",
          "tc": "哦，太好了～",
          "sc": "哦，太好了～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45519,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタのそういうノリがいいとこ好きだわ",
          "tc": "我就是很喜歡你這點。",
          "sc": "我就是很喜欢你这点。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45537,
          "spk": "茶梅 (サザンカ)",
          "ja": "んじゃ、午後６時になったらうち来てよ",
          "tc": "那你就晚上6點到我家來吧。",
          "sc": "那你就晚上6点到我家来吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45544,
          "spk": "茶梅 (サザンカ)",
          "ja": "布団とか着替えとかも用意しとくから",
          "tc": "棉被和換洗衣物我都會準備好的，",
          "sc": "棉被和换洗衣物我都会准备好的，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45551,
          "spk": "茶梅 (サザンカ)",
          "ja": "手ぶらで来ちゃっていいよ～",
          "tc": "所以兩手空空地來就可以囉～",
          "sc": "所以两手空空地来就行啦～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1191,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_SPECIAL_20_106_0082",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45573,
          "spk": "茶梅 (サザンカ)",
          "ja": "そっか～……",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45580,
          "spk": "茶梅 (サザンカ)",
          "ja": "ま、急だったししかたないか",
          "tc": "畢竟我約得很突然，所以也沒辦法。",
          "sc": "毕竟我约得很突然，所以也没办法。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45598,
          "spk": "茶梅 (サザンカ)",
          "ja": "って、もしかしてだけど……",
          "tc": "等等，該不會……",
          "sc": "等等，该不会……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45605,
          "spk": "茶梅 (サザンカ)",
          "ja": "片づいてないから来たくないとか……",
          "tc": "你是因為我沒有好好整理家裡……",
          "sc": "你是因为我没有好好整理家里……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45612,
          "spk": "茶梅 (サザンカ)",
          "ja": "そういうこと？",
          "tc": "所以才不想來嗎？",
          "sc": "所以才不想来吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1192,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45636,
          "spk": "茶梅 (サザンカ)",
          "ja": "あ～忙しい……",
          "tc": "啊～忙死了……",
          "sc": "啊～忙死了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45643,
          "spk": "茶梅 (サザンカ)",
          "ja": "イベントある日だったのにぃ～……",
          "tc": "明明是有活動的日子……",
          "sc": "明明是有活动的日子……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45654,
          "spk": "茶梅 (サザンカ)",
          "ja": "昨日、機械が暴走して火ィ吹いちゃって……",
          "tc": "昨天機器失控還燒起來……",
          "sc": "昨天机器失控还烧起来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45661,
          "spk": "茶梅 (サザンカ)",
          "ja": "バレるとまずくって……ハハハ……",
          "tc": "要是被發現就慘了……哈哈哈……",
          "sc": "要是被发现就惨了……哈哈哈……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1193,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45692,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねえ、<player>",
          "tc": "問你喔，<player>，",
          "sc": "问你哦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45699,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタは品評会に参加すんの？",
          "tc": "你會參加評鑑會嗎？",
          "sc": "你会参加评鉴会吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45710,
          "spk": "茶梅 (サザンカ)",
          "ja": "もしそうだとしたら",
          "tc": "如果是這樣的話，",
          "sc": "如果是这样的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45717,
          "spk": "茶梅 (サザンカ)",
          "ja": "俄然楽しみになってきたかも",
          "tc": "那就更令人期待了。",
          "sc": "那就更令人期待了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45724,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタならスゴイの出しそうだし",
          "tc": "感覺你會拿出不得了的東西呢。",
          "sc": "感觉你会拿出不得了的东西呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1194,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45748,
          "spk": "茶梅 (サザンカ)",
          "ja": "今年も晴れてよかったね～",
          "tc": "今年也是晴天真是太好啦～",
          "sc": "今年也是晴天真是太好啦～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45755,
          "spk": "茶梅 (サザンカ)",
          "ja": "お、<player>じゃん",
          "tc": "哦，這不是<player>嗎？",
          "sc": "哦，这不是<player>吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45766,
          "spk": "茶梅 (サザンカ)",
          "ja": "見てよ、飲み物も食べ物もいっぱい",
          "tc": "你快看，滿滿的食物和飲料。",
          "sc": "你快看，满满的食物和饮料。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45773,
          "spk": "茶梅 (サザンカ)",
          "ja": "オッサンだけじゃなくて、",
          "tc": "不只是大叔的料理，",
          "sc": "不只是大叔的料理，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45780,
          "spk": "茶梅 (サザンカ)",
          "ja": "みんなの持ち寄りだよ",
          "tc": "還有大家帶來的東西喔。",
          "sc": "还有大家带来的东西哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45791,
          "spk": "茶梅 (サザンカ)",
          "ja": "早く始まらないかな～",
          "tc": "能不能快點開始啊～",
          "sc": "能不能快点开始啊～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1195,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45815,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>はお花見好き？",
          "tc": "<player>，你喜歡賞花嗎？",
          "sc": "<player>，你喜欢赏花吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45822,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシはね～、意外と好きなんだ",
          "tc": "我的話～意外地還滿喜歡的呢。",
          "sc": "我的话～意外地还满喜欢的呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45829,
          "spk": "茶梅 (サザンカ)",
          "ja": "みんなでワイワイすんの楽しいし",
          "tc": "能和大家聚在一起吵吵鬧鬧的很開心。",
          "sc": "能和大家聚在一起吵吵闹闹的很开心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45840,
          "spk": "茶梅 (サザンカ)",
          "ja": "それにみんなお弁当に個性あってさ～",
          "tc": "而且每個人的便當也都很有個性～",
          "sc": "而且每个人的便当也都很有个性～"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45847,
          "spk": "茶梅 (サザンカ)",
          "ja": "お花だけじゃなくって",
          "tc": "所以除了賞花，",
          "sc": "所以除了赏花，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45854,
          "spk": "茶梅 (サザンカ)",
          "ja": "そういうの眺めるのも面白いんだよね～",
          "tc": "能看到這些東西也很有趣呢～",
          "sc": "能看到这些东西也很有趣呢～"
        },
        {
          "f_idx": 6,
          "pidx_tc": 45865,
          "spk": "茶梅 (サザンカ)",
          "ja": "って、楽しみ方が独特？",
          "tc": "我享受的方式很特別嗎？",
          "sc": "我享受的方式很特别吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 45872,
          "spk": "茶梅 (サザンカ)",
          "ja": "いいじゃん、別に～",
          "tc": "這樣又沒什麼不好的～",
          "sc": "这样又没什么不好的～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1196,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45903,
          "spk": "茶梅 (サザンカ)",
          "ja": "んー、射的の調子は……っと",
          "tc": "嗯～射擊遊戲的狀況……好。",
          "sc": "嗯～射击游戏的状况……好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45910,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>、まだ準備中だよ",
          "tc": "<player>，我還在準備中喔。",
          "sc": "<player>，我还在准备中哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45928,
          "spk": "茶梅 (サザンカ)",
          "ja": "今年もたくさん景品用意したよ",
          "tc": "今年也準備了很多獎品，",
          "sc": "今年也准备了很多奖品，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45935,
          "spk": "茶梅 (サザンカ)",
          "ja": "もらえるものは……当たるまで秘密だからね",
          "tc": "至於獎品內容……在獲得前都是祕密啦。",
          "sc": "至于奖品内容……在获得前都是秘密啦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 45942,
          "spk": "茶梅 (サザンカ)",
          "ja": "後でまたおいでよ",
          "tc": "之後再來看看喔。",
          "sc": "之后再来看看哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1197,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 45966,
          "spk": "茶梅 (サザンカ)",
          "ja": "いらっしゃ～い",
          "tc": "歡迎光臨～",
          "sc": "欢迎光临～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 45973,
          "spk": "茶梅 (サザンカ)",
          "ja": "お客さん、射的やってかない？",
          "tc": "這位客人，要不要玩射擊遊戲啊？",
          "sc": "这位客人，要不要玩射击游戏啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 45984,
          "spk": "茶梅 (サザンカ)",
          "ja": "豪華な景品もたくさんそろえたし",
          "tc": "我準備了很多豪華獎品，",
          "sc": "我准备了很多豪华奖品，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 45991,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>にならサービスして",
          "tc": "是<player>的話，",
          "sc": "是<player>的话，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 45998,
          "spk": "茶梅 (サザンカ)",
          "ja": "弾数多めに渡しちゃうよ～？",
          "tc": "我還能免費多送你幾發子彈喔～？",
          "sc": "我还能免费多送你几发子弹哦～？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 46009,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、いっぱい商品倒して",
          "tc": "所以就請你盡量多打中一些商品，",
          "sc": "所以就请你尽量多打中一些商品，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 46016,
          "spk": "茶梅 (サザンカ)",
          "ja": "ぜひとも店の在庫処分に……",
          "tc": "幫忙清掉我店裡的庫存……",
          "sc": "帮忙清掉我店里的库存……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 46023,
          "spk": "茶梅 (サザンカ)",
          "ja": "ううん、なんでもない",
          "tc": "不，沒什麼。",
          "sc": "不，没什么。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 1198,
      "rec_id": "TALK_ID_GENERAL_STORE_MANAGER_HOLIDAY_20_106_0130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 46047,
          "spk": "茶梅 (サザンカ)",
          "ja": "んー……焼きいもの焚き火って",
          "tc": "嗯……烤地瓜的篝火，",
          "sc": "嗯……烤红薯的篝火，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 46054,
          "spk": "茶梅 (サザンカ)",
          "ja": "このくらいでいいのかな？",
          "tc": "這樣應該就可以了吧？",
          "sc": "这样应该就可以了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 46072,
          "spk": "茶梅 (サザンカ)",
          "ja": "毎年やってるけど",
          "tc": "雖然每年都要準備，",
          "sc": "虽然每年都要准备，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 46079,
          "spk": "茶梅 (サザンカ)",
          "ja": "全然なれないんだよなぁ……",
          "tc": "但依然不熟悉呢……",
          "sc": "但依然不熟悉呢……"
        }
      ]
