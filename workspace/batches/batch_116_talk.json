      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 36961,
          "spk": "驹子 (コマコ)",
          "ja": "わっ、<player>！",
          "tc": "哇，<player>！",
          "sc": "哇，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 36968,
          "spk": "驹子 (コマコ)",
          "ja": "こんな雨の日にどうしたの？",
