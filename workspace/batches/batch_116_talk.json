      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 36530,
          "spk": "驹子 (コマコ)",
          "ja": "えっ、私にプレゼント？",
          "tc": "咦？給我的禮物？",
          "sc": "咦？给我的礼物？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 36537,
          "spk": "驹子 (コマコ)",
          "ja": "もらっちゃっていいのかな……",
          "tc": "我可以收下嗎……",
          "sc": "我可以收下吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 36548,
          "spk": "驹子 (コマコ)",
          "ja": "……わあ！",
          "tc": "……哇！",
          "sc": "……哇！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 36555,
          "spk": "驹子 (コマコ)",
          "ja": "これ、私がすごく好きなもの……",
          "tc": "我超喜歡這個的……",
          "sc": "我超喜欢这个的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 36562,
          "spk": "驹子 (コマコ)",
          "ja": "もしかして、知っててくれたの？",
          "tc": "難道說你知道我喜歡這個？",
          "sc": "难道说你知道我喜欢这个？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 36573,
          "spk": "驹子 (コマコ)",
          "ja": "ありがとう、<player>！",
          "tc": "謝謝你，<player>！",
          "sc": "谢谢你，<player>！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 36580,
          "spk": "驹子 (コマコ)",
          "ja": "まさかこんな良いものを",
          "tc": "沒想到能收到",
          "sc": "没想到能收到"
        },
        {
          "f_idx": 7,
          "pidx_tc": 36587,
          "spk": "驹子 (コマコ)",
          "ja": "もらえるなんて思わなかったよ",
          "tc": "這麼好的禮物。",
          "sc": "这么好的礼物。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 36598,
          "spk": "驹子 (コマコ)",
          "ja": "良かったら<player>の欲しいものも",
          "tc": "如果可以的話，<player>，",
          "sc": "如果可以的话，<player>，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 36605,
          "spk": "驹子 (コマコ)",
          "ja": "教えてもらいたいな",
          "tc": "我也想知道你喜歡什麼，",
          "sc": "我也想知道你喜欢什么，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 36612,
          "spk": "驹子 (コマコ)",
          "ja": "今度お礼にお返しするよ",
          "tc": "下次我會回禮給你的。",
          "sc": "下次我会回礼给你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
