      "rec_id": "TALK_ID_HUNTER_PRESENT_20_105_0201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 36636,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、私にプレゼントくれるの？",
          "tc": "<player>，你要送我禮物嗎？",
          "sc": "<player>，你要送我礼物吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 36647,
          "spk": "驹子 (コマコ)",
          "ja": "あ、これ……",
          "tc": "啊，這個……",
          "sc": "啊，这个……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 36654,
          "spk": "驹子 (コマコ)",
          "ja": "いいのかな、私がもらっちゃっても",
          "tc": "我真的可以收下嗎？",
          "sc": "我真的可以收下吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 36665,
          "spk": "驹子 (コマコ)",
          "ja": "……そっか、私のために準備してくれたんだ",
          "tc": "……這樣啊，這是你特地為我準備的。",
          "sc": "……这样啊，这是你特地为我准备的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 36672,
          "spk": "驹子 (コマコ)",
          "ja": "それじゃ、ありがたくいただくね",
          "tc": "那我就感激地收下了。",
          "sc": "那我就感激地收下了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 36683,
          "spk": "驹子 (コマコ)",
          "ja": "代わりってわけじゃないけど",
          "tc": "不知道能不能算是回禮，",
          "sc": "不知道能不能算是回礼，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 36690,
          "spk": "驹子 (コマコ)",
          "ja": "私に手伝えることがあったら",
          "tc": "但如果有我可以幫上忙的事，",
          "sc": "但如果有我可以帮上忙的事，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 36697,
          "spk": "驹子 (コマコ)",
          "ja": "なんでも言ってね",
          "tc": "你都可以來找我幫忙喔。",
          "sc": "你都可以来找我帮忙哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
