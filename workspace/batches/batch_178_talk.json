  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3996,
      "rec_id": "TALK_ID_10_0201_011_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 226809,
          "spk": "？？？ (未知角色)",
          "ja": "あなたは……最近こちらにいらした",
          "tc": "您是……最近來到這裡的",
          "sc": "您是……最近来到这里的"
        },
        {
          "f_idx": 1,
          "pidx_tc": 226816,
          "spk": "？？？ (未知角色)",
          "ja": "<player>さんですね？",
          "tc": "<player>，沒錯吧？",
          "sc": "<player>，没错吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 226827,
          "spk": "名护 (ナゴ)",
          "ja": "わたくし、市で勤めております",
          "tc": "我任職於市公所，",
          "sc": "我任职于市政厅，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 226834,
          "spk": "名护 (ナゴ)",
          "ja": "「名護」という者です",
          "tc": "名叫「名護」。",
          "sc": "名叫“名护”。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 226843,
          "spk": "名护 (ナゴ)",
          "ja": "本日は<player>さんに、",
          "tc": "今天前來拜訪<player>，",
          "sc": "今天前来拜访<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 226850,
          "spk": "名护 (ナゴ)",
          "ja": "お得なご案内がありまして……",
          "tc": "是有一件相當划算的情報……",
          "sc": "是有一件相当划算的情报……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 226857,
          "spk": "名护 (ナゴ)",
          "ja": "訪問させていただいたのです",
          "tc": "要向您介紹。",
          "sc": "要向您介绍。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 226868,
          "spk": "名护 (ナゴ)",
          "ja": "といいますのも、",
          "tc": "之所以這麼說，",
          "sc": "之所以这么说，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 226875,
          "spk": "名护 (ナゴ)",
          "ja": "このあたりの土地は",
          "tc": "是因為這一帶的土地，",
          "sc": "是因为这一带的土地，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 226882,
          "spk": "名护 (ナゴ)",
          "ja": "市でも管理の手が回っておらず……",
          "tc": "目前市公所還無暇管理……",
          "sc": "目前市政厅还无暇管理……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 226891,
          "spk": "名护 (ナゴ)",
          "ja": "正直に申しますと、",
          "tc": "老實說，",
          "sc": "老实说，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 226898,
          "spk": "名护 (ナゴ)",
          "ja": "今、この村は危機に瀕してまして……",
          "tc": "由於這村子面臨著危機……",
          "sc": "由于这村子面临着危机……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 226905,
          "spk": "名护 (ナゴ)",
          "ja": "運用価値が低いとみなされているのです",
          "tc": "被認為沒什麼運用價值。",
          "sc": "被认为没什么运用价值。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 226916,
          "spk": "名护 (ナゴ)",
          "ja": "そこで、市でこの土地を買い上げて、",
          "tc": "有鑑於此，市公所擬定了新計畫，",
          "sc": "有鉴于此，市政厅拟定了新计划，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 226923,
          "spk": "名护 (ナゴ)",
          "ja": "ソーラーパネルを設置するという計画を、",
          "tc": "打算收購這片土地",
          "sc": "打算收购这片土地"
        },
        {
          "f_idx": 15,
          "pidx_tc": 226930,
          "spk": "名护 (ナゴ)",
          "ja": "立ち上げたのです！",
          "tc": "用來設置太陽能板！",
          "sc": "用来设置太阳能板！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 226941,
          "spk": "名护 (ナゴ)",
          "ja": "このプロジェクトが完了した暁には、",
          "tc": "一旦這個專案完成，",
          "sc": "一旦这个专案完成，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 226948,
          "spk": "名护 (ナゴ)",
          "ja": "現在払っていただいている電気代が、",
          "tc": "預計各位目前繳納的電費",
          "sc": "预计各位目前缴纳的电费"
        },
        {
          "f_idx": 18,
          "pidx_tc": 226955,
          "spk": "名护 (ナゴ)",
          "ja": "なんと、20％も削減される見積りです！",
          "tc": "可以減免20%！",
          "sc": "可以减免20%！"
        },
        {
          "f_idx": 19,
          "pidx_tc": 226964,
          "spk": "名护 (ナゴ)",
          "ja": "もちろん、わたくしどもは",
          "tc": "當然，我們不會妨礙到",
          "sc": "当然，我们不会妨碍到"
        },
        {
          "f_idx": 20,
          "pidx_tc": 226971,
          "spk": "名护 (ナゴ)",
          "ja": "あなたの暮らしを妨げたりしませんし、",
          "tc": "各位的生活，",
          "sc": "各位的生活，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 226978,
          "spk": "名护 (ナゴ)",
          "ja": "この豊かな自然も、維持していく所存です",
          "tc": "也會維持這裡自然豐富的環境。",
          "sc": "也会维持这里自然丰富的环境。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3997,
      "rec_id": "TALK_ID_10_0201_011_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 226996,
          "spk": "名护 (ナゴ)",
          "ja": "しかし、こんなに広い土地、",
          "tc": "但如此寬廣的土地，",
          "sc": "但如此宽广的土地，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227003,
          "spk": "名护 (ナゴ)",
          "ja": "有効活用しないと",
          "tc": "如果不有效利用的話，",
          "sc": "如果不有效利用的话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227010,
          "spk": "名护 (ナゴ)",
          "ja": "宝の持ち腐れではないでしょうか",
          "tc": "豈不是暴殄天物嗎？",
          "sc": "岂不是暴殄天物吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3998,
      "rec_id": "TALK_ID_10_0201_011_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227028,
          "spk": "名护 (ナゴ)",
          "ja": "どうでしょう？",
          "tc": "您意下如何呢？",
          "sc": "您意下如何呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227035,
          "spk": "名护 (ナゴ)",
          "ja": "悪い話ではありませんよ？",
          "tc": "這應該不是件壞事吧？",
          "sc": "这应该不是件坏事吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227044,
          "spk": "名护 (ナゴ)",
          "ja": "この土地全てとは言いませんが、",
          "tc": "我們並不是要所有的土地，",
          "sc": "我们并不是要所有的土地，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227051,
          "spk": "名护 (ナゴ)",
          "ja": "少しでも、ソーラーパネルの設置に",
          "tc": "能不能請您稍微配合一下，",
          "sc": "能不能请您稍微配合一下，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 227058,
          "spk": "名护 (ナゴ)",
          "ja": "ご協力いただけませんか……？",
          "tc": "協助設置一些太陽能板呢？",
          "sc": "协助设置一些太阳能板呢？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 227067,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 227074,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3999,
      "rec_id": "TALK_ID_10_0201_011_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227162,
          "spk": "林 (リン)",
          "ja": "こらぁーーーっ！！",
          "tc": "喂～～！！",
          "sc": "喂～～！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4000,
      "rec_id": "TALK_ID_10_0201_011_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227184,
          "spk": "名护 (ナゴ)",
          "ja": "ゲッ……",
          "tc": "呃……",
          "sc": "呃……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227195,
          "spk": "林 (リン)",
          "ja": "なんであなたが",
          "tc": "你為什麼",
          "sc": "你为什么"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227202,
          "spk": "林 (リン)",
          "ja": "こんな所にいるのかしら！",
          "tc": "會在這裡！？",
          "sc": "会在这里！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227215,
          "spk": "名护 (ナゴ)",
          "ja": "そ、それはもちろん、",
          "tc": "這、這當然是因為我",
          "sc": "这、这当然是因为我"
        },
        {
          "f_idx": 4,
          "pidx_tc": 227222,
          "spk": "名护 (ナゴ)",
          "ja": "お得なご案内のために……",
          "tc": "帶來了相當划算的情報……",
          "sc": "带来了相当划算的情报……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 227235,
          "spk": "林 (リン)",
          "ja": "この子に営業かけても無駄ですわよ",
          "tc": "你對這孩子推銷也是沒用的，",
          "sc": "你对这孩子推销也是没用的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 227242,
          "spk": "林 (リン)",
          "ja": "この土地は、この私が貸してるだけですから",
          "tc": "因為這片土地是我租給他的。",
          "sc": "因为这片土地是我租给他的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 227262,
          "spk": "名护 (ナゴ)",
          "ja": "な……",
          "tc": "什……",
          "sc": "什……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4001,
      "rec_id": "TALK_ID_10_0201_011_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227280,
          "spk": "名护 (ナゴ)",
          "ja": "そういうことは、",
          "tc": "這種事",
          "sc": "这种事"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227287,
          "spk": "名护 (ナゴ)",
          "ja": "先に言ってくださいよ！",
          "tc": "您應該先說清楚呀！",
          "sc": "您应该先说清楚呀！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227300,
          "spk": "林 (リン)",
          "ja": "フン……！",
          "tc": "哼……！",
          "sc": "哼……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227307,
          "spk": "林 (リン)",
          "ja": "無駄足だってわかったなら、",
          "tc": "既然知道是白費功夫了，",
          "sc": "既然知道是白费功夫了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 227314,
          "spk": "林 (リン)",
          "ja": "さっさと帰ってくださいまし",
          "tc": "那就快點給我回去吧。",
          "sc": "那就快点给我回去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4002,
      "rec_id": "TALK_ID_10_0201_011_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227332,
          "spk": "名护 (ナゴ)",
          "ja": "突然の訪問、失礼しました",
          "tc": "抱歉這麼突然來訪。",
          "sc": "抱歉这么突然来访。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227339,
          "spk": "名护 (ナゴ)",
          "ja": "でも……今日の話、",
          "tc": "不過……今天講的這些話，",
          "sc": "不过……今天讲的这些话，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227346,
          "spk": "名护 (ナゴ)",
          "ja": "覚えておいてくださいね",
          "tc": "還請您放在心上。",
          "sc": "还请您放在心上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227357,
          "spk": "名护 (ナゴ)",
          "ja": "あなたからも村長さんを、",
          "tc": "如果您也能一起",
          "sc": "如果您也能一起"
        },
        {
          "f_idx": 4,
          "pidx_tc": 227364,
          "spk": "名护 (ナゴ)",
          "ja": "説得していただけるとありがたいのですが……",
          "tc": "幫忙說服村長就太感謝了……",
          "sc": "帮忙说服村长就太感谢了……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 227384,
          "spk": "林 (リン)",
          "ja": "無駄な話を持ちかける前に、",
          "tc": "與其搞這種無謂的交涉，",
          "sc": "与其搞这种无谓的交涉，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 227391,
          "spk": "林 (リン)",
          "ja": "さっさと市の仕事に戻ったらいかがかしら？",
          "tc": "還不如趕快回去做你市公所的工作吧。",
          "sc": "还不如赶快回去做你市政厅的工作吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4003,
      "rec_id": "TALK_ID_10_0201_011_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227416,
          "spk": "名护 (ナゴ)",
          "ja": "これもれっきとした市の仕事ですので！",
          "tc": "這也是正正經經的市公所的工作！",
          "sc": "这也是正正经经的市政厅的工作！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4004,
      "rec_id": "TALK_ID_10_0201_011_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227434,
          "spk": "名护 (ナゴ)",
          "ja": "それではまた",
          "tc": "那麼，下次見。",
          "sc": "那么，下次见。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227441,
          "spk": "名护 (ナゴ)",
          "ja": "失礼します",
          "tc": "告辭了。",
          "sc": "告辞了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4005,
      "rec_id": "TALK_ID_10_0201_011_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227465,
          "spk": "林 (リン)",
          "ja": "まったく",
          "tc": "真是的。",
          "sc": "真是的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227476,
          "spk": "林 (リン)",
          "ja": "あの人が、こっちに向かうのを見て、",
          "tc": "我看到那個人往這邊走，",
          "sc": "我看到那个人往这边走，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227483,
          "spk": "林 (リン)",
          "ja": "慌てて追いかけてみたら……",
          "tc": "就急忙追了過來……",
          "sc": "就急忙追了过来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227490,
          "spk": "林 (リン)",
          "ja": "あなたにまで言い寄ってくるとは……",
          "tc": "真沒想到他居然纏上你……",
          "sc": "真没想到他居然缠上你……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4006,
      "rec_id": "TALK_ID_10_0201_011_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227508,
          "spk": "林 (リン)",
          "ja": "まあでも、変な事吹き込まれる前に",
          "tc": "還好在你被他灌輸奇怪的想法之前",
          "sc": "还好在你被他灌输奇怪的想法之前"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227515,
          "spk": "林 (リン)",
          "ja": "気が付いてよかったわ",
          "tc": "就成功阻止了他。",
          "sc": "就成功阻止了他。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227526,
          "spk": "林 (リン)",
          "ja": "じゃ、用は済んだから、もう帰るわね",
          "tc": "既然事情已解決，我就先回去了。",
          "sc": "既然事情已解决，我就先回去了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 227533,
          "spk": "林 (リン)",
          "ja": "お邪魔して悪かったわ",
          "tc": "抱歉打擾到你。",
          "sc": "抱歉打扰到你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4007,
      "rec_id": "TALK_ID_10_0201_012_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227553,
          "spk": "莲实 (ハスミ)",
          "ja": "こ……困ります",
          "tc": "這……這樣我很困擾，",
          "sc": "这……这样我很困扰，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227560,
          "spk": "莲实 (ハスミ)",
          "ja": "私に言われましても……",
          "tc": "就算你這麼說……",
          "sc": "就算你这么说……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4008,
      "rec_id": "TALK_ID_10_0201_012_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 227582,
          "spk": "名护 (ナゴ)",
          "ja": "そ、そう言われると、",
          "tc": "您、您這樣",
          "sc": "您、您这样"
        },
        {
          "f_idx": 1,
          "pidx_tc": 227589,
          "spk": "名护 (ナゴ)",
          "ja": "こちらが悪いことを",
          "tc": "搞得好像",
          "sc": "搞得好像"
        },
        {
          "f_idx": 2,
          "pidx_tc": 227596,
          "spk": "名护 (ナゴ)",
          "ja": "しているみたいじゃないですか",
          "tc": "我在做什麼壞事一樣。",
