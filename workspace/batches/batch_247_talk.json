    {
      "file": "talk.dat",
      "rec_idx": 6765,
      "rec_id": "TALK_ID_70_2020_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387785,
          "spk": "帷 (トバリ)",
          "ja": "<player>……なんの用？",
          "tc": "<player>……有什麼事嗎？",
          "sc": "<player>……有什么事吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6766,
      "rec_id": "TALK_ID_70_2020_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387803,
          "spk": "帷 (トバリ)",
          "ja": "アンタもわざわざこんな場所まで来るなんて……",
          "tc": "你居然會特地跑到這種地方來……",
          "sc": "你居然会特地跑到这种地方来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387810,
          "spk": "帷 (トバリ)",
          "ja": "よっぽど暇なのね",
          "tc": "看來是滿閒的嘛。",
          "sc": "看来是满闲的嘛。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387821,
          "spk": "帷 (トバリ)",
          "ja": "私は……別に何かしてるってワケじゃない",
          "tc": "我……沒在做什麼。",
          "sc": "我……没在做什么。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387828,
          "spk": "帷 (トバリ)",
          "ja": "ただ、川を眺めてぼんやりしてただけ",
          "tc": "就只是在看著河而已。",
          "sc": "就只是在看着河而已。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 387846,
          "spk": "帷 (トバリ)",
          "ja": "……学校に行ってるワケでもない",
          "tc": "……我沒有去上學，",
          "sc": "……我没有去上学，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 387853,
          "spk": "帷 (トバリ)",
          "ja": "仕事をしてるワケでもない",
          "tc": "也沒有在工作。",
          "sc": "也没有在工作。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 387862,
          "spk": "帷 (トバリ)",
          "ja": "特にしたいことがあるワケでもないし",
          "tc": "也沒有什麼特別想做的事，",
          "sc": "也没有什么特别想做的事，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 387869,
          "spk": "帷 (トバリ)",
          "ja": "こうして時間を持て余してる",
          "tc": "有一堆時間都不知道該怎麼打發……",
          "sc": "有一堆时间都不知道该怎么打发……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 387887,
          "spk": "帷 (トバリ)",
          "ja": "毎日毎日無駄な時間を過ごしてる……",
          "tc": "每天都在過這種沒有意義的日子……",
          "sc": "每天都在过这种没有意义的日子……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 387894,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……私の青春、これでいいのかな……",
          "tc": "唉……我的青春就這樣度過，真的沒問題嗎……",
          "sc": "唉……我的青春就这样度过，真的没问题吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6767,
      "rec_id": "TALK_ID_70_2020_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387919,
          "spk": "帷 (トバリ)",
          "ja": "……この村はまるで、時が止まったみたい",
          "tc": "……這個村子的時間就像是停止了一樣。",
          "sc": "……这个村子的时间就像是停止了一样。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387937,
          "spk": "帷 (トバリ)",
          "ja": "ずっとここにいたら",
          "tc": "感覺如果一直待在這裡，",
          "sc": "感觉如果一直待在这里，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387944,
          "spk": "帷 (トバリ)",
          "ja": "世界から取り残されてしまいそう……",
          "tc": "會被世界拋在後頭……",
          "sc": "会被世界抛在后头……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 387955,
          "spk": "帷 (トバリ)",
          "ja": "アンタ、この村以外に居場所ってある？",
          "tc": "你除了這個村子，還有其他可以回去的地方嗎？",
          "sc": "你除了这个村子，还有其他可以回去的地方吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6768,
      "rec_id": "TALK_ID_70_2020_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387986,
          "spk": "帷 (トバリ)",
          "ja": "私は……たぶん、ない",
          "tc": "我的話……大概是沒有。",
          "sc": "我的话……大概是没有。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387995,
          "spk": "帷 (トバリ)",
          "ja": "退屈なこの村から出たところで",
          "tc": "即便離開了這無聊的村子，",
          "sc": "即便离开了这无聊的村子，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388002,
          "spk": "帷 (トバリ)",
          "ja": "行くあてなんてどこにもない",
          "tc": "我也無處可去。",
          "sc": "我也无处可去。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388013,
          "spk": "帷 (トバリ)",
          "ja": "だから結局、村に残る以外",
          "tc": "所以到頭來，",
          "sc": "所以到头来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 388020,
          "spk": "帷 (トバリ)",
          "ja": "私に選択肢なんてないの",
          "tc": "我唯一的選擇只有留在這個村子裡。",
          "sc": "我唯一的选择只有留在这个村子里。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6769,
      "rec_id": "TALK_ID_70_2020_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388038,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388045,
          "spk": "帷 (トバリ)",
          "ja": "私は、何をしたいんだろう……",
          "tc": "我到底想做什麼呢……",
          "sc": "我到底想做什么呢……"
