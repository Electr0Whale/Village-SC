  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6759,
      "rec_id": "TALK_ID_70_2020_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387392,
          "spk": "帷 (トバリ)",
          "ja": "教養を身につけたいの",
          "tc": "我想多學點東西。",
          "sc": "我想多学点东西。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387399,
          "spk": "帷 (トバリ)",
          "ja": "この村の、どこか気の抜けた大人たちみたいには",
          "tc": "我可不想要變的跟村子裡那些",
          "sc": "我可不想要变的跟村子里那些"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387406,
          "spk": "帷 (トバリ)",
          "ja": "なりたくないから",
          "tc": "有點散漫的大人們一樣。",
          "sc": "有点散漫的大人们一样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6760,
      "rec_id": "TALK_ID_70_2020_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387424,
          "spk": "帷 (トバリ)",
          "ja": "アンタも、村仕事ばかりじゃなくて",
          "tc": "你也是，別老是忙村裡的工作，",
          "sc": "你也是，别老是忙村里的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387431,
          "spk": "帷 (トバリ)",
          "ja": "たまには本でも読んだら？",
          "tc": "偶爾也讀點書好嗎？",
          "sc": "偶尔也读点书好吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387449,
          "spk": "帷 (トバリ)",
          "ja": "頭を使わないと、",
          "tc": "不好好動腦，",
          "sc": "不好好动脑，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 387456,
          "spk": "帷 (トバリ)",
          "ja": "自分で考えられない人間になるかもよ",
          "tc": "搞不好會變成無法獨立思考的人喔。",
          "sc": "说不定会变成无法独立思考的人。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 387463,
          "spk": "帷 (トバリ)",
          "ja": "誰かの言うことを、そのまま信じるだけの",
          "tc": "變成一個只會照他人意思去做的人。",
          "sc": "变成一个只会照他人意思去做的人。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 387474,
          "spk": "帷 (トバリ)",
          "ja": "「晴耕雨読」って知ってる？",
          "tc": "你聽說過「晴耕雨讀」嗎？",
          "sc": "你听说过“晴耕雨读”吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 387481,
          "spk": "帷 (トバリ)",
          "ja": "晴れた日は働いて、雨の日は本を読む……",
          "tc": "晴天勞作，雨天讀書……",
          "sc": "晴天劳作，雨天读书……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 387488,
          "spk": "帷 (トバリ)",
          "ja": "……そういう生き方",
          "tc": "……就是那樣的生活方式。",
          "sc": "……就是那样的生活方式。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 387499,
          "spk": "帷 (トバリ)",
          "ja": "……まあ、アンタは雨でも構わず、",
          "tc": "……不過你即使是下雨天，",
          "sc": "……不过你即使是下雨天，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 387506,
          "spk": "帷 (トバリ)",
          "ja": "走り回ってそうだけど",
          "tc": "也到處跑呢。",
          "sc": "也到处跑呢。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 387524,
          "spk": "帷 (トバリ)",
          "ja": "毎日楽しそうにしてるけど……",
          "tc": "好像每天都過得很開心……",
          "sc": "好像每天都过得很开心……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 387531,
          "spk": "帷 (トバリ)",
          "ja": "アンタはここでの暮らしに満足してるの？",
          "tc": "你很滿意這裡的生活嗎？",
          "sc": "你很满意这里的生活吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6761,
      "rec_id": "TALK_ID_70_2020_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387556,
          "spk": "帷 (トバリ)",
          "ja": "聞くまでもないか",
          "tc": "看來問這個是多餘的，",
          "sc": "看来问这个是多余的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387563,
          "spk": "帷 (トバリ)",
          "ja": "今更な質問だったわね……",
          "tc": "答案都這麼明顯了……",
          "sc": "答案都这么明显了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387574,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ……仲のいい人……",
          "tc": "那我問你……你有跟誰感情比較好嗎？",
          "sc": "那我问你……你有跟谁感情比较好吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387581,
          "spk": "帷 (トバリ)",
          "ja": "たとえば友達とか……アンタにはいるの？",
          "tc": "有交到朋友嗎？",
          "sc": "有交到朋友吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 387597,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "有",
          "sc": "有"
        },
        {
          "f_idx": 6,
          "pidx_tc": 387604,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6762,
      "rec_id": "TALK_ID_70_2020_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387683,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ、<player>……",
          "tc": "那，<player>……",
          "sc": "那，<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 387690,
          "spk": "帷 (トバリ)",
          "ja": "アンタってもしかして……",
          "tc": "你該不會……",
          "sc": "你该不会……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 387701,
          "spk": "帷 (トバリ)",
          "ja": "……って、もういいか",
          "tc": "……算了。",
          "sc": "……算了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 387712,
          "spk": "帷 (トバリ)",
          "ja": "話は終わり",
          "tc": "這個話題就到此為止。",
          "sc": "这个话题就到此为止。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 387719,
          "spk": "帷 (トバリ)",
          "ja": "私は読書に戻りたいの",
          "tc": "我想要繼續看書了。",
          "sc": "我想要继续看书了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6763,
      "rec_id": "TALK_ID_70_2020_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 387737,
          "spk": "帷 (トバリ)",
          "ja": "……ほら、ここ以外のどこかにいきなさい",
          "tc": "……請你去其他地方吧。",
          "sc": "……请你去其他地方吧。"
        }
      ]
    },
