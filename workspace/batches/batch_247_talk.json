    {
      "file": "talk.dat",
      "rec_idx": 6771,
      "rec_id": "TALK_ID_70_2020_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388087,
          "spk": "帷 (トバリ)",
          "ja": "……ねえ、<player>",
          "tc": "……我問你，<player>。",
          "sc": "……我问你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388094,
          "spk": "帷 (トバリ)",
          "ja": "この川の水は、どこへ流れていくのか知ってる？",
          "tc": "你知道這條河會流向哪裡嗎？",
          "sc": "你知道这条河会流向哪里吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6772,
      "rec_id": "TALK_ID_70_2020_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388112,
          "spk": "帷 (トバリ)",
          "ja": "……なんとなく考えてたの",
          "tc": "……我只是在想，",
          "sc": "……我只是在想，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388119,
          "spk": "帷 (トバリ)",
          "ja": "村の外に流れて……",
          "tc": "它流向村外……",
          "sc": "它流向村外……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388126,
          "spk": "帷 (トバリ)",
          "ja": "麓の街まで繋がってるのかな……って",
          "tc": "會通往山腳的城鎮嗎……",
          "sc": "会通往山脚的城镇吗……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388137,
          "spk": "帷 (トバリ)",
          "ja": "そんなことを考えていたからか、",
          "tc": "然後想著想著，",
          "sc": "然后想着想着，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 388144,
          "spk": "帷 (トバリ)",
          "ja": "昔のことを思い出したの……",
          "tc": "就回想起了一些往事……",
          "sc": "就回想起了一些往事……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 388151,
          "spk": "帷 (トバリ)",
          "ja": "都会で暮らしていた頃のことを……",
          "tc": "想起我還在都市生活時的事……",
          "sc": "想起我还在都市生活时的事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6773,
      "rec_id": "TALK_ID_70_2020_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388175,
          "spk": "帷 (トバリ)",
          "ja": "私、この村に来る前は……",
          "tc": "我來到這個村子之前……",
          "sc": "我来到这个村子之前……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388182,
          "spk": "帷 (トバリ)",
          "ja": "都会の養護施設で育てられてたの",
          "tc": "是在都市的育幼院長大的。",
          "sc": "是在都市的育幼院长大的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6774,
      "rec_id": "TALK_ID_70_2020_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388200,
          "spk": "帷 (トバリ)",
          "ja": "……親の顔なんて見たことない",
          "tc": "……我沒看過父母的臉，",
          "sc": "……我没看过父母的脸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388207,
          "spk": "帷 (トバリ)",
          "ja": "覚えてるのは、施設の人だけ",
          "tc": "只記得育幼院裡的人。",
          "sc": "只记得育幼院里的人。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388225,
          "spk": "帷 (トバリ)",
          "ja": "あとは、同年代の友達くらい……",
          "tc": "還有就是同輩的朋友……",
          "sc": "还有就是同辈的朋友……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 388243,
          "spk": "帷 (トバリ)",
          "ja": "中学に通っていた時は、仲のいい友達もいたの",
          "tc": "我上國中的時候，也有感情不錯的朋友，",
          "sc": "我上国中的时候，也有感情不错的朋友，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 388250,
          "spk": "帷 (トバリ)",
          "ja": "一緒に進学しようと約束してた",
