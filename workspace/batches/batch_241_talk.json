      "rec_idx": 6464,
      "rec_id": "TALK_ID_70_0120_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370469,
          "spk": "裕太 (ユータ)",
          "ja": "……家？",
          "tc": "……有房子？",
          "sc": "……有房子？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370476,
          "spk": "裕太 (ユータ)",
          "ja": "な、なんで、こんな山の中に……？",
          "tc": "為、為、為什麼這種山裡會有房子……？",
          "sc": "为、为、为什么这种山里会有房子……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370485,
          "spk": "裕太 (ユータ)",
          "ja": "誰か住んでるのかな……",
          "tc": "有人住在裡面嗎……",
          "sc": "有人住在里面吗……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 370492,
          "spk": "裕太 (ユータ)",
          "ja": "でも、それらしい人を",
          "tc": "但是我在村子裡，",
          "sc": "但是我在村子里，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 370499,
          "spk": "裕太 (ユータ)",
          "ja": "村で見たことないんだけど……",
          "tc": "從來沒見過那樣的人啊……",
          "sc": "从来没见过那样的人啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6465,
      "rec_id": "TALK_ID_70_0120_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370517,
          "spk": "裕太 (ユータ)",
          "ja": "……声、ここから聞こえるよね？",
          "tc": "歌聲……是從這邊傳來的吧？",
          "sc": "歌声……是从这边传来的吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370524,
          "spk": "裕太 (ユータ)",
          "ja": "でもこの家、中に人が居ると思う……？",
          "tc": "你覺得這間房子有人住嗎……？",
          "sc": "你觉得这间房子有人住吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6466,
      "rec_id": "TALK_ID_70_0120_003_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370549,
          "spk": "裕太 (ユータ)",
          "ja": "……そうだよね",
          "tc": "……說得也是。",
          "sc": "……说得也是。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370556,
          "spk": "裕太 (ユータ)",
          "ja": "だとしても……",
          "tc": "就算這樣……",
          "sc": "就算这样……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370563,
          "spk": "裕太 (ユータ)",
          "ja": "村まで聞こえたのは変だよね……",
          "tc": "連村子那邊都聽得到還是很奇怪……",
          "sc": "连村子那边都听得到还是很奇怪……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 370574,
          "spk": "裕太 (ユータ)",
          "ja": "と、とりあえず……",
          "tc": "總、總之……",
          "sc": "总、总之……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 370581,
          "spk": "裕太 (ユータ)",
          "ja": "ノックしてみよう",
          "tc": "先去敲門看看。",
          "sc": "先去敲门看看。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6467,
      "rec_id": "TALK_ID_70_0120_003_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370605,
          "spk": "裕太 (ユータ)",
          "ja": "えっ……ど、どうしよう",
          "tc": "咦……怎、怎麼辦？",
          "sc": "咦……怎、怎么办？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370612,
          "spk": "裕太 (ユータ)",
          "ja": "返事がない……けど……",
          "tc": "雖然……沒有回應……",
          "sc": "虽然……没有回应……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370619,
          "spk": "裕太 (ユータ)",
          "ja": "歌、聞こえなくなったね……",
          "tc": "但是歌聲……停下來了……",
          "sc": "但是歌声……停下来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6468,
      "rec_id": "TALK_ID_70_0120_003_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370637,
          "spk": "裕太 (ユータ)",
          "ja": "ちょ、ちょっとだけ……覗いてみる？",
          "tc": "要、要偷瞄一眼嗎？",
          "sc": "要、要偷瞄一眼吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6469,
      "rec_id": "TALK_ID_70_0120_003_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370655,
          "spk": "裕太 (ユータ)",
          "ja": "あああ……嫌な予感がする……",
          "tc": "啊啊啊……我有不好的預感……",
          "sc": "啊啊啊……我有不好的预感……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6470,
      "rec_id": "TALK_ID_70_0120_003_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370679,
          "spk": "裕太 (ユータ)",
          "ja": "あのー……誰かいませんか……？",
          "tc": "那個……請問有人在嗎……？",
          "sc": "那个……请问有人在吗……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6471,
      "rec_id": "TALK_ID_70_0120_003_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370697,
          "spk": "裕太 (ユータ)",
          "ja": "……！！！！",
          "tc": "……！！！！",
          "sc": "……！！！！"
        }
