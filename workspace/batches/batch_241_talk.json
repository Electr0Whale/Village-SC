  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6434,
      "rec_id": "TALK_ID_70_0110_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379104,
          "spk": "洋 (ヨウ)",
          "ja": "あ、<player>",
          "tc": "啊，<player>，",
          "sc": "啊，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379111,
          "spk": "洋 (ヨウ)",
          "ja": "この間はお魚、ありがとう",
          "tc": "謝謝你之前幫忙釣的魚。",
          "sc": "谢谢你之前帮忙钓的鱼。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379122,
          "spk": "六角 (ロッカク)",
          "ja": "おや、いらっしゃい",
          "tc": "哎呀，歡迎光臨，",
          "sc": "哎呀，欢迎光临，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379129,
          "spk": "六角 (ロッカク)",
          "ja": "我が食堂の救世主の登場っスねぇ",
          "tc": "本餐廳的救世主登場啦。",
          "sc": "本餐厅的救世主登场呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6435,
      "rec_id": "TALK_ID_70_0110_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379149,
          "spk": "六角 (ロッカク)",
          "ja": "いえね？",
          "tc": "是這樣的啦，",
          "sc": "是这样的啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379156,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが魚を欲しがった原因、",
          "tc": "洋妹妹之所以會想要魚，",
          "sc": "洋妹妹之所以会想要鱼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379163,
          "spk": "六角 (ロッカク)",
          "ja": "実はワシにありまして",
          "tc": "其實原因出在我身上。",
          "sc": "其实原因出在我身上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379174,
          "spk": "六角 (ロッカク)",
          "ja": "最近、この村も賑やかになったもんで",
          "tc": "最近這個村子也變得熱鬧起來了，",
          "sc": "最近这个村子也变得热闹起来了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379181,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの看板の焼き魚定食が",
          "tc": "所以我們家招牌的烤魚定食",
          "sc": "所以我们家招牌的烤鱼定食"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379188,
          "spk": "六角 (ロッカク)",
          "ja": "売れるようになったんスよ",
          "tc": "也賣得越來越好。",
          "sc": "也卖得越来越好。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 379199,
          "spk": "六角 (ロッカク)",
          "ja": "それはいいことなんスけど、",
          "tc": "這雖然是件好事，",
          "sc": "这虽然是件好事，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 379206,
          "spk": "六角 (ロッカク)",
          "ja": "魚の確保が追い付かなくなりましてね",
          "tc": "但是卻變得沒辦法確保足夠的魚。",
          "sc": "但是却变得没办法确保足够的鱼。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 379224,
          "spk": "六角 (ロッカク)",
          "ja": "そんで、そいつを愚痴ってるところを",
          "tc": "然後我在發牢騷的時候，",
          "sc": "然后我在发牢骚的时候，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 379231,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんに見られてたみたいで",
          "tc": "就被洋妹妹看見了。",
          "sc": "就被洋妹妹看见了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 379238,
          "spk": "六角 (ロッカク)",
          "ja": "ホント、手間をおかけしたっス",
          "tc": "真的是給你添麻煩了。",
          "sc": "真的是给你添麻烦呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6436,
      "rec_id": "TALK_ID_70_0110_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379256,
          "spk": "洋 (ヨウ)",
          "ja": "お店のお魚、もうだいじょうぶ？",
          "tc": "店裡的魚，已經夠了嗎？",
          "sc": "店里的鱼，已经够了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6437,
      "rec_id": "TALK_ID_70_0110_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379281,
          "spk": "六角 (ロッカク)",
          "ja": "ええ、ええ",
          "tc": "當然、當然。",
          "sc": "当然、当然。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379288,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが教えてくれた釣り場で",
          "tc": "因為我在洋妹妹告訴我的釣魚地點，",
          "sc": "因为我在洋妹妹告诉我的钓鱼地点，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379295,
          "spk": "六角 (ロッカク)",
          "ja": "山ほど釣り上げてきたんでねぇ",
          "tc": "釣到了一大堆的魚喔。",
          "sc": "钓到了一大堆的鱼呐。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379308,
          "spk": "洋 (ヨウ)",
          "ja": "すごい",
          "tc": "好厲害，",
          "sc": "好厉害，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379315,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、釣りじょうず",
          "tc": "叔叔真會釣魚。",
          "sc": "叔叔真会钓鱼。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379328,
          "spk": "六角 (ロッカク)",
          "ja": "……冗談っス",
          "tc": "……我開玩笑的啦，",
          "sc": "……我开玩笑的啦，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 379339,
          "spk": "六角 (ロッカク)",
          "ja": "実際には、魚好きの常連どもに",
          "tc": "實際上我只是和",
          "sc": "实际上我只是和"
        },
        {
          "f_idx": 7,
          "pidx_tc": 379346,
          "spk": "六角 (ロッカク)",
          "ja": "「食いたい分は自分で釣ってこい」って",
          "tc": "愛吃魚的常客們說了",
          "sc": "爱吃鱼的常客们说了"
        },
        {
          "f_idx": 8,
          "pidx_tc": 379353,
          "spk": "六角 (ロッカク)",
          "ja": "伝えただけっスけど……",
          "tc": "「想吃的話就自己去釣」而已……",
          "sc": "“想吃的话就自己去钓”而已……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6438,
      "rec_id": "TALK_ID_70_0110_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379373,
          "spk": "六角 (ロッカク)",
          "ja": "ともかく、ヨウさんの気遣いに感謝っス",
          "tc": "總之，我很感謝洋妹妹如此體貼。",
          "sc": "总之，我很感谢洋妹妹如此体贴呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379380,
          "spk": "六角 (ロッカク)",
          "ja": "もちろん<player>さんとスミレさんにも",
          "tc": "當然也很感謝<player>還有堇怜弟弟喔。",
          "sc": "当然也很感谢<player>还有堇怜弟弟呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6439,
      "rec_id": "TALK_ID_70_0110_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379405,
          "spk": "六角 (ロッカク)",
          "ja": "お礼と言ってはなんですが……",
          "tc": "雖然這可能稱不上是謝禮……",
          "sc": "虽然这可能称不上是谢礼……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6440,
      "rec_id": "TALK_ID_70_0110_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379433,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの手作りお菓子っス",
          "tc": "但這是我親手做的點心。",
          "sc": "但这是我亲手做的点心呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379440,
          "spk": "六角 (ロッカク)",
          "ja": "食堂のメニューにもあるんで、",
          "tc": "這也有出現在餐廳的菜單上，",
          "sc": "这也有出现在餐厅的菜单上，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379447,
          "spk": "六角 (ロッカク)",
          "ja": "気に入ったら注文してくださいな",
          "tc": "所以你如果喜歡的話可以再來點喔。",
          "sc": "所以你如果喜欢的话可以再来点呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6441,
      "rec_id": "TALK_ID_70_0110_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379465,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんは、いろいろなお料理を作れるね",
          "tc": "叔叔會做各式各樣的料理呢，",
          "sc": "叔叔会做各式各样的料理呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379472,
          "spk": "洋 (ヨウ)",
          "ja": "どうやって覚えたの？",
          "tc": "叔叔是怎麼學會的？",
          "sc": "叔叔是怎么学会的？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379485,
          "spk": "六角 (ロッカク)",
          "ja": "覚えたいお料理をたくさん食べれば、",
          "tc": "只要多吃幾次想學的料理，",
          "sc": "只要多吃几次想学的料理，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379492,
          "spk": "六角 (ロッカク)",
          "ja": "作り方も覚えられるっスよ！",
          "tc": "就能學會作法囉！",
          "sc": "就能学会作法哟！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 379508,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんも、",
          "tc": "<player>也不妨",
          "sc": "<player>也不妨"
        },
        {
          "f_idx": 6,
          "pidx_tc": 379515,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの食堂でたくさん食べて、",
          "tc": "在我們餐廳多吃一點，",
          "sc": "在我们餐厅多吃一点，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 379522,
          "spk": "六角 (ロッカク)",
          "ja": "自分でも作れるようになってくださいな",
          "tc": "學會自己做料理吧。",
          "sc": "学会自己做料理吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6442,
      "rec_id": "TALK_ID_70_0110_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379540,
          "spk": "洋 (ヨウ)",
          "ja": "<player>、ほんとうに、ありがとうね！",
          "tc": "<player>，真的很謝謝你！",
          "sc": "<player>，真的很谢谢你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6443,
      "rec_id": "TALK_ID_70_0110_004_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379558,
          "spk": "六角 (ロッカク)",
          "ja": "お、満面の笑み",
          "tc": "哇，笑得真燦爛。",
          "sc": "哇，笑得真灿烂。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379565,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさん、すっかり<player>さんと",
          "tc": "洋妹妹已經和<player>",
          "sc": "洋妹妹已经和<player>"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379572,
          "spk": "六角 (ロッカク)",
          "ja": "仲良しっスねえ",
          "tc": "變成好朋友了呢。",
          "sc": "变成好朋友呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6444,
      "rec_id": "TALK_ID_70_0110_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379590,
          "spk": "洋 (ヨウ)",
          "ja": "うん、<player>がいると、",
          "tc": "嗯，只要有<player>在，",
          "sc": "嗯，只要有<player>在，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379597,
          "spk": "洋 (ヨウ)",
          "ja": "ちょっとだけ、さみしくなくなるから……",
          "tc": "就感覺沒那麼寂寞了……",
          "sc": "就感觉没那么寂寞了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6445,
      "rec_id": "TALK_ID_70_0110_004_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379615,
          "spk": "洋 (ヨウ)",
          "ja": "じゃあ、わたし、お部屋に戻るけど、",
          "tc": "那我先回房間了，",
          "sc": "那我先回房间了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379622,
          "spk": "洋 (ヨウ)",
          "ja": "<player>はゆっくりしていってね",
          "tc": "<player>就慢慢坐吧。",
          "sc": "<player>就慢慢坐吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379629,
          "spk": "洋 (ヨウ)",
          "ja": "またね",
          "tc": "下次再見。",
          "sc": "下次再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6446,
      "rec_id": "TALK_ID_70_0110_004_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379651,
          "spk": "六角 (ロッカク)",
          "ja": "よかった、よかった",
          "tc": "真是太好了，",
          "sc": "真是太好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379658,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんのおかげで、ヨウさんにも",
          "tc": "多虧有<player>，",
          "sc": "多亏有<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379665,
          "spk": "六角 (ロッカク)",
          "ja": "少し笑顔が戻ってきたように思うっス",
          "tc": "洋妹妹看起來也比較常露出笑容了呢。",
          "sc": "洋妹妹看起来也比较常露出笑容呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6447,
      "rec_id": "TALK_ID_70_0110_004_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379685,
          "spk": "六角 (ロッカク)",
          "ja": "……時に<player>さん",
          "tc": "……話說回來，<player>。",
          "sc": "……话说回来，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379694,
          "spk": "六角 (ロッカク)",
          "ja": "スミレさんから話は聞きました",
          "tc": "我從堇怜弟弟那邊聽說了，",
          "sc": "我从堇怜弟弟那边听说了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379701,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが川に入ろうとしたんですってね",
          "tc": "洋妹妹上次似乎是打算走進河裡是嗎？",
          "sc": "洋妹妹上次似乎是打算走进河里是吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379712,
          "spk": "六角 (ロッカク)",
          "ja": "他人には聞こえない",
          "tc": "就彷彿像是被",
          "sc": "就仿佛像是被"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379719,
          "spk": "六角 (ロッカク)",
          "ja": "妙な声に誘われるようにして",
          "tc": "別人聽不見的奇妙聲音給呼喚了過去。",
          "sc": "别人听不见的奇妙声音给呼唤了过去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6448,
      "rec_id": "TALK_ID_70_0110_004_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379737,
          "spk": "六角 (ロッカク)",
          "ja": "……時々あるんスよ",
          "tc": "……洋妹妹偶爾會這樣，",
          "sc": "……洋妹妹偶尔会这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379744,
          "spk": "六角 (ロッカク)",
          "ja": "ヨウさんが「見えないお友達」と話すことが",
          "tc": "會和「看不見的朋友」說話。",
          "sc": "会和“看不见的朋友”说话。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 379755,
          "spk": "六角 (ロッカク)",
          "ja": "……<player>さん",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 379762,
          "spk": "六角 (ロッカク)",
          "ja": "どうか、ヨウさんのこと",
          "tc": "我希望以後你能幫我多留意一下",
          "sc": "我希望以后你能帮我多留意一下"
        },
        {
          "f_idx": 4,
          "pidx_tc": 379769,
          "spk": "六角 (ロッカク)",
          "ja": "少し気にかけてやってほしいっス",
          "tc": "洋妹妹的情況。",
          "sc": "洋妹妹的情况呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6449,
      "rec_id": "TALK_ID_70_0110_004_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 379787,
          "spk": "六角 (ロッカク)",
          "ja": "ありがとうございます",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 379794,
          "spk": "六角 (ロッカク)",
          "ja": "よろしくお願いするっス",
          "tc": "那就拜託你了。",
          "sc": "那就拜托你呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6450,
      "rec_id": "TALK_ID_70_0120_001_01",
      "lines": [
        {
          "f_idx": 0,
