        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6475,
      "rec_id": "TALK_ID_70_0120_003_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370918,
          "spk": "裕太 (ユータ)",
          "ja": "あ、それで……",
          "tc": "啊，然後……",
          "sc": "啊，然后……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370925,
          "spk": "裕太 (ユータ)",
          "ja": "ごめんね、なんの話をしてたんだっけ",
          "tc": "抱歉，我們原本在聊什麼來著？",
          "sc": "抱歉，我们原本在聊什么来着？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6476,
      "rec_id": "TALK_ID_70_0120_003_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370943,
          "spk": "裕太 (ユータ)",
          "ja": "そうだった",
          "tc": "對了，",
          "sc": "对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370950,
          "spk": "裕太 (ユータ)",
          "ja": "ハチを捕まえてもらったんだったね",
          "tc": "你幫我抓了蜜蜂過來對吧？",
          "sc": "你帮我抓了蜜蜂过来对吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370961,
          "spk": "裕太 (ユータ)",
          "ja": "お礼がしたいんだけど、",
          "tc": "雖然我想要答謝你，",
          "sc": "虽然我想要答谢你，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 370968,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと今……混乱してて……",
          "tc": "但是現在……腦袋有點混亂……",
          "sc": "但是现在……脑袋有点混乱……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 370975,
          "spk": "裕太 (ユータ)",
          "ja": "気持ちが落ち着くまで、待ってくれる？",
          "tc": "可以先給我一點時間冷靜嗎？",
          "sc": "可以先给我一点时间冷静吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 370984,
          "spk": "裕太 (ユータ)",
          "ja": "<strong>明日以降、時間がある時にでもうちに寄ってよ</strong>",
          "tc": "<strong>明天之後，等你有空再找時間來我家吧</strong>。",
          "sc": "<strong>明天之后，等你有空再找时间来我家吧</strong>。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 370991,
          "spk": "裕太 (ユータ)",
          "ja": "お手伝いのお礼、ちゃんとするからさ",
          "tc": "我會好好準備謝禮的。",
          "sc": "我会好好准备谢礼的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6477,
      "rec_id": "TALK_ID_70_0120_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371022,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、外の養蜂箱は見てくれた？",
          "tc": "<player>，你看到外面的蜂箱了嗎？",
          "sc": "<player>，你看到外面的蜂箱了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371029,
          "spk": "裕太 (ユータ)",
          "ja": "もらったハチ、ちゃんと住み着いてくれたよ",
          "tc": "你給我的蜜蜂都已經好好住下來囉。",
          "sc": "你给我的蜜蜂都已经好好安家啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6478,
      "rec_id": "TALK_ID_70_0120_004_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371054,
          "spk": "裕太 (ユータ)",
          "ja": "ハチの視点に立って、ハチの住み心地を",
          "tc": "我以蜜蜂的角度設計了這個蜂箱，",
          "sc": "我以蜜蜂的角度设计了这个蜂箱，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371061,
          "spk": "裕太 (ユータ)",
          "ja": "重視して作った養蜂箱なんだ",
          "tc": "非常注重蜜蜂的舒適度。",
          "sc": "非常注重蜜蜂的舒适度。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 371068,
          "spk": "裕太 (ユータ)",
          "ja": "きっと、いいハチミツがたくさんとれるよ",
          "tc": "一定可以採集到很多高品質的蜂蜜。",
          "sc": "一定可以采集到很多高品质的蜂蜜。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 371079,
          "spk": "裕太 (ユータ)",
          "ja": "それで、お礼なんだけどね",
          "tc": "然後關於謝禮的事。",
          "sc": "然后关于谢礼的事。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 371086,
          "spk": "裕太 (ユータ)",
          "ja": "<player>も養蜂に興味あるんじゃない？",
          "tc": "<player>也對養蜂有興趣吧？",
          "sc": "<player>也对养蜂有兴趣吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 371093,
          "spk": "裕太 (ユータ)",
          "ja": "だから養蜂箱の設計図をあげようと思って",
          "tc": "所以我打算給你蜂箱的設計圖。",
          "sc": "所以我打算给你蜂箱的设计图。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 371102,
          "spk": "裕太 (ユータ)",
          "ja": "俺はもう、完璧に作り方を覚えたからね",
          "tc": "反正做法我已經記得一清二楚了。",
          "sc": "反正做法我已经记得一清二楚了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 371127,
          "spk": "裕太 (ユータ)",
          "ja": "ただ……",
          "tc": "只不過……",
          "sc": "只不过……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 371134,
          "spk": "裕太 (ユータ)",
          "ja": "設計図をどこに置いたか、忘れちゃったんだ",
          "tc": "我忘記把設計圖放到哪裡去了。",
          "sc": "我忘记把设计图放到哪里去了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 371152,
          "spk": "裕太 (ユータ)",
          "ja": "悪いけど、一緒に探してくれない？",
          "tc": "抱歉，你可以陪我一起找嗎？",
          "sc": "抱歉，你可以陪我一起找吗？"
        },
        {
          "f_idx": 13,
          "pidx_tc": 371159,
          "spk": "裕太 (ユータ)",
          "ja": "部屋のどこかにしまってあると思うんだけど",
          "tc": "應該就收在房間的某處。",
          "sc": "应该就收在房间的某处。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6479,
      "rec_id": "TALK_ID_70_0120_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371183,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、それはぬか床だよ",
          "tc": "啊，那是醃米糠醬菜用的米糠床。",
          "sc": "啊，那是腌米糠酱菜用的米糠床。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371190,
          "spk": "裕太 (ユータ)",
          "ja": "今はキュウリとトマトを漬けてるところ",
          "tc": "我正好在醃小黃瓜和番茄。",
          "sc": "我正好在腌黄瓜和西红柿。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 371201,
          "spk": "裕太 (ユータ)",
          "ja": "おいしい野菜は漬かってるけど",
          "tc": "裡面是醃了好吃的蔬菜沒錯，",
          "sc": "里面是腌了好吃的蔬菜没错，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 371208,
          "spk": "裕太 (ユータ)",
          "ja": "さすがに設計図は漬けてないと思うな",
          "tc": "但我總不至於把設計圖拿去醃吧？",
          "sc": "但我总不至于把设计图拿去腌吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6480,
      "rec_id": "TALK_ID_70_0120_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 371239,
          "spk": "裕太 (ユータ)",
          "ja": "並んでる食器、どれもいいでしょ？",
          "tc": "擺在那邊的餐具都很好看吧？",
          "sc": "摆在那边的餐具都很好看吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 371246,
          "spk": "裕太 (ユータ)",
          "ja": "ほとんど自分で作ったんだ",
          "tc": "幾乎都是我自己做的喔！",
          "sc": "几乎都是我自己做的哦！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 371264,
          "spk": "裕太 (ユータ)",
          "ja": "ろくろを回したり、窯の火加減を見たり……",
          "tc": "不管是拉坏，還是留意窯裡的火候……",
          "sc": "不管是拉坏，还是留意窑里的火候……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 371271,
          "spk": "裕太 (ユータ)",
          "ja": "陶芸っていいよ",
          "tc": "陶藝真的很有趣，",
          "sc": "陶艺真的很有趣，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 371278,
          "spk": "裕太 (ユータ)",
          "ja": "自然との対話ができるんだよね",
          "tc": "能夠跟大自然對話喔！",
          "sc": "能够跟大自然对话哦！"
        }
      ]
    },
