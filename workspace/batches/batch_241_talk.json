    },
    {
      "file": "talk.dat",
      "rec_idx": 6472,
      "rec_id": "TALK_ID_70_0120_003_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370721,
          "spk": "裕太 (ユータ)",
          "ja": "い、いまいま……い、今すぐ！",
          "tc": "現、現現現……現在馬上！",
          "sc": "现、现现现……现在马上！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370728,
          "spk": "裕太 (ユータ)",
          "ja": "ここを離れるんだ！",
          "tc": "離開這裡！",
          "sc": "离开这里！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370735,
          "spk": "裕太 (ユータ)",
          "ja": "おいで、<player>！",
          "tc": "<player>，快過來！",
          "sc": "<player>，快过来！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6473,
      "rec_id": "TALK_ID_70_0120_003_19",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370759,
          "spk": "裕太 (ユータ)",
          "ja": "あ、焦った……",
          "tc": "嚇、嚇死我了……",
          "sc": "吓、吓死我了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370766,
          "spk": "裕太 (ユータ)",
          "ja": "あんなの絶対<player>には見せられないよ",
          "tc": "絕對不能讓<player>看到那個。",
          "sc": "绝对不能让<player>看到那个。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 370784,
          "spk": "裕太 (ユータ)",
          "ja": "ここは平和でのどかな田舎なんだから",
          "tc": "這裡是和平又悠閒的鄉村，",
          "sc": "这里是和平又悠闲的乡村，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 370791,
          "spk": "裕太 (ユータ)",
          "ja": "あ、あんなものがあるわけないんだ……",
          "tc": "不、不可能會有那種東西……",
          "sc": "不、不可能会有那种东西……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6474,
      "rec_id": "TALK_ID_70_0120_003_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 370816,
          "spk": "裕太 (ユータ)",
          "ja": "そうだ、<player>！　約束して",
          "tc": "對了，<player>！",
          "sc": "对了，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 370823,
          "spk": "裕太 (ユータ)",
          "ja": "あそこには二度と行かないって",
          "tc": "答應我，不可以再到那裡去喔！",
          "sc": "答应我，不可以再到那里去哦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 370832,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
