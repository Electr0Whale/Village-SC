  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 47,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0141",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12590,
          "spk": "帷 (トバリ)",
          "ja": "もう年末か……",
          "tc": "已經年底了啊……",
          "sc": "已经年底了啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12597,
          "spk": "帷 (トバリ)",
          "ja": "一年なんて、ホントあっという間だね",
          "tc": "一年真的眨眼就過去了。",
          "sc": "一年真的眨眼就过去了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 12608,
          "spk": "帷 (トバリ)",
          "ja": "来年はどんな年にしたいとか",
          "tc": "<player>，你新年有什麼新希望嗎？",
          "sc": "<player>，你新年有什么新希望吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 12615,
          "spk": "帷 (トバリ)",
          "ja": "<player>は抱負ってあるの？",
          "tc": "有什麼抱負嗎？",
          "sc": "有什么抱负吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 12626,
          "spk": "帷 (トバリ)",
          "ja": "私は……現状維持でいいかな",
          "tc": "我……應該只要能維持現狀就好。",
          "sc": "我……应该只要能维持现状就好。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 12633,
          "spk": "帷 (トバリ)",
          "ja": "急にやる気出したって、結局続かないし",
          "tc": "反正即使突然提起幹勁，我終究也是三分鐘熱度。",
          "sc": "反正即使突然提起干劲，我终究也是三分钟热度。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 12651,
          "spk": "帷 (トバリ)",
          "ja": "……ま、来年も<player>と",
          "tc": "……只要明年還能跟<player>一起跨年，",
          "sc": "……只要明年还能跟<player>一起跨年，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 12658,
          "spk": "帷 (トバリ)",
          "ja": "年を越せたら、それでいいよ",
          "tc": "這樣就夠了。",
          "sc": "这样就够了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 48,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0150",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12682,
          "spk": "帷 (トバリ)",
          "ja": "最後まで見たけど、",
          "tc": "我一路看到了最後，",
          "sc": "我一路看到了最后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12689,
          "spk": "帷 (トバリ)",
          "ja": "<player>はエントリーしなかったんだ",
          "tc": "但<player>你沒報名啊。",
          "sc": "但<player>你没报名啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 12700,
          "spk": "帷 (トバリ)",
          "ja": "さては、農作業サボってたとか……",
          "tc": "你是不是偷懶沒耕作……",
          "sc": "你是不是偷懒没耕作……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 12718,
          "spk": "帷 (トバリ)",
          "ja": "は、なさそうか、<player>だし",
          "tc": "好像不可能，畢竟是<player>你啊。",
          "sc": "好像不可能，毕竟是<player>你啊。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 12729,
          "spk": "帷 (トバリ)",
          "ja": "ま、別にいいんじゃない？",
          "tc": "不過也沒關係啦，",
          "sc": "不过也没关系啦，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 12736,
          "spk": "帷 (トバリ)",
          "ja": "作物を育てたら、必ず出ないと",
          "tc": "反正又沒人規定種出了作物",
          "sc": "反正又没人规定种出了作物"
        },
        {
          "f_idx": 7,
          "pidx_tc": 12743,
          "spk": "帷 (トバリ)",
          "ja": "いけないって決まりもないんだし",
          "tc": "就一定要參加評鑑會。",
          "sc": "就一定要参加评鉴会。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 49,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0151",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12767,
          "spk": "帷 (トバリ)",
          "ja": "すごいね、<player>",
          "tc": "你太厲害了，<player>，",
          "sc": "你太厉害了，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12774,
          "spk": "帷 (トバリ)",
          "ja": "最高ランクに選ばれるなんて",
          "tc": "居然得到了最高級評分，",
          "sc": "居然得到了最高级评分，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 12781,
          "spk": "帷 (トバリ)",
          "ja": "そうそうないんじゃない？",
          "tc": "這應該不是隨便就能得到的吧？",
          "sc": "这应该不是随便就能得到的吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 12792,
          "spk": "帷 (トバリ)",
          "ja": "まあ……この結果も",
          "tc": "不過……",
          "sc": "不过……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 12799,
          "spk": "帷 (トバリ)",
          "ja": "別に意外とは思ってないけど",
          "tc": "這個結果我是不太意外啦。",
          "sc": "这个结果我是不太意外啦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 12810,
          "spk": "帷 (トバリ)",
          "ja": "だってさ、あれだけ農作業に励んでる",
          "tc": "畢竟你都這麼勤奮在耕作了，",
          "sc": "毕竟你都这么勤奋在耕作了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 12817,
          "spk": "帷 (トバリ)",
          "ja": "アンタで最高ランクもらえないんなら、",
          "tc": "如果連你都拿不到最高級評分，",
          "sc": "如果连你都拿不到最高级评分，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 12824,
          "spk": "帷 (トバリ)",
          "ja": "壁高すぎでしょ",
          "tc": "那門檻也太高了。",
          "sc": "那门槛也太高了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 50,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0152",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12848,
          "spk": "帷 (トバリ)",
          "ja": "惜しかったね、<player>",
          "tc": "好可惜啊，<player>。",
          "sc": "好可惜啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12855,
          "spk": "帷 (トバリ)",
          "ja": "最高ランク逃がしちゃって",
          "tc": "你沒有得到最高級評分呢。",
          "sc": "你没有得到最高级评分呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 12866,
          "spk": "帷 (トバリ)",
          "ja": "けど、これで終わりにするつもりないでしょ？",
          "tc": "不過你不會就這樣作罷了吧？",
          "sc": "不过你不会就这样作罢了吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 12873,
          "spk": "帷 (トバリ)",
          "ja": "今よりも作物の品質上げて、リベンジしなよ",
          "tc": "你要再更提升作物的品質，重新雪恥喔。",
          "sc": "你要再更提升作物的品质，重新雪耻。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 51,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0153",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12904,
          "spk": "帷 (トバリ)",
          "ja": "今回は、参加を見送ることにしたんだ",
          "tc": "你這次沒有參加啊。",
          "sc": "你这次没有参加啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12911,
          "spk": "帷 (トバリ)",
          "ja": "まだ動物を育ててる途中だったとか？",
          "tc": "是不是動物還在培育中？",
          "sc": "是不是动物还在培育中？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 12929,
          "spk": "帷 (トバリ)",
          "ja": "理由はなんにせよ、次は期待してる",
          "tc": "無論原因是什麼，我很期待你下次的表現喔。",
          "sc": "无论原因是什么，我很期待你下次的表现。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 12936,
          "spk": "帷 (トバリ)",
          "ja": "<player>が出た方が面白いし",
          "tc": "畢竟有<player>出場會比較有趣嘛。",
          "sc": "毕竟有<player>出场会比较有趣嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 52,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0154",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 12967,
          "spk": "帷 (トバリ)",
          "ja": "見てたよ、最高ランクに選ばれてたとこ",
          "tc": "我有看到喔，你獲得了最高級評分了呢。",
          "sc": "我看见了，你拿到了最高评级呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 12974,
          "spk": "帷 (トバリ)",
          "ja": "よかったね、おめでと、<player>",
          "tc": "太好了，恭喜你，<player>。",
          "sc": "太好了，恭喜你，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 12990,
          "spk": "帷 (トバリ)",
          "ja": "……なんか、<player>も動物も",
          "tc": "……感覺<player>和動物",
          "sc": "……感觉<player>和动物"
        },
        {
          "f_idx": 4,
          "pidx_tc": 12997,
          "spk": "帷 (トバリ)",
          "ja": "してやったり、みたいな自信に満ちてない？",
          "tc": "都有種「我做到了」，充滿了信心的感覺。",
          "sc": "都有种“我做到了”，充满了信心的感觉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 13015,
          "spk": "帷 (トバリ)",
          "ja": "そのしたり顔はちょっと腹立つけど",
          "tc": "雖然你那得意的表情讓我看了有點不爽，",
          "sc": "虽然你那得意的表情让我看了有点不爽，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 13022,
          "spk": "帷 (トバリ)",
          "ja": "今日くらいはいいか、大目に見てあげる",
          "tc": "但今天就算了，我就特別睜一隻眼閉一隻眼吧。",
          "sc": "但今天就算了，我就特别睁一只眼闭一只眼吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 53,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0155",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 13046,
          "spk": "帷 (トバリ)",
          "ja": "最高評価はもらえなかったけど……",
          "tc": "雖然你沒有得到最高評價……",
          "sc": "虽然你没有得到最高评价……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 13053,
          "spk": "帷 (トバリ)",
          "ja": "まぁ、いつもいつも完璧にはいかないでしょ",
          "tc": "不過沒有人是能夠永遠十全十美的。",
          "sc": "不过没有人是能够永远十全十美的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 13071,
          "spk": "帷 (トバリ)",
          "ja": "<player>も動物も疲れてるだろうし",
          "tc": "<player>，你和動物都累了吧？",
          "sc": "<player>，你和动物都累了吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 13078,
          "spk": "帷 (トバリ)",
          "ja": "まずは休んで、次がんばってみたら？",
          "tc": "你們就先休息一陣子，下次再努力看看吧。",
          "sc": "你们就先休息一阵子，下次再努力看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 54,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0156",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 13109,
          "spk": "帷 (トバリ)",
          "ja": "あーあ、<player>が出るって期待してたから、",
          "tc": "唉，我本來還期待<player>會出場的，",
          "sc": "唉，我本来还期待<player>会出场的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 13116,
          "spk": "帷 (トバリ)",
          "ja": "エントリーなしでガッカリね",
          "tc": "結果你沒有報名，真是令人失望。",
          "sc": "结果你没有报名，真是令人失望。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 13134,
          "spk": "帷 (トバリ)",
          "ja": "……<player>は元気そうにしてるから",
          "tc": "……我看<player>你很有精神啊，",
          "sc": "……我看<player>你很有精神啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 13141,
          "spk": "帷 (トバリ)",
          "ja": "出なかったのは、馬が理由？",
          "tc": "所以沒出賽是因為馬的關係嗎？",
          "sc": "所以没出赛是因为马的关系吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 13152,
          "spk": "帷 (トバリ)",
          "ja": "それなら、まあ……仕方ないか",
          "tc": "如果是這樣的話……那就沒辦法了。",
          "sc": "如果是这样的话……那就没办法了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 13159,
          "spk": "帷 (トバリ)",
          "ja": "本調子じゃないなら",
          "tc": "既然狀態不好，",
          "sc": "既然状态不好，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 13166,
          "spk": "帷 (トバリ)",
          "ja": "無理に出すのも気の毒だし",
          "tc": "勉強讓牠出場也有點可憐。",
          "sc": "勉强让它出场也有点可怜。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 55,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0157",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 13190,
          "spk": "帷 (トバリ)",
          "ja": "おめでと、<player>",
          "tc": "恭喜你，<player>，",
          "sc": "恭喜你，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 13197,
          "spk": "帷 (トバリ)",
          "ja": "アンタの育てた馬が、最高ランクだって",
          "tc": "你養育的馬得到了最高級的評分了呢。",
          "sc": "你养育的马得到了最高级的评分了呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 13208,
          "spk": "帷 (トバリ)",
          "ja": "順当な結果だと思う",
          "tc": "我覺得這是你們應得的結果。",
          "sc": "我觉得这是你们应得的结果。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 13215,
          "spk": "帷 (トバリ)",
          "ja": "だって登場してきた瞬間",
          "tc": "畢竟牠在登場的瞬間，",
          "sc": "毕竟它在登场的瞬间，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 13222,
          "spk": "帷 (トバリ)",
          "ja": "綺麗な馬だなってハッとしたから",
          "tc": "我就好驚訝牠怎麼這麼漂亮。",
          "sc": "我就好惊讶它怎么这么漂亮。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 13233,
          "spk": "帷 (トバリ)",
          "ja": "もっと近くで見て、撫でてもみたいかな……",
          "tc": "真想靠近一點看牠、摸摸牠……",
          "sc": "真想靠近一点看它、摸摸它……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 13240,
          "spk": "帷 (トバリ)",
          "ja": "気が向いたらでいいから、お願いね",
          "tc": "等你想給我看的時候就好，拜託你了。",
          "sc": "等你想给我看的时候就好，拜托你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 56,
      "rec_id": "TALK_ID_ORPHAN_HOLIDAY_20_101_0158",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 13264,
          "spk": "帷 (トバリ)",
          "ja": "あーあ……残念だったね",
          "tc": "唉～真遺憾呢。",
          "sc": "唉～真遗憾呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 13271,
          "spk": "帷 (トバリ)",
          "ja": "<player>と<player>の馬なら",
          "tc": "我還以為<player>和<player>的馬",
          "sc": "我还以为<player>和<player>的马"
        },
        {
          "f_idx": 2,
          "pidx_tc": 13278,
          "spk": "帷 (トバリ)",
          "ja": "最高ランクも狙えるかと思ったんだけど",
          "tc": "可以拿到最高級評分的。",
          "sc": "可以拿到最高级评分的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 13289,
          "spk": "帷 (トバリ)",
          "ja": "ま……世の中そんなに甘くないってことね",
          "tc": "嗯……看來這世界沒有那麼簡單啊，",
          "sc": "嗯……看来这世界没有那么简单啊，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 13296,
          "spk": "帷 (トバリ)",
          "ja": "悔しいと思うなら、諦めずに挑戦を続けなよ",
          "tc": "你如果不甘心的話就繼續挑戰吧，別放棄喔。",
          "sc": "你如果不甘心的话就继续挑战吧，别放弃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 57,
      "rec_id": "TALK_ID_ORPHAN_PRESENT_20_101_0200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 13327,
          "spk": "帷 (トバリ)",
          "ja": "これを、私に……？",
          "tc": "要給我這個……？",
          "sc": "要给我这个……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 13334,
          "spk": "帷 (トバリ)",
          "ja": "ほんとにもらっていいの……？",
          "tc": "我真的可以收下嗎……？",
          "sc": "我真的可以收下吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 13345,
          "spk": "帷 (トバリ)",
          "ja": "わざわざ用意してくれたのね……",
          "tc": "是特地為我準備的呢……",
          "sc": "是特地为我准备的呢……"
        },
        {
