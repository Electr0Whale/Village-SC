          "pidx_tc": 319148,
          "spk": "名护 (ナゴ)",
          "ja": "……<player>さん",
          "tc": "……<player>，",
          "sc": "……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 319155,
          "spk": "名护 (ナゴ)",
          "ja": "居たのか……",
          "tc": "原來你在啊……",
          "sc": "原来你在啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 319166,
          "spk": "名护 (ナゴ)",
          "ja": "いや……その……",
          "tc": "不……就是……",
