      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 318471,
          "spk": "莲实 (ハスミ)",
          "ja": "そういうわけじゃ……",
          "tc": "不是那樣……",
          "sc": "不是那样……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 318484,
          "spk": "堇怜 (スミレ)",
          "ja": "だったら、どうして姉さんは",
          "tc": "既然如此，",
          "sc": "既然如此，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 318491,
          "spk": "堇怜 (スミレ)",
          "ja": "リンの言いなりなんだよ！",
          "tc": "那為什麼姊姊要對林言聽計從！",
          "sc": "那为什么姐姐要对林言听计从！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 318504,
          "spk": "莲实 (ハスミ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 318519,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんは、いつもそうだ！",
          "tc": "姊姊每次都這樣！",
          "sc": "姐姐每次都这样！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 318526,
          "spk": "堇怜 (スミレ)",
          "ja": "何も話してくれない！",
          "tc": "什麼都不肯說！",
          "sc": "什么都不肯说！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 318537,
          "spk": "堇怜 (スミレ)",
          "ja": "そもそも姉さんが鵺の皮を",
          "tc": "說到底，要是姊姊當初沒有弄丟鵺皮，",
          "sc": "说到底，要是姐姐当初没有弄丢鵺皮，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 318544,
          "spk": "堇怜 (スミレ)",
          "ja": "なくさなかったら、うちは昔のままだった！",
          "tc": "我們家就可以維持以前那樣！",
          "sc": "我们家就可以维持以前那样！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 318551,
          "spk": "堇怜 (スミレ)",
          "ja": "こんな貧乏じゃなかったんだ！！",
          "tc": "根本不會變得這麼窮！！",
          "sc": "根本不会变得这么穷！！"
        }
      ]
    },
