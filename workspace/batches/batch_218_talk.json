    {
      "file": "talk.dat",
      "rec_idx": 5479,
      "rec_id": "TALK_ID_10_0502_214_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 319202,
          "spk": "名护 (ナゴ)",
          "ja": "……ああ、いや",
          "tc": "……啊，不是，",
          "sc": "……啊，不是，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 319209,
          "spk": "名护 (ナゴ)",
          "ja": "確証があるわけじゃないんだ",
          "tc": "我並沒有確切的證據。",
          "sc": "我并没有确切的证据。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 319220,
          "spk": "名护 (ナゴ)",
          "ja": "憶測を口にするのはやめておきたい",
          "tc": "所以我想避免說出沒有根據的推論。",
          "sc": "所以我想避免说出没有根据的推论。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 319227,
          "spk": "名护 (ナゴ)",
          "ja": "……ただ",
          "tc": "……只不過，",
          "sc": "……只不过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 319238,
          "spk": "名护 (ナゴ)",
          "ja": "鵺には、関わらないほうがいいかもしれない",
          "tc": "也許不要跟鵺扯上關係會比較好。",
          "sc": "也许不要跟鵺扯上关系会比较好。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 319245,
          "spk": "名护 (ナゴ)",
          "ja": "それが、キミやスミレくんのためでもあり、",
          "tc": "這不僅是為了你和堇怜，",
          "sc": "这不仅是为了你和堇怜，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 319252,
          "spk": "名护 (ナゴ)",
          "ja": "鵺のためでもある",
          "tc": "也是為了鵺。",
          "sc": "也是为了鵺。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5480,
      "rec_id": "TALK_ID_10_0502_214_06",
      "lines": [
        {
