          "ja": "なかったんだ……",
          "tc": "那種話的……",
          "sc": "那种话的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5473,
      "rec_id": "TALK_ID_10_0502_213_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 318731,
          "spk": "堇怜 (スミレ)",
          "ja": "どうして姉さんは、",
          "tc": "為什麼姊姊",
          "sc": "为什么姐姐"
        },
        {
          "f_idx": 1,
          "pidx_tc": 318738,
          "spk": "堇怜 (スミレ)",
          "ja": "わかってくれないんだろう",
          "tc": "就是不懂我的用意呢？",
          "sc": "就是不懂我的用意呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 318749,
          "spk": "堇怜 (スミレ)",
          "ja": "うちの運気は、",
          "tc": "明明我們家的運勢，",
          "sc": "明明我们家的运势，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 318756,
          "spk": "堇怜 (スミレ)",
          "ja": "鵺の皮と一緒に逃げちゃったっていうのに",
          "tc": "就是跟著鵺皮一起跑掉的，",
          "sc": "就是跟着鵺皮一起跑掉的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 318765,
          "spk": "堇怜 (スミレ)",
          "ja": "あの鵺を倒して皮を取り戻せば、",
          "tc": "只要打倒鵺，把皮拿回來，",
          "sc": "只要打倒鵺，把皮拿回来，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 318772,
          "spk": "堇怜 (スミレ)",
          "ja": "うちはまた金持ちになれるんだ",
          "tc": "我們家就能再次成為有錢人了。",
          "sc": "我们家就能再次成为有钱人了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 318783,
          "spk": "堇怜 (スミレ)",
          "ja": "そうしたら、僕が商売を始めて",
          "tc": "這樣一來，只要我開始做生意，",
          "sc": "这样一来，只要我开始做生意，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 318790,
          "spk": "堇怜 (スミレ)",
          "ja": "どんどん金を増やせばいい",
          "tc": "不斷賺錢就沒問題了。",
          "sc": "不断赚钱就没问题了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 318801,
          "spk": "堇怜 (スミレ)",
          "ja": "暮らしは今より楽になるし、",
          "tc": "我們的生活會變得比現在輕鬆，",
          "sc": "我们的生活会变得比现在轻松，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 318808,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんも夢をまた追いかけられる",
          "tc": "姊姊也能再次去追求她的夢想。",
          "sc": "姐姐也能再次去追求她的梦想。"
        }
      ]
    },
    {
