      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5481,
      "rec_id": "TALK_ID_10_0502_215_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 319319,
          "spk": "堇怜 (スミレ)",
          "ja": "あ！　<player>……",
          "tc": "啊！<player>……",
          "sc": "啊！<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 319330,
          "spk": "堇怜 (スミレ)",
          "ja": "さっき鵺がやって来て、",
          "tc": "剛才鵺出現了，",
          "sc": "刚才鵺出现了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 319337,
          "spk": "堇怜 (スミレ)",
          "ja": "慌てて矢を放ったら命中したんだ",
          "tc": "我連忙放箭結果就射中了。",
          "sc": "我连忙放箭结果就射中了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 319355,
          "spk": "堇怜 (スミレ)",
          "ja": "その後どこかへ",
          "tc": "之後祂不曉得",
          "sc": "之后他不晓得"
        },
        {
          "f_idx": 5,
          "pidx_tc": 319362,
          "spk": "堇怜 (スミレ)",
          "ja": "飛んでいっちゃったんだけど",
          "tc": "飛到哪去，",
          "sc": "飞到哪去，"
        },
