      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 318595,
          "spk": "莲实 (ハスミ)",
          "ja": "……ごめんなさい、<player>さん",
          "tc": "……對不起，<player>。",
          "sc": "……对不起，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 318602,
          "spk": "莲实 (ハスミ)",
          "ja": "できれば……あの子を",
          "tc": "如果可以……",
          "sc": "如果可以……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 318609,
          "spk": "莲实 (ハスミ)",
          "ja": "止めてあげてほしいんです……",
          "tc": "希望你能幫忙阻止那孩子……",
          "sc": "希望你能帮忙阻止那孩子……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 318618,
          "spk": "莲实 (ハスミ)",
          "ja": "私は、その言葉を持たないから……",
          "tc": "因為我沒辦法說服他……",
          "sc": "因为我没办法说服他……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 318627,
          "spk": "莲实 (ハスミ)",
          "ja": "どうか……",
          "tc": "拜託你……",
          "sc": "拜托你……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 318634,
          "spk": "莲实 (ハスミ)",
          "ja": "あの子が危険なことに巻き込まれないよう、",
          "tc": "請從旁幫幫那孩子，",
          "sc": "请从旁帮帮那孩子，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 318641,
          "spk": "莲实 (ハスミ)",
          "ja": "側で助けてあげてください……",
          "tc": "避免他被捲入危險之中……",
          "sc": "避免他被卷入危险之中……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5471,
      "rec_id": "TALK_ID_10_0502_213_01",
      "lines": [
        {
