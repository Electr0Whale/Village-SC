        },
        {
          "f_idx": 5,
          "pidx_tc": 396969,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうだい、<player>？",
          "tc": "怎麼樣啊，<player>？",
          "sc": "怎么样啊，<player>？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396976,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミもウチと一緒に",
          "tc": "你要不要跟我一起喝",
