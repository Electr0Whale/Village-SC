          "f_idx": 1,
          "pidx_tc": 396901,
          "spk": "琪娜娜 (チナナ)",
          "ja": "香ばしくておいしいねえ",
          "tc": "好香好好吃喔。",
          "sc": "好香好好吃哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396908,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、<player>も食べて",
          "tc": "來，<player>也趕快吃吧。",
          "sc": "来，<player>也赶快吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
