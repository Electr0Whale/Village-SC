  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7905,
      "rec_id": "TALK_ID_70_2150_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395208,
          "spk": "琪娜娜 (チナナ)",
          "ja": "わかっているなら、まあいいさ",
          "tc": "懂了就好，",
          "sc": "懂了就好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395215,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっちゃったことは",
          "tc": "但過去的事已經過去了，",
          "sc": "但过去的事已经过去了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395222,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうにもならないからね",
          "tc": "無法重來。",
          "sc": "无法重来。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395233,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいかい、<player>",
          "tc": "聽好了，<player>，",
          "sc": "听好了，<player>，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395240,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日のことは貸しだよ",
          "tc": "今天你欠我一次，",
          "sc": "今天你欠我一次，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395247,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人になったら返してもらう",
          "tc": "所以等你長大之後要還我喔。",
          "sc": "所以等你长大之后要还我哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7906,
      "rec_id": "TALK_ID_70_2150_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "よし、じゃあ",
          "tc": "很好，",
          "sc": "很好，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もう気にしなくていいよ",
          "tc": "那你可以不用在意這件事了，",
          "sc": "那你可以不用在意这件事了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395279,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは心が広いんだ",
          "tc": "我的心胸可是很寬大的。",
          "sc": "我的心胸可是很宽大的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395290,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これに懲りずに",
          "tc": "你不用覺得不好意思，",
          "sc": "你不用觉得不好意思，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また遊びにおいで",
          "tc": "下次要再來玩喔。",
          "sc": "下次要再来玩哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7907,
      "rec_id": "TALK_ID_70_2150_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395321,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……くっくっく",
          "tc": "……呵呵呵，",
          "sc": "……呵呵呵，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395328,
          "spk": "琪娜娜 (チナナ)",
          "ja": "将来のカモを",
          "tc": "我找到一隻",
          "sc": "我找到一只"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395335,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見つけたねえ",
          "tc": "未來的肥羊了。",
          "sc": "未来的肥羊了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7908,
      "rec_id": "TALK_ID_70_2150_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395359,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あれ？",
          "tc": "咦？",
          "sc": "咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395366,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>じゃないか",
          "tc": "這不是<player>嗎？",
          "sc": "这不是<player>吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395373,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんばんは",
          "tc": "你好啊。",
          "sc": "你好啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395384,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間に",
          "tc": "居然會跟你在這種時間、",
          "sc": "居然会跟你在这种时间、"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395391,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなところで会うなんて",
          "tc": "這種地方相遇，",
          "sc": "这种地方相遇，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395398,
          "spk": "琪娜娜 (チナナ)",
          "ja": "運命じゃないかい？",
          "tc": "難道這是命運的安排嗎？",
          "sc": "难道这是命运的安排吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 395409,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミはなんで",
          "tc": "你為什麼",
          "sc": "你为什么"
        },
        {
          "f_idx": 7,
          "pidx_tc": 395416,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんな時間に……",
          "tc": "會在這個時間……",
          "sc": "会在这个时间……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 395427,
          "spk": "琪娜娜 (チナナ)",
          "ja": "って、それは",
          "tc": "對喔，",
          "sc": "对哦，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 395434,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも同じか",
          "tc": "這麼說來我也一樣啊。",
          "sc": "这么说来我也一样啊。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 395445,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ウチはね",
          "tc": "……我在村外",
          "sc": "……我在村外"
        },
        {
          "f_idx": 11,
          "pidx_tc": 395452,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の外では基本",
          "tc": "基本上都是",
          "sc": "基本上都是"
        },
        {
          "f_idx": 12,
          "pidx_tc": 395459,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人旅だったんだよ",
          "tc": "獨自旅行的。",
          "sc": "独自旅行的。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 395468,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、常に警戒心を持って",
          "tc": "所以不管進行任何行動，",
          "sc": "所以不管进行任何行动，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 395475,
          "spk": "琪娜娜 (チナナ)",
          "ja": "行動していたんだけどね",
          "tc": "我都會隨時保持戒心。",
          "sc": "我都会随时保持戒心。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 395486,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村にいるようになってからは、",
          "tc": "但是自從開始留在村裡之後，",
          "sc": "但是自从开始留在村里之后，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 395493,
          "spk": "琪娜娜 (チナナ)",
          "ja": "警戒心を抱く必要がなくなった",
          "tc": "我就不再需要保持什麼戒心了。",
          "sc": "我就不再需要保持什么戒心了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 395504,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなものとは無縁の",
          "tc": "我現在每天都過著",
          "sc": "我现在每天都过着"
        },
        {
          "f_idx": 18,
          "pidx_tc": 395511,
          "spk": "琪娜娜 (チナナ)",
          "ja": "毎日だから、緊張感というものを",
          "tc": "輕鬆悠閒的生活，",
          "sc": "轻松悠闲的生活，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 395518,
          "spk": "琪娜娜 (チナナ)",
          "ja": "忘れてしまいそうでねえ",
          "tc": "都快要忘記什麼叫做緊張了。",
          "sc": "都快要忘记什么叫做紧张了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7909,
      "rec_id": "TALK_ID_70_2150_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395534,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……まあ、忘れたからって",
          "tc": "……不過忘記了",
          "sc": "……不过忘记了"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395541,
          "spk": "琪娜娜 (チナナ)",
          "ja": "困るものでもないんだろうけど",
          "tc": "好像也不會有什麼不便就是了。",
          "sc": "好像也不会有什么不便就是了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395552,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ただ……なんとなくだけどね",
          "tc": "只是……我有時候會覺得，",
          "sc": "只是……我有时候会觉得，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395559,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自分が自分じゃなくなるような",
          "tc": "自己似乎變得不像是我自己似的，",
          "sc": "自己似乎变得不像是我自己似的，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395566,
          "spk": "琪娜娜 (チナナ)",
          "ja": "変な気持ちになるんだよ",
          "tc": "心情很複雜。",
          "sc": "心情很复杂。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395577,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だから、そういう時はこうやって",
          "tc": "所以這種時候我就會像現在這樣，",
          "sc": "所以这种时候我就会像现在这样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 395584,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人の時間を持つようにしているんだ",
          "tc": "為自己保留獨處的時間。",
          "sc": "为自己保留独处的时间。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7910,
      "rec_id": "TALK_ID_70_2150_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395609,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395616,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、邪魔をしたかって？",
          "tc": "哈哈哈，你怕打擾到我嗎？",
          "sc": "哈哈哈，你怕打扰到我吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395623,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そんなことはないよ",
          "tc": "不至於啦。",
          "sc": "不至于啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395634,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと深刻ぶって",
          "tc": "我剛剛是刻意",
          "sc": "我刚刚是刻意"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395641,
          "spk": "琪娜娜 (チナナ)",
          "ja": "話したけどね",
          "tc": "講得好像很嚴重一樣。",
          "sc": "讲得好像很严重一样。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395648,
          "spk": "琪娜娜 (チナナ)",
          "ja": "要は、あれだよ",
          "tc": "總而言之呢……",
          "sc": "总而言之呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 395659,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人はたまに、",
          "tc": "就是大人",
          "sc": "就是大人"
        },
        {
          "f_idx": 7,
          "pidx_tc": 395666,
          "spk": "琪娜娜 (チナナ)",
          "ja": "センチメンタルに",
          "tc": "偶爾都會比較",
          "sc": "偶尔都会比较"
        },
        {
          "f_idx": 8,
          "pidx_tc": 395673,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なるって話なんだよ",
          "tc": "感性一點啦。",
          "sc": "感性一点啦。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 395684,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それにねえ、見なよ",
          "tc": "而且你看，",
          "sc": "而且你看，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 395691,
          "spk": "琪娜娜 (チナナ)",
          "ja": "綺麗な空だろう？",
          "tc": "天空是不是很美？",
          "sc": "天空是不是很美？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7911,
      "rec_id": "TALK_ID_70_2150_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395715,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こんなに綺麗な星空は",
          "tc": "這麼漂亮的星空，",
          "sc": "这么漂亮的星空，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395722,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一人で見るより誰かと見たほうが",
          "tc": "與其自己一個人獨享，",
          "sc": "与其自己一个人独享，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395729,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいに決まっているよ",
          "tc": "還不如找人一起欣賞呢。",
          "sc": "还不如找人一起欣赏呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395740,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……キミといる",
          "tc": "……與你相處的時間",
          "sc": "……与你相处的时间"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395747,
          "spk": "琪娜娜 (チナナ)",
          "ja": "時間は、悪くないよ",
          "tc": "還不賴喔。",
          "sc": "还不赖哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395758,
          "spk": "琪娜娜 (チナナ)",
          "ja": "できれば、これからも",
          "tc": "如果可以，",
          "sc": "如果可以，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 395765,
          "spk": "琪娜娜 (チナナ)",
          "ja": "末長いお付き合いを",
          "tc": "我還想請你",
          "sc": "我还想请你"
        },
        {
          "f_idx": 7,
          "pidx_tc": 395772,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お願いしたいところだねえ",
          "tc": "以後也繼續跟我做朋友呢。",
          "sc": "以后也继续跟我做朋友呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7912,
      "rec_id": "TALK_ID_70_2150_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395790,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、ありがとさん",
          "tc": "哈哈哈，謝啦。",
          "sc": "哈哈哈，谢啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395801,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これからは、もっとちょくちょく",
          "tc": "以後你記得",
          "sc": "以后你记得"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395808,
          "spk": "琪娜娜 (チナナ)",
          "ja": "店に顔を出しにおいで",
          "tc": "要更常來店裡露面喔。",
          "sc": "要更常来店里露面哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395819,
          "spk": "琪娜娜 (チナナ)",
          "ja": "気が向いたら",
          "tc": "我心情好的話",
          "sc": "我心情好的话"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395826,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かサービスするからさ",
          "tc": "就會送你一些優惠的。",
          "sc": "就会送你一些优惠的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7913,
      "rec_id": "TALK_ID_70_2150_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395844,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……じゃあ",
          "tc": "……那麼就先晚安囉，",
          "sc": "……那么就先说晚安啦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395851,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おやすみ、またね",
          "tc": "下次再見。",
          "sc": "下次再见。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7914,
      "rec_id": "TALK_ID_70_2150_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395875,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>，",
          "sc": "欢迎光临，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395882,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 395893,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日食べてもらうのは",
          "tc": "今天要請你吃的是",
          "sc": "今天要请你吃的是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 395900,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「おにぎりと漬物定食」だよ",
          "tc": "「飯糰與醃漬物定食」。",
          "sc": "“饭团与腌渍物定食”。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 395911,
          "spk": "琪娜娜 (チナナ)",
          "ja": "もちろん、漬物は",
          "tc": "醃漬物當然是用",
          "sc": "腌渍物当然是用"
        },
        {
          "f_idx": 5,
          "pidx_tc": 395918,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミが前に探してくれた",
          "tc": "你之前幫我找的",
          "sc": "你之前帮我找的"
        },
        {
          "f_idx": 6,
          "pidx_tc": 395925,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物石を使って漬けたからね",
          "tc": "醃菜石醃出來的。",
          "sc": "腌菜石腌出来的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 395934,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おにぎりは",
          "tc": "然後烤飯糰上面抹的",
          "sc": "然后烤饭团上面抹的"
        },
        {
          "f_idx": 8,
          "pidx_tc": 395941,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自家製の味噌を",
          "tc": "是我自製的味噌，",
          "sc": "是我自制的味噌，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 395948,
          "spk": "琪娜娜 (チナナ)",
          "ja": "塗って焼いた自信作さ",
          "tc": "是我的得意之作喔。",
          "sc": "是我的得意之作哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 395959,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、食べようか",
          "tc": "來，我們開動吧。",
          "sc": "来，我们开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7915,
      "rec_id": "TALK_ID_70_2150_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 395983,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい食べっぷりだねえ",
          "tc": "你吃得很豪邁呢，",
          "sc": "你吃得很豪迈呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 395990,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見ていて気持ちがいいよ",
          "tc": "令人看了真開心。",
          "sc": "令人看了真开心。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396001,
          "spk": "琪娜娜 (チナナ)",
          "ja": "シンプルな食事でも",
          "tc": "簡單的餐點",
          "sc": "简单的餐点"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396008,
          "spk": "琪娜娜 (チナナ)",
          "ja": "こだわって作ると",
          "tc": "也只要用心製作，",
          "sc": "也只要用心制作，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396015,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やたらとおいしくなるんだよ",
          "tc": "就能變得特別好吃。",
          "sc": "就能变得特别好吃。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396026,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチのトラックはいっつも",
          "tc": "雖然我的卡車上",
          "sc": "虽然我的卡车上"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396033,
          "spk": "琪娜娜 (チナナ)",
          "ja": "商品をたくさん乗せるけどね",
          "tc": "總是載著一大堆商品，",
          "sc": "总是载着一大堆商品，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396051,
          "spk": "琪娜娜 (チナナ)",
          "ja": "漬物樽と味噌壺の",
          "tc": "但無論如何",
          "sc": "但无论如何"
        },
        {
          "f_idx": 9,
          "pidx_tc": 396058,
          "spk": "琪娜娜 (チナナ)",
          "ja": "スペースだけは何がなんでも",
          "tc": "我一定都會留空間給",
          "sc": "我一定都会留空间给"
        },
        {
          "f_idx": 10,
          "pidx_tc": 396065,
          "spk": "琪娜娜 (チナナ)",
          "ja": "死守しているんだよ",
          "tc": "醃菜桶與味噌甕喔。",
          "sc": "腌菜桶与味噌瓮哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7916,
      "rec_id": "TALK_ID_70_2150_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396083,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……料理が好きというよりは",
          "tc": "嗯……與其說我喜歡下廚，",
          "sc": "嗯……与其说我喜欢下厨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396090,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何かを仕込むのが好きっていうほうが",
          "tc": "不如說",
          "sc": "不如说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396097,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチにはしっくり来るかもしれないね",
          "tc": "我比較喜歡備料吧。",
          "sc": "我比较喜欢备料吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396108,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、漬物が残っているよ",
          "tc": "來，醃漬物還有很多。",
          "sc": "来，腌渍物还有很多。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396115,
          "spk": "琪娜娜 (チナナ)",
          "ja": "きっちり食べておくれ",
          "tc": "多吃點吧。",
          "sc": "多吃点吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちなみにキミは、",
          "tc": "順便問一下……",
          "sc": "顺便问一下……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きなものから食べちゃう派かい？",
          "tc": "你是先從喜歡的東西開始吃嗎？",
          "sc": "你是先从喜欢的东西开始吃吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396149,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 9,
          "pidx_tc": 396156,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7917,
      "rec_id": "TALK_ID_70_2150_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは絶対に",
          "tc": "我一定是",
          "sc": "我一定是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396238,
          "spk": "琪娜娜 (チナナ)",
          "ja": "好きなものから食べるよ",
          "tc": "先從喜歡的開始吃。",
          "sc": "先从喜欢的开始吃。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396249,
          "spk": "琪娜娜 (チナナ)",
          "ja": "だって、もしも今この瞬間に",
          "tc": "因為要是此時此刻",
          "sc": "因为要是此时此刻"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396256,
          "spk": "琪娜娜 (チナナ)",
          "ja": "隕石が落っこちてきて",
          "tc": "有隕石掉了下來，",
          "sc": "有陨石掉了下来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396263,
          "spk": "琪娜娜 (チナナ)",
          "ja": "死んじゃったとするだろ？",
          "tc": "我就此喪命了，",
          "sc": "我就此丧命了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396274,
          "spk": "琪娜娜 (チナナ)",
          "ja": "その時に好きなものを残していたら",
          "tc": "但我卻留下了喜歡的東西還沒吃，",
          "sc": "但我却留下了喜欢的东西还没吃，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396281,
          "spk": "琪娜娜 (チナナ)",
          "ja": "後悔するに決まっているからね",
          "tc": "那我一定會後悔莫及的啊。",
          "sc": "那我一定会后悔莫及的啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396299,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあ、漬物のキュウリとナスは",
          "tc": "不過醃小黃瓜和茄子",
          "sc": "不过腌黄瓜和茄子"
        },
        {
          "f_idx": 9,
          "pidx_tc": 396306,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どっちも好きなものだから",
          "tc": "都是我愛吃的，",
          "sc": "都是我爱吃的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 396313,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今の質問には関係ないけどさ",
          "tc": "所以這跟剛剛的問題沒有任何關係就是了。",
          "sc": "所以这跟刚刚的问题没有任何关系就是了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 396324,
          "spk": "琪娜娜 (チナナ)",
          "ja": "また新しい漬物を仕込んでおくから",
          "tc": "我之後會再準備新的醃漬物的，",
          "sc": "我之后会再准备新的腌渍物的，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 396331,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい具合になったら声をかけるよ",
          "tc": "等醃得差不多了我會再告訴你，",
          "sc": "等腌得差不多了我会再告诉你，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 396338,
          "spk": "琪娜娜 (チナナ)",
          "ja": "都合が合ったら食べにおいで",
          "tc": "所以你有空就再過來吃吧。",
          "sc": "所以你有空就再过来吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7918,
      "rec_id": "TALK_ID_70_2150_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396362,
          "spk": "琪娜娜 (チナナ)",
          "ja": "来たね、<player>",
          "tc": "你來啦，<player>，",
          "sc": "你来啦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396369,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396376,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日キミに出すのは",
          "tc": "今天我要招待你吃的是……",
          "sc": "今天我要招待你吃的是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396387,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「オリジナルラーメン」だよ",
          "tc": "我的「自創拉麵」喔。",
          "sc": "我的“自创拉面”哦。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396394,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチの大好物さ",
          "tc": "這是我的最愛。",
          "sc": "这是我的最爱。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396405,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、座って座って",
          "tc": "來，快坐快坐，",
          "sc": "来，快坐快坐，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396412,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっそく食べようじゃないか",
          "tc": "我們趕快來開動吧。",
          "sc": "我们赶快来开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7919,
      "rec_id": "TALK_ID_70_2150_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396436,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はあ……",
          "tc": "呼……",
          "sc": "呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396443,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おいしいねえ……",
          "tc": "真好吃……",
          "sc": "真好吃……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396452,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外で食べる料理の中では",
          "tc": "在村子外面吃的料理之中，",
          "sc": "在村子外面吃的料理之中，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396459,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やっぱりラーメンが",
          "tc": "果然還是拉麵",
          "sc": "果然还是拉面"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396466,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ダントツで好きなんだよねえ……",
          "tc": "最得我心呢……",
          "sc": "最得我心呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396477,
          "spk": "琪娜娜 (チナナ)",
          "ja": "袋麺を茹でて、その時ある材料を",
          "tc": "雖然不過就是煮個麵條，",
          "sc": "虽然不过就是煮个面条，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396484,
          "spk": "琪娜娜 (チナナ)",
          "ja": "炒めて、適当に乗っけただけなのに",
          "tc": "然後看手邊有什麼材料就炒一炒放上去，",
          "sc": "然后看手边有什么材料就炒一炒放上去，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396500,
          "spk": "琪娜娜 (チナナ)",
          "ja": "青空を見ながら食べると",
          "tc": "但是邊看著藍天邊吃，",
          "sc": "但是边看着蓝天边吃，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 396507,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ものすごくおいしく感じるんだよ",
          "tc": "卻會覺得格外美味。",
          "sc": "却会觉得格外美味。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 396518,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうそう",
          "tc": "……啊，對了對了，",
          "sc": "……啊，对了对了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 396525,
          "spk": "琪娜娜 (チナナ)",
          "ja": "思いだした",
          "tc": "我想起來了。",
          "sc": "我想起来了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 396536,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日は<player>を招いたからね",
          "tc": "今天都邀<player>來了，",
          "sc": "今天都邀<player>来了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 396543,
          "spk": "琪娜娜 (チナナ)",
          "ja": "贅沢に卵を乗せようと思っていたんだ",
          "tc": "我想說要奢侈一點，來加顆蛋。",
          "sc": "我想说要奢侈一点，来加颗蛋。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 396561,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕込んである味付き玉子か、",
          "tc": "我這邊有醬油溏心蛋，",
          "sc": "我这边有酱油溏心蛋，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 396568,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さっき焼いたばかりの目玉焼きか、",
          "tc": "還有剛剛煎好的荷包蛋，",
          "sc": "还有刚刚煎好的荷包蛋，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 396575,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どっちがいいかな？",
          "tc": "你想要哪一個？",
          "sc": "你想要哪一个？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 396584,
          "spk": "主角心声/旁白/选项",
          "ja": "味付き玉子",
          "tc": "醬油溏心蛋",
          "sc": "酱油溏心蛋"
        },
        {
          "f_idx": 19,
          "pidx_tc": 396591,
          "spk": "主角心声/旁白/选项",
          "ja": "目玉焼き",
          "tc": "荷包蛋",
          "sc": "荷包蛋"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7920,
      "rec_id": "TALK_ID_70_2150_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396709,
          "spk": "琪娜娜 (チナナ)",
          "ja": "最初から卵があってもいいけど",
          "tc": "其實也可以一開始就把蛋加進去，",
          "sc": "其实也可以一开始就把蛋加进去，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396716,
          "spk": "琪娜娜 (チナナ)",
          "ja": "途中からだとちょっとした味変に",
          "tc": "不過吃到一半再加可以享受到味道的變化，",
          "sc": "不过吃到一半再加可以享受到味道的变化，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396723,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なって、これはこれでいいよね",
          "tc": "這樣也很不錯。",
          "sc": "这样也很不错。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396734,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……どう？",
          "tc": "……怎麼樣？",
          "sc": "……怎么样？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396741,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お腹いっぱいに",
          "tc": "你有沒有",
          "sc": "你有没有"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396748,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なりそうかい？",
          "tc": "吃飽啊？",
          "sc": "吃饱啊？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396759,
          "spk": "琪娜娜 (チナナ)",
          "ja": "替え玉が欲しかったら",
          "tc": "如果還想要加麵的話，",
          "sc": "如果还想要加面的话，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 396766,
          "spk": "琪娜娜 (チナナ)",
          "ja": "遠慮なく言ってくれて",
          "tc": "不用客氣，",
          "sc": "不用客气，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396773,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いいからね",
          "tc": "儘管開口喔。",
          "sc": "尽管开口哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7921,
      "rec_id": "TALK_ID_70_2150_009_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396797,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 396804,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ご馳走を用意して",
          "tc": "我已經準備好了大餐，",
          "sc": "我已经准备好了大餐，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 396811,
          "spk": "琪娜娜 (チナナ)",
          "ja": "待っていたよ",
          "tc": "就等你來了。",
          "sc": "就等你来了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 396822,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今日はウチのお手製",
          "tc": "今天是我自製的",
          "sc": "今天是我自制的"
        },
        {
          "f_idx": 4,
          "pidx_tc": 396829,
          "spk": "琪娜娜 (チナナ)",
          "ja": "「バーニャカウダ」だよ",
          "tc": "「熱沾醬沙拉」。",
          "sc": "“热沾酱沙拉”。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 396838,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ニンニクやオリーブオイルを混ぜたソースを",
          "tc": "把加入了大蒜與橄欖油的醬汁",
          "sc": "把加入了大蒜与橄榄油的酱汁"
        },
        {
          "f_idx": 6,
          "pidx_tc": 396845,
          "spk": "琪娜娜 (チナナ)",
          "ja": "温めてから、野菜につけて食べるんだよ",
          "tc": "加熱過後，就可以用蔬菜沾著吃了。",
          "sc": "加热过后，就可以用蔬菜沾着吃了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 396852,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチのは唐辛子もいっぱい入れてあるんだ",
          "tc": "我獨創的秘訣是加入很多辣椒。",
          "sc": "我独创的秘诀是加入很多辣椒。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 396863,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さあ、冷めないうちに",
          "tc": "來吧，",
          "sc": "来吧，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 396870,
          "spk": "琪娜娜 (チナナ)",
          "ja": "召し上がれ",
          "tc": "我們趕快趁熱吃。",
          "sc": "我们赶快趁热吃。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7922,
      "rec_id": "TALK_ID_70_2150_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396894,
          "spk": "琪娜娜 (チナナ)",
          "ja": "んん～……",
