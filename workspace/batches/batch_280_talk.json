      "rec_id": "TALK_ID_70_2150_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 396926,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっはっはっは",
          "tc": "啊哈哈哈，",
