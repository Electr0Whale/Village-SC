        },
        {
          "f_idx": 3,
          "pidx_tc": 397142,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちゃんと辛くないディップも",
          "tc": "我還有準備不辣的沾醬，",
          "sc": "我还有准备不辣的沾酱，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 397149,
          "spk": "琪娜娜 (チナナ)",
          "ja": "用意してあるから安心するといいよ",
          "tc": "所以你就放心吧。",
          "sc": "所以你就放心吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 397160,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……早く一緒に",
          "tc": "……真希望",
          "sc": "……真希望"
        },
        {
          "f_idx": 6,
          "pidx_tc": 397167,
          "spk": "琪娜娜 (チナナ)",
          "ja": "辛いものとビールを",
          "tc": "你能趕快長大，",
          "sc": "你能赶快长大，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 397174,
          "spk": "琪娜娜 (チナナ)",
          "ja": "楽しめるようになりたいねえ",
          "tc": "我們就可以一起享用辣的食物跟啤酒了呢。",
          "sc": "我们就可以一起享用辣的食物跟啤酒了呢。"
