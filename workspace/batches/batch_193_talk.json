      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265998,
          "spk": "帷 (トバリ)",
          "ja": "コマコは……？",
          "tc": "駒子……？",
          "sc": "驹子……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 266005,
          "spk": "帷 (トバリ)",
          "ja": "どうして協力できないの？",
          "tc": "妳為什麼不能幫忙？",
          "sc": "你为什么不能帮忙？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 266014,
          "spk": "帷 (トバリ)",
          "ja": "村の掟に、",
          "tc": "就因為村子有",
          "sc": "就因为村子有"
        },
        {
          "f_idx": 3,
          "pidx_tc": 266021,
          "spk": "帷 (トバリ)",
          "ja": "<strong>「他人の秘密を暴くな」</strong>って",
