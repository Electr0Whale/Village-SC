      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265096,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ、二人とも",
          "tc": "那就這樣吧，",
          "sc": "那就这样吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265103,
          "spk": "帷 (トバリ)",
          "ja": "計画はまた後日話すから",
