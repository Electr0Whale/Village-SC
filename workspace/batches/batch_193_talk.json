    {
      "file": "talk.dat",
      "rec_idx": 4604,
      "rec_id": "TALK_ID_10_0401_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264482,
          "spk": "帷 (トバリ)",
          "ja": "私ね、この前のこと",
          "tc": "之前的事情，",
          "sc": "之前的事情，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264489,
          "spk": "帷 (トバリ)",
          "ja": "もう怒っていないわ",
          "tc": "我呢，已經沒有在生氣了。",
          "sc": "我呢，已经没有在生气了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264500,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちはリンの言うことに、",
          "tc": "因為我已經非常清楚，",
          "sc": "因为我已经非常清楚，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 264507,
          "spk": "帷 (トバリ)",
          "ja": "絶対逆らえないことが、よくわかったから",
          "tc": "你們絕對沒辦法反抗林的指示。",
          "sc": "你们绝对没办法反抗林的指示。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 264527,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そんなこと",
          "tc": "才、才沒有……",
          "sc": "才、才没有……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 264540,
          "spk": "帷 (トバリ)",
          "ja": "私がアンタたちを、",
          "tc": "我要讓你們",
          "sc": "我要让你们"
        },
        {
          "f_idx": 7,
          "pidx_tc": 264547,
          "spk": "帷 (トバリ)",
          "ja": "自由にしてあげる",
          "tc": "獲得自由。",
          "sc": "获得自由。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4605,
      "rec_id": "TALK_ID_10_0401_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264565,
          "spk": "帷 (トバリ)",
          "ja": "だから……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264572,
          "spk": "帷 (トバリ)",
          "ja": "手伝ってほしいことがあるの",
          "tc": "有點事我想請你們幫忙。",
          "sc": "有点事我想请你们帮忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264585,
          "spk": "驹子 (コマコ)",
          "ja": "な、なにかな……",
          "tc": "什、什麼事……？",
          "sc": "什、什么事……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4606,
      "rec_id": "TALK_ID_10_0401_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264603,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちも気づいているでしょう",
          "tc": "你們應該也察覺到了吧。",
          "sc": "你们应该也察觉到了吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264612,
          "spk": "帷 (トバリ)",
          "ja": "掟も、呪いも、全部リンが作り出している",
          "tc": "什麼規矩、詛咒，全都是林捏造出來的。",
          "sc": "什么规矩、诅咒，全都是林捏造出来的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264619,
          "spk": "帷 (トバリ)",
          "ja": "恐怖で村を縛り付けるために",
          "tc": "為的是用恐懼來束縛這座村子。",
          "sc": "为的是用恐惧来束缚这座村子。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 264637,
          "spk": "帷 (トバリ)",
          "ja": "その上、次は儀式とか言って",
          "tc": "而且之前她還提到接下來的儀式，",
          "sc": "而且之前她还提到接下来的仪式，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 264644,
          "spk": "帷 (トバリ)",
          "ja": "なにかを準備しているわ",
          "tc": "正在進行某種準備。",
          "sc": "正在进行某种准备。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 264655,
          "spk": "帷 (トバリ)",
          "ja": "私は、その具体的な証拠を掴んで",
          "tc": "所以我打算找出具體的證據，",
          "sc": "所以我打算找出具体的证据，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 264662,
          "spk": "帷 (トバリ)",
          "ja": "真実を明らかにするつもり",
          "tc": "讓一切真相大白。",
          "sc": "让一切真相大白。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4607,
      "rec_id": "TALK_ID_10_0401_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264680,
          "spk": "驹子 (コマコ)",
          "ja": "リンがそんなこと……",
          "tc": "我覺得林……",
          "sc": "我觉得林……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264687,
          "spk": "驹子 (コマコ)",
          "ja": "しないと思うけど……",
          "tc": "應該不會做那種事情才對……",
          "sc": "应该不会做那种事情才对……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4608,
      "rec_id": "TALK_ID_10_0401_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264705,
          "spk": "帷 (トバリ)",
          "ja": "してるのよ……",
          "tc": "我都看到了……",
          "sc": "我都看到了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264712,
          "spk": "帷 (トバリ)",
          "ja": "私が深夜に出歩いた時に",
          "tc": "因為我深夜外出散步時，",
          "sc": "因为我深夜外出散步时，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264719,
          "spk": "帷 (トバリ)",
          "ja": "リンが怪物を呼んでいるのを見たんだから",
          "tc": "看到林正在召喚怪物的場面。",
          "sc": "看到林正在召唤怪物的场面。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4609,
      "rec_id": "TALK_ID_10_0401_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264737,
          "spk": "驹子 (コマコ)",
          "ja": "そんな……まさか……",
          "tc": "這……怎麼可能……",
          "sc": "这……怎么可能……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264744,
          "spk": "驹子 (コマコ)",
          "ja": "そもそもどうして、",
          "tc": "說到底這是為什麼，",
          "sc": "说到底这是为什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264751,
          "spk": "驹子 (コマコ)",
          "ja": "リンの秘密を暴こうなんて……",
          "tc": "妳竟然想揭發林的祕密……",
          "sc": "你竟然想揭发林的秘密……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 264764,
          "spk": "帷 (トバリ)",
          "ja": "リンを、村長の座から引きずり降ろして、",
          "tc": "我要把林從村長的寶座拉下來，",
          "sc": "我要把林从村长的宝座拉下来，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 264771,
          "spk": "帷 (トバリ)",
          "ja": "この支配を終わらせる……",
          "tc": "結束這場統治……",
          "sc": "结束这场统治……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 264782,
          "spk": "帷 (トバリ)",
          "ja": "その証拠を掴むために、",
          "tc": "為了找到證據，",
          "sc": "为了找到证据，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 264789,
          "spk": "帷 (トバリ)",
          "ja": "やりたいことがあるの",
          "tc": "我有想要做的事。",
          "sc": "我有想要做的事。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4610,
      "rec_id": "TALK_ID_10_0401_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264805,
          "spk": "帷 (トバリ)",
          "ja": "二人とも、もちろん",
          "tc": "你們兩個，",
          "sc": "你们两个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264812,
          "spk": "帷 (トバリ)",
          "ja": "手伝ってくれるでしょ？",
          "tc": "一定會幫助我吧？",
          "sc": "一定会帮助我吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264825,
          "spk": "驹子 (コマコ)",
          "ja": "そ、それは……",
          "tc": "呃，這……",
          "sc": "呃，这……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 264832,
          "spk": "驹子 (コマコ)",
          "ja": "えっと……私には……",
          "tc": "那個……我……",
          "sc": "那个……我……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4611,
      "rec_id": "TALK_ID_10_0401_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264850,
          "spk": "帷 (トバリ)",
          "ja": "コマコ、アンタの性質はもう知ってる",
          "tc": "駒子，我已經摸透妳的本性了。",
          "sc": "驹子，我已经摸透你的本性了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264861,
          "spk": "帷 (トバリ)",
          "ja": "アンタには、自分の意志がない……",
          "tc": "妳沒有自己的意志……",
          "sc": "你没有自己的意志……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264868,
          "spk": "帷 (トバリ)",
          "ja": "言われた全てに従ってしまう性格なのよね",
          "tc": "妳的個性就是不管別人講什麼都會言聽計從。",
          "sc": "你的个性就是不管别人讲什么都会言听计从。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 264888,
          "spk": "驹子 (コマコ)",
          "ja": "……え",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 264895,
          "spk": "驹子 (コマコ)",
          "ja": "……あ",
          "tc": "……啊。",
          "sc": "……啊。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 264908,
          "spk": "帷 (トバリ)",
          "ja": "だったら私の頼みも、",
          "tc": "那麼我的請求，",
          "sc": "那么我的请求，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 264915,
          "spk": "帷 (トバリ)",
          "ja": "もちろん聞いてくれるでしょ？",
          "tc": "妳當然也會願意答應對吧？",
          "sc": "你当然也会愿意答应对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4612,
      "rec_id": "TALK_ID_10_0401_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264933,
          "spk": "驹子 (コマコ)",
          "ja": "う……でも……",
          "tc": "唔……可是……",
          "sc": "唔……可是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4613,
      "rec_id": "TALK_ID_10_0401_005_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 264951,
          "spk": "帷 (トバリ)",
          "ja": "……どうしてためらうわけ？",
          "tc": "……妳為什麼猶豫不決？",
          "sc": "……你为什么犹豫不决？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 264964,
          "spk": "驹子 (コマコ)",
          "ja": "ど、どうしてって",
          "tc": "妳、妳問為什麼……",
          "sc": "你、你问为什么……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 264973,
          "spk": "驹子 (コマコ)",
          "ja": "だって村の掟では、",
          "tc": "因為，村子的規矩就說了，",
          "sc": "因为，村子的规矩就说了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 264980,
          "spk": "驹子 (コマコ)",
          "ja": "秘密は暴いちゃダメって……",
          "tc": "「不可揭露他人祕密」啊……",
          "sc": "“不可揭露他人秘密”啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 264993,
          "spk": "帷 (トバリ)",
          "ja": "私にだけは従えないってこと？",
          "tc": "所以妳偏偏就是不聽我的請求嗎？",
          "sc": "所以你偏偏就是不听我的请求吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265008,
          "spk": "驹子 (コマコ)",
          "ja": "……いや、そういうわけじゃ",
          "tc": "……不是的，我沒有那個意思。",
          "sc": "……不是的，我没有那个意思。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4614,
      "rec_id": "TALK_ID_10_0401_005_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265026,
          "spk": "帷 (トバリ)",
          "ja": "アンタもよ、<player>",
          "tc": "<player>，你也一樣。",
          "sc": "<player>，你也一样。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265033,
          "spk": "帷 (トバリ)",
          "ja": "命令に絶対逆らわない",
          "tc": "你絕對不會違抗他人的命令。",
          "sc": "你绝对不会违抗他人的命令。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265051,
          "spk": "帷 (トバリ)",
          "ja": "ただのお人よしじゃないでしょう",
          "tc": "不單純因為你是個濫好人，",
          "sc": "不单纯因为你是个滥好人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265058,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちは二人とも、",
          "tc": "而是因為你們兩個都只會隨波逐流，",
          "sc": "而是因为你们两个都只会随波逐流，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265065,
          "spk": "帷 (トバリ)",
          "ja": "流されているだけで自分の意志がないのよ",
          "tc": "沒有自己的主見！",
          "sc": "没有自己的主见！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 265078,
          "spk": "驹子 (コマコ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
