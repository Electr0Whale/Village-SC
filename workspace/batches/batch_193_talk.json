        },
        {
          "f_idx": 1,
          "pidx_tc": 265709,
          "spk": "帷 (トバリ)",
          "ja": "今日はアンタに話があって、",
          "tc": "今天我有事情要找你談，",
          "sc": "今天我有事情要找你谈，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265716,
          "spk": "帷 (トバリ)",
          "ja": "コマコも呼んでいるんだけれど……",
          "tc": "我也有找駒子來啦……",
          "sc": "我也有找驹子来啦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4628,
      "rec_id": "TALK_ID_10_0401_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265734,
          "spk": "帷 (トバリ)",
          "ja": "嫌がっていたけれど、",
          "tc": "雖然她看起來很不情願，",
          "sc": "虽然她看起来很不情愿，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265741,
          "spk": "帷 (トバリ)",
          "ja": "あの子は絶対に来るわ",
          "tc": "但她一定會來的。",
