          "pidx_tc": 265231,
          "spk": "六角 (ロッカク)",
          "ja": "なんか食べていくっスか？",
          "tc": "你要吃點什麼嗎？",
          "sc": "你要吃点什么不？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4620,
      "rec_id": "TALK_ID_10_0401_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265256,
          "spk": "六角 (ロッカク)",
          "ja": "あら、トバリさんだ",
          "tc": "哎呀，是帷妹妹啊。",
          "sc": "哎呀，是帷妹妹啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265263,
          "spk": "六角 (ロッカク)",
          "ja": "こんな時間からめずらしい",
          "tc": "難得這個時間看到妳耶。",
          "sc": "难得这个时间看到你呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4621,
      "rec_id": "TALK_ID_10_0401_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265281,
          "spk": "六角 (ロッカク)",
          "ja": "トバリさん、またなんも",
          "tc": "帷妹妹，",
          "sc": "帷妹妹，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265288,
          "spk": "六角 (ロッカク)",
          "ja": "食べてないんじゃないんスか",
          "tc": "妳是不是又什麼都沒吃啊？",
          "sc": "你是不是又什么都没吃啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265299,
          "spk": "六角 (ロッカク)",
          "ja": "ウチでなんか食べません？",
          "tc": "要不要去我們餐廳吃點東西？",
          "sc": "要不要去我们餐厅吃点东西？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265306,
          "spk": "六角 (ロッカク)",
          "ja": "村の野菜をたっぷり使った美味しいご飯、",
          "tc": "讓我用村裡種的大把蔬菜，",
          "sc": "让我用村里种的大把蔬菜，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265313,
          "spk": "六角 (ロッカク)",
          "ja": "振る舞うっスよ",
          "tc": "做一頓好吃的給妳吧！",
          "sc": "做一顿好吃的给你哟！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4622,
      "rec_id": "TALK_ID_10_0401_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265333,
          "spk": "帷 (トバリ)",
          "ja": "別にいらない",
          "tc": "我才不需要。",
          "sc": "我才不需要。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4623,
      "rec_id": "TALK_ID_10_0401_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265351,
          "spk": "帷 (トバリ)",
          "ja": "この村で作られたものなんて、",
          "tc": "這座村子種出來的東西，",
          "sc": "这座村子种出来的东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265358,
          "spk": "帷 (トバリ)",
          "ja": "食べたらどうなるかわからないもの",
          "tc": "天曉得吃了會怎樣。",
          "sc": "天晓得吃了会怎样。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265371,
          "spk": "六角 (ロッカク)",
          "ja": "そんな、怪しいモンは入ってないっスよ",
          "tc": "怎麼這麼說啊，我才不會放奇怪的東西進去呢。",
          "sc": "怎么这么说啊，我才不会放奇怪的东西进去哟。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265384,
          "spk": "帷 (トバリ)",
          "ja": "アンタも信用できないのよ",
          "tc": "你也不能信任。",
          "sc": "你也不能信任。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265391,
          "spk": "帷 (トバリ)",
          "ja": "知っているんだから",
          "tc": "這點我很清楚。",
          "sc": "这点我很清楚。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265400,
          "spk": "帷 (トバリ)",
          "ja": "この村の人間たちは、",
          "tc": "這座村子裡的所有人，",
          "sc": "这座村子里的所有人，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 265407,
          "spk": "帷 (トバリ)",
          "ja": "全員で村の闇を隠しているのを",
          "tc": "一個個都在隱瞞村子見不得光的祕密。",
          "sc": "一个个都在隐瞒村子见不得光的秘密。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 265420,
          "spk": "六角 (ロッカク)",
          "ja": "そんな……",
          "tc": "怎麼這麼說……",
          "sc": "怎么这么说……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 265427,
          "spk": "六角 (ロッカク)",
          "ja": "闇だとかってほどじゃねえっスよ",
          "tc": "沒有到見不得光的程度啦。",
          "sc": "没有到见不得光的程度哟。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 265438,
          "spk": "六角 (ロッカク)",
          "ja": "秘密くらい生きてたら、",
          "tc": "祕密這種東西，只要活在這世上，",
          "sc": "秘密这种东西，只要活在这世上，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 265445,
          "spk": "六角 (ロッカク)",
          "ja": "一つや二つぐらい……",
          "tc": "總會有一兩個嘛……",
          "sc": "总会有一两个嘛……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 265465,
          "spk": "帷 (トバリ)",
          "ja": "はぐらかしても無駄よ",
          "tc": "你這樣模糊焦點也沒用的。",
          "sc": "你这样模糊焦点也没用的。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 265481,
          "spk": "帷 (トバリ)",
          "ja": "いつか村の暗がりを、",
          "tc": "我總有一天，",
          "sc": "我总有一天，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 265488,
          "spk": "帷 (トバリ)",
          "ja": "絶対に暴いてやるから",
          "tc": "一定會揭穿這座村子的陰暗面。",
          "sc": "一定会揭穿这座村子的阴暗面。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 265508,
          "spk": "六角 (ロッカク)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4624,
      "rec_id": "TALK_ID_10_0401_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265530,
          "spk": "六角 (ロッカク)",
          "ja": "……その暗がりは、",
          "tc": "……妳難道沒有想過，",
          "sc": "……你难道没有想过，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265537,
          "spk": "六角 (ロッカク)",
          "ja": "誰かの秘密を守るための、",
          "tc": "那可能是為了保護某個人的祕密，",
          "sc": "那可能是为了保护某个人的秘密，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265544,
          "spk": "六角 (ロッカク)",
          "ja": "優しい闇だとは考えたことはないんスか",
          "tc": "而出於良善的陰暗面嗎？",
          "sc": "而出于良善的阴暗面吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4625,
      "rec_id": "TALK_ID_10_0401_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265564,
          "spk": "帷 (トバリ)",
          "ja": "……それでも",
          "tc": "……即使如此，",
          "sc": "……即使如此，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265575,
          "spk": "帷 (トバリ)",
          "ja": "人の自由を縛るような秘密が、",
          "tc": "難道那種束縛他人自由的祕密，",
          "sc": "难道那种束缚他人自由的秘密，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265582,
          "spk": "帷 (トバリ)",
          "ja": "優しい闇だと言うの",
          "tc": "也配稱作「良善的陰暗面」嗎？",
          "sc": "也配称作“良善的阴暗面”吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265602,
          "spk": "六角 (ロッカク)",
          "ja": "時には、口や目を閉ざすことも、",
          "tc": "妳不覺得為了守護祕密，",
          "sc": "你不觉得为了守护秘密，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265609,
          "spk": "六角 (ロッカク)",
          "ja": "秘密を守るために必要なのでは？",
          "tc": "有時候是需要裝聾作啞的嗎？",
          "sc": "有时候是需要装聋作哑的吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 265629,
          "spk": "帷 (トバリ)",
          "ja": "少なくとも、私はそんな話受け入れられない",
          "tc": "至少我是不會接受這種說法的。",
          "sc": "至少我是不会接受这种说法的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 265636,
          "spk": "帷 (トバリ)",
          "ja": "私はこの村の人間じゃないから",
          "tc": "畢竟我不是這座村子的人。",
          "sc": "毕竟我不是这座村子的人。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 265647,
          "spk": "帷 (トバリ)",
          "ja": "いつか絶対、暴いてやるから",
          "tc": "總有一天，我絕對會揭穿一切。",
          "sc": "总有一天，我绝对会揭穿一切。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4626,
      "rec_id": "TALK_ID_10_0401_006_09",
      "lines": [
        {
          "f_idx": 0,
