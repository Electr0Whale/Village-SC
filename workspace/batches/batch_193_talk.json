    {
      "file": "talk.dat",
      "rec_idx": 4631,
      "rec_id": "TALK_ID_10_0401_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265819,
          "spk": "帷 (トバリ)",
          "ja": "じゃあ、手伝って欲しいことを",
          "tc": "好了，",
          "sc": "好了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265826,
          "spk": "帷 (トバリ)",
          "ja": "説明するから",
          "tc": "我來說明要你們幫什麼忙。",
          "sc": "我来说明要你们帮什么忙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4632,
      "rec_id": "TALK_ID_10_0401_007_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265844,
          "spk": "驹子 (コマコ)",
          "ja": "……トバリ",
          "tc": "……帷。",
          "sc": "……帷。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265857,
          "spk": "帷 (トバリ)",
          "ja": "リンは毎晩、",
          "tc": "林好像每晚，",
          "sc": "林好像每晚，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265864,
          "spk": "帷 (トバリ)",
          "ja": "儀式の準備をしているらしい",
          "tc": "都在準備儀式的樣子。",
          "sc": "都在准备仪式的样子。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265875,
          "spk": "帷 (トバリ)",
          "ja": "私たちの目的は、彼女が深夜に",
          "tc": "我們的目標，",
          "sc": "我们的目标，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265882,
          "spk": "帷 (トバリ)",
          "ja": "何をしているのかを突き止め、",
          "tc": "就是查清楚她深夜都在搞什麼鬼，",
          "sc": "就是查清楚她深夜都在搞什么鬼，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 265889,
          "spk": "帷 (トバリ)",
          "ja": "現場を押さえて問い詰めること",
          "tc": "然後當場逮住她問個清楚。",
          "sc": "然后当场逮住她问个清楚。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4633,
      "rec_id": "TALK_ID_10_0401_007_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 265907,
          "spk": "帷 (トバリ)",
          "ja": "アンタたちには、証人になってもらう",
          "tc": "你們要負責當證人，",
          "sc": "你们要负责当证人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 265914,
          "spk": "帷 (トバリ)",
          "ja": "私は秘密を村の人々に明らかにして、",
          "tc": "然後我要把祕密向村民們公開，",
          "sc": "然后我要把秘密向村民们公开，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 265921,
          "spk": "帷 (トバリ)",
          "ja": "リンを村長の座から追放する",
          "tc": "把林踢下村長的寶座。",
          "sc": "把林踢下村长的宝座。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 265930,
          "spk": "帷 (トバリ)",
          "ja": "そうすれば、私も奇妙な風習の",
          "tc": "這樣一來，我也不會因為奇怪的風俗習慣，",
          "sc": "这样一来，我也不会因为奇怪的风俗习惯，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 265937,
          "spk": "帷 (トバリ)",
          "ja": "生贄になることから逃れられるかもしれない",
          "tc": "而被迫成為活祭品了。",
          "sc": "而被迫成为活祭品了。"
        }
      ]
    },
    {
