      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120640,
          "spk": "四郎治 (シロージ)",
          "ja": "俺が暑さで倒れたら",
          "tc": "我要是熱昏了，",
          "sc": "我要是热昏了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120647,
          "spk": "四郎治 (シロージ)",
          "ja": "誰か呼んできてくれると助かる",
          "tc": "希望你能幫我叫人過來。",
          "sc": "希望你能帮我叫人过来。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120658,
          "spk": "四郎治 (シロージ)",
          "ja": "……なんてな、冗談だ",
          "tc": "……我開玩笑的。",
          "sc": "……我开玩笑的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 574,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120682,
          "spk": "四郎治 (シロージ)",
          "ja": "よっと……ふう",
          "tc": "嘿咻……呼……",
          "sc": "嘿咻……呼……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120693,
          "spk": "四郎治 (シロージ)",
          "ja": "こうして必死に薪割りなんてしてると",
          "tc": "像這樣卯足全力砍柴，",
          "sc": "像这样卯足全力砍柴，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120700,
          "spk": "四郎治 (シロージ)",
          "ja": "汗が止まらねぇな……",
          "tc": "汗水就會停不下來啊……",
          "sc": "汗水就会停不下来啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 575,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120724,
          "spk": "四郎治 (シロージ)",
          "ja": "この薪はリンのところに持って行って……",
          "tc": "這些木柴要送去林那裡……",
          "sc": "这些木柴要送去林那里……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120735,
          "spk": "四郎治 (シロージ)",
          "ja": "となるとまだ数が必要か",
          "tc": "所以還需要更多木柴嗎，",
          "sc": "所以还需要更多木柴吗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120742,
          "spk": "四郎治 (シロージ)",
          "ja": "どんどん割っていかねぇとな",
          "tc": "我得繼續劈才行。",
          "sc": "我得继续劈才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 576,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120766,
          "spk": "四郎治 (シロージ)",
          "ja": "雨音を聞きながら",
          "tc": "邊聽著雨聲，",
          "sc": "边听着雨声，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120773,
          "spk": "四郎治 (シロージ)",
          "ja": "ゆっくり休憩するっていうのも",
          "tc": "邊悠哉地休息，",
          "sc": "边悠哉地休息，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120780,
          "spk": "四郎治 (シロージ)",
          "ja": "悪くねぇんだよな……",
          "tc": "感覺也挺不錯的……",
          "sc": "感觉也挺不错的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 577,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120804,
          "spk": "四郎治 (シロージ)",
          "ja": "この天気じゃ釣りはできないか……？",
          "tc": "看這天氣，好像沒辦法釣魚……？",
          "sc": "看这天气，好像没办法钓鱼……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120811,
          "spk": "四郎治 (シロージ)",
          "ja": "仕事が片付いたら、釣りにでも行って",
          "tc": "我本來想說等工作告一段落要去釣魚，",
          "sc": "我本来想说等工作告一段落要去钓鱼，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120818,
          "spk": "四郎治 (シロージ)",
          "ja": "スミレに差し入れしようと思ったんだがな",
          "tc": "然後送幾條去給堇怜的。",
          "sc": "然后送几条去给堇怜的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 578,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120842,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろ止んでくれたら",
          "tc": "真希望雨差不多可以停下來了……",
          "sc": "真希望雨差不多可以停下来了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120849,
          "spk": "四郎治 (シロージ)",
          "ja": "助かるんだが……どうなるかね",
          "tc": "也不知道會不會停。",
          "sc": "也不知道会不会停。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 579,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2013",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120873,
          "spk": "四郎治 (シロージ)",
          "ja": "暑い日に飲む冷たい水は最高だな",
          "tc": "在大熱天喝冰水最讚了。",
          "sc": "在大热天喝冰水最赞了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120891,
          "spk": "四郎治 (シロージ)",
          "ja": "でも、あんまり冷たいものを飲みすぎると",
          "tc": "但我記得喝太多冰的",
          "sc": "但我记得喝太多冰的"
        },
        {
          "f_idx": 3,
          "pidx_tc": 120898,
          "spk": "四郎治 (シロージ)",
          "ja": "よくないんだったか……？",
          "tc": "好像不太好……？",
          "sc": "好像不太好……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 580,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2014",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120922,
          "spk": "四郎治 (シロージ)",
          "ja": "時間ができたら",
          "tc": "如果有空的話，",
          "sc": "如果有空的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120929,
          "spk": "四郎治 (シロージ)",
          "ja": "サザンカの店にでも顔を出しに行くか……",
          "tc": "就去茶梅的店裡露露臉好了……",
          "sc": "就去茶梅的店里露露脸好了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 120940,
          "spk": "四郎治 (シロージ)",
          "ja": "いろいろと話もしたいしな",
          "tc": "我也有很多話想跟她聊。",
          "sc": "我也有很多话想跟她聊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 581,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2015",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120964,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……？　",
          "tc": "嗯……？",
          "sc": "嗯……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 120975,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も一緒に休んでいくか？",
          "tc": "<player>，你要跟我一起去休息嗎？",
          "sc": "<player>，你要跟我一起去休息吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 582,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 120999,
          "spk": "四郎治 (シロージ)",
          "ja": "夏場の片付けは",
          "tc": "在夏天收拾東西，",
          "sc": "在夏天收拾东西，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121006,
          "spk": "四郎治 (シロージ)",
          "ja": "他の季節よりもよっぽどしんどいな",
          "tc": "比其他季節還來得辛苦啊。",
          "sc": "比其他季节还来得辛苦啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121017,
          "spk": "四郎治 (シロージ)",
          "ja": "だからってサボれないんだけどよ",
          "tc": "但是又不能因為這樣就偷懶。",
          "sc": "但是又不能因为这样就偷懒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 583,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121048,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>はそっちを",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121055,
          "spk": "四郎治 (シロージ)",
          "ja": "片付けておいてくれ",
          "tc": "你幫我收拾那邊的東西吧。",
          "sc": "你帮我收拾那边的东西吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121066,
          "spk": "四郎治 (シロージ)",
          "ja": "……ってのは冗談だ",
          "tc": "……我開玩笑的。",
          "sc": "……我开玩笑的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 584,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121090,
          "spk": "四郎治 (シロージ)",
          "ja": "あとでコマコに道具の場所を",
          "tc": "待會得告訴駒子",
          "sc": "待会得告诉驹子"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121097,
          "spk": "四郎治 (シロージ)",
          "ja": "移動したって伝えておかねぇと",
          "tc": "我移動了工具的位置。",
          "sc": "我移动了工具的位置。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 585,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2030",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121121,
          "spk": "四郎治 (シロージ)",
          "ja": "ん、湿気の対策もしとかねぇと",
          "tc": "嗯，還要想辦法防濕氣啊，",
          "sc": "嗯，还要想办法防湿气啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121128,
          "spk": "四郎治 (シロージ)",
          "ja": "カビちまいそうだな……",
          "tc": "不然應該會發霉的吧……",
          "sc": "不然应该会发霉的吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 586,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2031",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121152,
          "spk": "四郎治 (シロージ)",
          "ja": "そろそろコンノに夏の新作を",
          "tc": "差不多該做點表示，",
          "sc": "差不多该做点表示，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121159,
          "spk": "四郎治 (シロージ)",
          "ja": "譲ってもらえるよう",
          "tc": "讓今野把今年夏天的新款式",
          "sc": "让今野把今年夏天的新款式"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121166,
          "spk": "四郎治 (シロージ)",
          "ja": "動いておかねぇとな",
          "tc": "讓給我了。",
          "sc": "让给我了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 587,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2032",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121190,
          "spk": "四郎治 (シロージ)",
          "ja": "なんだか眠くなってきたな……",
          "tc": "感覺越來越睏了……",
          "sc": "感觉越来越困了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121201,
          "spk": "四郎治 (シロージ)",
          "ja": "あと少し手入れしたら",
          "tc": "我再保養一下工具",
          "sc": "我再保养一下工具"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121208,
          "spk": "四郎治 (シロージ)",
          "ja": "今日はもう眠るとするか",
          "tc": "就去睡好了。",
          "sc": "就去睡好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 588,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2100",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121232,
          "spk": "四郎治 (シロージ)",
          "ja": "漏れはなさそうだよな……？",
          "tc": "應該沒漏掉什麼吧……？",
          "sc": "应该没漏掉什么吧……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121243,
          "spk": "四郎治 (シロージ)",
          "ja": "少しでも注文と違ってると",
          "tc": "只要跟訂單稍微有點出入，",
          "sc": "只要跟订单稍微有点出入，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121250,
          "spk": "四郎治 (シロージ)",
          "ja": "リンがうるせぇからな……",
          "tc": "林就會囉哩叭唆的……",
          "sc": "林就会啰里啰嗦的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 589,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2101",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121274,
          "spk": "四郎治 (シロージ)",
          "ja": "無事にリンに受け渡しできたら",
          "tc": "等順利交貨給林之後，",
          "sc": "等顺利交货给林之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121281,
          "spk": "四郎治 (シロージ)",
          "ja": "どこかで一服するか",
          "tc": "我就找地方來一根吧。",
          "sc": "我就找地方来一根吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 590,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2102",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121305,
          "spk": "四郎治 (シロージ)",
          "ja": "夏場は雨が多いから",
          "tc": "夏天常常下雨，",
          "sc": "夏天常常下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121312,
          "spk": "四郎治 (シロージ)",
          "ja": "薪の管理が大変なんだよな……",
          "tc": "所以管理木柴很辛苦啊……",
          "sc": "所以管理木柴很辛苦啊……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 121319,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、もちろん責任持ってやるけどさ",
          "tc": "但我還是會負起責任，把工作做好的。",
          "sc": "但我还是会负起责任，把工作做好的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 591,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2110",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121343,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……雨の日は何でもかんでも",
          "tc": "嗯……雨天就是",
          "sc": "嗯……雨天就是"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121350,
          "spk": "四郎治 (シロージ)",
          "ja": "湿気っちまうから困るな",
          "tc": "濕氣重，真令人頭痛。",
          "sc": "湿气重，真令人头痛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 592,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2111",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121374,
          "spk": "四郎治 (シロージ)",
          "ja": "ふう……今日も暑いが",
          "tc": "呼……雖然今天也很熱，",
          "sc": "呼……虽然今天也很热，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121381,
          "spk": "四郎治 (シロージ)",
          "ja": "これでもうひとがんばりできそうだ",
          "tc": "不過這樣一來我應該能再努力一下了。",
          "sc": "不过这样一来我应该能再努力一下了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 593,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2120",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121405,
          "spk": "四郎治 (シロージ)",
          "ja": "夏の暑さに負けねぇためにも",
          "tc": "為了不輸給夏天的炎熱，",
          "sc": "为了不输给夏天的炎热，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121412,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと食べとかねぇとな……",
          "tc": "我也得好好吃飯才行……",
          "sc": "我也得好好吃饭才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 594,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_2121",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 121436,
          "spk": "四郎治 (シロージ)",
          "ja": "暑いときは食欲がなくなっちまう",
          "tc": "只要天氣一熱，我就會沒有食欲。",
          "sc": "只要天气一热，我就会没有食欲。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 121447,
          "spk": "四郎治 (シロージ)",
          "ja": "ただでさえ、",
          "tc": "而且我本來就",
          "sc": "而且我本来就"
        },
        {
