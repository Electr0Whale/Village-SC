          "pidx_tc": 456956,
          "spk": "木助 (キスケ)",
          "ja": "ま、認めてやれるのは酒の肴くらいだな",
          "tc": "我是承認你的下酒菜進步很多，",
          "sc": "我是承认你的下酒菜进步很多，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 456963,
          "spk": "木助 (キスケ)",
          "ja": "飯は十年やってこの程度じゃ、",
          "tc": "不過做了十年料理還是這個程度，",
          "sc": "不过做了十年料理还是这个程度，"
