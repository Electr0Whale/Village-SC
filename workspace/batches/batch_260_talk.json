      "rec_id": "TALK_ID_70_2070_010_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436359,
          "spk": "茶梅 (サザンカ)",
          "ja": "……約束、だからね？",
          "tc": "……那就約好囉？",
          "sc": "……那就说好喽？"
