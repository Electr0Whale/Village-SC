          "pidx_tc": 456894,
          "spk": "茶梅 (サザンカ)",
          "ja": "変わらないよねこの村も",
          "tc": "這村子真是一點都沒變呢。",
          "sc": "这村子真是一点都没变呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456909,
          "spk": "木助 (キスケ)",
          "ja": "唯一変わったのが、この店だな",
          "tc": "唯一變了的就是這間店了吧。",
          "sc": "唯一变了的就是这间店了吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456916,
