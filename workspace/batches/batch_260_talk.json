      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436487,
          "spk": "茶梅 (サザンカ)",
          "ja": "昨日の約束、",
          "tc": "昨天的約定，",
          "sc": "昨天的约定，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436494,
          "spk": "茶梅 (サザンカ)",
          "ja": "忘れんなよ～？",
          "tc": "你可別忘了喔～！",
          "sc": "你可别忘了哦～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7261,
      "rec_id": "TALK_ID_70_2080_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455600,
          "spk": "六角 (ロッカク)",
          "ja": "おや、<player>さんじゃないですか",
          "tc": "哦，這不是<player>嗎。",
          "sc": "哦，这不是<player>吗。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455607,
          "spk": "六角 (ロッカク)",
          "ja": "今日も元気いっぱいっスねえ",
          "tc": "你今天看起來也很有活力耶。",
          "sc": "你今天看起来也很有精神呐。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455618,
          "spk": "六角 (ロッカク)",
          "ja": "ちゃんとご飯食べてます？",
          "tc": "你有沒有在好好吃飯啊？",
          "sc": "你有没有在好好吃饭啊？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455625,
          "spk": "六角 (ロッカク)",
          "ja": "山ほどがんばった後は、",
          "tc": "人在努力做完事情之後，",
          "sc": "人在努力做完事情之后，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 455632,
          "spk": "六角 (ロッカク)",
          "ja": "お腹が減るってのが人間っスから",
          "tc": "一定都會餓肚子的。",
          "sc": "一定都会饿肚子的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 455643,
          "spk": "六角 (ロッカク)",
          "ja": "よければ、ウチの食堂で食べてきますか？",
          "tc": "你願意的話，要不要來我家餐廳吃飯？",
          "sc": "你愿意的话，要不要来我家餐厅吃饭？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 455650,
          "spk": "六角 (ロッカク)",
          "ja": "ワシから誘ったんだ",
          "tc": "是我約你的，",
          "sc": "是我约你的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 455657,
          "spk": "六角 (ロッカク)",
          "ja": "もちろん、奢りですよ",
          "tc": "當然是我請客了。",
          "sc": "当然是我请客了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 455668,
          "spk": "六角 (ロッカク)",
          "ja": "……あ、奢りではありますが、",
          "tc": "啊，雖然是我請客，",
          "sc": "啊，虽然是我请客，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 455675,
          "spk": "六角 (ロッカク)",
          "ja": "少し手心を加えていただけると助かるっスけど",
          "tc": "但如果你能稍微手下留情就好了。",
          "sc": "但如果你能稍微手下留情就好呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7262,
      "rec_id": "TALK_ID_70_2080_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455693,
          "spk": "六角 (ロッカク)",
          "ja": "そうこなくっちゃ",
          "tc": "這樣才對嘛。",
          "sc": "这样才对嘛。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455700,
          "spk": "六角 (ロッカク)",
          "ja": "それじゃ、ワシも休憩はこれくらいにして",
          "tc": "那我也休息到這邊好了，",
          "sc": "那我也休息到这边好了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455707,
          "spk": "六角 (ロッカク)",
          "ja": "一緒に店に戻るとしますか",
          "tc": "我們就一起回店裡吧。",
          "sc": "我们就一起回店里吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7263,
      "rec_id": "TALK_ID_70_2080_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455731,
          "spk": "六角 (ロッカク)",
          "ja": "おっ、良い食いっぷりっスねえ",
          "tc": "哦，你吃得很香耶。",
          "sc": "哦，你吃得挺香呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455738,
          "spk": "六角 (ロッカク)",
          "ja": "それじゃあ、こいつもサービスっス",
          "tc": "那這道我請你。",
          "sc": "那这道我请你呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7264,
      "rec_id": "TALK_ID_70_2080_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455756,
          "spk": "六角 (ロッカク)",
          "ja": "はい、キクラゲと卵炒めっス",
          "tc": "來，這是「木耳炒蛋」。",
          "sc": "来，这是“木耳炒蛋”呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455763,
          "spk": "六角 (ロッカク)",
          "ja": "村の酒呑みどもの好物なんですが、",
          "tc": "村裡那群愛喝酒的都很喜歡這道菜，",
          "sc": "村里那群爱喝酒的都很喜欢这道菜，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455770,
          "spk": "六角 (ロッカク)",
          "ja": "これが白いご飯によく合うんスよ",
          "tc": "非常下飯喔。",
          "sc": "非常下饭呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7265,
      "rec_id": "TALK_ID_70_2080_001_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455788,
          "spk": "六角 (ロッカク)",
          "ja": "……え？",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455795,
          "spk": "六角 (ロッカク)",
          "ja": "どうして飯をタダで食わすのか、って？",
          "tc": "你問我為什麼要請你？",
          "sc": "你问我为什么要请你？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455806,
          "spk": "六角 (ロッカク)",
          "ja": "よくぞ聞いてくれました",
          "tc": "真是個好問題，",
          "sc": "真是个好问题，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 455813,
          "spk": "六角 (ロッカク)",
          "ja": "そこには聞くも涙、語るも涙の物語が――",
          "tc": "說到這背後的原因啊，聽者、說者皆聲淚俱下──",
          "sc": "说到这背后的原因啊，听者、说者皆声泪俱下——"
        },
        {
          "f_idx": 5,
          "pidx_tc": 455831,
          "spk": "六角 (ロッカク)",
          "ja": "なんてね",
          "tc": "開玩笑的啦。",
          "sc": "开玩笑的啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 455838,
          "spk": "六角 (ロッカク)",
          "ja": "実は、特に理由はないんスよ",
          "tc": "其實也沒什麼特別的理由，",
          "sc": "其实也没什么特别的理由，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 455845,
          "spk": "六角 (ロッカク)",
          "ja": "ただ、そうっスね……",
          "tc": "只是，怎麼說呢……",
          "sc": "只是，怎么说呢……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 455856,
          "spk": "六角 (ロッカク)",
          "ja": "子どもが腹ぁ減らしてる姿を見るのが、",
          "tc": "就是我不忍心看到",
          "sc": "就是我不忍心看到"
        },
        {
          "f_idx": 9,
          "pidx_tc": 455863,
          "spk": "六角 (ロッカク)",
          "ja": "どうにも耐えられなくってねえ",
          "tc": "小孩子餓肚子的模樣。",
          "sc": "小孩子饿肚子的模样。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 455874,
          "spk": "六角 (ロッカク)",
          "ja": "要は、自己満足っス",
          "tc": "簡單來說就只是在自我滿足而已。",
          "sc": "简单来说就只是在自我满足而已呐。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 455881,
          "spk": "六角 (ロッカク)",
          "ja": "こうして若い子に飯を奢ることで、",
          "tc": "只要像這樣招待年輕人吃飯，",
          "sc": "只要像这样招待年轻人吃饭，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 455888,
          "spk": "六角 (ロッカク)",
          "ja": "良いことした気になってるんスよ、ワシは",
          "tc": "我就會覺得自己做了善事。",
          "sc": "我就会觉得自己做了善事。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 455899,
          "spk": "六角 (ロッカク)",
          "ja": "なんで、遠慮する必要はないっスよ",
          "tc": "所以你不必客氣，",
          "sc": "所以你不必客气，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 455906,
          "spk": "六角 (ロッカク)",
          "ja": "年寄りの道楽に付き合ってやった、くらいに",
          "tc": "你就當作是在陪老人家吧，",
          "sc": "你就当作是在陪老人家吧，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 455913,
          "spk": "六角 (ロッカク)",
          "ja": "思ってもらえると幸いっス",
          "tc": "這樣我就很開心了。",
          "sc": "这样我就很开心呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7266,
      "rec_id": "TALK_ID_70_2080_001_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455931,
          "spk": "六角 (ロッカク)",
          "ja": "お、ご飯もう一杯おかわりっスか？",
          "tc": "哦，你還想再來一碗嗎？",
          "sc": "哦，你还想再来一碗不？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455938,
          "spk": "六角 (ロッカク)",
          "ja": "いいねえ、どんどん食べてください",
          "tc": "很好啊，多吃點多吃點。",
          "sc": "很好啊，多吃点多吃点。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455945,
          "spk": "六角 (ロッカク)",
          "ja": "やっぱり若い子はたくさん食べないと",
          "tc": "年輕人就是要給他吃得飽飽的才對。",
          "sc": "年轻人就是要给他吃得饱饱的才对。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7267,
      "rec_id": "TALK_ID_70_2080_001_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 455973,
          "spk": "洋 (ヨウ)",
          "ja": "ただいま、おじちゃん",
          "tc": "叔叔，我回來了。",
          "sc": "叔叔，我回来了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 455988,
          "spk": "六角 (ロッカク)",
          "ja": "おかえりなさい、ヨウさん",
          "tc": "妳回來啦，洋妹妹。",
          "sc": "你回来啦，洋妹妹。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 455999,
          "spk": "六角 (ロッカク)",
          "ja": "おや、もしかして",
          "tc": "哎呀，難道說，",
          "sc": "哎呀，难道说，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456006,
          "spk": "六角 (ロッカク)",
          "ja": "トバリさんが送ってくれたんスか？",
          "tc": "帷妹妹是特地送她回來的嗎？",
          "sc": "帷妹妹是特地送她回来的吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456019,
          "spk": "帷 (トバリ)",
          "ja": "……別に",
          "tc": "……沒有，",
          "sc": "……没有，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456026,
          "spk": "帷 (トバリ)",
          "ja": "たまたま、途中で会っただけ",
          "tc": "我只是剛好在半路遇到她而已。",
          "sc": "我只是刚好在半路遇到她而已。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456039,
          "spk": "六角 (ロッカク)",
          "ja": "せっかくだ",
          "tc": "難得都來了，",
          "sc": "难得都来了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456046,
          "spk": "六角 (ロッカク)",
          "ja": "トバリさんも、食べてきます？",
          "tc": "帷妹妹要不要進來吃頓飯再走？",
          "sc": "帷妹妹要不要进来吃顿饭再走？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 456053,
          "spk": "六角 (ロッカク)",
          "ja": "今ならなんと、ワシの奢りっスよ",
          "tc": "趁現在，我請客。",
          "sc": "趁现在，我请客哟。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 456064,
          "spk": "六角 (ロッカク)",
          "ja": "ご飯も炊きたてホカホカで、",
          "tc": "而且白飯也才剛煮好，熱騰騰的，",
          "sc": "而且白饭也才刚煮好，热腾腾的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 456071,
          "spk": "六角 (ロッカク)",
          "ja": "三杯までならなにも言わずについてくるっス",
          "tc": "只要不吃超過三碗，我都不會阻止妳的。",
          "sc": "只要不吃超过三碗，我都不会阻止你呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7268,
      "rec_id": "TALK_ID_70_2080_001_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456096,
          "spk": "帷 (トバリ)",
          "ja": "……いらない",
          "tc": "……不用了，",
          "sc": "……不用了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456103,
          "spk": "帷 (トバリ)",
          "ja": "オッサンの誘いに乗ると、",
          "tc": "要是答應了，",
          "sc": "要是答应了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456110,
          "spk": "帷 (トバリ)",
          "ja": "目いっぱい食べるまで帰してくれないから",
          "tc": "你一定會讓我吃到撐才肯放我走的。",
          "sc": "你一定会让我吃到撑才肯放我走的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456123,
          "spk": "六角 (ロッカク)",
          "ja": "……えっ",
          "tc": "……咦？",
          "sc": "……咦？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456136,
          "spk": "帷 (トバリ)",
          "ja": "別にお腹減ってないし",
          "tc": "我又不餓，",
          "sc": "我又不饿，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456143,
          "spk": "帷 (トバリ)",
          "ja": "家にご飯もあるし",
          "tc": "家裡也有煮飯，",
          "sc": "家里也有煮饭，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456150,
          "spk": "帷 (トバリ)",
          "ja": "中途半端な時間に食べると太るし",
          "tc": "在這種不上不下的時間吃東西還會胖。",
          "sc": "在这种不上不下的时间吃东西还会胖。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7269,
      "rec_id": "TALK_ID_70_2080_001_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456182,
          "spk": "六角 (ロッカク)",
          "ja": "……最近の若い子は、そうなんスか？",
          "tc": "……最近的年輕人都是這樣的嗎？",
          "sc": "……最近的年轻人都是这样的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456189,
          "spk": "六角 (ロッカク)",
          "ja": "ちょっと真面目にショックなんスけど",
          "tc": "我真心感到有點震驚耶。",
          "sc": "我真心感到有点震惊呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456202,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、",
          "tc": "叔叔，",
          "sc": "叔叔，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456209,
          "spk": "洋 (ヨウ)",
          "ja": "わたしは食べるよ？",
          "tc": "我要吃喔。",
          "sc": "我要吃哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7270,
      "rec_id": "TALK_ID_70_2080_001_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456229,
          "spk": "六角 (ロッカク)",
          "ja": "ああ、はいはい",
          "tc": "喔，好好好。",
          "sc": "喔，好好好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456236,
          "spk": "六角 (ロッカク)",
          "ja": "今、美味しいご飯を用意しますからね",
          "tc": "我這就來準備好吃的飯菜。",
          "sc": "我这就来准备好吃的饭菜。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7271,
      "rec_id": "TALK_ID_70_2080_001_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456254,
          "spk": "六角 (ロッカク)",
          "ja": "その、なんと言いますか……",
          "tc": "該怎麼說呢……",
          "sc": "该怎么说呢……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456261,
          "spk": "六角 (ロッカク)",
          "ja": "つい、若い子になにかしてあげたくなって、",
          "tc": "我總是想為年輕人做些什麼，",
          "sc": "我总是想为年轻人做些什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456268,
          "spk": "六角 (ロッカク)",
          "ja": "こっちの価値観を押し付けちまうスよね",
          "tc": "卻把我的價值觀強加在他們身上。",
          "sc": "却把我的价值观强加在他们身上。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456279,
          "spk": "六角 (ロッカク)",
          "ja": "しかもオッサン呼ばわり……",
          "tc": "還被叫做大叔……",
          "sc": "还被叫做大叔……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456286,
          "spk": "六角 (ロッカク)",
          "ja": "……まあ、年齢的には間違いないんスが",
          "tc": "……雖然說我的年齡的確是大叔啦。",
          "sc": "……虽然说我的年龄的确是大叔啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456304,
          "spk": "六角 (ロッカク)",
          "ja": "でも、やっぱり心配なので、めげないっス",
          "tc": "但我果然還是會擔心，所以不會氣餒的。",
          "sc": "但我果然还是会担心，所以不会气馁呐。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456311,
          "spk": "六角 (ロッカク)",
          "ja": "若い子用に、スイーツの勉強でもしときますか",
          "tc": "為了年輕人，我看我還是來學做些甜點吧。",
          "sc": "为了年轻人，我看我还是来学做些甜点吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 456331,
          "spk": "洋 (ヨウ)",
          "ja": "……今、トバリさんが断ったの",
          "tc": "……我覺得帷姐姐應該不是因為這個",
          "sc": "……我觉得帷姐姐应该不是因为这个"
        },
        {
          "f_idx": 10,
          "pidx_tc": 456338,
          "spk": "洋 (ヨウ)",
          "ja": "そういう理由じゃないと思うよ？",
          "tc": "才拒絕你的。",
          "sc": "才拒绝你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7272,
      "rec_id": "TALK_ID_70_2080_001_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456356,
          "spk": "六角 (ロッカク)",
          "ja": "あ、ハイ……",
          "tc": "啊，好……",
          "sc": "啊，好……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456363,
          "spk": "六角 (ロッカク)",
          "ja": "今度からは、おかわりの強要はやめときます……",
          "tc": "我以後不會再強迫她要再多來幾碗了……",
          "sc": "我以后不会再强迫她要再多来几碗了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7273,
      "rec_id": "TALK_ID_70_2080_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456391,
          "spk": "茶梅 (サザンカ)",
          "ja": "あはは",
          "tc": "啊哈哈，",
          "sc": "啊哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456398,
          "spk": "茶梅 (サザンカ)",
          "ja": "キスケさんてば、それ本気で言ってる？",
          "tc": "木助啊，你是說真的嗎？",
          "sc": "木助啊，你是说真的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456411,
          "spk": "木助 (キスケ)",
          "ja": "あたりめえだ",
          "tc": "那當然啦。",
          "sc": "那当然啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456418,
          "spk": "木助 (キスケ)",
          "ja": "夏は団扇、冬は酒がありゃ俺には十分",
          "tc": "我家才沒有空調這種高級的東西，",
          "sc": "我家才没有空调这种高级的东西，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456425,
          "spk": "木助 (キスケ)",
          "ja": "エアコンなんて上等なモン、置いてねえよ",
          "tc": "我只要夏天有扇子、冬天有酒就夠了。",
          "sc": "我只要夏天有扇子、冬天有酒就够了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456438,
          "spk": "茶梅 (サザンカ)",
          "ja": "今のご時世、",
          "tc": "照現在這種氣候來看，",
          "sc": "照现在这种气候来看，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456445,
          "spk": "茶梅 (サザンカ)",
          "ja": "それじゃ煮えるか凍るかしそうだけどね～",
          "tc": "你這樣不是會被煮熟就是會被凍死吧。",
          "sc": "你这样不是会被煮熟就是会被冻死吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456458,
          "spk": "木助 (キスケ)",
          "ja": "そこは根性で乗り越えるんだよ",
          "tc": "這種時候就要靠毅力撐過去了。",
          "sc": "这种时候就要靠毅力撑过去了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7274,
      "rec_id": "TALK_ID_70_2080_002_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456491,
          "spk": "六角 (ロッカク)",
          "ja": "そんなこと言って……",
          "tc": "話是這樣講啦……",
          "sc": "话是这样讲啦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456498,
          "spk": "六角 (ロッカク)",
          "ja": "どうせ暑いか寒いで耐えられなくなったら、",
          "tc": "但是只要天氣太熱或太冷，你覺得受不了了，",
          "sc": "但是只要天气太热或太冷，你觉得受不了了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456505,
          "spk": "六角 (ロッカク)",
          "ja": "ウチの店に転がり込むじゃないっスか",
          "tc": "你不是就會跑來我的店裡嗎？",
          "sc": "你不是就会跑来我的店里不？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456520,
          "spk": "木助 (キスケ)",
          "ja": "……そんなこと、あったか？",
          "tc": "……我有嗎？",
          "sc": "……我有吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456533,
          "spk": "六角 (ロッカク)",
          "ja": "ありましたって",
          "tc": "有啦，",
          "sc": "有啦，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456540,
          "spk": "六角 (ロッカク)",
          "ja": "そのままテーブルで寝られて、",
          "tc": "你有次還直接睡在了我們餐廳桌子上，",
          "sc": "你有次还直接睡在了我们餐厅桌子上，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456547,
          "spk": "六角 (ロッカク)",
          "ja": "どかすのに苦労したんスから",
          "tc": "我費盡了好大的力氣才把你移走呢。",
          "sc": "我费尽了好大的力气才把你移走呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7275,
      "rec_id": "TALK_ID_70_2080_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456577,
          "spk": "六角 (ロッカク)",
          "ja": "おや、いらっしゃい<player>さん",
          "tc": "哎呀，歡迎光臨啊，<player>。",
          "sc": "哎呀，欢迎光临啊，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456584,
          "spk": "六角 (ロッカク)",
          "ja": "すみませんね、酔客どもがうるさくて",
          "tc": "不好意思啊，這些酒鬼吵吵鬧鬧的。",
          "sc": "不好意思啊，这些酒鬼吵吵闹闹的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456604,
          "spk": "茶梅 (サザンカ)",
          "ja": "はぁ？　それ、ひどくない",
          "tc": "啊？那樣講會不會太過分？",
          "sc": "啊？那样讲会不会太过分？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456611,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシらもちゃんとしたお客なんだけど？",
          "tc": "你也要把我們當作客人來招待才對吧？",
          "sc": "你也要把我们当作客人来招待才对吧？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456631,
          "spk": "木助 (キスケ)",
          "ja": "おう、<player>",
          "tc": "哦，是<player>啊。",
          "sc": "哦，是<player>啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 456638,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもここのマズい飯食いに来たのか？",
          "tc": "你也來這裡吃飯喔？這裡很難吃耶。",
          "sc": "你也来这里吃饭啊？这里很难吃呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7276,
      "rec_id": "TALK_ID_70_2080_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456658,
          "spk": "六角 (ロッカク)",
          "ja": "マズいってのは余計じゃないっスかねえ",
          "tc": "「難吃」是多餘的吧？",
          "sc": "“难吃”是多余的吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456665,
          "spk": "六角 (ロッカク)",
          "ja": "これでも腕を上げたつもりなんスけど",
          "tc": "我的手藝好歹也有進步了，",
          "sc": "我的手艺好歹也有进步了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456672,
          "spk": "六角 (ロッカク)",
          "ja": "村随一の味と、リンさんにだけは評判っス",
          "tc": "至少村長有肯定我，說我家是全村第一好吃的店。",
          "sc": "至少村长有肯定我，说我家是全村第一好吃的店呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7277,
      "rec_id": "TALK_ID_70_2080_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456690,
          "spk": "木助 (キスケ)",
          "ja": "はぁ……これでねぇ？",
          "tc": "哎……我跟你說啊，",
          "sc": "哎……我跟你说啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 456697,
          "spk": "木助 (キスケ)",
          "ja": "リンはバカ舌なんだろうよ",
          "tc": "林她根本分不出味道好壞。",
          "sc": "林她根本分不出味道好坏。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 456710,
          "spk": "六角 (ロッカク)",
          "ja": "バカ舌はあなたらでしょうよ……",
          "tc": "你們才分不清楚味道好壞吧……",
          "sc": "你们才分不清楚味道好坏吧……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 456717,
          "spk": "六角 (ロッカク)",
          "ja": "たらふく呑んで、",
          "tc": "那樣狂喝猛喝，",
          "sc": "那样狂喝猛喝，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 456724,
          "spk": "六角 (ロッカク)",
          "ja": "辛い味しかわかんなくなってるっス",
          "tc": "只品得出酒的辛辣味吧。",
          "sc": "只品得出酒的辛辣味呐。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 456735,
          "spk": "六角 (ロッカク)",
          "ja": "まったく、いつもワシが手塩にかけた料理を",
          "tc": "真是的，總是用廉價酒",
          "sc": "真是的，总是用廉价酒"
        },
        {
          "f_idx": 6,
          "pidx_tc": 456742,
          "spk": "六角 (ロッカク)",
          "ja": "安酒で流し込みやがって……",
          "tc": "把我用心做的料理吞進肚子裡……",
          "sc": "把我用心做的料理吞进肚子里……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 456762,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが継ぐ前はこの倍くらい美味かったぞ",
          "tc": "在你接手前，這裡的料理比現在美味好幾倍啊。",
          "sc": "在你接手前，这里的料理比现在美味好几倍啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 456769,
          "spk": "木助 (キスケ)",
          "ja": "十年前の店主の味に近づけるように、",
          "tc": "你可以要好好加油，",
          "sc": "你可以要好好加油，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 456776,
          "spk": "木助 (キスケ)",
          "ja": "精進することだな",
          "tc": "讓味道更接近十年前的老闆。",
          "sc": "让味道更接近十年前的老板。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 456789,
          "spk": "茶梅 (サザンカ)",
          "ja": "まぁオッサンも、",
          "tc": "不過，",
          "sc": "不过，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 456796,
          "spk": "茶梅 (サザンカ)",
          "ja": "始めた頃よりはいい感じだと思うよ",
          "tc": "大叔你現在也比剛開始好多了。",
          "sc": "大叔你现在也比刚开始好多了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 456803,
          "spk": "茶梅 (サザンカ)",
          "ja": "十年間で成長してるんだって",
          "tc": "這十年來也是有在進步的呢。",
          "sc": "这十年来也是有在进步的呢。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 456816,
          "spk": "木助 (キスケ)",
          "ja": "しかし、ロッカクが来て十年経ったのか……",
          "tc": "不過從六角來這裡也過十年了啊……",
          "sc": "不过从六角来这里也过十年了啊……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 456823,
          "spk": "木助 (キスケ)",
          "ja": "長いようで短かったぜ……",
          "tc": "好像過了很久卻又覺得很短暫……",
          "sc": "好像过了很久却又觉得很短暂……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7278,
      "rec_id": "TALK_ID_70_2080_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 456862,
          "spk": "茶梅 (サザンカ)",
          "ja": "ああ、<player>が来たのは最近だもんね",
          "tc": "對喔，<player>是最近才來我們村子裡的吧？",
