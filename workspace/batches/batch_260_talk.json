      "rec_id": "TALK_ID_70_2070_010_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436379,
          "spk": "茶梅 (サザンカ)",
          "ja": "う～ん、久々によく眠れたかも",
          "tc": "嗯～感覺好久沒睡這麼飽了。",
          "sc": "嗯～感觉好久没睡这么饱了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436386,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタはどうだった？",
          "tc": "你呢？",
          "sc": "你呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7258,
      "rec_id": "TALK_ID_70_2070_010_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436411,
          "spk": "茶梅 (サザンカ)",
          "ja": "ぐっすり？",
          "tc": "睡得很熟嗎？",
          "sc": "睡得很熟吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436418,
          "spk": "茶梅 (サザンカ)",
          "ja": "そっか、よかった",
          "tc": "這樣啊，太好了。",
          "sc": "这样啊，太好了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436429,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、アタシはこれから店に出ないと",
          "tc": "那我接下來",
          "sc": "那我接下来"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436436,
          "spk": "茶梅 (サザンカ)",
          "ja": "いけないから……",
          "tc": "得去店裡才行……",
          "sc": "得去店里才行……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 436445,
          "spk": "茶梅 (サザンカ)",
          "ja": "ここで解散ってことで",
          "tc": "我們就在這裡解散吧。",
          "sc": "我们就在这里解散吧。"
        }
      ]
    },
    {
