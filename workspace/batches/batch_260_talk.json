    {
      "file": "talk.dat",
      "rec_idx": 7253,
      "rec_id": "TALK_ID_70_2070_010_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436180,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねえ、起きてる？",
          "tc": "我說，你還醒著嗎？",
          "sc": "我说，你还醒着吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436189,
          "spk": "茶梅 (サザンカ)",
          "ja": "まあ、起きてても寝ててもいいんだけど……",
          "tc": "雖然不管醒著還是睡著都無所謂……",
          "sc": "虽然不管醒着还是睡着都无所谓……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436196,
          "spk": "茶梅 (サザンカ)",
          "ja": "いい機会だから伝えておくね",
          "tc": "趁這個機會我有話想跟你說。",
          "sc": "趁这个机会我有话想跟你说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7254,
      "rec_id": "TALK_ID_70_2070_010_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436219,
          "spk": "茶梅 (サザンカ)",
          "ja": "えーと……アタシはアンタに会えて",
          "tc": "那個……我真的很慶幸，",
          "sc": "那个……我真的很庆幸，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436226,
          "spk": "茶梅 (サザンカ)",
          "ja": "よかったと思ってるんだ",
          "tc": "能夠遇見你。",
          "sc": "能够遇见你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436235,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタは埋蔵金や発明品のことをバカにせず、",
          "tc": "你沒有把地下寶藏或發明道具的事當成笑話，",
          "sc": "你没有把地下宝藏或发明道具的事当成笑话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436242,
          "spk": "茶梅 (サザンカ)",
          "ja": "一緒に色々やってくれたからね",
          "tc": "還陪我一起做了很多嘗試。",
          "sc": "还陪我一起做了很多尝试。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 436258,
          "spk": "茶梅 (サザンカ)",
          "ja": "だから、アンタが来てからは",
          "tc": "所以自從你來了之後，",
          "sc": "所以自从你来了之后，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 436265,
          "spk": "茶梅 (サザンカ)",
          "ja": "前よりずっと埋蔵金探しや発明への",
          "tc": "我變得比之前更有動力",
          "sc": "我变得比之前更有动力"
        },
        {
          "f_idx": 7,
          "pidx_tc": 436272,
          "spk": "茶梅 (サザンカ)",
          "ja": "モチベーションが上がってさ……",
          "tc": "尋找地下寶藏和發明新東西了……",
          "sc": "寻找地下宝藏和发明新东西了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 436281,
          "spk": "茶梅 (サザンカ)",
          "ja": "退屈さとか、寂しさとか……",
          "tc": "無聊也好，寂寞也好……",
          "sc": "无聊也好，寂寞也好……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 436288,
          "spk": "茶梅 (サザンカ)",
          "ja": "そういうの、薄まった感じがするんだよね",
          "tc": "那些感覺好像都漸漸消散了。",
          "sc": "那些感觉好像都渐渐消散了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 436297,
          "spk": "茶梅 (サザンカ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7255,
      "rec_id": "TALK_ID_70_2070_010_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436313,
          "spk": "茶梅 (サザンカ)",
          "ja": "ねえ、アンタがよかったらだけど……",
          "tc": "欸，要是你願意的話……",
          "sc": "诶，要是你愿意的话……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436320,
          "spk": "茶梅 (サザンカ)",
          "ja": "これからもアタシと一緒に色んな発明品で",
          "tc": "以後也和我一起用各種新發明",
          "sc": "以后也和我一起用各种新发明"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436327,
          "spk": "茶梅 (サザンカ)",
          "ja": "実験とか遊んだりしようよ",
          "tc": "做實驗或是玩遊戲吧。",
          "sc": "做实验或是玩游戏吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436336,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタの気が向いたらで、いいからさ",
          "tc": "只要在你有興趣的時候就行了。",
          "sc": "只要在你有兴趣的时候就行了。"
        }
      ]
    },
    {
      "file": "talk.dat",
