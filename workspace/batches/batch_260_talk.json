      "rec_id": "TALK_ID_70_2070_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 435995,
          "spk": "茶梅 (サザンカ)",
          "ja": "オッケー",
          "tc": "OK～",
          "sc": "OK～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436002,
          "spk": "茶梅 (サザンカ)",
          "ja": "じゃあ、さっそく準備するね",
          "tc": "那我馬上來準備。",
          "sc": "那我马上来准备。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436013,
          "spk": "茶梅 (サザンカ)",
          "ja": "けど、アンタも度胸あるじゃん",
          "tc": "不過你也很有膽量耶。",
          "sc": "不过你也很有胆量呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436020,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシ、結構自信あるジャンルだよ？",
          "tc": "這種類型我可是挺拿手的喔！",
          "sc": "这种类型我可是挺拿手的哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7249,
      "rec_id": "TALK_ID_70_2070_010_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436045,
          "spk": "茶梅 (サザンカ)",
          "ja": "って、操作方法から教えて欲しいの？",
          "tc": "咦，要我從操作方法開始教？",
          "sc": "咦，要我从操作方法开始教？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436052,
          "spk": "茶梅 (サザンカ)",
          "ja": "マジか……それでアタシに挑もうとしてたの？",
          "tc": "真的假的……這樣你也想挑戰我啊？",
          "sc": "真的假的……这样你也想挑战我啊？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436063,
          "spk": "茶梅 (サザンカ)",
          "ja": "も～、しょうがないな～",
          "tc": "真是的～拿你沒辦法～",
          "sc": "真是的～拿你没办法～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7250,
      "rec_id": "TALK_ID_70_2070_010_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436087,
          "spk": "茶梅 (サザンカ)",
          "ja": "あー、楽しかったぁ",
          "tc": "啊～今天真開心。",
          "sc": "啊～今天真开心。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436094,
          "spk": "茶梅 (サザンカ)",
          "ja": "ひっさしぶりに、ゲームで夜更かししちゃったよ",
          "tc": "好久沒有通宵打遊戲了。",
          "sc": "好久没有通宵打游戏了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436105,
          "spk": "茶梅 (サザンカ)",
          "ja": "ガキのアンタはもう眠いでしょ",
          "tc": "還是小孩的你應該很想睡吧。",
          "sc": "还是小孩的你应该很想睡吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 436112,
          "spk": "茶梅 (サザンカ)",
          "ja": "それじゃ、そろそろお開きにして寝よっか",
          "tc": "那就收拾收拾睡覺吧。",
          "sc": "那就收拾收拾睡觉吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7251,
      "rec_id": "TALK_ID_70_2070_010_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 436130,
          "spk": "茶梅 (サザンカ)",
          "ja": "寝床はアタシのベッドでいいよね？",
          "tc": "就睡我床上吧？",
          "sc": "就睡我床上吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 436137,
          "spk": "茶梅 (サザンカ)",
          "ja": "ちょい狭いかもだけど、",
          "tc": "雖然床不大，",
          "sc": "虽然床不大，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 436144,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタはちっちゃいから詰めれば大丈夫っしょ",
          "tc": "但你小小一個，擠一擠應該可以吧。",
          "sc": "但你小小一个，挤一挤应该可以吧。"
        }
      ]
    },
