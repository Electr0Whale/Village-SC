        {
          "f_idx": 18,
          "pidx_tc": 457028,
          "spk": "木助 (キスケ)",
          "ja": "あん？　誰に口きいてんだ？",
          "tc": "嗯？你在跟誰說話？",
          "sc": "嗯？你在跟谁说话？"
        },
        {
          "f_idx": 19,
          "pidx_tc": 457035,
          "spk": "木助 (キスケ)",
          "ja": "俺の酒代で、てめぇの微妙な飯屋が",
          "tc": "是我的酒錢，才讓你這家不怎麼樣的餐廳",
