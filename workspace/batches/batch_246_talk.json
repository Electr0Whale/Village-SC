    {
      "file": "talk.dat",
      "rec_idx": 6849,
      "rec_id": "TALK_ID_70_2030_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408316,
          "spk": "木助 (キスケ)",
          "ja": "……ん？",
          "tc": "……嗯？",
          "sc": "……嗯？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408334,
          "spk": "木助 (キスケ)",
          "ja": "あ～……なんだ、てめぇか",
          "tc": "啊……原來是你啊。",
          "sc": "啊……原来是你啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408341,
          "spk": "木助 (キスケ)",
          "ja": "もしかして話しかけてたか？",
          "tc": "你剛才有跟我說話嗎？",
          "sc": "你刚才有跟我说话吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408348,
          "spk": "木助 (キスケ)",
          "ja": "気づかなくて悪かったな",
          "tc": "抱歉，我沒注意到。",
          "sc": "抱歉，我没注意到。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408359,
          "spk": "木助 (キスケ)",
          "ja": "今日はどうも調子が悪くて",
          "tc": "總覺得今天狀態不太好，",
          "sc": "总觉得今天状态不太好，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408366,
          "spk": "木助 (キスケ)",
          "ja": "いけねぇな……",
          "tc": "這可不行啊……",
          "sc": "这可不行啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6850,
      "rec_id": "TALK_ID_70_2030_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408384,
          "spk": "木助 (キスケ)",
          "ja": "ああ、心配すんな",
          "tc": "沒事，不必擔心。",
          "sc": "没事，不必担心。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408391,
          "spk": "木助 (キスケ)",
          "ja": "体はピンピンしてるぜ",
          "tc": "我身體好得很呢。",
          "sc": "我身体好得很呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408402,
          "spk": "木助 (キスケ)",
          "ja": "ただ、夢見が悪くてな",
          "tc": "只是因為做了惡夢，",
          "sc": "只是因为做了恶梦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408409,
          "spk": "木助 (キスケ)",
          "ja": "今イチ気分がシャキッとしねぇ",
          "tc": "感覺整個人提不起勁。",
          "sc": "感觉整个人提不起劲。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408420,
          "spk": "木助 (キスケ)",
          "ja": "こういう時は酒でも呑もうかと",
          "tc": "本來想說這種時候",
          "sc": "本来想说这种时候"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408427,
          "spk": "木助 (キスケ)",
          "ja": "思ったんだけどな",
          "tc": "就該喝點酒的，",
          "sc": "就该喝点酒的，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408434,
          "spk": "木助 (キスケ)",
          "ja": "悪酔いしそうでやめたよ",
          "tc": "但好像會醉得很難受就算了。",
          "sc": "但好像会醉得很难受就算了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 408445,
          "spk": "木助 (キスケ)",
          "ja": "そんで、仕方ねぇから",
          "tc": "因為沒別的辦法，",
          "sc": "因为没别的办法，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 408452,
          "spk": "木助 (キスケ)",
          "ja": "ここでぼけっとしてたわけだ",
          "tc": "我只好在這裡發呆了。",
          "sc": "我只好在这里发呆了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6851,
      "rec_id": "TALK_ID_70_2030_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408470,
          "spk": "木助 (キスケ)",
          "ja": "……どんな夢を見たか",
          "tc": "……你很好奇",
          "sc": "……你很好奇"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408477,
          "spk": "木助 (キスケ)",
          "ja": "気になるか？",
          "tc": "我夢到什麼嗎？",
          "sc": "我梦到什么吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408488,
          "spk": "木助 (キスケ)",
          "ja": "そりゃそうだな",
          "tc": "這麼說也是。",
          "sc": "这么说也是。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408495,
          "spk": "木助 (キスケ)",
          "ja": "こんな話を聞かされちゃあな",
          "tc": "畢竟都跟你講這麼多了。",
          "sc": "毕竟都跟你讲这么多了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408506,
          "spk": "木助 (キスケ)",
          "ja": "……ま、昔の家の夢だ",
          "tc": "……這個嘛，只是夢到以前的家，",
          "sc": "……这个嘛，只是梦到以前的家，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408513,
          "spk": "木助 (キスケ)",
          "ja": "聞いても面白くねぇよ",
          "tc": "聽了也不會覺得有趣啦。",
          "sc": "听了也不会觉得有趣啦。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408524,
          "spk": "木助 (キスケ)",
          "ja": "それより、お前が見た夢の",
          "tc": "比起這個，",
          "sc": "比起这个，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 408531,
          "spk": "木助 (キスケ)",
          "ja": "話でも聞かせてくれよ",
          "tc": "告訴我你做了什麼夢吧。",
          "sc": "告诉我你做了什么梦吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 408538,
          "spk": "木助 (キスケ)",
          "ja": "気が紛れるかもしんねぇだろ",
          "tc": "搞不好能轉換一下心情啊。",
          "sc": "说不定能转换一下心情啊。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 408549,
          "spk": "木助 (キスケ)",
          "ja": "<player>が最近見たもんだと",
          "tc": "<player>最近有夢到什麼",
          "sc": "<player>最近有梦到什么"
        },
        {
          "f_idx": 10,
          "pidx_tc": 408556,
          "spk": "木助 (キスケ)",
          "ja": "どんな夢が印象に残ってんだ？",
          "tc": "令你印象深刻的夢嗎？",
          "sc": "令你印象深刻的梦吗？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 408572,
          "spk": "主角心声/旁白/选项",
          "ja": "楽しい夢",
          "tc": "開心的夢",
          "sc": "开心的梦"
        },
        {
          "f_idx": 13,
          "pidx_tc": 408579,
          "spk": "主角心声/旁白/选项",
          "ja": "怖い夢",
          "tc": "可怕的夢",
          "sc": "可怕的梦"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6852,
      "rec_id": "TALK_ID_70_2030_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408672,
          "spk": "木助 (キスケ)",
          "ja": "……楽しいもんだけ",
          "tc": "……要是可以只記得開心的事，",
          "sc": "……要是可以只记得开心的事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408679,
          "spk": "木助 (キスケ)",
          "ja": "覚えてられりゃいいのにな",
          "tc": "那該多好。",
          "sc": "那该多好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6853,
      "rec_id": "TALK_ID_70_2030_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408697,
          "spk": "木助 (キスケ)",
          "ja": "話し相手になってもらって助かったぜ",
          "tc": "多虧有你陪我聊天，",
          "sc": "多亏有你陪我聊天，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408704,
          "spk": "木助 (キスケ)",
          "ja": "おかげで、多少は気力が湧いてきた",
          "tc": "總算感覺比較有精神了。",
          "sc": "总算感觉比较有精神了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408715,
          "spk": "木助 (キスケ)",
          "ja": "……久しぶりに見た夢が、",
          "tc": "……難得做了夢",
          "sc": "……难得做了梦"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408722,
          "spk": "木助 (キスケ)",
          "ja": "昔の記憶そのまんまでな",
          "tc": "卻和過去的記憶沒兩樣，",
          "sc": "却和过去的记忆没两样，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408729,
          "spk": "木助 (キスケ)",
          "ja": "嫌に現実味があったんだよ……",
          "tc": "真實得讓人不舒服……",
          "sc": "真实得让人不舒服……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408740,
          "spk": "木助 (キスケ)",
          "ja": "けど、<player>と話してたら",
          "tc": "不過和<player>聊過之後，",
          "sc": "不过和<player>聊过之后，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408747,
          "spk": "木助 (キスケ)",
          "ja": "過去より今を見てりゃいいって気になった",
          "tc": "就覺得比起過去，不如把握當下。",
          "sc": "就觉得比起过去，不如把握当下。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 408765,
          "spk": "木助 (キスケ)",
          "ja": "……<player>は",
          "tc": "……我說<player>，",
          "sc": "……我说<player>，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 408772,
          "spk": "木助 (キスケ)",
          "ja": "自分以外の何かに",
          "tc": "你可別被自己以外的事物",
          "sc": "你可别被自己以外的事物"
        },
        {
          "f_idx": 10,
          "pidx_tc": 408779,
          "spk": "木助 (キスケ)",
          "ja": "振り回されんじゃねえぞ",
          "tc": "耍得團團轉喔！",
          "sc": "耍得团团转啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6854,
      "rec_id": "TALK_ID_70_2030_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408797,
          "spk": "木助 (キスケ)",
          "ja": "要は、てめぇの人生を",
          "tc": "簡單說，就是要好好珍惜",
          "sc": "简单说，就是要好好珍惜"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408804,
          "spk": "木助 (キスケ)",
          "ja": "大事にしろってこった",
          "tc": "你自己的人生啦。",
          "sc": "你自己的人生啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6855,
      "rec_id": "TALK_ID_70_2030_005_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408822,
          "spk": "木助 (キスケ)",
          "ja": "そろそろ腹が減ったな",
          "tc": "感覺肚子有點餓了，",
          "sc": "感觉肚子有点饿了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408829,
          "spk": "木助 (キスケ)",
          "ja": "俺は誰かに飯をたかりに行くぜ",
          "tc": "我要去找別人蹭飯吃了。",
          "sc": "我要去找别人蹭饭吃了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408840,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな",
          "tc": "先走啦。",
          "sc": "先走啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6856,
      "rec_id": "TALK_ID_70_2030_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408864,
          "spk": "木助 (キスケ)",
          "ja": "おう、<player>",
          "tc": "哦，<player>，",
          "sc": "哦，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408871,
          "spk": "木助 (キスケ)",
          "ja": "まだ起きてたのか",
          "tc": "你還醒著嗎？",
          "sc": "你还醒着吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6857,
      "rec_id": "TALK_ID_70_2030_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408889,
          "spk": "木助 (キスケ)",
          "ja": "てめぇなァ……こんな時間までなにしてんだ",
          "tc": "你這傢伙……在做什麼拖到這個時間？",
          "sc": "你这家伙……在做什么拖到这个时间？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408896,
          "spk": "木助 (キスケ)",
          "ja": "あんま夜更かしすんなよ、",
          "tc": "別太常熬夜啦。",
          "sc": "别太常熬夜啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408903,
          "spk": "木助 (キスケ)",
          "ja": "俺みてぇに背が伸びなかったらどうすんだ",
          "tc": "是想要像我一樣長不高嗎？",
          "sc": "是想要像我一样长不高吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6858,
      "rec_id": "TALK_ID_70_2030_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408921,
          "spk": "木助 (キスケ)",
          "ja": "いや……小言を言うのは違うな……",
          "tc": "不……不該這樣說教啊……",
          "sc": "不……不该这样说教啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408928,
          "spk": "木助 (キスケ)",
          "ja": "勝手にてめぇの庭に入って悪かったよ",
          "tc": "隨意跑進你的庭院是我不對。",
          "sc": "随意跑进你的庭院是我不对。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408935,
          "spk": "木助 (キスケ)",
          "ja": "こんな場所に俺がいるから、来てくれたんだよな",
          "tc": "是因為我在這裡，所以你才來了吧。",
          "sc": "是因为我在这里，所以你才来了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6859,
      "rec_id": "TALK_ID_70_2030_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408953,
          "spk": "木助 (キスケ)",
          "ja": "俺は……ちょっと寝付けなくってな……",
          "tc": "我只是……有點睡不著而已……",
          "sc": "我只是……有点睡不着而已……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408960,
          "spk": "木助 (キスケ)",
          "ja": "散歩してたらここに辿り着いちまった……",
          "tc": "想說散散步，就走到這裡來了……",
          "sc": "想说散散步，就走到这里来了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6860,
      "rec_id": "TALK_ID_70_2030_006_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408991,
          "spk": "木助 (キスケ)",
          "ja": "……はぁ",
          "tc": "……唉。",
          "sc": "……唉。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408998,
          "spk": "木助 (キスケ)",
          "ja": "……気持ちよく呑んでたはずなんだがなァ",
          "tc": "……明明應該是喝得很愉快的啊。",
          "sc": "……明明应该是喝得很愉快的啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409005,
          "spk": "木助 (キスケ)",
          "ja": "どうにも、こいつが気になっちまってよ……",
          "tc": "但就是很在意這傢伙……",
          "sc": "但就是很在意这家伙……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6861,
      "rec_id": "TALK_ID_70_2030_006_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409029,
          "spk": "木助 (キスケ)",
          "ja": "……コダマ",
          "tc": "……木珠。",
          "sc": "……木珠。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409040,
          "spk": "木助 (キスケ)",
          "ja": "コダマ、聞こえるか？",
          "tc": "木珠，你聽得見嗎？",
          "sc": "木珠，你听得见吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409047,
          "spk": "木助 (キスケ)",
          "ja": "これで……よかったんだよな……？",
          "tc": "這樣……就可以了吧……？",
          "sc": "这样……就可以了吧……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409054,
          "spk": "木助 (キスケ)",
          "ja": "お前の孤独は、少しは軽くなったか？",
          "tc": "你的孤單有稍微減少一點嗎？",
          "sc": "你的孤单有稍微减少一点吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409065,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは俺の代わりに死んだのに……",
          "tc": "你明明代替我死去……",
          "sc": "你明明代替我死去……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409072,
          "spk": "木助 (キスケ)",
          "ja": "土地神に囚われていたことも気づいていたのに、",
          "tc": "我也明明注意到你被土地神囚禁著，",
          "sc": "我也明明注意到你被土地神囚禁着，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409079,
          "spk": "木助 (キスケ)",
          "ja": "それなのに、俺は何もしてやれなかった",
          "tc": "但是我卻沒能為你做些什麼。",
          "sc": "但是我却没能为你做些什么。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 409088,
          "spk": "木助 (キスケ)",
          "ja": "村のしがらみを言い訳にして、",
          "tc": "以村子的束縛作為藉口，",
          "sc": "以村子的束缚作为借口，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 409095,
          "spk": "木助 (キスケ)",
          "ja": "恨み言ばかり積み重ねて……",
          "tc": "一昧地累積著怨言……",
          "sc": "一昧地累积着怨言……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 409102,
          "spk": "木助 (キスケ)",
          "ja": "結局、俺一人じゃ何もしてやれなかった",
          "tc": "最後，我一個人什麼忙也幫不上。",
          "sc": "最后，我一个人什么忙也帮不上。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6862,
      "rec_id": "TALK_ID_70_2030_006_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409126,
          "spk": "木助 (キスケ)",
          "ja": "今さらだが、ちゃんと謝らせてくれ……",
          "tc": "雖然為時已晚，但讓我好好地道歉……",
          "sc": "虽然为时已晚，但让我好好地道歉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409133,
          "spk": "木助 (キスケ)",
          "ja": "助けてやれなくて、ごめんな……",
          "tc": "沒能救你，真的很抱歉……",
          "sc": "没能救你，真的很抱歉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409142,
          "spk": "木助 (キスケ)",
          "ja": "俺を……兄ちゃんを、許してくれ",
          "tc": "原諒我……原諒我這個做哥哥的。",
          "sc": "原谅我……原谅我这个做哥哥的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6863,
      "rec_id": "TALK_ID_70_2030_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409173,
          "spk": "木助 (キスケ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6864,
      "rec_id": "TALK_ID_70_2030_006_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409197,
          "spk": "木助 (キスケ)",
          "ja": "あー……すまん……",
          "tc": "啊……抱歉……",
          "sc": "啊……抱歉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409204,
          "spk": "木助 (キスケ)",
          "ja": "……湿っぽいところを見せちまったな",
          "tc": "……讓你看到這種沉重的場面。",
          "sc": "……让你看到这种沉重的场面。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6865,
      "rec_id": "TALK_ID_70_2030_006_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409222,
          "spk": "木助 (キスケ)",
          "ja": "俺……思ったより、まだ引きずってるみてぇだ",
          "tc": "我……似乎比我想的還要還放不下呢。",
          "sc": "我……似乎比我想的还要还放不下呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409229,
          "spk": "木助 (キスケ)",
          "ja": "全部終わった後なのに……情けねーー",
          "tc": "明明事情全都結束了……真沒用啊……",
          "sc": "明明事情全都结束了……真没用啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409247,
          "spk": "木助 (キスケ)",
          "ja": "でもよ……てめぇのぼんやりした顔を見たら、",
          "tc": "不過……看到你那張呆呆的臉，",
          "sc": "不过……看到你那张呆呆的脸，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409254,
          "spk": "木助 (キスケ)",
          "ja": "シケた気持ちが少し和らいだぜ",
          "tc": "沉悶的心情也稍微緩和了一點。",
          "sc": "沉闷的心情也稍微缓和了一点。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409272,
          "spk": "木助 (キスケ)",
          "ja": "ありがとうよ、<player>",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 409279,
          "spk": "木助 (キスケ)",
          "ja": "ここに来てくれたのが、てめぇでよかった",
          "tc": "很高興來這裡的人，是你。",
          "sc": "很高兴来这里的人，是你。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 409288,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが、<player>でよかった",
          "tc": "很高興你是<player>。",
          "sc": "很高兴你是<player>。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 409295,
          "spk": "木助 (キスケ)",
          "ja": "優しい心の持ち主で、本当によかったよ",
          "tc": "很高興你是一個溫柔的人。",
          "sc": "很高兴你是一个温柔的人。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 409306,
          "spk": "木助 (キスケ)",
          "ja": "実は俺、ビビってるんだよ……",
          "tc": "其實我一直很害怕……",
          "sc": "其实我一直很害怕……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 409313,
          "spk": "木助 (キスケ)",
          "ja": "今日も本当は、",
          "tc": "實際上，今天",
          "sc": "实际上，今天"
        },
        {
          "f_idx": 12,
          "pidx_tc": 409320,
          "spk": "木助 (キスケ)",
          "ja": "コダマに会いに来たんじゃなくて……",
          "tc": "並不是來看木珠的……",
          "sc": "并不是来看木珠的……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6866,
      "rec_id": "TALK_ID_70_2030_006_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409338,
          "spk": "木助 (キスケ)",
          "ja": "……っておい、<player>",
          "tc": "……喂，<player>。",
          "sc": "……喂，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409345,
          "spk": "木助 (キスケ)",
          "ja": "コダマをよく見てみろよ",
          "tc": "你仔細看看木珠。",
          "sc": "你仔细看看木珠。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6867,
      "rec_id": "TALK_ID_70_2030_006_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409363,
          "spk": "木助 (キスケ)",
          "ja": "……ちょっと成長したんじゃねぇか？",
          "tc": "……是不是稍微長大了一點？",
          "sc": "……是不是稍微长大了一点？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409370,
          "spk": "木助 (キスケ)",
          "ja": "桃栗三年柿八年とは言うが、",
          "tc": "俗話說「桃栗三年柿八年」，",
          "sc": "俗话说“桃栗三年柿八年”，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409377,
          "spk": "木助 (キスケ)",
          "ja": "本当にすくすく育ってんなぁ",
          "tc": "真的長得很快呢～",
          "sc": "真的长得很快呢～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6868,
      "rec_id": "TALK_ID_70_2030_006_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409395,
          "spk": "木助 (キスケ)",
          "ja": "てめぇもコダマも……",
          "tc": "你和木珠……",
          "sc": "你和木珠……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409402,
          "spk": "木助 (キスケ)",
          "ja": "いつか俺よりデカくなんだろうなァ……",
          "tc": "總有一天會變得比我高大……",
          "sc": "总有一天会变得比我高大……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409409,
          "spk": "木助 (キスケ)",
          "ja": "楽しみだなァ……",
          "tc": "真令人期待……",
          "sc": "真令人期待……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409420,
          "spk": "木助 (キスケ)",
          "ja": "なあ……<player>よぉ……",
          "tc": "欸……<player>……",
          "sc": "诶……<player>……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409431,
          "spk": "木助 (キスケ)",
          "ja": "いつか、てめぇが大人になった時……",
          "tc": "等到你成為大人之後……",
          "sc": "等到你成为大人之后……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409438,
          "spk": "木助 (キスケ)",
          "ja": "一緒に酒でも酌み交わそうぜ",
          "tc": "再一起把酒言歡吧。",
          "sc": "再一起把酒言欢吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409445,
          "spk": "木助 (キスケ)",
          "ja": "ここで、コダマと三人で……",
          "tc": "就在這裡，和木珠三個人一起……",
          "sc": "就在这里，和木珠三个人一起……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6869,
      "rec_id": "TALK_ID_70_2030_006_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409469,
          "spk": "木助 (キスケ)",
          "ja": "だから……",
          "tc": "所以……",
          "sc": "所以……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409476,
          "spk": "木助 (キスケ)",
          "ja": "てめぇも急に、消えちまったりするなよ",
          "tc": "你也不要突然消失喔。",
          "sc": "你也不要突然消失啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6870,
      "rec_id": "TALK_ID_70_2030_006_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409494,
          "spk": "木助 (キスケ)",
          "ja": "約束だぜ……？",
          "tc": "約好了喔……！",
          "sc": "约好了啊……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409501,
          "spk": "木助 (キスケ)",
          "ja": "忘れんじゃ……ねぇぞ",
          "tc": "可別……忘了……",
          "sc": "可别……忘了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6871,
      "rec_id": "TALK_ID_70_2030_006_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409519,
          "spk": "木助 (キスケ)",
          "ja": "………約束だ",
          "tc": "……就這麼說定了。",
          "sc": "……就这么说定了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6872,
      "rec_id": "TALK_ID_70_2030_006_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409543,
          "spk": "木助 (キスケ)",
          "ja": "……じゃあ、そろそろ俺は帰るよ",
          "tc": "……那我差不多要回去了。",
          "sc": "……那我差不多要回去了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409550,
          "spk": "木助 (キスケ)",
          "ja": "あばよ、コダマ、また来るぜ",
          "tc": "再見，木珠，我會再來看你。",
          "sc": "再见，木珠，我会再来看你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6873,
      "rec_id": "TALK_ID_70_2030_006_18",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409568,
          "spk": "木助 (キスケ)",
          "ja": "邪魔して悪かったな",
          "tc": "抱歉打擾你了，",
          "sc": "抱歉打扰你了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409575,
          "spk": "木助 (キスケ)",
          "ja": "おやすみ、<player>",
          "tc": "晚安，<player>。",
          "sc": "晚安，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6874,
      "rec_id": "TALK_ID_70_2030_006_20",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409599,
          "spk": "木助 (キスケ)",
          "ja": "それにしても……庭が、見違えるようだな",
          "tc": "不過話說回來……庭院已經完全不一樣了。",
          "sc": "不过话说回来……庭院已经完全不一样了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409606,
          "spk": "木助 (キスケ)",
          "ja": "最初に見たときは、",
          "tc": "一開始看到的時候，",
          "sc": "一开始看到的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409613,
          "spk": "木助 (キスケ)",
          "ja": "こんなに広く感じなかったのに……",
          "tc": "明明不覺得有這麼寬敞……",
          "sc": "明明不觉得有这么宽敞……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409624,
          "spk": "木助 (キスケ)",
          "ja": "最後までよくやったよ",
          "tc": "你努力到最後了。",
          "sc": "你努力到最后了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409631,
          "spk": "木助 (キスケ)",
          "ja": "こんな妙なことばかり起きる土地でさ……",
          "tc": "在這片充滿詭異事件的土地上……",
          "sc": "在这片充满诡异事件的土地上……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409638,
          "spk": "木助 (キスケ)",
          "ja": "放り出してもおかしくないのに……",
          "tc": "這片庭院就算荒廢了也不奇怪……",
          "sc": "这片庭院就算荒废了也不奇怪……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409649,
          "spk": "木助 (キスケ)",
          "ja": "……命までかけて",
          "tc": "……你卻賭上了性命。",
          "sc": "……你却赌上了性命。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 409656,
          "spk": "木助 (キスケ)",
          "ja": "ほんと、お人よしだよな……",
          "tc": "你這個人真是好過頭了……",
          "sc": "你这个人真是好过头了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 409667,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはさ……ここに帰ってきたかったんだろ？",
          "tc": "你……本來是想回到這裡吧？",
          "sc": "你……本来是想回到这里吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 409674,
          "spk": "木助 (キスケ)",
          "ja": "なのに、どうして何も言わないんだ",
          "tc": "但為何什麼都不說呢？",
          "sc": "但为何什么都不说呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6875,
      "rec_id": "TALK_ID_70_2030_006_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409698,
          "spk": "木助 (キスケ)",
          "ja": "なあ……コダマ？",
          "tc": "欸……木珠？",
          "sc": "诶……木珠？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409705,
          "spk": "木助 (キスケ)",
          "ja": "……あいつと、何か約束でもしたからか？",
          "tc": "……是和那傢伙做了什麼約定嗎？",
          "sc": "……是和那家伙做了什么约定吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6876,
      "rec_id": "TALK_ID_70_2030_006_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409729,
          "spk": "木助 (キスケ)",
          "ja": "あいつは……優しかったからな",
          "tc": "畢竟……那傢伙很溫柔。",
          "sc": "毕竟……那家伙很温柔。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409736,
          "spk": "木助 (キスケ)",
          "ja": "ここに残って、庭をここまで変えて……",
          "tc": "留在這裡，把庭院變成現在這樣……",
          "sc": "留在这里，把庭院变成现在这样……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409747,
          "spk": "木助 (キスケ)",
          "ja": "そして、最後は、てめぇに体を返して消えた……",
          "tc": "到最後，把身體還給你，消失了……",
          "sc": "到最后，把身体还给你，消失了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409754,
          "spk": "木助 (キスケ)",
          "ja": "何も言わずに、",
          "tc": "什麼也沒說，",
          "sc": "什么也没说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409761,
          "spk": "木助 (キスケ)",
          "ja": "自分の居た場所をてめぇに渡して……",
          "tc": "就這樣把自己曾經的居所交給你……",
          "sc": "就这样把自己曾经的居所交给你……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409772,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは……この現状を",
          "tc": "你……是怎麼看待",
          "sc": "你……是怎么看待"
        },
        {
          "f_idx": 6,
          "pidx_tc": 409779,
          "spk": "木助 (キスケ)",
          "ja": "どう思っているんだよ……",
          "tc": "如今的狀況……",
          "sc": "如今的状况……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6877,
      "rec_id": "TALK_ID_70_2030_006_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409797,
          "spk": "木助 (キスケ)",
          "ja": "まあいい、答えなくても……",
          "tc": "算了，不回答也可以……",
          "sc": "算了，不回答也可以……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409804,
          "spk": "木助 (キスケ)",
          "ja": "……あいつが選んだ道なら、",
          "tc": "……既然是他的選擇，",
          "sc": "……既然是他的选择，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409811,
          "spk": "木助 (キスケ)",
          "ja": "俺が口出しすることじゃない",
          "tc": "那我就不該插嘴。",
          "sc": "那我就不该插嘴。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409822,
          "spk": "木助 (キスケ)",
          "ja": "……でも、てめぇはここまで戻ってくるために、",
          "tc": "……但是，你為了回到這裡，",
          "sc": "……但是，你为了回到这里，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409829,
          "spk": "木助 (キスケ)",
          "ja": "一体何人殺したんだ？",
          "tc": "到底殺了多少人？",
          "sc": "到底杀了多少人？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 409836,
          "spk": "木助 (キスケ)",
          "ja": "村の人を殺して、そして<player>までも……",
          "tc": "殺了村裡的人，就連<player>也……",
          "sc": "杀了村里的人，就连<player>也……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6878,
      "rec_id": "TALK_ID_70_2030_006_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409860,
          "spk": "木助 (キスケ)",
          "ja": "<player>は消えた、もう奇跡は起きない",
          "tc": "<player>不在了，不會再有奇蹟發生。",
          "sc": "<player>不在了，不会再有奇迹发生。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409867,
          "spk": "木助 (キスケ)",
          "ja": "てめぇがやったことは、消えることはない",
          "tc": "你做過的事不會消失。",
          "sc": "你做过的事不会消失。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6879,
      "rec_id": "TALK_ID_70_2030_006_25",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409885,
          "spk": "木助 (キスケ)",
          "ja": "……元を辿れば、俺にも原因がある",
          "tc": "……追根究柢，我也是原因之一。",
          "sc": "……追根究柢，我也是原因之一。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409903,
          "spk": "木助 (キスケ)",
          "ja": "あの時、止められなかったのも、",
          "tc": "無論是當時沒能阻止事情發生，",
          "sc": "无论是当时没能阻止事情发生，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409910,
          "spk": "木助 (キスケ)",
          "ja": "あいつに全部押しつけたのも、",
          "tc": "還是把一切都推到那傢伙身上，",
          "sc": "还是把一切都推到那家伙身上，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 409917,
          "spk": "木助 (キスケ)",
          "ja": "てめぇになにもしてやれなかったのも全部、俺だ",
          "tc": "什麼都沒能為你做，這一切都怪我。",
          "sc": "什么都没能为你做，这一切都怪我。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6880,
      "rec_id": "TALK_ID_70_2030_006_26",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409941,
          "spk": "木助 (キスケ)",
          "ja": "その罪はてめぇひとりのものじゃない",
          "tc": "那不是你一個人的罪。",
          "sc": "那不是你一个人的罪。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409948,
          "spk": "木助 (キスケ)",
          "ja": "背負うなら、俺も一緒に背負おう",
          "tc": "讓我也一起承擔這份罪吧。",
          "sc": "让我也一起承担这份罪吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6881,
      "rec_id": "TALK_ID_70_2030_006_27",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 409973,
          "spk": "木助 (キスケ)",
          "ja": "その体も、あいつの命も、",
          "tc": "那副身體、那傢伙的性命，",
          "sc": "那副身体、那家伙的性命，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 409980,
          "spk": "木助 (キスケ)",
          "ja": "てめぇが奪ったものも……",
          "tc": "還有被你奪走得一切……",
          "sc": "还有被你夺走得一切……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 409987,
          "spk": "木助 (キスケ)",
          "ja": "全部まとめて、生きて返すぞ",
          "tc": "全部一起活著還回去吧。",
          "sc": "全部一起活着还回去吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 409998,
          "spk": "木助 (キスケ)",
          "ja": "……俺も逃げない",
          "tc": "……我不會再逃避了。",
          "sc": "……我不会再逃避了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410005,
          "spk": "木助 (キスケ)",
          "ja": "だから、てめぇも逃げるな",
          "tc": "所以，你也別逃避。",
          "sc": "所以，你也别逃避。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6882,
      "rec_id": "TALK_ID_70_2030_006_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410029,
          "spk": "木助 (キスケ)",
          "ja": "……じゃあ、俺は帰るよ",
          "tc": "……那我要回去了。",
          "sc": "……那我要回去了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410036,
          "spk": "木助 (キスケ)",
          "ja": "邪魔して悪かったな",
          "tc": "抱歉打擾你了，",
          "sc": "抱歉打扰你了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410047,
          "spk": "木助 (キスケ)",
          "ja": "……あばよ、<player>",
          "tc": "……再見，<player>。",
          "sc": "……再见，<player>。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6883,
      "rec_id": "TALK_ID_70_2030_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410071,
          "spk": "木助 (キスケ)",
          "ja": "おう、やっと来たか",
          "tc": "哦，終於來啦。",
          "sc": "哦，终于来啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410078,
          "spk": "木助 (キスケ)",
          "ja": "ほら、さっさとこっちに来い",
          "tc": "快點過來這裡。",
          "sc": "快点过来这里。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410089,
          "spk": "木助 (キスケ)",
          "ja": "実はなぁ、サトイモが",
          "tc": "其實，",
          "sc": "其实，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410096,
          "spk": "木助 (キスケ)",
          "ja": "安く手に入ったんだ",
          "tc": "我買到一批好便宜的芋頭。",
          "sc": "我买到一批好便宜的芋头。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410107,
          "spk": "木助 (キスケ)",
          "ja": "ロッカクに「実家の味定食」に",
          "tc": "請六角幫我做了",
          "sc": "请六角帮我做了"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410114,
          "spk": "木助 (キスケ)",
          "ja": "してもらったんだぜ",
          "tc": "「家鄉味定食」。",
          "sc": "“家乡味定食”。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 410125,
          "spk": "木助 (キスケ)",
          "ja": "サトイモの煮っ転がし、",
          "tc": "醬燒芋頭、",
          "sc": "酱烧芋头、"
        },
        {
          "f_idx": 7,
          "pidx_tc": 410132,
          "spk": "木助 (キスケ)",
          "ja": "煮魚、ホウレンソウのお浸し",
          "tc": "醬煮魚、涼拌菠菜，",
          "sc": "酱煮鱼、凉拌菠菜，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 410139,
          "spk": "木助 (キスケ)",
          "ja": "それから忘れちゃならねえ白飯だ",
          "tc": "當然還有必備的白飯！",
          "sc": "当然还有必备的白饭！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 410150,
          "spk": "木助 (キスケ)",
          "ja": "煮魚とサトイモは",
          "tc": "醬煮魚和芋頭",
          "sc": "酱煮鱼和芋头"
        },
        {
          "f_idx": 10,
          "pidx_tc": 410157,
          "spk": "木助 (キスケ)",
          "ja": "米とよく合うんだよ",
          "tc": "可是很下飯的。",
          "sc": "可是很下饭的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 410168,
          "spk": "木助 (キスケ)",
          "ja": "ただなァ……",
          "tc": "只不過……",
          "sc": "只不过……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 410175,
          "spk": "木助 (キスケ)",
          "ja": "一人で食うには量が多すぎてな",
          "tc": "我一個人實在吃不完，",
          "sc": "我一个人实在吃不完，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 410186,
          "spk": "木助 (キスケ)",
          "ja": "ほれ、おすそわけしてやる",
          "tc": "來，分給你吃。",
          "sc": "来，分给你吃。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 410193,
          "spk": "木助 (キスケ)",
          "ja": "とにかく大量にあるからな",
          "tc": "總之份量很多，",
          "sc": "总之份量很多，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 410200,
          "spk": "木助 (キスケ)",
          "ja": "遠慮なく食ってけ",
          "tc": "別客氣，儘管吃吧。",
          "sc": "别客气，尽管吃吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6884,
      "rec_id": "TALK_ID_70_2030_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410224,
          "spk": "木助 (キスケ)",
          "ja": "<player>、どうだ",
          "tc": "<player>，怎麼樣？",
          "sc": "<player>，怎么样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410231,
          "spk": "木助 (キスケ)",
          "ja": "実家の味定食の味はよ",
          "tc": "家鄉味定食的味道如何？",
          "sc": "家乡味定食的味道如何？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410238,
          "spk": "木助 (キスケ)",
          "ja": "美味いか？",
          "tc": "好吃嗎？",
          "sc": "好吃吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410247,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410254,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6885,
      "rec_id": "TALK_ID_70_2030_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 410329,
          "spk": "木助 (キスケ)",
          "ja": "こいつを食ってると、なんでか",
          "tc": "只要吃了這個，",
          "sc": "只要吃了这个，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 410336,
          "spk": "木助 (キスケ)",
          "ja": "じいさんとばあさんを思い出すぜ",
          "tc": "就會想起爺爺和奶奶。",
          "sc": "就会想起爷爷和奶奶。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 410347,
          "spk": "木助 (キスケ)",
          "ja": "別に、じいさんとばあさんが",
          "tc": "但這也不是因為爺爺和奶奶",
          "sc": "但这也不是因为爷爷和奶奶"
        },
        {
          "f_idx": 3,
          "pidx_tc": 410354,
          "spk": "木助 (キスケ)",
          "ja": "煮っ転がしをよく作ってくれたって",
          "tc": "很常煮醬燒芋頭給我吃，",
          "sc": "很常煮酱烧芋头给我吃，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 410361,
          "spk": "木助 (キスケ)",
          "ja": "わけでもねえんだが",
          "tc": "我才會這樣想。",
          "sc": "我才会这样想。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 410372,
          "spk": "木助 (キスケ)",
          "ja": "多分、年寄りが作ってくれそうって",
          "tc": "大概是有種既定印象",
          "sc": "大概是有种既定印象"
        },
        {
          "f_idx": 6,
          "pidx_tc": 410379,
