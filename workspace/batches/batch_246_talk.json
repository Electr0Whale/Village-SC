  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 6843,
      "rec_id": "TALK_ID_70_2030_004_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408027,
          "spk": "裕太 (ユータ)",
          "ja": "先輩、お待たせ……あっ！",
          "tc": "學長，久等了……啊！",
          "sc": "学长，久等了……啊！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408045,
          "spk": "裕太 (ユータ)",
          "ja": "……寝てる",
          "tc": "……睡著了……",
          "sc": "……睡着了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408052,
          "spk": "裕太 (ユータ)",
          "ja": "自由すぎるでしょ……",
          "tc": "也太自由奔放了吧……",
          "sc": "也太自由奔放了吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6844,
      "rec_id": "TALK_ID_70_2030_004_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408070,
          "spk": "裕太 (ユータ)",
          "ja": "迷惑かけちゃってごめんね",
          "tc": "抱歉給你添麻煩了。",
          "sc": "抱歉给你添麻烦了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408077,
          "spk": "裕太 (ユータ)",
          "ja": "昼から呑んでたから",
          "tc": "因為從白天就在喝酒，",
          "sc": "因为从白天就在喝酒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408084,
          "spk": "裕太 (ユータ)",
          "ja": "先輩かなり酔ってて……",
          "tc": "所以學長醉得很厲害……",
          "sc": "所以学长醉得很厉害……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408095,
          "spk": "裕太 (ユータ)",
          "ja": "……えっと",
          "tc": "……那個。",
          "sc": "……那个。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 408102,
          "spk": "裕太 (ユータ)",
          "ja": "もしかしたら、<player>の目には",
          "tc": "也許在<player>眼裡，",
          "sc": "也许在<player>眼里，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 408109,
          "spk": "裕太 (ユータ)",
          "ja": "先輩が傍若無人に映ってるかもしれない",
          "tc": "學長看起來一副目中無人的樣子，",
          "sc": "学长看起来一副目中无人的样子，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 408120,
          "spk": "裕太 (ユータ)",
          "ja": "それは否定しないけど",
          "tc": "這點我也不否認。",
          "sc": "这点我也不否认。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 408127,
          "spk": "裕太 (ユータ)",
          "ja": "でもね、先輩って本当は",
          "tc": "但學長他，",
          "sc": "但学长他，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 408134,
          "spk": "裕太 (ユータ)",
          "ja": "根っこが優しい人なんだよ",
          "tc": "其實是個本性善良的人。",
          "sc": "其实是个本性善良的人。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 408145,
          "spk": "裕太 (ユータ)",
          "ja": "……だから俺は",
          "tc": "……所以我",
          "sc": "……所以我"
        },
        {
          "f_idx": 10,
          "pidx_tc": 408152,
          "spk": "裕太 (ユータ)",
          "ja": "キスケさんの後輩なんだ",
          "tc": "要當木助學長的學弟。",
          "sc": "要当木助学长的学弟。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6845,
      "rec_id": "TALK_ID_70_2030_004_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408172,
          "spk": "木助 (キスケ)",
          "ja": "グカァ……スピィ……",
          "tc": "呼……呼嚕……",
          "sc": "呼……呼噜……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408185,
          "spk": "裕太 (ユータ)",
          "ja": "……これは当分",
          "tc": "……這樣看起來，",
          "sc": "……这样看起来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408192,
          "spk": "裕太 (ユータ)",
          "ja": "起きそうにないな",
          "tc": "他一時半刻是不會醒了。",
          "sc": "他一时半刻是不会醒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6846,
      "rec_id": "TALK_ID_70_2030_004_17",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 408210,
          "spk": "裕太 (ユータ)",
          "ja": "先輩は、自宅に連れて行くよ",
          "tc": "學長我就先帶回家了。",
          "sc": "学长我就先带回家了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 408217,
          "spk": "裕太 (ユータ)",
          "ja": "おぶっていくから",
          "tc": "我會背他過去，",
          "sc": "我会背他过去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 408224,
          "spk": "裕太 (ユータ)",
          "ja": "手伝わなくても大丈夫だよ",
          "tc": "你不用幫忙也沒問題的。",
          "sc": "你不用帮忙也没问题的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 408235,
          "spk": "裕太 (ユータ)",
          "ja": "それじゃ、またね",
          "tc": "那就改天見囉。",
          "sc": "那就改天见啦。"
        }
      ]
    },
