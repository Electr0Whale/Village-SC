          "tc": "你跟我來餐廳一趟吧。",
          "sc": "你跟我来餐厅一趟呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6357,
      "rec_id": "TALK_ID_70_0080_004_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363278,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんは今、",
          "tc": "<player>，",
          "sc": "<player>，"
