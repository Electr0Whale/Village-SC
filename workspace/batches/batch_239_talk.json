        {
          "f_idx": 1,
          "pidx_tc": 363481,
          "spk": "六角 (ロッカク)",
          "ja": "妙な声に呼びかけられたことってないっスか？",
          "tc": "有沒有被奇怪的聲音呼喚過？",
          "sc": "有没有被奇怪的声音呼唤过？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6362,
      "rec_id": "TALK_ID_70_0080_004_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363499,
          "spk": "六角 (ロッカク)",
          "ja": "ないなら、いいんス",
          "tc": "沒有就好，",
          "sc": "没有就好，"
