    },
    {
      "file": "talk.dat",
      "rec_idx": 6363,
      "rec_id": "TALK_ID_70_0090_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363562,
          "spk": "今野 (コンノ)",
          "ja": "おやァ、これはお手伝い券じゃないですかァ",
