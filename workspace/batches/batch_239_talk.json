          "sc": "你现在是自己一个人生活对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6358,
      "rec_id": "TALK_ID_70_0080_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363303,
          "spk": "六角 (ロッカク)",
          "ja": "なら、料理のひとつくらいは、",
          "tc": "既然如此，",
