        },
        {
          "f_idx": 3,
          "pidx_tc": 363169,
          "spk": "六角 (ロッカク)",
          "ja": "ほら、村の掟にもあるでしょう？",
          "tc": "村裡不是有規矩嗎？",
          "sc": "村里不是有规矩吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6355,
      "rec_id": "TALK_ID_70_0080_004_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363187,
          "spk": "六角 (ロッカク)",
          "ja": "「他人の秘密を暴くな」ってね",
          "tc": "「別揭露他人祕密」。",
          "sc": "“别揭露他人秘密”。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363205,
          "spk": "六角 (ロッカク)",
          "ja": "さて、それじゃあ<player>さんには",
          "tc": "好了，既然<player>",
          "sc": "好了，既然<player>"
        },
        {
          "f_idx": 3,
          "pidx_tc": 363212,
          "spk": "六角 (ロッカク)",
          "ja": "ワシの頼みを聞いてくれた",
          "tc": "完成了我的要求，",
          "sc": "完成了我的要求，"
