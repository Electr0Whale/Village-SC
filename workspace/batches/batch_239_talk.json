          "f_idx": 1,
          "pidx_tc": 363573,
          "spk": "今野 (コンノ)",
          "ja": "アナタもトバリさんのように",
          "tc": "您也跟帷小姐一樣",
          "sc": "您也跟帷小姐一样"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363580,
          "spk": "今野 (コンノ)",
          "ja": "リンさんから罰を受けたんですねェ",
          "tc": "被林小姐懲罰了啊？",
          "sc": "被林小姐惩罚了啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 363598,
          "spk": "今野 (コンノ)",
          "ja": "とはいえ、<player>さんのような",
          "tc": "但是像<player>這樣的小孩子，",
