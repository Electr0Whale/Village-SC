          "pidx_tc": 363219,
          "spk": "六角 (ロッカク)",
          "ja": "お礼をしなくちゃならねえっスね",
          "tc": "那我得來好好答謝你才行。",
          "sc": "那我得来好好答谢你才行呐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6356,
      "rec_id": "TALK_ID_70_0080_004_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 363245,
          "spk": "六角 (ロッカク)",
