          "pidx_tc": 363506,
          "spk": "六角 (ロッカク)",
          "ja": "変なこと言ったっスね",
          "tc": "抱歉啊，問了奇怪的問題，",
          "sc": "抱歉啊，问了奇怪的问题，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 363513,
          "spk": "六角 (ロッカク)",
          "ja": "忘れてください",
          "tc": "你就忘了吧。",
          "sc": "你就忘了吧。"
