      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400134,
          "spk": "林 (リン)",
          "ja": "ねえ、<player>",
          "tc": "欸，<player>。",
          "sc": "诶，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400141,
          "spk": "林 (リン)",
          "ja": "……この前は、悪かったわね？",
          "tc": "……之前真的是很不好意思。",
          "sc": "……之前真的是很不好意思。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7049,
      "rec_id": "TALK_ID_70_2050_004_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400159,
          "spk": "林 (リン)",
          "ja": "私が倒れた時に、",
          "tc": "就是上次我昏倒那時，",
          "sc": "就是上次我昏倒那时，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400166,
          "spk": "林 (リン)",
          "ja": "助けてもらった時のことよ……",
          "tc": "你幫了我的那件事……",
          "sc": "你帮了我的那件事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7050,
      "rec_id": "TALK_ID_70_2050_004_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400184,
          "spk": "林 (リン)",
          "ja": "あれからしばらく",
          "tc": "在那之後，",
          "sc": "在那之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 400191,
          "spk": "林 (リン)",
          "ja": "考えたの……",
          "tc": "我好好思考過了……",
          "sc": "我好好思考过了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 400200,
          "spk": "林 (リン)",
          "ja": "私は今まで一人で抱え込んで、",
          "tc": "我一直都是自己一個人承擔，",
          "sc": "我一直都是自己一个人承担，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 400207,
          "spk": "林 (リン)",
          "ja": "一人でなんとかしようとしてきた……",
          "tc": "努力想要靠自己解決……",
          "sc": "努力想要靠自己解决……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 400214,
          "spk": "林 (リン)",
          "ja": "でもそれは、限界があると痛感したわ",
          "tc": "但是我深刻感受到，那是有極限的。",
          "sc": "但是我深刻感受到，那是有极限的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 400225,
          "spk": "林 (リン)",
          "ja": "だから、あなたが支えてくれたみたいに、",
          "tc": "所以，就像你曾經支持我一樣，",
          "sc": "所以，就像你曾经支持我一样，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 400232,
          "spk": "林 (リン)",
          "ja": "私も、もう少しみんなを信用して、悩みを",
          "tc": "我也覺得，也許我可以再多信任大家一點，",
          "sc": "我也觉得，也许我可以再多信任大家一点，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 400239,
          "spk": "林 (リン)",
          "ja": "打ち明けてもいいのかもしれないって思ったの",
          "tc": "把煩惱說出來也沒關係。",
          "sc": "把烦恼说出来也没关系。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 400250,
          "spk": "林 (リン)",
          "ja": "……というわけで",
          "tc": "……所以，",
          "sc": "……所以，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 400257,
          "spk": "林 (リン)",
          "ja": "さっそくあなたを頼っていいかしら？",
          "tc": "我可不可以馬上拜託你一件事？",
