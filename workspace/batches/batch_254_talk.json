      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399485,
          "spk": "林 (リン)",
          "ja": "私はこれから村の清掃活動よ",
          "tc": "我接下來要開始村子的清掃活動。",
          "sc": "我接下来要开始村子的清扫活动。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399492,
          "spk": "林 (リン)",
          "ja": "こんな仕事、村の人たちは嫌がると思うから、",
          "tc": "我想村裡的大家都不愛這種工作，",
          "sc": "我想村里的大家都不爱这种工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399499,
          "spk": "林 (リン)",
          "ja": "私がやってるのだけど……",
          "tc": "所以只能我來做了……",
          "sc": "所以只能我来做了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7035,
      "rec_id": "TALK_ID_70_2050_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399517,
          "spk": "林 (リン)",
          "ja": "あ、あら……？",
          "tc": "奇、奇怪……？",
          "sc": "奇、奇怪……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399524,
          "spk": "林 (リン)",
          "ja": "なにこれ、視界が……",
          "tc": "怎麼回事？我怎麼眼前……",
          "sc": "怎么回事？我怎么眼前……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7036,
      "rec_id": "TALK_ID_70_2050_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399548,
          "spk": "林 (リン)",
          "ja": "……ん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7037,
      "rec_id": "TALK_ID_70_2050_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399572,
          "spk": "林 (リン)",
          "ja": "あら？　<player>……",
          "tc": "哎呀？<player>……",
          "sc": "哎呀？<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399579,
          "spk": "林 (リン)",
          "ja": "私、なんでここに？",
          "tc": "我怎麼在這裡？",
          "sc": "我怎么在这里？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7038,
      "rec_id": "TALK_ID_70_2050_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399597,
          "spk": "林 (リン)",
          "ja": "……そう",
          "tc": "……這樣啊，",
          "sc": "……这样啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399604,
          "spk": "林 (リン)",
          "ja": "私、疲れていたのね……",
          "tc": "我累積太多疲勞了……",
          "sc": "我累积太多疲劳了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399615,
          "spk": "林 (リン)",
          "ja": "あなたがここまで運んでくれたのね",
          "tc": "是你把我帶來這邊的吧。",
          "sc": "是你把我带来这边的吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 399622,
          "spk": "林 (リン)",
          "ja": "ありがとう……助かったわ",
          "tc": "謝謝你……幫大忙了。",
          "sc": "谢谢你……帮大忙了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7039,
      "rec_id": "TALK_ID_70_2050_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399646,
          "spk": "林 (リン)",
          "ja": "はぁ……こうならないように、",
          "tc": "唉……雖然為了避免出現這種情況，",
          "sc": "唉……虽然为了避免出现这种情况，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399653,
          "spk": "林 (リン)",
          "ja": "みんなに仕事は頼んでいるつもりなんだけど……",
          "tc": "我自認已經儘量地把工作分給大家了……",
          "sc": "我自认已经尽量地把工作分给大家了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399662,
          "spk": "林 (リン)",
          "ja": "どうしても、手が回らないところが出てくるの",
          "tc": "但總有應付不來的地方，",
          "sc": "但总有应付不来的地方，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 399669,
          "spk": "林 (リン)",
          "ja": "だから結局、自分でやるしかなくて……",
          "tc": "結果到最後還是只能自己來……",
          "sc": "结果到最后还是只能自己来……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 399687,
          "spk": "林 (リン)",
          "ja": "……情けない話よ",
          "tc": "……真丟臉呢。",
          "sc": "……真丢脸呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 399694,
          "spk": "林 (リン)",
          "ja": "自分の体調管理すら、",
          "tc": "我連自己的健康管理",
          "sc": "我连自己的健康管理"
        },
        {
          "f_idx": 7,
          "pidx_tc": 399701,
          "spk": "林 (リン)",
          "ja": "満足にできてないなんて",
          "tc": "都做不好，",
          "sc": "都做不好，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 399710,
          "spk": "林 (リン)",
          "ja": "もっとしっかりしなくちゃ……",
          "tc": "我得更振作一點才行……",
          "sc": "我得更振作一点才行……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 399717,
          "spk": "林 (リン)",
          "ja": "私が倒れたら、この村は……",
          "tc": "要是我倒下去了，這座村子……",
          "sc": "要是我倒下去了，这座村子……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7040,
      "rec_id": "TALK_ID_70_2050_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399735,
          "spk": "林 (リン)",
          "ja": "……心配してくれるの？",
          "tc": "……你在擔心我嗎？",
          "sc": "……你在担心我吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399742,
          "spk": "林 (リン)",
          "ja": "ふふ、私、あなたに迷惑かけてばかりね……",
          "tc": "呵呵，我總是在麻煩你……",
          "sc": "呵呵，我总是在麻烦你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 399760,
          "spk": "林 (リン)",
          "ja": "でも私は……",
          "tc": "但是，我……",
          "sc": "但是，我……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 399767,
          "spk": "林 (リン)",
          "ja": "いつもみんなに規則を守らせる立場で、",
          "tc": "總是站在讓大家遵守規則的立場上，",
          "sc": "总是站在让大家遵守规则的立场上，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 399774,
          "spk": "林 (リン)",
          "ja": "無理やり従わせることばかりしているわ",
          "tc": "強迫大家服從我。",
          "sc": "强迫大家服从我。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 399785,
          "spk": "林 (リン)",
          "ja": "知ってるのよ、煙たがられてることは……",
          "tc": "被討厭也是不爭的事實……",
          "sc": "被讨厌也是不争的事实……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 399792,
          "spk": "林 (リン)",
          "ja": "それなのに、また頼みごとなんてしたら……",
          "tc": "如果這樣還去拜託他人幫忙的話……",
          "sc": "如果这样还去拜托他人帮忙的话……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 399810,
          "spk": "林 (リン)",
          "ja": "だから、できるだけ自分で",
          "tc": "所以，我才會想要",
          "sc": "所以，我才会想要"
        },
        {
          "f_idx": 10,
          "pidx_tc": 399817,
          "spk": "林 (リン)",
          "ja": "解決するようにしているのだけれど……",
          "tc": "盡可能靠自己的力量解決……",
          "sc": "尽可能靠自己的力量解决……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7041,
      "rec_id": "TALK_ID_70_2050_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399835,
          "spk": "林 (リン)",
          "ja": "でも、ありがとう、<player>",
          "tc": "不過，謝謝你，<player>。",
          "sc": "不过，谢谢你，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399842,
          "spk": "林 (リン)",
          "ja": "あなたのおかげで少し、気分が楽になったわ",
          "tc": "多虧有你，心情上比較輕鬆了。",
          "sc": "多亏有你，心情上比较轻松了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399853,
          "spk": "林 (リン)",
          "ja": "確かに……全部一人で抱え込むことが",
          "tc": "確實……獨自承擔所有事情，",
          "sc": "确实……独自承担所有事情，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 399860,
          "spk": "林 (リン)",
          "ja": "「しっかりする」ってことじゃ",
          "tc": "或許並不能被稱為",
          "sc": "或许并不能被称为"
        },
        {
          "f_idx": 4,
          "pidx_tc": 399867,
          "spk": "林 (リン)",
          "ja": "ないのかもしれないわね",
          "tc": "「好好做事」對吧。",
          "sc": "“好好做事”对吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 399878,
          "spk": "林 (リン)",
          "ja": "今日のお礼にこれからは、",
          "tc": "今天的事情很感謝你，",
          "sc": "今天的事情很感谢你，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 399885,
          "spk": "林 (リン)",
          "ja": "気軽に私の家に来るのを許してあげる",
          "tc": "今後允許你可以隨意進出我家。",
          "sc": "今后允许你可以随意进出我家。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 399892,
          "spk": "林 (リン)",
          "ja": "ちゃんとおもてなしもしてあげるわよ",
          "tc": "我會好好招待你的。",
          "sc": "我会好好招待你的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7042,
      "rec_id": "TALK_ID_70_2050_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 399916,
          "spk": "林 (リン)",
          "ja": "それじゃ、私は仕事に戻るから……",
          "tc": "那我就先回去工作囉。",
          "sc": "那我就先回去工作啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 399927,
          "spk": "林 (リン)",
          "ja": "……いや、今日はやめときましょう",
          "tc": "……不，今天就不工作了。",
          "sc": "……不，今天就不工作了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 399934,
          "spk": "林 (リン)",
          "ja": "これ以上あなたに心配はかけられないわね",
          "tc": "不能再讓你為我擔心了。",
          "sc": "不能再让你为我担心了。"
        }
      ]
    },
    {
