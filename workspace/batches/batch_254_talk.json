      "rec_id": "TALK_ID_70_2050_004_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 400407,
          "spk": "茶梅 (サザンカ)",
          "ja": "あれ？　<player>にリンじゃん",
