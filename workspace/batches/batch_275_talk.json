        },
        {
          "f_idx": 2,
          "pidx_tc": 446234,
          "spk": "裕太 (ユータ)",
          "ja": "さすが師匠だね",
          "tc": "不愧是師父。",
          "sc": "不愧是师父。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446241,
          "spk": "裕太 (ユータ)",
          "ja": "俺、感動しちゃったよ！",
          "tc": "我覺得好感動！",
          "sc": "我觉得好感动！"
        }
      ]
    },
    {
