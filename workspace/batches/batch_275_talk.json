          "pidx_tc": 390766,
          "spk": "今野 (コンノ)",
          "ja": "チナナさんがとてつもない苦労をして",
          "tc": "而且是琪娜娜小姐歷經千辛萬苦才入手，",
          "sc": "而且是琪娜娜小姐历经千辛万苦才入手，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 390773,
          "spk": "今野 (コンノ)",
          "ja": "手に入れ、特別にワタシに売ってくれると",
          "tc": "然後說可以特別賣給我的",
          "sc": "然后说可以特别卖给我的"
