          "f_idx": 3,
          "pidx_tc": 448059,
          "spk": "堇怜 (スミレ)",
          "ja": "誰かに話すと、",
          "tc": "感覺只要告訴別人，",
          "sc": "感觉只要告诉别人，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 448066,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと自分のものになる気がするんだ！",
          "tc": "就會確實消化成自己的知識！",
          "sc": "就会确实消化成自己的知识！"
        }
      ]
    },
    {
