        {
          "f_idx": 6,
          "pidx_tc": 447548,
          "spk": "堇怜 (スミレ)",
          "ja": "早く食べよう",
          "tc": "趕緊開動吧。",
          "sc": "赶紧开动吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7769,
      "rec_id": "TALK_ID_70_2130_009_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447572,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん……！",
          "tc": "嗯～！",
          "sc": "嗯～！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447579,
          "spk": "堇怜 (スミレ)",
          "ja": "食べ応えがあって美味いなあ",
          "tc": "吃起來好滿足，真美味啊。",
          "sc": "吃起来好满足，真美味啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 447590,
          "spk": "堇怜 (スミレ)",
          "ja": "肉だけにしようとしてたら",
          "tc": "本來只打算吃肉，",
          "sc": "本来只打算吃肉，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 447597,
          "spk": "堇怜 (スミレ)",
          "ja": "ちゃんと野菜も食べたほうがいい",
          "tc": "結果被說還是應該",
          "sc": "结果被说还是应该"
        },
        {
          "f_idx": 4,
          "pidx_tc": 447604,
          "spk": "堇怜 (スミレ)",
          "ja": "って言われてさ",
          "tc": "好好吃點蔬菜比較好。",
          "sc": "好好吃点蔬菜比较好。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 447615,
          "spk": "堇怜 (スミレ)",
          "ja": "ああ、コマコにね",
          "tc": "啊，是駒子這樣說的。",
          "sc": "啊，是驹子这样说的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 447622,
          "spk": "堇怜 (スミレ)",
          "ja": "おいしいから文句とかないんだけどさ",
          "tc": "不過這樣很好吃，也沒什麼好抱怨的。",
          "sc": "不过这样很好吃，也没什么好抱怨的。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 447640,
          "spk": "堇怜 (スミレ)",
          "ja": "これ、コマコが捕まえた",
          "tc": "這個野豬肉",
          "sc": "这个野猪肉"
        },
        {
          "f_idx": 9,
          "pidx_tc": 447647,
          "spk": "堇怜 (スミレ)",
          "ja": "イノシシなんだって",
          "tc": "說是駒子自己獵到的呢。",
          "sc": "说是驹子自己猎到的呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 447658,
          "spk": "堇怜 (スミレ)",
          "ja": "僕と違って、コマコには",
          "tc": "駒子哪像我，",
          "sc": "驹子哪像我，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 447665,
          "spk": "堇怜 (スミレ)",
          "ja": "手に職があって偉いよなあ",
          "tc": "真佩服她有一技之長呢。",
          "sc": "真佩服她有一技之长呢。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 447681,
          "spk": "堇怜 (スミレ)",
          "ja": "リンも……",
          "tc": "林也是……",
          "sc": "林也是……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 447688,
          "spk": "堇怜 (スミレ)",
          "ja": "どうかと思うところはあるけど",
          "tc": "雖然有讓人不敢恭維的地方，",
          "sc": "虽然有让人不敢恭维的地方，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 447695,
          "spk": "堇怜 (スミレ)",
          "ja": "村長をやってるなんて偉いと思うよ",
          "tc": "但能擔任村長還是很厲害。",
          "sc": "但能担任村长还是很厉害。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 447706,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も、将来はちゃんと、",
          "tc": "我將來是不是也能",
          "sc": "我将来是不是也能"
        },
        {
          "f_idx": 17,
          "pidx_tc": 447713,
          "spk": "堇怜 (スミレ)",
          "ja": "立派な大人になれるのかな？",
          "tc": "成為出色的大人呢？",
          "sc": "成为出色的大人呢？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 447722,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 19,
          "pidx_tc": 447729,
          "spk": "主角心声/旁白/选项",
          "ja": "うーん",
          "tc": "唔……",
          "sc": "唔……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7770,
      "rec_id": "TALK_ID_70_2130_009_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447826,
          "spk": "堇怜 (スミレ)",
          "ja": "大人になったら僕と",
          "tc": "等到成為大人，",
          "sc": "等到成为大人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447833,
          "spk": "堇怜 (スミレ)",
          "ja": "リンとコマコの三人で",
          "tc": "就由我、林、駒子三個人",
          "sc": "就由我、林、驹子三个人"
        },
        {
          "f_idx": 2,
          "pidx_tc": 447840,
          "spk": "堇怜 (スミレ)",
          "ja": "この村を支えていくんだ",
          "tc": "來守護這座村子。",
          "sc": "来守护这座村子。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 447851,
          "spk": "堇怜 (スミレ)",
          "ja": "その時は<player>も",
          "tc": "到時候<player>也要",
          "sc": "到时候<player>也要"
        },
        {
          "f_idx": 4,
          "pidx_tc": 447858,
          "spk": "堇怜 (スミレ)",
          "ja": "協力してくれよ！",
          "tc": "一起來幫忙喔！",
          "sc": "一起来帮忙哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7771,
      "rec_id": "TALK_ID_70_2130_010_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447889,
          "spk": "堇怜 (スミレ)",
          "ja": "やっと来た……！",
          "tc": "終於來了……！",
          "sc": "终于来了……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447896,
          "spk": "堇怜 (スミレ)",
          "ja": "いらっしゃい、待ってたよ",
          "tc": "歡迎，等你好久了。",
          "sc": "欢迎，等你好久了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7772,
      "rec_id": "TALK_ID_70_2130_010_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447914,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>が来るから、部屋、少し片付けたよ",
          "tc": "因為<player>要來，所以稍微打掃了房間喔。",
          "sc": "因为<player>要来，所以稍微打扫了房间哦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447921,
          "spk": "堇怜 (スミレ)",
          "ja": "最近は前より、ちゃんとするようにしてるんだ",
          "tc": "最近，我比以前更認真過生活了。",
          "sc": "最近，我比以前更认真过生活了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7773,
      "rec_id": "TALK_ID_70_2130_010_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447946,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強しようと思ったら、",
          "tc": "我發現，就算我想要唸書，",
          "sc": "我发现，就算我想要念书，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447953,
          "spk": "堇怜 (スミレ)",
          "ja": "散らかした楽しそうなものが見えると",
          "tc": "但要是房間裡亂糟糟的，",
          "sc": "但要是房间里乱糟糟的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 447960,
          "spk": "堇怜 (スミレ)",
          "ja": "気が散っちゃうことに気づいてさ",
          "tc": "一看到有趣的東西就會讓我分心。",
          "sc": "一看到有趣的东西就会让我分心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 447971,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんにも教えてもらうことが増えたよ",
          "tc": "也多了一些想請姊姊教我的事情。",
          "sc": "也多了一些想请姐姐教我的事情。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 447978,
          "spk": "堇怜 (スミレ)",
          "ja": "医者になるって夢を叶えるためには、",
          "tc": "畢竟想要成為醫生，",
          "sc": "毕竟想要成为医生，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 447985,
          "spk": "堇怜 (スミレ)",
          "ja": "足りないことばかりで恥ずかしいんだけどね……",
          "tc": "我還有很多不足的地方，總覺得很不好意思……",
          "sc": "我还有很多不足的地方，总觉得很不好意思……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 447996,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、大きくなる前に",
          "tc": "但是，在長大之前，",
          "sc": "但是，在长大之前，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 448003,
          "spk": "堇怜 (スミレ)",
          "ja": "お金も貯めて、鵺の皮で村を出て",
          "tc": "我要存到錢，靠鵺皮離開村子，",
          "sc": "我要存到钱，靠鵺皮离开村子，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 448010,
          "spk": "堇怜 (スミレ)",
          "ja": "僕は、ちゃんと外で学びたい",
          "tc": "我想要好好地在外面念書。",
          "sc": "我想要好好地在外面念书。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7774,
      "rec_id": "TALK_ID_70_2130_010_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 448034,
          "spk": "堇怜 (スミレ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
