        {
          "f_idx": 5,
          "pidx_tc": 390755,
          "spk": "今野 (コンノ)",
          "ja": "いう超高級ウルトラレア腕時計！",
          "tc": "超高級超稀有的手錶！",
          "sc": "超高级超稀有的手表！"
        },
        {
