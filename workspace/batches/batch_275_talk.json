      "rec_id": "TALK_ID_70_2130_008_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 447442,
          "spk": "堇怜 (スミレ)",
          "ja": "まあ、僕は川の魚が好きだし",
          "tc": "不過我很喜歡淡水魚就是了，",
