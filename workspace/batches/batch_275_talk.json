          "pidx_tc": 390199,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けどね、これがわりと",
          "tc": "可是這其實是個",
          "sc": "可是这其实是个"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390206,
          "spk": "琪娜娜 (チナナ)",
          "ja": "深刻な悩みなんだよ",
          "tc": "很嚴重的問題喔。",
          "sc": "很严重的问题哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 390217,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今までは、村で作ったものを",
          "tc": "我之前會把村裡製造的東西",
          "sc": "我之前会把村里制造的东西"
