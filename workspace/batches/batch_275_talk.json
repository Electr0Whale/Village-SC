        {
          "f_idx": 6,
          "pidx_tc": 390224,
          "spk": "琪娜娜 (チナナ)",
          "ja": "外で売りさばいたり、村に必要な",
          "tc": "拿去外面兜售，",
          "sc": "拿去外面兜售，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 390231,
          "spk": "琪娜娜 (チナナ)",
          "ja": "商品を買い付けたりしていてね",
          "tc": "或是幫村裡採購需要的商品回來。",
          "sc": "或是帮村里采购需要的商品回来。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 390240,
          "spk": "琪娜娜 (チナナ)",
          "ja": "これでも、村の生活のために",
          "tc": "別看我這樣，",
          "sc": "别看我这样，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 390247,
          "spk": "琪娜娜 (チナナ)",
          "ja": "かなり重要な仕事をしているって",
          "tc": "我的工作對村子裡生活是很重要的，",
          "sc": "我的工作对村子里生活是很重要的，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 390254,
          "spk": "琪娜娜 (チナナ)",
          "ja": "自負があったんだけど",
          "tc": "所以我很引以為傲。",
          "sc": "所以我很引以为傲。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 390265,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今じゃ、時間が余りに余っててね",
          "tc": "但我現在閒得發慌，",
          "sc": "但我现在闲得发慌，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 390272,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほとんどプータローみたいなもんさ",
          "tc": "簡直就跟米蟲沒兩樣。",
          "sc": "简直就跟米虫没两样。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 390290,
          "spk": "琪娜娜 (チナナ)",
          "ja": "店番してるだけってのも",
          "tc": "單純顧店",
          "sc": "单纯顾店"
        },
        {
          "f_idx": 15,
          "pidx_tc": 390297,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どうにも味気ないし……",
          "tc": "也沒什麼意思……",
          "sc": "也没什么意思……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 390308,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミなら、時間が余ったら",
          "tc": "你如果閒得發慌，",
          "sc": "你如果闲得发慌，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 390315,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何をするんだろうね？",
          "tc": "都會做些什麼啊？",
          "sc": "都会做些什么啊？"
        },
        {
          "f_idx": 18,
          "pidx_tc": 390322,
          "spk": "琪娜娜 (チナナ)",
          "ja": "仕事以外で何かあるかい？",
          "tc": "你除了工作還有其他事可以做嗎？",
          "sc": "你除了工作还有其他事可以做吗？"
