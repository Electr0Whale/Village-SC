          "pidx_tc": 447084,
          "spk": "堇怜 (スミレ)",
          "ja": "自分でこだわって作る料理のほうが",
          "tc": "我還是覺得比不上自己",
          "sc": "我还是觉得比不上自己"
        },
        {
          "f_idx": 2,
          "pidx_tc": 447091,
          "spk": "堇怜 (スミレ)",
          "ja": "いいと思うし",
