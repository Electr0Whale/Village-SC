          "pidx_tc": 447134,
          "spk": "堇怜 (スミレ)",
          "ja": "もちろん美味いんだけどさ……",
          "tc": "當然也很美味……",
          "sc": "当然也很美味……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 447145,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>と食べる料理も",
          "tc": "但和<player>一起品嘗的料理",
          "sc": "但和<player>一起品尝的料理"
        },
        {
          "f_idx": 9,
          "pidx_tc": 447152,
          "spk": "堇怜 (スミレ)",
          "ja": "すごく美味く感じるんだ",
          "tc": "我也覺得非常好吃。",
          "sc": "我也觉得非常好吃。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 447163,
          "spk": "堇怜 (スミレ)",
          "ja": "また、ご飯食べに来てよ",
          "tc": "下次再來找我吃飯吧。",
          "sc": "下次再来找我吃饭吧。"
        }
      ]
    },
