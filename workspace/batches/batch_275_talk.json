          "spk": "堇怜 (スミレ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 447505,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はご馳走を用意してるよ！",
