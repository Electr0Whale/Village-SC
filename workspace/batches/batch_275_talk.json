          "pidx_tc": 390741,
          "spk": "今野 (コンノ)",
          "ja": "ノブレスオブリージュで",
          "tc": "是貴族必須配戴在身上，",
          "sc": "是贵族必须配戴在身上，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390748,
          "spk": "今野 (コンノ)",
          "ja": "ロイヤルな方々のために作られたと",
          "tc": "專門製作給皇室貴族們的",
          "sc": "专门制作给皇室贵族们的"
