      "rec_id": "TALK_ID_70_2130_006_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446730,
          "spk": "堇怜 (スミレ)",
          "ja": "僕、<player>を相棒に",
          "tc": "我很慶幸選擇了<player>",
          "sc": "我很庆幸选择了<player>"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446737,
          "spk": "堇怜 (スミレ)",
          "ja": "選んでよかったよ",
          "tc": "當我的夥伴。",
          "sc": "当我的伙伴。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446748,
          "spk": "堇怜 (スミレ)",
          "ja": "これからの人生を",
          "tc": "為了讓往後的人生變得更好，",
          "sc": "为了让往后的人生变得更好，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446755,
          "spk": "堇怜 (スミレ)",
          "ja": "より良くするために頑張るから",
          "tc": "我會加油的。",
          "sc": "我会加油的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446762,
          "spk": "堇怜 (スミレ)",
          "ja": "応援していてほしい",
