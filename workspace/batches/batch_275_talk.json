  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 7842,
      "rec_id": "TALK_ID_70_2150_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388782,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミが心配かい？",
          "tc": "你在擔心蓮實嗎？",
          "sc": "你在担心莲实吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388789,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大丈夫、起きたら",
          "tc": "沒事的，",
          "sc": "没事的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388796,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けろっとしているよ",
          "tc": "她醒來之後就會若無其事的了。",
          "sc": "她醒来之后就会若无其事的了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7843,
      "rec_id": "TALK_ID_70_2150_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388814,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あの子があそこまで",
          "tc": "她如果醉到像現在這樣，",
          "sc": "她如果醉到像现在这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388821,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酔ったら、とりあえず",
          "tc": "那只要讓她",
          "sc": "那只要让她"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388828,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝かせておけば大丈夫",
          "tc": "躺下來睡就會好了。",
          "sc": "躺下来睡就会好了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388839,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミが酔い潰れて",
          "tc": "我們的聚會",
          "sc": "我们的聚会"
        },
        {
          "f_idx": 4,
          "pidx_tc": 388846,
          "spk": "琪娜娜 (チナナ)",
          "ja": "お開きになることなんて",
          "tc": "本來就常常因為蓮實喝了個爛醉",
          "sc": "本来就常常因为莲实喝了个烂醉"
        },
        {
          "f_idx": 5,
          "pidx_tc": 388853,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しょっちゅうだからね",
          "tc": "而結束。",
          "sc": "而结束。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 388864,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ま、酒が多少の",
          "tc": "……如果酒精",
          "sc": "……如果酒精"
        },
        {
          "f_idx": 7,
          "pidx_tc": 388871,
          "spk": "琪娜娜 (チナナ)",
          "ja": "息抜きになるならいいさ",
          "tc": "能稍微讓她放鬆的話就好。",
          "sc": "能稍微让她放松的话就好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 388880,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチにできることは、",
          "tc": "我能做的，",
          "sc": "我能做的，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 388887,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酒に付き合うぐらいだし……",
          "tc": "也就只有陪她喝酒了……",
          "sc": "也就只有陪她喝酒了……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 388898,
          "spk": "琪娜娜 (チナナ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7844,
      "rec_id": "TALK_ID_70_2150_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388916,
          "spk": "琪娜娜 (チナナ)",
          "ja": "さて、帰るかねえ",
          "tc": "好了，該回家了。",
          "sc": "好了，该回家了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388923,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも眠たくなってきた",
          "tc": "我也開始睏了。",
          "sc": "我也开始困了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7845,
      "rec_id": "TALK_ID_70_2150_002_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388947,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？",
          "tc": "嗯？",
          "sc": "嗯？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388954,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……ああ、その段ボールか",
          "tc": "……喔，你說那個紙箱嗎？",
          "sc": "……哦，你说那个纸箱吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388961,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そのまま置いといていいよ",
          "tc": "你放著就好。",
          "sc": "你放着就好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388972,
          "spk": "琪娜娜 (チナナ)",
          "ja": "面と向かって渡すと",
          "tc": "要是當面給她，",
          "sc": "要是当面给她，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 388979,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミは受け取らないからね",
          "tc": "她是不會收的。",
          "sc": "她是不会收的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 388986,
          "spk": "琪娜娜 (チナナ)",
          "ja": "寝ているうちに置いとくんだ",
          "tc": "我都趁她睡覺的時候放著。",
          "sc": "我都趁她睡觉的时候放着。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7846,
      "rec_id": "TALK_ID_70_2150_002_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389004,
          "spk": "琪娜娜 (チナナ)",
          "ja": "中身は食料だよ",
          "tc": "裡面是些糧食，",
          "sc": "里面是些粮食，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389011,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミと、",
          "tc": "是給蓮實",
          "sc": "是给莲实"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389018,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べ盛りのスミレの分さ",
          "tc": "以及正在發育期的堇怜的。",
          "sc": "以及正在发育期的堇怜的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389029,
          "spk": "琪娜娜 (チナナ)",
          "ja": "念のために言っとくけど、",
          "tc": "為了保險起見，我還是說一聲好了，",
          "sc": "为了保险起见，我还是说一声好了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 389036,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミは食べないようね",
          "tc": "你可不要偷吃喔。",
          "sc": "你可不要偷吃哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7847,
      "rec_id": "TALK_ID_70_2150_002_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389054,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ははは、よろしい",
          "tc": "哈哈哈，很好。",
          "sc": "哈哈哈，很好。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389061,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあ、おやすみ～",
          "tc": "那就晚安了～",
          "sc": "那就晚安了～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7848,
      "rec_id": "TALK_ID_70_2150_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389087,
          "spk": "木助 (キスケ)",
          "ja": "……あんま言いたくねぇけどよ",
          "tc": "……我不是很想說這種事，",
          "sc": "……我不是很想说这种事，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389094,
          "spk": "木助 (キスケ)",
          "ja": "もっと人を頼ってもいいんじゃねえか？",
          "tc": "多依靠他人一點也可以吧？",
          "sc": "多依靠他人一点也可以吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389107,
          "spk": "琪娜娜 (チナナ)",
          "ja": "まあねえ",
          "tc": "或許吧。",
          "sc": "或许吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389120,
          "spk": "木助 (キスケ)",
          "ja": "古傷、たまに痛むんだろ？",
          "tc": "舊傷還會痛吧？",
          "sc": "旧伤还会痛吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 389140,
          "spk": "琪娜娜 (チナナ)",
          "ja": "多少はね",
          "tc": "多少會，",
          "sc": "多少会，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 389147,
          "spk": "琪娜娜 (チナナ)",
          "ja": "けどまあ、普段は",
          "tc": "不過平常",
          "sc": "不过平常"
        },
        {
          "f_idx": 7,
          "pidx_tc": 389154,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうでもないさ",
          "tc": "也都還好。",
          "sc": "也都还好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 389167,
          "spk": "木助 (キスケ)",
          "ja": "真剣に考えたらどうだ？",
          "tc": "妳要不要認真考慮一下？",
          "sc": "你要不要认真考虑一下？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 389174,
          "spk": "木助 (キスケ)",
          "ja": "それが結局はハスミの心配性につながって、",
          "tc": "那最後還不是會讓蓮實窮擔心，",
          "sc": "那最后还不是会让莲实穷担心，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 389181,
          "spk": "木助 (キスケ)",
          "ja": "あいつの酒の量も……",
          "tc": "她喝酒的量也是……",
          "sc": "她喝酒的量也是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7849,
      "rec_id": "TALK_ID_70_2150_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389207,
          "spk": "木助 (キスケ)",
          "ja": "……てめぇなぁ",
          "tc": "……我說你啊，",
          "sc": "……我说你啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389214,
          "spk": "木助 (キスケ)",
          "ja": "黙って立ってないで",
          "tc": "不要默默站在那裡，",
          "sc": "不要默默站在那里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389221,
          "spk": "木助 (キスケ)",
          "ja": "声ぐらいかけろっての",
          "tc": "好歹也出個聲吧？",
          "sc": "好歹也出个声吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7850,
      "rec_id": "TALK_ID_70_2150_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389247,
          "spk": "木助 (キスケ)",
          "ja": "じゃあな、チナナ",
          "tc": "那我先走啦，琪娜娜。",
          "sc": "那我先走啦，琪娜娜。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389260,
          "spk": "琪娜娜 (チナナ)",
          "ja": "はいはい、またね～",
          "tc": "好好好，再見～",
          "sc": "好好好，再见～"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7851,
      "rec_id": "TALK_ID_70_2150_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389286,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いらっしゃい、<player>",
          "tc": "歡迎光臨，<player>，",
          "sc": "欢迎光临，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389293,
          "spk": "琪娜娜 (チナナ)",
          "ja": "今、休憩中だったんだよ",
          "tc": "我剛剛在休息。",
          "sc": "我刚刚在休息。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389300,
          "spk": "琪娜娜 (チナナ)",
          "ja": "何か欲しいものでも？",
          "tc": "你有什麼想要的東西嗎？",
          "sc": "你有什么想要的东西吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7852,
      "rec_id": "TALK_ID_70_2150_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389318,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだ、通りすがりかい？",
          "tc": "什麼？你只是剛好經過？",
          "sc": "什么？你只是刚好经过？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389325,
          "spk": "琪娜娜 (チナナ)",
          "ja": "じゃあもうちょっと",
          "tc": "那我就",
          "sc": "那我就"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389332,
          "spk": "琪娜娜 (チナナ)",
          "ja": "休憩させてもらおうかね",
          "tc": "再多休息一下囉。",
          "sc": "再多歇会儿吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389343,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……あ、そうだ",
          "tc": "……啊，對了。",
          "sc": "……啊，对了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 389350,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 389357,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ちょっと聞いててよ",
          "tc": "你聽我說。",
          "sc": "你听我说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7853,
      "rec_id": "TALK_ID_70_2150_003_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389375,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ンモォ～～～～～～ッ！",
          "tc": "哞～～～～～～！",
          "sc": "哞～～～～～～！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7854,
      "rec_id": "TALK_ID_70_2150_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389393,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あっはっは",
          "tc": "啊哈哈，",
          "sc": "啊哈哈，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389400,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい反応だねえ",
          "tc": "你的反應真不錯。",
          "sc": "你的反应真不错。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389409,
          "spk": "琪娜娜 (チナナ)",
          "ja": "昔、キスケにこれを聞かされて",
          "tc": "以前木助學給我聽的時候，",
          "sc": "以前木助学给我听的时候，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389416,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そっくりすぎるって感動してね",
          "tc": "因為實在是太像了，我整個很感動，",
          "sc": "因为实在是太像了，我整个很感动，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 389423,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチも特訓してできるようになったんだよ",
          "tc": "於是我也特訓了一番，然後就學起來了。",
          "sc": "于是我也特训了一番，然后就学起来了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 389434,
          "spk": "琪娜娜 (チナナ)",
          "ja": "村の人には何度も聞かせているから",
          "tc": "村民都已經聽過無數次了，",
          "sc": "村民都已经听过无数次了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 389441,
          "spk": "琪娜娜 (チナナ)",
          "ja": "久しぶりの新鮮な反応で嬉しいね",
          "tc": "所以我好久沒看到這麼新鮮的反應了，真開心。",
          "sc": "所以我好久没看到这么新鲜的反应了，真开心。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7855,
      "rec_id": "TALK_ID_70_2150_003_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389466,
          "spk": "琪娜娜 (チナナ)",
          "ja": "あー……他にも聞きたいかい？",
          "tc": "啊……你還想聽聽別的嗎？",
          "sc": "啊……你还想听听别的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389473,
          "spk": "琪娜娜 (チナナ)",
          "ja": "悪いけど、ウチはウシしか",
          "tc": "抱歉，",
          "sc": "抱歉，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389480,
          "spk": "琪娜娜 (チナナ)",
          "ja": "真似できないんだよ",
          "tc": "我只會模仿牛。",
          "sc": "我只会模仿牛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7856,
      "rec_id": "TALK_ID_70_2150_003_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 389498,
          "spk": "琪娜娜 (チナナ)",
          "ja": "……そんな期待した目で",
          "tc": "……你用這樣期待的眼神",
          "sc": "……你用这样期待的眼神"
        },
        {
          "f_idx": 1,
          "pidx_tc": 389505,
          "spk": "琪娜娜 (チナナ)",
          "ja": "見られてもね",
          "tc": "看著我也沒用啊，",
          "sc": "看着我也没用啊，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 389512,
          "spk": "琪娜娜 (チナナ)",
          "ja": "声真似はこれで終わりだよ",
          "tc": "聲音模仿秀就到這邊結束了。",
          "sc": "声音模仿秀就到这边结束了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 389523,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ほら、どっか行って遊んどいで",
