    },
    {
      "file": "talk.dat",
      "rec_idx": 7743,
      "rec_id": "TALK_ID_70_2130_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446062,
          "spk": "裕太 (ユータ)",
          "ja": "どうどう？",
          "tc": "怎麼樣？",
          "sc": "怎么样？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446069,
          "spk": "裕太 (ユータ)",
          "ja": "すごいでしょ？",
          "tc": "很厲害吧？",
          "sc": "很厉害吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446080,
          "spk": "裕太 (ユータ)",
          "ja": "あれからずっと練習してたんだ",
          "tc": "那之後我一直拼命練習。",
          "sc": "那之后我一直拼命练习。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446087,
          "spk": "裕太 (ユータ)",
          "ja": "俺は、師匠を超えたぞ！",
          "tc": "我終於超越師父了！",
          "sc": "我终于超越师父了！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7744,
      "rec_id": "TALK_ID_70_2130_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446112,
          "spk": "堇怜 (スミレ)",
          "ja": "へぇ、その程度の実力で",
          "tc": "是嗎～",
          "sc": "是吗～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446119,
          "spk": "堇怜 (スミレ)",
          "ja": "僕に勝負を挑もうっていうんだ？",
          "tc": "就憑這點實力也想贏過我？",
          "sc": "就凭这点实力也想赢过我？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446132,
          "spk": "裕太 (ユータ)",
          "ja": "なら、どっちが水切りチャンピオンか",
          "tc": "既然如此，究竟誰才是打水漂冠軍，",
          "sc": "既然如此，究竟谁才是打水漂冠军，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446139,
          "spk": "裕太 (ユータ)",
          "ja": "勝負で決めようじゃないか！",
          "tc": "就用比賽分個高下吧！",
          "sc": "就用比赛分个高下吧！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446159,
          "spk": "堇怜 (スミレ)",
          "ja": "望むところだよ",
          "tc": "正合我意。",
          "sc": "正合我意。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7745,
      "rec_id": "TALK_ID_70_2130_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446177,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446184,
          "spk": "堇怜 (スミレ)",
          "ja": "僕が勝つところを見ててね",
          "tc": "要好好看著我贏喔。",
          "sc": "要好好看着我赢哦。"
        }
      ]
    },
    {
