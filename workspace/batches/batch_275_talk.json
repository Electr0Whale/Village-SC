    {
      "file": "talk.dat",
      "rec_idx": 7748,
      "rec_id": "TALK_ID_70_2130_005_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446292,
          "spk": "堇怜 (スミレ)",
          "ja": "ちょっと前まで",
          "tc": "直到不久之前，",
          "sc": "直到不久之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446299,
          "spk": "堇怜 (スミレ)",
          "ja": "こんな遊び、お金がないから",
          "tc": "我還覺得都是因為很窮，",
          "sc": "我还觉得都是因为很穷，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446306,
          "spk": "堇怜 (スミレ)",
          "ja": "これしかできないと思ってた",
          "tc": "所以只能玩這種遊戲。",
          "sc": "所以只能玩这种游戏。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446317,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、お金がなくても",
          "tc": "不過即使沒有錢",
          "sc": "不过即使没有钱"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446324,
          "spk": "堇怜 (スミレ)",
          "ja": "楽しいことはあるんだって",
          "tc": "也還是有開心的事，",
          "sc": "也还是有开心的事，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446331,
          "spk": "堇怜 (スミレ)",
          "ja": "最近気づいたんだ",
          "tc": "我最近終於察覺到這點了。",
          "sc": "我最近终于察觉到这点了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7749,
      "rec_id": "TALK_ID_70_2130_005_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446349,
          "spk": "堇怜 (スミレ)",
          "ja": "今度、水切り以外の遊びも",
          "tc": "下次我再教你",
          "sc": "下次我再教你"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446356,
          "spk": "堇怜 (スミレ)",
          "ja": "教えてあげますね",
          "tc": "打水漂以外遊戲吧。",
          "sc": "打水漂以外游戏吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446378,
          "spk": "裕太 (ユータ)",
          "ja": "それは楽しみだ！",
          "tc": "那真是令人期待！",
          "sc": "那真是令人期待！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7750,
      "rec_id": "TALK_ID_70_2130_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446396,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>にも教えるから",
          "tc": "<player>也可以一起來，",
          "sc": "<player>也可以一起来，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446403,
          "spk": "堇怜 (スミレ)",
          "ja": "楽しみにしててよ！",
          "tc": "要好好期待喔！",
          "sc": "要好好期待哦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7751,
      "rec_id": "TALK_ID_70_2130_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446429,
          "spk": "堇怜 (スミレ)",
          "ja": "やあ、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446436,
          "spk": "堇怜 (スミレ)",
          "ja": "また釣りをしにきたの？",
          "tc": "你又來釣魚了嗎？",
          "sc": "你又来钓鱼了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7752,
      "rec_id": "TALK_ID_70_2130_006_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446454,
          "spk": "堇怜 (スミレ)",
          "ja": "ほら、隣においで",
          "tc": "來，到我旁邊來吧。",
          "sc": "来，到我旁边来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7753,
      "rec_id": "TALK_ID_70_2130_006_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446478,
          "spk": "堇怜 (スミレ)",
          "ja": "……僕さ、<player>と出会って",
          "tc": "……我啊，自從遇見<player>，",
          "sc": "……我啊，自从遇见<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446485,
          "spk": "堇怜 (スミレ)",
          "ja": "いろんなことが変わったよ",
          "tc": "有很多事都改變了。",
          "sc": "有很多事都改变了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446496,
          "spk": "堇怜 (スミレ)",
          "ja": "前までは現状への",
          "tc": "之前的我滿腦子都是",
          "sc": "之前的我满脑子都是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446503,
          "spk": "堇怜 (スミレ)",
          "ja": "不満ばっかり考えてたけど",
          "tc": "對於現狀的不滿，",
          "sc": "对于现状的不满，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446510,
          "spk": "堇怜 (スミレ)",
          "ja": "前向きに考えられるようになってきた",
          "tc": "現在漸漸變得能樂觀面對了。",
          "sc": "现在渐渐变得能乐观面对了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446521,
          "spk": "堇怜 (スミレ)",
          "ja": "今までが最悪だとしたら、",
          "tc": "如果之前算是糟到不能再糟了，",
          "sc": "如果之前算是糟到不能再糟了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446528,
          "spk": "堇怜 (スミレ)",
          "ja": "これからはいろんなことが",
          "tc": "那今後想必很多事情",
          "sc": "那今后想必很多事情"
        },
        {
          "f_idx": 7,
          "pidx_tc": 446535,
          "spk": "堇怜 (スミレ)",
          "ja": "よくなっていくばっかりだと思う",
          "tc": "都只會往好的方向發展吧。",
          "sc": "都只会往好的方向发展吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 446546,
          "spk": "堇怜 (スミレ)",
          "ja": "もう言ったっけ？",
          "tc": "我有和你說過嗎？",
          "sc": "我有和你说过吗？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 446553,
          "spk": "堇怜 (スミレ)",
          "ja": "僕、医大を目指すつもりなんだ",
          "tc": "我打算要考醫大。",
          "sc": "我打算要考医大。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7754,
      "rec_id": "TALK_ID_70_2130_006_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 446571,
          "spk": "堇怜 (スミレ)",
          "ja": "あはは、意外かな？",
          "tc": "啊哈哈，很意外嗎？",
          "sc": "啊哈哈，很意外吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 446582,
          "spk": "堇怜 (スミレ)",
          "ja": "医者になったら",
          "tc": "只要成為醫生，",
          "sc": "只要成为医生，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 446589,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんの仕事を手伝えるでしょ",
          "tc": "就能幫忙姊姊處理工作了。",
          "sc": "就能帮忙姐姐处理工作了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 446600,
          "spk": "堇怜 (スミレ)",
          "ja": "そうやって姉さんを",
          "tc": "如果能藉此扶持姊姊就好了，",
          "sc": "如果能借此扶持姐姐就好了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 446607,
          "spk": "堇怜 (スミレ)",
          "ja": "支えられたらいいなと思ったんだ",
          "tc": "我是這麼想的。",
          "sc": "我是这么想的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 446618,
          "spk": "堇怜 (スミレ)",
          "ja": "村のみんなのことも、",
          "tc": "還有村子裡的大家也是，",
          "sc": "还有村子里的大家也是，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 446625,
          "spk": "堇怜 (スミレ)",
          "ja": "僕なりに支えられたらいいなって思う",
          "tc": "我希望可以盡自己的所能幫上忙。",
          "sc": "我希望可以尽自己的所能帮上忙。"
        }
      ]
    },
    {
