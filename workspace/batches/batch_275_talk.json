          "pidx_tc": 390536,
          "spk": "琪娜娜 (チナナ)",
          "ja": "わけじゃあないんだよ",
          "tc": "事情要做。",
          "sc": "事情要做。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 390547,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチには、ハスミの酒に付き合うって",
          "tc": "我還有重大使命在身，",
          "sc": "我还有重大使命在身，"
        },
        {
