      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390718,
          "spk": "今野 (コンノ)",
          "ja": "これは……！",
          "tc": "這是……！",
          "sc": "这是……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390725,
          "spk": "今野 (コンノ)",
          "ja": "チナナさんが言っていた",
          "tc": "這是琪娜娜小姐之前提到過的，",
          "sc": "这是琪娜娜小姐之前提到过的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390732,
          "spk": "今野 (コンノ)",
          "ja": "世界に十本しかない腕時計ですよネ？",
