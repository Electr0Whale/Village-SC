          "tc": "……其實，",
          "sc": "……其实，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 440827,
          "spk": "裕太 (ユータ)",
          "ja": "わかってたんだ",
          "tc": "我都知道的。",
          "sc": "我都知道的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 440836,
          "spk": "裕太 (ユータ)",
          "ja": "先輩は、大学の先輩じゃなくて",
          "tc": "學長他根本就不是我的大學學長，",
          "sc": "学长他根本就不是我的大学学长，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 440843,
          "spk": "裕太 (ユータ)",
          "ja": "ただの通りすがりの人で……",
          "tc": "他只不過是剛好路過罷了……",
          "sc": "他只不过是刚好路过罢了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 440854,
          "spk": "裕太 (ユータ)",
          "ja": "駅のホームでふらふらしてた俺を心配して",
          "tc": "他是看我在月台上搖搖晃晃的，很擔心，",
          "sc": "他是看我在月台上摇摇晃晃的，很担心，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 440861,
          "spk": "裕太 (ユータ)",
          "ja": "とっさに嘘をついてくれたってこと",
          "tc": "所以在情急之下就撒了謊。",
          "sc": "所以在情急之下就撒了谎。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 440877,
          "spk": "裕太 (ユータ)",
          "ja": "死ぬまでにやりたいことリストだって",
          "tc": "「死前願望清單」這種東西，",
          "sc": "“死前愿望清单”这种东西，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 440884,
          "spk": "裕太 (ユータ)",
          "ja": "俺があそこで死ななくてもいいように",
          "tc": "也是學長為了不讓我死在那裡，",
          "sc": "也是学长为了不让我死在那里，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 440891,
          "spk": "裕太 (ユータ)",
          "ja": "先輩がとっさに考えてくれたことなんだ",
          "tc": "情急之下想出來的東西。",
          "sc": "情急之下想出来的东西。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 440902,
          "spk": "裕太 (ユータ)",
          "ja": "……俺は先輩の嘘に甘えて",
          "tc": "……而我則是接受了學長的謊言，",
          "sc": "……而我则是接受了学长的谎言，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 440909,
          "spk": "裕太 (ユータ)",
          "ja": "生まれ変わることにしたんだよ",
          "tc": "選擇重新再活一次。",
          "sc": "选择重新再活一次。"
        }
      ]
