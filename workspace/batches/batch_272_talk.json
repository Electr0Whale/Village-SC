    {
      "file": "talk.dat",
      "rec_idx": 7654,
      "rec_id": "TALK_ID_70_2120_005_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439432,
          "spk": "裕太 (ユータ)",
          "ja": "わわ……",
          "tc": "哇……",
          "sc": "哇……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439439,
          "spk": "裕太 (ユータ)",
          "ja": "あわわわ……",
          "tc": "嗚哇……",
          "sc": "呜哇……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439450,
          "spk": "名护 (ナゴ)",
          "ja": "な、何が",
          "tc": "這、這是",
          "sc": "这、这是"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439457,
          "spk": "名护 (ナゴ)",
          "ja": "起こったんだ……？",
          "tc": "發生了什麼事……？",
          "sc": "发生了什么事……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7655,
      "rec_id": "TALK_ID_70_2120_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439485,
          "spk": "裕太 (ユータ)",
          "ja": "ナゴさん、<player>",
          "tc": "名護先生、<player>，",
          "sc": "名护先生、<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439492,
          "spk": "裕太 (ユータ)",
          "ja": "片付けを手伝ってくれて",
          "tc": "謝謝你們",
          "sc": "谢谢你们"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439499,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439512,
          "spk": "名护 (ナゴ)",
          "ja": "それはいいんだが",
          "tc": "這沒什麼，",
          "sc": "这没什么，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439519,
          "spk": "名护 (ナゴ)",
          "ja": "一体何が起こったんだ？",
          "tc": "但這裡到底是發生了什麼事？",
          "sc": "但这里到底是发生了什么事？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439530,
          "spk": "名护 (ナゴ)",
          "ja": "俺の認識では",
          "tc": "依我的理解，",
          "sc": "依我的理解，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439537,
          "spk": "名护 (ナゴ)",
          "ja": "この家に入った途端",
          "tc": "是在我踏入這間房子的瞬間，",
          "sc": "是在我踏入这间房子的瞬间，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439544,
          "spk": "名护 (ナゴ)",
          "ja": "何かが破裂したんだが……",
          "tc": "有什麼東西爆掉了……",
          "sc": "有什么东西爆掉了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439557,
          "spk": "裕太 (ユータ)",
          "ja": "味噌が爆発したんだ",
          "tc": "是味噌爆炸了。",
          "sc": "是味噌爆炸了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7656,
      "rec_id": "TALK_ID_70_2120_005_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439575,
          "spk": "名护 (ナゴ)",
          "ja": "味噌が……",
          "tc": "味噌……",
          "sc": "味噌……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439582,
          "spk": "名护 (ナゴ)",
          "ja": "爆発……？",
          "tc": "爆炸了……？",
          "sc": "爆炸了……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439593,
          "spk": "名护 (ナゴ)",
          "ja": "いや、味噌は",
          "tc": "不，",
          "sc": "不，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439600,
          "spk": "名护 (ナゴ)",
          "ja": "爆発しないだろう",
          "tc": "味噌怎麼可能會爆炸。",
          "sc": "味噌怎么可能会爆炸。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439613,
          "spk": "裕太 (ユータ)",
          "ja": "前に、チナナさんから",
          "tc": "我之前曾經問過琪娜娜",
          "sc": "我之前曾经问过琪娜娜"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439620,
          "spk": "裕太 (ユータ)",
          "ja": "味噌の作り方を聞いたんだよね",
          "tc": "製作味噌的方法。",
          "sc": "制作味噌的方法。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439629,
          "spk": "裕太 (ユータ)",
          "ja": "だからチャックで密閉できる",
          "tc": "所以我就把味噌",
          "sc": "所以我就把味噌"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439636,
          "spk": "裕太 (ユータ)",
          "ja": "袋に味噌を仕込んで",
          "tc": "用夾鏈袋密封起來，",
          "sc": "用夹链袋密封起来，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439643,
          "spk": "裕太 (ユータ)",
          "ja": "部屋の隅に置いといたんだけど",
          "tc": "然後放在了房間角落。",
          "sc": "然后放在了房间角落。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439654,
          "spk": "裕太 (ユータ)",
          "ja": "ここ最近、ちょっとずつ",
          "tc": "結果最近，",
          "sc": "结果最近，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439661,
          "spk": "裕太 (ユータ)",
          "ja": "袋がパンパンになっていってね",
          "tc": "那個袋子就漸漸鼓了起來。",
          "sc": "那个袋子就渐渐鼓了起来。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 439672,
          "spk": "裕太 (ユータ)",
          "ja": "味噌って膨らむんだなって",
          "tc": "我就想說原來味噌還會膨脹啊，",
          "sc": "我就想说原来味噌还会膨胀啊，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 439679,
          "spk": "裕太 (ユータ)",
          "ja": "思ってそのまま置いておいたら",
          "tc": "就這樣一直放在那裡，",
          "sc": "就这样一直放在那里，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 439686,
          "spk": "裕太 (ユータ)",
          "ja": "さっき急に爆発した",
          "tc": "結果剛剛就突然爆炸了。",
          "sc": "结果刚刚就突然爆炸了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 439699,
          "spk": "名护 (ナゴ)",
          "ja": "なんで放置するんだ！",
          "tc": "你為什麼要放著不管啊！？",
          "sc": "你为什么要放着不管啊！？"
        },
        {
          "f_idx": 15,
          "pidx_tc": 439706,
          "spk": "名护 (ナゴ)",
          "ja": "発酵が進んでガスが",
          "tc": "它不是都因為發酵",
          "sc": "它不是都因为发酵"
        },
        {
          "f_idx": 16,
          "pidx_tc": 439713,
          "spk": "名护 (ナゴ)",
          "ja": "出てたんだろう！？",
          "tc": "而產生氣體了嗎！？",
          "sc": "而产生气体了吗！？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 439726,
          "spk": "裕太 (ユータ)",
          "ja": "だって……まさか",
          "tc": "因為……",
          "sc": "因为……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 439733,
          "spk": "裕太 (ユータ)",
          "ja": "爆発するなんて……",
          "tc": "誰知道它會爆炸嘛……",
          "sc": "谁知道它会爆炸嘛……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7657,
      "rec_id": "TALK_ID_70_2120_005_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439751,
          "spk": "裕太 (ユータ)",
          "ja": "ああ、うん",
          "tc": "啊、嗯，",
          "sc": "啊、嗯，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439758,
          "spk": "裕太 (ユータ)",
          "ja": "怪我はないよ",
          "tc": "我沒有受傷喔，",
          "sc": "我没有受伤哦，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439765,
          "spk": "裕太 (ユータ)",
          "ja": "ナゴさんは？",
          "tc": "名護先生呢？",
          "sc": "名护先生呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7658,
      "rec_id": "TALK_ID_70_2120_005_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439783,
          "spk": "名护 (ナゴ)",
          "ja": "まあ……服に味噌がついたぐらいだ",
          "tc": "我沒事……只是衣服沾到了味噌而已。",
          "sc": "我没事……只是衣服沾到了味噌而已。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439801,
          "spk": "名护 (ナゴ)",
          "ja": "しかし、こんなことになるなら",
          "tc": "但如果早知道事情會變成這樣，",
          "sc": "但如果早知道事情会变成这样，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439808,
          "spk": "名护 (ナゴ)",
          "ja": "今日も断ればよかったな……",
          "tc": "我今天就不該過來了……",
          "sc": "我今天就不该过来了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439828,
          "spk": "裕太 (ユータ)",
          "ja": "そんなこと言わないでよー！",
          "tc": "不要這麼說嘛～！",
          "sc": "不要这么说嘛～！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 439837,
          "spk": "裕太 (ユータ)",
          "ja": "俺、村暮らしの先輩として",
          "tc": "身為住在村子裡的前輩，",
          "sc": "身为住在村子里的前辈，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 439844,
          "spk": "裕太 (ユータ)",
          "ja": "ナゴさんにレクチャーできることが",
          "tc": "我還有很多東西",
          "sc": "我还有很多东西"
        },
        {
          "f_idx": 8,
          "pidx_tc": 439851,
          "spk": "裕太 (ユータ)",
          "ja": "たくさんあると思ってるんだから！",
          "tc": "可以教名護先生耶！",
          "sc": "可以教名护先生呢！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 439862,
          "spk": "裕太 (ユータ)",
          "ja": "ナゴさんていつも",
          "tc": "名護先生",
          "sc": "名护先生"
        },
        {
          "f_idx": 10,
          "pidx_tc": 439869,
          "spk": "裕太 (ユータ)",
          "ja": "忙しそうだったからさ",
          "tc": "平常看起來都很忙的樣子，",
          "sc": "平常看起来都很忙的样子，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 439876,
          "spk": "裕太 (ユータ)",
          "ja": "今日は来てくれて嬉しいよ",
          "tc": "所以我很開心你今天能過來喔。",
          "sc": "所以我很开心你今天能过来哦。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 439889,
          "spk": "名护 (ナゴ)",
          "ja": "何度も誘いを断って",
          "tc": "都拒絕你那麼多次了，",
          "sc": "都拒绝你那么多次了，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 439896,
          "spk": "名护 (ナゴ)",
          "ja": "悪いとは思っていたよ",
          "tc": "我也覺得有點不好意思。",
          "sc": "我也觉得有点不好意思。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 439907,
          "spk": "名护 (ナゴ)",
          "ja": "だが、味噌を爆発させるキミから",
          "tc": "但看來我從你身上好像也學不到什麼，",
          "sc": "但看来我从你身上好像也学不到什么，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 439914,
          "spk": "名护 (ナゴ)",
          "ja": "教わることはあまりなさそうだ",
          "tc": "畢竟你都能把味噌弄爆炸了。",
          "sc": "毕竟你都能把味噌弄爆炸了。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 439934,
          "spk": "裕太 (ユータ)",
          "ja": "うっ",
          "tc": "唔，",
          "sc": "唔，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 439941,
          "spk": "裕太 (ユータ)",
          "ja": "痛いところを",
          "tc": "這還真是戳到",
          "sc": "这还真是戳到"
        },
        {
          "f_idx": 19,
          "pidx_tc": 439948,
          "spk": "裕太 (ユータ)",
          "ja": "突くね……",
          "tc": "我的痛點了……",
          "sc": "我的痛点了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7659,
      "rec_id": "TALK_ID_70_2120_005_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439974,
