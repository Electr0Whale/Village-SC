    {
      "file": "talk.dat",
      "rec_idx": 7663,
      "rec_id": "TALK_ID_70_2120_005_12",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 440067,
          "spk": "裕太 (ユータ)",
          "ja": "あっ、ナゴさんまで！",
          "tc": "啊，怎麼連名護先生也這樣！",
          "sc": "啊，怎么连名护先生也这样！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 440080,
          "spk": "名护 (ナゴ)",
          "ja": "……うん",
          "tc": "……嗯。",
          "sc": "……嗯。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 440087,
          "spk": "名护 (ナゴ)",
          "ja": "なかなかいい味だ",
          "tc": "味道不錯，",
          "sc": "味道不错，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 440094,
          "spk": "名护 (ナゴ)",
          "ja": "美味くできてる",
          "tc": "做得很好吃。",
          "sc": "做得很好吃。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 440107,
          "spk": "裕太 (ユータ)",
          "ja": "本当に？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
