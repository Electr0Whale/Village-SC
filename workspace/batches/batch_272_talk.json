      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 439333,
          "spk": "裕太 (ユータ)",
          "ja": "ありがとう",
          "tc": "謝謝你。",
          "sc": "谢谢你。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 439344,
          "spk": "裕太 (ユータ)",
          "ja": "キミが応援してくれてると",
          "tc": "只要一想到有你幫我加油，",
          "sc": "只要一想到有你帮我加油，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 439351,
          "spk": "裕太 (ユータ)",
          "ja": "思うと力が湧いてくるよ",
          "tc": "我心底就會湧出一股力量。",
          "sc": "我心底就会涌出一股力量。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 439360,
          "spk": "裕太 (ユータ)",
          "ja": "弾いてほしい曲が",
          "tc": "如果你有什麼想聽的曲子，",
          "sc": "如果你有什么想听的曲子，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 439367,
          "spk": "裕太 (ユータ)",
          "ja": "あったら言ってね",
          "tc": "記得告訴我喔。",
          "sc": "记得告诉我哦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 439374,
          "spk": "裕太 (ユータ)",
          "ja": "リクエストには応えるよ",
          "tc": "我會接受點歌的。",
          "sc": "我会接受点歌的。"
        }
      ]
    },
