          "f_idx": 1,
          "pidx_tc": 209522,
          "spk": "木助 (キスケ)",
          "ja": "だが二度目はねえぞ、",
          "tc": "但沒有下次了。",
          "sc": "但没有下次了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209529,
          "spk": "木助 (キスケ)",
          "ja": "次、勝手しやがったらぶん殴ってやるからな",
          "tc": "要是再給我逮到，我會狠狠揍你一頓。",
          "sc": "要是再给我逮到，我会狠狠揍你一顿。"
        },
        {
