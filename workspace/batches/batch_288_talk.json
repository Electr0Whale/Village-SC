  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 8236,
      "rec_id": "TALK_ID_10_0500_003_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 291299,
          "spk": "今野 (コンノ)",
          "ja": "ふぅん……",
          "tc": "哦……",
          "sc": "哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 291310,
          "spk": "今野 (コンノ)",
          "ja": "ハァ……そもそも神器の件も、",
          "tc": "唉……再說關於神器的事，",
          "sc": "唉……再说关于神器的事，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 291317,
          "spk": "今野 (コンノ)",
          "ja": "どこから聞いてきたのやら……",
          "tc": "也不曉得您是從哪聽來的……",
          "sc": "也不晓得您是从哪听来的……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 291324,
          "spk": "今野 (コンノ)",
          "ja": "また盗み聞きですかねェ",
          "tc": "難道也是偷聽到的嗎？",
          "sc": "难道也是偷听到的吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8237,
      "rec_id": "TALK_ID_10_0500_005_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292289,
          "spk": "木助 (キスケ)",
          "ja": "聞き分けが良くて、助かるぜ",
          "tc": "你這麼懂事真是太好了。",
          "sc": "你这么懂事真是太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 292300,
          "spk": "木助 (キスケ)",
          "ja": "残念だが、これはてめぇのために",
          "tc": "雖然可惜，",
          "sc": "虽然可惜，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292307,
          "spk": "木助 (キスケ)",
          "ja": "言ってることだから",
          "tc": "但我說這些是為了你好。",
          "sc": "但我说这些是为了你好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 292314,
          "spk": "木助 (キスケ)",
          "ja": "俺を恨んでくれるなよ",
          "tc": "可別恨我喔！",
          "sc": "可别恨我啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8238,
      "rec_id": "TALK_ID_10_0500_005_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 292332,
          "spk": "木助 (キスケ)",
          "ja": "……俺は忠告したからな",
          "tc": "……我可是給過你忠告了。",
          "sc": "……我可是给过你忠告了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 292341,
          "spk": "木助 (キスケ)",
          "ja": "走り回るのは勝手だが、",
          "tc": "要到處跑是你的自由，",
          "sc": "要到处跑是你的自由，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 292348,
          "spk": "木助 (キスケ)",
          "ja": "最初から無駄だとわかっているコトを",
          "tc": "但你應該曉得吧？",
          "sc": "但你应该晓得吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 292355,
          "spk": "木助 (キスケ)",
          "ja": "やろうとしていることはわかるだろ",
          "tc": "你想做的事從一開始就是在白費功夫。",
          "sc": "你想做的事从一开始就是在白费功夫。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 292366,
          "spk": "木助 (キスケ)",
          "ja": "きっと馬鹿を見ることになるぞ",
          "tc": "之後一定會吃苦頭的。",
          "sc": "之后一定会吃苦头的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8239,
      "rec_id": "TALK_ID_10_0500_020_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293665,
          "spk": "木助 (キスケ)",
          "ja": "そうか、よかった",
          "tc": "是嗎，太好了。",
          "sc": "是吗，太好了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293672,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ、荷物をまとめ始めてくれ",
          "tc": "那你就開始收拾行李吧。",
          "sc": "那你就开始收拾行李吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 293683,
          "spk": "木助 (キスケ)",
          "ja": "きっと麓の街で、",
          "tc": "山腳下的市區，",
          "sc": "山脚下的市区，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 293690,
          "spk": "木助 (キスケ)",
          "ja": "てめぇを保護してくれる奴がいるはずさ",
          "tc": "一定會有人願意收留你的。",
          "sc": "一定会有人愿意收留你的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 293699,
          "spk": "木助 (キスケ)",
          "ja": "村を下る時に、",
          "tc": "離開村子的時候，",
          "sc": "离开村子的时候，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 293706,
          "spk": "木助 (キスケ)",
          "ja": "良い言い訳を考えておけよ",
          "tc": "先想個好理由吧。",
          "sc": "先想个好理由吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 293713,
          "spk": "木助 (キスケ)",
          "ja": "また迷子だの、なにも覚えていねぇだのってな",
          "tc": "像是又迷路，或者什麼都不記得之類的。",
          "sc": "像是又迷路，或者什么都不记得之类的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8240,
      "rec_id": "TALK_ID_10_0500_020_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 293731,
          "spk": "木助 (キスケ)",
          "ja": "……そうか、残念だぜ",
          "tc": "……是嗎，真遺憾。",
          "sc": "……是吗，真遗憾。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 293738,
          "spk": "木助 (キスケ)",
          "ja": "じゃあ、行くところまで行っちまうな",
          "tc": "所以你是不見棺材不掉淚吧。",
          "sc": "所以你是不见棺材不掉泪吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8241,
      "rec_id": "TALK_ID_10_0500_032_00_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296506,
          "spk": "主角心声/旁白/选项",
          "ja": "今こっちには用はない……",
          "tc": "現在不需要去這裡……",
          "sc": "现在不需要去这里……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8242,
      "rec_id": "TALK_ID_10_0500_032_05_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296841,
          "spk": "帷 (トバリ)",
          "ja": "そう……そうだよね",
          "tc": "這樣啊……說得也是呢。",
          "sc": "这样啊……说得也是呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296848,
          "spk": "帷 (トバリ)",
          "ja": "ごめんなさい……",
          "tc": "對不起……",
          "sc": "对不起……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 296855,
          "spk": "帷 (トバリ)",
          "ja": "私が言い出したのに弱気になってしまって……",
          "tc": "明明是我提議的，現在卻害怕了起來……",
          "sc": "明明是我提议的，现在却害怕了起来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 296866,
          "spk": "帷 (トバリ)",
          "ja": "行こう、<player>",
          "tc": "走吧，<player>。",
          "sc": "走吧，<player>。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 296873,
          "spk": "帷 (トバリ)",
          "ja": "コダマに会わないと",
          "tc": "得去見木珠才行。",
          "sc": "得去见木珠才行。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 296880,
          "spk": "帷 (トバリ)",
          "ja": "土地神を倒すためにも……",
          "tc": "為了打倒土地神……",
          "sc": "为了打倒土地神……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 296889,
          "spk": "帷 (トバリ)",
          "ja": "扉、開けるね",
          "tc": "我要開門囉。",
          "sc": "我要开门喽。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8243,
      "rec_id": "TALK_ID_10_0500_032_05_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 296911,
          "spk": "帷 (トバリ)",
          "ja": "そう……アンタもなのね",
          "tc": "是嗎……你跟我一樣呢。",
          "sc": "是吗……你跟我一样呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 296922,
          "spk": "帷 (トバリ)",
          "ja": "いいよ、待ってる",
          "tc": "沒關係，我會等你。",
          "sc": "没关系，我会等你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 296929,
          "spk": "帷 (トバリ)",
          "ja": "アンタの覚悟が決まるまで",
          "tc": "等你下定決心。",
          "sc": "等你下定决心。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 296940,
          "spk": "帷 (トバリ)",
          "ja": "行く気になったら、私に声をかけて",
          "tc": "你想去的時候，再跟我說一聲。",
          "sc": "你想去的时候，再跟我说一声。"
        }
      ]
    },
