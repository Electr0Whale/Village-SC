          "pidx_tc": 209490,
          "spk": "木助 (キスケ)",
          "ja": "てめぇは仕事だろうが",
          "tc": "妳那是在工作，",
          "sc": "你那是在工作，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 209497,
          "spk": "木助 (キスケ)",
          "ja": "俺はコイツに怒ってんだ",
          "tc": "我是在罵這傢伙。",
          "sc": "我是在骂这家伙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8487,
      "rec_id": "TALK_ID_10_0102_030_03_02_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209515,
          "spk": "木助 (キスケ)",
          "ja": "今回は大目に見てやる",
          "tc": "這次我就睜一隻眼閉一隻眼，",
          "sc": "这次我就睁一只眼闭一只眼，"
