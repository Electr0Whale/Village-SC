    {
      "file": "talk.dat",
      "rec_idx": 8470,
      "rec_id": "TALK_ID_10_0101_021_14_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 204366,
          "spk": "木助 (キスケ)",
          "ja": "いいんだよ",
          "tc": "沒事的。",
          "sc": "没事的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 204373,
          "spk": "木助 (キスケ)",
          "ja": "ほら、<player>、",
          "tc": "好了，<player>，",
          "sc": "好了，<player>，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 204380,
          "spk": "木助 (キスケ)",
          "ja": "早く背を向けて目と耳を塞げ",
          "tc": "快轉過身去，閉上眼睛、塞住耳朵。",
          "sc": "快转过身去，闭上眼睛、塞住耳朵。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8471,
      "rec_id": "TALK_ID_10_0102_030_01_02_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 205163,
          "spk": "裕太 (ユータ)",
          "ja": "それはちょうどよかった！",
          "tc": "那真是太剛好了！",
          "sc": "那真是太刚好了！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 205170,
          "spk": "裕太 (ユータ)",
          "ja": "お店が開いてなくて、",
          "tc": "看妳沒開店，",
          "sc": "看你没开店，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 205177,
          "spk": "裕太 (ユータ)",
          "ja": "困ってたところだったから",
          "tc": "我正煩惱著。",
          "sc": "我正烦恼着。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 205190,
          "spk": "茶梅 (サザンカ)",
          "ja": "ユータ……今日は定休日だよ……",
          "tc": "裕太……今天可是公休日欸……",
          "sc": "裕太……今天可是休息日诶……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 205197,
          "spk": "茶梅 (サザンカ)",
          "ja": "いい加減覚えなって",
          "tc": "你好歹也該記住了吧。",
          "sc": "你好歹也该记住了吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 205210,
          "spk": "裕太 (ユータ)",
          "ja": "……あ、そうか、今日は金曜日だったね",
          "tc": "……啊，對欸，今天是星期五。",
          "sc": "……啊，对诶，今天是星期五。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 205217,
          "spk": "裕太 (ユータ)",
          "ja": "この村に来てから、毎日休日みたいなものだから",
          "tc": "自從來到這個村子，感覺每天都像假日。",
          "sc": "自从来到这个村子，感觉每天都像假日。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 205224,
          "spk": "裕太 (ユータ)",
          "ja": "曜日感覚が狂っちゃって……",
          "tc": "都分不清是星期幾了……",
          "sc": "都分不清是星期几了……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 205237,
          "spk": "茶梅 (サザンカ)",
          "ja": "全く、しゃーないね",
          "tc": "真是拿你沒辦法。",
          "sc": "真是拿你没办法。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 205244,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタもついでに、買い物してっていいよ",
          "tc": "你也可以一起買東西喔。",
          "sc": "你也可以一起买东西哦。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 205251,
          "spk": "茶梅 (サザンカ)",
          "ja": "<player>に感謝してよね",
          "tc": "好好感謝<player>吧。",
          "sc": "好好感谢<player>吧。"
        }
      ]
    },
