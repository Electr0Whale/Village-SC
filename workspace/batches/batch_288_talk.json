          "spk": "驹子 (コマコ)",
          "ja": "待っててくれるとうれしいな",
          "tc": "順便等我一下吧。",
          "sc": "顺便等我一下吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 209330,
          "spk": "驹子 (コマコ)",
          "ja": "……あ、でも",
          "tc": "……啊，不過，",
          "sc": "……啊，不过，"
