        {
          "f_idx": 2,
          "pidx_tc": 392625,
          "spk": "琪娜娜 (チナナ)",
          "ja": "食べるとおいしいんだよねえ",
          "tc": "吃起來特別好吃呢。",
          "sc": "吃起来特别好吃呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392636,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃ、<player>は目玉焼きで",
          "tc": "那<player>你吃荷包蛋，",
          "sc": "那<player>你吃荷包蛋，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392643,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは味付き玉子だ",
          "tc": "我就吃醬油溏心蛋囉。",
          "sc": "我就吃卤蛋啦。"
        }
      ]
    },
    {
