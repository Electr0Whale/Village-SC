      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422001,
          "spk": "莲实 (ハスミ)",
          "ja": "よかった……",
          "tc": "太好了……",
          "sc": "太好了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422008,
          "spk": "莲实 (ハスミ)",
          "ja": "そう言ってもらえて",
          "tc": "很高興聽到你這麼說，",
          "sc": "很高兴听到你这么说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422019,
          "spk": "莲实 (ハスミ)",
          "ja": "ありがとうございます、<player>さん",
          "tc": "謝謝你，<player>。",
          "sc": "谢谢你，<player>。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422026,
          "spk": "莲实 (ハスミ)",
          "ja": "おかげで少し、自信がつきました",
          "tc": "多虧了你，我比較有自信了。",
          "sc": "多亏了你，我比较有自信了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8451,
      "rec_id": "TALK_ID_70_2140_009_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422044,
          "spk": "莲实 (ハスミ)",
          "ja": "……まだまだ改善の余地が",
          "tc": "看來……",
          "sc": "看来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422051,
          "spk": "莲实 (ハスミ)",
          "ja": "ありそうですね",
          "tc": "還有改善的空間呢。",
          "sc": "还有改善的空间呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422062,
          "spk": "莲实 (ハスミ)",
          "ja": "この程度で諦めません",
          "tc": "我不會這樣就放棄的。",
          "sc": "我不会这样就放弃的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422069,
          "spk": "莲实 (ハスミ)",
          "ja": "次こそは、納得のいく",
          "tc": "下次一定會做出",
          "sc": "下次一定会做出"
        },
        {
          "f_idx": 4,
          "pidx_tc": 422076,
          "spk": "莲实 (ハスミ)",
          "ja": "クオリティに仕上げますから",
          "tc": "令人滿意的成果。",
          "sc": "令人满意的成果。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8452,
      "rec_id": "TALK_ID_70_2140_010_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422762,
          "spk": "莲实 (ハスミ)",
          "ja": "……誰にだって",
          "tc": "……無論是誰，",
          "sc": "……无论是谁，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422769,
          "spk": "莲实 (ハスミ)",
          "ja": "秘密の一つくらい、ありますよね",
          "tc": "都有祕密呢。",
          "sc": "都有秘密呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422778,
          "spk": "莲实 (ハスミ)",
          "ja": "<player>さんも",
          "tc": "<player>也有",
          "sc": "<player>也有"
        },
        {
          "f_idx": 3,
          "pidx_tc": 422785,
          "spk": "莲实 (ハスミ)",
          "ja": "同じ苦しさを抱えてたんですね……",
          "tc": "相同的痛苦呢……",
          "sc": "相同的痛苦呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8453,
      "rec_id": "TALK_ID_70_2140_010_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 422801,
          "spk": "莲实 (ハスミ)",
          "ja": "誰に対しても素直に",
          "tc": "無論面對誰都能",
          "sc": "无论面对谁都能"
        },
        {
          "f_idx": 1,
          "pidx_tc": 422808,
          "spk": "莲实 (ハスミ)",
          "ja": "自分の気持ちを語れる……",
          "tc": "坦率地表達自己的心情……",
          "sc": "坦率地表达自己的心情……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 422815,
          "spk": "莲实 (ハスミ)",
          "ja": "素晴らしい長所ですね",
          "tc": "這是非常了不起的優點呢。",
          "sc": "这是非常了不起的优点呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8454,
      "rec_id": "TALK_ID_70_2150_001_06_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388460,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうそう、",
          "tc": "這樣就對了，",
          "sc": "这样就对了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388467,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい子だね",
          "tc": "真是個好孩子。",
          "sc": "真是个好孩子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388478,
          "spk": "琪娜娜 (チナナ)",
          "ja": "大人の言うことは",
          "tc": "要乖乖聽",
          "sc": "要乖乖听"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388485,
          "spk": "琪娜娜 (チナナ)",
          "ja": "素直に聞いておくもんだよ",
          "tc": "大人說的話喔。",
          "sc": "大人说的话哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8455,
      "rec_id": "TALK_ID_70_2150_001_06_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 388503,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おお？",
          "tc": "哦？",
          "sc": "哦？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 388510,
          "spk": "琪娜娜 (チナナ)",
          "ja": "威勢がいいねえ",
          "tc": "很嗆嘛，",
          "sc": "很呛嘛，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 388517,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンに怒られちゃうよ？",
          "tc": "小心被林罵喔。",
          "sc": "小心被林骂哦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 388528,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キミ、悪ガキの",
          "tc": "你很有",
          "sc": "你很有"
        },
        {
          "f_idx": 4,
          "pidx_tc": 388535,
          "spk": "琪娜娜 (チナナ)",
          "ja": "素質があるよ",
          "tc": "壞小孩的素質。",
          "sc": "坏小孩的素质。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8456,
      "rec_id": "TALK_ID_70_2150_004_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390356,
          "spk": "琪娜娜 (チナナ)",
          "ja": "探検か、いいねえ",
          "tc": "探險啊？不錯耶。",
          "sc": "探险啊？不错呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390367,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ダラダラして過ごすよりは",
          "tc": "比起整天遊手好閒的，",
          "sc": "比起整天游手好闲的，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390374,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういう楽しいことに",
          "tc": "把時間花在一些好玩的事情上，",
          "sc": "把时间花在一些好玩的事情上，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390381,
          "spk": "琪娜娜 (チナナ)",
          "ja": "時間を使いたいもんだよね",
          "tc": "一定是來得更好嘛。",
          "sc": "一定是来得更好嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8457,
      "rec_id": "TALK_ID_70_2150_004_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 390399,
          "spk": "琪娜娜 (チナナ)",
          "ja": "趣味か……",
          "tc": "興趣喔……",
          "sc": "兴趣哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 390406,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そういえばウチの趣味って",
          "tc": "這麼說起來，",
          "sc": "这么说起来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 390413,
          "spk": "琪娜娜 (チナナ)",
          "ja": "なんだろうな",
          "tc": "我的興趣是什麼呢？",
          "sc": "我的兴趣是什么呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 390424,
          "spk": "琪娜娜 (チナナ)",
          "ja": "うーん……強いて言うなら……",
          "tc": "嗯……硬要說的話……",
          "sc": "嗯……硬要说的话……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 390431,
          "spk": "琪娜娜 (チナナ)",
          "ja": "料理の仕込みかな？",
          "tc": "就是做料理的備料了吧？",
          "sc": "就是做料理的备料了吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8458,
      "rec_id": "TALK_ID_70_2150_007_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392126,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おっ、ウチと一緒だね",
          "tc": "哦，跟我一樣耶，",
          "sc": "哦，跟我一样呢，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392133,
          "spk": "琪娜娜 (チナナ)",
          "ja": "<player>、気が合うじゃないか",
          "tc": "<player>，我們很合得來嘛。",
          "sc": "<player>，我们很合得来嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8459,
      "rec_id": "TALK_ID_70_2150_007_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392151,
          "spk": "琪娜娜 (チナナ)",
          "ja": "おや、じゃあ残ったコレが好物なんだね",
          "tc": "喔？那還沒吃的就是你喜歡的東西囉。",
          "sc": "喔？那还没吃的就是你喜欢的东西啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392158,
          "spk": "琪娜娜 (チナナ)",
          "ja": "しかし、好きなものを最後に残すだなんて、",
          "tc": "不過你把喜歡的東西留到最後，",
          "sc": "不过你把喜欢的东西留到最后，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392165,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチとは真逆だねえ",
          "tc": "跟我完全相反耶。",
          "sc": "跟我完全相反呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8460,
      "rec_id": "TALK_ID_70_2150_008_03_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392561,
          "spk": "琪娜娜 (チナナ)",
          "ja": "味付き玉子、おいしいよねえ",
          "tc": "醬油溏心蛋真的很好吃對吧，",
          "sc": "酱油溏心蛋真的很好吃对吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 392568,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは一晩漬け込んだくらいのが",
          "tc": "我尤其喜歡",
          "sc": "我尤其喜欢"
        },
        {
          "f_idx": 2,
          "pidx_tc": 392575,
          "spk": "琪娜娜 (チナナ)",
          "ja": "特に好きだよ",
          "tc": "泡醬油泡過一整晚的那種。",
          "sc": "泡酱油泡过一整晚的那种。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 392586,
          "spk": "琪娜娜 (チナナ)",
          "ja": "それじゃ、<player>は味付き玉子で",
          "tc": "那<player>你吃醬油溏心蛋，",
          "sc": "那<player>你吃酱油溏心蛋，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 392593,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ウチは目玉焼きだ",
          "tc": "我就吃荷包蛋囉。",
          "sc": "我就吃煎蛋啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8461,
      "rec_id": "TALK_ID_70_2150_008_03_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 392611,
          "spk": "琪娜娜 (チナナ)",
          "ja": "目玉焼きは半熟にしてあるよ",
          "tc": "荷包蛋我是做半熟的喔，",
