    {
      "file": "talk.dat",
      "rec_idx": 8246,
      "rec_id": "TALK_ID_10_0502_203_09_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312557,
          "spk": "名护 (ナゴ)",
          "ja": "いいのか？",
          "tc": "真的嗎？",
          "sc": "真的吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312564,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってもらえるなら、",
          "tc": "如果你願意幫忙，",
          "sc": "如果你愿意帮忙，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312571,
          "spk": "名护 (ナゴ)",
          "ja": "もちろんありがたいが",
          "tc": "我當然很高興。",
          "sc": "我当然很高兴。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 312584,
          "spk": "堇怜 (スミレ)",
          "ja": "じゃあ、<player>にも",
          "tc": "那麼，我也教<player>",
          "sc": "那么，我也教<player>"
        },
        {
          "f_idx": 4,
          "pidx_tc": 312591,
          "spk": "堇怜 (スミレ)",
          "ja": "「提灯」の作り方を教えてあげるよ",
          "tc": "怎麼製作「手提燈籠」吧。",
          "sc": "怎么制作“手提灯笼”吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8247,
      "rec_id": "TALK_ID_10_0502_203_09_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 312611,
          "spk": "堇怜 (スミレ)",
          "ja": "へえ……でもキミ、",
          "tc": "這樣啊……",
          "sc": "这样啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 312618,
          "spk": "堇怜 (スミレ)",
          "ja": "なんだかんだ言って、",
          "tc": "不過你說是這麼說，",
          "sc": "不过你说是这么说，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 312625,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさんについて峠に行くんじゃない？",
          "tc": "之後還是會跟著名護哥到隘口去吧？",
          "sc": "之后还是会跟着名护哥到隘口去吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8248,
      "rec_id": "TALK_ID_10_0502_205_04_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 313493,
          "spk": "名护 (ナゴ)",
          "ja": "わかった",
          "tc": "好吧，",
          "sc": "好吧，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 313500,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってくれてありがとう",
          "tc": "謝謝你幫忙。",
          "sc": "谢谢你帮忙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 313511,
          "spk": "名护 (ナゴ)",
          "ja": "俺はもう少し探索を続けるよ",
          "tc": "我還要再繼續探索一下。",
          "sc": "我还要再继续探索一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 313522,
          "spk": "名护 (ナゴ)",
          "ja": "キミは、気をつけて家まで帰ってくれ",
          "tc": "你回家路上要小心喔！",
          "sc": "你回家路上要小心哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 313529,
          "spk": "名护 (ナゴ)",
          "ja": "夜中には、不気味なことが起きると聞くからね",
          "tc": "我聽說晚上會發生很詭異的事情。",
          "sc": "我听说晚上会发生很诡异的事情。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8249,
      "rec_id": "TALK_ID_10_0502_205_04_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 313558,
          "spk": "名护 (ナゴ)",
          "ja": "そうか……！",
          "tc": "這樣啊……！",
          "sc": "这样啊……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 313565,
          "spk": "名护 (ナゴ)",
          "ja": "せっかく準備してここまで来たんだから、",
          "tc": "好不容易準備好，都走到這裡了，",
          "sc": "好不容易准备好，都走到这里了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 313572,
          "spk": "名护 (ナゴ)",
          "ja": "もう少し探索したいと思っていたんだ",
          "tc": "所以我本來就想說要再探索一下。",
          "sc": "所以我本来就想说要再探索一下。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 313583,
          "spk": "名护 (ナゴ)",
          "ja": "……いや、すまない",
          "tc": "……不，抱歉。",
          "sc": "……不，抱歉。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 313590,
          "spk": "名护 (ナゴ)",
          "ja": "訂正させてくれ……",
          "tc": "讓我修正一下……",
          "sc": "让我修正一下……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 313601,
          "spk": "名护 (ナゴ)",
          "ja": "こ、心細いから",
          "tc": "因、因為我很害怕，",
          "sc": "因、因为我很害怕，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 313608,
          "spk": "名护 (ナゴ)",
          "ja": "手伝ってくれるとありがたいんだ……",
          "tc": "要是你能幫忙就再好不過了……",
          "sc": "要是你能帮忙就再好不过了……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 313615,
          "spk": "名护 (ナゴ)",
          "ja": "悪いけど、頼むよ……",
          "tc": "不好意思，拜託你了……",
          "sc": "不好意思，拜托你了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8250,
      "rec_id": "TALK_ID_10_0502_209_01_01",
      "lines": [
        {
          "f_idx": 0,
