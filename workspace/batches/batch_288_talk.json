          "f_idx": 1,
          "pidx_tc": 209433,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには関係ないモンを触るんじゃねえ",
          "tc": "不要亂碰跟你無關的東西。",
          "sc": "不要乱碰跟你无关的东西。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8485,
      "rec_id": "TALK_ID_10_0102_030_03_02_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209451,
          "spk": "驹子 (コマコ)",
          "ja": "き、キスケさん！　ごめんなさい……！",
          "tc": "木、木助哥！對不起……！",
          "sc": "木、木助哥！对不起……！"
