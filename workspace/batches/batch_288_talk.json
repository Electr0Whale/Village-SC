          "ja": "私が勝手に……",
          "tc": "我擅自……",
          "sc": "我擅自……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 8486,
      "rec_id": "TALK_ID_10_0102_030_03_02_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 209483,
          "spk": "木助 (キスケ)",
          "ja": "ああ？",
          "tc": "講什麼啊？",
          "sc": "讲什么啊？"
        },
