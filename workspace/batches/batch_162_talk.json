  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 3330,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0057",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 178969,
          "spk": "莲实 (ハスミ)",
          "ja": "突然変なことを聞くようですけど、",
          "tc": "雖然這問題有點突然，",
          "sc": "虽然这问题有点突然，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 178976,
          "spk": "莲实 (ハスミ)",
          "ja": "ヨウが大人になった時のことって",
          "tc": "你平常會去想洋妹妹",
          "sc": "你平常会去想洋妹妹"
        },
        {
          "f_idx": 2,
          "pidx_tc": 178983,
          "spk": "莲实 (ハスミ)",
          "ja": "想像したりしますか？",
          "tc": "長大以後的事嗎？",
          "sc": "长大以后的事吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 178996,
          "spk": "六角 (ロッカク)",
          "ja": "これはまた、いきなりっスね",
          "tc": "這還真是突然耶。",
          "sc": "这还真是挺突然的呐。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 179007,
          "spk": "六角 (ロッカク)",
          "ja": "まだまだ先の未来なので",
          "tc": "畢竟是很久以後的事，",
          "sc": "毕竟是很久以后的事，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 179014,
          "spk": "六角 (ロッカク)",
          "ja": "考えることはまあ……",
          "tc": "要說有沒有想過……",
          "sc": "要说有没有想过……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 179021,
          "spk": "六角 (ロッカク)",
          "ja": "ないかもしれませんね",
          "tc": "大概沒有吧。",
          "sc": "大概没有吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 179034,
          "spk": "莲实 (ハスミ)",
          "ja": "そうですね",
          "tc": "說得也是呢。",
          "sc": "说得也是呢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 179041,
          "spk": "莲实 (ハスミ)",
          "ja": "まだまだ先の話ですものね……",
          "tc": "畢竟還要很久嘛……",
          "sc": "毕竟还要很久嘛……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 179054,
          "spk": "六角 (ロッカク)",
          "ja": "何か、お悩みですか？",
          "tc": "妳在煩惱什麼嗎？",
          "sc": "你在烦恼什么吗？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 179061,
          "spk": "六角 (ロッカク)",
          "ja": "差し出がましいようですけど",
          "tc": "雖然可能有點多管閒事，",
          "sc": "虽然可能有点多管闲事，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 179068,
          "spk": "六角 (ロッカク)",
          "ja": "ワシでよかったら聞かせてください",
          "tc": "妳不介意的話，就說給我聽聽吧。",
          "sc": "你不介意的话，就说给我听听吧。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 179081,
          "spk": "莲实 (ハスミ)",
          "ja": "……いろいろと口を出しているせいなのか",
          "tc": "……不曉得是不是因為我管得太多，",
          "sc": "……不晓得是不是因为我管得太多，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 179088,
          "spk": "莲实 (ハスミ)",
          "ja": "時々、スミレが嫌な顔をすることがあるんです",
          "tc": "堇怜有時候會露出不悅的表情。",
          "sc": "堇怜有时候会露出不悦的表情。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 179106,
          "spk": "莲实 (ハスミ)",
          "ja": "それで、私への不満を抱えたまま",
          "tc": "要是他就這樣一直對我有所不滿，",
          "sc": "要是他就这样一直对我有所不满，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 179113,
          "spk": "莲实 (ハスミ)",
          "ja": "スミレが成人を迎えたら――",
          "tc": "等他長大成人後──",
          "sc": "等他长大成人后——"
        },
        {
          "f_idx": 17,
          "pidx_tc": 179124,
          "spk": "莲实 (ハスミ)",
          "ja": "「姉さんと一緒のお酒なんて吞みたくない」",
          "tc": "會不會說出「我才不要跟姊姊一起喝酒」",
          "sc": "会不会说出“我才不要跟姐姐一起喝酒”"
        },
        {
          "f_idx": 18,
          "pidx_tc": 179131,
          "spk": "莲实 (ハスミ)",
          "ja": "と、そのように断られるのではないかと",
          "tc": "這樣的話來拒絕我，",
          "sc": "这样的话来拒绝我，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 179138,
          "spk": "莲实 (ハスミ)",
          "ja": "今から不安で不安で……",
          "tc": "我現在想到就覺得好擔心……",
          "sc": "我现在想到就觉得好担心……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 179151,
          "spk": "六角 (ロッカク)",
          "ja": "はあ……それが悩みの種っスか",
          "tc": "唉……原來妳在煩惱這個啊。",
          "sc": "唉……原来你在烦恼这个啊。"
        },
        {
          "f_idx": 21,
          "pidx_tc": 179162,
          "spk": "六角 (ロッカク)",
          "ja": "そんな心配しなくていいじゃないですかね？",
          "tc": "應該也不用那麼擔心吧？",
          "sc": "应该也不用那么担心吧？"
        },
        {
          "f_idx": 22,
          "pidx_tc": 179169,
          "spk": "六角 (ロッカク)",
          "ja": "ハスミさんたちほど仲のいい姉弟も",
          "tc": "畢竟像蓮實你們感情這麼好的姊弟，",
          "sc": "毕竟像莲实你们感情这么好的姐弟，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 179176,
          "spk": "六角 (ロッカク)",
          "ja": "そういないっスから",
          "tc": "其實也不多。",
          "sc": "其实也不多。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 179189,
          "spk": "莲实 (ハスミ)",
          "ja": "……だといいんですけど",
          "tc": "……真是這樣就好了。",
          "sc": "……真是这样就好了。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 179196,
          "spk": "莲实 (ハスミ)",
          "ja": "私の取り越し苦労であると祈ります",
          "tc": "希望只是我多慮了。",
          "sc": "希望只是我多虑了。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 179209,
          "spk": "六角 (ロッカク)",
          "ja": "しかし……大人になった時",
          "tc": "不過……希望在他長大成人後",
          "sc": "不过……希望在他长大成人后"
        },
        {
          "f_idx": 27,
          "pidx_tc": 179216,
          "spk": "六角 (ロッカク)",
          "ja": "酒を酌み交わしたい、かあ",
          "tc": "可以一起喝酒嗎……",
          "sc": "可以一起喝酒吗……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 179227,
          "spk": "六角 (ロッカク)",
          "ja": "そうっスね……",
          "tc": "也是呢……",
          "sc": "也是呢……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 179234,
          "spk": "六角 (ロッカク)",
          "ja": "いつか、そんな日が来るといいっスよね",
          "tc": "要是將來有這麼一天就好了。",
          "sc": "要是将来有这么一天就好哟。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3331,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0058",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 179264,
          "spk": "木助 (キスケ)",
          "ja": "今日も冷えるな……",
          "tc": "今天也好冷……",
          "sc": "今天也好冷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 179271,
          "spk": "木助 (キスケ)",
          "ja": "こういう日は強い酒で",
          "tc": "在這種天氣裡，就會想來點烈酒，",
          "sc": "在这种天气里，就会想来点烈酒，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 179278,
          "spk": "木助 (キスケ)",
          "ja": "かぁっと熱くなりてえな",
          "tc": "讓身體迅速暖起來呢。",
          "sc": "让身体迅速暖起来呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 179291,
          "spk": "四郎治 (シロージ)",
          "ja": "キスケ、酒に強くないんだから",
          "tc": "木助，你酒量又不好，",
          "sc": "木助，你酒量又不好，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 179298,
          "spk": "四郎治 (シロージ)",
          "ja": "ほどほどにしといたほうがいいぜ",
          "tc": "飲酒還是要適量啦。",
          "sc": "饮酒还是要适量啦。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 179311,
          "spk": "名护 (ナゴ)",
          "ja": "けど本当にこの村は寒いな",
          "tc": "不過，這個村子真的很冷呢。",
          "sc": "不过，这个村子真的很冷呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 179318,
          "spk": "名护 (ナゴ)",
          "ja": "街とは段違いだ",
          "tc": "跟市區完全不同。",
          "sc": "跟市区完全不同。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 179331,
          "spk": "木助 (キスケ)",
          "ja": "そんなに違うのか？",
          "tc": "有差那麼多嗎？",
          "sc": "有差那么多吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 179344,
          "spk": "名护 (ナゴ)",
          "ja": "大学の頃にいた街なんかは",
          "tc": "像我大學時代待過的市區，",
          "sc": "像我大学时代待过的市区，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 179351,
          "spk": "名护 (ナゴ)",
          "ja": "こんなに雪が降る場所じゃなかったな",
          "tc": "根本不會下這麼多雪。",
          "sc": "根本不会下这么多雪。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 179358,
          "spk": "名护 (ナゴ)",
          "ja": "年に数日降る程度だ",
          "tc": "一年大概只下個幾天而已。",
          "sc": "一年大概只下个几天而已。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 179371,
          "spk": "四郎治 (シロージ)",
          "ja": "羨ましいな",
          "tc": "真讓人羨慕。",
          "sc": "真让人羡慕。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 179378,
          "spk": "四郎治 (シロージ)",
          "ja": "雪が少ないなら森の仕事もはかどりそうだ",
          "tc": "如果雪下得少，在森林裡做事應該也會更順利。",
          "sc": "如果雪下得少，在森林里做事应该也会更顺利。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 179391,
          "spk": "木助 (キスケ)",
          "ja": "そうか？",
          "tc": "是嗎？",
          "sc": "是吗？"
        },
        {
          "f_idx": 14,
          "pidx_tc": 179398,
          "spk": "木助 (キスケ)",
          "ja": "俺としちゃあもったいねぇと思うけどな",
          "tc": "我倒覺得滿可惜的……",
          "sc": "我倒觉得满可惜的……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 179409,
          "spk": "木助 (キスケ)",
          "ja": "部屋の中で雪が降る様子を眺めながら",
          "tc": "那樣就沒辦法享受在房間裡邊賞雪",
          "sc": "那样就没办法享受在房间里边赏雪"
        },
        {
          "f_idx": 16,
          "pidx_tc": 179416,
          "spk": "木助 (キスケ)",
          "ja": "酒を呑む風情が楽しめなくなる",
          "tc": "邊喝酒的情趣了。",
          "sc": "边喝酒的情趣了。"
        },
        {
          "f_idx": 18,
          "pidx_tc": 179436,
          "spk": "名护 (ナゴ)",
          "ja": "雪はたまに降るくらいで十分かな",
          "tc": "雪只要偶爾下下就夠了吧。",
          "sc": "雪只要偶尔下下就够了吧。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 179443,
          "spk": "名护 (ナゴ)",
          "ja": "毎日雪かきしてるせいで、腰が……",
          "tc": "每天都在鏟雪，害我的腰都……",
          "sc": "每天都在铲雪，害我的腰都……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 179461,
          "spk": "名护 (ナゴ)",
          "ja": "けどキスケさんが用意してくれた",
          "tc": "不過木助先生幫我整備的房子很暖和，",
          "sc": "不过木助先生帮我整备的房子很暖和，"
        },
        {
          "f_idx": 22,
          "pidx_tc": 179468,
          "spk": "名护 (ナゴ)",
          "ja": "建物は暖かくて助かるよ",
          "tc": "真的幫了我很大的忙。",
          "sc": "真的帮了我很大的忙。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 179481,
          "spk": "四郎治 (シロージ)",
          "ja": "口は悪いが腕はいいからな",
          "tc": "他雖然嘴巴壞，但技術是真的好。",
          "sc": "他虽然嘴巴坏，但技术是真的好。"
        },
        {
          "f_idx": 25,
          "pidx_tc": 179501,
          "spk": "木助 (キスケ)",
          "ja": "一言余計だってんだよ",
          "tc": "前面那句太多餘了啦。",
          "sc": "前面那句太多余了啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 3332,
      "rec_id": "TALK_ID_MULTI_PERSON_20_500_0059",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 179531,
          "spk": "琪娜娜 (チナナ)",
          "ja": "どこかの家から薪が燃える",
          "tc": "不知道是哪戶人家在燒柴，",
          "sc": "不知道是哪户人家在烧柴，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 179538,
          "spk": "琪娜娜 (チナナ)",
          "ja": "匂いが漂ってくるよ",
          "tc": "味道飄過來了，",
          "sc": "味道飘过来了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 179545,
          "spk": "琪娜娜 (チナナ)",
          "ja": "いい匂いだねえ",
          "tc": "聞起來真不錯呢。",
          "sc": "闻起来真不错呢。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 179556,
          "spk": "琪娜娜 (チナナ)",
          "ja": "みんな、ちゃんと冬を越す",
          "tc": "看來大家都做好",
          "sc": "看来大家都做好"
        },
        {
          "f_idx": 4,
          "pidx_tc": 179563,
          "spk": "琪娜娜 (チナナ)",
          "ja": "準備ができているようだけど、",
          "tc": "過冬的準備了，",
          "sc": "过冬的准备了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 179570,
          "spk": "琪娜娜 (チナナ)",
          "ja": "リンはどうだい？",
          "tc": "那林妳呢？",
          "sc": "那林你呢？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 179583,
          "spk": "林 (リン)",
          "ja": "できているに決まっているじゃない",
          "tc": "我當然也準備好了啊。",
          "sc": "我当然也准备好了啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 179590,
          "spk": "林 (リン)",
          "ja": "彼ヶ津村で冬を越すということは、",
          "tc": "在彼津村過冬，",
          "sc": "在彼津村过冬，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 179597,
          "spk": "林 (リン)",
          "ja": "たっぷりと薪を準備しておくということよ",
          "tc": "就是得準備充足的柴火。",
          "sc": "就是得准备充足的柴火。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 179610,
          "spk": "琪娜娜 (チナナ)",
          "ja": "そうかい、愚問だったね",
          "tc": "這樣啊，是我問了個笨問題呢。",
          "sc": "这样啊，是我问了个笨问题呢。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 179617,
          "spk": "琪娜娜 (チナナ)",
          "ja": "みんな自分のやるべきことをわかってて、",
          "tc": "大家都很清楚自己該做什麼，",
          "sc": "大家都很清楚自己该做什么，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 179624,
          "spk": "琪娜娜 (チナナ)",
          "ja": "偉いねえ",
          "tc": "真是了不起。",
          "sc": "真是了不起。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 179637,
          "spk": "林 (リン)",
          "ja": "……あなたこそ",
          "tc": "……妳才是──",
          "sc": "……你才是——"
        },
        {
          "f_idx": 13,
          "pidx_tc": 179650,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ん？ ウチは偉くないよ",
          "tc": "嗯？我完全不厲害喔。",
          "sc": "嗯？我完全不厉害哦。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 179663,
          "spk": "林 (リン)",
          "ja": "そうじゃないわ",
          "tc": "我不是那個意思。",
          "sc": "我不是那个意思。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 179670,
          "spk": "林 (リン)",
          "ja": "……あなたこそ、いつまで",
          "tc": "……我要說的是，",
          "sc": "……我要说的是，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 179677,
          "spk": "林 (リン)",
          "ja": "あのトラックで商売するつもりなの",
          "tc": "妳打算用那台卡車做生意做到什麼時候？",
          "sc": "你打算用那台卡车做生意做到什么时候？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 179688,
          "spk": "林 (リン)",
          "ja": "冬は村のあちこちで道が凍るし、",
          "tc": "冬天時村子裡有很多道路都會結冰，",
          "sc": "冬天时村子里有很多道路都会结冰，"
