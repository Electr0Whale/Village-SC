    {
      "file": "talk.dat",
      "rec_idx": 4846,
      "rec_id": "TALK_ID_10_0403_044_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279550,
          "spk": "木助 (キスケ)",
          "ja": "静かになっちまったな",
          "tc": "變得好安靜啊。",
          "sc": "变得好安静啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279561,
          "spk": "木助 (キスケ)",
          "ja": "手を打てども打てどもこの繰り返し",
          "tc": "不管再怎麼想方設法，事情還是一再重演。",
          "sc": "不管再怎么想方设法，事情还是一再重演。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279568,
          "spk": "木助 (キスケ)",
          "ja": "はあ……全く、手のかかる土地だぜ",
          "tc": "唉……受不了，真是塊難搞的土地啊。",
          "sc": "唉……受不了，真是块难搞的土地啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4847,
      "rec_id": "TALK_ID_10_0403_044_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279601,
          "spk": "木助 (キスケ)",
          "ja": "ああ、この猟銃が気になるか",
          "tc": "哦，你很在意這把獵槍嗎？",
          "sc": "哦，你很在意这把猎枪吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279612,
          "spk": "木助 (キスケ)",
          "ja": "大丈夫、空砲だ",
          "tc": "沒事啦，只是空包彈，",
          "sc": "没事啦，只是空包弹，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279619,
          "spk": "木助 (キスケ)",
          "ja": "弾は込められちゃいねえさ",
          "tc": "裡面沒放實彈啦。",
          "sc": "里面没放实弹啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279630,
          "spk": "木助 (キスケ)",
          "ja": "村の連中が眠りこけてる隙に",
          "tc": "在村裡的大夥都沉睡的時候，",
          "sc": "在村里的大伙都沉睡的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279637,
          "spk": "木助 (キスケ)",
          "ja": "なんかあったら危ねえからよ",
          "tc": "要是出了什麼事就糟了嘛。",
          "sc": "要是出了什么事就糟了嘛。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4848,
      "rec_id": "TALK_ID_10_0403_044_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279663,
          "spk": "木助 (キスケ)",
          "ja": "リンや他の連中のことが",
          "tc": "你會擔心林和其他傢伙很正常，",
          "sc": "你会担心林和其他家伙很正常，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279670,
          "spk": "木助 (キスケ)",
          "ja": "気になる気持ちはわかるが、",
          "tc": "我能理解你的心情，",
          "sc": "我能理解你的心情，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279677,
          "spk": "木助 (キスケ)",
          "ja": "てめぇにできることはなんもねぇよ",
          "tc": "但是現在沒有你幫得上忙的地方啦。",
          "sc": "但是现在没有你帮得上忙的地方啦。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279688,
          "spk": "木助 (キスケ)",
          "ja": "大人しく庭にひっこんでろ",
          "tc": "你就乖乖回去你的庭院躲好吧。",
          "sc": "你就乖乖回去你的庭院躲好吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279699,
          "spk": "木助 (キスケ)",
          "ja": "心配すんな",
          "tc": "別瞎操心了，",
          "sc": "别瞎操心了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279706,
          "spk": "木助 (キスケ)",
          "ja": "俺やリンがなんとかしてやるからな",
          "tc": "我和林會設法搞定啦。",
          "sc": "我和林会设法搞定啦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4849,
      "rec_id": "TALK_ID_10_0403_045_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279813,
          "spk": "帷 (トバリ)",
          "ja": "私はどうすればよかったの……",
          "tc": "我到底該怎麼做才對……",
          "sc": "我到底该怎么做才对……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279824,
          "spk": "帷 (トバリ)",
          "ja": "秘密を暴かずに、リンや掟に従順に、",
          "tc": "是不是不該揭露祕密，乖乖順從林還有規矩，",
          "sc": "是不是不该揭露秘密，乖乖顺从林还有规矩，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279831,
          "spk": "帷 (トバリ)",
          "ja": "何も考えず暮らしていればよかったの……",
          "tc": "什麼都別去想，只要過我的日子就好呢……",
          "sc": "什么都别去想，只要过我的日子就好呢……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279849,
          "spk": "帷 (トバリ)",
          "ja": "でも、そんなの、私には……",
          "tc": "但是，那樣子，我……",
          "sc": "但是，那样子，我……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4850,
      "rec_id": "TALK_ID_10_0403_045_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279875,
          "spk": "帷 (トバリ)",
          "ja": "私はこれから、どうすれば……",
          "tc": "以後，我該怎麼辦才好……",
          "sc": "以后，我该怎么办才好……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279884,
          "spk": "帷 (トバリ)",
          "ja": "教えてよ、リン……",
          "tc": "告訴我啊，林……",
          "sc": "告诉我啊，林……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4851,
      "rec_id": "TALK_ID_10_0403_046_01",
      "lines": [
        {
          "f_idx": 0,
