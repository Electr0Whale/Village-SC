        {
          "f_idx": 40,
          "pidx_tc": 280259,
          "spk": "帷 (トバリ)",
          "ja": "こんなことを起こしたかったわけじゃない……",
          "tc": "也沒有想害這種事發生的意思……",
          "sc": "也没有想害这种事发生的意思……"
        },
        {
          "f_idx": 42,
          "pidx_tc": 280277,
          "spk": "帷 (トバリ)",
          "ja": "なのに……",
          "tc": "為什麼卻……",
          "sc": "为什么却……"
