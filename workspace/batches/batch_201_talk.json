        {
          "f_idx": 45,
          "pidx_tc": 280300,
          "spk": "帷 (トバリ)",
          "ja": "リン……",
          "tc": "林……",
          "sc": "林……"
        },
        {
          "f_idx": 46,
          "pidx_tc": 280307,
          "spk": "帷 (トバリ)",
          "ja": "私は、どうすれば……",
          "tc": "我到底，該怎麼辦才好……",
          "sc": "我到底，该怎么办才好……"
        }
      ]
    },
