  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 4837,
      "rec_id": "TALK_ID_10_0403_042_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 278869,
          "spk": "帷 (トバリ)",
          "ja": "でも……私……",
          "tc": "但是……我……",
          "sc": "但是……我……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 278876,
          "spk": "帷 (トバリ)",
          "ja": "アンタを殺してしまったのかと……",
          "tc": "我還以為自己殺了妳……",
          "sc": "我还以为自己杀了你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 278889,
          "spk": "林 (リン)",
          "ja": "違うわ、トバリ",
          "tc": "不是的，帷。",
          "sc": "不是的，帷。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 278900,
          "spk": "林 (リン)",
          "ja": "こんな大事を引き起こしたのは",
          "tc": "之所以會發生這麼嚴重的事，",
          "sc": "之所以会发生这么严重的事，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 278907,
          "spk": "林 (リン)",
          "ja": "この村に潜む……悪意のせいよ",
          "tc": "都要怪潛藏在村裡的……惡意。",
          "sc": "都要怪潜藏在村里的……恶意。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 278920,
          "spk": "帷 (トバリ)",
          "ja": "それでも、",
          "tc": "妳不惜如此，",
          "sc": "你不惜如此，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 278927,
          "spk": "帷 (トバリ)",
          "ja": "アンタが守ろうとしていた秘密は",
          "tc": "也想守護的祕密，",
          "sc": "也想守护的秘密，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 278934,
          "spk": "帷 (トバリ)",
          "ja": "あの樹のことだったのでしょう",
          "tc": "就是那棵樹吧？",
          "sc": "就是那棵树吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 278945,
          "spk": "帷 (トバリ)",
          "ja": "だから、コダマの樹を",
          "tc": "所以，",
          "sc": "所以，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 278952,
          "spk": "帷 (トバリ)",
          "ja": "切り倒して回っていた……",
          "tc": "妳才會四處砍倒木珠的樹……",
          "sc": "你才会四处砍倒木珠的树……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 278959,
          "spk": "帷 (トバリ)",
          "ja": "あれも、土地神の一部だから……",
          "tc": "因為那也是土地神的一部分……",
          "sc": "因为那也是土地神的一部分……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 278972,
          "spk": "林 (リン)",
          "ja": "……そうね",
          "tc": "……是啊。",
          "sc": "……是啊。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 278979,
          "spk": "林 (リン)",
          "ja": "秘密はソレだけじゃなかったけれど",
          "tc": "不過祕密並不只這件事就是了。",
          "sc": "不过秘密并不只这件事就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4838,
      "rec_id": "TALK_ID_10_0403_042_24",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 278997,
          "spk": "帷 (トバリ)",
          "ja": "じゃあこんなことになったのは、",
          "tc": "那事情會變成這樣，",
          "sc": "那事情会变成这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279004,
          "spk": "帷 (トバリ)",
          "ja": "全て私の……",
          "tc": "全都是我……",
          "sc": "全都是我……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279017,
          "spk": "林 (リン)",
          "ja": "ふふ、ふふふ",
          "tc": "呵呵、呵呵呵。",
          "sc": "呵呵、呵呵呵。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4839,
      "rec_id": "TALK_ID_10_0403_042_25",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279035,
          "spk": "帷 (トバリ)",
          "ja": "……なによ",
          "tc": "……笑什麼？",
          "sc": "……笑什么？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279048,
          "spk": "林 (リン)",
          "ja": "らしくないわね、トバリ",
          "tc": "這樣真不像妳呢，帷。",
          "sc": "这样真不像你呢，帷。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279055,
          "spk": "林 (リン)",
          "ja": "意外とかわいいところもあるじゃない",
          "tc": "真意外妳也有可愛的地方嘛。",
          "sc": "真意外你也有可爱的地方嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279068,
          "spk": "帷 (トバリ)",
          "ja": "それどころじゃないでしょう！",
          "tc": "現在不是講這種話的時候了吧！",
          "sc": "现在不是讲这种话的时候了吧！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279081,
          "spk": "林 (リン)",
          "ja": "いいのよ、いいの",
          "tc": "好了，沒關係的。",
          "sc": "好了，没关系的。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279088,
          "spk": "林 (リン)",
          "ja": "これはあなたのせいじゃない",
          "tc": "這不是妳的錯。",
          "sc": "这不是你的错。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 279099,
          "spk": "林 (リン)",
          "ja": "それに、みんな、",
          "tc": "更何況，",
          "sc": "更何况，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279106,
          "spk": "林 (リン)",
          "ja": "まだ死んだわけじゃないの",
          "tc": "大家並沒有死啊。",
          "sc": "大家并没有死啊。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279117,
          "spk": "林 (リン)",
          "ja": "これからちゃんと、封印をしなおせば……",
          "tc": "只要再好好重新封印起來……",
          "sc": "只要再好好重新封印起来……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 279124,
          "spk": "林 (リン)",
          "ja": "きっと、元の暮らしは戻ってくるわ",
          "tc": "我們一定能回到原本的生活的。",
          "sc": "我们一定能回到原本的生活的。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 279137,
          "spk": "帷 (トバリ)",
          "ja": "……じゃあ、教えてよ！",
          "tc": "……那妳告訴我吧！",
          "sc": "……那你告诉我吧！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 279144,
          "spk": "帷 (トバリ)",
          "ja": "……私はどうやって償えば良いの！",
          "tc": "……我該怎麼彌補才好！",
          "sc": "……我该怎么弥补才好！"
        },
        {
          "f_idx": 12,
          "pidx_tc": 279155,
          "spk": "帷 (トバリ)",
          "ja": "私が生贄になればいい？",
          "tc": "只要我成為活祭品就行了嗎？",
          "sc": "只要我成为活祭品就行了吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4840,
      "rec_id": "TALK_ID_10_0403_042_26",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279173,
          "spk": "林 (リン)",
          "ja": "……それは違うわ、",
          "tc": "……不是這樣的，",
          "sc": "……不是这样的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279180,
          "spk": "林 (リン)",
          "ja": "必要なのは、別の……",
          "tc": "需要的是，別的……",
          "sc": "需要的是，别的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279191,
          "spk": "林 (リン)",
          "ja": "……ごめんなさい、トバリ",
          "tc": "……對不起，帷。",
          "sc": "……对不起，帷。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279198,
          "spk": "林 (リン)",
          "ja": "これは……私の勇気が",
          "tc": "這都是……因為我勇氣不夠，",
          "sc": "这都是……因为我勇气不够，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279205,
          "spk": "林 (リン)",
          "ja": "足りなくて招いたこと……",
          "tc": "所導致的結果……",
          "sc": "所导致的结果……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279218,
          "spk": "帷 (トバリ)",
          "ja": "リン、はぐらかすのはもうやめてよ！",
          "tc": "林，妳別再想含糊帶過了！",
          "sc": "林，你别再想含糊带过了！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 279225,
          "spk": "帷 (トバリ)",
          "ja": "私はいつまで",
          "tc": "妳還想讓我當局外人",
          "sc": "你还想让我当局外人"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279232,
          "spk": "帷 (トバリ)",
          "ja": "部外者でいればいいのよ……！",
          "tc": "到什麼時候啊……！",
          "sc": "到什么时候啊……！"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279245,
          "spk": "林 (リン)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4841,
      "rec_id": "TALK_ID_10_0403_042_27",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279273,
          "spk": "帷 (トバリ)",
          "ja": "……リン？",
          "tc": "……林？",
          "sc": "……林？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279284,
          "spk": "帷 (トバリ)",
          "ja": "リン、しっかりして！！",
          "tc": "林，妳振作點！！",
          "sc": "林，你振作点！！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4842,
      "rec_id": "TALK_ID_10_0403_042_28",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279312,
          "spk": "木助 (キスケ)",
          "ja": "……ハァ",
          "tc": "……唉。",
          "sc": "……唉。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279319,
          "spk": "木助 (キスケ)",
          "ja": "……馬鹿野郎",
          "tc": "……這個大笨蛋。",
          "sc": "……这个大笨蛋。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279330,
          "spk": "木助 (キスケ)",
          "ja": "終わるどころか",
          "tc": "事情可還沒完，",
          "sc": "事情可还没完，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279337,
          "spk": "木助 (キスケ)",
          "ja": "まだ始まったばかりだぜ",
          "tc": "不如說現在才正要開始啊。",
          "sc": "不如说现在才正要开始啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279346,
          "spk": "木助 (キスケ)",
          "ja": "血が足りてないくせに",
          "tc": "誰叫妳都已經貧血了，",
          "sc": "谁叫你都已经贫血了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279353,
          "spk": "木助 (キスケ)",
          "ja": "無理するからだ",
          "tc": "還這樣勉強自己。",
          "sc": "还这样勉强自己。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4843,
      "rec_id": "TALK_ID_10_0403_042_29",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279371,
          "spk": "木助 (キスケ)",
          "ja": "悪いなトバリ、",
          "tc": "抱歉啊，帷，",
          "sc": "抱歉啊，帷，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279378,
          "spk": "木助 (キスケ)",
          "ja": "お喋りはここまでだ",
          "tc": "就先聊到這裡吧。",
          "sc": "就先聊到这里吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279387,
          "spk": "木助 (キスケ)",
          "ja": "リンを、奥の病室に",
          "tc": "把林帶去裡面的病房，",
          "sc": "把林带去里面的病房，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279394,
          "spk": "木助 (キスケ)",
          "ja": "寝かしてきてやってくれ",
          "tc": "讓她休息一下吧。",
          "sc": "让她休息一下吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279407,
          "spk": "帷 (トバリ)",
          "ja": "……わかった",
          "tc": "……我知道了。",
          "sc": "……我知道了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4844,
      "rec_id": "TALK_ID_10_0403_042_30",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279433,
          "spk": "木助 (キスケ)",
          "ja": "不安だろうが、",
          "tc": "雖然你應該也很不安，",
          "sc": "虽然你应该也很不安，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279440,
          "spk": "木助 (キスケ)",
          "ja": "今はリンを休ませてやってくれ",
          "tc": "但現在就讓林先休息吧。",
          "sc": "但现在就让林先休息吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279451,
          "spk": "木助 (キスケ)",
          "ja": "てめぇには、休めない別の仕事があるだろう",
          "tc": "至於你應該沒功夫休息，還有別的工作要做吧。",
          "sc": "至于你应该没功夫休息，还有别的工作要做吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279469,
          "spk": "木助 (キスケ)",
          "ja": "誰がいてもいなくても、",
          "tc": "不管誰在或不在了，",
          "sc": "不管谁在或不在了，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279476,
          "spk": "木助 (キスケ)",
          "ja": "あの庭はてめぇにしか管理できねぇからな",
          "tc": "那座庭院都只有你這傢伙有辦法打理啊。",
          "sc": "那座庭院都只有你这家伙有办法打理啊。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279494,
          "spk": "木助 (キスケ)",
          "ja": "できるかぎり、いつも通り過ごすんだ",
          "tc": "你就盡量照常過日子吧。",
          "sc": "你就尽量照常过日子吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279501,
          "spk": "木助 (キスケ)",
          "ja": "今のてめぇにできることは、それだけだ",
          "tc": "你現在能做的，就只有這件事了。",
          "sc": "你现在能做的，就只有这件事了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4845,
      "rec_id": "TALK_ID_10_0403_043_01",
      "lines": [
