          "spk": "主角心声/旁白/选项",
          "ja": "リンが眠っている……",
          "tc": "林還在沉睡……",
          "sc": "林还在沉睡……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279911,
          "spk": "主角心声/旁白/选项",
          "ja": "呼吸が浅い……",
          "tc": "呼吸很淺……",
          "sc": "呼吸很浅……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4852,
      "rec_id": "TALK_ID_10_0403_047_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279931,
          "spk": "帷 (トバリ)",
          "ja": "……祠の神さま",
          "tc": "……祠堂的神明大人，",
          "sc": "……祠堂的神明大人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279942,
          "spk": "帷 (トバリ)",
          "ja": "あなたは、村を樹で埋めつくして、",
          "tc": "祢跟那個讓村子裡長滿樹木，",
          "sc": "你跟那个让村子里长满树木，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279949,
          "spk": "帷 (トバリ)",
          "ja": "みんなを眠らせた土地神とは",
          "tc": "又讓大家陷入沉睡的土地神……",
          "sc": "又让大家陷入沉睡的土地神……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279956,
          "spk": "帷 (トバリ)",
          "ja": "違う神さまなんでしょう？",
          "tc": "應該不是同一位神明大人吧？",
          "sc": "应该不是同一位神明大人吧？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279965,
          "spk": "帷 (トバリ)",
          "ja": "あなたが、こんな状況でもここにいるなら……",
          "tc": "如果祢在這種狀況下依然留在這裡……",
          "sc": "如果你在这种状况下依然留在这里……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279972,
          "spk": "帷 (トバリ)",
          "ja": "……私の話を聞いてください",
          "tc": "……請祢聽聽我的請求。",
          "sc": "……请你听听我的请求。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279990,
          "spk": "帷 (トバリ)",
          "ja": "私は、ずっと、誰かに全てを",
          "tc": "一直以來，",
          "sc": "一直以来，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279997,
          "spk": "帷 (トバリ)",
          "ja": "決められて生きてきました",
          "tc": "我都是過著被別人決定好的人生，",
          "sc": "我都是过着被别人决定好的人生，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 280013,
          "spk": "帷 (トバリ)",
          "ja": "顔も覚えていない親に、知らない大人に……",
          "tc": "從連長相都不記得的父母，到不認識的大人……",
          "sc": "从连长相都不记得的父母，到不认识的大人……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 280020,
          "spk": "帷 (トバリ)",
          "ja": "理由もわからないまま、決められて……",
          "tc": "我的人生就這樣不明就裡被決定了……",
          "sc": "我的人生就这样不明就里被决定了……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 280027,
          "spk": "帷 (トバリ)",
          "ja": "私は、ずっと何も選べませんでした",
          "tc": "我從來都沒有自己選擇的權利。",
          "sc": "我从来都没有自己选择的权利。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 280038,
          "spk": "帷 (トバリ)",
          "ja": "数年前、あの女が現れて、",
          "tc": "幾年前，那個女人出現了。",
          "sc": "几年前，那个女人出现了。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 280045,
          "spk": "帷 (トバリ)",
          "ja": "当たり前みたいな顔で言ったんです",
          "tc": "她擺出理所當然的表情對我說：",
          "sc": "她摆出理所当然的表情对我说："
        },
        {
          "f_idx": 15,
          "pidx_tc": 280052,
          "spk": "帷 (トバリ)",
          "ja": "「養子になりなさい」って",
          "tc": "「來當我的養女吧。」",
          "sc": "“来当我的养女吧。”"
        },
        {
          "f_idx": 16,
          "pidx_tc": 280063,
          "spk": "帷 (トバリ)",
          "ja": "私が頷く前に全てが決まっていて、",
          "tc": "在我點頭之前，一切就都決定好了，",
          "sc": "在我点头之前，一切就都决定好了，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 280070,
          "spk": "帷 (トバリ)",
          "ja": "気づいたときには、この村の住人にされてた……",
          "tc": "回過神來，我已經成了這座村子的居民……",
          "sc": "回过神来，我已经成了这座村子的居民……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 280077,
          "spk": "帷 (トバリ)",
          "ja": "……外へ出る道はもうありませんでした",
          "tc": "……再也沒有通往外界的路了。",
          "sc": "……再也没有通往外界的路了。"
        },
        {
          "f_idx": 19,
          "pidx_tc": 280088,
          "spk": "帷 (トバリ)",
          "ja": "……そうして住む羽目になったこの村は、",
          "tc": "……就這樣，我被迫住進這座村子，",
          "sc": "……就这样，我被迫住进这座村子，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 280095,
          "spk": "帷 (トバリ)",
          "ja": "今まで居た場所と何も変わらない……",
          "tc": "結果這裡跟我以前待過的地方根本沒兩樣……",
          "sc": "结果这里跟我以前待过的地方根本没两样……"
        },
        {
          "f_idx": 21,
          "pidx_tc": 280102,
          "spk": "帷 (トバリ)",
          "ja": "……むしろ、もっと自由がない場所です",
          "tc": "……甚至比以前更不自由。",
          "sc": "……甚至比以前更不自由。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 280111,
          "spk": "帷 (トバリ)",
          "ja": "村のみんな、息をするみたいに掟に従って、",
          "tc": "遵守規矩對村裡的大家來說，就像呼吸一樣自然，",
          "sc": "遵守规矩对村里的大家来说，就像呼吸一样自然，"
        },
        {
          "f_idx": 23,
          "pidx_tc": 280118,
          "spk": "帷 (トバリ)",
          "ja": "誰も疑問を持たない",
          "tc": "誰也不曾抱持疑問。",
          "sc": "谁也不曾抱持疑问。"
        },
        {
          "f_idx": 24,
          "pidx_tc": 280129,
          "spk": "帷 (トバリ)",
          "ja": "私が何をしても、どこにいても、",
          "tc": "不論我做了什麼，又或是人在哪裡，",
          "sc": "不论我做了什么，又或是人在哪里，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 280136,
          "spk": "帷 (トバリ)",
          "ja": "全てが噂としてあの女の耳に届く……",
          "tc": "最後都會傳到那女人的耳裡……",
          "sc": "最后都会传到那女人的耳里……"
        },
        {
          "f_idx": 26,
          "pidx_tc": 280143,
          "spk": "帷 (トバリ)",
          "ja": "……私にとってこの村は、息苦しかった",
          "tc": "……對我來說，這座村子令人窒息。",
          "sc": "……对我来说，这座村子令人窒息。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 280154,
          "spk": "帷 (トバリ)",
          "ja": "あの女は、私を村へ連れて来る時に言いました",
          "tc": "那個女人帶我來村子時，",
          "sc": "那个女人带我来村子时，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 280161,
          "spk": "帷 (トバリ)",
          "ja": "「私と一緒に村長になってほしい」と……",
          "tc": "曾對我說過：「和我一起成為村長吧。」",
          "sc": "曾对我说过：“和我一起成为村长吧。”"
        },
        {
          "f_idx": 30,
          "pidx_tc": 280179,
          "spk": "帷 (トバリ)",
          "ja": "それなのに、私に何も教えてくれない……",
          "tc": "結果卻又什麼都不肯告訴我……",
          "sc": "结果却又什么都不肯告诉我……"
        },
        {
          "f_idx": 31,
          "pidx_tc": 280186,
          "spk": "帷 (トバリ)",
          "ja": "深夜に現れる怪物のことも、掟の意味も、",
          "tc": "不管是深夜出現的怪物、規矩的意義，",
          "sc": "不管是深夜出现的怪物、规矩的意义，"
        },
        {
          "f_idx": 32,
          "pidx_tc": 280193,
          "spk": "帷 (トバリ)",
          "ja": "なぜ、話が通じる幽霊だけを消すのかも",
          "tc": "還有為什麼只消滅可以溝通的幽靈。",
          "sc": "还有为什么只消灭可以沟通的幽灵。"
        },
        {
          "f_idx": 33,
          "pidx_tc": 280204,
          "spk": "帷 (トバリ)",
          "ja": "本当は……ただ知りたかっただけなんです",
          "tc": "其實我純粹只是……想知道為什麼。",
          "sc": "其实我纯粹只是……想知道为什么。"
        },
        {
          "f_idx": 34,
          "pidx_tc": 280211,
          "spk": "帷 (トバリ)",
          "ja": "でも、それが……間違いでした",
          "tc": "但是，那卻是一個……錯誤。",
          "sc": "但是，那却是一个……错误。"
        },
        {
          "f_idx": 36,
          "pidx_tc": 280227,
          "spk": "帷 (トバリ)",
          "ja": "隠れてリンについて行ったあの日……",
          "tc": "偷偷跟蹤林的那天……",
          "sc": "偷偷跟踪林的那天……"
        },
        {
          "f_idx": 37,
          "pidx_tc": 280234,
          "spk": "帷 (トバリ)",
          "ja": "私は、自分がナイフを持ってるなんて、",
          "tc": "我根本沒發現，",
          "sc": "我根本没发现，"
        },
        {
          "f_idx": 38,
          "pidx_tc": 280241,
          "spk": "帷 (トバリ)",
          "ja": "気が付かなかった……",
          "tc": "自己竟然帶著刀……",
          "sc": "自己竟然带着刀……"
