      "rec_id": "TALK_ID_10_0402_033_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 272368,
          "spk": "帷 (トバリ)",
          "ja": "ちゃんと録音したから",
          "tc": "我都錄下來了。",
          "sc": "我都录下来了。"
        },
