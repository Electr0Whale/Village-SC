    },
    {
      "file": "talk.dat",
      "rec_idx": 4742,
      "rec_id": "TALK_ID_10_0402_031_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271708,
          "spk": "驹子 (コマコ)",
          "ja": "大丈夫、トバリ？",
