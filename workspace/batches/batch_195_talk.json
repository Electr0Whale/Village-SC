    {
      "file": "talk.dat",
      "rec_idx": 4711,
      "rec_id": "TALK_ID_10_0402_022_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270633,
          "spk": "帷 (トバリ)",
          "ja": "やっぱり、今日も",
          "tc": "果然沒錯，",
          "sc": "果然没错，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270640,
          "spk": "帷 (トバリ)",
          "ja": "儀式の準備とやらを行うつもりね",
          "tc": "她今天也打算去準備那個什麼儀式的樣子。",
          "sc": "她今天也打算去准备那个什么仪式的样子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270651,
          "spk": "驹子 (コマコ)",
          "ja": "ねえ、トバリ、やっぱり今の話……",
          "tc": "我說帷，照剛剛的對話聽來……",
          "sc": "我说帷，照刚刚的对话听来……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270658,
          "spk": "驹子 (コマコ)",
          "ja": "リンは村の、私たちのために……",
          "tc": "林果然是為了村子，為了我們才……",
          "sc": "林果然是为了村子，为了我们才……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4712,
      "rec_id": "TALK_ID_10_0402_022_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270683,
          "spk": "帷 (トバリ)",
          "ja": "そのために私を生贄にする",
          "tc": "她為此正在做準備，",
          "sc": "她为此正在做准备，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270690,
          "spk": "帷 (トバリ)",
          "ja": "準備をしているってこと？",
          "tc": "打算拿我當活祭品是吧？",
          "sc": "打算拿我当活祭品是吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270703,
          "spk": "驹子 (コマコ)",
          "ja": "そ、そうと決まったわけじゃないよ……",
          "tc": "事、事情不一定是這樣吧……",
          "sc": "事、事情不一定是这样吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4713,
      "rec_id": "TALK_ID_10_0402_022_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270728,
          "spk": "帷 (トバリ)",
          "ja": "今更、諦めて帰りましょうとはならないわ",
          "tc": "事到如今，別想叫我放棄回家。",
          "sc": "事到如今，别想叫我放弃回家。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270735,
          "spk": "帷 (トバリ)",
          "ja": "私は必ずリンの思惑を暴く",
          "tc": "我一定要揭發林的企圖。",
          "sc": "我一定要揭发林的企图。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270753,
          "spk": "帷 (トバリ)",
          "ja": "さあ、後を追って",
          "tc": "來吧，快跟上！",
          "sc": "来吧，快跟上！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270760,
          "spk": "帷 (トバリ)",
          "ja": "リンの家に入りましょう",
          "tc": "潛入林的家裡吧。",
          "sc": "潜入林的家里吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4714,
      "rec_id": "TALK_ID_10_0402_024_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270782,
          "spk": "帷 (トバリ)",
          "ja": "止まって",
          "tc": "等等。",
          "sc": "等等。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4715,
      "rec_id": "TALK_ID_10_0402_024_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270804,
          "spk": "帷 (トバリ)",
          "ja": "あの廊下の先は行き止まりのはず",
          "tc": "那條走廊是死路才對……",
          "sc": "那条走廊是死路才对……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270824,
          "spk": "驹子 (コマコ)",
          "ja": "足音が聞こえるね",
          "tc": "我有聽到腳步聲。",
          "sc": "我听见脚步声了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4716,
      "rec_id": "TALK_ID_10_0402_024_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270842,
          "spk": "帷 (トバリ)",
          "ja": "歩き回っているようだけど……",
          "tc": "聽起來像是在來回走動……",
          "sc": "听起来像是在来回走动……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4717,
      "rec_id": "TALK_ID_10_0402_024_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270860,
          "spk": "驹子 (コマコ)",
          "ja": "……なにをしてるのかな",
          "tc": "……不知道是在做什麼呢？",
          "sc": "……不知道是在做什么呢？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270871,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4718,
      "rec_id": "TALK_ID_10_0402_024_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270899,
          "spk": "驹子 (コマコ)",
          "ja": "あ、あれ……？",
          "tc": "奇、奇怪了……？",
          "sc": "奇、奇怪了……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270906,
          "spk": "驹子 (コマコ)",
          "ja": "リンは……",
          "tc": "林人呢……",
          "sc": "林人呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4719,
      "rec_id": "TALK_ID_10_0402_024_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270924,
          "spk": "驹子 (コマコ)",
          "ja": "どうしようトバリ、",
          "tc": "帷，怎麼辦，",
          "sc": "帷，怎么办，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270931,
          "spk": "驹子 (コマコ)",
          "ja": "見失っちゃったよ",
          "tc": "我們追丟了啦！",
          "sc": "我们追丢了啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270944,
          "spk": "帷 (トバリ)",
          "ja": "ここだったのね……",
          "tc": "是這裡沒錯吧……",
          "sc": "是这里没错吧……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270957,
          "spk": "驹子 (コマコ)",
          "ja": "え……",
          "tc": "咦……",
          "sc": "咦……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4720,
      "rec_id": "TALK_ID_10_0402_024_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270975,
          "spk": "帷 (トバリ)",
          "ja": "リンはたしかにここに来たのね？",
          "tc": "林剛剛確實來過這裡吧？",
          "sc": "林刚刚确实来过这里吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270988,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん……",
          "tc": "啊、嗯……",
          "sc": "啊、嗯……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270995,
          "spk": "驹子 (コマコ)",
          "ja": "この廊下を歩いて行ったけど……",
          "tc": "她明明通過了這條走廊……",
          "sc": "她明明通过了这条走廊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4721,
      "rec_id": "TALK_ID_10_0402_024_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271013,
          "spk": "帷 (トバリ)",
          "ja": "どこかに仕掛けがあるはず",
          "tc": "所以這裡應該有什麼機關才對。",
          "sc": "所以这里应该有什么机关才对。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271020,
          "spk": "帷 (トバリ)",
          "ja": "探しましょう",
          "tc": "我們來找找吧。",
          "sc": "我们来找找吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4722,
      "rec_id": "TALK_ID_10_0402_025_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271046,
          "spk": "帷 (トバリ)",
          "ja": "この廊下に何か仕掛けがあるはず",
          "tc": "這條走廊上應該有什麼機關才對。",
          "sc": "这条走廊上应该有什么机关才对。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271064,
          "spk": "帷 (トバリ)",
          "ja": "アンタも探しなさい",
          "tc": "你也幫忙一起找。",
          "sc": "你也帮忙一起找。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4723,
      "rec_id": "TALK_ID_10_0402_025_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271088,
          "spk": "驹子 (コマコ)",
          "ja": "リン、どこへ消えちゃったんだろ……",
          "tc": "林消失去哪了呢……",
          "sc": "林消失去哪了呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4724,
      "rec_id": "TALK_ID_10_0402_026_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271108,
          "spk": "主角心声/旁白/选项",
          "ja": "壁板の隙間から紐が出ている……",
          "tc": "牆壁的縫隙有條繩子……",
          "sc": "墙壁的缝隙有条绳子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271115,
          "spk": "主角心声/旁白/选项",
          "ja": "持ってみよう！",
          "tc": "拉拉看吧！",
          "sc": "拉拉看吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4725,
      "rec_id": "TALK_ID_10_0402_026_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271137,
          "spk": "驹子 (コマコ)",
          "ja": "あ、開いたよ、トバリ！",
          "tc": "啊，打開了耶，帷！",
          "sc": "啊，打开了呢，帷！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4726,
      "rec_id": "TALK_ID_10_0402_026_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271155,
          "spk": "驹子 (コマコ)",
          "ja": "<player>、すごい！",
          "tc": "<player>，你好厲害！",
          "sc": "<player>，你好厉害！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4727,
      "rec_id": "TALK_ID_10_0402_026_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271173,
          "spk": "帷 (トバリ)",
          "ja": "ちょっとずつ閉まっている……",
          "tc": "慢慢關起來了……",
          "sc": "慢慢关起来了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271180,
          "spk": "帷 (トバリ)",
          "ja": "急いで進みましょう",
          "tc": "我們趕快進去吧。",
          "sc": "我们赶快进去吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4728,
      "rec_id": "TALK_ID_10_0402_027_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271208,
          "spk": "帷 (トバリ)",
          "ja": "玄関から出ていく気配がないと思っていたら……",
          "tc": "我才在想，林不像是從玄關出去的……",
          "sc": "我才在想，林不像是从玄关出去的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271215,
          "spk": "帷 (トバリ)",
          "ja": "リンは、この通路を使って外へ出ていたのね",
          "tc": "原來她都是走這條通道啊。",
          "sc": "原来她都是走这条通道啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4729,
      "rec_id": "TALK_ID_10_0402_027_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271238,
          "spk": "驹子 (コマコ)",
          "ja": "ここは……どこだろう",
          "tc": "這裡……是哪裡啊？",
          "sc": "这里……是哪里啊？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271245,
          "spk": "驹子 (コマコ)",
          "ja": "こんなところ入ったことないけど……",
          "tc": "我從來沒進來過這種地方……",
          "sc": "我从来没进来过这种地方……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271258,
          "spk": "帷 (トバリ)",
          "ja": "隠されていたということは、",
          "tc": "既然是隱藏的通道，",
          "sc": "既然是隐藏的通道，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 271265,
          "spk": "帷 (トバリ)",
          "ja": "きっとロクでもない場所に",
          "tc": "我想八成……",
          "sc": "我想八成……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 271272,
          "spk": "帷 (トバリ)",
          "ja": "繋がっているはず……",
          "tc": "不會通往什麼正經的地方吧。",
          "sc": "不会通往什么正经的地方吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 271285,
          "spk": "驹子 (コマコ)",
          "ja": "リンは……",
          "tc": "林人呢……",
          "sc": "林人呢……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 271292,
          "spk": "驹子 (コマコ)",
          "ja": "この先で一体なにを……",
          "tc": "在這條路的另一端在做些什麼呢……",
          "sc": "在这条路的另一端在做些什么呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4730,
      "rec_id": "TALK_ID_10_0402_027_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271310,
          "spk": "帷 (トバリ)",
          "ja": "さあ、行きましょう",
          "tc": "好了，我們走吧。",
          "sc": "好了，我们走吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271317,
          "spk": "帷 (トバリ)",
          "ja": "リンを追いかけないと",
          "tc": "得追上林才行。",
          "sc": "得追上林才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4731,
      "rec_id": "TALK_ID_10_0402_027_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271335,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん……",
          "tc": "啊、嗯……",
          "sc": "啊、嗯……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4732,
      "rec_id": "TALK_ID_10_0402_029_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271361,
          "spk": "帷 (トバリ)",
          "ja": "止まって……",
          "tc": "等等……",
          "sc": "等等……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4733,
      "rec_id": "TALK_ID_10_0402_029_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271377,
          "spk": "帷 (トバリ)",
          "ja": "リンだ",
          "tc": "是林。",
          "sc": "是林。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4734,
      "rec_id": "TALK_ID_10_0402_029_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271401,
          "spk": "林 (リン)",
          "ja": "此の供物の数々、",
          "tc": "謹此將諸多供品，",
          "sc": "谨此将诸多供品，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271408,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉りまつる",
          "tc": "悉數虔誠供奉予祢。",
          "sc": "悉数虔诚供奉予你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271417,
          "spk": "林 (リン)",
          "ja": "今宵の闇、この地の境もろとも、",
          "tc": "亦將今宵之闇與此地之境界，",
          "sc": "亦将今宵之暗与此地之境界，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 271424,
          "spk": "林 (リン)",
          "ja": "御身に捧げ奉る",
          "tc": "悉數供奉予祢。",
          "sc": "悉数供奉予你。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 271433,
          "spk": "林 (リン)",
          "ja": "されば――願わくは、御力を以て応え給え",
          "tc": "故此──但求祢展現神威，應我所求。",
          "sc": "故此——但求你展现神威，应我所求。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4735,
      "rec_id": "TALK_ID_10_0402_029_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271464,
          "spk": "林 (リン)",
          "ja": "守り主様、いいえ、ヅ主よ……",
          "tc": "守護神啊，不，津主啊……",
          "sc": "守护神啊，不，津主啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271471,
          "spk": "林 (リン)",
          "ja": "さあ、今日こそ成し遂げてもらうわよ",
          "tc": "來吧，今天一定要讓祢達成使命。",
          "sc": "来吧，今天一定要让你达成使命。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271480,
          "spk": "林 (リン)",
          "ja": "行きましょうか、封印の場所へ",
          "tc": "我們走吧，前往封印的所在。",
          "sc": "我们走吧，前往封印的所在。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 271487,
          "spk": "林 (リン)",
          "ja": "儀式の準備をしなくては",
          "tc": "得進行儀式的準備才行。",
          "sc": "得进行仪式的准备才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4736,
      "rec_id": "TALK_ID_10_0402_029_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271513,
          "spk": "驹子 (コマコ)",
          "ja": "い、いまのは……",
          "tc": "剛、剛才那是……",
          "sc": "刚、刚才那是……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4737,
      "rec_id": "TALK_ID_10_0402_029_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271531,
          "spk": "帷 (トバリ)",
          "ja": "見たでしょう",
          "tc": "你們都看到了吧。",
          "sc": "你们都看到了吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271538,
          "spk": "帷 (トバリ)",
          "ja": "リンは化け物を呼ぶことができる……",
          "tc": "林有能力召喚怪物……",
          "sc": "林有能力召唤怪物……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4738,
      "rec_id": "TALK_ID_10_0402_029_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271556,
          "spk": "帷 (トバリ)",
          "ja": "ああやって、深夜に徘徊する怪物を",
          "tc": "她就是像這樣，",
          "sc": "她就是像这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271563,
          "spk": "帷 (トバリ)",
          "ja": "村に放っているの",
          "tc": "放怪物半夜在村裡遊蕩的。",
          "sc": "放怪物半夜在村里游荡的。"
