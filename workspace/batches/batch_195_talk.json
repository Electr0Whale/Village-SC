    {
      "file": "talk.dat",
      "rec_idx": 4699,
      "rec_id": "TALK_ID_10_0402_020_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 269918,
          "spk": "驹子 (コマコ)",
          "ja": "それより……",
          "tc": "先不說這個了……",
          "sc": "先不说这个了……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 269925,
          "spk": "驹子 (コマコ)",
          "ja": "トバリ、さっき辻に行ったらしいけど……",
          "tc": "帷，我聽說妳剛才去過岔路……",
          "sc": "帷，我听说你刚才去过岔路……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 269932,
          "spk": "驹子 (コマコ)",
          "ja": "なにか、用事があったの？",
          "tc": "是有什麼事情嗎？",
          "sc": "是有什么事情吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 269945,
          "spk": "帷 (トバリ)",
          "ja": "……は？　行ってないけど？",
          "tc": "……啊？我沒去啊？",
          "sc": "……啊？我没去啊？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 269952,
          "spk": "帷 (トバリ)",
          "ja": "この家の鍵は、",
          "tc": "我不是說過，",
          "sc": "我不是说过，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 269959,
          "spk": "帷 (トバリ)",
          "ja": "私が中から開けられないって言ったじゃない",
          "tc": "我沒辦法從這個房子的內側打開鎖嗎？",
          "sc": "我没办法从这个房子的内侧打开锁吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 269972,
          "spk": "驹子 (コマコ)",
          "ja": "う……そうだけど……",
          "tc": "唔……妳是說過……",
          "sc": "唔……你是说过……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 269979,
          "spk": "驹子 (コマコ)",
          "ja": "で、でも、<player>が",
          "tc": "可、可是<player>說，",
          "sc": "可、可是<player>说，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 269986,
          "spk": "驹子 (コマコ)",
          "ja": "辻でトバリを見たって言ってたから……",
          "tc": "他剛才在岔路有看到妳……",
          "sc": "他说刚才在岔路看见你了……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 269999,
          "spk": "帷 (トバリ)",
          "ja": "他の村人と見間違えたんじゃないの？",
          "tc": "應該是把其他村民誤認成我了吧？",
          "sc": "应该是把其他村民误认成我了吧？"
        },
        {
          "f_idx": 10,
          "pidx_tc": 270006,
          "spk": "帷 (トバリ)",
          "ja": "それに、私がどこで何をしてても",
          "tc": "再說了，我要在哪裡做什麼事情，",
          "sc": "再说了，我要在哪里做什么事情，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 270013,
          "spk": "帷 (トバリ)",
          "ja": "別に構わないでしょう？",
          "tc": "都是我的自由吧？",
          "sc": "都是我的自由吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4700,
      "rec_id": "TALK_ID_10_0402_020_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270031,
          "spk": "驹子 (コマコ)",
          "ja": "……う、うん",
          "tc": "……呃、嗯。",
          "sc": "……呃、嗯。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270038,
          "spk": "驹子 (コマコ)",
          "ja": "ごめんね……",
          "tc": "抱歉……",
          "sc": "抱歉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270051,
          "spk": "帷 (トバリ)",
          "ja": "時間がないの",
          "tc": "沒時間了，",
          "sc": "没时间了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270058,
          "spk": "帷 (トバリ)",
          "ja": "そんなどうでもいい話はやめて",
          "tc": "別講那些無關緊要的事了。",
          "sc": "别讲那些无关紧要的事了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270071,
          "spk": "驹子 (コマコ)",
          "ja": "……わかった",
          "tc": "……我知道了。",
          "sc": "……我知道了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 270084,
          "spk": "帷 (トバリ)",
          "ja": "早速だけど、",
          "tc": "事不宜遲，",
          "sc": "事不宜迟，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 270091,
          "spk": "帷 (トバリ)",
          "ja": "リンの後をつけに行きましょう",
          "tc": "我們快去跟蹤林吧。",
          "sc": "我们快去跟踪林吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4701,
      "rec_id": "TALK_ID_10_0402_020_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270109,
          "spk": "驹子 (コマコ)",
          "ja": "えっ……",
          "tc": "咦……",
          "sc": "咦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270116,
          "spk": "驹子 (コマコ)",
          "ja": "もう……？",
          "tc": "現在嗎……？",
          "sc": "现在吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270129,
          "spk": "帷 (トバリ)",
          "ja": "そろそろリンが動き出す時間だから",
          "tc": "林差不多要出動了，",
          "sc": "林差不多要出动了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270136,
          "spk": "帷 (トバリ)",
          "ja": "急いで準備して",
          "tc": "快做好準備吧。",
          "sc": "快做好准备吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270147,
          "spk": "帷 (トバリ)",
          "ja": "リンは屋敷のどこかを通って、",
          "tc": "林都是從宅邸的某處",
          "sc": "林都是从宅邸的某处"
        },
        {
          "f_idx": 5,
          "pidx_tc": 270154,
          "spk": "帷 (トバリ)",
          "ja": "敷地の外へ行っているみたいだから……",
          "tc": "通往外面去的樣子……",
          "sc": "通往外面去的样子……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 270165,
          "spk": "帷 (トバリ)",
          "ja": "まずはリンを見つけないとね",
          "tc": "得先找到林才行。",
          "sc": "得先找到林才行。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 270172,
          "spk": "帷 (トバリ)",
          "ja": "バレないように、慎重に行きましょう",
          "tc": "要小心行動，別被發現了。",
          "sc": "要小心行动，别被发现了。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 270185,
          "spk": "驹子 (コマコ)",
          "ja": "う、うん……",
          "tc": "啊、嗯……",
          "sc": "啊、嗯……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 270192,
          "spk": "驹子 (コマコ)",
          "ja": "わかったよ……",
          "tc": "我知道了……",
          "sc": "我知道了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4702,
      "rec_id": "TALK_ID_10_0402_021_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270218,
          "spk": "帷 (トバリ)",
          "ja": "<player>、あまり離れないで",
          "tc": "<player>，別離我太遠。",
          "sc": "<player>，别离我太远。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270229,
          "spk": "帷 (トバリ)",
          "ja": "……ハァ",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270236,
          "spk": "帷 (トバリ)",
          "ja": "もう少し緊張感持ってくれない？",
          "tc": "你神經可以繃緊一點嗎？",
          "sc": "你神经可以绷紧一点吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4703,
      "rec_id": "TALK_ID_10_0402_021_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270260,
          "spk": "驹子 (コマコ)",
          "ja": "<player>……",
          "tc": "<player>……",
          "sc": "<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270267,
          "spk": "驹子 (コマコ)",
          "ja": "これからどうなるんだろう……",
          "tc": "接下來到底會發生什麼事呢……",
          "sc": "接下来到底会发生什么事呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270276,
          "spk": "驹子 (コマコ)",
          "ja": "なんだか……嫌な予感がするよ……",
          "tc": "總覺得……有種不好的預感……",
          "sc": "总觉得……有种不好的预感……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4704,
      "rec_id": "TALK_ID_10_0402_021_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270300,
          "spk": "帷 (トバリ)",
          "ja": "アンタ状況わかってる？",
          "tc": "你還在狀況外嗎？",
          "sc": "你还在状况外吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270307,
          "spk": "帷 (トバリ)",
          "ja": "私たち、隠れて行動してるの",
          "tc": "我們正在偷偷行動耶！",
          "sc": "我们正在偷偷行动呢！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270318,
          "spk": "帷 (トバリ)",
          "ja": "だから、バレるような場所へ行っちゃダメでしょ",
          "tc": "當然不能跑到會被發現的地方去啊。",
          "sc": "当然不能跑到会被发现的地方去啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270325,
          "spk": "帷 (トバリ)",
          "ja": "はぁ……もうちょっと緊張感持ってよね……",
          "tc": "唉……你神經也繃緊一點好嗎……",
          "sc": "唉……你神经也绷紧一点好吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4705,
      "rec_id": "TALK_ID_10_0402_022_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270345,
          "spk": "莲实 (ハスミ)",
          "ja": "リン……今日も行くのですか",
          "tc": "林……妳今天也要去嗎？",
          "sc": "林……你今天也要去吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4706,
      "rec_id": "TALK_ID_10_0402_022_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270361,
          "spk": "帷 (トバリ)",
          "ja": "シッ",
          "tc": "噓！",
          "sc": "嘘！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270368,
          "spk": "帷 (トバリ)",
          "ja": "隠れて",
          "tc": "快躲起來。",
          "sc": "快躲起来。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4707,
      "rec_id": "TALK_ID_10_0402_022_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270390,
          "spk": "莲实 (ハスミ)",
          "ja": "そう毎日だと、",
          "tc": "像這樣每天都去的話，",
          "sc": "像这样每天都去的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270397,
          "spk": "莲实 (ハスミ)",
          "ja": "お体に障りますよ……",
          "tc": "身體會吃不消的……",
          "sc": "身体会吃不消的……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270410,
          "spk": "林 (リン)",
          "ja": "黙ってなさい、ハスミ",
          "tc": "住口，蓮實。",
          "sc": "住口，莲实。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270417,
          "spk": "林 (リン)",
          "ja": "私の仕事なの",
          "tc": "這是我的工作。",
          "sc": "这是我的工作。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 270430,
          "spk": "莲实 (ハスミ)",
          "ja": "でも……",
          "tc": "可是……",
          "sc": "可是……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 270443,
          "spk": "林 (リン)",
          "ja": "ハスミ、あなたの秘密は守りたくないの？",
          "tc": "蓮實，妳不想守護自己的祕密嗎？",
          "sc": "莲实，你不想守护自己的秘密吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 270456,
          "spk": "莲实 (ハスミ)",
          "ja": "そ、それは……",
          "tc": "呃，這……",
          "sc": "呃，这……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 270469,
          "spk": "林 (リン)",
          "ja": "このままでは、また十年前と同じことが起きるわ",
          "tc": "這樣下去10年前的事情又會重演。",
          "sc": "这样下去10年前的事情又会重演。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 270476,
          "spk": "林 (リン)",
          "ja": "最悪なことが全てね……",
          "tc": "最糟的情況全都會再次發生……",
          "sc": "最糟的情况全都会再次发生……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 270492,
          "spk": "林 (リン)",
          "ja": "そうなれば秘密どころじゃ済まされない",
          "tc": "一旦變成那樣，可就不是守住祕密那麼簡單了。",
          "sc": "一旦变成那样，可就不是守住秘密那么简单了。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 270499,
          "spk": "林 (リン)",
          "ja": "わかるでしょ？",
          "tc": "妳明白吧？",
          "sc": "你明白吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 270512,
          "spk": "莲实 (ハスミ)",
          "ja": "……はい",
          "tc": "……嗯。",
          "sc": "……嗯。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4708,
      "rec_id": "TALK_ID_10_0402_022_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270530,
          "spk": "林 (リン)",
          "ja": "……ハァ",
          "tc": "……唉。",
          "sc": "……唉。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270539,
          "spk": "林 (リン)",
          "ja": "ハスミ、まだ準備をしているだけだから",
          "tc": "蓮實，現在還只是準備階段，",
          "sc": "莲实，现在还只是准备阶段，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270546,
          "spk": "林 (リン)",
          "ja": "そんなに心配しないでちょうだい",
          "tc": "妳別擔心成那樣。",
          "sc": "你别担心成那样。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4709,
      "rec_id": "TALK_ID_10_0402_022_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 270564,
          "spk": "林 (リン)",
          "ja": "私がなんとかするから安心しなさい",
          "tc": "我會想辦法解決的，妳放心吧。",
          "sc": "我会想办法解决的，你放心吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 270571,
          "spk": "林 (リン)",
          "ja": "あなたもスミレも、大丈夫だから",
          "tc": "妳和堇怜都會沒事的。",
          "sc": "你和堇怜都会没事的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 270580,
          "spk": "林 (リン)",
          "ja": "じゃあ、ね",
          "tc": "那我走囉，",
          "sc": "那我走啦，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 270587,
          "spk": "林 (リン)",
          "ja": "ハスミ",
          "tc": "蓮實。",
          "sc": "莲实。"
        }
      ]
    },
    {
