          "f_idx": 1,
          "pidx_tc": 271715,
          "spk": "驹子 (コマコ)",
          "ja": "暗くて歩きづらいね……",
          "tc": "這麼暗很難走對吧……",
          "sc": "这么暗很难走对吧……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271730,
          "spk": "帷 (トバリ)",
          "ja": "大丈夫、ちょっと躓いただけ",
          "tc": "沒事，我只是稍微絆到了而已。",
          "sc": "没事，我只是稍微绊到了而已。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4743,
      "rec_id": "TALK_ID_10_0402_031_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271750,
          "spk": "帷 (トバリ)",
