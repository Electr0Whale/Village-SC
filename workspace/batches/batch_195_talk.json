          "spk": "驹子 (コマコ)",
          "ja": "お邪魔します……",
          "tc": "打擾了……",
          "sc": "打扰了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 269880,
          "spk": "帷 (トバリ)",
          "ja": "二人とも",
          "tc": "看來你們兩個",
          "sc": "看来你们两个"
        },
        {
          "f_idx": 3,
          "pidx_tc": 269887,
          "spk": "帷 (トバリ)",
          "ja": "約束を守ってくれたわね",
          "tc": "都有遵守約定呢。",
          "sc": "都有遵守约定呢。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 269900,
          "spk": "驹子 (コマコ)",
          "ja": "うん……",
