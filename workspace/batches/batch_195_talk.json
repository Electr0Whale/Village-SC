      "rec_id": "TALK_ID_10_0402_029_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271583,
          "spk": "驹子 (コマコ)",
          "ja": "ちょ、ちょっと、トバリ……",
          "tc": "等、等等啊，帷……",
          "sc": "等、等等啊，帷……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271590,
          "spk": "驹子 (コマコ)",
          "ja": "まさか着いていくの！？",
          "tc": "妳該不會要跟上去吧！？",
          "sc": "你该不会要跟上去吧！？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271603,
          "spk": "帷 (トバリ)",
          "ja": "当たり前でしょ",
          "tc": "那還用說。",
          "sc": "那还用说。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4740,
      "rec_id": "TALK_ID_10_0402_029_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 271621,
          "spk": "帷 (トバリ)",
          "ja": "私達の目的は、リンの目的を知ること",
          "tc": "我們的目的是弄清楚林的企圖，",
          "sc": "我们的目的是弄清楚林的企图，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 271628,
          "spk": "帷 (トバリ)",
          "ja": "そして秘密を暴くこと……",
          "tc": "然後再揭穿她的祕密。",
          "sc": "然后再揭穿她的秘密。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 271637,
          "spk": "帷 (トバリ)",
          "ja": "最後まで見届けてやるんだから",
          "tc": "我要親眼看到最後！",
          "sc": "我要亲眼看到最后！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 271655,
          "spk": "帷 (トバリ)",
          "ja": "ほら、アンタたちも着いてきなさい",
          "tc": "好了，你們還不跟上。",
          "sc": "好了，你们还不跟上。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 271662,
          "spk": "帷 (トバリ)",
          "ja": "リンと化け物を追わないと",
          "tc": "得追上林和那個怪物才行。",
          "sc": "得追上林和那个怪物才行。"
        }
      ]
    },
