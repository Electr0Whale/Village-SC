    {
      "file": "talk.dat",
      "rec_idx": 7441,
      "rec_id": "TALK_ID_70_2100_003_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 416915,
          "spk": "名护 (ナゴ)",
          "ja": "……キスケさんの仕業か",
          "tc": "……原來是木助先生害的。",
          "sc": "……原来是木助先生害的。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 416928,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさん、どうにかしてくれませんか？",
          "tc": "名護哥，可以請你想想辦法嗎？",
          "sc": "名护哥，可以请你想想办法吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 416935,
          "spk": "堇怜 (スミレ)",
          "ja": "これじゃ、勉強どころじゃないんですけど",
          "tc": "這樣根本沒辦法好好念書啊。",
          "sc": "这样根本没办法好好念书啊。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 416955,
          "spk": "名护 (ナゴ)",
          "ja": "気持ちは分かるが……",
          "tc": "我懂你的心情……",
          "sc": "我懂你的心情……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 416962,
          "spk": "名护 (ナゴ)",
          "ja": "俺はあくまで部外者で、雇われの身でもある",
          "tc": "再怎麼說我也是外人，只是被雇來的。",
          "sc": "再怎么说我也是外人，只是被雇来的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 416969,
          "spk": "名护 (ナゴ)",
          "ja": "雇い主に逆らうわけにもいかないんだよ",
          "tc": "不可能違抗雇主。",
          "sc": "不可能违抗雇主。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 416982,
          "spk": "堇怜 (スミレ)",
          "ja": "はあ……？",
          "tc": "唉……？",
          "sc": "唉……？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 416989,
          "spk": "堇怜 (スミレ)",
          "ja": "まだそんなこと言ってるんですか？",
          "tc": "你怎麼又說那種話啊？",
          "sc": "你怎么又说那种话啊？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 417002,
          "spk": "名护 (ナゴ)",
          "ja": "……俺はこの土地の人間じゃない",
          "tc": "……我並不是這裡的人。",
          "sc": "……我并不是这里的人。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 417009,
          "spk": "名护 (ナゴ)",
          "ja": "向こうには、置いてきた大切なものもある……",
          "tc": "我所重視的人事物都被我留在遠方……",
          "sc": "我所重视的人事物都被我留在远方……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 417029,
          "spk": "名护 (ナゴ)",
          "ja": "いつまでここにいるかも分からないし、",
          "tc": "也不知道還要在這裡待多久，",
          "sc": "也不知道还要在这里待多久，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 417036,
          "spk": "名护 (ナゴ)",
          "ja": "あまり口出しするのは……",
          "tc": "所以不好隨便提意見……",
          "sc": "所以不好随便提意见……"
        },
        {
          "f_idx": 15,
          "pidx_tc": 417056,
          "spk": "堇怜 (スミレ)",
          "ja": "えー？　居てくださいよ！",
          "tc": "欸？請留下來！",
          "sc": "诶？请留下来！"
        },
        {
          "f_idx": 16,
          "pidx_tc": 417063,
          "spk": "堇怜 (スミレ)",
          "ja": "勉強見てもらってるの、",
          "tc": "你幫忙看我的念書進度，",
          "sc": "你帮忙看我的念书进度，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 417070,
          "spk": "堇怜 (スミレ)",
          "ja": "すごく助かってるんですから！",
          "tc": "真的幫了我很大的忙！",
          "sc": "真的帮了我很大的忙！"
        },
        {
          "f_idx": 18,
          "pidx_tc": 417081,
          "spk": "堇怜 (スミレ)",
          "ja": "最初は警戒してたかもしれませんけど、",
          "tc": "雖然一開始對你保持戒心，",
          "sc": "虽然一开始对你保持戒心，"
        },
        {
          "f_idx": 19,
          "pidx_tc": 417088,
          "spk": "堇怜 (スミレ)",
          "ja": "ナゴさん、いい人だから",
          "tc": "但名護哥是個好人，",
          "sc": "但名护哥是个好人，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 417095,
          "spk": "堇怜 (スミレ)",
          "ja": "今はみんな頼りにしてると思いますけど",
          "tc": "所以現在大家都很看重你。",
          "sc": "所以现在大家都很看重你。"
        }
      ]
    },
    {
      "file": "talk.dat",
