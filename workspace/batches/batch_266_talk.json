        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7447,
      "rec_id": "TALK_ID_70_2100_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417561,
          "spk": "名护 (ナゴ)",
          "ja": "……いきなりで、ごめん",
          "tc": "……抱歉，這麼突然。",
          "sc": "……抱歉，这么突然。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417568,
          "spk": "名护 (ナゴ)",
          "ja": "けど、もう決めたんだ",
          "tc": "但是我已經決定了。",
          "sc": "但是我已经决定了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417579,
          "spk": "名护 (ナゴ)",
          "ja": "そうだな……",
          "tc": "也是……",
          "sc": "也是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417586,
          "spk": "名护 (ナゴ)",
          "ja": "キミが怒るのも、わかるよ",
          "tc": "妳會生氣也很正常。",
          "sc": "你会生气也很正常。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 417597,
          "spk": "名护 (ナゴ)",
          "ja": "でも、もう帰らない",
          "tc": "不過，我不會回去了。",
          "sc": "不过，我不会回去了。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 417604,
          "spk": "名护 (ナゴ)",
          "ja": "キミとも……もう会うことはないだろう",
          "tc": "我和妳……大概不會再見了吧。",
          "sc": "我和你……大概不会再见了吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 417615,
          "spk": "名护 (ナゴ)",
          "ja": "家具は、すべてあげるよ",
          "tc": "家具全都歸妳，",
          "sc": "家具全都归你，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 417622,
          "spk": "名护 (ナゴ)",
          "ja": "他の物も処分するなり、好きにしていい",
          "tc": "其他東西也都隨妳處置。",
          "sc": "其他东西也都随你处置。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 417640,
          "spk": "名护 (ナゴ)",
          "ja": "……自分勝手でごめん",
          "tc": "……很抱歉我這麼自私。",
          "sc": "……很抱歉我这么自私。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 417647,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃ、さよなら",
