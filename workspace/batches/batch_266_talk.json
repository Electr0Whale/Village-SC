        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7454,
      "rec_id": "TALK_ID_70_2100_005_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417989,
          "spk": "名护 (ナゴ)",
          "ja": "気が変わったんだ",
          "tc": "我改變主意了。",
