          "spk": "名护 (ナゴ)",
          "ja": "街よりも、この村の方が",
          "tc": "比起待在市區，",
          "sc": "比起待在市区，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 418007,
          "spk": "名护 (ナゴ)",
          "ja": "俺にあってると思っただけだよ",
          "tc": "我覺得這座村子更適合我。",
          "sc": "我觉得这座村子更适合我。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 418018,
          "spk": "名护 (ナゴ)",
          "ja": "そうだ、猫のおもちゃはあるかな？",
          "tc": "對了，有貓咪的玩具嗎？",
          "sc": "对了，有猫咪的玩具吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 418025,
          "spk": "名护 (ナゴ)",
          "ja": "なければ取り寄せてほしいんだけど",
          "tc": "沒有的話想請妳幫我訂。",
          "sc": "没有的话想请你帮我订。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 418038,
          "spk": "琪娜娜 (チナナ)",
          "ja": "次来る時までには仕入れておくよ",
          "tc": "你下次來之前我會備好貨的。",
          "sc": "你下次来之前我会备好货的。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 418058,
          "spk": "名护 (ナゴ)",
          "ja": "ありがとう",
          "tc": "謝謝。",
          "sc": "谢谢。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 418065,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃあ、よろしく頼むよ",
          "tc": "那就拜託妳了。",
          "sc": "那就拜托你了。"
        }
      ]
    },
