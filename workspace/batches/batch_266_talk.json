        {
          "f_idx": 1,
          "pidx_tc": 416666,
          "spk": "名护 (ナゴ)",
          "ja": "この前整理したばかりなのに……！",
          "tc": "明明之前才整理過的……！",
          "sc": "明明之前才整理过的……！"
        }
      ]
    },
    {
      "file": "talk.dat",
