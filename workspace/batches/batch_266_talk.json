    {
      "file": "talk.dat",
      "rec_idx": 7444,
      "rec_id": "TALK_ID_70_2100_003_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417280,
          "spk": "名护 (ナゴ)",
          "ja": "うわっ……おいおい、嘘だろ！？",
          "tc": "哇啊……等等，不會吧！？",
          "sc": "哇啊……等等，不会吧！？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417287,
          "spk": "名护 (ナゴ)",
          "ja": "なんでこの本がこんなところに……",
          "tc": "為什麼這本書會在這裡……",
          "sc": "为什么这本书会在这里……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417300,
          "spk": "堇怜 (スミレ)",
          "ja": "あ、それって確か、",
          "tc": "啊、我記得……",
          "sc": "啊、我记得……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417307,
          "spk": "堇怜 (スミレ)",
          "ja": "付近の土地の歴史を記した",
          "tc": "那本書記載了附近地區的歷史，",
          "sc": "那本书记载了附近地区的历史，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 417314,
          "spk": "堇怜 (スミレ)",
          "ja": "貴重な資料なんですっけ？",
          "tc": "是很貴重的資料對嗎？",
          "sc": "是很贵重的资料对吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 417327,
          "spk": "名护 (ナゴ)",
          "ja": "残っているのが奇跡みたいなものなんだが……",
          "tc": "能保存到現在真的是宛如奇蹟……",
          "sc": "能保存到现在真的是宛如奇迹……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 417334,
          "spk": "名护 (ナゴ)",
          "ja": "この村の人にとっては、古い物が身近すぎて、",
          "tc": "但對這個村子的人而言，古老的東西",
          "sc": "但对这个村子的人而言，古老的东西"
        },
        {
          "f_idx": 7,
          "pidx_tc": 417341,
          "spk": "名护 (ナゴ)",
          "ja": "その価値が実感できないんだろうな……",
          "tc": "隨處可見，所以感受不到其價值吧……",
          "sc": "随处可见，所以感受不到其价值吧……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 417352,
          "spk": "名护 (ナゴ)",
          "ja": "これは大切なものなのに……",
          "tc": "這明明是很重要的東西……",
          "sc": "这明明是很重要的东西……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 417359,
          "spk": "名护 (ナゴ)",
          "ja": "もしかして……俺が責任を持つべきなのか？",
          "tc": "難道說……我該負起責任嗎？",
          "sc": "难道说……我该负起责任吗？"
        },
        {
          "f_idx": 11,
          "pidx_tc": 417377,
          "spk": "名护 (ナゴ)",
          "ja": "キスケさんの奇行についても",
          "tc": "對於木助先生的奇怪行動，",
          "sc": "对于木助先生的奇怪行动，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 417384,
          "spk": "名护 (ナゴ)",
          "ja": "ちゃんと対策を考えたほうがいいかも……",
          "tc": "或許也該好好思考對策……",
          "sc": "或许也该好好思考对策……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 7445,
      "rec_id": "TALK_ID_70_2100_003_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 417409,
          "spk": "名护 (ナゴ)",
          "ja": "キスケさんの撃退法は……",
          "tc": "擊退木助先生的方法……",
          "sc": "击退木助先生的方法……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 417416,
          "spk": "名护 (ナゴ)",
          "ja": "二人にも、手伝いを頼めるかい……？",
          "tc": "可以拜託兩位幫忙嗎……？",
          "sc": "可以拜托两位帮忙吗……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 417423,
          "spk": "名护 (ナゴ)",
          "ja": "一緒に対応策を考えてほしいんだ",
          "tc": "我希望你們可以一起想想對策。",
          "sc": "我希望你们可以一起想想对策。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 417436,
          "spk": "堇怜 (スミレ)",
          "ja": "もちろん手伝うよ",
          "tc": "我當然會幫忙。",
          "sc": "我当然会帮忙。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 417443,
          "spk": "堇怜 (スミレ)",
          "ja": "ただ、図書館でそれをやり始めると、",
          "tc": "但是，一旦開始在圖書館想對策，",
          "sc": "但是，一旦开始在图书馆想对策，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 417450,
          "spk": "堇怜 (スミレ)",
          "ja": "僕、勉強しなくなるけど……いいですか？",
          "tc": "我就沒辦法念書了……可以嗎？",
          "sc": "我就没办法念书了……可以吗？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 417463,
          "spk": "名护 (ナゴ)",
          "ja": "それは困るな……",
          "tc": "那也很困擾……",
          "sc": "那也很困扰……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 417474,
          "spk": "名护 (ナゴ)",
          "ja": "じゃあ、俺の家を使うか？",
          "tc": "那就在我家吧？",
          "sc": "那就在我家吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 417481,
          "spk": "名护 (ナゴ)",
          "ja": "そこでキスケさんの対策会議をしよう",
          "tc": "在我家召開對付木助先生的會議。",
          "sc": "在我家召开对付木助先生的会议。"
        }
      ]
    },
    {
