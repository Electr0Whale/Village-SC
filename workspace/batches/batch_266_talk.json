      "rec_id": "TALK_ID_70_2100_003_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 416688,
          "spk": "堇怜 (スミレ)",
          "ja": "すみません、",
          "tc": "很抱歉，",
          "sc": "很抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 416695,
          "spk": "堇怜 (スミレ)",
          "ja": "僕も何度か片付けたんですけど……",
          "tc": "雖然我已經收拾過幾次了……",
