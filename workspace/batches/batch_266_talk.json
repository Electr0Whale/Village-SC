      "rec_id": "TALK_ID_70_2100_003_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 416767,
          "spk": "木助 (キスケ)",
          "ja": "はっはっはァ～",
          "tc": "哈、哈、哈～",
