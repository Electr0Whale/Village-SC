        {
          "f_idx": 3,
          "pidx_tc": 416717,
          "spk": "名护 (ナゴ)",
          "ja": "元はどれだけひどかったんだ……",
          "tc": "那原本到底有多亂啊……",
          "sc": "那原本到底有多乱啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 416728,
          "spk": "名护 (ナゴ)",
          "ja": "一体どうしてこんなことに……？",
          "tc": "究竟為什麼會變成這樣……？",
          "sc": "究竟为什么会变成这样……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 416741,
          "spk": "堇怜 (スミレ)",
          "ja": "それは……",
          "tc": "那是因為……",
          "sc": "那是因为……"
        }
      ]
    },
    {
      "file": "talk.dat",
