      "rec_id": "TALK_ID_10_0501_110_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302484,
          "spk": "主角心声/旁白/选项",
          "ja": "すごくボロボロの看板が立ってる……",
          "tc": "立著一面非常破舊的看板……",
          "sc": "立着一面非常破旧的看板……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302493,
          "spk": "主角心声/旁白/选项",
          "ja": "古すぎて",
          "tc": "實在太過老舊，",
          "sc": "实在太过老旧，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302500,
          "spk": "主角心声/旁白/选项",
          "ja": "何が書いてあるか",
          "tc": "看不懂",
          "sc": "看不懂"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302507,
          "spk": "主角心声/旁白/选项",
          "ja": "読めない……",
          "tc": "上面寫什麼……",
          "sc": "上面写什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5206,
      "rec_id": "TALK_ID_10_0501_111_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302527,
          "spk": "裕太 (ユータ)",
          "ja": "うーん……",
          "tc": "嗯……",
          "sc": "嗯……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302534,
          "spk": "裕太 (ユータ)",
          "ja": "この辺は同じ景色ばかりに見えるね",
          "tc": "這一帶的景色看起來都一樣呢。",
          "sc": "这一带的景色看起来都一样呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302545,
          "spk": "裕太 (ユータ)",
          "ja": "<player>、ちゃんと周りの景色を",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302552,
          "spk": "裕太 (ユータ)",
          "ja": "良く見て覚えておいておくれ",
          "tc": "你要好好觀察周遭的景色並且記牢囉！",
          "sc": "你要好好观察周遭的景色并且记牢啦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 302561,
          "spk": "裕太 (ユータ)",
          "ja": "それを目印に",
          "tc": "把那些當成認路的記號，",
          "sc": "把那些当成认路的记号，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 302568,
          "spk": "裕太 (ユータ)",
          "ja": "先へ進もう",
          "tc": "繼續前進吧。",
          "sc": "继续前进吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5207,
      "rec_id": "TALK_ID_10_0501_111_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302592,
          "spk": "裕太 (ユータ)",
          "ja": "それにしても……",
          "tc": "話說回來……",
          "sc": "话说回来……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302599,
          "spk": "裕太 (ユータ)",
          "ja": "なんだか、嫌な気配がするよ",
          "tc": "總覺得有種不好的預感。",
          "sc": "总觉得有种不好的预感。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302608,
          "spk": "裕太 (ユータ)",
          "ja": "村に来てから、",
          "tc": "明明我自從來到村裡後，",
          "sc": "明明我自从来到村里后，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302615,
          "spk": "裕太 (ユータ)",
          "ja": "だいぶ山歩きにも慣れたのに……",
          "tc": "已經滿習慣走山路了……",
          "sc": "已经满习惯走山路了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 302633,
          "spk": "裕太 (ユータ)",
          "ja": "普通の場所じゃない……",
          "tc": "這個地方不尋常……",
          "sc": "这个地方不寻常……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 302640,
          "spk": "裕太 (ユータ)",
          "ja": "不思議な気分になる場所だ……",
          "tc": "會讓人產生奇幻的感覺……",
          "sc": "会让人产生奇幻的感觉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5208,
      "rec_id": "TALK_ID_10_0501_111_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302664,
          "spk": "裕太 (ユータ)",
          "ja": "うう……",
          "tc": "唔唔……",
          "sc": "唔唔……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302671,
          "spk": "裕太 (ユータ)",
          "ja": "な、なにも起きないと",
          "tc": "但、但願……",
          "sc": "但、但愿……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302678,
          "spk": "裕太 (ユータ)",
          "ja": "いいんだけど……",
          "tc": "不會出什麼事才好……",
          "sc": "不会出什么事才好……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302689,
          "spk": "裕太 (ユータ)",
          "ja": "……ご、ごめんね",
          "tc": "……抱、抱歉喔！",
          "sc": "……抱、抱歉哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 302696,
          "spk": "裕太 (ユータ)",
          "ja": "俺がこんな調子じゃ",
          "tc": "我這樣子，",
          "sc": "我这样子，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 302703,
          "spk": "裕太 (ユータ)",
          "ja": "キミも不安になっちゃうね",
          "tc": "會害你也跟著不安吧。",
          "sc": "会害你也跟着不安吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 302712,
          "spk": "裕太 (ユータ)",
          "ja": "大丈夫、大丈夫だから",
          "tc": "不要緊，不會有事的，",
          "sc": "不要紧，不会有事的，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 302719,
          "spk": "裕太 (ユータ)",
          "ja": "先に進もうか……",
          "tc": "我們繼續前進吧……",
          "sc": "我们继续前进吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5209,
      "rec_id": "TALK_ID_10_0501_112_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302743,
          "spk": "裕太 (ユータ)",
          "ja": "あれ……<player>",
          "tc": "咦……<player>，",
          "sc": "咦……<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302750,
          "spk": "裕太 (ユータ)",
          "ja": "今日はもう、探索をやめるのかい？",
          "tc": "今天要停止探索了嗎？",
          "sc": "今天要停止探索了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302759,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302766,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5210,
      "rec_id": "TALK_ID_10_0501_112_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302784,
          "spk": "裕太 (ユータ)",
          "ja": "そうか",
          "tc": "這樣啊。",
          "sc": "这样啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302791,
          "spk": "裕太 (ユータ)",
          "ja": "キミも忙しいもんね……",
          "tc": "畢竟你也很忙……",
          "sc": "毕竟你也很忙……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302800,
          "spk": "裕太 (ユータ)",
          "ja": "残念だけど、",
          "tc": "雖然很可惜，",
          "sc": "虽然很可惜，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302807,
          "spk": "裕太 (ユータ)",
          "ja": "家は逃げたりしないからね",
          "tc": "不過反正房子也不會跑掉。",
          "sc": "不过反正房子也不会跑掉。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 302818,
          "spk": "裕太 (ユータ)",
          "ja": "……たぶんだけど",
          "tc": "……大概吧。",
          "sc": "……大概吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 302829,
          "spk": "裕太 (ユータ)",
          "ja": "キミの気が向いたら来てくれよ",
          "tc": "等你有空就來找我，",
          "sc": "等你有空就来找我，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 302836,
          "spk": "裕太 (ユータ)",
          "ja": "またここに集合しよう",
          "tc": "在這裡集合吧。",
          "sc": "在这里集合吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 302847,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、よろしくね",
          "tc": "那就麻煩你囉！",
          "sc": "那就麻烦你啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5211,
      "rec_id": "TALK_ID_10_0501_112_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302869,
          "spk": "裕太 (ユータ)",
          "ja": "え……まだ探すの……？",
          "tc": "咦……還要繼續找嗎……？",
          "sc": "咦……还要继续找吗……？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302880,
          "spk": "裕太 (ユータ)",
          "ja": "いや、ちがう、ちがうよ！",
          "tc": "不，不是啦、不是啦！",
          "sc": "不，不是啦、不是啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302887,
          "spk": "裕太 (ユータ)",
          "ja": "俺は決して嫌になったわけじゃなくて……！",
          "tc": "我真的沒有不想找的意思啦……！",
          "sc": "我真的没有不想找的意思啦……！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302896,
          "spk": "裕太 (ユータ)",
          "ja": "……うん、なんでもない",
          "tc": "……嗯，沒什麼。",
          "sc": "……嗯，没什么。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 302903,
          "spk": "裕太 (ユータ)",
          "ja": "じゃ、頑張って探そうね",
          "tc": "那我們繼續努力找吧。",
          "sc": "那我们继续努力找吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5212,
      "rec_id": "TALK_ID_10_0501_112_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302927,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、<player>……",
          "tc": "咦？<player>……",
          "sc": "咦？<player>……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 302934,
          "spk": "裕太 (ユータ)",
          "ja": "また来たのかい？",
          "tc": "你來了啊。",
          "sc": "你来了啊。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 302945,
          "spk": "裕太 (ユータ)",
          "ja": "実はさ、俺もまだここで迷ってて……",
          "tc": "其實我還在這裡猶豫不決……",
          "sc": "其实我还在这里犹豫不决……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 302952,
          "spk": "裕太 (ユータ)",
          "ja": "どうする？　やっぱり行く？",
          "tc": "怎麼樣？還是去吧？",
          "sc": "怎么样？还是去吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 302968,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 6,
          "pidx_tc": 302975,
          "spk": "主角心声/旁白/选项",
          "ja": "やだ",
          "tc": "不要",
          "sc": "不要"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5213,
      "rec_id": "TALK_ID_10_0501_112_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 302993,
          "spk": "裕太 (ユータ)",
          "ja": "……そっか",
          "tc": "……這樣啊。",
          "sc": "……这样啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 303004,
          "spk": "裕太 (ユータ)",
          "ja": "よかった……正直、今すぐ行くって言われたら、",
          "tc": "太好了……老實說，如果你說現在就出發，",
          "sc": "太好了……老实说，如果你说现在就出发，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 303011,
          "spk": "裕太 (ユータ)",
          "ja": "ちょっと覚悟が追いつかないところだったよ",
          "tc": "我可能都還沒有做好心理準備。",
          "sc": "我可能都还没有做好心理准备。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 303029,
          "spk": "裕太 (ユータ)",
          "ja": "あ、いや……今のは忘れて！",
          "tc": "啊，不……把剛才說的忘了！",
          "sc": "啊，不……把刚才说的忘了！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 303036,
          "spk": "裕太 (ユータ)",
          "ja": "まだビビってるわけじゃないからね！",
          "tc": "我並不是在害怕喔！",
          "sc": "我并不是在害怕哦！"
        },
        {
          "f_idx": 6,
          "pidx_tc": 303043,
          "spk": "裕太 (ユータ)",
          "ja": "ただ、その……慎重なだけで……",
          "tc": "只是……比較慎重一點……",
          "sc": "只是……比较慎重一点……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 303054,
          "spk": "裕太 (ユータ)",
          "ja": "だから、無理に急がなくていいよ",
          "tc": "所以說，不用那麼著急。",
          "sc": "所以说，不用那么着急。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 303061,
          "spk": "裕太 (ユータ)",
          "ja": "キミのペースで決めてね",
          "tc": "就按照你的步調來吧。",
          "sc": "就按照你的步调来吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5214,
      "rec_id": "TALK_ID_10_0501_112_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 303083,
          "spk": "裕太 (ユータ)",
          "ja": "……よし、わかった",
          "tc": "……好，我知道了。",
          "sc": "……好，我知道了。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 303090,
          "spk": "裕太 (ユータ)",
          "ja": "俺も覚悟を決めるよ……",
          "tc": "我也會下定決心……",
          "sc": "我也会下定决心……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 303101,
          "spk": "裕太 (ユータ)",
          "ja": "で、でも……",
          "tc": "可、可是……",
          "sc": "可、可是……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 303108,
          "spk": "裕太 (ユータ)",
          "ja": "暗くなる前に帰ろうね",
          "tc": "在天色變暗之前就要回去。",
          "sc": "在天色变暗之前就要回去。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 303115,
          "spk": "裕太 (ユータ)",
          "ja": "探索は、いつでもできるんだからね……！",
          "tc": "畢竟探險隨時都可以出發……！",
          "sc": "毕竟探险随时都可以出发……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 303126,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、早速……",
          "tc": "那就立刻……",
          "sc": "那就立刻……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 303133,
          "spk": "裕太 (ユータ)",
          "ja": "出発しようか……！",
          "tc": "出發吧……！",
          "sc": "出发吧……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5215,
      "rec_id": "TALK_ID_10_0501_113_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 303153,
          "spk": "主角心声/旁白/选项",
          "ja": "これが……",
          "tc": "這就是……",
          "sc": "这就是……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 303160,
          "spk": "主角心声/旁白/选项",
          "ja": "人面岩……なのかな？",
          "tc": "人面岩……嗎？",
          "sc": "人面岩……吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 303169,
          "spk": "主角心声/旁白/选项",
          "ja": "この岩は確かに顔に見える……！",
          "tc": "這塊岩石看起來的確很像人臉……！",
          "sc": "这块岩石看起来的确很像人脸……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5216,
      "rec_id": "TALK_ID_10_0501_114_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 303189,
          "spk": "裕太 (ユータ)",
          "ja": "着いた……",
          "tc": "終於到了……",
          "sc": "终于到了……"
        },
        {
