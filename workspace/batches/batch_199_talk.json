        },
        {
          "f_idx": 11,
          "pidx_tc": 280929,
          "spk": "帷 (トバリ)",
          "ja": "……コダマだけは、話が通じるから",
          "tc": "……因為只有木珠，可以溝通。",
          "sc": "……因为只有木珠，可以沟通。"
        }
      ]
    },
    {
      "file": "talk.dat",
