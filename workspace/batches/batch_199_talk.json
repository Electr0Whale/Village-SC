        {
          "f_idx": 5,
          "pidx_tc": 281377,
          "spk": "木助 (キスケ)",
          "ja": "慎ましく暮らすことしかできねぇんだ",
          "tc": "一邊過著戒慎恐懼的日子啊。",
          "sc": "一边过着戒慎恐惧的日子啊。"
