          "pidx_tc": 281051,
          "spk": "帷 (トバリ)",
          "ja": "神器の話を知っているの……？",
          "tc": "你知道神器的事情嗎……？",
          "sc": "你知道神器的事情吗……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 281058,
          "spk": "帷 (トバリ)",
          "ja": "探せばいいじゃない……！",
          "tc": "那一起找不就好了……！",
          "sc": "那一起找不就好了……！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 281065,
          "spk": "帷 (トバリ)",
          "ja": "コダマの願いが叶うかもしれないのよ！",
          "tc": "搞不好可以實現木珠的願望啊！",
          "sc": "说不定可以实现木珠的愿望啊！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4889,
      "rec_id": "TALK_ID_10_0403_051_21",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 281083,
          "spk": "木助 (キスケ)",
          "ja": "何度も言わせるな",
          "tc": "別讓我講這麼多次，",
          "sc": "别让我讲这么多次，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 281090,
          "spk": "木助 (キスケ)",
          "ja": "死んだ人間は生き返らない",
          "tc": "人死不能復生。",
          "sc": "人死不能复生。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 281101,
          "spk": "木助 (キスケ)",
          "ja": "てめぇでも聞いたことがあるだろう",
          "tc": "妳應該也聽過這個故事吧？",
          "sc": "你应该也听过这个故事吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 281110,
          "spk": "木助 (キスケ)",
          "ja": "美しかったイザナミは、死んだ後に醜くなった",
          "tc": "曾經美麗的伊邪那美，死後卻變得醜陋。",
          "sc": "曾经美丽的伊邪那美，死后却变得丑陋。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 281117,
          "spk": "木助 (キスケ)",
          "ja": "それどころか、黄泉まで迎えにやって来た、",
          "tc": "甚至想殺掉",
          "sc": "甚至想杀掉"
        },
        {
          "f_idx": 5,
          "pidx_tc": 281124,
          "spk": "木助 (キスケ)",
          "ja": "夫のイザナギを殺そうとした",
          "tc": "特地到黃泉迎接她的丈夫伊邪那岐。",
          "sc": "特地到黄泉迎接她的丈夫伊邪那岐。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 281135,
          "spk": "木助 (キスケ)",
          "ja": "もし生き返ったとしても、",
          "tc": "就算真的復活了，",
          "sc": "就算真的复活了，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 281142,
          "spk": "木助 (キスケ)",
          "ja": "そいつは幽霊の価値観に染まっちまっている",
          "tc": "那傢伙也早就染上幽靈的價值觀了。",
          "sc": "那家伙也早就染上幽灵的价值观了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 281160,
          "spk": "木助 (キスケ)",
          "ja": "死者が蘇っても、生者と共に生きることは無理だ",
          "tc": "即使死者復生，也沒辦法再與生者一同生活。",
          "sc": "即使死者复生，也没办法再与生者一同生活。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 281167,
          "spk": "木助 (キスケ)",
          "ja": "もし出来たとしても、",
          "tc": "就算辦到了，",
          "sc": "就算办到了，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 281174,
          "spk": "木助 (キスケ)",
          "ja": "絶対にロクでもないことが起きる",
          "tc": "也絕對不會有什麼好下場。",
          "sc": "也绝对不会有什么好下场。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 281187,
          "spk": "帷 (トバリ)",
          "ja": "でもコダマは……",
          "tc": "可是木珠祂……",
          "sc": "可是木珠他……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 281194,
          "spk": "帷 (トバリ)",
          "ja": "村がこうならないために",
          "tc": "就是為了不讓村子變成這樣，",
          "sc": "就是为了不让村子变成这样，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 281201,
          "spk": "帷 (トバリ)",
          "ja": "生贄にされてしまったんでしょ……？",
          "tc": "才被獻祭給土地神的吧……？",
          "sc": "才被献祭给土地神的吧……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4890,
      "rec_id": "TALK_ID_10_0403_051_22",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 281219,
          "spk": "帷 (トバリ)",
          "ja": "やっぱりこの村なんて嫌い……",
          "tc": "我果然還是很討厭這座村子……",
          "sc": "我果然还是很讨厌这座村子……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 281226,
          "spk": "帷 (トバリ)",
          "ja": "誰かの不自由の上に成り立っているだなんて……",
          "tc": "竟然建立在犧牲他人的自由之上……",
          "sc": "竟然建立在牺牲他人的自由之上……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 281246,
          "spk": "木助 (キスケ)",
          "ja": "じゃあてめぇはこの状態を受け入れるのか？",
          "tc": "那妳難道打算接受現狀嗎？",
          "sc": "那你难道打算接受现状吗？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 281253,
          "spk": "木助 (キスケ)",
          "ja": "一人の人柱を救うために、",
          "tc": "為了拯救一個遭到人祭的人，",
          "sc": "为了拯救一个遭到人祭的人，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 281260,
          "spk": "木助 (キスケ)",
          "ja": "村の全員が死に絶える道を選ぶ",
          "tc": "選擇讓村裡的所有人送死。",
          "sc": "选择让村里的所有人送死。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 281269,
          "spk": "木助 (キスケ)",
          "ja": "その勇気がてめぇにはあるのかよ",
          "tc": "妳最好有這種勇氣啦！",
          "sc": "你最好有这种勇气啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4891,
      "rec_id": "TALK_ID_10_0403_051_23",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 281287,
          "spk": "帷 (トバリ)",
          "ja": "そんなの……！",
          "tc": "這種事……！",
