      "rec_id": "TALK_ID_10_0403_051_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279531,
          "spk": "帷 (トバリ)",
          "ja": "コダマ、アンタにずっと謝りたかったの……",
          "tc": "木珠，我一直都想跟祢道歉……",
          "sc": "木珠，我一直都想跟你道歉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279538,
          "spk": "帷 (トバリ)",
          "ja": "あの時、守ってあげることが出来なくて……",
          "tc": "我那時候沒能保護祢……",
          "sc": "我那时候没能保护你……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279545,
          "spk": "帷 (トバリ)",
          "ja": "……ごめんなさい",
          "tc": "……對不起。",
          "sc": "……对不起。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279558,
          "spk": "木珠 (コダマ)",
          "ja": "え……",
          "tc": "咦……",
          "sc": "咦……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279567,
          "spk": "木珠 (コダマ)",
          "ja": "あ、ま、また、あえ、た……",
          "tc": "嗯，我、我們又……見面了……",
          "sc": "嗯，我、我们又……见面了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279574,
          "spk": "木珠 (コダマ)",
          "ja": "から……いい、よ",
          "tc": "所以……沒……關係。",
          "sc": "所以……没……关系。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279594,
          "spk": "帷 (トバリ)",
          "ja": "コダマ……",
          "tc": "木珠……",
          "sc": "木珠……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279601,
          "spk": "帷 (トバリ)",
          "ja": "本当は、アンタも助けてあげたい……",
          "tc": "其實，我也很想救祢……",
          "sc": "其实，我也很想救你……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 279612,
          "spk": "帷 (トバリ)",
          "ja": "寂しくて、苦しい気持ちは、",
          "tc": "那種寂寞又痛苦的心情，",
          "sc": "那种寂寞又痛苦的心情，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 279619,
          "spk": "帷 (トバリ)",
          "ja": "私もよくわかるから……",
          "tc": "我再清楚不過了……",
          "sc": "我再清楚不过了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4873,
      "rec_id": "TALK_ID_10_0403_051_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279637,
          "spk": "帷 (トバリ)",
          "ja": "ほら、樹を切ったアンタも謝ったら？",
          "tc": "來，把樹砍掉的你也來道歉吧！",
          "sc": "来，把树砍掉的你也来道歉吧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279644,
          "spk": "帷 (トバリ)",
          "ja": "いくらリンに逆らえないとはいえ……ね",
          "tc": "就算你是因為無法反抗林……也表示一下吧。",
          "sc": "就算你是因为无法反抗林……也表示一下吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4874,
      "rec_id": "TALK_ID_10_0403_051_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279667,
          "spk": "木珠 (コダマ)",
          "ja": "う、あ、……",
          "tc": "唔，啊……",
          "sc": "唔，啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279674,
          "spk": "木珠 (コダマ)",
          "ja": "あ、やまって、ほしい、わけ、じゃ……",
          "tc": "我……不是……想要……道歉……",
          "sc": "我……不是……想要……道歉……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279690,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279699,
          "spk": "木珠 (コダマ)",
          "ja": "う……も、いい……よ……",
          "tc": "唔……已經……沒……關係了……",
          "sc": "唔……已经……没……关系了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4875,
      "rec_id": "TALK_ID_10_0403_051_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279717,
          "spk": "帷 (トバリ)",
          "ja": "ねぇ、コダマ……",
          "tc": "那個，木珠……",
          "sc": "那个，木珠……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279724,
          "spk": "帷 (トバリ)",
          "ja": "アンタには、もう一つ謝らなきゃいけないわね",
          "tc": "還有一件事，我也得向祢道歉才行。",
          "sc": "还有一件事，我也得向你道歉才行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279735,
          "spk": "帷 (トバリ)",
          "ja": "彼ヶ津村がこんな状態になってしまったのは、",
          "tc": "彼津村現在會變成這種狀態，",
          "sc": "彼津村现在会变成这种状态，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279742,
          "spk": "帷 (トバリ)",
          "ja": "私のせいなの……",
          "tc": "都是我的錯……",
          "sc": "都是我的错……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279751,
          "spk": "帷 (トバリ)",
          "ja": "アンタの願いは、村で暮らすことでしょう？",
          "tc": "祢的願望，就是在村子裡生活吧？",
          "sc": "你的愿望，就是在村子里生活吧？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279758,
          "spk": "帷 (トバリ)",
          "ja": "そのために生き返りたいって言ってた",
          "tc": "祢還說過就是為了這個願望才想復活。",
          "sc": "你还说过就是为了这个愿望才想复活。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279776,
          "spk": "木珠 (コダマ)",
          "ja": "う、ん……",
          "tc": "嗯、嗯……",
          "sc": "嗯、嗯……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279787,
          "spk": "帷 (トバリ)",
          "ja": "アンタはこうして、日中でも姿を現せて",
          "tc": "雖然現在白天祢也能像這樣現形，",
          "sc": "虽然现在白天你也能像这样现形，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 279794,
          "spk": "帷 (トバリ)",
          "ja": "便利かもしれないんだけど……",
          "tc": "或許比較方便……",
          "sc": "或许比较方便……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 279805,
          "spk": "帷 (トバリ)",
          "ja": "でも、村の人たちが眠ってしまって……",
          "tc": "但是，現在村裡的人都睡著了……",
          "sc": "但是，现在村里的人都睡着了……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 279812,
          "spk": "帷 (トバリ)",
          "ja": "目覚めなくて……",
          "tc": "大家都醒不過來……",
          "sc": "大家都醒不过来……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 279823,
          "spk": "帷 (トバリ)",
          "ja": "誰もいない、",
          "tc": "這裡變得空無一人，",
          "sc": "这里变得空无一人，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 279830,
          "spk": "帷 (トバリ)",
          "ja": "まるで死んだような場所になってしまった……",
          "tc": "就像失去了生機的土地一樣……",
          "sc": "就像失去了生机的土地一样……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4876,
      "rec_id": "TALK_ID_10_0403_051_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279848,
          "spk": "帷 (トバリ)",
          "ja": "アンタが生き返って暮らしたい場所を、",
          "tc": "把祢復活後想要生活的地方搞成這樣，",
          "sc": "把你复活后想要生活的地方搞成这样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279855,
          "spk": "帷 (トバリ)",
          "ja": "こんな状態にしてしまってごめんなさい……",
          "tc": "我真的很抱歉……",
          "sc": "我真的很抱歉……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279866,
          "spk": "木珠 (コダマ)",
          "ja": "う、うん……それ、は……",
          "tc": "嗯、嗯……是啊……",
          "sc": "嗯、嗯……是啊……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279882,
          "spk": "木珠 (コダマ)",
          "ja": "たし、かに……",
          "tc": "也……是呢……",
          "sc": "也……是呢……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279889,
          "spk": "木珠 (コダマ)",
          "ja": "いき、かえっても、",
          "tc": "就算……復活了，",
          "sc": "就算……复活了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 279896,
          "spk": "木珠 (コダマ)",
          "ja": "ここじゃ、さみ、しい……ね……",
          "tc": "這樣子……感覺……好寂寞……呢……",
          "sc": "这样子……感觉……好寂寞……呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4877,
      "rec_id": "TALK_ID_10_0403_051_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 279914,
          "spk": "帷 (トバリ)",
          "ja": "だから、コダマ……",
          "tc": "所以說，木珠……",
          "sc": "所以说，木珠……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 279921,
          "spk": "帷 (トバリ)",
          "ja": "……聞きたいことがあるの",
          "tc": "……我有問題想問祢。",
          "sc": "……我有问题想问你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 279930,
          "spk": "帷 (トバリ)",
          "ja": "アンタは昔、村に居たのでしょう？",
          "tc": "祢以前也住在這座村子裡吧？",
          "sc": "你以前也住在这座村子里吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 279937,
          "spk": "帷 (トバリ)",
          "ja": "そして、土地神の、生贄にされてしまった……",
          "tc": "然後……被當成了土地神的活祭品……",
          "sc": "然后……被当成了土地神的活祭品……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 279944,
          "spk": "帷 (トバリ)",
          "ja": "そうよね……？",
          "tc": "是這樣對吧……？",
          "sc": "是这样对吧……？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 279955,
          "spk": "帷 (トバリ)",
          "ja": "だから、生き返って、",
          "tc": "所以祢才會想復活，",
          "sc": "所以你才会想复活，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 279962,
          "spk": "帷 (トバリ)",
          "ja": "もう一度村で暮らしたいって",
          "tc": "想再次在村子裡生活，",
          "sc": "想再次在村子里生活，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 279969,
          "spk": "帷 (トバリ)",
          "ja": "願っているのでしょう？",
          "tc": "是這樣子對吧？",
          "sc": "是这样子对吧？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 279980,
          "spk": "木珠 (コダマ)",
          "ja": "そう……",
          "tc": "沒錯……",
          "sc": "没错……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 279989,
          "spk": "木珠 (コダマ)",
          "ja": "むか、し……",
          "tc": "以前……",
          "sc": "以前……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 279996,
          "spk": "木珠 (コダマ)",
          "ja": "おおあなに、おち、て……",
          "tc": "我掉到……大洞……裡面……",
          "sc": "我掉到……大洞……里面……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 280003,
          "spk": "木珠 (コダマ)",
          "ja": "そ、れから……ずっと、ひと、りだったの……",
          "tc": "然、然後……一直……都是……一個人……",
          "sc": "然、然后……一直……都是……一个人……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 280016,
          "spk": "帷 (トバリ)",
          "ja": "やっぱり、アンタはあの大穴に落とされて、",
          "tc": "祢果然是以前的村民，",
          "sc": "你果然是以前的村民，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 280023,
          "spk": "帷 (トバリ)",
          "ja": "土地神の生贄になった昔の村の人なのね……",
          "tc": "被當成活祭品扔進那個大洞裡獻祭給土地神了……",
          "sc": "被当成活祭品扔进那个大洞里献祭给土地神了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4878,
      "rec_id": "TALK_ID_10_0403_051_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 280048,
          "spk": "帷 (トバリ)",
          "ja": "ああ、じゃあつまり、あの大穴からも",
          "tc": "啊，所以說，",
          "sc": "啊，所以说，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 280055,
          "spk": "帷 (トバリ)",
          "ja": "贄を捧げられるということか……",
          "tc": "也可以透過那個大洞來獻祭嗎……",
          "sc": "也可以透过那个大洞来献祭吗……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 280073,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 280086,
          "spk": "帷 (トバリ)",
          "ja": "コダマ……",
          "tc": "木珠……",
          "sc": "木珠……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 280093,
          "spk": "帷 (トバリ)",
          "ja": "私、村を元の状態に戻したいの……",
          "tc": "我想讓村子變回以前的樣子……",
          "sc": "我想让村子变回以前的样子……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 280104,
          "spk": "帷 (トバリ)",
          "ja": "リンはもう、何もしなくていいと言うけれど……",
          "tc": "雖然林說我什麼都不用做……",
          "sc": "虽然林说我什么都不用做……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 280111,
          "spk": "帷 (トバリ)",
          "ja": "……これは私が招いた事態なの",
          "tc": "……但這是我闖出的禍。",
          "sc": "……但这是我闯出的祸。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 280118,
          "spk": "帷 (トバリ)",
          "ja": "だから、私も、村のみんなのために手伝いたい",
          "tc": "所以，我也想為了村裡的大家出一份力。",
          "sc": "所以，我也想为了村里的大家出一份力。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 280129,
          "spk": "帷 (トバリ)",
          "ja": "これが罪ほろぼしになるかわからないけど……",
          "tc": "雖然不知道這算不算贖罪……",
          "sc": "虽然不知道这算不算赎罪……"
        },
        {
          "f_idx": 10,
          "pidx_tc": 280136,
          "spk": "帷 (トバリ)",
          "ja": "アンタが暮らしたいって言った、",
          "tc": "但我還是想把這裡",
          "sc": "但我还是想把这里"
        },
        {
          "f_idx": 11,
          "pidx_tc": 280143,
          "spk": "帷 (トバリ)",
          "ja": "元の彼ヶ津村に戻したい……",
          "tc": "變回那個祢想生活的彼津村……",
          "sc": "变回那个你想生活的彼津村……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 280154,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4879,
      "rec_id": "TALK_ID_10_0403_051_11",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 280172,
          "spk": "帷 (トバリ)",
          "ja": "アンタも昔、村で暮らしていたのでしょう？",
          "tc": "祢以前不是也住在村子裡嗎？",
          "sc": "你以前不是也住在村子里吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 280179,
          "spk": "帷 (トバリ)",
          "ja": "何か知らない？",
          "tc": "有任何線索嗎？",
          "sc": "有任何线索吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 280190,
          "spk": "帷 (トバリ)",
          "ja": "土地神をもう一度、封印して、",
          "tc": "有沒有什麼方法能重新封印土地神，",
          "sc": "有没有什么方法能重新封印土地神，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 280197,
          "spk": "帷 (トバリ)",
          "ja": "祟りから村を救う方法はないの？",
          "tc": "從作祟中拯救村子呢？",
          "sc": "从作祟中拯救村子呢？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 280215,
          "spk": "木珠 (コダマ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 280224,
          "spk": "木珠 (コダマ)",
          "ja": "む、らを、もとにもど、す",
          "tc": "雖、雖然我……不知道……",
          "sc": "虽、虽然我……不知道……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 280231,
          "spk": "木珠 (コダマ)",
          "ja": "ほうほ、うは、わからな、いけ、ど……",
          "tc": "怎麼把……村、村子……恢復……原狀……",
          "sc": "怎么把……村、村子……恢复……原状……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 280247,
          "spk": "木珠 (コダマ)",
          "ja": "……じん、ぎ",
          "tc": "……神……器，",
          "sc": "……神……器，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 280256,
          "spk": "木珠 (コダマ)",
          "ja": "じんぎ、が、み、っつ、",
          "tc": "只要，拿到……三件……",
          "sc": "只要，拿到……三件……"
        },
        {
          "f_idx": 11,
          "pidx_tc": 280263,
