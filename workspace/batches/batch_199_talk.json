          "pidx_tc": 281499,
          "spk": "木助 (キスケ)",
          "ja": "",
          "tc": "向神祈求是蠢貨才會做的事",
          "sc": "向神祈求是蠢货才会做的事"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 4893,
      "rec_id": "TALK_ID_10_0403_051_25",
