        {
          "f_idx": 2,
          "pidx_tc": 88750,
          "spk": "洋 (ヨウ)",
          "ja": "一体どこから来るんだろう？",
          "tc": "到底是從哪裡來的呢？",
          "sc": "到底是从哪里来的呢？"
        }
      ]
    },
    {
