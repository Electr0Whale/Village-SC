          "sc": "雨好大哦……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88743,
          "spk": "洋 (ヨウ)",
          "ja": "こんなにたくさんのお水、",
          "tc": "這麼多的水，",
          "sc": "这么多的水，"
