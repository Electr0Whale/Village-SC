      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87933,
          "spk": "洋 (ヨウ)",
          "ja": "この水車も、キスケさんが",
          "tc": "這個水車",
          "sc": "这个水车"
        },
        {
          "f_idx": 1,
          "pidx_tc": 87940,
          "spk": "洋 (ヨウ)",
          "ja": "直したりしてるのかな",
          "tc": "也是木助叔叔在修理的嗎？",
          "sc": "也是木助叔叔在修理的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 87951,
          "spk": "洋 (ヨウ)",
          "ja": "それともサザンカさん？",
          "tc": "還是茶梅姐姐呢？",
          "sc": "还是茶梅姐姐呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 87962,
          "spk": "洋 (ヨウ)",
          "ja": "コンノさんは……違うよね",
          "tc": "還是說是今野叔叔……應該不是吧。",
          "sc": "还是说是今野叔叔……应该不是吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2239,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2130",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 87993,
          "spk": "洋 (ヨウ)",
          "ja": "チナナさんに新しいお人形を、",
          "tc": "琪娜娜姐姐送了我",
          "sc": "琪娜娜姐姐送了我"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88000,
          "spk": "洋 (ヨウ)",
          "ja": "もらっちゃったの",
          "tc": "新的玩偶。",
          "sc": "新的玩偶。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88011,
          "spk": "洋 (ヨウ)",
          "ja": "お礼はちゃんと言ったけど、",
          "tc": "雖然我有好好道謝了，",
          "sc": "虽然有我有好好道谢了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88018,
          "spk": "洋 (ヨウ)",
          "ja": "お返しもしたほうがいいよね……どうしよう？",
          "tc": "但是不是要準備回禮比較好……怎麼辦呢？",
          "sc": "但是不是要准备回礼比较好……怎么办呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2240,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2131",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88049,
          "spk": "洋 (ヨウ)",
          "ja": "お人形さんたちも、たまには洗ってあげないと",
          "tc": "偶爾也要幫玩偶們洗洗澡才行。",
          "sc": "偶尔也要帮玩偶们洗洗澡才行。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88067,
          "spk": "洋 (ヨウ)",
          "ja": "でも、洗濯機は可哀想だし……",
          "tc": "可是放進洗衣機實在太可憐了……",
          "sc": "可是放进洗衣机实在太可怜了……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88074,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱり、手で洗うのが一番なのかな……",
          "tc": "果然還是用手洗才是最好的吧……",
          "sc": "果然还是用手洗才是最好的吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2241,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2132",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88105,
          "spk": "洋 (ヨウ)",
          "ja": "今日もとっても暑いですねー、こねこさん",
          "tc": "今天也好熱喔～小貓咪。",
          "sc": "今天也好热哦～小猫咪。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88112,
          "spk": "洋 (ヨウ)",
          "ja": "お腹を冷やすと風邪ひきますよ、こいぬさん",
          "tc": "肚子著涼的話會感冒的喔，小狗狗。",
          "sc": "肚子着凉的话会感冒的哦，小狗狗。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88130,
          "spk": "洋 (ヨウ)",
          "ja": "それじゃあ今夜は、みんなで一緒に寝ましょう",
          "tc": "那今天晚上大家就一起睡吧。",
          "sc": "那今天晚上大家就一起睡吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2242,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2200",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88161,
          "spk": "洋 (ヨウ)",
          "ja": "うーん、ネコちゃんが上手く折れないよ",
          "tc": "嗯……沒辦法摺出好看的貓咪啊。",
          "sc": "嗯……没办法折出好看的猫咪啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88168,
          "spk": "洋 (ヨウ)",
          "ja": "今度、ナゴさんに折り方を聞いてみよっと",
          "tc": "下次請名護叔叔教我怎麼摺好了。",
          "sc": "下次请名护叔叔教我怎么折好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2243,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2201",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88199,
          "spk": "洋 (ヨウ)",
          "ja": "紙飛行機って、上手く折ったら",
          "tc": "紙飛機如果摺得好的話，",
          "sc": "纸飞机如果折得好的话，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88206,
          "spk": "洋 (ヨウ)",
          "ja": "どれくらいまで飛ぶんだろう？",
          "tc": "不知道能飛多遠呢？",
          "sc": "不知道能飞多远呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88213,
          "spk": "洋 (ヨウ)",
          "ja": "お家の天井まで届くのかな？",
          "tc": "能夠碰到家裡的天花板嗎？",
          "sc": "能够碰到家里的天花板吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2244,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2202",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88237,
          "spk": "洋 (ヨウ)",
          "ja": "この前、ユータさんが新聞紙で",
          "tc": "之前裕太哥哥用報紙",
          "sc": "之前裕太哥哥用报纸"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88244,
          "spk": "洋 (ヨウ)",
          "ja": "ハリセンを作ってたの",
          "tc": "做了紙扇。",
          "sc": "做了纸扇。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88255,
          "spk": "洋 (ヨウ)",
          "ja": "あれって、折り紙っていうかなあ？",
          "tc": "那個也算是摺紙嗎？",
          "sc": "那个也算是折纸吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2245,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2210",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88286,
          "spk": "洋 (ヨウ)",
          "ja": "ずっと暑い日が続いていたけど、",
          "tc": "雖然最近天氣一直都很熱，",
          "sc": "虽然最近天气一直都很热，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88293,
          "spk": "洋 (ヨウ)",
          "ja": "こうやって雨が降ると、ちょっとだけ涼しいね",
          "tc": "但像這樣下起雨來，就比較涼快一點了。",
          "sc": "但像这样下起雨来，就比较凉快一点了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2246,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88324,
          "spk": "洋 (ヨウ)",
          "ja": "本当にすごい雨……！",
          "tc": "雨真的好大……！",
          "sc": "雨真的好大……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88335,
          "spk": "洋 (ヨウ)",
          "ja": "<player>のワンちゃんは、大丈夫かな……",
          "tc": "<player>養的狗狗應該沒事吧……？",
          "sc": "<player>养的狗狗应该没事吧……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88342,
          "spk": "洋 (ヨウ)",
          "ja": "あとでちょっと、様子を見に行ってみようかな？",
          "tc": "晚一點要不要去看看牠？",
          "sc": "晚一点要不要去看看它？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2247,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88366,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃん、雨の日は釣りに",
          "tc": "雖然叔叔說過",
          "sc": "虽然叔叔说过"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88373,
          "spk": "洋 (ヨウ)",
          "ja": "ぴったりって言ってたけど……",
          "tc": "下雨天最適合釣魚了……",
          "sc": "下雨天最适合钓鱼了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88384,
          "spk": "洋 (ヨウ)",
          "ja": "これじゃウキも見えないよね",
          "tc": "但這樣根本看不見浮標啊。",
          "sc": "但这样根本看不见浮标啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2248,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2213",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88408,
          "spk": "洋 (ヨウ)",
          "ja": "ねえ、<player>は川遊び、好き？",
          "tc": "問你喔，<player>你喜歡在河邊玩嗎？",
          "sc": "问你哦，<player>你喜欢在河边玩吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88419,
          "spk": "洋 (ヨウ)",
          "ja": "わたしはけっこう好きなの",
          "tc": "我還滿喜歡的喔。",
          "sc": "我还满喜欢的哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88426,
          "spk": "洋 (ヨウ)",
          "ja": "色んな生き物がいて面白いんだよ",
          "tc": "在這裡可以發現很多生物，很有趣。",
          "sc": "在这里可以发现很多生物，很有趣。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2249,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2214",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88450,
          "spk": "洋 (ヨウ)",
          "ja": "……こんなに暑いのに、",
          "tc": "……明明天氣這麼熱，",
          "sc": "……明明天气这么热，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88457,
          "spk": "洋 (ヨウ)",
          "ja": "どうして水の中は冷たいんだろう？",
          "tc": "為什麼水裡卻這麼冰呢？",
          "sc": "为什么水里却这么冰呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88464,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、ふしぎな感じ",
          "tc": "真是不可思議。",
          "sc": "真是不可思议。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2250,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2215",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88488,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱり、一人だとつまらないな",
          "tc": "果然自己一個人好無聊喔。",
          "sc": "果然自己一个人好无聊哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88506,
          "spk": "洋 (ヨウ)",
          "ja": "コマコちゃん、誘ったら、",
          "tc": "去找駒子姐姐的話，",
          "sc": "去找驹子姐姐的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88513,
          "spk": "洋 (ヨウ)",
          "ja": "一緒に水遊びしてくれるかなあ？",
          "tc": "她會願意陪我一起玩水嗎？",
          "sc": "她会愿意陪我一起玩水吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2251,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88537,
          "spk": "洋 (ヨウ)",
          "ja": "暑くて、あんまり食べる気が",
          "tc": "雖然天氣熱到",
          "sc": "虽然天气热到"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88544,
          "spk": "洋 (ヨウ)",
          "ja": "起きないけど……",
          "tc": "不太想吃東西……",
          "sc": "不太想吃东西……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88555,
          "spk": "洋 (ヨウ)",
          "ja": "みんなで食べるご飯は、",
          "tc": "不過跟大家一起吃飯的話，",
          "sc": "不过跟大家一起吃饭的话，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88562,
          "spk": "洋 (ヨウ)",
          "ja": "なんだか、いつもより食べられる気がする",
          "tc": "感覺就好像能比平常再多吃一點。",
          "sc": "感觉就好像能比平常再多吃一点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2252,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88593,
          "spk": "洋 (ヨウ)",
          "ja": "自由研究って、",
          "tc": "說到自由研究，",
          "sc": "说到自由研究，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88600,
          "spk": "洋 (ヨウ)",
          "ja": "なにを研究すればいいんだろう",
          "tc": "到底要研究什麼才好呢？",
          "sc": "到底要研究什么才好呢？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88611,
          "spk": "洋 (ヨウ)",
          "ja": "おじちゃんからの宿題だから、",
          "tc": "既然是叔叔的給的功課，",
          "sc": "既然是叔叔的给的功课，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88618,
          "spk": "洋 (ヨウ)",
          "ja": "やっぱりお料理とかかな？",
          "tc": "果然還是應該要來研究料理嗎？",
          "sc": "果然还是应该要来研究料理吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2253,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88642,
          "spk": "洋 (ヨウ)",
          "ja": "コマコちゃんって、",
          "tc": "雖然駒子姐姐",
          "sc": "虽然驹子姐姐"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88649,
          "spk": "洋 (ヨウ)",
          "ja": "いつもはとっても優しいし、",
          "tc": "總是非常溫柔，",
          "sc": "总是非常温柔，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88656,
          "spk": "洋 (ヨウ)",
          "ja": "困ったときに助けてくれるんだけど……",
          "tc": "會在我有困難的時候伸出援手……",
          "sc": "会在我有困难的时候伸出援手……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 88667,
          "spk": "洋 (ヨウ)",
          "ja": "お勉強の時は全然頼りにならないの……",
          "tc": "可是她在念書的時候卻完全靠不住……",
          "sc": "可是她在念书的时候却完全靠不住……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2254,
      "rec_id": "TALK_ID_GIRL_ROUTINE_20_110_2232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88698,
          "spk": "洋 (ヨウ)",
          "ja": "わたし、算数苦手だな……",
          "tc": "我很不擅長算數……",
          "sc": "我很不擅长算数……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 88705,
          "spk": "洋 (ヨウ)",
          "ja": "少数とか分数とか、問題文も難しくって",
          "tc": "像是小數點和分數之類的，題目也都好難懂，",
