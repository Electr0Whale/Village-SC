      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88774,
          "spk": "洋 (ヨウ)",
          "ja": "今日のすごい雲、見た？",
          "tc": "今天有很厲害的雲，你看到了嗎？",
          "sc": "今天有很厉害的云，你看到了吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 88792,
