      "rec_id": "TALK_ID_GIRL_ROUTINE_WALK_20_110_2800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 88736,
          "spk": "洋 (ヨウ)",
          "ja": "すごい雨……",
