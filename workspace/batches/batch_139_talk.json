        {
          "f_idx": 2,
          "pidx_tc": 88712,
          "spk": "洋 (ヨウ)",
          "ja": "よく間違えちゃうの……",
          "tc": "所以我常常搞錯答案……",
          "sc": "所以我常常搞错答案……"
