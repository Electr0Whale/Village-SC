      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10554,
          "spk": "木助 (キスケ)",
          "ja": "サザンカのところでカイロ買っとかねぇとな",
          "tc": "得去茶梅那裡買暖暖包才行。",
          "sc": "得去茶梅那里买暖暖包才行。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10561,
          "spk": "木助 (キスケ)",
          "ja": "仕事中、指先を温めるのに便利なんだよ",
          "tc": "工作的時候用來暖手很方便。",
          "sc": "工作的时候用来暖手很方便。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 477,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10592,
          "spk": "木助 (キスケ)",
          "ja": "よお、この雪の中に一人で散歩かよ",
          "tc": "嗨，你一個人在雪中散步啊。",
          "sc": "嗨，你一个人在雪中散步啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10599,
          "spk": "木助 (キスケ)",
          "ja": "……まあ気持ちはわかるけどな",
          "tc": "……雖然我能理解你的心情啦。",
          "sc": "……虽然我能理解你的心情啦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10610,
          "spk": "木助 (キスケ)",
          "ja": "雪の夜は怖いほど静かで穏やかだからな、",
          "tc": "下雪的夜晚安靜得嚇人，",
          "sc": "下雪的夜晚安静得吓人，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10617,
          "spk": "木助 (キスケ)",
          "ja": "物思いにふけって歩くのにぴったりだ",
          "tc": "所以很適合邊想事情邊散步。",
          "sc": "所以很适合边想事情边散步。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 478,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10648,
          "spk": "木助 (キスケ)",
          "ja": "冬に外で酒呑んで寝るのはやめろって",
          "tc": "雖然林告誡過我，",
          "sc": "虽然林告诫过我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10655,
          "spk": "木助 (キスケ)",
          "ja": "リンに忠告されたんだが……",
          "tc": "叫我冬天不要在外面喝酒喝到睡著……",
          "sc": "叫我冬天不要在外面喝酒喝到睡着……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10662,
          "spk": "木助 (キスケ)",
          "ja": "どうしようが俺の自由だろ？",
          "tc": "但我想怎麼做是我的自由吧？",
          "sc": "但我想怎么做是我的自由吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 479,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10686,
          "spk": "木助 (キスケ)",
          "ja": "最近、めっきり寒くなっちまったが……",
          "tc": "最近明顯變冷了啊……",
          "sc": "最近明显变冷了啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10693,
          "spk": "木助 (キスケ)",
          "ja": "風邪とか引いてねぇだろうな？",
          "tc": "你應該沒感冒吧？",
          "sc": "你应该没感冒吧？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10704,
          "spk": "木助 (キスケ)",
          "ja": "風邪は万病の元って言うし、気をつけろよ？",
          "tc": "都說感冒是萬病之源，你記得小心點啊。",
          "sc": "都说感冒是万病之源，你记得小心点啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 480,
      "rec_id": "TALK_ID_CARPENTER_ROUTINE_WALK_20_102_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10735,
          "spk": "木助 (キスケ)",
          "ja": "いててて……",
          "tc": "痛痛痛……",
          "sc": "痛痛痛……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10742,
          "spk": "木助 (キスケ)",
          "ja": "手のあちこちがひび割れてらぁ……",
          "tc": "手上好多地方都裂開了……",
          "sc": "手上好多地方都裂开了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10753,
          "spk": "木助 (キスケ)",
          "ja": "ま、これも大工の勲章ってな",
          "tc": "不過這也算是木匠的勳章吧。",
          "sc": "不过这也算是木匠的勋章吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 481,
      "rec_id": "TALK_ID_CARPENTER_BIRTHDAY_20_102_5000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10784,
          "spk": "木助 (キスケ)",
          "ja": "おう、<player>じゃねぇか",
          "tc": "喔，這不是<player>嗎。",
          "sc": "哟，这不是<player>嘛！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10791,
          "spk": "木助 (キスケ)",
          "ja": "いいところに来たな",
          "tc": "你來得正好。",
          "sc": "你来得正好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10798,
          "spk": "木助 (キスケ)",
          "ja": "今日はてめぇの誕生日だろ？",
          "tc": "今天是你的生日對吧？",
          "sc": "今天是你的生日对吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10809,
          "spk": "木助 (キスケ)",
          "ja": "おめでとう、<player>",
          "tc": "生日快樂，<player>。",
          "sc": "生日快乐啊，<player>！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 10816,
          "spk": "木助 (キスケ)",
          "ja": "ちょっと背も伸びたんじゃねえか？",
          "tc": "你是不是又長高了一點啊？",
          "sc": "你小子是不是又长高了一点啊？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 10827,
          "spk": "木助 (キスケ)",
          "ja": "せっかくの誕生日なんだ",
          "tc": "今天可是你的生日，",
          "sc": "今天可是你的生日，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 10834,
          "spk": "木助 (キスケ)",
          "ja": "村の連中にプレゼントよこせって、",
          "tc": "就儘管去跟村裡的人討禮物，",
          "sc": "就尽管去跟村里的人讨礼物，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 10841,
          "spk": "木助 (キスケ)",
          "ja": "遠慮せずにねだっていけよ",
          "tc": "別跟他們客氣。",
          "sc": "别跟他们客气。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 10852,
          "spk": "木助 (キスケ)",
          "ja": "もちろん、俺も用意してるぜ！",
          "tc": "當然，我也準備好了！",
          "sc": "当然，我也准备好了！"
        },
        {
          "f_idx": 9,
          "pidx_tc": 10859,
          "spk": "木助 (キスケ)",
          "ja": "めでたい日に手ぶらで帰すわけには",
          "tc": "這麼值得慶祝的日子，",
          "sc": "这么值得庆祝的日子，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 10866,
          "spk": "木助 (キスケ)",
          "ja": "いかねぇからな",
          "tc": "怎麼能讓你空手回去。",
          "sc": "怎么能让你空手回去。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 482,
      "rec_id": "TALK_ID_CARPENTER_BIRTHDAY_20_102_5001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 10890,
          "spk": "木助 (キスケ)",
          "ja": "それは、俺が木で作ったおもちゃだ",
          "tc": "那是我用木頭做的玩具，",
          "sc": "那是我用木头做的玩具，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 10897,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの好みがよくわかんなかったから、",
          "tc": "因為不太清楚你會喜歡什麼，",
          "sc": "因为不太清楚你会喜欢什么，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 10904,
          "spk": "木助 (キスケ)",
          "ja": "とりあえず色々なモンを作ってみたぜ",
          "tc": "所以就先做了各式各樣的東西試試。",
          "sc": "所以就先做了各式各样的东西试试。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 10915,
          "spk": "木助 (キスケ)",
          "ja": "頑丈な作りにしておいたんだ",
          "tc": "我特地做得很堅固，",
          "sc": "我特地做得很坚固，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 10922,
          "spk": "木助 (キスケ)",
          "ja": "落としたりぶつけたりしても、",
          "tc": "就算摔到或撞到，",
          "sc": "就算摔到或撞到，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 10929,
          "spk": "木助 (キスケ)",
          "ja": "簡単には壊れねぇはずだ",
          "tc": "應該也不太容易會壞掉。",
          "sc": "应该也不太容易会坏掉。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 10940,
          "spk": "木助 (キスケ)",
          "ja": "いくら仕事があるとはいえ、",
          "tc": "就算有工作在身，",
          "sc": "就算有工作在身，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 10947,
          "spk": "木助 (キスケ)",
          "ja": "てめぇはまだチビでガキなんだ",
          "tc": "你也還只是個小鬼頭。",
          "sc": "你也还只是个小鬼头。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 10954,
          "spk": "木助 (キスケ)",
          "ja": "たまには、そういうモンで遊んだりしろ",
          "tc": "偶爾也該玩玩這種東西。",
          "sc": "偶尔也该玩玩这种东西。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 10965,
          "spk": "木助 (キスケ)",
          "ja": "忙しかったら、いい場所に飾っておいてくれ",
          "tc": "要是太忙沒空玩，就找個地方擺著吧。",
          "sc": "要是太忙没空玩，就找个地方摆着吧。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 10972,
          "spk": "木助 (キスケ)",
          "ja": "それだけでもサマになるだろうからな",
          "tc": "光是拿來裝飾，看起來應該也挺有一回事的。",
          "sc": "光是拿来装饰，看起来应该也挺像模像样的。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 10990,
          "spk": "木助 (キスケ)",
          "ja": "そうだ、今度作り方も教えてやるよ",
          "tc": "對了，下次也教你怎麼做吧。",
          "sc": "对了，下次也教你怎么做吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 10997,
          "spk": "木助 (キスケ)",
          "ja": "無心でヤスリをかけて木を滑らかにするの、",
          "tc": "放空腦袋，專注地用砂紙把木頭磨到光滑，",
          "sc": "放空脑袋，专心地用砂纸把木头磨得光滑，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 11004,
          "spk": "木助 (キスケ)",
          "ja": "けっこう楽しいぜ",
          "tc": "其實還滿有趣的喔。",
          "sc": "其实还挺有趣的哦。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 11015,
          "spk": "木助 (キスケ)",
          "ja": "よし、もう用は済んだろ？",
          "tc": "好了，沒事了吧？",
          "sc": "好了，没事了吧？"
        },
        {
          "f_idx": 16,
          "pidx_tc": 11022,
          "spk": "木助 (キスケ)",
          "ja": "せっかくの誕生日なんだ、もう行けよ",
          "tc": "難得過生日，快去吧。",
          "sc": "难得过生日，快去吧。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 11029,
          "spk": "木助 (キスケ)",
          "ja": "とっとと他のヤツにもプレゼントを要求してこい",
          "tc": "趕快去跟其他人討禮物。",
          "sc": "赶紧去跟其他人要礼物吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
