          "pidx_tc": 118428,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>か……",
          "tc": "是<player>啊……",
          "sc": "是<player>啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118435,
          "spk": "四郎治 (シロージ)",
          "ja": "それは<tmpstr>か？",
          "tc": "那是<tmpstr>嗎？",
          "sc": "那是<tmpstr>吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118442,
