      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 489,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0053",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118548,
          "spk": "四郎治 (シロージ)",
          "ja": "ん……すまん",
          "tc": "嗯……抱歉，",
          "sc": "嗯……抱歉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118555,
          "spk": "四郎治 (シロージ)",
          "ja": "違っていたか",
          "tc": "我搞錯了。",
          "sc": "我搞错了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118566,
          "spk": "四郎治 (シロージ)",
          "ja": "それは<player>に必要なモノなんだな",
          "tc": "那是<player>你自己需要的東西吧，",
          "sc": "那是<player>你自己需要的东西吧，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118573,
          "spk": "四郎治 (シロージ)",
          "ja": "だったら大事にしてくれ",
          "tc": "既然如此，要好好珍惜喔。",
          "sc": "既然如此，就好好珍惜吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 490,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0060",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118597,
          "spk": "四郎治 (シロージ)",
          "ja": "よう、<player>",
          "tc": "嗨，<player>，",
          "sc": "嗨，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118604,
          "spk": "四郎治 (シロージ)",
          "ja": "ちゃんと飯は食ってんのか？",
          "tc": "你有在好好吃飯嗎？",
          "sc": "你有在好好吃饭吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118615,
          "spk": "四郎治 (シロージ)",
          "ja": "いつも同じもん食って飽きてんなら、",
          "tc": "如果你每次都吃一樣的吃到膩了，",
          "sc": "如果你每次都吃一样的吃到腻了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118622,
          "spk": "四郎治 (シロージ)",
          "ja": "調理法を変えてみるのも手だぜ",
          "tc": "那換換料理方式會是個好辦法。",
          "sc": "那换换料理方式会是个好办法。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118638,
          "spk": "四郎治 (シロージ)",
          "ja": "山菜やキノコを食うんなら",
          "tc": "想吃山菜和蘑菇，",
          "sc": "想吃山菜和蘑菇，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118645,
          "spk": "四郎治 (シロージ)",
          "ja": "「山の幸茶碗蒸し」にしてみるといい",
          "tc": "就試著做做看「山珍茶碗蒸」吧。",
          "sc": "就试着做做看“山珍茶碗蒸”吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 118663,
          "spk": "四郎治 (シロージ)",
          "ja": "サッと食えるし体が温まるから、",
          "tc": "可以快速吃完又可以溫暖身體，",
          "sc": "可以快速吃完又可以温暖身体，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 118670,
          "spk": "四郎治 (シロージ)",
          "ja": "寒い時期にちょうどいいんだ",
          "tc": "很適合寒冷的天氣。",
          "sc": "很适合寒冷的天气。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 118688,
          "spk": "四郎治 (シロージ)",
          "ja": "作り方、教えてやるから",
          "tc": "我告訴你怎麼做，",
          "sc": "我告诉你怎么做，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 118695,
          "spk": "四郎治 (シロージ)",
          "ja": "今度試してみろよ",
          "tc": "你下次就試試看吧。",
          "sc": "你下次就试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 491,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0061",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118719,
          "spk": "四郎治 (シロージ)",
          "ja": "なあ、<player>",
          "tc": "我問你，<player>，",
          "sc": "我问你，<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118726,
          "spk": "四郎治 (シロージ)",
          "ja": "記憶に残る料理って、何かあるか？",
          "tc": "你有沒有什麼印象深刻的料理？",
          "sc": "你有没有什么印象深刻的料理？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118744,
          "spk": "四郎治 (シロージ)",
          "ja": "昔、コマコが「ホワイトシチュー」を",
          "tc": "以前駒子曾經做過",
          "sc": "以前驹子曾经做过"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118751,
          "spk": "四郎治 (シロージ)",
          "ja": "作ったことがあってな",
          "tc": "「奶油燉菜」。",
          "sc": "“黄油炖菜”。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118762,
          "spk": "四郎治 (シロージ)",
          "ja": "本に出てきたのを見て",
          "tc": "大概是她在書上看到了，",
          "sc": "大概是她在书上看到了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118769,
          "spk": "四郎治 (シロージ)",
          "ja": "自分でも食べてみたくなったんだろうな",
          "tc": "自己也想吃吃看才做的吧。",
          "sc": "自己也想吃吃看才做的吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 118780,
          "spk": "四郎治 (シロージ)",
          "ja": "ま、具材の大きさはバラバラで",
          "tc": "雖然材料切得大小不一的，",
          "sc": "虽然材料切得大小不一的，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 118787,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと焦げたりしてて、",
          "tc": "而且還有一點焦掉了，",
          "sc": "而且还有一点焦掉了，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 118794,
          "spk": "四郎治 (シロージ)",
          "ja": "思い描いたシチューとは違ったみたいだけどな",
          "tc": "跟我想像中的燉菜不太一樣。",
          "sc": "跟我想像中的炖菜不太一样。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 118805,
          "spk": "四郎治 (シロージ)",
          "ja": "味も特別美味かったわけじゃない",
          "tc": "吃起來也不是特別美味，",
          "sc": "吃起来也不是特别美味，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 118812,
          "spk": "四郎治 (シロージ)",
          "ja": "けど、今でもたまに思い出すんだ",
          "tc": "但我現在偶爾都還會想起那個味道。",
          "sc": "但我现在偶尔都还会想起那个味道。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 118828,
          "spk": "四郎治 (シロージ)",
          "ja": "レシピは簡単だから、",
          "tc": "這食譜很簡單，",
          "sc": "这食谱很简单，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 118835,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も作ってみろよ",
          "tc": "<player>你也做做看吧。",
          "sc": "<player>你也做做看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 492,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0062",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 118859,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、お前さ、",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 118866,
          "spk": "四郎治 (シロージ)",
          "ja": "山の果物って食ったことあるか？",
          "tc": "你有吃過山上的水果嗎？",
          "sc": "你吃过山上的野果吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 118877,
          "spk": "四郎治 (シロージ)",
          "ja": "山を歩いていると実ってるだろ？",
          "tc": "在山裡走走，應該會看到很多果實吧？",
          "sc": "在山里走走，应该会看到很多果实吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 118884,
          "spk": "四郎治 (シロージ)",
          "ja": "ビワやキイチゴとか、アケビ……",
          "tc": "像是枇杷、樹莓、木通之類的……",
          "sc": "像是枇杷、树莓、木通之类的……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 118891,
          "spk": "四郎治 (シロージ)",
          "ja": "要するに、山で採れる果物のことだ",
          "tc": "都是可以在山裡採到的水果。",
          "sc": "都是可以在山里采到的水果。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 118902,
          "spk": "四郎治 (シロージ)",
          "ja": "果物とはいえお前みたいなガキにとっては、",
          "tc": "對妳這樣的小孩來說，",
          "sc": "对你这样的小孩来说，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 118909,
          "spk": "四郎治 (シロージ)",
          "ja": "少しクセがあって食べにくいかもしれないが、",
          "tc": "這些水果可能有些獨特，不太好入口，",
          "sc": "这些水果可能有些独特，不太好入口，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 118916,
          "spk": "四郎治 (シロージ)",
          "ja": "栄養があって、体にいいんだぜ",
          "tc": "但它們營養價值高，對身體很好。",
          "sc": "但它们营养价值高，对身体很好。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 118925,
          "spk": "四郎治 (シロージ)",
          "ja": "騙されたと思って食ってみろよ",
          "tc": "就當作是被我騙了，試試看吧。",
          "sc": "就当作是被我骗了，试试看吧。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 118932,
          "spk": "四郎治 (シロージ)",
          "ja": "あ、いや別に、騙すつもりはないんだけどな",
          "tc": "啊，不是，我也不是想要騙你，",
          "sc": "啊，不是，我也不是想要骗你，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 118939,
          "spk": "四郎治 (シロージ)",
          "ja": "きっと好きになると思うんだ",
          "tc": "我想你一定會喜歡的。",
          "sc": "我想你一定会喜欢的。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 118950,
          "spk": "四郎治 (シロージ)",
          "ja": "作り方だけ教えておくから",
          "tc": "我會教你怎麼做，",
          "sc": "我会教你怎么做，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 118957,
          "spk": "四郎治 (シロージ)",
          "ja": "気が向いたら食べてみてくれ",
          "tc": "你有興趣的話再做來吃吃看吧。",
          "sc": "你有兴趣的话再做来吃吃看吧。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 118966,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、作り方っつっても",
          "tc": "不過說是要教你怎麼做，",
          "sc": "不过说是要教你怎么做，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 118973,
          "spk": "四郎治 (シロージ)",
          "ja": "適当に盛り付けるだけなんだけどな",
          "tc": "其實也就只是隨便擺個盤而已。",
          "sc": "其实也就只是随便摆个盘而已。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 493,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0070",
      "lines": [
        {
