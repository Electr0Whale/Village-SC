          "tc": "我有事找你。",
          "sc": "我有事找你。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 119015,
          "spk": "四郎治 (シロージ)",
          "ja": "いい食材がいくつか手に入ったから、",
          "tc": "我拿到了一些不錯的食材，",
          "sc": "我拿到了一些不错的食材，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 119022,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかくだから調理して",
          "tc": "想說機會難得，",
          "sc": "想说机会难得，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 119029,
          "spk": "四郎治 (シロージ)",
          "ja": "お前にも食わせてやろうかと思ったんだ",
          "tc": "我想讓你也吃吃看。",
          "sc": "我想让你也吃吃看。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 119038,
          "spk": "四郎治 (シロージ)",
          "ja": "今日、俺の家に",
          "tc": "所以你今天要不要",
          "sc": "所以你今天要不要"
        },
        {
          "f_idx": 6,
          "pidx_tc": 119045,
          "spk": "四郎治 (シロージ)",
          "ja": "飯でも食いにこないか",
          "tc": "來我家吃飯？",
          "sc": "来我家吃饭？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 119056,
          "spk": "四郎治 (シロージ)",
          "ja": "時間は……午後６時くらいだと",
          "tc": "時間……",
          "sc": "时间……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 119063,
          "spk": "四郎治 (シロージ)",
          "ja": "助かるんだが、どうだ？",
          "tc": "就約晚上6點左右好了，怎麼樣？",
          "sc": "就约晚上6点左右好了，怎么样？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 119072,
          "spk": "主角心声/旁白/选项",
          "ja": "うん",
          "tc": "嗯",
          "sc": "嗯"
        },
        {
          "f_idx": 10,
          "pidx_tc": 119079,
          "spk": "主角心声/旁白/选项",
          "ja": "ううん",
          "tc": "不",
          "sc": "不"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 494,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0071",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 119097,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>、暇してたのか",
          "tc": "所以<player>你很閒，是嗎？",
          "sc": "所以<player>你很闲，是吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 119104,
          "spk": "四郎治 (シロージ)",
          "ja": "まあ、都合がついてよかった",
          "tc": "不過時間搭得上就好。",
          "sc": "不过时间搭得上就好。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 119115,
          "spk": "四郎治 (シロージ)",
          "ja": "それじゃあなにか、",
          "tc": "那我就做好美味的料理",
          "sc": "那我就做好美味的料理"
