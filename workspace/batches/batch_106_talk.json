        {
          "f_idx": 3,
          "pidx_tc": 119122,
          "spk": "四郎治 (シロージ)",
          "ja": "美味いもん作って待ってるから",
          "tc": "等你來了。",
          "sc": "等你来了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 119129,
          "spk": "四郎治 (シロージ)",
          "ja": "午後６時に頼むぜ",
          "tc": "記得晚上6點喔。",
          "sc": "就约晚上6点，交给你了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 495,
      "rec_id": "TALK_ID_LUMBERJACK_SPECIAL_20_103_0072",
      "lines": [
        {
          "f_idx": 0,
