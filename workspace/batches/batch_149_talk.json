    {
      "file": "talk.dat",
      "rec_idx": 2799,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 102987,
          "spk": "堇怜 (スミレ)",
          "ja": "このあたりは特に涼しくて",
          "tc": "這附近特別涼爽，",
          "sc": "这附近特别凉爽，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 102994,
          "spk": "堇怜 (スミレ)",
          "ja": "気持ちがいいんだ",
          "tc": "很舒服喔。",
          "sc": "很舒服哦。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2800,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103018,
          "spk": "堇怜 (スミレ)",
          "ja": "気のせいかもしれないけど、",
          "tc": "雖然可能只是我的錯覺，",
          "sc": "虽然可能只是我的错觉，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103025,
          "spk": "堇怜 (スミレ)",
          "ja": "こうしてるとなんとなく落ち着くんだ",
          "tc": "但像這樣待著心情就會平靜下來，",
          "sc": "但像这样待着心情就会平静下来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103036,
          "spk": "堇怜 (スミレ)",
          "ja": "なんならちょっと眠くなってきた……",
          "tc": "甚至都開始覺得有點想睡了……",
          "sc": "甚至都开始觉得有点想睡了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2801,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3213",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103060,
          "spk": "堇怜 (スミレ)",
          "ja": "この地蔵、ちょっと",
          "tc": "這尊地藏菩薩，",
          "sc": "这尊地藏菩萨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103067,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>の顔に似てる気がする……",
          "tc": "跟<player>好像有點像……",
          "sc": "跟<player>好像有点像……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103085,
          "spk": "堇怜 (スミレ)",
          "ja": "なんて、冗談だよ！",
          "tc": "我開玩笑的啦！",
          "sc": "我开玩笑的啦！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2802,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3214",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103109,
          "spk": "堇怜 (スミレ)",
          "ja": "涼しい季節になってくれて",
          "tc": "變成了涼爽的季節，",
          "sc": "变成了凉爽的季节，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103116,
          "spk": "堇怜 (スミレ)",
          "ja": "地蔵も嬉しいかもね",
          "tc": "地藏菩薩或許也很開心呢。",
          "sc": "地藏菩萨或许也很开心呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2803,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3215",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103147,
          "spk": "堇怜 (スミレ)",
          "ja": "どこ見ても落ち葉だらけだ",
          "tc": "到處都是落葉，",
          "sc": "到处都是落叶，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103154,
          "spk": "堇怜 (スミレ)",
          "ja": "もう、すっかり秋だねえ",
          "tc": "已經到秋天了啊。",
          "sc": "已经到秋天了啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2804,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103185,
          "spk": "堇怜 (スミレ)",
          "ja": "うん、美味しい……！",
          "tc": "嗯，真好吃……！",
          "sc": "嗯，真好吃……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103196,
          "spk": "堇怜 (スミレ)",
          "ja": "秋の食材もロッカクさんの",
          "tc": "秋天的食材和六角叔的廚藝",
          "sc": "秋天的食材和六角叔的厨艺"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103203,
          "spk": "堇怜 (スミレ)",
          "ja": "料理の腕も最高だね",
          "tc": "都是一級棒。",
          "sc": "都是一级棒。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2805,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103227,
          "spk": "堇怜 (スミレ)",
          "ja": "僕ももっと弓が上手くなったら、",
          "tc": "等我更擅長用弓箭之後，",
          "sc": "等我更擅长用弓箭之后，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103234,
          "spk": "堇怜 (スミレ)",
          "ja": "落ちる木の葉を射抜けるようになったり",
          "tc": "也有辦法",
          "sc": "也有办法"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103241,
          "spk": "堇怜 (スミレ)",
          "ja": "するのかな？",
          "tc": "射穿飄落的樹葉嗎？",
          "sc": "射穿飘落的树叶吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2806,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103265,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は弓の調子がいいぞ",
          "tc": "今天拉起弓來很順手。",
          "sc": "今天拉起弓来很顺手。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103272,
          "spk": "堇怜 (スミレ)",
          "ja": "これなら明日はうまく的に当てられそう",
          "tc": "感覺明天能順利地射中目標。",
          "sc": "感觉明天能顺利地射中目标。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103283,
          "spk": "堇怜 (スミレ)",
          "ja": "きっとコマコも褒めてくれるぞ",
          "tc": "駒子也一定會稱讚我的。",
          "sc": "驹子也一定会称赞我的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2807,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103314,
          "spk": "堇怜 (スミレ)",
          "ja": "釣竿の代わりに、弓矢で",
          "tc": "弓箭應該也能代替釣竿",
          "sc": "弓箭应该也能代替钓竿"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103321,
          "spk": "堇怜 (スミレ)",
          "ja": "魚を狙うのもありかもな？",
          "tc": "來抓魚吧？",
          "sc": "来抓鱼吧？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103339,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、矢の回収が大変かぁ……",
          "tc": "不過這樣要回收箭會很麻煩啊……",
          "sc": "不过这样要回收箭会很麻烦啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2808,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103370,
          "spk": "堇怜 (スミレ)",
          "ja": "涼しいから雨に当たると",
          "tc": "天氣很涼，所以只要一淋到雨",
          "sc": "天气很凉，所以只要一淋到雨"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103377,
          "spk": "堇怜 (スミレ)",
          "ja": "すぐに身体が冷えちゃうなぁ……",
          "tc": "身體馬上就會著涼了……",
          "sc": "身体马上就会着凉了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2809,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103401,
          "spk": "堇怜 (スミレ)",
          "ja": "秋の空に浮かんでる雲って",
          "tc": "你不覺得秋天在天上飄的雲",
          "sc": "你不觉得秋天在天上飘的云"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103408,
          "spk": "堇怜 (スミレ)",
          "ja": "なぜか美味しそうに見えない？",
          "tc": "看起來莫名好吃嗎？",
          "sc": "看起来莫名好吃吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2810,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103439,
          "spk": "堇怜 (スミレ)",
          "ja": "涼しいと勉強が捗るから助かるよ",
          "tc": "天氣這麼涼爽，就更能專心念書了。",
          "sc": "天气这么凉爽，就更能专心念书了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103457,
          "spk": "堇怜 (スミレ)",
          "ja": "この気候なら宿題もさくっと",
          "tc": "這樣的好天氣，",
          "sc": "这样的好天气，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103464,
          "spk": "堇怜 (スミレ)",
          "ja": "終わらせられそう",
          "tc": "看來功課也能夠輕鬆搞定。",
          "sc": "看来功课也能够轻松搞定。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2811,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103488,
          "spk": "堇怜 (スミレ)",
          "ja": "あっ、今の聞こえた？",
          "tc": "啊，被你聽見了嗎？",
          "sc": "啊，被你听见了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103499,
          "spk": "堇怜 (スミレ)",
          "ja": "恥ずかし～……",
          "tc": "真丟臉……",
          "sc": "真丢脸……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103506,
          "spk": "堇怜 (スミレ)",
          "ja": "さっきからずっとお腹が鳴っててさ……",
          "tc": "我的肚子從剛才開始就一直在叫……",
          "sc": "我的肚子从刚才开始就一直在叫……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103517,
          "spk": "堇怜 (スミレ)",
          "ja": "秋はやたらと腹が減るんだよなぁ……",
          "tc": "秋天果然肚子特別容易餓啊……",
          "sc": "秋天果然肚子特别容易饿啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2812,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103548,
          "spk": "堇怜 (スミレ)",
          "ja": "雨が降ったら、木からさらに葉っぱが落ちるね",
          "tc": "一旦下雨，樹上就會掉更多葉子下來。",
          "sc": "一旦下雨，树上就会掉更多叶子下来。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103555,
          "spk": "堇怜 (スミレ)",
          "ja": "この調子だと、すぐに山が",
          "tc": "照這樣下去，",
          "sc": "照这样下去，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103562,
          "spk": "堇怜 (スミレ)",
          "ja": "丸裸になっちゃうだろうな",
          "tc": "山很快就會變得光禿禿的了。",
          "sc": "山很快就会变得光秃秃的了。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103573,
          "spk": "堇怜 (スミレ)",
          "ja": "儚さってやつを感じるね",
          "tc": "有種虛幻無常的感覺呢。",
          "sc": "有种虚幻无常的感觉呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2813,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103604,
          "spk": "堇怜 (スミレ)",
          "ja": "さっき、ヨウが",
          "tc": "剛剛洋",
          "sc": "刚刚洋"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103611,
          "spk": "堇怜 (スミレ)",
          "ja": "綺麗な落ち葉を拾って僕に見せに来たんだ",
          "tc": "撿了很漂亮的落葉來給我看喔。",
          "sc": "捡了很漂亮的落叶来给我看哦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103622,
          "spk": "堇怜 (スミレ)",
          "ja": "葉っぱで喜べるなんて、ホントかわいいよね",
          "tc": "因為幾片葉子就這麼開心，她真的很可愛呢。",
          "sc": "因为几片叶子就这么开心，她真的很可爱呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2814,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103653,
          "spk": "堇怜 (スミレ)",
          "ja": "この時期、川辺はちょっと寒いんだけど、",
          "tc": "雖然這個時期的河邊確實有點冷，",
          "sc": "虽然这个时期的河边确实有点冷，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103660,
          "spk": "堇怜 (スミレ)",
          "ja": "子持ちアユは捨てがたいから、",
          "tc": "但抱卵香魚實在太有吸引力了，",
          "sc": "但抱卵香鱼实在太有吸引力了，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103667,
          "spk": "堇怜 (スミレ)",
          "ja": "つい粘って釣りしちゃうんだよね……",
          "tc": "所以總會忍不住待著繼續釣呢……",
          "sc": "所以总会忍不住待着继续钓呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2815,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103691,
          "spk": "堇怜 (スミレ)",
          "ja": "秋はスポーツの季節っていうけど、",
          "tc": "雖然說秋天是運動的季節，",
          "sc": "虽然说秋天是运动的季节，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103698,
          "spk": "堇怜 (スミレ)",
          "ja": "僕一人でできるスポーツはあるのかな……",
          "tc": "但有我一個人也進行的運動嗎……",
          "sc": "但有我一个人也进行的运动吗……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 103705,
          "spk": "堇怜 (スミレ)",
          "ja": "とりあえず走っておくか……",
          "tc": "總之先跑跑步吧……",
          "sc": "总之先跑跑步吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2816,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103729,
          "spk": "堇怜 (スミレ)",
          "ja": "雨音を聞きながら眠るのって",
          "tc": "聽著雨聲入眠",
          "sc": "听着雨声入眠"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103736,
          "spk": "堇怜 (スミレ)",
          "ja": "最高に気持ち良いんだよね",
          "tc": "真的超級舒服的。",
          "sc": "真的超级舒服的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2817,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103760,
          "spk": "堇怜 (スミレ)",
          "ja": "夜になると肌寒いよね……",
          "tc": "到了晚上有點冷啊……",
          "sc": "到了晚上有点冷啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103767,
          "spk": "堇怜 (スミレ)",
          "ja": "油断してると体調を崩しそうだよ",
          "tc": "感覺一不小心身體就會出狀況。",
          "sc": "感觉一不小心身体就会出状况。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2818,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103798,
          "spk": "堇怜 (スミレ)",
          "ja": "秋は空気が澄んでて空がキレイだよね",
          "tc": "秋天空氣清新，天空也很清澈呢。",
          "sc": "秋天空气清新，天空也很清澈呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 103805,
          "spk": "堇怜 (スミレ)",
          "ja": "ついつい上を見上げちゃうんだ",
          "tc": "忍不住就會抬頭往上看。",
          "sc": "忍不住就会抬头往上看。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 103823,
          "spk": "堇怜 (スミレ)",
          "ja": "星座の名前が分かれば、",
          "tc": "如果知道星座的名稱，",
          "sc": "如果知道星座的名称，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 103830,
          "spk": "堇怜 (スミレ)",
          "ja": "もっと楽しめるかもしれないな……",
          "tc": "應該會更有樂趣吧……",
          "sc": "应该会更有乐趣吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2819,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_3823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 103854,
          "spk": "堇怜 (スミレ)",
          "ja": "明日の夕飯は何にしよう",
          "tc": "明天晚餐該吃什麼呢？",
          "sc": "明天晚餐该吃什么呢？"
        },
        {
          "f_idx": 1,
