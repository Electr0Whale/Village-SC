  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 2759,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101238,
          "spk": "堇怜 (スミレ)",
          "ja": "こうも暑いと、アイスか",
          "tc": "天氣熱成這樣，就會很想吃冰，",
          "sc": "天气热成这样，就会很想吃冰，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101245,
          "spk": "堇怜 (スミレ)",
          "ja": "冷やしたスイカが食べたくなるよ",
          "tc": "或是冰鎮過的西瓜呢。",
          "sc": "或是冰镇过的西瓜呢。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101256,
          "spk": "堇怜 (スミレ)",
          "ja": "でも、節約しないといけないしなぁ",
          "tc": "但我又得省錢。",
          "sc": "但我又得省钱。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2760,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101280,
          "spk": "堇怜 (スミレ)",
          "ja": "ユータさんから、一緒にカブトムシを",
          "tc": "裕太哥約我",
          "sc": "裕太哥约我"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101287,
          "spk": "堇怜 (スミレ)",
          "ja": "捕まえに行こうって誘われてるんだ",
          "tc": "一起去抓獨角仙。",
          "sc": "一起去抓独角仙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101298,
          "spk": "堇怜 (スミレ)",
          "ja": "せっかくならデカいのを捕まえたいよな",
          "tc": "真想趁這個機會抓隻大隻的。",
          "sc": "真想趁这个机会抓只大只的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2761,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101329,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、水分は摂ってる？",
          "tc": "<player>，你有好好補充水分嗎？",
          "sc": "<player>，你有好好补充水分吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101347,
          "spk": "堇怜 (スミレ)",
          "ja": "暑いときはこまめに飲んだほうがいいって",
          "tc": "姊姊說過，天氣熱的時候",
          "sc": "姐姐说过，天气热的时候"
        },
        {
          "f_idx": 3,
          "pidx_tc": 101354,
          "spk": "堇怜 (スミレ)",
          "ja": "姉さんが言ってたよ",
          "tc": "最好要隨時補充水分。",
          "sc": "最好要随时补充水分。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2762,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101385,
          "spk": "堇怜 (スミレ)",
          "ja": "今日は雨降りだからか、",
          "tc": "也許是因為今天下雨，",
          "sc": "也许是因为今天下雨，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101392,
          "spk": "堇怜 (スミレ)",
          "ja": "さっき小さいカエルを見かけたんだ",
          "tc": "我在河邊看到了小小的青蛙。",
          "sc": "我在河边看到了小小的青蛙。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101403,
          "spk": "堇怜 (スミレ)",
          "ja": "何考えてるのかわかんないけど、",
          "tc": "不知道牠在想什麼，",
          "sc": "不知道它在想什么，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 101410,
          "spk": "堇怜 (スミレ)",
          "ja": "全然逃げなくて……食べてほしかったのかな？",
          "tc": "竟然完全不逃走……是想要我吃牠嗎？",
          "sc": "竟然完全不逃走……是想要我吃它吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2763,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101441,
          "spk": "堇怜 (スミレ)",
          "ja": "夏は脂が乗ったアユを釣れるのが",
          "tc": "夏天就是能釣到肥美香魚這點",
          "sc": "夏天就是能钓到肥美香鱼这点"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101448,
          "spk": "堇怜 (スミレ)",
          "ja": "いいところだよな～",
          "tc": "最棒了～",
          "sc": "最棒了～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101455,
          "spk": "堇怜 (スミレ)",
          "ja": "想像したらお腹が減ってきたよ",
          "tc": "光是想到就肚子餓了呢。",
          "sc": "光是想到就肚子饿了呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2764,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101479,
          "spk": "堇怜 (スミレ)",
          "ja": "<player>、暑くて参ってない？",
          "tc": "<player>，你是不是熱得受不了？",
          "sc": "<player>，你是不是热得受不了？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101486,
          "spk": "堇怜 (スミレ)",
          "ja": "涼みたくなったら川遊びでもしようよ",
          "tc": "想要消暑的話，就去河邊玩吧。",
          "sc": "想要消暑的话，就去河边玩吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 101504,
          "spk": "堇怜 (スミレ)",
          "ja": "この時期でも心臓が止まるぐらい冷たいんだぜ！",
          "tc": "即使是這個季節也冰到嚇死人喔！",
          "sc": "即使是这个季节也冰到吓死人哦！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 101511,
          "spk": "堇怜 (スミレ)",
          "ja": "きっと死ぬほど涼しくなれるよ！",
          "tc": "肯定涼死你！",
          "sc": "肯定凉死你！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2765,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101542,
          "spk": "堇怜 (スミレ)",
          "ja": "あちこちでセミを見かけるよな",
          "tc": "到處都可以看到蟬呢。",
          "sc": "到处都可以看到蝉呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101553,
          "spk": "堇怜 (スミレ)",
          "ja": "暇な日にでもヨウを誘って",
          "tc": "哪天有空",
          "sc": "哪天有空"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101560,
          "spk": "堇怜 (スミレ)",
          "ja": "捕まえに行こうかな",
          "tc": "就約洋一起去抓蟬好了。",
          "sc": "就约洋一起去抓蝉好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2766,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101584,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は雨が止むといいなぁ",
          "tc": "真希望明天不要下雨。",
          "sc": "真希望明天不要下雨。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101595,
          "spk": "堇怜 (スミレ)",
          "ja": "からっと晴れたせいで",
          "tc": "雖然要是突然出大太陽，",
          "sc": "虽然要是突然出大太阳，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101602,
          "spk": "堇怜 (スミレ)",
          "ja": "暑くなっても困るんだけどさ",
          "tc": "天氣變得超熱也很困擾就是了。",
          "sc": "天气变得超热也很困扰就是了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2767,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101633,
          "spk": "堇怜 (スミレ)",
          "ja": "夏だからって肝試しでもしようとしてる？",
          "tc": "你是因為夏天到了，所以出來試膽嗎？",
          "sc": "你是因为夏天到了，所以出来试胆吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101640,
          "spk": "堇怜 (スミレ)",
          "ja": "もう遅いから帰ったほうがいいと思うよ",
          "tc": "但已經很晚了，還是快點回家比較好。",
          "sc": "但已经很晚了，还是快点回家比较好。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2768,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101671,
          "spk": "堇怜 (スミレ)",
          "ja": "今日はもう終わりだね",
          "tc": "今天要結束了啊。",
          "sc": "今天要结束了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101678,
          "spk": "堇怜 (スミレ)",
          "ja": "明日は何をしようかな",
          "tc": "明天要做什麼好呢……",
          "sc": "明天要做什么好呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101689,
          "spk": "堇怜 (スミレ)",
          "ja": "コマコに弓を教えてもらおうかな？",
          "tc": "要請駒子教我練習射箭嗎？",
          "sc": "要请驹子教我练习射箭吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 101696,
          "spk": "堇怜 (スミレ)",
          "ja": "それとも釣りをしに行こうかな？",
          "tc": "還是去釣魚呢？",
          "sc": "还是去钓鱼呢？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2769,
      "rec_id": "TALK_ID_BOY_ROUTINE_WALK_20_112_2823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101720,
          "spk": "堇怜 (スミレ)",
          "ja": "昼間よりは涼しくなってきたかな",
          "tc": "感覺比白天涼快多了。",
          "sc": "感觉比白天凉快多了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101738,
          "spk": "堇怜 (スミレ)",
          "ja": "ずっとこのくらいの気温なら",
          "tc": "如果一直都是這樣的氣溫就好了，",
          "sc": "如果一直都是这样的气温就好了，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 101745,
          "spk": "堇怜 (スミレ)",
          "ja": "行動しやすくっていいのに",
          "tc": "活動起來會更舒服。",
          "sc": "活动起来会更舒服。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2770,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101769,
          "spk": "堇怜 (スミレ)",
          "ja": "うーん、美味しいなぁ",
          "tc": "嗯～真好吃。",
          "sc": "嗯～真好吃。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101780,
          "spk": "堇怜 (スミレ)",
          "ja": "おかわりしたばっかりなのに、",
          "tc": "明明才剛添過一碗，",
          "sc": "明明才刚添过一碗，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101787,
          "spk": "堇怜 (スミレ)",
          "ja": "まだまだ食べられそうだよ",
          "tc": "但感覺我還能吃更多呢。",
          "sc": "但感觉我还能吃更多呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2771,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3001",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101811,
          "spk": "堇怜 (スミレ)",
          "ja": "シロージさんにもらったキノコを使った汁物、",
          "tc": "用四郎治哥給我的蘑菇做成的湯，",
          "sc": "用四郎治哥给我的蘑菇做成的汤，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101818,
          "spk": "堇怜 (スミレ)",
          "ja": "いい味が出てるんだよな",
          "tc": "味道很好呢。",
          "sc": "味道很好呢。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2772,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3002",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101842,
          "spk": "堇怜 (スミレ)",
          "ja": "そろそろ栗ごはんを",
          "tc": "開始想吃",
          "sc": "开始想吃"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101849,
          "spk": "堇怜 (スミレ)",
          "ja": "食べたいんだけど……",
          "tc": "栗子飯了……",
          "sc": "栗子饭了……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101856,
          "spk": "堇怜 (スミレ)",
          "ja": "山のどっかでたくさん拾えないかな？",
          "tc": "不知道山上有沒有哪裡可以撿到很多栗子？",
          "sc": "不知道山上有没有哪里可以捡到很多栗子？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2773,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3010",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101880,
          "spk": "堇怜 (スミレ)",
          "ja": "食べられる木の実と、食べられない木の実",
          "tc": "可以吃的果實跟不能吃的果實，",
          "sc": "可以吃的果实跟不能吃的果实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101887,
          "spk": "堇怜 (スミレ)",
          "ja": "選別なら僕に任せてよ",
          "tc": "就交給我來分辨吧。",
          "sc": "就交给我来分辨吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2774,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3011",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101918,
          "spk": "堇怜 (スミレ)",
          "ja": "美味しい木の実をたくさん拾って、",
          "tc": "要是能撿到很多好吃的果實，",
          "sc": "要是能捡到很多好吃的果实，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101925,
          "spk": "堇怜 (スミレ)",
          "ja": "ご飯に使えるといいな",
          "tc": "然後能拿來做飯的話就好了。",
          "sc": "然后能拿来做饭的话就好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2775,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3012",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101949,
          "spk": "堇怜 (スミレ)",
          "ja": "前にロッカクさんに作ってもらった",
          "tc": "之前拜託六角叔用樹果做點心給我，",
          "sc": "之前拜托六角叔用树果做点心给我，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101956,
          "spk": "堇怜 (スミレ)",
          "ja": "木の実を使ったお菓子、美味しかったんだよね",
          "tc": "超級好吃！",
          "sc": "超级好吃！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 101963,
          "spk": "堇怜 (スミレ)",
          "ja": "レシピ、聞いてみようかな",
          "tc": "去跟六角叔問問食譜好了。",
          "sc": "去跟六角叔问问食谱好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2776,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3020",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 101987,
          "spk": "堇怜 (スミレ)",
          "ja": "今日こそ貯めたコイン、",
          "tc": "今天就把存起來的硬幣",
          "sc": "今天就把存起来的硬币"
        },
        {
          "f_idx": 1,
          "pidx_tc": 101994,
          "spk": "堇怜 (スミレ)",
          "ja": "大放出して回しちゃおっと",
          "tc": "大量拿去轉扭蛋吧！",
          "sc": "大量拿去转扭蛋吧！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 102005,
          "spk": "堇怜 (スミレ)",
          "ja": "で、ついでに買い物もしちゃうっていう……",
          "tc": "然後再順便手滑買點東西……",
          "sc": "然后再顺便手滑买点东西……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 102012,
          "spk": "堇怜 (スミレ)",
          "ja": "サザンカさん、商売上手だなぁ",
          "tc": "茶梅姐，真是會做生意欸。",
          "sc": "茶梅姐，真是会做生意诶。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2777,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3021",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 102043,
          "spk": "堇怜 (スミレ)",
          "ja": "僕もこの模型……コツコツ集めてるけど、",
          "tc": "這個模型……雖然我收集很久了，",
          "sc": "这个模型……虽然我收集很久了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 102050,
          "spk": "堇怜 (スミレ)",
          "ja": "なかなか全部揃わないんだよね……",
          "tc": "一直還沒收集到全套……",
          "sc": "一直还没收集到全套……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 102057,
          "spk": "堇怜 (スミレ)",
          "ja": "ホントに全種類、入ってんのかな……",
          "tc": "但這真的有放全套在裡面嗎……",
          "sc": "但这真的有放全套在里面吗……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 2778,
      "rec_id": "TALK_ID_BOY_ROUTINE_20_112_3022",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 102081,
          "spk": "堇怜 (スミレ)",
