          "tc": "寫的是這個村子……？",
          "sc": "写的是这个村子……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6226,
      "rec_id": "TALK_ID_70_0020_008_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374171,
          "spk": "帷 (トバリ)",
          "ja": "……発行年は、十年前？",
          "tc": "……刊登日是十年前？",
          "sc": "……刊登日是十年前？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374178,
          "spk": "帷 (トバリ)",
          "ja": "新聞に載るって何事よ……",
          "tc": "是什麼事情啊，居然會上新聞……",
          "sc": "是什么事情啊，居然会上新闻……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6227,
      "rec_id": "TALK_ID_70_0020_008_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374196,
          "spk": "帷 (トバリ)",
          "ja": "山間の村で異常死相次ぐ",
          "tc": "山間村落頻傳離奇死亡，",
          "sc": "山间村落频传离奇死亡，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374203,
          "spk": "帷 (トバリ)",
          "ja": "一週間で……七人死亡……",
          "tc": "一星期內……七名死者……",
          "sc": "一星期内……七名死者……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374219,
          "spk": "帷 (トバリ)",
          "ja": "山間部の村でわずか一週間のうちに",
          "tc": "山間村落在短短一星期內，",
          "sc": "山间村落在短短一星期内，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374226,
          "spk": "帷 (トバリ)",
          "ja": "七名が死亡する異常事態が発生し、",
          "tc": "發生了出現七名死者的離奇事件……",
          "sc": "发生了出现七名死者的离奇事件……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 374233,
          "spk": "帷 (トバリ)",
          "ja": "行方不明者も複数いると見られている……",
          "tc": "更有多人下落不明……",
          "sc": "更有多人下落不明……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 374242,
          "spk": "帷 (トバリ)",
          "ja": "全員の死因は失血死と見られ……",
          "tc": "被害者皆因失血過多身亡……",
          "sc": "被害者皆因失血过多身亡……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 374249,
          "spk": "帷 (トバリ)",
          "ja": "快楽的殺人の可能性も視野に",
          "tc": "警方不排除為享樂殺人的可能，",
          "sc": "警方不排除为享乐杀人的可能，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 374256,
          "spk": "帷 (トバリ)",
          "ja": "捜査を進めているが……",
          "tc": "正在進行搜查……",
          "sc": "正在进行搜查……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 374265,
          "spk": "帷 (トバリ)",
          "ja": "犯人は依然逃走中であり、",
          "tc": "然而凶手依然在潛逃中，",
          "sc": "然而凶手依然在潜逃中，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 374272,
          "spk": "帷 (トバリ)",
          "ja": "村内には不安が広がっている",
          "tc": "村內人心惶惶。",
          "sc": "村内人心惶惶。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 374279,
          "spk": "帷 (トバリ)",
          "ja": "また軽傷者一名が保護され、聴取が続いて……",
          "tc": "另有一名輕傷者受到保護，正持續進行偵訊……",
          "sc": "另有一名轻伤者受到保护，正持续进行侦讯……"
        },
        {
          "f_idx": 12,
          "pidx_tc": 374288,
          "spk": "帷 (トバリ)",
          "ja": "…………",
          "tc": "…………",
          "sc": "……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6228,
      "rec_id": "TALK_ID_70_0020_008_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374312,
          "spk": "帷 (トバリ)",
          "ja": "やっぱりこの村はおかしい",
          "tc": "這村子果然很奇怪，",
