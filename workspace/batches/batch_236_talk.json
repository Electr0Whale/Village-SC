      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6231,
      "rec_id": "TALK_ID_70_0020_008_13",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374430,
          "spk": "帷 (トバリ)",
          "ja": "それ、手伝ってくれたお礼",
          "tc": "當作你來幫忙的回禮。",
          "sc": "当作你来帮忙的回礼。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374437,
          "spk": "帷 (トバリ)",
          "ja": "ずっとここに放置されてたから、",
          "tc": "反正一直被放在這裡，",
          "sc": "反正一直被放在这里，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374444,
          "spk": "帷 (トバリ)",
          "ja": "無くなっても誰も気づかないと思う",
          "tc": "就算不見了也不會有人發現吧。",
          "sc": "就算不见了也不会有人发现吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374455,
          "spk": "帷 (トバリ)",
          "ja": "働いた分だけ対価が手に入る",
          "tc": "有工作就要收下相對應的酬勞，",
          "sc": "有工作就要收下相对应的酬劳，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374462,
          "spk": "帷 (トバリ)",
          "ja": "当たり前のことでしょ",
          "tc": "這是天經地義的吧。",
          "sc": "这是天经地义的吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6232,
      "rec_id": "TALK_ID_70_0020_008_14",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374480,
          "spk": "帷 (トバリ)",
          "ja": "もし誰かに文句言われたら",
          "tc": "如果有人找你麻煩，",
          "sc": "如果有人找你麻烦，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374487,
          "spk": "帷 (トバリ)",
          "ja": "私のせいにすればいい",
          "tc": "你就推到我身上吧。",
          "sc": "你就推到我身上吧。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 374498,
          "spk": "帷 (トバリ)",
          "ja": "それと新聞については、",
          "tc": "還有剛剛那篇新聞，",
          "sc": "还有刚刚那篇新闻，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374505,
          "spk": "帷 (トバリ)",
          "ja": "誰にも言わないこと",
          "tc": "你可不要告訴別人。",
          "sc": "你可不要告诉别人。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 374512,
          "spk": "帷 (トバリ)",
          "ja": "約束だから",
          "tc": "說好了喔。",
          "sc": "说好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6233,
      "rec_id": "TALK_ID_70_0030_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367375,
          "spk": "木助 (キスケ)",
          "ja": "ん？　<player>か……",
          "tc": "嗯？是<player>啊……",
          "sc": "嗯？是<player>啊……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367386,
          "spk": "木助 (キスケ)",
          "ja": "って、なんだこれは……？",
          "tc": "這是什麼……？",
          "sc": "这是什么……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 367393,
          "spk": "木助 (キスケ)",
          "ja": "お手伝い券だぁ？",
          "tc": "幫忙券？",
          "sc": "帮忙券？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 367404,
          "spk": "木助 (キスケ)",
          "ja": "はぁ……んなもん捨てとけ",
          "tc": "唉……那種東西就丟了吧。",
          "sc": "唉……那种东西就丢了吧。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 367413,
          "spk": "木助 (キスケ)",
          "ja": "てめぇに頼む仕事なんてねぇよ",
          "tc": "我可沒有事情能拜託你。",
          "sc": "我可没有事情能拜托你。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6234,
      "rec_id": "TALK_ID_70_0030_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 367431,
          "spk": "木助 (キスケ)",
          "ja": "……おい、そんな顔するんじゃねぇよ",
          "tc": "……喂，別露出那種表情啦。",
          "sc": "……喂，别露出那种表情啦。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 367438,
          "spk": "木助 (キスケ)",
          "ja": "まるで俺が悪者みてぇじゃねぇか",
          "tc": "搞得我像壞人一樣。",
          "sc": "搞得我像坏人一样。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 367456,
          "spk": "木助 (キスケ)",
          "ja": "……チッ……はぁ、しょうがねぇ",
          "tc": "……嘖……唉，真沒辦法。",
          "sc": "……啧……唉，真没办法。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 367463,
          "spk": "木助 (キスケ)",
          "ja": "てめぇにも事情はあるだろうしな",
          "tc": "你也有你的苦衷吧。",
          "sc": "你也有你的苦衷吧。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 367472,
          "spk": "木助 (キスケ)",
          "ja": "いいか？",
          "tc": "聽好了，",
          "sc": "听好了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 367479,
          "spk": "木助 (キスケ)",
          "ja": "一回しか言わねえからよく聞けよ",
          "tc": "我只說一次，所以給我聽清楚了。",
          "sc": "我只说一次，所以给我听清楚了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 367490,
          "spk": "木助 (キスケ)",
          "ja": "シロージの作業場近くの山道に",
          "tc": "在四郎治工作場地附近的山路",
          "sc": "在四郎治工作场地附近的山路"
        },
        {
          "f_idx": 8,
          "pidx_tc": 367497,
          "spk": "木助 (キスケ)",
          "ja": "落石が転がってきて、道を塞いでいるらしい",
          "tc": "好像有落石滾了下來，把路給擋住了。",
          "sc": "好像有落石滚了下来，把路给挡住了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 367504,
          "spk": "木助 (キスケ)",
          "ja": "だから、その岩を壊してこいって頼まれてんだ",
          "tc": "所以我被拜託要去破壞那個岩石。",
          "sc": "所以我被拜托要去破坏那个岩石。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 367515,
          "spk": "木助 (キスケ)",
          "ja": "思いっきり岩でもぶっ壊せば、",
          "tc": "我本來覺得狠狠把岩石砸爛，",
          "sc": "我本来觉得狠狠把岩石砸烂，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 367522,
          "spk": "木助 (キスケ)",
          "ja": "溜まった日頃の鬱憤が",
          "tc": "應該就能消除一些",
          "sc": "应该就能消除一些"
        },
        {
          "f_idx": 12,
          "pidx_tc": 367529,
          "spk": "木助 (キスケ)",
          "ja": "晴れると思ってたんだが……",
          "tc": "日常生活累積的負面情緒……",
          "sc": "日常生活累积的负面情绪……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 367540,
          "spk": "木助 (キスケ)",
          "ja": "それの他にやらなきゃなんねぇ",
          "tc": "但我還有其他",
          "sc": "但我还有其他"
        },
        {
          "f_idx": 14,
          "pidx_tc": 367547,
          "spk": "木助 (キスケ)",
          "ja": "大工仕事がいくつもあるんだ",
          "tc": "木匠工作要做。",
          "sc": "木匠工作要做。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 367558,
          "spk": "木助 (キスケ)",
          "ja": "だから……なんつーか……",
          "tc": "所以說……那個……",
          "sc": "所以说……那个……"
        },
        {
          "f_idx": 16,
          "pidx_tc": 367569,
          "spk": "木助 (キスケ)",
          "ja": "譲ってやるよ",
          "tc": "這工作就讓給你吧。",
          "sc": "这工作就让给你吧。"
        },
        {
          "f_idx": 17,
          "pidx_tc": 367580,
          "spk": "木助 (キスケ)",
          "ja": "ほら、このツルハシで片付けてきな",
          "tc": "你就拿著這個十字鎬去清理吧。",
          "sc": "你就拿着这个十字镐去清理吧。"
        }
      ]
    }
  ]
