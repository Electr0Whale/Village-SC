          "tc": "你真奇怪……",
          "sc": "你真奇怪……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6223,
      "rec_id": "TALK_ID_70_0020_008_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374089,
          "spk": "帷 (トバリ)",
          "ja": "ほこりっぽくてジメジメして",
          "tc": "灰塵這麼多，而且又陰暗潮濕的，",
          "sc": "灰尘这么多，而且又阴暗潮湿的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374096,
          "spk": "帷 (トバリ)",
          "ja": "なんで私がこんなことを……",
          "tc": "為什麼我非得做這種事不可啊……",
          "sc": "为什么我非得做这种事不可啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6224,
      "rec_id": "TALK_ID_70_0020_008_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374114,
          "spk": "帷 (トバリ)",
          "ja": "新聞とか雑誌とか、古いのばっかり",
          "tc": "報章雜誌也都是舊的，",
          "sc": "报章杂志也都是旧的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 374121,
          "spk": "帷 (トバリ)",
          "ja": "こんなの取っておいても意味ないでしょ",
          "tc": "保存這些根本沒意義吧。",
          "sc": "保存这些根本没意义吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6225,
      "rec_id": "TALK_ID_70_0020_008_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374146,
          "spk": "帷 (トバリ)",
          "ja": "……ん？　この新聞記事……",
