      "file": "talk.dat",
      "rec_idx": 6204,
      "rec_id": "TALK_ID_70_0020_001_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373248,
          "spk": "帷 (トバリ)",
          "ja": "アンタが、リンから雑用を",
          "tc": "我知道林",
          "sc": "我知道林"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373255,
          "spk": "帷 (トバリ)",
          "ja": "押しつけられたのは知ってる",
          "tc": "把很多雜事丟給你做。",
          "sc": "把很多杂事丢给你做。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373266,
          "spk": "帷 (トバリ)",
          "ja": "「お手伝い券」ね……",
          "tc": "「幫忙券」啊……",
          "sc": "“帮忙券”啊……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373273,
          "spk": "帷 (トバリ)",
          "ja": "こんなくだらないもの、",
          "tc": "這種無聊的東西，",
          "sc": "这种无聊的东西，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373280,
          "spk": "帷 (トバリ)",
          "ja": "捨ててしまえばいいのに",
          "tc": "你隨手丟掉就好了吧。",
          "sc": "你随手丢掉就好了吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6205,
      "rec_id": "TALK_ID_70_0020_001_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373298,
          "spk": "帷 (トバリ)",
          "ja": "……なに？　できないの？",
          "tc": "……什麼？辦不到？",
          "sc": "……什么？办不到？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373305,
          "spk": "帷 (トバリ)",
          "ja": "アンタにはリンに歯向かう",
          "tc": "你不敢",
          "sc": "你不敢"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373312,
          "spk": "帷 (トバリ)",
          "ja": "度胸はないのね",
          "tc": "反抗林啊。",
          "sc": "反抗林啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373323,
          "spk": "帷 (トバリ)",
          "ja": "……ならいい",
          "tc": "……那就算了，",
          "sc": "……那就算了，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373330,
          "spk": "帷 (トバリ)",
          "ja": "蔵の掃除でもやっておいて",
          "tc": "你去掃個倉庫吧，",
          "sc": "你去扫个仓库吧，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 373337,
          "spk": "帷 (トバリ)",
          "ja": "簡単な頼みでしょ？",
          "tc": "是很簡單的委託對吧？",
          "sc": "是很简单的委托对吧？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6206,
      "rec_id": "TALK_ID_70_0020_001_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373355,
          "spk": "帷 (トバリ)",
          "ja": "私がリンにやれって言われているんだけど",
          "tc": "這是林要我做的工作，",
          "sc": "这是林要我做的工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373362,
          "spk": "帷 (トバリ)",
          "ja": "でも、そんなこと誰がやろうと同じでしょ",
          "tc": "但倉庫不管誰來掃都一樣吧。",
          "sc": "但仓库不管谁来扫都一样吧。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373380,
          "spk": "帷 (トバリ)",
          "ja": "……それでやるの？　やらないの？",
          "tc": "……所以呢？你要不要做？",
          "sc": "……所以呢？你要不要做？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6207,
      "rec_id": "TALK_ID_70_0020_001_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373404,
          "spk": "帷 (トバリ)",
          "ja": "……ハァ",
          "tc": "唉……",
          "sc": "唉……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373415,
          "spk": "帷 (トバリ)",
          "ja": "一つ忠告しておくけど",
          "tc": "我給你一個忠告，",
          "sc": "我给你一个忠告，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373422,
          "spk": "帷 (トバリ)",
          "ja": "なんでもホイホイ引き受けない方がいい",
          "tc": "最好不要隨便接下別人的委託。",
          "sc": "最好不要随便接下别人的委托。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373440,
          "spk": "帷 (トバリ)",
          "ja": "この村で暮らしてたら、なんだってやらされる",
          "tc": "你在這個村子生活會被迫做一堆雜事，",
          "sc": "你在这个村子生活会被迫做一堆杂事，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 373447,
          "spk": "帷 (トバリ)",
          "ja": "雑用を頼まれるなんて、それこそ日常茶飯事",
          "tc": "被拜託去做雜務根本是家常便飯。",
          "sc": "被拜托去做杂务根本是家常便饭。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 373463,
          "spk": "帷 (トバリ)",
          "ja": "助け合いの精神とか言って",
          "tc": "他們就是這樣以「互助精神」之名，",
          "sc": "他们就是这样以“互助精神”之名，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 373470,
          "spk": "帷 (トバリ)",
          "ja": "仕事を押しつけられるんだから",
          "tc": "行「丟包工作」之實。",
          "sc": "行“丢包工作”之实。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 373488,
          "spk": "帷 (トバリ)",
          "ja": "そうやって面倒な仕事をさせられるうちに",
          "tc": "這些麻煩的工作做著做著，",
          "sc": "这些麻烦的工作做着做着，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 373495,
          "spk": "帷 (トバリ)",
          "ja": "村の一員だと引きずり込まれるの",
          "tc": "就會被吸收成村裡的一員。",
          "sc": "就会被吸收成村里的一员。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 373513,
          "spk": "帷 (トバリ)",
          "ja": "そして……この陰気な村に",
          "tc": "然後……",
          "sc": "然后……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 373520,
          "spk": "帷 (トバリ)",
          "ja": "少しずつ染まってく",
          "tc": "就這麼漸漸地融入這個陰森的村落。",
          "sc": "就这么渐渐地融入这个阴森的村落。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 373531,
          "spk": "帷 (トバリ)",
          "ja": "アンタも気をつけることね",
          "tc": "你自己也多注意一點吧。",
          "sc": "你自己也多注意一点吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6208,
      "rec_id": "TALK_ID_70_0020_002_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373551,
          "spk": "主角心声/旁白/选项",
          "ja": "鍵がかかってるみたい……",
          "tc": "好像上鎖了……",
          "sc": "好像上锁了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6209,
      "rec_id": "TALK_ID_70_0020_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373567,
          "spk": "主角心声/旁白/选项",
          "ja": "蔵の鍵が開いてる……",
          "tc": "倉庫的鎖開著……",
          "sc": "仓库的锁开着……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373576,
          "spk": "主角心声/旁白/选项",
          "ja": "入ってみよう",
          "tc": "進去看看吧。",
          "sc": "进去看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6210,
      "rec_id": "TALK_ID_70_0020_004_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373592,
          "spk": "主角心声/旁白/选项",
          "ja": "ちらかっている……",
          "tc": "亂七八糟的……",
          "sc": "乱七八糟的……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373601,
          "spk": "主角心声/旁白/选项",
          "ja": "全てのゴミを拾い集めよう……",
          "tc": "把垃圾都收集起來吧……",
          "sc": "把垃圾都收集起来吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6211,
      "rec_id": "TALK_ID_70_0020_005_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373617,
          "spk": "主角心声/旁白/选项",
          "ja": "きれいになった",
          "tc": "變乾淨了，",
          "sc": "变干净了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373624,
          "spk": "主角心声/旁白/选项",
          "ja": "トバリに報告しに行こう",
          "tc": "去向帷報告吧。",
          "sc": "去向帷报告吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6212,
      "rec_id": "TALK_ID_70_0020_006_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373640,
          "spk": "主角心声/旁白/选项",
          "ja": "古い新聞記事が置いてある……",
          "tc": "這裡堆著舊報紙……",
          "sc": "这里堆着旧报纸……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6213,
      "rec_id": "TALK_ID_70_0020_007_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373660,
          "spk": "帷 (トバリ)",
          "ja": "蔵の掃除が終わったの？",
          "tc": "你掃完倉庫了嗎？",
          "sc": "你扫完仓库了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373667,
          "spk": "帷 (トバリ)",
          "ja": "ふうん、ご苦労様",
          "tc": "喔，辛苦了。",
          "sc": "哼，辛苦了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6214,
      "rec_id": "TALK_ID_70_0020_007_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373685,
          "spk": "帷 (トバリ)",
          "ja": "リンの言いつけにバカ正直に従う",
          "tc": "你還真是老實地在聽從林的吩咐啊，",
          "sc": "你还真是老实地在听从林的吩咐啊，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373692,
          "spk": "帷 (トバリ)",
          "ja": "アンタの気が知れない",
          "tc": "真是無法理解你的心情。",
          "sc": "真是无法理解你的心情。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6215,
      "rec_id": "TALK_ID_70_0020_007_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373710,
          "spk": "帷 (トバリ)",
          "ja": "真面目に働くのは",
          "tc": "你這麼勤奮工作，",
          "sc": "你这么勤奋工作，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373717,
          "spk": "帷 (トバリ)",
          "ja": "村やリンの役に立ちたいから？",
          "tc": "是為了幫助村子和林嗎？",
          "sc": "是为了帮助村子和林吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6216,
      "rec_id": "TALK_ID_70_0020_007_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373735,
          "spk": "帷 (トバリ)",
          "ja": "まさかとは思うけど",
          "tc": "難道說",
          "sc": "难道说"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373742,
          "spk": "帷 (トバリ)",
          "ja": "この村に愛着を持ったとか？",
          "tc": "你喜歡上這個村子了？",
          "sc": "你喜欢上这个村子了？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6217,
      "rec_id": "TALK_ID_70_0020_007_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373766,
          "spk": "帷 (トバリ)",
          "ja": "私は、違う",
          "tc": "我跟你不一樣，",
          "sc": "我跟你不一样，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373773,
          "spk": "帷 (トバリ)",
          "ja": "アンタみたいに",
          "tc": "我是不會聽從",
          "sc": "我是不会听从"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373780,
          "spk": "帷 (トバリ)",
          "ja": "誰かのいいなりにはならない",
          "tc": "任何人的吩咐的。",
          "sc": "任何人的吩咐的。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373789,
          "spk": "帷 (トバリ)",
          "ja": "……こんな村が衰退しようが",
          "tc": "……這種村子，看是要荒廢還是要毀滅掉，",
          "sc": "……这种村子，看是要荒废还是要毁灭掉，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373796,
          "spk": "帷 (トバリ)",
          "ja": "破滅しようがどうだっていい",
          "tc": "對我來說都無所謂。",
          "sc": "对我来说都无所谓。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 373814,
          "spk": "帷 (トバリ)",
          "ja": "不便で虫ばかり湧いてくる田舎暮らし……",
          "tc": "鄉下生活既不方便，又有一堆蟲……",
          "sc": "乡下生活既不方便，又有一堆虫……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 373830,
          "spk": "帷 (トバリ)",
          "ja": "せまっ苦しくて",
          "tc": "這村子也小到讓人感到窒息，",
          "sc": "这村子也小到让人感到窒息，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 373837,
          "spk": "帷 (トバリ)",
          "ja": "個人情報は筒抜けだし",
          "tc": "毫無個人隱私可言。",
          "sc": "毫无个人隐私可言。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 373848,
          "spk": "帷 (トバリ)",
          "ja": "村人は意味不明な掟だとか",
          "tc": "村民還會逼迫你接受",
          "sc": "村民还会逼迫你接受"
        },
        {
          "f_idx": 11,
          "pidx_tc": 373855,
          "spk": "帷 (トバリ)",
          "ja": "風習だとか押しつけてくるし、もうウンザリ",
          "tc": "莫名其妙的規矩跟風俗，煩都煩死了。",
          "sc": "莫名其妙的规矩跟风俗，烦都烦死了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 373873,
          "spk": "帷 (トバリ)",
          "ja": "けど、なにより嫌なのは",
          "tc": "但是最討厭的，",
          "sc": "但是最讨厌的，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 373880,
          "spk": "帷 (トバリ)",
          "ja": "そう思ってるのが私だけってこと……",
          "tc": "是整個村子會這麼想的只有我一個……",
          "sc": "是整个村子会这么想的只有我一个……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6218,
      "rec_id": "TALK_ID_70_0020_007_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373898,
          "spk": "帷 (トバリ)",
          "ja": "<strong>明日、また蔵に来て</strong>",
          "tc": "你<strong>明天再來倉庫一趟吧</strong>，",
          "sc": "你<strong>明天再来仓库一趟吧</strong>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373905,
          "spk": "帷 (トバリ)",
          "ja": "お手伝い券がなくてもいいから",
          "tc": "沒有幫忙券也沒關係。",
          "sc": "没有帮忙券也没关系。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 373923,
          "spk": "帷 (トバリ)",
          "ja": "次も、吐き気がするほどの",
          "tc": "下次我要塞一堆工作給你，",
          "sc": "下次我要塞一堆工作给你，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 373930,
          "spk": "帷 (トバリ)",
          "ja": "仕事を押しつけてあげる",
          "tc": "讓你做到吐。",
          "sc": "让你做到吐。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6219,
      "rec_id": "TALK_ID_70_0020_008_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373950,
          "spk": "帷 (トバリ)",
          "ja": "はあ……ダル……",
          "tc": "唉……麻煩死了……",
          "sc": "唉……麻烦死了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6220,
      "rec_id": "TALK_ID_70_0020_008_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 373977,
          "spk": "帷 (トバリ)",
          "ja": "アンタに蔵の掃除を",
          "tc": "林發現我把掃倉庫的工作",
          "sc": "林发现我把扫仓库的工作"
        },
        {
          "f_idx": 1,
          "pidx_tc": 373984,
          "spk": "帷 (トバリ)",
          "ja": "押し付けたのがリンにバレたの",
          "tc": "推給你了。",
          "sc": "推给你了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 373995,
          "spk": "帷 (トバリ)",
          "ja": "それでちゃんと自分でやれって言われて……",
          "tc": "所以她要我自己認真掃……",
          "sc": "所以她要我自己认真扫……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 374002,
          "spk": "帷 (トバリ)",
          "ja": "……はぁ、本当に意味わからない",
          "tc": "……唉，真是莫名其妙。",
          "sc": "……唉，真是莫名其妙。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 6221,
      "rec_id": "TALK_ID_70_0020_008_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 374033,
          "spk": "帷 (トバリ)",
          "ja": "……え、なに？",
          "tc": "……咦？什麼？",
