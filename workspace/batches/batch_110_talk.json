        },
        {
          "f_idx": 2,
          "pidx_tc": 106877,
          "spk": "林 (リン)",
          "ja": "最近の私って、なんていうか……",
          "tc": "最近的我，怎麼說呢……",
          "sc": "最近的我，怎么说呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 106884,
          "spk": "林 (リン)",
          "ja": "ふっくらしてきてる気がしない？",
          "tc": "是不是變得有點圓潤了？",
          "sc": "是不是变得有点圆润了？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 106893,
          "spk": "林 (リン)",
          "ja": "最近、村のあれこれで",
          "tc": "最近，我因為村裡的各種事情",
          "sc": "最近，我因为村里的各种事情"
        },
        {
          "f_idx": 5,
          "pidx_tc": 106900,
          "spk": "林 (リン)",
