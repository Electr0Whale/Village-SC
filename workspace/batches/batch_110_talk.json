  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 701,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4211",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128508,
          "spk": "四郎治 (シロージ)",
          "ja": "小さい雪だるまがいると思ったら",
          "tc": "我還以為是個小雪人，",
          "sc": "我还以为是个小雪人，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128515,
          "spk": "四郎治 (シロージ)",
          "ja": "白い小鳥だった……",
          "tc": "結果是白色的小鳥……",
          "sc": "结果是白色的小鸟……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 128533,
          "spk": "四郎治 (シロージ)",
          "ja": "真っ白な羽をしてて可愛いもんだな",
          "tc": "純白的羽毛真可愛。",
          "sc": "纯白的羽毛真可爱。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 702,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4212",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128564,
          "spk": "四郎治 (シロージ)",
          "ja": "冬は薪の消費が激しくなるんだよ",
          "tc": "冬天的木柴消耗量會變很大，",
          "sc": "冬天的木柴消耗量会变很大，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128571,
          "spk": "四郎治 (シロージ)",
          "ja": "こまめに薪割りしておかねえと",
          "tc": "我砍柴必須砍得勤奮點才行。",
          "sc": "我砍柴必须砍得勤奋点才行。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 703,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4213",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128602,
          "spk": "四郎治 (シロージ)",
          "ja": "ソリを滑らせてると",
          "tc": "滑雪橇會看到",
          "sc": "滑雪橇会看到"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128609,
          "spk": "四郎治 (シロージ)",
          "ja": "周りの景色がすごい勢いで",
          "tc": "景色快速變化，",
          "sc": "景色快速变化，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128616,
          "spk": "四郎治 (シロージ)",
          "ja": "過ぎていって面白ぇんだよな",
          "tc": "挺有趣的。",
          "sc": "挺有趣的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 704,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4220",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128640,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかいもんが身体に染みわたる",
          "tc": "溫暖的料理讓整個身體都暖洋洋的。",
          "sc": "温暖的料理让整个身体都暖洋洋的。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128658,
          "spk": "四郎治 (シロージ)",
          "ja": "今日は気分よく眠れそうだな",
          "tc": "今天應該可以睡得很香了。",
          "sc": "今天应该可以睡得很香了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 705,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4230",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128682,
          "spk": "四郎治 (シロージ)",
          "ja": "どんどん寒くなってるし",
          "tc": "天氣越來越冷了，",
          "sc": "天气越来越冷了，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128689,
          "spk": "四郎治 (シロージ)",
          "ja": "やっぱりもっと上等な毛布を",
          "tc": "果然還是要來準備",
          "sc": "果然还是要来准备"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128696,
          "spk": "四郎治 (シロージ)",
          "ja": "用意した方がいいな……",
          "tc": "更好一點的棉被才行……",
          "sc": "更好一点的棉被才行……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 706,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4231",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128720,
          "spk": "四郎治 (シロージ)",
          "ja": "寒い時期はたまに怖い夢を見るんだ",
          "tc": "在這麼寒冷的時期，我偶爾會夢到恐怖的夢。",
          "sc": "在这么寒冷的时期，我偶尔会梦到恐怖的梦。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128738,
          "spk": "四郎治 (シロージ)",
          "ja": "ホラーゲームの主人公になったみたいで",
          "tc": "不過也很像是變成了恐怖遊戲的主角，",
          "sc": "不过也很像是变成了恐怖游戏的主角，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 128745,
          "spk": "四郎治 (シロージ)",
          "ja": "ちょっと面白いんだがな",
          "tc": "還滿有趣的。",
          "sc": "还满有趣的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 707,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_20_103_4232",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128776,
          "spk": "四郎治 (シロージ)",
          "ja": "う～ん",
          "tc": "嗯～",
          "sc": "嗯～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128783,
          "spk": "四郎治 (シロージ)",
          "ja": "ここに冬毛のタヌキでもいれば",
          "tc": "如果這裡有換上了冬毛的狸貓，",
          "sc": "如果这里有换上了冬毛的狸猫，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128790,
          "spk": "四郎治 (シロージ)",
          "ja": "抱きしめて眠るんだけどな……",
          "tc": "我會抱著牠睡覺……",
          "sc": "我会抱着它睡觉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 708,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4800",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128814,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>",
          "tc": "<player>，",
          "sc": "<player>，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128821,
          "spk": "四郎治 (シロージ)",
          "ja": "自分の服の袖をよく見てみろ",
          "tc": "你看一下自己的袖子。",
          "sc": "你看一下自己的袖子。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128832,
          "spk": "四郎治 (シロージ)",
          "ja": "そら、雪の結晶がついてるぞ",
          "tc": "看，沾到雪花了。",
          "sc": "看，沾到雪花了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 709,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4801",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128856,
          "spk": "四郎治 (シロージ)",
          "ja": "冬になると動物たちが眠りに就き始めるんだ",
          "tc": "入冬後動物們會開始冬眠。",
          "sc": "入冬后动物们会开始冬眠。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128874,
          "spk": "四郎治 (シロージ)",
          "ja": "だから、春を迎えるまでは",
          "tc": "所以在春天來臨前，",
          "sc": "所以在春天来临前，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 128881,
          "spk": "四郎治 (シロージ)",
          "ja": "山が少し寂しくなるんだよな",
          "tc": "山區會變得有點冷清。",
          "sc": "山区会变得有点冷清。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 710,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4802",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128905,
          "spk": "四郎治 (シロージ)",
          "ja": "<player>も白い息が出てるな",
          "tc": "<player>也呼出白霧了啊。",
          "sc": "<player>也呼出白雾了啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 128916,
          "spk": "四郎治 (シロージ)",
          "ja": "子どもの頃、冬になると白い息が出るのが",
          "tc": "我記得我小時候總覺得",
          "sc": "我记得我小时候总觉得"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128923,
          "spk": "四郎治 (シロージ)",
          "ja": "不思議で仕方なかったのを思い出したよ",
          "tc": "冬天會吐白霧這件事很神奇。",
          "sc": "冬天会吐白雾这件事很神奇。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 711,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4803",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128947,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコがくしゃみしてたのが気になる",
          "tc": "駒子在打噴嚏，我有點擔心。",
          "sc": "驹子在打喷嚏，我有点担心。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 128965,
          "spk": "四郎治 (シロージ)",
          "ja": "適当に新しく防寒具を買い足すように",
          "tc": "叫她隨便去多買幾個",
          "sc": "叫她随便去多买几个"
        },
        {
          "f_idx": 3,
          "pidx_tc": 128972,
          "spk": "四郎治 (シロージ)",
          "ja": "伝えておいた方がいいかもな",
          "tc": "防寒用具好了。",
          "sc": "防寒用具好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 712,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4810",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 128996,
          "spk": "四郎治 (シロージ)",
          "ja": "せっかく雪が降ってんだ",
          "tc": "難得下雪，",
          "sc": "难得下雪，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129003,
          "spk": "四郎治 (シロージ)",
          "ja": "雪だるまを作るなりソリで滑るなり",
          "tc": "無論是要堆雪人或滑雪橇都可以。",
          "sc": "无论是要堆雪人或滑雪橇都可以。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129010,
          "spk": "四郎治 (シロージ)",
          "ja": "今ならではの遊びをしないともったいないぜ",
          "tc": "不趁現在好好玩玩就太可惜了。",
          "sc": "不趁现在好好玩玩就太可惜了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 713,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4811",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129034,
          "spk": "四郎治 (シロージ)",
          "ja": "樹氷って知ってるか？",
          "tc": "你知道「樹冰」嗎？",
          "sc": "你知道“树冰”吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129052,
          "spk": "四郎治 (シロージ)",
          "ja": "場所によっては寒さのせいで",
          "tc": "有些地方因為天氣寒冷，",
          "sc": "有些地方因为天气寒冷，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 129059,
          "spk": "四郎治 (シロージ)",
          "ja": "木がデカいお化けみたいになるんだぜ",
          "tc": "樹木會變得像巨大怪物一樣喔。",
          "sc": "树木会变得像巨大怪物一样啊。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 714,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4812",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129083,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかいもんが食いたいけど",
          "tc": "我想吃點熱的，",
          "sc": "我想吃点热的，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129090,
          "spk": "四郎治 (シロージ)",
          "ja": "何にするかな……",
          "tc": "但要吃什麼呢……",
          "sc": "但要吃什么呢……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129101,
          "spk": "四郎治 (シロージ)",
          "ja": "うどんか鍋が楽でよさそうだよな",
          "tc": "烏龍麵或火鍋應該是方便的好選擇。",
          "sc": "乌冬面或火锅应该是方便的好选择。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 715,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4813",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129132,
          "spk": "四郎治 (シロージ)",
          "ja": "おう、寒くても活動してて偉いじゃん",
          "tc": "哦，這麼冷你還在外面跑啊，真了不起。",
          "sc": "哦，这么冷你还在外面跑啊，真了不起。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129150,
          "spk": "四郎治 (シロージ)",
          "ja": "風邪引かないようにあったかくしておけよ",
          "tc": "記得要穿暖一點，別感冒了。",
          "sc": "记得要穿暖一点，别感冒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 716,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4820",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129181,
          "spk": "四郎治 (シロージ)",
          "ja": "かまくらを作って中で鍋でも食べたい気分だ",
          "tc": "我想蓋個雪屋，在雪屋裡面吃火鍋。",
          "sc": "我想盖个雪屋，在雪屋里面吃火锅。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129199,
          "spk": "四郎治 (シロージ)",
          "ja": "ひんやりした中であったかいものを",
          "tc": "在寒冷的環境下",
          "sc": "在寒冷的环境下"
        },
        {
          "f_idx": 3,
          "pidx_tc": 129206,
          "spk": "四郎治 (シロージ)",
          "ja": "食べると最高なんだぜ",
          "tc": "吃熱的東西最棒了。",
          "sc": "吃热的东西最棒了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 717,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4821",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129237,
          "spk": "四郎治 (シロージ)",
          "ja": "朝と夜は特に冷え込むからキャンプで",
          "tc": "早晚氣溫特別低，",
          "sc": "早晚气温特别低，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129244,
          "spk": "四郎治 (シロージ)",
          "ja": "寝てると風邪を引きそうになっちまう",
          "tc": "所以睡帳篷很容易感冒。",
          "sc": "所以睡帐篷很容易感冒。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 129262,
          "spk": "四郎治 (シロージ)",
          "ja": "コマコから毛皮でももらうか",
          "tc": "去跟駒子拿些毛皮來用好了。",
          "sc": "去跟驹子拿些毛皮来用好了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 718,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4822",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129293,
          "spk": "四郎治 (シロージ)",
          "ja": "手がかじかんでるのか？",
          "tc": "你的手凍僵了嗎？",
          "sc": "你的手冻僵了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129304,
          "spk": "四郎治 (シロージ)",
          "ja": "動かしてみるとマシになる",
          "tc": "動一動會比較好一點。",
          "sc": "动一动会比较好一点。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 129311,
          "spk": "四郎治 (シロージ)",
          "ja": "騙されたと思って試してみろ",
          "tc": "你就當作是被我騙了，試試看吧。",
          "sc": "你就当作是被我骗了，试试看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 719,
      "rec_id": "TALK_ID_LUMBERJACK_ROUTINE_WALK_20_103_4823",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129335,
          "spk": "四郎治 (シロージ)",
          "ja": "何を間違えたのか、昨日の夜",
          "tc": "昨天晚上有一隻小松鼠睡在我旁邊，",
          "sc": "昨天晚上有一只小松鼠睡在我旁边，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129342,
          "spk": "四郎治 (シロージ)",
          "ja": "小せぇリスが俺の隣で眠ってた",
          "tc": "也不知道他是把我當成了什麼。",
          "sc": "也不知道他是把我当成了什么。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 129360,
          "spk": "四郎治 (シロージ)",
          "ja": "あったかくて悪くなかったけどな",
          "tc": "不過牠很溫暖，感覺還挺不錯的。",
          "sc": "不过它很温暖，感觉还挺不错的。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 720,
      "rec_id": "TALK_ID_LUMBERJACK_BIRTHDAY_20_103_5000",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 129382,
          "spk": "四郎治 (シロージ)",
          "ja": "よう、<player>",
          "tc": "嗨，<player>。",
          "sc": "嗨，<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 129389,
          "spk": "四郎治 (シロージ)",
          "ja": "お前、今日が誕生日なんだってな",
          "tc": "聽說你今天生日啊？",
          "sc": "听说你今天生日啊？"
        },
