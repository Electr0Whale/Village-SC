        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5262,
      "rec_id": "TALK_ID_10_0501_123_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305587,
          "spk": "裕太 (ユータ)",
          "ja": "<player>……",
