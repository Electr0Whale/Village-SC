  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5247,
      "rec_id": "TALK_ID_10_0501_121_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 304729,
          "spk": "年轻时的六角 (？？？)",
          "ja": "……ちっ",
          "tc": "……嘖！",
          "sc": "……啧！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 304736,
          "spk": "年轻时的六角 (？？？)",
          "ja": "しけてんな",
          "tc": "真是有夠窮酸。",
          "sc": "真是有够穷酸。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 304751,
          "spk": "年轻时的六角 (？？？)",
          "ja": "この村でも古い歴史のある家だって言うから、",
          "tc": "聽說這一戶是村裡歷史最悠久的人家，",
          "sc": "听说这一户是村里历史最悠久的人家，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 304758,
          "spk": "年轻时的六角 (？？？)",
          "ja": "リスクを承知で忍び込んだってのに",
          "tc": "我才冒著風險偷跑進來。",
          "sc": "我才冒着风险偷跑进来。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 304774,
          "spk": "年轻时的六角 (？？？)",
          "ja": "これじゃ、酒代どころか",
          "tc": "光這點東西，別說酒錢了，",
          "sc": "光这点东西，别说酒钱了，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 304781,
          "spk": "年轻时的六角 (？？？)",
          "ja": "生活費の足しにもなりゃしねえ……",
          "tc": "連補貼生活費都不夠……",
          "sc": "连补贴生活费都不够……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 304797,
          "spk": "年轻时的六角 (？？？)",
          "ja": "噂では、「ジンギ」っつーお宝を",
          "tc": "傳聞中，",
          "sc": "传闻中，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 304804,
          "spk": "年轻时的六角 (？？？)",
          "ja": "隠し持ってるって話なんだが",
          "tc": "這裡藏著叫「神器」的寶貝。",
          "sc": "这里藏着叫“神器”的宝贝。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5248,
      "rec_id": "TALK_ID_10_0501_121_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 304835,
          "spk": "年轻时的六角 (？？？)",
          "ja": "……別の部屋か？",
          "tc": "……是放在其他房間嗎？",
          "sc": "……是放在其他房间吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5249,
      "rec_id": "TALK_ID_10_0501_121_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 304859,
          "spk": "裕太 (ユータ)",
          "ja": "あれ、ロッカクさんだったよね？",
          "tc": "剛剛那個人，應該是六角叔吧？",
          "sc": "刚刚那个人，应该是六角叔吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 304866,
          "spk": "裕太 (ユータ)",
          "ja": "……今より少しだけ若かったけど",
          "tc": "……雖然看起來比現在年輕了一點。",
          "sc": "……虽然看起来比现在年轻了一点。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5250,
      "rec_id": "TALK_ID_10_0501_121_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 304884,
          "spk": "裕太 (ユータ)",
          "ja": "やっぱり……間違いない……！",
          "tc": "果然……不會錯的……！",
          "sc": "果然……不会错的……！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 304891,
          "spk": "裕太 (ユータ)",
          "ja": "つまり、この心霊現象は",
          "tc": "也就是說，這些靈異現象",
          "sc": "也就是说，这些灵异现象"
        },
        {
          "f_idx": 2,
          "pidx_tc": 304898,
          "spk": "裕太 (ユータ)",
          "ja": "過去の幻影的なものが見えてるってことなんだ！",
          "tc": "其實是「過去的幻影」嗎！？",
          "sc": "其实是“过去的幻影”吗！？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 304909,
          "spk": "裕太 (ユータ)",
          "ja": "じゃあ、どうしてロッカクさんは忍び込んで……",
          "tc": "那六角叔為什麼要偷偷進來……",
          "sc": "那六角叔为什么要偷偷进来……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 304916,
          "spk": "裕太 (ユータ)",
          "ja": "もしかして……泥棒……？",
          "tc": "難不成是……小偷……？",
          "sc": "难不成是……小偷……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 304934,
          "spk": "裕太 (ユータ)",
          "ja": "でも、今はヨウちゃんと一緒に暮らしてるよね？",
          "tc": "可是，他現在跟小洋住在一起不是嗎？",
          "sc": "可是，他现在跟小洋住在一起不是吗？"
        },
        {
          "f_idx": 7,
          "pidx_tc": 304941,
          "spk": "裕太 (ユータ)",
          "ja": "一体なにがあったら、泥棒に入った家の子と",
          "tc": "到底發生了什麼事，才讓一個入室行竊的小偷，",
          "sc": "到底发生了什么事，才让一个入室行窃的小偷，"
        },
        {
          "f_idx": 8,
          "pidx_tc": 304948,
          "spk": "裕太 (ユータ)",
          "ja": "暮らすことになるんだよ……",
          "tc": "演變成跟那戶人家的孩子一起生活啊……",
          "sc": "演变成跟那户人家的孩子一起生活啊……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 304959,
          "spk": "裕太 (ユータ)",
          "ja": "うう……頭がこんがらがってきた",
          "tc": "唔唔……腦袋開始打結了。",
          "sc": "唔唔……脑袋开始打结了。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 304970,
          "spk": "裕太 (ユータ)",
          "ja": "……とにかく、",
          "tc": "……總之，",
          "sc": "……总之，"
        },
        {
          "f_idx": 11,
          "pidx_tc": 304977,
          "spk": "裕太 (ユータ)",
          "ja": "この部屋にもまだ奥があるみたいだ",
          "tc": "這個房間跟剛才一樣，還可以再往裡面走。",
          "sc": "这个房间跟刚才一样，还可以再往里面走。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 304986,
          "spk": "裕太 (ユータ)",
          "ja": "……行ってみよう",
          "tc": "……我們過去看看吧。",
          "sc": "……我们过去看看吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5251,
      "rec_id": "TALK_ID_10_0501_121_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305010,
          "spk": "裕太 (ユータ)",
          "ja": "不思議な廃屋で、不気味な死体の幻……",
          "tc": "神祕的廢棄屋中有詭異的屍體幻象……",
          "sc": "神秘的废弃屋中有诡异的尸体幻象……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305017,
          "spk": "裕太 (ユータ)",
          "ja": "ってのはわかるんだけど……",
          "tc": "這個我還可以理解……",
          "sc": "这个我还可以理解……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305035,
          "spk": "裕太 (ユータ)",
          "ja": "どうして若いロッカクさんらしき人の幻まで",
          "tc": "但為什麼連疑似年輕時的六角叔的幻象……",
          "sc": "但为什么连疑似年轻时的六角叔的幻象……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305042,
          "spk": "裕太 (ユータ)",
          "ja": "見えたのかな……",
          "tc": "都會出現在這裡……",
          "sc": "都会出现在这里……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 305053,
          "spk": "裕太 (ユータ)",
          "ja": "このお屋敷って……",
          "tc": "這個屋子……",
          "sc": "这个屋子……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 305060,
          "spk": "裕太 (ユータ)",
          "ja": "本当に、一体なんなんだろう……",
          "tc": "究竟是什麼……",
          "sc": "究竟是什么……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5252,
      "rec_id": "TALK_ID_10_0501_121_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305084,
          "spk": "裕太 (ユータ)",
          "ja": "……ヒエッ！！",
          "tc": "……噫！！",
          "sc": "……噫！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305095,
          "spk": "裕太 (ユータ)",
          "ja": "き、急に話しかけないでよ！",
          "tc": "不要突然跟我說話啦！",
          "sc": "不要突然跟我说话啦！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305102,
          "spk": "裕太 (ユータ)",
          "ja": "考え事をしてるんだから！",
          "tc": "我正在思考欸！",
          "sc": "我正在思考诶！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305109,
          "spk": "裕太 (ユータ)",
          "ja": "別に、ビビったわけじゃ……",
          "tc": "才、才沒有嚇到……",
          "sc": "才、才没有吓到……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305120,
          "spk": "裕太 (ユータ)",
          "ja": "い、いや……ごめん……",
          "tc": "啊、不……抱歉……",
          "sc": "啊、不……抱歉……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 305127,
          "spk": "裕太 (ユータ)",
          "ja": "てっきりお化けに話しかけられたのかと……",
          "tc": "我還以為是被妖怪搭話……",
          "sc": "我还以为是被妖怪搭话……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 305134,
          "spk": "裕太 (ユータ)",
          "ja": "お化けじゃなくて、キミでよかったよ……",
          "tc": "還好是你，不是妖怪……",
          "sc": "还好是你，不是妖怪……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5253,
      "rec_id": "TALK_ID_10_0501_121_09",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305158,
          "spk": "裕太 (ユータ)",
          "ja": "俺がビビって泣き出す前に、",
          "tc": "在我嚇到哭出來之前，",
          "sc": "在我吓到哭出来之前，"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305165,
          "spk": "裕太 (ユータ)",
          "ja": "ヨウちゃんを呼ぶ声を突き止めて……",
          "tc": "必須找出呼喚小洋的聲音……",
          "sc": "必须找出呼唤小洋的声音……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305183,
          "spk": "裕太 (ユータ)",
          "ja": "突き止めて……どうすればいいんだろう",
          "tc": "但……到底該怎麼辦才好。",
          "sc": "但……到底该怎么办才好。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305190,
          "spk": "裕太 (ユータ)",
          "ja": "相手はどうせ、お化けだろう……？",
          "tc": "怎麼說，對方都是妖怪嘛……？",
          "sc": "怎么说，对方都是妖怪嘛……？"
        },
        {
          "f_idx": 6,
          "pidx_tc": 305208,
          "spk": "裕太 (ユータ)",
          "ja": "……俺の心臓、持つかなあ",
          "tc": "……我的心臟撐得住嗎？",
          "sc": "……我的心脏撑得住吗？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5254,
      "rec_id": "TALK_ID_10_0501_122_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305232,
          "spk": "裕太 (ユータ)",
          "ja": "な、な、なんで",
          "tc": "為、為、為什麼",
          "sc": "为、为、为什么"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305239,
          "spk": "裕太 (ユータ)",
          "ja": "勝手に物が動いたんだ……？",
          "tc": "東西會自己移動……？",
          "sc": "东西会自己移动……？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305250,
          "spk": "裕太 (ユータ)",
          "ja": "頼むからこれ以上、",
          "tc": "拜託不要再發生什麼",
          "sc": "拜托不要再发生什么"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305257,
          "spk": "裕太 (ユータ)",
          "ja": "怖いことが起きないでほしいな……",
          "tc": "可怕的事了……",
          "sc": "可怕的事了……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305266,
          "spk": "裕太 (ユータ)",
          "ja": "俺が、耐えられないから……",
          "tc": "我的心臟會受不了啊……",
          "sc": "我的心脏会受不了啊……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5255,
      "rec_id": "TALK_ID_10_0501_122_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305290,
          "spk": "裕太 (ユータ)",
          "ja": "い、今の見た？",
          "tc": "你、你有看到剛剛那個嗎？",
          "sc": "你、你刚才看到那个了吗？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305297,
          "spk": "裕太 (ユータ)",
          "ja": "俺たちの他に",
          "tc": "除了我們之外，",
          "sc": "除了我们之外，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305304,
          "spk": "裕太 (ユータ)",
          "ja": "誰かいるはずが……",
          "tc": "不可能有其他人在……",
          "sc": "不可能有其他人在……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305315,
          "spk": "裕太 (ユータ)",
          "ja": "頼む……",
          "tc": "拜託……",
          "sc": "拜托……"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305322,
          "spk": "裕太 (ユータ)",
          "ja": "幻覚であってくれ……",
          "tc": "希望那是幻覺……",
          "sc": "希望那是幻觉……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5256,
      "rec_id": "TALK_ID_10_0501_123_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305346,
          "spk": "裕太 (ユータ)",
          "ja": "うわぁぁぁっ！！！",
          "tc": "哇啊～～～！！！",
          "sc": "哇啊～～～！！！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305353,
          "spk": "裕太 (ユータ)",
          "ja": "へ、部屋が燃えてる……っ！！",
          "tc": "房、房間燒起來了……！！",
          "sc": "房、房间烧起来了……！！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305362,
          "spk": "裕太 (ユータ)",
          "ja": "これもまた、幻覚……？",
          "tc": "這也是幻覺嗎……？",
          "sc": "这也是幻觉吗……？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 305369,
          "spk": "裕太 (ユータ)",
          "ja": "いや、でも、熱は感じるから幻覚じゃない……？",
          "tc": "不對，我感覺得到熱度，所以不是幻覺……？",
          "sc": "不对，我感觉得到热度，所以不是幻觉……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 305378,
          "spk": "裕太 (ユータ)",
          "ja": "そもそも、一体、どうして火事なんか……",
          "tc": "話說回來，到底為什麼會發生火災……",
          "sc": "话说回来，到底为什么会发生火灾……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5257,
      "rec_id": "TALK_ID_10_0501_123_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305402,
          "spk": "裕太 (ユータ)",
          "ja": "この音……",
          "tc": "這個聲音……",
          "sc": "这个声音……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305409,
          "spk": "裕太 (ユータ)",
          "ja": "過去の幻影がまた――",
          "tc": "過去的幻影又──",
          "sc": "过去的幻影又——"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5258,
      "rec_id": "TALK_ID_10_0501_123_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305431,
          "spk": "洋的母亲 (？？？)",
          "ja": "っ、離……しっ、わた、しは――",
          "tc": "放手……我、我──",
          "sc": "放手……我、我——"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305442,
          "spk": "年轻时的六角 (？？？)",
          "ja": "くっ……",
          "tc": "唔……",
          "sc": "唔……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305449,
          "spk": "年轻时的六角 (？？？)",
          "ja": "おあっ、待……っ！",
          "tc": "啊，等……！",
          "sc": "啊，等……！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5259,
      "rec_id": "TALK_ID_10_0501_123_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 305465,
          "spk": "洋的母亲 (？？？)",
          "ja": "おとう、さ――たすけ……っ",
          "tc": "孩子的爸──救命……",
          "sc": "孩子的爸——救命……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 305476,
          "spk": "年轻时的六角 (？？？)",
          "ja": "あ……くそっ",
          "tc": "啊……可惡！",
          "sc": "啊……可恶！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 305483,
          "spk": "年轻时的六角 (？？？)",
          "ja": "お、俺は……っ",
          "tc": "我、我……",
          "sc": "我、我……"
        }
      ]
    },
    {
