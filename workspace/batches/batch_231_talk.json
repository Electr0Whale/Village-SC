    },
    {
      "file": "talk.dat",
      "rec_idx": 5994,
      "rec_id": "TALK_ID_10_0601_025_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349219,
          "spk": "林 (リン)",
          "ja": "このバカ！",
          "tc": "妳這個笨蛋！",
          "sc": "你这个笨蛋！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349228,
          "spk": "林 (リン)",
          "ja": "あなた、無茶ばかりして！",
          "tc": "老是這麼亂來！",
          "sc": "老是这么乱来！"
        },
        {
          "f_idx": 2,
          "pidx_tc": 349235,
          "spk": "林 (リン)",
          "ja": "どんだけ血を流せば学ぶのよ！！",
          "tc": "到底要流多少血才會學乖啊！！",
          "sc": "到底要流多少血才会学乖啊！！"
        },
        {
          "f_idx": 3,
          "pidx_tc": 349248,
          "spk": "帷 (トバリ)",
          "ja": "リンには言われたくないから",
          "tc": "我才不想被林這樣說，",
          "sc": "我才不想被林这样说，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 349255,
          "spk": "帷 (トバリ)",
          "ja": "アンタのバカが移ったのよ",
          "tc": "笨都是被妳傳染的。",
          "sc": "笨都是被你传染的。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 349275,
          "spk": "林 (リン)",
          "ja": "本当に心配したんだから……！",
          "tc": "我真的很擔心妳……！",
          "sc": "我真的很担心你……！"
        },
        {
          "f_idx": 7,
          "pidx_tc": 349282,
          "spk": "林 (リン)",
          "ja": "あなたが無事でよかった……",
          "tc": "幸好妳平安無事……",
          "sc": "幸好你平安无事……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5995,
      "rec_id": "TALK_ID_10_0601_025_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349300,
          "spk": "帷 (トバリ)",
          "ja": "リン……",
          "tc": "林……",
          "sc": "林……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349307,
          "spk": "帷 (トバリ)",
          "ja": "話したいことがたくさんあるの",
          "tc": "我有好多話想跟妳說。",
          "sc": "我有好多话想跟你说。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 349318,
          "spk": "帷 (トバリ)",
          "ja": "……この村を脅かしているのは、",
          "tc": "……威脅著這座村子的存在，",
          "sc": "……威胁着这座村子的存在，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 349325,
          "spk": "帷 (トバリ)",
          "ja": "土地神だけじゃない",
          "tc": "並不是只有土地神。",
          "sc": "并不是只有土地神。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 349336,
          "spk": "帷 (トバリ)",
          "ja": "きっと十年前の事件も、",
          "tc": "無論是十年前的事件，",
          "sc": "无论是十年前的事件，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 349343,
          "spk": "帷 (トバリ)",
          "ja": "私が大穴の前でアンタを刺したのも全て……",
          "tc": "還是我在大洞前刺傷妳的事，這一切……",
          "sc": "还是我在大洞前刺伤你的事，这一切……"
        },
        {
          "f_idx": 7,
          "pidx_tc": 349363,
          "spk": "林 (リン)",
          "ja": "ええ、わかってるわ……",
          "tc": "嗯，我知道……",
          "sc": "嗯，我知道……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 349370,
          "spk": "林 (リン)",
          "ja": "私も全て見たもの",
          "tc": "我也全都看到了。",
          "sc": "我也全都看到了。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 349381,
          "spk": "林 (リン)",
          "ja": "あのコダマという、土地神の樹に囚われた",
          "tc": "是那個被困在土地神之樹中的怨靈──",
          "sc": "是那个被困在土地神之树中的怨灵——"
        },
        {
          "f_idx": 10,
          "pidx_tc": 349388,
          "spk": "林 (リン)",
          "ja": "怨霊の仕業でしょ？",
          "tc": "木珠所做的對吧？",
          "sc": "木珠所做的对吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 349408,
          "spk": "帷 (トバリ)",
          "ja": "リン、私達はやらないといけない",
          "tc": "林，我們必須行動。",
          "sc": "林，我们必须行动。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 349415,
          "spk": "帷 (トバリ)",
          "ja": "神器を使って……",
          "tc": "用神器……",
          "sc": "用神器……"
        },
        {
          "f_idx": 14,
          "pidx_tc": 349422,
          "spk": "帷 (トバリ)",
          "ja": "暮らしを脅かすモノを……",
          "tc": "把那些威脅村中生活的傢伙……",
          "sc": "把那些威胁村中生活的家伙……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5996,
      "rec_id": "TALK_ID_10_0601_025_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349440,
          "spk": "林 (リン)",
          "ja": "いいえ、トバリ",
          "tc": "不，帷。",
          "sc": "不，帷。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349447,
          "spk": "林 (リン)",
          "ja": "私、決めたわ",
          "tc": "我已經決定了。",
          "sc": "我已经决定了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5997,
      "rec_id": "TALK_ID_10_0601_025_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349465,
          "spk": "林 (リン)",
          "ja": "私……村を、放棄しようと思っているの",
          "tc": "我打算……放棄村子。",
          "sc": "我打算……放弃村子。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349478,
          "spk": "帷 (トバリ)",
          "ja": "リン……",
          "tc": "林……",
          "sc": "林……"
        },
        {
          "f_idx": 2,
          "pidx_tc": 349485,
          "spk": "帷 (トバリ)",
          "ja": "まさかアンタがそんなことを",
          "tc": "妳竟然……",
          "sc": "你竟然……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 349492,
          "spk": "帷 (トバリ)",
          "ja": "言い出すなんて",
          "tc": "會說出這種話。",
          "sc": "会说出这种话。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 349503,
          "spk": "帷 (トバリ)",
          "ja": "ここはアンタのお爺さんの、そのまたお爺さんの",
          "tc": "以前妳不是說過嗎？",
          "sc": "以前你不是说过吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 349510,
          "spk": "帷 (トバリ)",
          "ja": "数えきれないほど昔の代から",
          "tc": "這裡是從妳爺爺，還有爺爺的爺爺，",
          "sc": "这里是从你爷爷，还有爷爷的爷爷，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 349517,
          "spk": "帷 (トバリ)",
          "ja": "守り続けてきた場所だって言ってたじゃない",
          "tc": "再往前無數代，一直守護至今的地方。",
          "sc": "再往前无数代，一直守护至今的地方。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 349528,
          "spk": "帷 (トバリ)",
          "ja": "それを捨てるなんて、アンタにできるの？",
          "tc": "妳有辦法捨棄這裡嗎？",
          "sc": "你有办法舍弃这里吗？"
        },
        {
          "f_idx": 8,
          "pidx_tc": 349541,
          "spk": "林 (リン)",
          "ja": "そう、ここは大切な場所",
          "tc": "沒錯，這裡是很重要的地方。",
          "sc": "没错，这里是很重要的地方。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 349548,
          "spk": "林 (リン)",
          "ja": "私が受け継いだ、守りたかった場所よ",
          "tc": "是我所繼承的，曾經想好好守護的地方。",
          "sc": "是我所继承的，曾经想好好守护的地方。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 349555,
          "spk": "林 (リン)",
          "ja": "でも、村のみんなの命に代えられるものはないわ",
          "tc": "不過，沒什麼比村子裡大家的性命更重要。",
          "sc": "不过，没什么比村子里大家的性命更重要。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 349566,
          "spk": "林 (リン)",
          "ja": "もう、ヅ主は呼んでも現れない",
          "tc": "現在津主已經不會回應呼喚現身，",
          "sc": "现在津主已经不会回应呼唤现身，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 349573,
          "spk": "林 (リン)",
          "ja": "土地神さまの祟りから守ってくれる者はいない",
          "tc": "沒有人能保護我們不受土地神大人的作祟威脅，",
          "sc": "没有人能保护我们不受土地神大人的作祟威胁，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 349580,
          "spk": "林 (リン)",
          "ja": "きっと今まで以上に危険なことが起きる",
          "tc": "今後一定會發生比之前更加危險的情況。",
          "sc": "今后一定会发生比之前更加危险的情况。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 349589,
          "spk": "林 (リン)",
          "ja": "ここに住み続けることで、",
          "tc": "既然繼續住在這裡，",
          "sc": "既然继续住在这里，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 349596,
          "spk": "林 (リン)",
          "ja": "あなたたちの命が脅かされるのなら、",
          "tc": "會讓你們的生命受到威脅，",
          "sc": "会让你们的生命受到威胁，"
        },
        {
          "f_idx": 16,
          "pidx_tc": 349603,
          "spk": "林 (リン)",
