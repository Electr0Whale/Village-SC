  "line_count": 200,
  "records": [
    {
      "file": "talk.dat",
      "rec_idx": 5980,
      "rec_id": "TALK_ID_10_0601_023_15",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348150,
          "spk": "名护 (ナゴ)",
          "ja": "……ダメだ",
          "tc": "……不行。",
          "sc": "……不行。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348157,
          "spk": "名护 (ナゴ)",
          "ja": "こういう時、どうしても",
          "tc": "像這種時候，",
          "sc": "像这种时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348164,
          "spk": "名护 (ナゴ)",
          "ja": "神に祈りたくなってしまうな……",
          "tc": "總是會忍不住想求神呢……",
          "sc": "总是会忍不住想求神呢……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 348175,
          "spk": "名护 (ナゴ)",
          "ja": "……キスケさんがよく言ってたよ",
          "tc": "……木助先生說過，",
          "sc": "……木助先生说过，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 348182,
          "spk": "名护 (ナゴ)",
          "ja": "都合のいい時だけ神に祈るのは、",
          "tc": "只在自己需要的時候才求神，",
          "sc": "只在自己需要的时候才求神，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 348189,
          "spk": "名护 (ナゴ)",
          "ja": "愚か者のすることだって",
          "tc": "是愚蠢的行為。",
          "sc": "是愚蠢的行为。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 348200,
          "spk": "名护 (ナゴ)",
          "ja": "自由があるのに、",
          "tc": "明明擁有自由，",
          "sc": "明明拥有自由，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 348207,
          "spk": "名护 (ナゴ)",
          "ja": "起きるかわからない奇跡を頼りにする……",
          "tc": "卻依賴不知是否會發生的奇蹟……",
          "sc": "却依赖不知是否会发生的奇迹……"
        },
        {
          "f_idx": 9,
          "pidx_tc": 348225,
          "spk": "名护 (ナゴ)",
          "ja": "そんな生き方はやめろって……",
          "tc": "捨棄那樣的生活方式吧……",
          "sc": "舍弃那样的生活方式吧……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5981,
      "rec_id": "TALK_ID_10_0601_023_16",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348243,
          "spk": "名护 (ナゴ)",
          "ja": "俺は、自分に何ができるか考えてみようと思う",
          "tc": "我打算嘗試思考自己能做些什麼。",
          "sc": "我打算尝试思考自己能做些什么。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348250,
          "spk": "名护 (ナゴ)",
          "ja": "キミや村の人たちが、",
          "tc": "好讓你和村裡的其他人",
          "sc": "好让你和村里的其他人"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348257,
          "spk": "名护 (ナゴ)",
          "ja": "ここで暮らしていけるように",
          "tc": "能夠在這裡生活下去。",
          "sc": "能够在这里生活下去。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 348268,
          "spk": "名护 (ナゴ)",
          "ja": "それじゃ、また",
          "tc": "那就下次見了。",
          "sc": "那就下次见了。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5982,
      "rec_id": "TALK_ID_10_0601_024_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348292,
          "spk": "裕太 (ユータ)",
          "ja": "おはよう、<player>！",
          "tc": "早安，<player>！",
          "sc": "早安，<player>！"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348301,
          "spk": "裕太 (ユータ)",
          "ja": "起こしてごめんね",
          "tc": "抱歉把你吵醒了。",
          "sc": "抱歉把你吵醒了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348308,
          "spk": "裕太 (ユータ)",
          "ja": "でも、先輩たちが戻って来るって！",
          "tc": "但是，聽說學長他們要回來了！",
          "sc": "但是，听说学长他们要回来了！"
        },
        {
          "f_idx": 4,
          "pidx_tc": 348324,
          "spk": "裕太 (ユータ)",
          "ja": "だから、居ても立っても居られなくって……！",
          "tc": "所以我興奮得靜不下來……！",
          "sc": "所以我兴奋得静不下来……！"
        },
        {
          "f_idx": 5,
          "pidx_tc": 348331,
          "spk": "裕太 (ユータ)",
          "ja": "<player>もおいで！",
          "tc": "<player>也一起來吧！",
          "sc": "<player>也一起来吧！"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5983,
      "rec_id": "TALK_ID_10_0601_024_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348359,
          "spk": "琪娜娜 (チナナ)",
          "ja": "やあ、久しぶりだね、ユータと<player>",
          "tc": "嗨，好久不見了，裕太還有<player>。",
          "sc": "嗨，好久不见了，裕太还有<player>。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348370,
          "spk": "莲实 (ハスミ)",
          "ja": "ああ……ユータさん",
          "tc": "啊……裕太先生。",
          "sc": "啊……裕太先生。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348377,
          "spk": "莲实 (ハスミ)",
          "ja": "すみません……",
          "tc": "不好意思……",
          "sc": "不好意思……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 348390,
          "spk": "琪娜娜 (チナナ)",
          "ja": "ハスミ、鵺の皮でぶっ飛んだ時に",
          "tc": "蓮實在披上鵺皮飛行的時候，",
          "sc": "莲实在披上鵺皮飞行的时候，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 348397,
          "spk": "琪娜娜 (チナナ)",
          "ja": "酔っちゃったみたいで……",
          "tc": "好像不小心頭暈了……",
          "sc": "好像不小心头晕了……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 348410,
          "spk": "莲实 (ハスミ)",
          "ja": "私のことは放っておいてもらって",
          "tc": "請不用管我",
          "sc": "请不用管我"
        },
        {
          "f_idx": 6,
          "pidx_tc": 348417,
          "spk": "莲实 (ハスミ)",
          "ja": "結構ですからね……",
          "tc": "沒關係……",
          "sc": "没关系……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5984,
      "rec_id": "TALK_ID_10_0601_024_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348435,
          "spk": "琪娜娜 (チナナ)",
          "ja": "キスケは確か……",
          "tc": "我記得木助之前……",
          "sc": "我记得木助之前……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348442,
          "spk": "琪娜娜 (チナナ)",
          "ja": "トバリを引き取るために村を出るとき、",
          "tc": "為了收養帷而離開村子的時候，",
          "sc": "为了收养帷而离开村子的时候，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348449,
          "spk": "琪娜娜 (チナナ)",
          "ja": "一度使ったことがあるんだっけ",
          "tc": "好像有用過一次吧。",
          "sc": "好像有用过一次吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5985,
      "rec_id": "TALK_ID_10_0601_024_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348467,
          "spk": "裕太 (ユータ)",
          "ja": "チナナさん、ハスミさん……",
          "tc": "琪娜娜小姐、蓮實小姐……",
          "sc": "琪娜娜小姐、莲实小姐……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348474,
          "spk": "裕太 (ユータ)",
          "ja": "先輩……",
          "tc": "學長……",
          "sc": "学长……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5986,
      "rec_id": "TALK_ID_10_0601_024_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 348500,
          "spk": "木助 (キスケ)",
          "ja": "よォ、殊勝だな",
          "tc": "嗨，真有心啊。",
          "sc": "嗨，真有心啊。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 348507,
          "spk": "木助 (キスケ)",
          "ja": "お出迎えに来てくれたのか？",
          "tc": "你們是來迎接我們的嗎？",
          "sc": "你们是来迎接我们的吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 348518,
          "spk": "裕太 (ユータ)",
          "ja": "……やっぱり、目はダメだったの？",
          "tc": "……眼睛果然還是救不回來嗎？",
          "sc": "……眼睛果然还是救不回来吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 348531,
          "spk": "木助 (キスケ)",
          "ja": "もとよりそのつもりだ",
          "tc": "我本來就是這麼打算的。",
          "sc": "我本来就是这么打算的。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 348544,
          "spk": "裕太 (ユータ)",
          "ja": "聞いたよ",
          "tc": "我有聽說，",
          "sc": "我有听说，"
        },
        {
          "f_idx": 5,
          "pidx_tc": 348551,
          "spk": "裕太 (ユータ)",
          "ja": "神に捧げるためだって……",
          "tc": "是為了獻祭給神明……",
          "sc": "是为了献祭给神明……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 348564,
          "spk": "木助 (キスケ)",
          "ja": "……まあ、そうなるな",
          "tc": "……嗯，算是那樣吧。",
          "sc": "……嗯，算是那样吧。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 348577,
          "spk": "裕太 (ユータ)",
          "ja": "先輩は、バカだよ",
          "tc": "學長真是笨蛋。",
          "sc": "学长真是笨蛋。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 348588,
          "spk": "裕太 (ユータ)",
          "ja": "先輩も、村の人たちも、",
          "tc": "你跟村子裡的人，",
          "sc": "你跟村子里的人，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 348595,
          "spk": "裕太 (ユータ)",
          "ja": "神さまに平和な暮らしを妨げられているのに",
          "tc": "明明都被神明大人攪亂了安穩的生活，",
          "sc": "明明都被神明大人搅乱了安稳的生活，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 348602,
          "spk": "裕太 (ユータ)",
          "ja": "それなのに、なんでまだ神に縋るんだよ",
          "tc": "為什麼還要繼續依靠神啊。",
          "sc": "为什么还要继续依靠神啊。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 348615,
          "spk": "木助 (キスケ)",
          "ja": "ハァ？　勘違いすんな",
          "tc": "什麼？你可別誤會了。",
          "sc": "什么？你可别误会了。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 348622,
          "spk": "木助 (キスケ)",
          "ja": "この目は暮らしを脅かす神に",
          "tc": "我這隻眼睛，",
          "sc": "我这只眼睛，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 348629,
          "spk": "木助 (キスケ)",
          "ja": "捧げたワケじゃねぇ",
          "tc": "可不是獻給了對生活有所威脅的神。",
          "sc": "可不是献给了对生活有所威胁的神。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 348642,
          "spk": "木助 (キスケ)",
          "ja": "神と一口に言ってもな、",
          "tc": "雖說都稱為神，",
          "sc": "虽说都称为神，"
        },
        {
          "f_idx": 15,
          "pidx_tc": 348649,
          "spk": "木助 (キスケ)",
          "ja": "色んな奴がいるんだよ",
          "tc": "但神明也是有各式各樣的啊。",
          "sc": "但神明也是有各式各样的啊。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 348660,
          "spk": "木助 (キスケ)",
          "ja": "祀らないと怒る奴、",
          "tc": "沒受到崇敬就生氣的神，",
          "sc": "没受到崇敬就生气的神，"
        },
        {
          "f_idx": 17,
          "pidx_tc": 348667,
          "spk": "木助 (キスケ)",
          "ja": "見るだけで祟る奴、",
          "tc": "只是被看到就作祟的神，",
          "sc": "只是被看到就作祟的神，"
        },
        {
          "f_idx": 18,
          "pidx_tc": 348674,
          "spk": "木助 (キスケ)",
          "ja": "何もせずに立ってるだけの奴……",
          "tc": "什麼也不做只是待在那裡的神……",
          "sc": "什么也不做只是待在那里的神……"
        },
        {
          "f_idx": 19,
          "pidx_tc": 348683,
          "spk": "木助 (キスケ)",
          "ja": "俺たち人間は、",
          "tc": "我們人類，",
          "sc": "我们人类，"
        },
        {
          "f_idx": 20,
          "pidx_tc": 348690,
          "spk": "木助 (キスケ)",
          "ja": "その中のどいつに願いを叶えさせるか",
          "tc": "有權在那些神明之中選擇",
          "sc": "有权在那些神明之中选择"
        },
        {
          "f_idx": 21,
          "pidx_tc": 348697,
          "spk": "木助 (キスケ)",
          "ja": "選ぶ権利を持っている",
          "tc": "替我們實現願望的神。",
          "sc": "替我们实现愿望的神。"
        },
        {
          "f_idx": 22,
          "pidx_tc": 348708,
          "spk": "木助 (キスケ)",
          "ja": "だから俺は、選んだんだ",
          "tc": "所以我做出了選擇。",
          "sc": "所以我做出了选择。"
        },
        {
          "f_idx": 23,
          "pidx_tc": 348719,
          "spk": "木助 (キスケ)",
          "ja": "そいつは暮らしを良くしようと",
          "tc": "努力想讓生活變得更好",
          "sc": "努力想让生活变得更好"
        },
        {
          "f_idx": 24,
          "pidx_tc": 348726,
          "spk": "木助 (キスケ)",
          "ja": "健気に一緒に歩んでくれた、",
          "tc": "而陪我們一路走過來，",
          "sc": "而陪我们一路走过来，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 348733,
          "spk": "木助 (キスケ)",
          "ja": "可哀想で可愛いやつなんだ",
          "tc": "這樣一個可憐又可愛的傢伙。",
          "sc": "这样一个可怜又可爱的家伙。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 348744,
          "spk": "木助 (キスケ)",
          "ja": "俺は、託すことにした",
          "tc": "我決定託付給祂。",
          "sc": "我决定托付给祂。"
        },
        {
          "f_idx": 27,
          "pidx_tc": 348751,
          "spk": "木助 (キスケ)",
          "ja": "俺と一緒に、この村の暮らしを",
          "tc": "相信祂會跟我一起，",
          "sc": "相信祂会跟我一起，"
        },
        {
          "f_idx": 28,
          "pidx_tc": 348758,
          "spk": "木助 (キスケ)",
          "ja": "守ってくれると信じてな……",
          "tc": "守護這座村子的生活……",
          "sc": "守护这座村子的生活……"
        },
        {
          "f_idx": 29,
          "pidx_tc": 348771,
          "spk": "裕太 (ユータ)",
          "ja": "でも先輩……",
          "tc": "可是學長……",
          "sc": "可是学长……"
        },
        {
          "f_idx": 30,
          "pidx_tc": 348778,
          "spk": "裕太 (ユータ)",
          "ja": "その目だったら仕事に支障が出るよ",
          "tc": "你眼睛這樣會影響到工作啊。",
          "sc": "你眼睛这样会影响到工作啊。"
        },
        {
          "f_idx": 31,
          "pidx_tc": 348785,
          "spk": "裕太 (ユータ)",
          "ja": "あんなにプライド持ってやってたのに……",
          "tc": "學長對自己工作明明那麼自豪……",
          "sc": "学长对自己工作明明那么自豪……"
        },
        {
          "f_idx": 32,
          "pidx_tc": 348798,
          "spk": "木助 (キスケ)",
          "ja": "馬鹿野郎、目がいいからって",
          "tc": "大笨蛋，就算視力再好，",
          "sc": "大笨蛋，就算视力再好，"
        },
        {
          "f_idx": 33,
          "pidx_tc": 348805,
          "spk": "木助 (キスケ)",
          "ja": "目測だけでやってるワケねぇだろ",
          "tc": "做木工又不是只靠目測！",
          "sc": "做木工又不是只靠目测！"
        },
        {
          "f_idx": 34,
          "pidx_tc": 348812,
          "spk": "木助 (キスケ)",
          "ja": "何のために人間が定規を発明したと思ってんだ",
          "tc": "你以為人類為什麼要發明尺啊？",
          "sc": "你以为人类为什么要发明尺啊？"
        },
        {
          "f_idx": 35,
          "pidx_tc": 348823,
          "spk": "木助 (キスケ)",
          "ja": "だからてめぇの作るモンは",
          "tc": "所以你做的東西才會",
          "sc": "所以你做的东西才会"
        },
        {
          "f_idx": 36,
          "pidx_tc": 348830,
          "spk": "木助 (キスケ)",
          "ja": "どれも傾いてるんだよ",
          "tc": "每個都是歪的。",
          "sc": "每个都是歪的。"
        },
        {
          "f_idx": 37,
          "pidx_tc": 348841,
          "spk": "木助 (キスケ)",
          "ja": "まあ、てめぇがもう少し落ち着いて",
          "tc": "不過，要是你能多靜下心來幫忙測量，",
          "sc": "不过，要是你能多静下心来帮忙测量，"
        },
        {
          "f_idx": 38,
          "pidx_tc": 348848,
          "spk": "木助 (キスケ)",
          "ja": "測量してくれりゃあ俺も助かるんだが……",
          "tc": "我也會輕鬆一點吧……",
          "sc": "我也会轻松一点吧……"
        },
        {
          "f_idx": 40,
          "pidx_tc": 348868,
          "spk": "裕太 (ユータ)",
          "ja": "……先輩、もしかして",
          "tc": "學長，意思是……",
          "sc": "学长，意思是……"
        },
        {
          "f_idx": 41,
          "pidx_tc": 348875,
          "spk": "裕太 (ユータ)",
          "ja": "俺を頼ろうとしてくれてるの？",
          "tc": "你願意找我幫忙嗎？",
          "sc": "你愿意找我帮忙吗？"
        },
        {
          "f_idx": 42,
          "pidx_tc": 348888,
          "spk": "木助 (キスケ)",
          "ja": "猫の手も借りてぇところだ",
          "tc": "我現在是只要有人能幫忙都好。",
          "sc": "我现在是只要有人能帮忙都好。"
        },
        {
          "f_idx": 43,
          "pidx_tc": 348895,
          "spk": "木助 (キスケ)",
          "ja": "……今のてめぇじゃ猫の手以下だが",
          "tc": "……雖然憑你現在的本事不要幫倒忙就好。",
          "sc": "……虽然凭你现在的本事不要帮倒忙就好。"
        },
        {
          "f_idx": 45,
          "pidx_tc": 348915,
          "spk": "裕太 (ユータ)",
          "ja": "俺、頑張るよ！",
          "tc": "我會努力的！",
          "sc": "我会努力的！"
        },
        {
          "f_idx": 46,
          "pidx_tc": 348922,
          "spk": "裕太 (ユータ)",
          "ja": "先輩の目の代わりになれるように！",
          "tc": "為了能當學長的眼睛！",
          "sc": "为了能当学长的眼睛！"
        },
        {
          "f_idx": 47,
          "pidx_tc": 348929,
          "spk": "裕太 (ユータ)",
          "ja": "測量、勉強する！",
          "tc": "我會學習測量！",
          "sc": "我会学习测量！"
        },
        {
          "f_idx": 48,
          "pidx_tc": 348940,
          "spk": "裕太 (ユータ)",
          "ja": "だから、先輩は",
          "tc": "所以說，",
          "sc": "所以说，"
        },
        {
          "f_idx": 49,
          "pidx_tc": 348947,
          "spk": "裕太 (ユータ)",
          "ja": "村から出て他の場所に住むなんて、",
          "tc": "拜託別連學長都說出要離開村子",
          "sc": "拜托别连学长都说出要离开村子"
        },
        {
          "f_idx": 50,
          "pidx_tc": 348954,
          "spk": "裕太 (ユータ)",
          "ja": "間違っても言わないでよね！",
          "tc": "去其他地方居住！",
          "sc": "去其他地方居住！"
        },
        {
          "f_idx": 51,
          "pidx_tc": 348967,
          "spk": "木助 (キスケ)",
          "ja": "当たりめぇだ",
          "tc": "那當然。",
          "sc": "那当然。"
        },
        {
          "f_idx": 52,
          "pidx_tc": 348974,
          "spk": "木助 (キスケ)",
          "ja": "俺はもう選んだんだ、",
          "tc": "我已經做出了選擇。",
          "sc": "我已经做出了选择。"
        },
        {
          "f_idx": 53,
          "pidx_tc": 348981,
          "spk": "木助 (キスケ)",
          "ja": "この村での暮らしを守るってな",
          "tc": "要守護這座村子的生活。",
          "sc": "要守护这座村子的生活。"
        }
      ]
    },
    {
