    {
      "file": "talk.dat",
      "rec_idx": 5991,
      "rec_id": "TALK_ID_10_0601_025_02",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349120,
          "spk": "帷 (トバリ)",
          "ja": "私は大丈夫",
          "tc": "我沒事。",
          "sc": "我没事。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349127,
          "spk": "帷 (トバリ)",
          "ja": "ちょっと傷が痛むけど、",
          "tc": "雖然傷口有點痛，",
          "sc": "虽然伤口有点痛，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 349134,
          "spk": "帷 (トバリ)",
          "ja": "痛み止めさえ飲んでおけば",
          "tc": "但只要記得吃止痛藥就好。",
          "sc": "但只要记得吃止痛药就好。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 349145,
          "spk": "帷 (トバリ)",
          "ja": "それよりアンタこそ大丈夫なの……？",
          "tc": "比起這個，我才要問你真的沒事嗎……？",
          "sc": "比起这个，我才要问你真的没事吗……？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 349152,
          "spk": "帷 (トバリ)",
          "ja": "自分で首を……",
          "tc": "明明自己把脖子給……",
          "sc": "明明自己把脖子给……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 349161,
          "spk": "帷 (トバリ)",
          "ja": "死んだかと思ったのに……",
          "tc": "我還以為你已經死了……",
          "sc": "我还以为你已经死了……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5992,
      "rec_id": "TALK_ID_10_0601_025_03",
      "lines": [
