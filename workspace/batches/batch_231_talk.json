    {
      "file": "talk.dat",
      "rec_idx": 5988,
      "rec_id": "TALK_ID_10_0601_024_07",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349026,
          "spk": "木助 (キスケ)",
          "ja": "次は俺の願いを叶えてもらおうか",
          "tc": "接下來就請你實現我的願望吧。",
          "sc": "接下来就请你实现我的愿望吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349033,
          "spk": "木助 (キスケ)",
          "ja": "落ち着いたら、説明する",
          "tc": "等我忙完會跟你說明，",
          "sc": "等我忙完会跟你说明，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 349040,
          "spk": "木助 (キスケ)",
          "ja": "待っていてくれ",
          "tc": "先等我一段時間。",
          "sc": "先等我一段时间。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 349053,
          "spk": "裕太 (ユータ)",
          "ja": "……なんで、<player>に言うんだい？",
          "tc": "……為什麼是跟<player>說啊？",
          "sc": "……为什么是跟<player>说啊？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5989,
      "rec_id": "TALK_ID_10_0601_024_08",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 349071,
          "spk": "木助 (キスケ)",
          "ja": "さあ、時は待ってくれねぇ",
          "tc": "好了，時間不等人。",
          "sc": "好了，时间不等人。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 349078,
          "spk": "木助 (キスケ)",
          "ja": "みんな、元の暮らしに戻るぜ",
          "tc": "大家都回歸原本的生活吧。",
          "sc": "大家都回归原本的生活吧。"
        }
      ]
    },
    {
