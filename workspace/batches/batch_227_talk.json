      "rec_id": "TALK_ID_10_0601_004_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339850,
          "spk": "六角 (ロッカク)",
          "ja": "奇遇っスね",
          "tc": "真巧啊。",
          "sc": "真巧呐。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339857,
          "spk": "六角 (ロッカク)",
          "ja": "<player>さんまで来るだなんて",
          "tc": "沒想到連<player>都來了。",
          "sc": "没想到连<player>都来了。"
        },
        {
          "f_idx": 2,
          "pidx_tc": 339870,
          "spk": "莲实 (ハスミ)",
          "ja": "ふふ、やっぱり皆さん、",
          "tc": "呵呵，",
          "sc": "呵呵，"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339877,
          "spk": "莲实 (ハスミ)",
          "ja": "ここにお参りに来てたのですね",
          "tc": "大家果然都來這裡參拜了呢。",
          "sc": "大家果然都来这里参拜了呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339899,
          "spk": "六角 (ロッカク)",
          "ja": "土地神さまのこともあるので、",
          "tc": "因為還有土地神大人的事，",
          "sc": "因为还有土地神大人的事，"
        },
        {
          "f_idx": 6,
          "pidx_tc": 339906,
          "spk": "六角 (ロッカク)",
          "ja": "気軽に神頼みするのは、危うい事だと",
          "tc": "我也明白",
          "sc": "我也明白"
        },
        {
          "f_idx": 7,
          "pidx_tc": 339913,
          "spk": "六角 (ロッカク)",
          "ja": "わかってるんスけど……",
          "tc": "隨便求神實現願望是很危險的……",
          "sc": "随便求神实现愿望是很危险的……"
        },
        {
          "f_idx": 8,
          "pidx_tc": 339924,
          "spk": "六角 (ロッカク)",
          "ja": "……こうして生活してると、",
          "tc": "……但人生在世，",
          "sc": "……但人生在世，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 339931,
          "spk": "六角 (ロッカク)",
          "ja": "どうしても、手を合わさずには",
          "tc": "難免會有",
          "sc": "难免会有"
        },
        {
          "f_idx": 10,
          "pidx_tc": 339938,
          "spk": "六角 (ロッカク)",
          "ja": "いられない時があるんスよね",
          "tc": "很想合掌祈求的時候嘛。",
          "sc": "很想合掌祈求的时候嘛。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 339953,
          "spk": "名护 (ナゴ)",
          "ja": "どんな国にも、神という存在が語られているし、",
          "tc": "無論在什麼樣的國家，都流傳著神明的存在，",
          "sc": "无论在什么样的国家，都流传着神明的存在，"
        },
        {
          "f_idx": 12,
          "pidx_tc": 339960,
          "spk": "名护 (ナゴ)",
          "ja": "きっと、人はどうしようもない時に、",
          "tc": "想必是因為，人類這種生物，",
          "sc": "想必是因为，人类这种生物，"
        },
        {
          "f_idx": 13,
          "pidx_tc": 339967,
          "spk": "名护 (ナゴ)",
          "ja": "何かにすがる生き物なんでしょうね",
          "tc": "在走投無路的時候就會想依靠些什麼吧。",
          "sc": "在走投无路的时候就会想依靠些什么吧。"
        }
      ]
    },
