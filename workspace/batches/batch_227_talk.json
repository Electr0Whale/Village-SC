      "rec_id": "TALK_ID_10_0601_002_03",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338768,
          "spk": "茶梅 (サザンカ)",
          "ja": "あちゃ～",
          "tc": "哎呀～",
          "sc": "哎呀～"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338775,
          "spk": "茶梅 (サザンカ)",
          "ja": "壊れちゃってらぁ",
          "tc": "壞掉了啦。",
