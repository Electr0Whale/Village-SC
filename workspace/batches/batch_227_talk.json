        },
        {
          "f_idx": 2,
          "pidx_tc": 338788,
          "spk": "四郎治 (シロージ)",
          "ja": "何かに当たって",
          "tc": "看起來像是撞到了什麼",
          "sc": "看起来像是撞到了什么"
