          "spk": "木助 (キスケ)",
          "ja": "えらく荒らしたなぁ",
          "tc": "弄得還真亂耶～",
          "sc": "弄得还真乱呢～"
        },
        {
          "f_idx": 2,
          "pidx_tc": 340602,
          "spk": "木助 (キスケ)",
          "ja": "畑が気に食わなかったのか？",
          "tc": "你看田地不爽嗎？",
          "sc": "你看田地不爽吗？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 340613,
          "spk": "木珠 (コダマ)",
          "ja": "うん、そうだよ",
