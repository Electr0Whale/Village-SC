    },
    {
      "file": "talk.dat",
      "rec_idx": 5797,
      "rec_id": "TALK_ID_10_0601_003_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339245,
          "spk": "林 (リン)",
          "ja": "相変わらず元気そうね",
          "tc": "你還是一樣，看起來很有精神呢。",
          "sc": "你还是一样，看起来很有精神呢。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339256,
          "spk": "林 (リン)",
          "ja": "そういえばあなた、",
          "tc": "話說回來，",
          "sc": "话说回来，"
        },
        {
          "f_idx": 2,
          "pidx_tc": 339263,
          "spk": "林 (リン)",
          "ja": "今朝は姿を見なかったけど……",
          "tc": "我今天早上都沒見到你……",
          "sc": "我今天早上都没见到你……"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339270,
          "spk": "林 (リン)",
          "ja": "なにしてたのよ",
          "tc": "你都在做什麼？",
          "sc": "你都在做什么？"
        },
        {
          "f_idx": 4,
          "pidx_tc": 339281,
          "spk": "木珠 (コダマ)",
          "ja": "寝てた……",
          "tc": "我在睡覺……",
          "sc": "我在睡觉……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339294,
          "spk": "驹子 (コマコ)",
          "ja": "寝てたの？　珍しいね",
          "tc": "睡覺？真稀奇呢。",
          "sc": "睡觉？真稀奇呢。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 339307,
          "spk": "林 (リン)",
          "ja": "あなた、最近の探し物集めで、",
          "tc": "你最近都在收集要找的東西，",
          "sc": "你最近都在收集要找的东西，"
        },
        {
          "f_idx": 7,
          "pidx_tc": 339314,
          "spk": "林 (リン)",
          "ja": "本分を忘れてないでしょうね？",
          "tc": "應該沒有因此忘記本分吧？",
          "sc": "应该没有因此忘记本分吧？"
        },
        {
          "f_idx": 9,
          "pidx_tc": 339332,
          "spk": "林 (リン)",
          "ja": "ちゃんと庭の世話をするって約束の代わりに、",
          "tc": "你可是答應我說會好好照顧庭院，",
          "sc": "你可是答应我说会好好照顾庭院，"
        },
        {
          "f_idx": 10,
          "pidx_tc": 339339,
          "spk": "林 (リン)",
          "ja": "あの土地に住まわせてあげてるのよ？",
          "tc": "我才讓你住在那片土地上的喔！",
          "sc": "我才让你住在那片土地上的！"
        },
        {
          "f_idx": 11,
          "pidx_tc": 339346,
          "spk": "林 (リン)",
          "ja": "追い出されたくないでしょう？",
          "tc": "你應該不想被趕出去吧？",
          "sc": "你应该不想被赶出去吧？"
        },
        {
          "f_idx": 12,
          "pidx_tc": 339357,
          "spk": "木珠 (コダマ)",
          "ja": "う、うん……追い出されたくない",
          "tc": "呃，嗯……我不想被趕出去。",
          "sc": "呃，嗯……我不想被赶出去。"
        },
        {
          "f_idx": 14,
          "pidx_tc": 339379,
          "spk": "林 (リン)",
          "ja": "だったら精一杯励むことね",
          "tc": "那就別忘了好好努力。",
          "sc": "那就别忘了好好努力。"
        },
        {
          "f_idx": 15,
          "pidx_tc": 339390,
          "spk": "木珠 (コダマ)",
          "ja": "わかった、がんばるね",
          "tc": "好，我會加油的。",
          "sc": "好，我会加油的。"
        },
        {
          "f_idx": 16,
          "pidx_tc": 339403,
          "spk": "林 (リン)",
          "ja": "そういえばあなた、最近ヅ主は見た？",
          "tc": "話說回來，你最近有見到津主嗎？",
          "sc": "话说回来，你最近有见到津主吗？"
        },
        {
          "f_idx": 17,
          "pidx_tc": 339410,
          "spk": "林 (リン)",
          "ja": "私が呼んでも反応がないのよ……",
          "tc": "就算我呼喚祂也沒有回應……",
          "sc": "就算我呼唤祂也没有回应……"
        },
        {
          "f_idx": 18,
          "pidx_tc": 339421,
          "spk": "林 (リン)",
          "ja": "また土地神が暴れるかもしれないのに……",
          "tc": "偏偏土地神還有可能再次作亂……",
          "sc": "偏偏土地神还有可能再次作乱……"
        },
        {
          "f_idx": 20,
          "pidx_tc": 339441,
          "spk": "驹子 (コマコ)",
          "ja": "もしかしてあの封印の時に、",
          "tc": "該不會是在那次封印的時候，",
          "sc": "该不会是在那次封印的时候，"
        },
        {
          "f_idx": 21,
          "pidx_tc": 339448,
          "spk": "驹子 (コマコ)",
          "ja": "力を使い果たしちゃったとか……",
          "tc": "把力量耗盡了吧……",
          "sc": "把力量耗尽了吧……"
        },
        {
          "f_idx": 22,
          "pidx_tc": 339459,
          "spk": "木珠 (コダマ)",
          "ja": "あの……もう神器は集まったから……",
          "tc": "那個……神器已經湊齊了……",
          "sc": "那个……神器已经凑齐了……"
        },
        {
          "f_idx": 24,
          "pidx_tc": 339475,
          "spk": "木珠 (コダマ)",
          "ja": "だからもう、どんな神さまにも、",
          "tc": "所以，無論是什麼樣的神明大人，",
          "sc": "所以，无论是什么样的神明大人，"
        },
        {
          "f_idx": 25,
          "pidx_tc": 339482,
          "spk": "木珠 (コダマ)",
          "ja": "襲われなくて済むよ",
          "tc": "都不會再襲擊我們了。",
          "sc": "都不会再袭击我们了。"
        },
        {
          "f_idx": 26,
          "pidx_tc": 339495,
          "spk": "林 (リン)",
          "ja": "まあ、一体その神器で",
          "tc": "雖說，還得看那些神器",
          "sc": "虽说，还得看那些神器"
        },
        {
          "f_idx": 27,
          "pidx_tc": 339502,
          "spk": "林 (リン)",
          "ja": "なにができるのかって話だけれど……",
          "tc": "究竟能拿來做什麼就是了……",
          "sc": "究竟能拿来做什么就是了……"
        },
        {
          "f_idx": 28,
          "pidx_tc": 339515,
          "spk": "驹子 (コマコ)",
          "ja": "本当にすごいよ、<player>",
          "tc": "你真的好厲害，<player>。",
          "sc": "你真的好厉害，<player>。"
        },
        {
          "f_idx": 29,
          "pidx_tc": 339522,
          "spk": "驹子 (コマコ)",
