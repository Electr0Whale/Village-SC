        {
          "f_idx": 1,
          "pidx_tc": 339081,
          "spk": "裕太 (ユータ)",
          "ja": "なんで急に落ちたんだろ……",
          "tc": "為什麼會突然掉下來呢……",
          "sc": "为什么会突然掉下来呢……"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5794,
      "rec_id": "TALK_ID_10_0601_003_01",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339116,
          "spk": "林 (リン)",
          "ja": "でも、どうしようかしら",
          "tc": "不過，該怎麼辦才好？",
          "sc": "不过，该怎么办才好？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339127,
          "spk": "林 (リン)",
          "ja": "ヅ主が来なくなっただなんて、大問題よ",
          "tc": "津主不再過來了，這可是大問題。",
          "sc": "津主不再过来了，这可是大问题。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339147,
          "spk": "驹子 (コマコ)",
          "ja": "あの……ヅ主さまの祠をなんとかしたら……",
          "tc": "那個……如果把津主大人的祠堂整理一下……",
          "sc": "那个……如果把津主大人的祠堂整理一下……"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339167,
          "spk": "林 (リン)",
          "ja": "確かに……",
          "tc": "有道理……",
          "sc": "有道理……"
        },
        {
          "f_idx": 6,
          "pidx_tc": 339174,
          "spk": "林 (リン)",
          "ja": "トバリに掃除させようかしら",
          "tc": "要不要叫帷去打掃呢？",
          "sc": "要不要叫帷去打扫呢？"
        }
      ]
    },
    {
