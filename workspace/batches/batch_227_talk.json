          "f_idx": 12,
          "pidx_tc": 341100,
          "spk": "木助 (キスケ)",
          "ja": "まあ、てめぇの力を引き出せるような供物……",
          "tc": "要說什麼樣的供品能夠激發你的力量……",
          "sc": "要说什么样的供品能够激发你的力量……"
        },
        {
          "f_idx": 13,
          "pidx_tc": 341107,
          "spk": "木助 (キスケ)",
          "ja": "目玉や腕を捧げてくれる人間を、",
          "tc": "你就到自己的祠堂前慢慢等，",
          "sc": "你就到自己的祠堂前慢慢等，"
        },
        {
          "f_idx": 14,
          "pidx_tc": 341114,
          "spk": "木助 (キスケ)",
          "ja": "てめぇの祠の前で待ってみることだな",
          "tc": "看有沒有自願獻上眼珠或手臂的人類吧。",
          "sc": "看有没有自愿献上眼珠或手臂的人类吧。"
