          "ja": "……はぁ",
          "tc": "……唉。",
          "sc": "……唉。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 341001,
          "spk": "木助 (キスケ)",
          "ja": "そこに居るのか",
          "tc": "你在那裡嗎？",
          "sc": "你在那里吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 341012,
          "spk": "木助 (キスケ)",
          "ja": "可哀想になァ",
          "tc": "真可憐啊。",
          "sc": "真可怜啊。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 341023,
          "spk": "木助 (キスケ)",
          "ja": "体も、庭も、村人との関係も奪われちまった",
          "tc": "身體、庭院，還有與村民間建立的關係，",
          "sc": "身体、庭院，还有与村民间建立的关系，"
        },
        {
          "f_idx": 4,
          "pidx_tc": 341030,
          "spk": "木助 (キスケ)",
          "ja": "もう二度と、誰もてめぇには気づいてくれねぇ",
          "tc": "這些通通都被搶走了。",
          "sc": "这些通通都被抢走了。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 341048,
          "spk": "木助 (キスケ)",
          "ja": "俺は忠告したぜ",
          "tc": "再也不會有人注意到你，我可是提醒過你了。",
          "sc": "再也不会有人注意到你，我可是提醒过你了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 341057,
          "spk": "木助 (キスケ)",
          "ja": "自由を欲しがってたのは、",
          "tc": "渴望得到自由的人",
          "sc": "渴望得到自由的人"
        },
        {
          "f_idx": 8,
          "pidx_tc": 341064,
          "spk": "木助 (キスケ)",
          "ja": "てめぇだけじゃなかったんだ",
          "tc": "不是只有你一個。",
          "sc": "不是只有你一个。"
        },
        {
          "f_idx": 9,
          "pidx_tc": 341075,
          "spk": "木助 (キスケ)",
          "ja": "あの庭も、体も一つだけだ",
          "tc": "無論庭院或身體，都只有一個。",
          "sc": "无论庭院或身体，都只有一个。"
        },
        {
          "f_idx": 10,
          "pidx_tc": 341082,
          "spk": "木助 (キスケ)",
          "ja": "悪いが俺は、てめぇの力にはなれねぇよ",
          "tc": "抱歉，我沒辦法幫你。",
          "sc": "抱歉，我没办法帮你。"
        },
