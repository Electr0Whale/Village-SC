      "rec_id": "TALK_ID_10_0601_002_04",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338815,
          "spk": "裕太 (ユータ)",
          "ja": "ねぇ、シロージも見たよね？",
          "tc": "喂～四郎治你也看到了吧？",
          "sc": "喂～四郎治你也看到了吧？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338822,
          "spk": "裕太 (ユータ)",
          "ja": "一体何にぶつかったのかな……？",
          "tc": "到底是撞到了什麼呢……？",
          "sc": "到底是撞到了什么呢……？"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5788,
      "rec_id": "TALK_ID_10_0601_002_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338840,
          "spk": "茶梅 (サザンカ)",
          "ja": "なにその言い訳……",
          "tc": "還找什麼理由……",
          "sc": "还找什么理由……"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338847,
          "spk": "茶梅 (サザンカ)",
          "ja": "アンタの操作のせいでしょ",
          "tc": "明明是你操作得不好吧。",
          "sc": "明明是你操作得不好吧。"
        }
      ]
    },
    {
      "file": "talk.dat",
      "rec_idx": 5789,
      "rec_id": "TALK_ID_10_0601_002_06",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 338865,
          "spk": "裕太 (ユータ)",
          "ja": "ええー？",
          "tc": "咦咦～？",
          "sc": "咦咦～？"
        },
        {
          "f_idx": 1,
          "pidx_tc": 338872,
          "spk": "裕太 (ユータ)",
          "ja": "俺のせいなの？",
          "tc": "是我的錯嗎？",
          "sc": "是我的错吗？"
        },
        {
          "f_idx": 2,
          "pidx_tc": 338885,
          "spk": "茶梅 (サザンカ)",
          "ja": "なに？",
          "tc": "不然呢？",
          "sc": "不然呢？"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338892,
          "spk": "茶梅 (サザンカ)",
          "ja": "アタシの傑作、テンアゲドローンちゃんに",
          "tc": "難道你的意思是",
          "sc": "难道你的意思是"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338899,
          "spk": "茶梅 (サザンカ)",
          "ja": "欠陥があるって言いたいの？",
          "tc": "我的傑作嗨翻天無人機有缺陷嗎？",
          "sc": "我的杰作嗨翻天无人机有缺陷吗？"
        },
        {
          "f_idx": 5,
          "pidx_tc": 338912,
          "spk": "四郎治 (シロージ)",
          "ja": "強いて言えばそうだろ",
          "tc": "硬要說的話也沒錯吧。",
          "sc": "硬要说的话也没错吧。"
        },
        {
          "f_idx": 6,
          "pidx_tc": 338919,
          "spk": "四郎治 (シロージ)",
          "ja": "絶対落ちないって、豪語してたんだから",
          "tc": "畢竟妳之前都誇下海口說，絕對不會掉下來。",
          "sc": "毕竟你之前都夸下海口说，绝对不会掉下来。"
        }
      ]
    },
    {
