          "ja": "はぁ……また修理しなきゃな～",
          "tc": "唉……又得修理了～",
          "sc": "唉……又得修理了～"
        },
        {
          "f_idx": 3,
          "pidx_tc": 338977,
          "spk": "裕太 (ユータ)",
          "ja": "ご、ごめんよサザンカ",
          "tc": "對、對不起啦，茶梅。",
          "sc": "对、对不起啦，茶梅。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 338984,
          "spk": "裕太 (ユータ)",
          "ja": "なんか奢ってあげるからさぁ",
          "tc": "我請妳吃東西嘛～",
          "sc": "我请你吃东西嘛～"
        },
        {
          "f_idx": 5,
          "pidx_tc": 338997,
