      "rec_id": "TALK_ID_10_0601_002_10",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339074,
          "spk": "裕太 (ユータ)",
          "ja": "それにしても変だなぁ",
          "tc": "話說回來，真奇怪耶～",
          "sc": "话说回来，真奇怪呢～"
