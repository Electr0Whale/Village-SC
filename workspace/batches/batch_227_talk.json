        {
          "f_idx": 3,
          "pidx_tc": 338795,
          "spk": "四郎治 (シロージ)",
          "ja": "落ちたように見えたぞ",
          "tc": "才掉下來的。",
          "sc": "才掉下来的。"
        }
      ]
    },
    {
      "file": "talk.dat",
