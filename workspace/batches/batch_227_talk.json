      "rec_idx": 5798,
      "rec_id": "TALK_ID_10_0601_003_05",
      "lines": [
        {
          "f_idx": 0,
          "pidx_tc": 339625,
          "spk": "林 (リン)",
          "ja": "さあ、私たちも行きましょう",
          "tc": "好了，我們走吧。",
          "sc": "好了，我们走吧。"
        },
        {
          "f_idx": 1,
          "pidx_tc": 339638,
          "spk": "驹子 (コマコ)",
          "ja": "今日はトバリが",
          "tc": "因為帷有答應說",
          "sc": "因为帷有答应说"
        },
        {
          "f_idx": 2,
          "pidx_tc": 339645,
          "spk": "驹子 (コマコ)",
          "ja": "晩ご飯を作ってくれるって、約束したからね",
          "tc": "她今天會做晚餐嘛。",
          "sc": "她今天会做晚餐嘛。"
        },
        {
          "f_idx": 3,
          "pidx_tc": 339658,
          "spk": "林 (リン)",
          "ja": "どういう風の吹き回しかしら",
          "tc": "真不曉得這是吹什麼風了。",
          "sc": "真不晓得这是吹什么风了。"
        },
        {
          "f_idx": 4,
          "pidx_tc": 339671,
          "spk": "驹子 (コマコ)",
          "ja": "そういえばトバリ、今日はいないね",
          "tc": "話說回來，帷今天不在呢。",
          "sc": "话说回来，帷今天不在呢。"
        },
        {
          "f_idx": 5,
          "pidx_tc": 339678,
          "spk": "驹子 (コマコ)",
          "ja": "どこ行ったんだろ",
          "tc": "不曉得跑哪去了。",
          "sc": "不晓得跑哪去了。"
        },
        {
          "f_idx": 7,
          "pidx_tc": 339698,
          "spk": "林 (リン)",
          "ja": "まさか、約束を忘れてるんじゃないわよね",
          "tc": "她該不會忘記約定了吧。",
          "sc": "她该不会忘记约定了吧。"
        },
        {
          "f_idx": 8,
          "pidx_tc": 339711,
          "spk": "驹子 (コマコ)",
          "ja": "トバリは意外と律儀だから、",
          "tc": "帷其實還滿一板一眼的，",
          "sc": "帷其实还满一板一眼的，"
        },
        {
          "f_idx": 9,
          "pidx_tc": 339718,
          "spk": "驹子 (コマコ)",
          "ja": "きっと食材を集めに行ってるんじゃないかな",
          "tc": "應該是去準備食材了吧。",
          "sc": "应该是去准备食材了吧。"
        },
        {
          "f_idx": 11,
          "pidx_tc": 339738,
          "spk": "林 (リン)",
          "ja": "……そうね",
          "tc": "……也對。",
          "sc": "……也对。"
        },
        {
          "f_idx": 12,
          "pidx_tc": 339745,
          "spk": "林 (リン)",
          "ja": "そのうち帰ってくるか",
          "tc": "應該不用多久就會回來了。",
          "sc": "应该不用多久就会回来了。"
        },
        {
          "f_idx": 13,
          "pidx_tc": 339756,
          "spk": "林 (リン)",
          "ja": "約束をすっぽかしたら、許さないんだから！",
          "tc": "要是她敢食言，我可不會原諒她！",
          "sc": "要是她敢食言，我可不会原谅她！"
        }
      ]
    },
